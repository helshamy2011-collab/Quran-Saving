{"1":[[2,2,"ٱنفَطَرَتۡ","انْشَقَّتْ، واخْتَلَّ نِظامُها."]],"2":[[2,2,"ٱنتَثَرَتۡ","تَساقَطَتْ."]],"3":[[2,2,"فُجِّرَتۡ","فَجَّرَ اللهُ بَعْضَها في بَعْضٍ، فَمَلأَ جَمِيعَها."]],"4":[[2,2,"بُعۡثِرَتۡ","قُلِبتْ بِبَعْثِ مَن كانَ فِيها."]],"5":[[1,1,"نَفۡسٌ","كلُّ نَفْسٍ."],[2,4,"مَّا قَدَّمَتۡ وَأَخَّرَتۡ","ما تَقَدَّمَ مِن أعْمالِها وما تَأَخَّرَ."]],"6":[[1,1,"ٱلۡإِنسَـٰنُ","المنْكِرُ لِلْبَعْثِ."],[2,4,"مَا غَرَّكَ بِرَبِّكَ","ما الَّذِي خَدَعَكَ حتّى كَفَرْتَ بِرَبِّكَ؟."],[5,5,"ٱلۡكَرِيمِ","الجَوادِ الكَثِيرِ الخيرِ."]],"7":[[2,2,"فَسَوَّىٰكَ","فَجَعَلَكَ قَوِيمًا سَلِيمًا."],[3,3,"فَعَدَلَكَ","فَجَعَلَكَ مُسْتَقِيمَ القامَةِ مُتَناسِبَ الأجْزاءِ."]],"8":[[3,5,"مَّا شَآءَ رَكَّبَكَ","رَكَّبكَ التَّرْكِيبَ الَّذِي شاءَهُ."]],"9":[[0,0,"كَلَّا","لَيسَ الأمرُ كَما تَقُولُونَ."],[3,3,"بِٱلدِّينِ","بِيومِ الِحسابِ."]],"10":[[2,2,"لَحَـٰفِظِينَ","لمَلائِكَةً رُقَباءَ."]],"11":[[0,0,"كِرَامًا","على اللهِ."],[1,1,"كَـٰتِبِينَ","لِما وُكِّلُوا بإحْصائِهِ."]],"13":[[1,1,"ٱلۡأَبۡرَارَ","القائِمينَ بِحُقُوقِ اللهِ وحُقُوقِ عِبادِهِ."],[3,3,"نَعِيمٍ","التَّنَعُّمِ الدّائِم في الجنَّةِ."]],"14":[[1,1,"ٱلۡفُجَّارَ","الَّذِينَ قَصَّرُوا في حُقُوقِ اللهِ وحُقُوقِ عِبادِهِ."]],"15":[[0,0,"يَصۡلَوۡنَهَا","يُصِيبُهُم لَهَبُها."],[1,2,"يَوۡمَ ٱلدِّينِ","يوم الجزاءِ."]],"16":[[2,2,"عَنۡهَا","عذابِ جَهَنَّمَ."],[3,3,"بِغَآئِبِينَ","لا بِخُرُوج ولا بِمَوتٍ."]],"17":[[0,1,"وَمَآ أَدۡرَىٰكَ","وما أعْلَمَكَ؟"],[2,4,"مَا يَوۡمُ ٱلدِّينِ","ما عَظَمَةُ يَومِ الحِسابِ."]],"19":[[1,5,"لَا تَمۡلِكُ نَفۡسٌ لِّنَفۡسٍ شَيۡـًٔا","لا يَقْدِرُ أحدٌ على نَفْعِ أحَدٍ."]]}