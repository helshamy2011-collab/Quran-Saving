{"1":[[2,2,"ٱلۡوَاقِعَةُ","القِيامَةُ."]],"2":[[2,2,"كَاذِبَةٌ","لا يَكُونُ عِنْدَ وُقُوعِها تَكْذِيبٌ."]],"3":[[0,1,"خَافِضَةٌ رَّافِعَةٌ","هي خافِضَةٌ يَحْصُلُ عِنْدَها خَفْضُ أقْوامٍ كانُوا مُرْتَفِعِينَ ورَفْعُ أقْوامٍ كانُوا مُنْخَفِضِينَ، وخافِضَةُ جِهاتٍ كانَتْ مُرْتَفِعَةً كالجِبالِ والصَّوامِعِ، رافِعَةٌ ما كانَ مُنْخَفِضًا بِسَبَبِ ما يَحْدُثُ في الكَونِ."]],"4":[[1,1,"رُجَّتِ","اضْطَرَبَتْ، بِسَبَبِ الزَّلازِلِ والخَسْفِ ونَحْوِ ذَلِكَ."]],"5":[[0,0,"وَبُسَّتِ","فُتِّتَتِ الجبالُ ونُسِفَتْ."]],"6":[[1,1,"هَبَآءً","ما يَلُوحُ في خُيُوطِ شُعاعِ الشَّمسِ مِن دَقِيقِ الغُبارِ."],[2,2,"مُّنۢبَثًّا","مُتَفَرِّقًا."]],"7":[[1,1,"أَزۡوَٰجًا","أصْنافًا."]],"8":[[0,1,"أَصۡحَـٰبُ ٱلۡمَيۡمَنَةِ","هُمُ الَّذِينَ يُجْعَلُونَ في الجِهَةِ اليُمْنى فِي الجَنَّةِ أوْ فِي الَمحْشَرِ."]],"9":[[0,1,"أَصۡحَـٰبُ ٱلۡمَشۡـَٔمَةِ","أصْحابُ الشَّقاوَةِ الَّذِينَ يُؤْخَذُ بِهِم ذاتَ الشِّمال إلى النّارِ."]],"10":[[0,0,"وَٱلسَّـٰبِقُونَ","إلى الخَيْراتِ."],[1,1,"ٱلسَّـٰبِقُونَ","إلى مُنْتَهى الفَضْلِ والرِّفْعَةِ."]],"13":[[0,0,"ثُلَّةٌ","جَماعةٌ."]],"15":[[1,1,"سُرُرٍ","جَمْعُ سَرِيرٍ، وهو مَجِلِسُ العُظَماءِ والمُلُوكِ أيْضًا."],[2,2,"مَّوۡضُونَةٍ","مَسْبُوكٍ بَعْضُها بِبَعْضٍ."]],"16":[[2,2,"مُتَقَـٰبِلِينَ","يَجْلِسُ بَعْضُهُم مُقابِلَ بَعْضٍ، وذَلِكَ مِن تَمامِ النَّعِيمِ لمِا فِيهِ مِنَ الأُنْسِ بِمُشاهَدَةِ الأَصْحابِ والحَدِيثِ مَعَهُم."]],"17":[[0,0,"يَطُوفُ","يَدُورُ عَلى نَحْوٍ دائِمٍ."],[3,3,"مُّخَلَّدُونَ","أي دائِمُونَ عَلى الطَّوافِ عَلَيهِم ومُناوَلَتِهِم."]],"18":[[0,0,"بِأَكۡوَابٍ","جَمْعُ كُوبٍ، وهو إناءُ الخمْرِ."],[1,1,"وَأَبَارِيقَ","جَمْعِ إبْريقٍ، وهو إناءٌ تُحْمَلُ فِيهِ الخمْرُ فتُصَبُّ في الأكْوابِ."],[2,2,"وَكَأۡسٍ","هو إناءٌ للخَمْرِ كاْلكُوبِ."],[4,4,"مَّعِينٍ","هو الجارِي، والمُرادُ بِهِ الخَمْرُ الَّتِي لِكَثْرَتِها تَجْرِي ولَيسَتْ عَزِيَزةً كَما هِي في الدُّنيا."]],"19":[[0,1,"لَّا يُصَدَّعُونَ","لا يُصِيبُهُم صُداعُ الرَّأْسِ."],[3,4,"وَلَا يُنزِفُونَ","أي لا يَعْتَرِيهِم اخْتِلاطُ العَقْلِ."]],"20":[[2,2,"يَتَخَيَّرُونَ","يَخْتارُونَهُ ويَشْتَهُونَهُ."]],"22":[[0,0,"وَحُورٌ","نِساءٌ ذَواتُ حَوَرٍ أي: نِساءٌ شَدِيداتُ بياضِ العَينِ وسَوادِها."],[1,1,"عِينٌ","واسِعاتُ العُيُونِ."]],"23":[[0,0,"كَأَمۡثَـٰلِ","كأشْباهِ."],[1,1,"ٱللُّؤۡلُوِٕ","الدُّرِّ."],[2,2,"ٱلۡمَكۡنُونِ","المَخْزُونِ المُخَبَّأِ لِنَفاسَتِهِ."]],"25":[[3,3,"لَغۡوًا","هُوَ الكَلامُ الَّذِي لا يُعْتَدُّ بِهِ."],[5,5,"تَأۡثِيمًا","هُوَ اللَّومُ والإنْكارُ."]],"26":[[2,3,"سَلَـٰمًا سَلَـٰمًا","سَلَّمْنا سَلامًا إثْرَ سَلامٍ."]],"28":[[1,1,"سِدۡرٍ","شَجَرٍ مِن شَجَرِ العِضاه، ذِي ورَقٍ عَرِيضٍ مُدَوَّرٍ."],[2,2,"مَّخۡضُودٍ","أُزِيلَ شَوْكُهُ."]],"29":[[0,0,"وَطَلۡحٍ","شَجَرٍ مِن شَجَرِ العِضاه، واحدُه طَلْحةٌ، كَثِيرَةُ الظِّلِّ مِن التِفافِ أغْصانِها."],[1,1,"مَّنضُودٍ","مُتَراصٍّ مُتَراكِبٍ بالأغْصانِ."]],"30":[[0,1,"وَظِلٍّ مَّمۡدُودٍ","لا يَتَقَلَّصُ كَظِلِّ الدُّنيا."]],"31":[[0,1,"وَمَآءٍ مَّسۡكُوبٍ","مَصبُوبٍ."]],"33":[[0,3,"لَّا مَقۡطُوعَةٍ وَلَا مَمۡنُوعَةٍ","دائِمَةٍ مَبْذُولَةٍ لَهُم."]],"34":[[0,0,"وَفُرُشٍ","جَمْعُ فِراشٍ، وهو ما يُفْرَشُ."],[1,1,"مَّرۡفُوعَةٍ","عَلى الأَسِرَّةِ."]],"42":[[1,1,"سَمُومٍ","هي الرِّيحُ الشَّدِيدَةُ الحَرارةِ."],[2,2,"وَحَمِيمٍ","هو الماءُ الشَّديدُ الحَرارةِ."]],"43":[[2,2,"يَحۡمُومٍ","الدُّخانِ الأَسْوَدِ."]],"45":[[4,4,"مُتۡرَفِينَ","ذوي نِعْمَةٍ واسِعةٍ."]],"46":[[1,1,"يُصِرُّونَ","يَثْبُتُونَ عَلَيهِ."],[3,3,"ٱلۡحِنثِ","الذَّنبِ والمَعْصِيَةِ."],[4,4,"ٱلۡعَظِيمِ","القَوِيِّ في نَوْعِهِ، وهو الشِّركُ."]],"50":[[0,0,"لَمَجۡمُوعُونَ","يُبْعَثُونَ ويُحْشَرُونَ جَمِيعًا."]],"52":[[2,4,"شَجَرٍ مِّن زَقُّومٍ","شَجَرَةٍ كَرِيهَةِ الرّائِحَةِ يُنبتُها اللهُ في جَهَنَّمَ."]],"54":[[3,3,"ٱلۡحَمِيمِ","هُوَ الماءُ الشَّدِيدُ الغَلَيانِ."]],"55":[[2,2,"ٱلۡهِيمِ","جَمْعُ أهْيَمَ، وهُوَ البَعِيرُ الَّذِي أصابَهُ الهُيامُ، وهو داءُ يُصُيِبُ الإبِلَ فلا تَزالُ تَشْرَبُ ولا تَرْوى."]],"56":[[1,1,"نُزُلُهُمۡ","النُّزُلُ هو ما يُقَدَّمُ للضَّيفِ مِن طَعامٍ."]],"58":[[2,2,"تُمۡنُونَ","ما يَكُونُ مِنكُم مِن الَمنِيِّ."]],"60":[[1,3,"قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ","قَضَيْنا عَلَيكُم بِالمَوْتِ أوْ سَوَّينا بَينَكُم في الموتِ."],[6,6,"بِمَسۡبُوقِينَ","بِمَغْلُوبِينَ."]],"61":[[2,3,"نُّبَدِّلَ أَمۡثَـٰلَكُمۡ","نُغَيِّرَ خَلْقَكُم."],[5,8,"فِي مَا لَا تَعۡلَمُونَ","مِنَ الصِّفاتِ والأحْوال."]],"62":[[2,3,"ٱلنَّشۡأَةَ ٱلۡأُولَىٰ","خَلْقَ اللهِ إياكُم ولَمْ تكُونُوا شَيئًا مَذْكُورًا."]],"64":[[1,1,"تَزۡرَعُونَهُۥٓ","تُنْبِتُونَهُ."]],"65":[[3,3,"حُطَـٰمًا","يابِسًا هَشِيمًا لا يُنْتَفعُ بِهِ."],[4,4,"فَظَلۡتُمۡ","فصِرْتُمْ."],[5,5,"تَفَكَّهُونَ","تَعْجَبُونَ مِن يُبْسِهِ بَعْدَ خُضْرَتِهِ."]],"66":[[0,1,"إِنَّا لَمُغۡرَمُونَ","لَمُلْزَمُونَ غَرامَةَ ما أنْفَقْنا."]],"67":[[2,2,"مَحۡرُومُونَ","من الرِّزقِ."]],"69":[[3,3,"ٱلۡمُزۡنِ","السَّحابِ."]],"70":[[3,3,"أُجَاجًا","شَدِيدَ المُلُوحَةِ."]],"71":[[3,3,"تُورُونَ","تُوقِدُونَ."]],"72":[[2,2,"شَجَرَتَهَآ","الَّتِي تُقْدَحُ مِنها النّارُ."],[5,5,"ٱلۡمُنشِـُٔونَ","الخالِقُونَ."]],"73":[[2,2,"تَذۡكِرَةً","تَذْكِيرًا لَكُم بِنارِ جَهَنَّمَ."],[3,3,"وَمَتَـٰعًا","ومَنفَعَةً."],[4,4,"لِّلۡمُقۡوِينَ","لِلْمُسافِريِنَ."]],"74":[[0,0,"فَسَبِّحۡ","فنَزِّهْ."]],"75":[[2,3,"بِمَوَٰقِعِ ٱلنُّجُومِ","بِمَساقِطِ النُّجُومِ في مَغارِبِها في السَّماءِ."]],"78":[[2,2,"مَّكۡنُونٍ","مَصُونٍ مَسْتُورٍ، وهو الكِتابُ الَّذِي بأيدِي الملائِكةِ."]],"79":[[3,3,"ٱلۡمُطَهَّرُونَ","هُمُ المَلائِكةُ الَّذِينَ طَهَّرَهُم اللهُ مِنَ الآفاتِ والذُّنُوبِ."]],"81":[[1,1,"ٱلۡحَدِيثِ","القرآنِ."],[3,3,"مُّدۡهِنُونَ","مُكَذِّبُونَ."]],"82":[[1,1,"رِزۡقَكُمۡ","شُكْرَكُم لِنِعَمِ اللهِ عَلَيكُم."]],"83":[[0,0,"فَلَوۡلَآ","فَهَلّا."],[2,2,"بَلَغَتِ","أي النَّفْسُ."],[3,3,"ٱلۡحُلۡقُومَ","الحَلْقَ."]],"85":[[0,3,"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ","بِمَلائِكَتِنا ولَكِنَّكُم لا تَرَونَهُم."]],"86":[[0,0,"فَلَوۡلَآ","فَهَلّا."],[3,4,"غَيۡرَ مَدِينِينَ","غَيرَ مُحاسَبِينَ ولا مَجْزِيِّينَ بِأَعْمالِكُم."]],"87":[[0,0,"تَرۡجِعُونَهَآ","تَرُدُّونَ النَّفْسَ."]],"89":[[0,0,"فَرَوۡحٌ","فَلَهُ رَحْمَةٌ وفَرَحٌ عِنْدَ مَوتِهِ."],[1,1,"وَرَيۡحَانٌ","مُسْتَراحٌ."]],"91":[[0,1,"فَسَلَـٰمٌ لَّكَ","فسَلامةٌ لَكَ وأَمْنٌ."]],"94":[[0,0,"وَتَصۡلِيَةُ","وإدْخالٌ لِيُقاسِيَ الحرَّ."]],"95":[[3,4,"حَقُّ ٱلۡيَقِينِ","اليَقِينُ حقًا."]],"96":[[0,0,"فَسَبِّحۡ","فَنَزِّهْ."]]}