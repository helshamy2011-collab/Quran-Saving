{"1":[[4,4,"ٱلۡمُبِينِ","الواضِحِ في معانيه وأحكامِه."]],"3":[[15,15,"ٱلۡغَـٰفِلِينَ","السّاهِين، أي: لم يَكُنْ لك عِلْمٌ بهذا الإخبارِ."]],"4":[[14,14,"سَـٰجِدِينَ","أي: سجودَ تَكريمٍ واحترامٍ."]],"5":[[7,8,"فَيَكِيدُواْ لَكَ","يَحْتالُوا من أجلِ إهلاكِك حَسَدًا."],[14,14,"مُّبِينٌ","ظاهرُ العداوةِ."]],"6":[[1,1,"يَجۡتَبِيكَ","يختارُك لأمورٍ عظيمة."],[5,6,"تَأۡوِيلِ ٱلۡأَحَادِيثِ","تفسيرِ الرُّؤى المناميةِ."],[7,9,"وَيُتِمُّ نِعۡمَتَهُۥ عَلَيۡكَ","أي: بالنبوَّةِ والرسالةِ."]],"7":[[5,5,"ءَايَـٰتٌ","عِبَرٌ، وعلاماتٌ دالَّةٌ على قدرةِ اللهِ."]],"8":[[9,9,"عُصۡبَةٌ","جماعةٌ من الرجالِ متناصِرُون."],[13,14,"ضَلَـٰلٍ مُّبِينٍ","خطأٍ بيِّنٍ في تفضيلِهما علينا."]],"9":[[3,4,"ٱطۡرَحُوهُ أَرۡضًا","ألْقُوه في أرضٍ بعيدةٍ."],[5,8,"يَخۡلُ لَكُمۡ وَجۡهُ أَبِيكُمۡ","يَخْلُصْ لكم حُبُّ أبيكم وإقبالُه عليكم."],[10,11,"مِنۢ بَعۡدِهِۦ","من بعدِ قَتْلِ يوسفَ أو إبعادِه."],[13,13,"صَـٰلِحِينَ","تائبين إلى اللهِ مِن فَعْلَتِكم."]],"10":[[8,9,"غَيَـٰبَتِ ٱلۡجُبِّ","جوفِ البئرِ وأسفلِه حيثُ يَغيبُ خبرُه."],[12,12,"ٱلسَّيَّارَةِ","المسافرين المارِّينَ بالبئرِ."]],"12":[[3,3,"يَرۡتَعۡ","يَتَنعَّمْ في أكْلِ ما لَذَّ له وطابَ."],[4,4,"وَيَلۡعَبۡ","يتسابَقْ ويرمِ بالسِّهام معنا."]],"13":[[2,2,"لَيَحۡزُنُنِيٓ","لَيُؤْلمُ نفسي فِراقُ يوسفَ."],[12,12,"غَـٰفِلُونَ","ساهُون."]],"14":[[8,8,"لَّخَـٰسِرُونَ","عاجِزُون لا خيرَ فينا."]],"15":[[3,3,"وَأَجۡمَعُوٓاْ","عَزَمُوا."],[9,10,"وَأَوۡحَيۡنَآ إِلَيۡهِ","أعلمَ اللهُ يوسُفَ؛ تَطْمينًا لقَلْبِه."],[11,11,"لَتُنَبِّئَنَّهُم","لتُخْبِرَنَّ إخوتَك."]],"17":[[4,4,"نَسۡتَبِقُ","نتسابَقُ في الجَرْيِ والرَّمْيِ بالسِّهامِ."],[8,8,"مَتَـٰعِنَا","ما ننتفِعُ به من الطَّعامِ والثيابِ ونحوِهما."],[13,14,"بِمُؤۡمِنٍ لَّنَا","بمُصَدِّقٍ لنا."]],"18":[[7,7,"سَوَّلَتۡ","زَيَّنَتْ."],[11,12,"فَصَبۡرٌ جَمِيلٌ","وهو ما لا جَزَعَ فيه، ولا شَكْوى معه لأحدٍ من الخَلْقِ."]],"19":[[1,1,"سَيَّارَةٌ","جماعةٌ من المسافرين."],[3,3,"وَارِدَهُمۡ","مَن يتقدَّمُهم ليطلُبَ لهم الماءَ."],[4,5,"فَأَدۡلَىٰ دَلۡوَهُۥ","فأَنْزَلَها الواردُ في البئرِ."],[10,10,"وَأَسَرُّوهُ","وأخفى الوارِدُ وأصحابُه يوسفَ عن بقيةِ المسافرين."],[11,11,"بِضَـٰعَةً","متاعًا للتجارة."]],"20":[[0,0,"وَشَرَوۡهُ","باعه إخوتُه."],[2,2,"بَخۡسٍ","قليلٍ ناقصٍ عن مِثْلِه."],[8,8,"ٱلزَّٰهِدِينَ","المُعْرِضين عنه، غيرِ المبالِين به."]],"21":[[6,7,"أَكۡرِمِي مَثۡوَىٰهُ","اجعلي مَقامَه عندنا كريمًا."],[17,18,"فِي ٱلۡأَرۡضِ","أرضِ مصرَ."],[23,26,"وَٱللَّهُ غَالِبٌ عَلَىٰٓ أَمۡرِهِۦ","لا يُعْجِزُه شيءٌ، ولا ينازعُه في حُكْمِه أحدٌ."]],"22":[[2,2,"أَشُدَّهُۥٓ","منتهى قوتِه الجسميةِ، وتكامُلَ عَقْلِه."],[4,4,"حُكۡمًا","حِكْمةً وفَهْمًا سديدًا، أو النبوَّةَ."]],"23":[[0,0,"وَرَٰوَدَتۡهُ","ودَعَتْ امرأةُ العزيزِ يوسُفَ إلى نفسِها بلِينٍ ومُخادَعَةٍ."],[10,11,"هَيۡتَ لَكَ","هلمَّ إليَّ وأقْبِلْ."],[13,14,"مَعَاذَ ٱللَّهِ","أستجيرُ بالله وأعتصِمُ به ممّا تُريدين مني."],[15,16,"إِنَّهُۥ رَبِّيٓ","إن زوجَكِ سيِّدي."],[18,18,"مَثۡوَايَ","مَقامي عنده."]],"24":[[1,2,"هَمَّتۡ بِهِۦ","مالَتْ إليه وعَزَمَتْ على فِعْلِ الفاحشةِ به."],[3,4,"وَهَمَّ بِهَا","ما خَطَرَ بنفسِه من الميلِ بمقتضى الطبيعةِ البشريَّة."],[8,9,"بُرۡهَـٰنَ رَبِّهِۦ","حُجَّةَ رَبِّه الواضحةَ التي مَنَعَتْه عن المَيْلِ لخَطَراتِ نفسِه."],[13,13,"ٱلسُّوٓءَ","كلَّ ما يَسُوءُه، ومنه خيانةُ سَيِّدِه."],[14,14,"وَٱلۡفَحۡشَآءَ","ما يَشْتَدُّ قُبْحُه من المعاصي، ومنه الزِّنى."],[18,18,"ٱلۡمُخۡلَصِينَ","المختارِين لطاعةِ اللهِ ورسالتِه."]],"25":[[0,1,"وَٱسۡتَبَقَا ٱلۡبَابَ","تسابَقا إليه، هو يريدُ الخروجَ وهي تمنعُه."],[2,5,"وَقَدَّتۡ قَمِيصَهُۥ مِن دُبُرٍ","شَقَّتْه طُولًا مِن خَلْفٍ."],[6,7,"وَأَلۡفَيَا سَيِّدَهَا","وجدا زوجَها."]],"26":[[5,6,"وَشَهِدَ شَاهِدٌ","صَبِيٌّ في المهد أنطقَه اللهُ ببراءته."]],"28":[[9,9,"كَيۡدِكُنَّ","احتيالِكنَّ ومَكْرِكنَّ."]],"30":[[11,12,"شَغَفَهَا حُبًّا","دَخَلَ حُبُّه إلى غِلاف قلبِها، حتى تَمَكَّنَ."]],"31":[[2,2,"بِمَكۡرِهِنَّ","باغتيابِهنَّ لها واحتيالِهنَّ في ذَمِّها."],[5,5,"أَعۡتَدَتۡ","هَيَّأت."],[7,7,"مُتَّكَـًٔا","ما يَتَّكِئْنَ عليه من الوَسائدِ ونحوِها."],[18,18,"أَكۡبَرۡنَهُۥ","أعْظَمْنَه، ودَهِشْنَ من جَمالِه الرائعِ."],[19,20,"وَقَطَّعۡنَ أَيۡدِيَهُنَّ","جَرَحْنَها بالسَّكاكين؛ لانشغالِهنَّ بحُسْنِه."],[22,23,"حَـٰشَ لِلَّهِ","معاذَ اللهِ وتنزيهًا له."]],"32":[[9,9,"فَٱسۡتَعۡصَمَ","امتنَع وأبى."],[18,18,"ٱلصَّـٰغِرِينَ","الأذِلّاءِ المُهانِين."]],"33":[[12,13,"أَصۡبُ إِلَيۡهِنَّ","أمِلْ إلى إجابتِهنَّ."],[16,16,"ٱلۡجَـٰهِلِينَ","الذين يرتكِبُون الإثمَ؛ لجَهْلِهم بعواقِبه."]],"35":[[1,1,"بَدَا","ظَهَر."],[7,7,"ٱلۡـَٔايَـٰتِ","الأدلَّةَ على براءةِ يوسفَ وعِفَّتِه."],[9,10,"حَتَّىٰ حِينٍ","إلى زمنٍ غيرِ محدَّدٍ."]],"36":[[9,9,"خَمۡرًا","عِنَبًا يصير خَمْرًا."],[22,22,"بِتَأۡوِيلِهِۦٓ","بتفسيرِ ما رَأَيْنا."]],"37":[[11,11,"ذَٰلِكُمَا","التعبيرُ للرؤيا، أو العِلْمُ بالغَيبِ."]],"40":[[6,6,"سَمَّيۡتُمُوهَآ","جَعَلْتُموها آلهةً، تَوَهُّمًا منكم وضلالًا."],[14,14,"سُلۡطَـٰنٍ","حُجَّةٍ تَدُلُّ على صحَّتِها."],[26,26,"ٱلۡقَيِّمُ","المستقيمُ، والثابتُ الذي لا شَكَّ فيه."]],"42":[[2,2,"ظَنَّ","عَلِمَ."],[8,8,"رَبِّكَ","سيِّدِكَ الملِكِ."],[9,10,"فَأَنسَىٰهُ ٱلشَّيۡطَـٰنُ","فأنسى الشيطانُ ساقِيَ المَلِكِ."],[11,12,"ذِكۡرَ رَبِّهِۦ","ذِكْرَ يوسُفَ عند سيِّده الملِكِ."],[16,16,"بِضۡعَ","من ثلاثٍ إلى تسعٍ."]],"43":[[9,9,"عِجَافٌ","جَمْعُ عَجْفاءَ، وهي التي بلغَتْ غايةَ الهُزال."],[23,23,"تَعۡبُرُونَ","تُفَسِّرُون."]],"44":[[1,2,"أَضۡغَـٰثُ أَحۡلَـٰمٍ","تَخاليطُ مَناماتٍ كاذبةٍ."],[5,6,"بِتَأۡوِيلِ ٱلۡأَحۡلَـٰمِ","بتفسيرِ ما يراه النائمون ممّا لا حقيقةَ له."]],"45":[[4,4,"وَٱدَّكَرَ","تَذَكَّرَ أمْرَ يوسُفَ."],[6,6,"أُمَّةٍ","مُدَّةٍ."]],"47":[[4,4,"دَأَبًا","جادِّين على عادتِكم."],[5,6,"فَمَا حَصَدتُّمۡ","ما قَطَعْتُموه حالَ نُضْجِه."],[7,7,"فَذَرُوهُ","اترُكُوه وادَّخِرُوه."]],"48":[[6,6,"شِدَادٌ","شديدةُ الجَدْبِ."],[7,10,"يَأۡكُلۡنَ مَا قَدَّمۡتُمۡ لَهُنَّ","يأكلُ الناسُ كلَّ ما ادَّخَرْتُم لأجْلِهنَّ."],[14,14,"تُحۡصِنُونَ","تُخَبِّئونه من البَذْرِ للزِّراعةِ."]],"49":[[7,8,"يُغَاثُ ٱلنَّاسُ","يأتيهم المطرُ."],[10,10,"يَعۡصِرُونَ","ما يُعْصَرُ من الثِّمارِ؛ لكثرةِ الخيرِ."]],"50":[[10,10,"رَبِّكَ","سيِّدِكَ الملِكِ."],[12,14,"مَا بَالُ ٱلنِّسۡوَةِ","ما شأنُهنَّ وحقيقةُ أمْرِهنَّ معي؟"],[16,17,"قَطَّعۡنَ أَيۡدِيَهُنَّ","جَرَحْنَها بالسَّكاكين."],[20,20,"بِكَيۡدِهِنَّ","باحتيالهنَّ ومَكْرِهنَّ."]],"51":[[1,2,"مَا خَطۡبُكُنَّ","ما شأنكُنَّ؟"],[9,10,"حَـٰشَ لِلَّهِ","معاذَ اللهِ وتنزيهًا له."]],"52":[[0,0,"ذَٰلِكَ","أي: ما قُلْتُه في تنزيهِ يوسفَ، واعترافي بإغرائه."],[1,1,"لِيَعۡلَمَ","أي: زوجي."],[3,5,"لَمۡ أَخُنۡهُ بِٱلۡغَيۡبِ","لم تَقَعْ مني الفاحشةُ والأبوابُ مُغَلَّقَةٌ."],[8,9,"لَا يَهۡدِي","لا يُوَفِّقُ."]],"54":[[4,5,"أَسۡتَخۡلِصۡهُ لِنَفۡسِي","أجْعَلْ يوسفَ مِن خاصَّتي وأهلِ مَشُورتي."],[12,12,"مَكِينٌ","ذو مَكانةٍ رفيعةٍ وقولٍ نافذٍ."]],"55":[[4,4,"ٱلۡأَرۡضِ","أرضِ مصرَ."]],"56":[[0,0,"وَكَذَٰلِكَ","وكما أنْعَمْنا على يوسفَ بالخَلاصِ من السِّجْنِ."],[5,6,"يَتَبَوَّأُ مِنۡهَا","يَنْزِلُ من بلاد مِصرَ."]],"58":[[8,8,"مُنكِرُونَ","لم يَعْرِفُوا يوسفَ لطولِ المدةِ، وتَغَيُّرِهيئتِه."]],"59":[[1,2,"جَهَّزَهُم بِجَهَازِهِمۡ","هيَّأ لهم ما هم في حاجةٍ إليه من طعامٍ ومَتاعٍ."],[16,16,"ٱلۡمُنزِلِينَ","المُضِيفِين."]],"61":[[1,3,"سَنُرَٰوِدُ عَنۡهُ أَبَاهُ","سنجتهدُ في استمالةِ أبيه برِفْقٍ؛ ليُرْسِلَه معنا."]],"62":[[1,1,"لِفِتۡيَـٰنِهِ","غِلْمانِ يوسفَ."],[3,5,"بِضَـٰعَتَهُمۡ فِي رِحَالِهِمۡ","ثمنَ ما اشترَوْه في أمتعتِهم."],[9,9,"ٱنقَلَبُوٓاْ","رَجَعُوا."]],"63":[[6,8,"مُنِعَ مِنَّا ٱلۡكَيۡلُ","حُكِمَ بمَنعِه عنّا بعدَ هذه المرَّةِ."],[12,12,"نَكۡتَلۡ","نَحصُلْ على ما نَحْتاج إليه مُقَدَّرًا بالكَيْلِ."]],"65":[[2,2,"مَتَـٰعَهُمۡ","أوْعِيتَهم، أو أمتعتَهم."],[9,10,"مَا نَبۡغِي","ماذا نَطْلُبُ أكثرَ من هذا الإكرامِ؟"],[15,16,"وَنَمِيرُ أَهۡلَنَا","نَجْلُبُ لهم الطعامَ."]],"66":[[6,8,"مَوۡثِقًا مِّنَ ٱللَّهِ","عَهْدًا، وتُؤَكِّدُوه بالحَلِفِ باللهِ."],[13,14,"يُحَاطَ بِكُمۡ","تُغْلَبُوا، فلا تَسْتطيعوا الإتيانَ به، أو تَهْلِكُوا جميعًا."],[23,23,"وَكِيلٌ","رقيبٌ مُطَّلعٌ."]],"67":[[11,13,"وَمَآ أُغۡنِي عَنكُم","لا أدْفَعُ عنكم."],[22,23,"عَلَيۡهِ تَوَكَّلۡتُ","اعتمَدْتُ على ربي وفَوَّضْتُ أمري إليه."]],"68":[[15,18,"حَاجَةً فِي نَفۡسِ يَعۡقُوبَ","وهي شَفَقَتُه على أولادِه أن تصيبَهم العَيْنُ."],[19,19,"قَضَىٰهَا","أدْرَكَها، ووَصّى أولادَه باتِّقائِها."]],"69":[[4,6,"ءَاوَىٰٓ إِلَيۡهِ أَخَاهُ","ضَمَّ إليه شقيقَه بِنْيامينَ."],[11,12,"فَلَا تَبۡتَئِسۡ","فلا تَحْزَنْ."]],"70":[[4,4,"ٱلسِّقَايَةَ","إناءٌ للشُّرْبِ، وهو هنا المِكيالُ الذي يُكالُ به الطَّعامُ."],[9,10,"أَذَّنَ مُؤَذِّنٌ","نادى مُنادٍ."],[12,12,"ٱلۡعِيرُ","القافلةُ المحمَّلةُ بالطَّعام."]],"72":[[2,3,"صُوَاعَ ٱلۡمَلِكِ","المكيالَ الذي يَكيلُ به."],[11,11,"زَعِيمٌ","ضامِنٌ وكفيلٌ."]],"75":[[1,5,"جَزَٰٓؤُهُۥ مَن وُجِدَ فِي رَحۡلِهِۦ","عقوبةُ سَرِقَتِه استرقاقُ مَن وُجِدَ المِكْيالُ في مَتاعِه."]],"76":[[10,12,"كَذَٰلِكَ كِدۡنَا لِيُوسُفَ","يَسَّرْنا له هذا التدبيرَ الخَفِيَّ للتوصُّلِ إلى غَرَضِه."],[18,19,"دِينِ ٱلۡمَلِكِ","شريعةِ مَلِكِ مصرَ."]],"77":[[9,9,"أَسَرَّهَا","فأخفى يوسفُ مقالَتَهم التي سَمِعَها مِن نِسْبَتِهم إياه إلى السَّرِقَةِ."],[19,19,"مَّكَانًا","مَنزِلَةً."]],"79":[[1,2,"مَعَاذَ ٱللَّهِ","نَسْتجيرُ باللّٰهِ ونعتصِمُ به."],[8,8,"مَتَـٰعَنَا","مِكْيالَنا الَّذي نَكِيلُ به الطَّعامَ."]],"80":[[1,2,"ٱسۡتَيۡـَٔسُواْ مِنۡهُ","يَئِسُوا من إجابةِ يوسفَ لمَطْلبِهم."],[3,3,"خَلَصُواْ","انفردُوا عن الناسِ."],[4,4,"نَجِيًّا","مُتَسارِّين يتشاوَرُون بينهم."],[14,16,"مَّوۡثِقًا مِّنَ ٱللَّهِ","عَهْدًا وأكّدْتُموه بالحَلِفِ باللهِ."],[19,20,"مَا فَرَّطتُمۡ","قَصَّرْتُم."],[23,25,"فَلَنۡ أَبۡرَحَ ٱلۡأَرۡضَ","لن أُفارِقَ أرضَ مصرَ."]],"81":[[13,16,"وَمَا كُنَّا لِلۡغَيۡبِ حَـٰفِظِينَ","ولم نَدْرِ حين عاهَدْناك على رَدِّه أنه سيَسْرِقُ."]],"82":[[5,5,"وَٱلۡعِيرَ","القافلةَ."],[7,8,"أَقۡبَلۡنَا فِيهَا","عُدْنا فيها."]],"83":[[2,2,"سَوَّلَتۡ","زَيَّنَتْ."],[6,7,"فَصَبۡرٌ جَمِيلٌ","وهو ما لا جَزَعَ فيه، ولا شَكْوى معه لأحدٍ من الخَلْقِ."]],"84":[[0,1,"وَتَوَلَّىٰ عَنۡهُمۡ","أعرضَ يعقوبُ عن خِطابِهم."],[3,3,"يَـٰٓأَسَفَىٰ","يا حُزني الشديدَ."],[6,7,"وَٱبۡيَضَّتۡ عَيۡنَاهُ","بذَهابِ سوادِهما، مما أدّى إلى ضَعْف بَصَرِه أو ذَهابِه."],[11,11,"كَظِيمٌ","ممتلئُ القلب حُزْنًا، يَكْتُمُه ولا يُبْدِيه."]],"85":[[2,2,"تَفۡتَؤُاْ","لا تَزالُ."],[7,7,"حَرَضًا","مُشرِفًا على الهَلاكِ."]],"86":[[3,3,"بَثِّي","هَمِّي الشديدَ."]],"87":[[2,4,"فَتَحَسَّسُواْ مِن يُوسُفَ","تَعَرَّفُوا وتَطَلَّبُوا خبرَه."],[9,10,"رَّوۡحِ ٱللَّهِ","رحمتِه وفَرَجِه."]],"88":[[8,8,"ٱلضُّرُّ","الشِّدَّةُ والجوعُ من الجَدْبِ."],[11,11,"مُّزۡجَىٰةٍ","رديئةٍ قليلةٍ."]],"90":[[10,12,"مَنَّ ٱللَّهُ عَلَيۡنَآ","تَفضَّلَ علينا بالسَّلامةِ والاجتماعِ."]],"91":[[3,5,"ءَاثَرَكَ ٱللَّهُ عَلَيۡنَا","اختارك وفَضَّلَكَ علينا بما خَصَّكَ به من صفاتِ الكمالِ."]],"92":[[1,2,"لَا تَثۡرِيبَ","لا تأنيبَ ولا لَوْمَ."]],"93":[[7,8,"يَأۡتِ بَصِيرًا","يَرْجِعُ إليه بَصَرُهُ."]],"94":[[1,2,"فَصَلَتِ ٱلۡعِيرُ","خرجَتِ القافلةُ من مصرَ قاصدةً الشّامَ."],[6,8,"لَأَجِدُ رِيحَ يُوسُفَ","لَأَشُمُّ رائحتَه."],[11,11,"تُفَنِّدُونِ","تَسْخَرُوا مني وتنسِبُوني إلى العَجْزِ، وضَعْفِ الرأيِ، أو تُكَذِّبوني."]],"95":[[4,4,"ضَلَـٰلِكَ","خَطَئِك وبُعْدِك عن الصوابِ في حُبِّ يوسفَ."]],"96":[[3,3,"ٱلۡبَشِيرُ","الذي بَشَّرَ يعقوبَ بأنّ يوسفَ حيٌّ."]],"99":[[4,6,"ءَاوَىٰٓ إِلَيۡهِ أَبَوَيۡهِ","ضَمَّهما وأنزلَهما عنده."]],"100":[[0,3,"وَرَفَعَ أَبَوَيۡهِ عَلَى ٱلۡعَرۡشِ","أجْلَسَهما بجانبِه على سريرِ مُلْكِه؛ إكرامًا لهما."],[4,4,"وَخَرُّواْ","هَوى أبوه وإخوتُه إلى الأرضِ."],[5,6,"لَهُۥ سُجَّدًا","ساجدين تكريمًا ليوسفَ، على عادتِهم في تحيةِ الملُوك وأشباهِهم."],[9,13,"هَـٰذَا تَأۡوِيلُ رُءۡيَـٰيَ مِن قَبۡلُ","أي: هذا السجودُ تفسيرٌ وتصديقٌ للرؤيا التي رأيتُها في صِغَري."],[17,17,"حَقًّا","صِدْقًا، وليسَتْ من أكاذيبِ الأحلامِ."],[19,20,"أَحۡسَنَ بِيٓ","أفاض اللهُ عليَّ من نِعَمِه."],[28,28,"ٱلۡبَدۡوِ","باديةِ الشّامِ."],[32,33,"نَّزَغَ ٱلشَّيۡطَـٰنُ","أفسَدَ وأغوى؛ لأنه هو سببُ الإفسادِ."],[39,39,"لَطِيفٌ","عليمٌ بخَفايا الأمورِ، مُدَبِّرٌ لها،ومُسَهِّلٌ لصعابِها."]],"101":[[3,4,"مِنَ ٱلۡمُلۡكِ","مُلْكِ مِصْرَ."],[7,8,"تَأۡوِيلِ ٱلۡأَحَادِيثِ","تفسير الرُّؤى، وغيرِها من العِلْمِ."],[9,11,"فَاطِرَ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ","يا خالقَهما ومُبْدِعَهما."],[13,13,"وَلِيِّۦ","مُتَوَلِّي حِفْظي وجميعِ شأني."]],"102":[[0,0,"ذَٰلِكَ","ما ذُكِرَ من قصةِ يوسفَ وإخوانِه."],[6,8,"وَمَا كُنتَ لَدَيۡهِمۡ","وما كنتَ حاضرًا مع إخوةِ يوسفَ."],[10,11,"أَجۡمَعُوٓاْ أَمۡرَهُمۡ","حينَ دبَّرُوا إلقاءَه في جوفِ البئرِ وظُلْمَتِه."],[12,13,"وَهُمۡ يَمۡكُرُونَ","يَحْتالُون في خُفْيَةٍ؛ لإيقاعِ الأذى والشَّرِّ به."]],"103":[[2,2,"ٱلنَّاسِ","مُشْركِي قومِك."]],"105":[[0,0,"وَكَأَيِّن","وكثيرٌ."],[1,2,"مِّنۡ ءَايَةٍ","من الدلائلِ الدالَّةِ على وحْدانيةِ اللهِ وقدرتِه."],[6,7,"يَمُرُّونَ عَلَيۡهَا","يشاهِدُونها."]],"106":[[5,6,"وَهُم مُّشۡرِكُونَ","فهم يَخْلِطُون مع إيمانِهم باللهِ ربًّا الإشراكَ في ألوهيَّتِه وعبادتِه."]],"107":[[3,3,"غَـٰشِيَةٌ","عقوبةٌ في الدنيا تَعُمُّهم."],[10,10,"بَغۡتَةً","فَجْأةً."]],"108":[[7,7,"بَصِيرَةٍ","يقينٍ وحُجَّةٍ واضحةٍ."]],"109":[[9,10,"أَهۡلِ ٱلۡقُرَىٰٓ","المدنِ والحاضرةِ."]],"110":[[2,3,"ٱسۡتَيۡـَٔسَ ٱلرُّسُلُ","يَئِسوا من إيمانِ قومِهم."],[4,7,"وَظَنُّوٓاْ أَنَّهُمۡ قَدۡ كُذِبُواْ","وظَنَّ المُرْسَلُ إليهم أن الرُّسَلَ قد كَذَبُوهم فيما أخبرُوهم عن اللهِ."],[8,9,"جَآءَهُمۡ نَصۡرُنَا","جاء نَصْرُنا لرُسِلِنا عند شِدَّةِ الكَرْبِ."],[15,15,"بَأۡسُنَا","عذابُنا."]],"111":[[4,4,"عِبۡرَةٌ","عِظَةٌ."],[5,6,"لِّأُوْلِي ٱلۡأَلۡبَـٰبِ","أصحابِ العقولِ السليمةِ."],[7,8,"مَا كَانَ","أي: هذا القرآنُ."],[10,10,"يُفۡتَرَىٰ","يُخْتَلَقُ."],[12,15,"تَصۡدِيقَ ٱلَّذِي بَيۡنَ يَدَيۡهِ","أي: القرآنُ يَشْهَدُ على صِدْقِ ما تقدَّمه من الكتبِ المنزَّلةِ، وأنها من عندِ اللهِ."],[16,18,"وَتَفۡصِيلَ كُلِّ شَيۡءٍ","تبيينَ ما يَحْتاجُ إليه العبادُ من أمورِ الدينِ."]]}