{"1":[[0,0,"سَبَّحَ","نَزَّهَ."]],"2":[[3,4,"ٱلَّذِينَ كَفَرُواْ","هُم بنُو النَّضِيرِ مِنَ اليهُودِ."],[9,9,"دِيَـٰرِهِمۡ","مَساكِنِهِم الَّتِي جاوَرُوا بِها المسْلِمِينَ حَوْلَ «المدينةِ»."],[10,11,"لِأَوَّلِ ٱلۡحَشۡرِ","عِنْدَ أوَّلِ جَمْعِهِم لِلْخُرُوجِ مِن جَزِيرةِ العَرَبِ."],[18,18,"مَّانِعَتُهُمۡ","تَدْفَعُ عَنْهُم."],[22,23,"فَأَتَىٰهُمُ ٱللَّهُ","فَجاءَهُم أمْرُ اللهِ."],[24,27,"مِنۡ حَيۡثُ لَمۡ يَحۡتَسِبُواْ","مِن مَكانٍ لم يَظُنُّوهُ."],[28,28,"وَقَذَفَ","وجَعَل."],[31,31,"ٱلرُّعۡبَ","الخَوْفَ والفَزَعَ الشَّدِيدَ."],[37,37,"فَٱعۡتَبِرُواْ","فاتَّعِظُوا."],[38,39,"يَـٰٓأُوْلِي ٱلۡأَبۡصَـٰرِ","أصْحابَ البَصائِر السَّلِيمَةِ، والعُقُولِ الرّاجِحَةِ."]],"3":[[5,5,"ٱلۡجَلَآءَ","الخُرُوجَ مِنَ الوطنِ بِنِيَّةِ عَدَمِ العَوْدِ."]],"4":[[2,2,"شَآقُّواْ","خالفُوا."]],"5":[[3,3,"لِّينَةٍ","نَخْلَةٍ ذاتِ ثَمَرٍ طَيِّبٍ."],[8,8,"أُصُولِهَا","قَواعِدِها، والمرادُ: سُوقُ النَّخْلِ."],[11,11,"وَلِيُخۡزِيَ","ولِيُهِينَ."],[12,12,"ٱلۡفَـٰسِقِينَ","الكافِرِينَ، وهُمْ يَهُودُ بَنِي النَّضِيرِ."]],"6":[[0,4,"وَمَآ أَفَآءَ ٱللَّهُ عَلَىٰ رَسُولِهِۦ","وما أعطاهُ اللهُ لِرَسُولِه مما يَظْفَرُ بِهِ الجيشُ مِن عَدُوِّهِم."],[6,7,"فَمَآ أَوۡجَفۡتُمۡ","فَما أرْكَضْتُم للإغارَةِ، وأَوْجَفَهُ: حَمَلَهُ عَلى السَّيرِ السَّرِيعِ."],[12,12,"رِكَابٍ","الإبِلِ الَّتِي تُرْكَبُ."]],"7":[[7,7,"ٱلۡقُرَىٰ","قُرىً فُتِحَتْ في عَهْدِ الرَّسُولِ ﷺ."],[8,9,"فَلِلَّهِ وَلِلرَّسُولِ","أي يُصْرَفُ في مصالِحِ المسْلِمِينَ."],[10,11,"وَلِذِي ٱلۡقُرۡبَىٰ","ولِذِي قَرابَةِ رَسُولِ اللهِ ﷺ، وهم بنُو هاشِم، وبنُو المطَّلِبِ."],[12,12,"وَٱلۡيَتَـٰمَىٰ","الأَطْفالِ الَّذِين ماتَ آباؤُهم، وهم دُونَ سِنِّ البُلُوغِ."],[13,13,"وَٱلۡمَسَـٰكِينِ","هم أهلُ الحاجةِ الَّذِينَ لا يَمْلِكُونَ ما يَسُدُّ حاجَتَهَم."],[14,15,"وَٱبۡنِ ٱلسَّبِيلِ","هو الغريبُ المسافِر الَّذِي نَفِدَتْ نَفَقَتُهُ."],[19,21,"دُولَةَۢ بَيۡنَ ٱلۡأَغۡنِيَآءِ","مُداوَلَةً يَتَداولُه الأَغْنِياءُ ويتعاقَبُونَ في التَّصَرُّفِ فِيهِ."]],"9":[[1,1,"تَبَوَّءُو","اسْتَوطَنُوا وتَمَكَّنُوا."],[2,2,"ٱلدَّارَ","المدِينَةَ، وهي دارُ الهِجْرَةِ."],[14,14,"حَاجَةً","حَسَدًا."],[15,16,"مِّمَّآ أُوتُواْ","مِمّا أُعْطِي المهاجِرُونَ من فَيْءِ بَنِي النَّضِيرِ."],[17,19,"وَيُؤۡثِرُونَ عَلَىٰٓ أَنفُسِهِمۡ","ويُقَدِّمُونَ غيرَهُم مِنَ المهاجِرِينَ وذَوِي الحاجةِ عَلى أنْفُسِهِم."],[23,23,"خَصَاصَةٌ","شِدَّةُ احْتِياجٍ."],[24,25,"وَمَن يُوقَ","ومَن سَلَّمَهُ اللهُ فمُنِعَ."],[26,27,"شُحَّ نَفۡسِهِۦ","بُخْلَها مَعَ حِرْصِها."],[30,30,"ٱلۡمُفۡلِحُونَ","الفائِزُونَ بِمَطْلُوبِهِم."]],"10":[[12,12,"غِلًّا","حَسَدًا وحِقْدًَا."]],"11":[[7,11,"ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَـٰبِ","هم بَنُو النَّضِيرِ."],[16,18,"وَلَا نُطِيعُ فِيكُمۡ","أي في ضُرِّكُم."]],"12":[[9,10,"وَلَئِن نَّصَرُوهُمۡ","ولئِنْ أرادُوا نُصْرَتَهُم."],[13,15,"ثُمَّ لَا يُنصَرُونَ","أي لا يَغْلِبُونَ."]],"13":[[2,2,"رَهۡبَةً","خَوْفًا."]],"14":[[6,6,"مُّحَصَّنَةٍ","ممنُوعَةٍ بأسْوارٍ أو خَنادِقَ مِمَّن يُرِيدُ أخْذَها."],[10,10,"جُدُرِۭ","حِيطانٍ."],[11,11,"بَأۡسُهُم","قوَّتُهُم."],[17,17,"شَتَّىٰ","مُتَفَرِّقَةٌ"]],"15":[[6,7,"وَبَالَ أَمۡرِهِمۡ","سُوءَ عاقِبَةِ كُفْرِهِم وعَداوَتِهِم لِلرَّسُولِ ﷺ."]],"18":[[7,8,"مَّا قَدَّمَتۡ","أي: مِنَ الأعْمالِ."],[9,9,"لِغَدٍ","يومِ القِيامةِ."]],"19":[[3,4,"نَسُواْ ٱللَّهَ","تَرَكُوا أداءَ حَقِّ اللهِ الَّذِي أوْجَبَهُ عَلَيهِم."],[5,6,"فَأَنسَىٰهُمۡ أَنفُسَهُمۡ","مِمّا يُنَجِّيهِم مِنَ عَذابِ يَوْمِ القِيامةِ."],[9,9,"ٱلۡفَـٰسِقُونَ","الخارجُونَ عَن طاعَةِ اللهِ ورَسُولِهِ."]],"21":[[7,7,"خَـٰشِعًا","خاضِعًا مُتَذَلِّلًا."],[8,8,"مُّتَصَدِّعًا","مُتَشَقِّقًا."],[14,14,"نَضۡرِبُهَا","نُوَضِّحُها."]],"22":[[7,9,"عَـٰلِمُ ٱلۡغَيۡبِ وَٱلشَّهَـٰدَةِ","يَعْلَمُ ما غابَ وما حَضَرَ."]],"23":[[7,7,"ٱلۡمَلِكُ","المالِكُ لجمِيعِ الأشْياءِ، المتَصَرِّفُ فِيها بِلا مُمانَعَةٍ ولا مُدافَعَةٍ."],[8,8,"ٱلۡقُدُّوسُ","المُنَزَّهُ عَن كُلِّ نَقْصٍ."],[9,9,"ٱلسَّلَـٰمُ","الَّذِي سَلِمَ مِن كُلِّ عيبٍ."],[10,10,"ٱلۡمُؤۡمِنُ","المصَدِّقُ رُسُلَه وأنبياءَه بِما أرْسَلَهُم بِهِ."],[11,11,"ٱلۡمُهَيۡمِنُ","الرَّقِيبُ على خَلْقِهِ في أعمالِهِم."],[12,12,"ٱلۡعَزِيزُ","الَّذِي لا يُغالَبُ."],[13,13,"ٱلۡجَبَّارُ","الَّذِي قَهَرَ جَميعَ العِبادِ، وأَذْعَنُوا لَهُ."],[14,14,"ٱلۡمُتَكَبِّرُ","الَّذِي له الكبرياءُ والعَظَمَةُ."],[15,16,"سُبۡحَـٰنَ ٱللَّهِ","تنَزَّهَ اللهُ."]],"24":[[2,2,"ٱلۡخَـٰلِقُ","المقَدِّرُ لِلْخَلْقِ."],[3,3,"ٱلۡبَارِئُ","المنْشِئُ لِلْخَلْقِ."],[4,4,"ٱلۡمُصَوِّرُ","صَوَّر خَلْقَهُ كَيفَ يَشاءُ."],[15,15,"ٱلۡعَزِيزُ","الشَّدِيدُ الانتِقامِ مِن أعدائِهِ."],[16,16,"ٱلۡحَكِيمُ","في تَدْبِيرِه أُمُورَ خَلْقِه."]]}