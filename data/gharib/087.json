{"1":[[0,0,"سَبِّحِ","نَزِّه عَن كُلِّ ما لا يَليقُ بِهِ."]],"2":[[2,2,"فَسَوَّىٰ","فَأَتْقَنَ خَلْقَ الإنسانِ."]],"3":[[2,2,"فَهَدَىٰ","الإنسانَ لِسبيلِ الخير والشر، وهدى الأنعام لمراتعها."]],"4":[[2,2,"ٱلۡمَرۡعَىٰ","الكلأ الأخضر."]],"5":[[1,1,"غُثَآءً","هشيمًا جافًّا."],[2,2,"أَحۡوَىٰ","مُتَغَيِّرًا إلى السَّوادِ بَعْدَ الخُضْرَةِ."]],"6":[[0,0,"سَنُقۡرِئُكَ","سنُعْلِمُكَ بِقراءةِ جِبريلَ عَلَيكَ."]],"7":[[0,3,"إِلَّا مَا شَآءَ ٱللَّهُ","أن تَنْساهُ وما نَسَخَ اللهُ تِلاوتَهُ."]],"8":[[0,0,"وَنُيَسِّرُكَ","وُنَهوِّنُ عَلَيكَ."],[1,1,"لِلۡيُسۡرَىٰ","عَمَلِ أهْلِ الجنَّةِ."]],"9":[[0,0,"فَذَكِّرۡ","فَعِظْ بالقرآنِ."],[1,3,"إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","إن رُجِيَ مِنهُ التَّذَكُّرُ."]],"10":[[0,0,"سَيَذَّكَّرُ","سيَتَّعِظُ."]],"11":[[1,1,"ٱلۡأَشۡقَى","الَّذِي لا يَخْشى رَبَّهُ، وشَقِيَ فِي عِلْمِ اللهِ."]],"12":[[1,1,"يَصۡلَى","يُقاسِي حرَّها."],[2,3,"ٱلنَّارَ ٱلۡكُبۡرَىٰ","نارَ جَهَنَّمَ العُظْمى."]],"13":[[1,3,"لَا يَمُوتُ فِيهَا","فَيَسْتَرِيحَ."],[4,5,"وَلَا يَحۡيَىٰ","حياةً تَنفَعُهُ."]],"14":[[1,1,"أَفۡلَحَ","فازَ."],[3,3,"تَزَكَّىٰ","طَهَّرَ نَفسَهُ مِنَ الأخْلاقِ السَّيِّئةِ."]],"16":[[1,1,"تُؤۡثِرُونَ","تُفَضِّلُونَ."]],"18":[[1,1,"هَـٰذَا","ما ذُكِرَ مِن قولِه تعالى:(قَدۡ أفۡلَحَ مَن تَزَكّى) إلى تَمامِ أرْبَعِ آياتٍ."],[3,4,"ٱلصُّحُفِ ٱلۡأُولَىٰ","الكُتُبِ الأُولى الَّتِي أُنزِلَت قَبْلَ القُرآنِ."]]}