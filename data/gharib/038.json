{"2":[[4,4,"عِزَّةٍ","تكبُّرٍ عَنِ الحقِّ."],[5,5,"وَشِقَاقٍ","مُشاقَّةٍ ومُخالَفةٍ للهِ ولِرَسُولِهِ."]],"3":[[0,1,"كَمۡ أَهۡلَكۡنَا","كَثِيرًا أهْلَكْنا."],[4,5,"مِّن قَرۡنٍ","مِن أُمَّةٍ."],[6,6,"فَنَادَواْ","فاسْتَغاثُوا حِينَ عايَنُوا العَذابَ."],[7,7,"وَّلَاتَ","ولَيسَ."],[8,9,"حِينَ مَنَاصٍ","وقتَ فِرارٍ."]],"4":[[3,4,"مُّنذِرٌ مِّنۡهُمۡ","رَسُولٌ مِنهُم."]],"5":[[7,7,"عُجَابٌ","عَجِيبٌ."]],"6":[[1,1,"ٱلۡمَلَأُ","أشْرافُ القوم ورُؤساؤُهُم."],[3,4,"أَنِ ٱمۡشُواْ","أنِ امْضُوا على ما كُنتُم عَلَيهِ ولا تَدْخُلُوا في دِينِه."],[5,7,"وَٱصۡبِرُواْ عَلَىٰٓ ءَالِهَتِكُمۡ","أي: اثبُتُوا على عِبادَتِها."],[10,11,"لَشَيۡءٌ يُرَادُ","أي: شَيءٌ مُدَبَّرٌ يُريدُهُ محمدٌ بِنا وبآلَهتِنا؛ لِيَتَحَكَّمَ فِينا بِما يُرِيدُ."]],"7":[[4,5,"ٱلۡمِلَّةِ ٱلۡـَٔاخِرَةِ","هي النَّصْرانِيَّةُ، أو دِينُ قُرَيشٍ."],[8,9,"إِلَّا ٱخۡتِلَـٰقٌ","إلا كَذِبٌ اختَلَقَهُ محمدٌ وافْتَراهُ."]],"10":[[7,7,"فَلۡيَرۡتَقُواْ","فَلْيَصْعَدُوا."],[9,9,"ٱلۡأَسۡبَـٰبِ","المعارِجِ إلى السَّماءِ."]],"11":[[0,2,"جُندٌ مَّا هُنَالِكَ","أي: هَؤُلاءِ الجُنْدُ المكذِّبُونَ الَّذينَ هُم في عِزَّةٍ وشِقاقٍ."],[3,5,"مَهۡزُومٌ مِّنَ ٱلۡأَحۡزَابِ","سَيُهْزَمُ هَذا الجُنْدُ ويُغلَبُ، كما هُزِمَ الَّذينَ مِن قَبْلِهِم مِنَ الأحْزابِ المكَذِّبِينَ."]],"12":[[7,7,"ٱلۡأَوۡتَادِ","صاحِبُ القُوَّةِ العظِيمةِ مِنَ الجُنُودِ والمبانِي الشّاهِقَةِ."]],"13":[[3,4,"وَأَصۡحَـٰبُ لۡـَٔيۡكَةِ","أصْحابُ الأشْجارِ والبَساتِينِ."]],"14":[[5,6,"فَحَقَّ عِقَابِ","فحَلَّ بهم عِقابِي وعَذابي."]],"15":[[1,1,"يَنظُرُ","يَنْتَظِرُ."],[4,5,"صَيۡحَةً وَٰحِدَةً","نَفْخَةً واحِدةً في الصُّورِ."],[6,9,"مَّا لَهَا مِن فَوَاقٍ","مالها مِن تَوقُّفٍ مِقْدارَ فَواقِ ناقَةٍ: وهو مابيَن حَلْبَتَيها مِنَ المدَّةِ القلِيلَةِ."]],"16":[[4,4,"قِطَّنَا","نصيبَنا مِنَ العذابِ."]],"17":[[7,8,"ذَا ٱلۡأَيۡدِ","صاحِبَ القُوَّةِ."],[10,10,"أَوَّابٌ","كَثِيرُ الرُّجُوعِ إلى اللهِ وطاعَتِهِ عَن كُلِّ ما يَكْرَهُهُ."]],"18":[[5,5,"بِٱلۡعَشِيِّ","بآخِرِ النَّهارِ."],[6,6,"وَٱلۡإِشۡرَاقِ","أوَّلِ النَّهارِ."]],"19":[[0,1,"وَٱلطَّيۡرَ مَحۡشُورَةً","أي: سَخَّرْنا الطَّيرَ مَجْمُوعَةً إليهِ تُسَبِّحُ اللهَ مَعَهُ."]],"20":[[0,1,"وَشَدَدۡنَا مُلۡكَهُۥ","أي: قَوَّيْناهُ بأسْبابِ القُوَّةِ كُلِّها."],[3,3,"ٱلۡحِكۡمَةَ","النُّبوَّةَ."],[4,5,"وَفَصۡلَ ٱلۡخِطَابِ","أي: الفَصْلَ في الكَلامِ والخُصُوماتِ."]],"21":[[2,3,"نَبَؤُاْ ٱلۡخَصۡمِ","خبرُ المتخاصِمَينِ."],[5,6,"تَسَوَّرُواْ ٱلۡمِحۡرَابَ","تَسَلَّقُوا مَكانَ عِبادَتِهِ وأتَوهُ مِن أعلى سُورِهِ."]],"22":[[4,4,"فَفَزِعَ","فَخافَ."],[10,10,"بَغَىٰ","ظَلَمَ وتَعدّى."],[16,16,"بِٱلۡحَقِّ","بالعَدْلِ."],[17,18,"وَلَا تُشۡطِطۡ","لا تَجُرْ في حُكْمِكَ."],[19,19,"وَٱهۡدِنَآ","أرْشِدْنا."],[21,22,"سَوَآءِ ٱلصِّرَٰطِ","وسَطِ الطَّرِيقِ وهو الطَّرِيقُ الحقُّ."]],"23":[[11,11,"أَكۡفِلۡنِيهَا","أعْطِنيها حتّى أكْفَلَها."],[12,12,"وَعَزَّنِي","غَلَبَني."],[13,14,"فِي ٱلۡخِطَابِ","في المُحاجَّةِ الكَلامِيَّةِ."]],"24":[[10,10,"ٱلۡخُلَطَآءِ","الشُّركاءِ."],[11,11,"لَيَبۡغِي","لَيَظْلِمُ ويَتَعَدّى."],[23,23,"وَظَنَّ","أيْقَنَ."],[26,26,"فَتَنَّـٰهُ","ابْتَلَيناهُ وامْتَحَنّاه."],[29,30,"وَخَرَّ رَاكِعًا","سَقَطَ ساجِدًا للهِ."],[31,31,"وَأَنَابَ","رَجَعَ إلى اللهِ بالتَّوبَةِ."]],"25":[[6,6,"لَزُلۡفَىٰ","لقُرْبةً ومَكانَةً."],[7,8,"وَحُسۡنَ مَـَٔابٍ","حُسْنَ مَرْجِعٍ في الآخِرَةِ، وهو الجنَّةُ."]],"26":[[9,9,"بِٱلۡحَقِّ","بالعَدْلِ والإنْصافِ."],[12,12,"ٱلۡهَوَىٰ","أي: هَوى النَّفْسِ المُخالِفَ لِلْحَقِّ."],[26,29,"بِمَا نَسُواْ يَوۡمَ ٱلۡحِسَابِ","أي: بِسَبَبِ تَرْكِهِم العَمَلَ لِيومِ الحِسابِ."]],"27":[[6,6,"بَـٰطِلًا","لَعِبًا وعَبَثًا."],[11,11,"فَوَيۡلٌ","فَهَلاكٌ."]],"29":[[4,4,"لِّيَدَّبَّرُوٓاْ","لِيَتَفكَّرُوا."],[6,6,"وَلِيَتَذَكَّرَ","ليتَّعِظَ."],[7,8,"أُوْلُواْ ٱلۡأَلۡبَـٰبِ","أصْحابُ العُقُولِ السَّلِيمَةِ."]],"30":[[6,6,"أَوَّابٌ","توّابٌ كثيرُ الرُّجُوعِ إلى اللهِ."]],"31":[[3,3,"بِٱلۡعَشِيِّ","بآخِرِ النَّهارِ (مِن بَعْدِ الزَّوالِ إلى الغُرُوبِ)."],[4,4,"ٱلصَّـٰفِنَـٰتُ","الخُيُولُ الأصِيلةُ الواقِفَةُ على ثَلاثِ قَوائِمَ وطرفِ حافِرِ الرّابِعَةِ."],[5,5,"ٱلۡجِيَادُ","السَّريعَةُ في الجَرْي."]],"32":[[2,4,"أَحۡبَبۡتُ حُبَّ ٱلۡخَيۡرِ","آثَرْتُ حُبَّ الخيلِ."],[9,10,"تَوَارَتۡ بِٱلۡحِجَابِ","غَرَبَتِ الشَّمسُ."]],"33":[[2,5,"فَطَفِقَ مَسۡحَۢا بِٱلسُّوقِ وَٱلۡأَعۡنَاقِ","فَشَرَعَ يَقْطَعُ سُوقَها وأعْناقَها بالسَّيفِ."]],"34":[[1,1,"فَتَنَّا","ابتَلَينا."],[6,6,"جَسَدًا","شِقَّ ولَدٍ وُلِد لَهُ."],[8,8,"أَنَابَ","رَجَعَ إلى اللهِ بالتَّوبَةِ."]],"36":[[0,1,"فَسَخَّرۡنَا لَهُ","فَذَلَّلْنا لَه."],[5,5,"رُخَآءً","لَيِّنةً طَيِّعةً."],[6,7,"حَيۡثُ أَصَابَ","حيثُ أرادَ."]],"37":[[2,2,"بَنَّآءٍ","يَبْنِي لَهُ ما يشاءُ."],[3,3,"وَغَوَّاصٍ","يَغُوصُ في البحْرِ لاسْتِخْراجِ نَفائِسِه."]],"38":[[1,3,"مُقَرَّنِينَ فِي ٱلۡأَصۡفَادِ","مُقَيَّدين في الأغْلالِ والسَّلاسِلِ."]],"39":[[2,4,"فَٱمۡنُنۡ أَوۡ أَمۡسِكۡ","فأعْطِ مَن شِئْتَ، وامنَعْ مَن شِئْتَ."]],"40":[[3,3,"لَزُلۡفَىٰ","لَقُرْبةً وكَرامةً."],[4,5,"وَحُسۡنَ مَـَٔابٍ","حُسْنَ مَرْجِعٍ في الآخِرَةِ، وهو الجَنّةُ."]],"41":[[9,9,"بِنُصۡبٍ","بِتَعَبٍ ومَشَقَّةٍ."],[10,10,"وَعَذَابٍ","ألَمٍ وضُرٍّ."]],"42":[[0,1,"ٱرۡكُضۡ بِرِجۡلِكَ","اضْرِبْ بِها الأرْضَ."]],"43":[[2,2,"أَهۡلَهُۥ","زَوْجَهُ ووَلَدَهُ."],[3,4,"وَمِثۡلَهُم مَّعَهُمۡ","وزِدْناهُ مِثْلَهُم بَنِينَ وحَفَدَةً."],[8,9,"لِأُوْلِي ٱلۡأَلۡبَـٰبِ","لأصْحابِ العُقُولِ السَّلِيمَةِ."]],"44":[[2,2,"ضِغۡثًا","حُزْمَةً مِنَ الحَشِيشِ ونَحْوِهِ."],[5,6,"وَلَا تَحۡنَثۡ","لا تَتْرُكِ الوفاءَ بِيَمِينِكَ."],[13,13,"أَوَّابٌ","رَجّاعٌ إلى طاعَةِ اللهِ."]],"45":[[5,6,"أُوْلِي ٱلۡأَيۡدِي","أصْحابَ القُوى في طاعةِ اللهِ."],[7,7,"وَٱلۡأَبۡصَـٰرِ","البصائرِ في الدِّينِ."]],"46":[[1,2,"أَخۡلَصۡنَـٰهُم بِخَالِصَةٍ","خَصَصْناهُم واصْطَفَيناهُم بِخاصَّةٍ عَظِيمَةٍ."],[3,4,"ذِكۡرَى ٱلدَّارِ","ذِكْرِ الدّارِ الآخرةِ في قُلُوبِهِم."]],"47":[[3,3,"ٱلۡمُصۡطَفَيۡنَ","الَّذينَ اخْتَرْناهُم لِرِسالَتِنا وطاعَتِنا."],[4,4,"ٱلۡأَخۡيَارِ","الُمخْتارِينَ الفضلاءِ المُخْتَصِّينَ بالخيرِ."]],"49":[[1,1,"ذِكۡرٌ","عِظَةٌ وشَرَفٌ لك أيُّها الرسولُ ولِقَومِكَ."],[5,5,"مَـَٔابٍ","مَصِيرٍ."]],"50":[[0,1,"جَنَّـٰتِ عَدۡنٍ","جَنّاتِ إقامَةٍ."]],"51":[[0,0,"مُتَّكِـِٔينَ","جالِسِينَ مُتَمَكِّنِينَ على السُّرُرِ."],[2,2,"يَدۡعُونَ","يَطْلُبُونَ."]],"52":[[1,2,"قَـٰصِرَٰتُ ٱلطَّرۡفِ","لا يَمْدُدْنَ أبْصارَهُنَّ إلى غَيْرِ أزْواجِهِنَّ."],[3,3,"أَتۡرَابٌ","مُتَساوِياتٌ في السِّنِّ."]],"54":[[6,6,"نَّفَادٍ","فَناءٍ وانْقِطاعِ."]],"55":[[2,2,"لِلطَّـٰغِينَ","الُمتَجاوِزِينَ الحَدَّ في الكُفْرِ والمعاصِي."],[4,4,"مَـَٔابٍ","مَرْجِعٍ ومَصِيرٍ."]],"56":[[1,1,"يَصۡلَوۡنَهَا","يُعذَّبُونَ فِيها، تَغْمُرُهُم مِن جَمِيعِ جَوانِبِهِم."],[3,3,"ٱلۡمِهَادُ","الفِراشُ."]],"57":[[2,2,"حَمِيمٌ","ماءٌ شَدِيدُ الحَرارَةِ."],[3,3,"وَغَسَّاقٌ","صَدِيدٌ سائِلٌ مِن أجْسادِ أهْلِ النّارِ."]],"58":[[0,0,"وَءَاخَرُ","عَذابٌ آخَرُ."],[2,2,"شَكۡلِهِۦٓ","مِثْلِه."],[3,3,"أَزۡوَٰجٌ","أصْنافٌ وألْوانٌ."]],"59":[[1,1,"فَوۡجٌ","جَماعَةٌ عَظِيمةٌ."],[2,2,"مُّقۡتَحِمٌ","داخِلٌ."],[8,9,"صَالُواْ ٱلنَّارِ","مُقاسُونَ حَرَّها."]],"60":[[7,8,"قَدَّمۡتُمُوهُ لَنَا","بَدَأْتُم بالكُفْرِ قَبْلنا وسَنَنْتُمُوهُ لَنا."],[10,10,"ٱلۡقَرَارُ","دارُ الاسْتِقْرارِ، وهي جَهَنَّمُ."]],"61":[[8,8,"ضِعۡفًا","مُضاعَفًا."]],"63":[[0,1,"أَتَّخَذۡنَـٰهُمۡ سِخۡرِيًّا","هَلْ أخْطأنا في تَحْقِيرِنا لَهُم، واسْتِهْزائِنا بِهِم؟"],[3,3,"زَاغَتۡ","لم تَقَعْ عَلَيهِم."]],"64":[[1,1,"ذَٰلِكَ","جِدالَ أهْلِ النّارِ وخِصامَهُم."]],"65":[[10,10,"ٱلۡقَهَّارُ","الَّذي قَهَرَ كُلَّ شَيءٍ وغَلَبَهُ."]],"67":[[2,3,"نَبَؤٌاْ عَظِيمٌ","خَبَرٌ عظِيمُ النَّفْعِ."]],"69":[[5,6,"بِٱلۡمَلَإِ ٱلۡأَعۡلَىٰٓ","مَلائِكَةِ السَّماءِ."]],"72":[[5,5,"رُّوحِي","رُوحِ الحَياةِ الَّتي يَخْلُقُها اللهُ."],[6,8,"فَقَعُواْ لَهُۥ سَـٰجِدِينَ","فاسْجُدُوا لَهُ سُجُودَ تَحِيَّةٍ وإكْرامٍ، لا سُجُودَ عِبادَةٍ وتَعْظِيمٍ."]],"75":[[9,9,"أَسۡتَكۡبَرۡتَ","أتَعَظَّمْتَ وتَكَبَّرْتَ الآنَ عَنِ السُّجُودِ لآدَمَ؟"],[10,13,"أَمۡ كُنتَ مِنَ ٱلۡعَالِينَ","أم كُنْتَ مِنَ الُمتَكَبِّرِينَ عَلى رَبِكَ مِن قَبْلُ."]],"77":[[4,4,"رَجِيمٌ","مَطْرُودٌ."]],"78":[[2,2,"لَعۡنَتِيٓ","طَرْدِي وإبْعادِي."],[5,5,"ٱلدِّينِ","الجَزاءِ."]],"79":[[2,2,"فَأَنظِرۡنِيٓ","فأخِّرْ أجَلِي، ولا تُهْلِكْنِي."]],"80":[[3,3,"ٱلۡمُنظَرِينَ","المُؤَخَّرِينَ."]],"81":[[0,3,"إِلَىٰ يَوۡمِ ٱلۡوَقۡتِ ٱلۡمَعۡلُومِ","إلى يومِ النَّفْخَةِ الأُولى الَّتي يَمُوتُ مِنها مَن بَقِيَ مِنَ الخلائِقِ."]],"83":[[3,3,"ٱلۡمُخۡلَصِينَ","الَّذينَ أخْلَصْتَهُم لِعِبادَتِكَ وعَصَمْتَهم من إضْلالِ الشَّيطانِ."]],"86":[[9,9,"ٱلۡمُتَكَلِّفِينَ","الُمتَقَوِّلينَ للقُرآنِ مِن تِلْقاءِ نَفْسِي."]],"87":[[3,3,"ذِكۡرٌ","تَذْكِيرٌ."]],"88":[[1,1,"نَبَأَهُۥ","خَبَرَ صِدْقِ القُرآنِ."],[2,3,"بَعۡدَ حِينِۭ","حِينَ يَغْلِبُ الإسْلامُ، وحيِنَ يَقَعُ عَلَيكُم العَذابُ."]]}