{"3":[[2,3,"ٱلدِّينُ ٱلۡخَالِصُ","الطّاعَةُ التّامَّةُ السّالِمَةُ مِنَ الشِّرْكِ."],[15,15,"زُلۡفَىٰٓ","قُرْبى."]],"4":[[6,6,"لَّٱصۡطَفَىٰ","لاخْتارَ."],[15,15,"ٱلۡقَهَّارُ","الَّذي قَهَرَ خَلْقَه بِقُدْرَتِهِ، فَكُلُّ شَيءٍ لَهُ مُتَذَلِّلٌ خاضِعٌ."]],"5":[[4,7,"يُكَوِّرُ ٱلَّيۡلَ عَلَى ٱلنَّهَارِ","يُدْخِلُ الليلَ على النَّهارِ."],[8,11,"وَيُكَوِّرُ ٱلنَّهَارَ عَلَى ٱلَّيۡلِ","يُدْخِلُ النَّهارَ على الليلِ."],[12,12,"وَسَخَّرَ","ذَلَّل."],[17,18,"لِأَجَلٍ مُّسَمًّى","إلى حِينِ قِيامِ السّاعةِ."]],"6":[[2,3,"نَّفۡسٍ وَٰحِدَةٍ","آدَمَ عَلَيهِ السَّلامُ."],[8,8,"وَأَنزَلَ","خَلَقَ."],[10,13,"مِّنَ ٱلۡأَنۡعَـٰمِ ثَمَـٰنِيَةَ أَزۡوَٰجٍ","ثمانيةَ أنْواعٍ ذَكَرًا وأُنْثى مِنَ الإبِلِ والبَقَرِ والضَّأنِ والَمعْزِ."],[18,21,"خَلۡقًا مِّنۢ بَعۡدِ خَلۡقٍ","طَوْرًا بَعْدَ طَورِ مِنَ الخَلْقِ."],[23,24,"ظُلُمَـٰتٍ ثَلَـٰثٍ","ظُلُماتِ البَطْنِ والرَّحِمِ والَمشِيمَةِ."],[34,35,"فَأَنَّىٰ تُصۡرَفُونَ","فَكَيفَ تَعْدِلُونَ عَنْ عِبادَةِ رَبِّكُم إلى عِبادَةِ غَيْرِه؟"]],"7":[[14,18,"وَلَا تَزِرُ وَازِرَةٌ وِزۡرَ أُخۡرَىٰ","ولا تُؤْخَذُ نَفْسٌ بإثْمِ غَيْرِها."],[29,30,"بِذَاتِ ٱلصُّدُورِ","بأسْرارِ النُّفُوسِ وما تُخْفِيهِ."]],"8":[[6,6,"مُنِيبًا","تائِبًا إليِهِ."],[10,10,"خَوَّلَهُۥ","مَنَحَه."],[22,22,"أَندَادًا","شُرَكاءَ."],[27,29,"تَمَتَّعۡ بِكُفۡرِكَ قَلِيلًا","تَمَتَّعْ بالسَّلامَةِ مِنَ العَذابِ زَمَنًا قَلِيلًا."]],"9":[[2,2,"قَـٰنِتٌ","عابدٌ لِرَبِّهِ، طائِعٌ لَهُ."],[3,3,"ءَانَآءَ","ساعاتِ."],[22,23,"أُوْلُواْ ٱلۡأَلۡبَـٰبِ","أصْحابُ العُقُولِ السَّلِيمَةِ."]],"10":[[11,11,"حَسَنَةٌ","في الدُّنيا بالعافِيةِ، وفي الآخِرةِ بالجنَّةِ."],[19,20,"بِغَيۡرِ حِسَابٍ","مِن غَيْرِ حَدٍّ ولا مِقْدارٍ."]],"12":[[3,4,"أَوَّلَ ٱلۡمُسۡلِمِينَ","أوَّلَ مَن أسْلَمَ مِن أُمَّتِي."]],"15":[[0,2,"فَٱعۡبُدُواْ مَا شِئۡتُم","صِيغَةُ أمْرٍ على جِهَةِ التَّهْدِيدِ."]],"16":[[3,3,"ظُلَلٌ","جَمْعُ ظُلَّةٍ قِطَعُ عَذابٍ كالسَّحابِ العظِيمِ."],[13,13,"عِبَادَهُۥ","كُلَّ عَبْدٍ مِنَ النّاسِ مِن مُّؤْمِنٍ وكافِرٍ."]],"17":[[2,2,"ٱلطَّـٰغُوتَ","كُلَّ ما عُبِدَ مِن دُونِ اللهِ مِن شَيطانٍ وغَيرِهِ."],[5,5,"وَأَنَابُوٓاْ","وتابُوا."]],"18":[[4,4,"أَحۡسَنَهُۥٓ","أرْشَدَهُ، وأَحْسَنُ الكَلامِ كَلامُ اللهِ ثُمَّ كَلامُ رَسُولِهِ."],[11,12,"أُوْلُواْ ٱلۡأَلۡبَـٰبِ","أصْحابُ العُقُولِ السَّليمَةِ."]],"19":[[1,1,"حَقَّ","وجَبَ."]],"20":[[5,5,"غُرَفٌ","منازِلُ عالِيةٌ في الجنُّةِ."]],"21":[[6,6,"ٱلسَّمَآءِ","السَّحابِ."],[7,7,"مَآءً","مَطَرًا."],[8,8,"فَسَلَكَهُۥ","فأدْخَلَه."],[9,9,"يَنَـٰبِيعَ","جَمْعُ يَنْبُوعٍ وهو العينُ الكَثِيرةُ النَّبعِ التي لا يَنضُبُ ماؤُها."],[19,19,"يَهِيجُ","يَيْبَسُ بَعْدَ خُضْرتِهِ ونَضارَتِهِ."],[24,24,"حُطَـٰمًا","مُتَكَسِّرًا مُتَفَتِّتًا."],[29,30,"لِأُوْلِي ٱلۡأَلۡبَـٰبِ","لِأَصْحابِ العُقُول السَّلِيمَةِ."]],"22":[[1,4,"شَرَحَ ٱللَّهُ صَدۡرَهُۥ لِلۡإِسۡلَـٰمِ","وسَّعَ اللهُ صدْرَهُ بالإيمانِ بِهِ والإسْلامِ."],[10,10,"فَوَيۡلٌ","فَهَلاكٌ."],[11,15,"لِّلۡقَـٰسِيَةِ قُلُوبُهُم مِّن ذِكۡرِ ٱللَّهِ","الَّذينَ غَلُظَتْ قُلُوبُهُم وأَعْرَضَتْ عَن ذِكْرِ اللهِ."]],"23":[[2,3,"أَحۡسَنَ ٱلۡحَدِيثِ","القرآنَ العَظِيمَ."],[5,5,"مُّتَشَـٰبِهًا","يُشْبِهُ بَعْضُه بَعْضًا في الحُسْنِ والإحْكامِ وعَدَمِ الاخْتِلافِ."],[6,6,"مَّثَانِيَ","تُثَنّى فيه وتُكَرَّرُ القِصَصُ والأَحْكامُ والحُجَجُ والبَيِّناتُ."],[7,7,"تَقۡشَعِرُّ","تَتَقَبَّضُ وتَتَغَيَّرُ بِسَبَبِ الخوفِ."],[14,14,"تَلِينُ","تَطْمئِنُّ وتَسْكُنُ."]],"24":[[0,4,"أَفَمَن يَتَّقِي بِوَجۡهِهِۦ سُوٓءَ ٱلۡعَذَابِ","أفمن يُلْقى في النّارِ مكْتُوفًا فلا يَقْدِرُ أن يَتَّقِيَ النّارَ إلا بِوجْهِهِ كَمَن هُو مُنَعَّمٌ في الجنَّةِ؟"]],"25":[[6,9,"مِنۡ حَيۡثُ لَا يَشۡعُرُونَ","مِنَ الموضِعِ الَّذي لا يعلَمُونَ بِمَجِيءِ العَذابِ مِنهُ."]],"26":[[2,2,"ٱلۡخِزۡيَ","العَذابَ والهَوانَ."]],"27":[[1,1,"ضَرَبۡنَا","ذَكَرْنا ووَصَفْنا."],[8,8,"مَثَلٍ","نَبَأٍ عَظِيمٍ يَدْعُو إلى الاعْتِبارِ ويَسْتَوجِبُ الإيمانَ."]],"28":[[2,4,"غَيۡرَ ذِي عِوَجٍ","لا لَبْسَ فِيهِ ولا اخْتِلافَ."]],"29":[[3,5,"رَّجُلًا فِيهِ شُرَكَآءُ","عَبْدًا مَمْلُوكًا لِشُرَكاءَ."],[6,6,"مُتَشَـٰكِسُونَ","متنازِعُونَ، سَيِّئةٌ أخْلاقُهُم."],[8,9,"سَلَمًا لِّرَجُلٍ","خالِصًا لِرَجُلٍ واحِدٍ."],[12,12,"مَثَلًا","حالًَا."]],"32":[[0,1,"فَمَنۡ أَظۡلَمُ","لا أحَدَ أظْلَمُ."],[7,7,"بِٱلصِّدۡقِ","بالقرآنِ."],[13,13,"مَثۡوًى","مأوىً ومَسْكَنٌ."]],"33":[[2,2,"بِٱلصِّدۡقِ","لا إلَهَ إلّا اللهُ."],[3,4,"وَصَدَّقَ بِهِۦٓ","مَن آمَنَ بالقُرْآنِ مِن نَّبِيِّ اللهِ وأَتْباعِهِ."]],"36":[[2,3,"بِكَافٍ عَبۡدَهُۥ","حامِي رَسُولِهِ مُحَمَّدٍ ﷺ."],[6,7,"مِن دُونِهِۦ","بالَّذِينَ يَعْبُدُونَ مِن دُونِهِ وهُمُ الأَصْنامُ."],[6,7,"مِن دُونِهِۦ","آلهَتِهِم الَّذين يَزْعُمُون أنها سَتُؤْذِيكَ."]],"37":[[0,2,"وَمَن يَهۡدِ ٱللَّهُ","ومَن يُوفِّقْه اللهُ للإيمانِ بهِ والعملِ بِكِتابِهِ."]],"38":[[28,29,"مُمۡسِكَـٰتُ رَحۡمَتِهِۦ","حابِساتُ رَحْمَتِهَ."],[31,32,"حَسۡبِيَ ٱللَّهُ","كافيَّ اللهُ."],[34,34,"يَتَوَكَّلُ","يَعْتَمِدُ ويُفَوِّضُ أمْرَهُ."]],"39":[[2,4,"ٱعۡمَلُواْ عَلَىٰ مَكَانَتِكُمۡ","اعْمَلُوا على حالَتِكُم الَّتِي رَضَيتُمُوها لِأَنْفُسِكُم."]],"40":[[3,3,"يُخۡزِيهِ","يُهينُهُ."],[7,7,"مُّقِيمٌ","دائِمٌ."]],"41":[[8,8,"فَلِنَفۡسِهِۦ","فَنَفْعُ هِدايتِهِ لِنَفْسِهِ."],[12,13,"يَضِلُّ عَلَيۡهَا","يَعُودُ ضَرَرُ ضَلالِهِ عَلى نَفْسِهِ."],[17,17,"بِوَكِيلٍ","بِحَفِيظٍ ومَسْؤُولٍ عَنْ أعْمالِهِم."]],"43":[[5,5,"شُفَعَآءَ","جَمْعُ شَفِيعٍ وهو الَّذِي يَطْلُبُ مِن غَيْرِه قَضاءَ حاجةِ شَخْصٍ آخَرَ، والمرادُ، واللهُ أعلمُ، ما يعبُدُونَه مِن دُونِ اللهِ."]],"44":[[0,2,"قُل لِّلَّهِ ٱلشَّفَـٰعَةُ","لِأَنَّ شَفاعةَ غَيرِهِ مَوقُوفَةٌ على إذْنِهِ سُبحانَه للشّافِعِ ورِضاهُ عَنِ المشْفُوعِ لَهُ، فلا تُطْلَبُ مِن هؤلاءِ الآلِهَةِ."]],"45":[[4,4,"ٱشۡمَأَزَّتۡ","نَفَرَتْ."],[13,14,"مِن دُونِهِۦٓ","وهُمُ الأَصْنامُ والأَوْثانُ والأَوْلِياءُ."]],"46":[[2,2,"فَاطِرَ","هُوَ الخالِقُ والُمبْدِعُ عَلى غَيرِ مِثالٍ."],[9,9,"تَحۡكُمُ","تَفْصِلُ وتَقْضِي."]],"47":[[17,17,"وَبَدَا","وظَهَرَ."],[24,24,"يَحۡتَسِبُونَ","يَظُنُونَ أنَّهُ واقِعٌ بِهِم."]],"48":[[5,6,"وَحَاقَ بِهِم","ونَزَلَ وأَحاطَ بِهِم."]],"49":[[7,7,"خَوَّلۡنَـٰهُ","أعْطَيناهُ تَفَضُّلًا مِنّا."],[13,14,"عَلَىٰ عِلۡمِۭ","عَلى خَيرٍ عِنْدِي."],[17,17,"فِتۡنَةٌ","بَلْوى يَبْتَلِي اللهُ بِها عِبادَهُ لِيَنْظُرَ مَن يَشْكُرُهُ مِمَّنْ يَكْفُرُهُ."]],"50":[[5,7,"فَمَآ أَغۡنَىٰ عَنۡهُم","ما دَفَعَ عَنْهُمُ العَذابَ."]],"51":[[1,3,"سَيِّـَٔاتُ مَا كَسَبُواْ","جَزاءُ سَيِّئاتِهِم وهو العَذابُ."],[12,14,"وَمَا هُم بِمُعۡجِزِينَ","وماهُمْ بِفائِتِينَ اللهَ ولا سابِقِيهِ."]],"52":[[8,8,"وَيَقۡدِرُ","ويُضَيِّقُ."]],"53":[[3,5,"أَسۡرَفُواْ عَلَىٰٓ أَنفُسِهِمۡ","تَمادَوا في المَعاصِي والكَبائِر."],[6,7,"لَا تَقۡنَطُواْ","لا تَيْئَسُوا."]],"54":[[0,0,"وَأَنِيبُوٓاْ","ارْجِعُوا إلى رَبِّكُم بالتَّوبَةِ والطّاعةِ."],[3,4,"وَأَسۡلِمُواْ لَهُۥ","واخْضَعُوا لَهُ بالطّاعةِ والإقْرارِ بَتَوْحِيدِهِ وإخْلاصِ العِبادةِ لَهُ."],[11,12,"لَا تُنصَرُونَ","لا تُمنَعُونَ."]],"55":[[1,6,"أَحۡسَنَ مَآ أُنزِلَ إِلَيۡكُم مِّن رَّبِّكُم","هو القُرآنُ العظِيمُ، وفِيهِ الخبرُ والأمْرُ بالحَسَنِ والأَحْسَنِ، ومُقْتَضاهُ فِيهِ حَسَنٌ وأَحْسَنُ، وإن كانَ في نَفْسِه أحْسَنَ الحَدِيثِ."],[12,12,"بَغۡتَةً","فَجْأةً."]],"56":[[0,1,"أَن تَقُولَ","لِئَلّا تَقُولَ."],[3,3,"يَـٰحَسۡرَتَى","يا نَدَمِي؛ اغْتِمامًا عَلى ما فاتَ."],[5,6,"مَا فَرَّطتُ","ما ضَيَّعْتُ في الدُّنيا مِنَ العَمَلِ بِما أمَرَنِي اللهُ بِه."],[7,9,"فِي جَنۢبِ ٱللَّهِ","في طاعَتِهِ."],[13,13,"ٱلسَّـٰخِرِينَ","المُسْتَهْزِئِينَ بِأمْرِ اللهِ وكِتابِهِ ورَسُولِهِ والمؤُمِنِينَ."]],"58":[[8,8,"كَرَّةً","رَجْعَةً إلى الحياةِ الدُّنيا."]],"60":[[12,12,"مَثۡوًى","مأوىً ومَسْكَنٌ."]],"61":[[4,4,"بِمَفَازَتِهِمۡ","بِسَبِبِ فَوْزِهِم بالأَعْمالِ الصّالِحَةِ."],[7,7,"ٱلسُّوٓءُ","أذى جَهَنَّمَ."]],"62":[[8,8,"وَكِيلٌ","حَفِيظٌ يُدَبِّرُ جَمِيعَ شَؤُونِ خَلْقِهِ."]],"63":[[1,1,"مَقَالِيدُ","مَفاتِيحُ خَزائِن."]],"65":[[9,9,"لَيَحۡبَطَنَّ","لَيَبْطُلَنَّ."]],"67":[[0,4,"وَمَا قَدَرُواْ ٱللَّهَ حَقَّ قَدۡرِهِۦ","ما عَظَّمُوا اللهَ حَقَّ تعظِيمِهِ إذْ عَبَدُوا مَعَهُ غَيرَهُ."],[7,7,"قَبۡضَتُهُۥ","في قَبْضَتِه عَلى ما يَلِيقُ بِه."]],"68":[[2,2,"ٱلصُّورِ","الَقْرنِ الَّذِي يُنْفخُ فِيهِ."],[3,3,"فَصَعِقَ","فَماتَ مِنَ الفَزَعِ وشِدَّةِ الصَّوْتِ."],[17,17,"أُخۡرَىٰ","هي نَفْخَةُ البَعْثِ."],[21,21,"يَنظُرُونَ","يُبْصِرُونَ، لِكَمالِ حياتِهِم."]],"69":[[0,0,"وَأَشۡرَقَتِ","أضاءَتْ."],[1,1,"ٱلۡأَرۡضُ","أرْضُ القِيامَةِ."],[4,5,"وَوُضِعَ ٱلۡكِتَـٰبُ","ونَشَرَتِ الملائِكةُ صَحِيفَةَ كُلِّ فَرْدٍ."],[8,8,"وَٱلشُّهَدَآءِ","هُمُ الَّذِينَ يَشْهَدُونَ على النّاسِ بأعْمالِهِم."]],"71":[[0,0,"وَسِيقَ","وحُثَّ الكافِرُونَ على السَّيرِ بِعْنْفٍ."],[5,5,"زُمَرًا","جماعاتٍ مُتَفَرِّقةً، بَعْضُهُم عَلى إثْرِ بَعْضٍ."],[29,29,"حَقَّتۡ","وجَبَتْ."],[30,31,"كَلِمَةُ ٱلۡعَذَابِ","قَضاءُ اللهِ بالعَذابِ."]],"72":[[6,6,"فَبِئۡسَ","فَقَبُحَ."],[7,7,"مَثۡوَى","مَصِيرُ."]],"73":[[0,0,"وَسِيقَ","وحُثَّ المتَّقُونَ عَلى السَّيرِ مُكَرَّمِينَ."],[6,6,"زُمَرًا","جماعاتٍ مُتَفَرِّقةً، بعضُهم على إثْرِ بَعْضٍ."],[17,17,"طِبۡتُمۡ","طابَتْ أحْوالُكُم."]],"74":[[7,7,"ٱلۡأَرۡضَ","أرْضَ الجنَّةِ."],[8,8,"نَتَبَوَّأُ","نَنْزِلُ."]],"75":[[2,2,"حَآفِّينَ","مُحِيطِينَ بجَوانِبِ العَرْشِ."],[5,5,"ٱلۡعَرۡشِ","هو سَرِيرُ الُملْكِ الَّذي اسْتَوى عَلَيهِ الَّرحمنُ، وتَحْمِلُهُ الملائِكَةُ، وهو أعْظَمُ المَخْلُوقاتِ، وهو سَقْفُ الجنَّةِ."],[6,6,"يُسَبِّحُونَ","يُنَزِّهُونَ."]]}