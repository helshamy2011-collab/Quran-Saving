{"1":[[0,1,"بِسۡمِ ٱللَّهِ","أبتدِئُ القراءةَ مُسْتعينًا باللهِ."],[2,2,"ٱلرَّحۡمَـٰنِ","ذي الرَّحمةِ العامَّةِ لجميع الخَلْقِ."],[3,3,"ٱلرَّحِيمِ","ذي الرَّحمةِ الخاصَّةِ بِالمؤمنين."]],"2":[[0,0,"ٱلۡحَمۡدُ","الثَّناءُ على اللهِ بصفاتِه، وبنِعَمِه كلِّها."],[3,3,"ٱلۡعَـٰلَمِينَ","جميعِ الخلْقِ."]],"4":[[1,2,"يَوۡمِ ٱلدِّينِ","يومِ القيامةِ الذي يكونُ فيه الجزاءُ."]],"5":[[0,1,"إِيَّاكَ نَعۡبُدُ","نَخُصُّك بالعبادةِ."]],"6":[[1,2,"ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","الطَّريقَ الواضحَ، المُوصِلَ إلى رِضوانِ اللهِ، وهو الإسلامُ."]],"7":[[2,3,"أَنۡعَمۡتَ عَلَيۡهِمۡ","مَنَنْتَ عليهم بالهدايةِ والتَّوفيقِ."],[5,6,"ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ","الذين عَرَفُوا الحقَّ، ولم يَعْمَلُوا به."],[7,8,"وَلَا ٱلضَّآلِّينَ","الذين لم يَهْتَدُوا، جَهْلًا منهم."]]}