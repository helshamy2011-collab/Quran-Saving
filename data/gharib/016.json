{"1":[[0,0,"أَتَىٰٓ","قَرُبَ ودَنا."],[1,2,"أَمۡرُ ٱللَّهِ","عقابُه للمُشْركين، أو القيامةُ."],[5,5,"سُبۡحَـٰنَهُۥ","تنزيهًا لله."]],"2":[[2,2,"بِٱلرُّوحِ","بالوَحْي؛ الذي فيه الحياةُ التامَّةُ."],[8,9,"مِنۡ عِبَادِهِۦٓ","الذين اختصَّهم بالرسالة."],[11,11,"أَنذِرُوٓاْ","خَوِّفُوا."]],"4":[[3,3,"نُّطۡفَةٍ","ماءِ الحياةِ، وهو المَنِيُّ."],[6,6,"خَصِيمٌ","شديدُ الخصومةِ والمجادَلةِ."],[7,7,"مُّبِينٌ","بيِّنُ الخُصومةِ واضحُها."]],"5":[[0,0,"وَٱلۡأَنۡعَـٰمَ","هي الإبِلُ والبَقَرُ والغنم."],[4,4,"دِفۡءٌ","ما تَسْتَدْفِئُون به مِن صوفِها ووَبَرِها وشَعْرِها."]],"6":[[2,2,"جَمَالٌ","زينةٌ تَسُرُّكم."],[4,4,"تُرِيحُونَ","تَرُدُّونها في المساء إلى حَظائرِها."],[6,6,"تَسۡرَحُونَ","تُخْرِجُونها في الصَّباح إلى مَراعِيها."]],"7":[[1,1,"أَثۡقَالَكُمۡ","أمتعتَكم الثقيلةَ."],[8,9,"بِشِقِّ ٱلۡأَنفُسِ","بجُهْدٍ شديدٍ ومشَقَّةٍ زائدةٍ عليها."]],"8":[[4,4,"وَزِينَةً","لتتزيَّنُوا بها حالَ ركوبِها، وحالَ جَمالِ منظرها."]],"9":[[2,3,"قَصۡدُ ٱلسَّبِيلِ","بيانُ الطَّريقِ المستقيمِ، وهو الإسلامُ."],[5,5,"جَآئِرٌ","مائلٌ عن الاستقامةِ، وهو ما خالَفَ الإسلامَ."]],"10":[[12,12,"تُسِيمُونَ","تَرعَوْن دَوابَّكم."]],"11":[[13,13,"لَـَٔايَةً","دلالةً واضحةً."]],"12":[[0,1,"وَسَخَّرَ لَكُمُ","ذلَّلَ لمنافعِكم."]],"13":[[1,1,"ذَرَأَ","خَلَقَ."]],"14":[[6,7,"لَحۡمًا طَرِيًّا","هو السَّمَكُ."],[10,10,"حِلۡيَةً","ما تتحَلّى به النِّساءُ وتَتَزَيَّنُ، كاللؤلؤِ والمَرْجانِ."],[13,13,"ٱلۡفُلۡكَ","السُّفُنَ."],[14,15,"مَوَاخِرَ فِيهِ","تَشُقُّ الماءَ بجَرْيِها فيه ذَهابًا ورُجوعًا."]],"15":[[3,3,"رَوَٰسِيَ","جبالًا ثوابِتَ."],[4,6,"أَن تَمِيدَ بِكُمۡ","حتى لا تَمِيلَ بكم وتضطربَ."],[8,8,"وَسُبُلًا","طُرُقًا."],[10,10,"تَهۡتَدُونَ","إلى مقاصِدِكم."]],"16":[[0,0,"وَعَلَـٰمَـٰتٍ","معالمَ تَسْتَدِلُّون بها على الطُّرُقِ نهارًا."]],"17":[[0,1,"أَفَمَن يَخۡلُقُ","وهو اللهُ تعالى."],[2,4,"كَمَن لَّا يَخۡلُقُ","أتَجْعَلُونه في استحقاقِ العبادةِ كالآلهةِ المزعومةِ التي لا تملِك شيئًا؟"]],"18":[[2,3,"نِعۡمَةَ ٱللَّهِ","نِعَمَه عليكم."],[4,5,"لَا تُحۡصُوهَآ","لا تُطيقوا حَصْرَها ولا القيامَ بشُكْرها؛ لكثرتِها وتَنَوُّعِها."]],"19":[[2,3,"مَا تُسِرُّونَ","ما تُخْفُونَه من أقوالِكم وأعمالِكم."]],"21":[[5,5,"أَيَّانَ","وقتَ."],[6,6,"يُبۡعَثُونَ","يُحْيَوْن مِن قُبورِهم."]],"22":[[7,8,"قُلُوبُهُم مُّنكِرَةٌ","جاحدةٌ وحدانيةَ اللهِ."]],"23":[[0,1,"لَا جَرَمَ","حَقًّا، أو لا مَحالةَ."]],"24":[[7,8,"أَسَـٰطِيرُ ٱلۡأَوَّلِينَ","جَمْعُ أُسْطورة، وهي: ما سُطِّرَ في كتب السابقينَ من الأخبارِ المكذوبةِ."]],"25":[[1,1,"أَوۡزَارَهُمۡ","آثامَ ضلالِهم."],[13,14,"مَا يَزِرُونَ","ما يَحْمِلُونه من آثامٍ."]],"26":[[1,1,"مَكَرَ","دَبَّرَ في حِيلةٍ وخَفاءٍ."],[5,7,"فَأَتَى ٱللَّهُ بُنۡيَـٰنَهُم","أهْلكَه وأفْناه."],[8,9,"مِّنَ ٱلۡقَوَاعِدِ","من أساسِه."],[10,10,"فَخَرَّ","سَقَطَ."],[18,20,"حَيۡثُ لَا يَشۡعُرُونَ","من مَأْمَنِهم، ومن جهةٍ لا تَخْطُرُ ببالِهم."]],"27":[[3,3,"يُخۡزِيهِمۡ","يُذِلُّهم اللهُ ويُهينُهم بالعذابِ."],[6,6,"شُرَكَآءِيَ","الآلهةُ التي عَبَدْتُموها من دوني."],[9,10,"تُشَـٰٓقُّونَ فِيهِمۡ","تُخاصِمُون وتُعادُون الأنبياءَ وأتباعَهم في شأنهم."],[16,16,"ٱلۡخِزۡيَ","الذُّلَّ والهَوانَ."],[18,18,"وَٱلسُّوٓءَ","العذابَ."]],"28":[[1,2,"تَتَوَفَّىٰهُمُ ٱلۡمَلَـٰٓئِكَةُ","تَقْبِضُ أرواحَهم."],[5,6,"فَأَلۡقَوُاْ ٱلسَّلَمَ","استَسْلَمُوا لأمرِ اللهِ حين رَأَوا الموتَ."]],"29":[[6,7,"مَثۡوَى ٱلۡمُتَكَبِّرِينَ","مَأْواهم ومَقَرُّهم."]],"30":[[13,13,"حَسَنَةٌ","مَكْرُمَةٌ من اللهِ بالعيشِ الهنيءِ والرِّزقِ الواسعِ."]],"31":[[0,1,"جَنَّـٰتُ عَدۡنٍ","جناتُ إقامةٍ."],[4,5,"مِن تَحۡتِهَا","من تحتِ قُصورِها وأشجارِها."]],"32":[[3,3,"طَيِّبِينَ","طاهِرين زاكِيَةً أفعالُهم وأقوالُهم."],[5,6,"سَلَـٰمٌ عَلَيۡكُمُ","تحيةٌ خاصةٌ بكم، وسَلِمْتُم من كلِّ آفةٍ."]],"33":[[0,1,"هَلۡ يَنظُرُونَ","ما ينتظِرُ الكفارُ."],[4,5,"تَأۡتِيَهُمُ ٱلۡمَلَـٰٓئِكَةُ","لقَبْضِ أرواحِهم."],[8,9,"أَمۡرُ رَبِّكَ","عذابُ الاستئصالِ في الدنيا، أو القيامةُ التي فيها عذابُهم."]],"34":[[4,4,"وَحَاقَ","نَزَلَ وأحاطَ."]],"35":[[21,25,"كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبۡلِهِمۡ","بمِثْلِ هذا الاحتجاجِ الباطلِ احتجَّ الكفارُ السابقون."]],"36":[[10,10,"ٱلطَّـٰغُوتَ","كلَّ معبودٍ باطلٍ، كالشيطانِ والأوثانِ والأمواتِ، وكلَّ داعٍ إلى ضَلالٍ."],[17,17,"حَقَّتۡ","وجَبَتْ."]],"38":[[2,3,"جَهۡدَ أَيۡمَـٰنِهِمۡ","غايةَ اجتهادِهم بالأيمانِ المؤكَّدةِ."]],"39":[[0,1,"لِيُبَيِّنَ لَهُمُ","أي: يَبْعَثُ اللهُ جميعَ العبادِ؛ ليُظْهِرَ لهم حقيقةَ البعثِ."]],"41":[[8,8,"لَنُبَوِّئَنَّهُمۡ","لَنُنْزِلَنَّهم."],[11,11,"حَسَنَةً","دارًا حسنةً، أو رزقًا واسعًا وعَيْشًا هنيئًا."]],"42":[[4,4,"يَتَوَكَّلُونَ","يعتمدون عليه ويُفَوِّضُون أمرَهم إليه."]],"43":[[9,10,"أَهۡلَ ٱلذِّكۡرِ","العلماءَ من أهلِ الكتبِ السابقةِ."]],"44":[[0,0,"بِٱلۡبَيِّنَـٰتِ","وأرسَلْنا الرسلَ بالمعجزاتِ الواضحةِ الدالَّةِ على صِدْقِهم."],[1,1,"وَٱلزُّبُرِ","وبالكتبِ المنزَّلةِ، المتضمِّنةِ للشرائعِ."],[4,4,"ٱلذِّكۡرَ","القرآنَ؛ لما فيه من الموعظةِ والتنبيهِ."]],"45":[[2,3,"مَكَرُواْ ٱلسَّيِّـَٔاتِ","دبَّروا المكايدَ بخَفاءٍ، وأشركوا مع اللهِ."],[5,5,"يَخۡسِفَ","يُغيِّبَ."]],"46":[[3,3,"تَقَلُّبِهِمۡ","أسفارِهم وتصرُّفِهم في أمورِهم."],[6,6,"بِمُعۡجِزِينَ","بفائتين اللهَ بالفِرارِ من عَذابِه."]],"47":[[2,3,"عَلَىٰ تَخَوُّفٍ","على تَنَقُّصٍ شيئًا فشيئًا في الأموالِ والأنفسِ والثمراتِ حتى يَهْلِكُوا، أو على مخافَةٍ من العَذابِ."]],"48":[[6,7,"مِن شَيۡءٍ","أي: له ظِلٌّ، كالجبالِ والشجَرِ."],[8,9,"يَتَفَيَّؤُاْ ظِلَـٰلُهُ","يَميلُ ظِلُّ الأشياءِ وينتقلُ من جانبٍ إلى آخَر."],[13,14,"سُجَّدًا لِّلَّهِ","مُنْقادةً خاضعةً لعَظَمَةِ رِّبها، وتسخيرِه."],[16,16,"دَٰخِرُونَ","أذلّاءُ مُنقادُون لحُكم الله تعالى."]],"49":[[1,1,"يَسۡجُدُ","سجودَ طاعةٍ وعبادةٍ، أو سُجودَ تسخيرٍ وخضوعٍ."],[9,9,"دَآبَّةٍ","كلِّ حَيَوانٍ يمشي -على هيئته- على الأرضِ."]],"51":[[2,3,"لَا تَتَّخِذُوٓاْ","لا تَعْبُدوا."],[11,11,"فَٱرۡهَبُونِ","خافونِ دونَ غيري."]],"52":[[5,6,"وَلَهُ ٱلدِّينُ","وللهِ وحدَه العبادةُ والإخلاصُ."],[7,7,"وَاصِبًا","دائمًا، أو واجبًا لازمًا."]],"53":[[8,8,"مَسَّكُمُ","أصابكم."],[9,9,"ٱلضُّرُّ","سوءُ الحالِ بنَقْصٍ في الأموالِ أو الأنفسِ أو الثمراتِ."],[11,11,"تَجۡـَٔرُونَ","ترفعونَ أصواتَكم بالدُّعاءِ والاستغاثةِ."]],"55":[[1,2,"بِمَآ ءَاتَيۡنَـٰهُمۡ","من النِّعَمِ."],[3,3,"فَتَمَتَّعُواْ","عِيشُوا في أمْنٍ وسلامةٍ، والتَذُّوا بالدنيا، والمرادُ التهديدُ."]],"56":[[0,0,"وَيَجۡعَلُونَ","ويجعلُ المشركون على وجْهِ التقرُّبِ."],[1,3,"لِمَا لَا يَعۡلَمُونَ","لآلهتِهم التي لا عِلْمَ لها، ولا تنفعُ ولا تَضُرُّ."],[11,11,"تَفۡتَرُونَ","تَكْذِبُون على الله من الباطِلِ."]],"57":[[5,6,"مَّا يَشۡتَهُونَ","ما يُحِبُّون من البنين."]],"58":[[8,8,"كَظِيمٌ","ممتلِئٌ غَمًّا وحُزْنًا وغَضَبًا."]],"59":[[0,2,"يَتَوَٰرَىٰ مِنَ ٱلۡقَوۡمِ","يَسْتَخْفي من قومِه؟"],[8,8,"أَيُمۡسِكُهُۥ","أيُبقي مَوْلُودَه الأنثى حيًا."],[10,10,"هُونٍ","ذُلٍّ وهَوانٍ."],[12,12,"يَدُسُّهُۥ","يُخْفِيه، فَيدْفِنُه حيًّا حتى يموتَ."]],"60":[[4,5,"مَثَلُ ٱلسَّوۡءِ","الصِّفةُ القبيحةُ من كراهةِ البناتِ، والجهلِ، والكفرِ باللهِ."],[6,8,"وَلِلَّهِ ٱلۡمَثَلُ ٱلۡأَعۡلَىٰ","الصفةُ العُليا من استحقاقِ العبوديةِ، والكمالِ، والجلالِ، والغنى، والجودِ."]],"61":[[13,14,"أَجَلٍ مُّسَمًّى","وقتٍ محدَّدٍ هو نهايةُ آجالِهم."],[21,22,"وَلَا يَسۡتَقۡدِمُونَ","لا يَتَقَدَّمون عليه."]],"62":[[2,3,"مَا يَكۡرَهُونَ","ما لا يُحبون نِسْبتَه إلى أنفسِهم من البناتِ."],[4,4,"وَتَصِفُ","تقولُ."],[9,9,"ٱلۡحُسۡنَىٰ","حُسْنَ العاقبةِ."],[10,11,"لَا جَرَمَ","حقًّا، أو لا مَحالةَ."],[16,16,"مُّفۡرَطُونَ","مَتْرُوكون مَنسِيُّون فيها أبدًا."]],"63":[[7,7,"فَزَيَّنَ","حَسَّنَ."],[12,13,"وَلِيُّهُمُ ٱلۡيَوۡمَ","مُتَوَلٍّ إغواءَهم في الدنيا."]],"64":[[3,3,"ٱلۡكِتَـٰبَ","القرآنَ العظيمَ."],[5,6,"لِتُبَيِّنَ لَهُمُ","لتُوَضِّحَ للناسِ."]],"65":[[13,13,"لَـَٔايَةً","دليلًا وحُجَّةً على قُدرةِ الله."]],"66":[[3,3,"ٱلۡأَنۡعَـٰمِ","وهي: الإبِلُ والبَقَرُ والغَنَمُ."],[4,4,"لَعِبۡرَةً","لعِظَةً."],[11,11,"فَرۡثٍ","خُلاصةِ المأكول في الكَرِشِ والأمعاءِ."],[14,14,"خَالِصًا","مُصَفّى من جميعِ الشوائبِ."],[15,15,"سَآئِغًا","سهلَ المُرورِ في الحَلْقِ، هنيئًا."]],"67":[[6,6,"سَكَرًا","خَمْرًا (وهذا امتنانٌ قبلَ التحريمِ)."]],"68":[[0,0,"وَأَوۡحَىٰ","وألْهَمَ."],[11,12,"وَمِمَّا يَعۡرِشُونَ","وفيما يَبْنيه الناسُ من البيوتِ والخَلايا."]],"69":[[6,7,"سُبُلَ رَبِّكِ","طُرُقَه التي ألْهَمكِ؛ لامتصاصِ ما في أزهارِ الثمار."],[8,8,"ذُلُلًا","مُذَلَّلةً لكِ لا عُسْرَ فيها."],[12,12,"شَرَابٌ","هو العَسَلُ."]],"70":[[3,3,"يَتَوَفَّىٰكُمۡ","يُميتكُم عندَ نهايةِ أعمارِكم."],[8,9,"أَرۡذَلِ ٱلۡعُمُرِ","أردَئهِ وأحقَرِه، وهو وقتُ الهَرَمِ."]],"71":[[16,18,"فَهُمۡ فِيهِ سَوَآءٌ","فهم لا يَرْضَوْن بالتساوي في الرزقِ، فكيف رَضُوا أن يَجْعلوا للهِ شركاءَ من عبيدِه؟"]],"72":[[11,11,"وَحَفَدَةً","جَمْعَ حَفِيدٍ، أي: أولادَ الأولادِ، أو أعوانًا وخَدَمًا."]],"74":[[0,3,"فَلَا تَضۡرِبُواْ لِلَّهِ ٱلۡأَمۡثَالَ","لا تَجْعَلُوا للهِ أشباهًا مماثِلين له مِن خَلْقِه، تُشْرِكُونهم معه في العبادةِ."]],"75":[[19,20,"هَلۡ يَسۡتَوُۥنَ","لا، فكذلك اللهُ المالكُ مع عبيدِه، فكيف تُسَوُّون بينَهما؟"]],"76":[[5,5,"أَبۡكَمُ","أخْرَسُ منذُ ولادَتِه."],[11,11,"كَلٌّ","عِبْءٌ يعتَمِدُ على غيرِه في معيشَتِه."],[13,13,"مَوۡلَىٰهُ","مَن يلي أمرَه ويَعُولُه."],[24,24,"بِٱلۡعَدۡلِ","بالحقِّ وعبادةِ اللهِ."],[27,27,"صِرَٰطٍ","طريقٍ."]],"77":[[1,3,"غَيۡبُ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ","عِلْمُ ما غابَ فيهما."],[8,9,"كَلَمۡحِ ٱلۡبَصَرِ","كنَظْرَةٍ سريعةٍ بالبَصَرِ."]],"79":[[4,4,"مُسَخَّرَٰتٍ","مُذَلَّلاتٍ للطَّيَرانِ."]],"80":[[5,5,"سَكَنًا","مَسْكَنًا واستقرارًا لكم."],[11,11,"بُيُوتًا","كالخِيام."],[12,12,"تَسۡتَخِفُّونَهَا","تَجِدُونها خفيفةَ الحَمْلِ والنَّقْلِ."],[13,14,"يَوۡمَ ظَعۡنِكُمۡ","وقتَ سَفَرِكم."],[17,18,"وَمِنۡ أَصۡوَافِهَا","أي: أصوافِ الضَّأنِ."],[19,19,"وَأَوۡبَارِهَا","أي: أوبارِ الإبِل، وهو ما يَعْلُو أجسادَها."],[20,20,"وَأَشۡعَارِهَآ","أي: أشعارِ المَعْزِ."],[21,21,"أَثَـٰثًا","مَتاعًا لبيوتِكم، كالأغطيةِ والفُرُشِ."],[22,22,"وَمَتَـٰعًا","ما تتمتَّعُون وتنتفِعُون به."],[23,24,"إِلَىٰ حِينٍ","إلى وقتٍ محدَّدٍ في الدنيا."]],"81":[[5,5,"ظِلَـٰلًا","ما تَسْتظِلُّون به من شدَّةِ الحرِّ."],[10,10,"أَكۡنَـٰنًا","أماكنَ وِقايةٍ وسِتْرٍ، كالكهوفِ."],[13,13,"سَرَٰبِيلَ","كلَّ ما يُلْبَس من ثيابٍ أو دُروعٍ."],[18,18,"بَأۡسَكُمۡ","الشدَّةَ في حروبِكم، كالطَّعْنِ والضَّرْبِ والشَّظايا."],[24,24,"تُسۡلِمُونَ","تَنقادُون وتَخْضَعُون لأمرِ اللهِ وحُكْمِه."]],"82":[[1,1,"تَوَلَّوۡاْ","أعْرَضُوا."],[5,5,"ٱلۡمُبِينُ","الواضحُ."]],"84":[[5,5,"شَهِيدًا","هو رسولُهم يَشْهَدُ على مَن آمَنَ منهم، وعلى مَن كَفَرَ."],[7,10,"لَا يُؤۡذَنُ لِلَّذِينَ كَفَرُواْ","بالاعتذار عَمّا وقَعَ منهم."],[11,13,"وَلَا هُمۡ يُسۡتَعۡتَبُونَ","لا يُطْلَبُ منهم العُتْبى، أي: الرجوعُ إلى ما يُرْضي اللهَ من التوبةِ والعملِ الصّالحِ."]],"85":[[10,10,"يُنظَرُونَ","يُمْهَلُون ويُؤَخَّرون عنه."]],"86":[[4,4,"شُرَكَآءَهُمۡ","آلهتَهم المزعومةَ."],[11,11,"نَدۡعُواْ","نعبدُ."],[14,16,"فَأَلۡقَوۡاْ إِلَيۡهِمُ ٱلۡقَوۡلَ","رَدَّتِ الآلهةُ على عابدِيها قائلين."]],"87":[[0,4,"وَأَلۡقَوۡاْ إِلَى ٱللَّهِ يَوۡمَئِذٍ ٱلسَّلَمَ","أظهرَ المشركونَ خُضوعَهم وانقيادَهم للهِ يومَ القيامةِ."],[5,5,"وَضَلَّ","غابَ وضاعَ."],[9,9,"يَفۡتَرُونَ","يختلِقُونَه مِن الأكاذيبِ."]],"89":[[11,13,"شَهِيدًا عَلَىٰ هَـٰٓؤُلَآءِ","تَشْهَدُ على أمَّتِك أنكَ بَلَّغْتَهم رسالةَ ربِّك."],[16,16,"ٱلۡكِتَـٰبَ","القرآنَ."],[17,17,"تِبۡيَـٰنًا","بَيانًا وتوضيحًا."],[18,19,"لِّكُلِّ شَيۡءٍ","مما يَحْتاجُ إليه الناسُ من أمورِ الشريعةِ."]],"90":[[3,3,"بِٱلۡعَدۡلِ","بالتوسُّطِ والإنصافِ في الأمور."],[4,4,"وَٱلۡإِحۡسَـٰنِ","كمالِ العملِ وإتقانِه، وإيصالِ النفعِ إلى الخَلْقِ."],[5,7,"وَإِيتَآيِٕ ذِي ٱلۡقُرۡبَىٰ","إعطاءِ القَرابةِ حَقَّهم من الصِّلةِ والبِرِّ."],[10,10,"ٱلۡفَحۡشَآءِ","ما عَظُمَ قُبْحُه من الذنوبِ قولًا أو فعلًا."],[12,12,"وَٱلۡبَغۡيِ","ظُلْمِ الناسِ وتجاوُزِ الحَدِّ في الاستعلاءِ والتعدِّي عليهم."]],"91":[[1,2,"بِعَهۡدِ ٱللَّهِ","ما يَلْتَزِمُه المسلمُ باختيارِه بينَه وبينَ اللهِ، أو بينَ الناسِ."],[5,7,"وَلَا تَنقُضُواْ ٱلۡأَيۡمَـٰنَ","لا تُبْطِلُوها وتَتْرُكُوا العَمَلَ بمُقْتضاها."],[14,14,"كَفِيلًا","رَقيبًا أو ضامِنًا."]],"92":[[4,4,"غَزۡلَهَا","ما فَتَلَتْه من صُوفٍ ونحوِه."],[8,8,"أَنكَـٰثًا","جَمْعُ نِكْثٍ، وهو: ما حُلَّ فَتْلُه؛ ليُغْزَلَ ثانيةً."],[11,12,"دَخَلَۢا بَيۡنَكُمۡ","خديعةً ومُنْكَرًا بينَكم."],[17,19,"أَرۡبَىٰ مِنۡ أُمَّةٍ","أكثرَ عَددًَا وأوفرَ مالًا من الجماعة التي عاهَدْتموها."],[21,22,"يَبۡلُوكُمُ ٱللَّهُ","يختبرُكم بالوفاءِ بِالعهودِ وعَدَمِ نَقْضِها."]],"93":[[4,5,"أُمَّةً وَٰحِدَةً","أهلَ دينٍ واحدٍ، وهو الإسلامُ."],[10,10,"وَيَهۡدِي","يُوَفِّقُ إلى الهدايةِ."]],"94":[[5,6,"فَتَزِلَّ قَدَمُۢ","فتنحَرِفَ أقدامُكم عن محَجَّةِ الحقِّ."],[8,8,"ثُبُوتِهَا","استقامتِها عليه."],[10,10,"ٱلسُّوٓءَ","ما يَسُوءُكم من العذابِ في الدنيا."]],"95":[[0,1,"وَلَا تَشۡتَرُواْ","لا تَسْتبدلوا."]],"96":[[2,2,"يَنفَدُ","يزولُ ويَفْنى."],[6,6,"بَاقٍ","لا يزولُ ولا يَفْنى."]],"97":[[11,11,"طَيِّبَةً","سعيدةً في الدنيا، يصاحِبُها القناعة بما قَسَمهُ اللهُ وقَدَّره."]],"98":[[0,1,"فَإِذَا قَرَأۡتَ","أي: فإذا أرَدْتَ أن تَقْرَأَ."],[3,4,"فَٱسۡتَعِذۡ بِٱللَّهِ","فالتجِئْ واستَجِرْ به."],[7,7,"ٱلرَّجِيمِ","المَرْجُومِ، أي: المَطْرودِ من رحمةِ اللهِ."]],"99":[[3,3,"سُلۡطَـٰنٌ","تَسَلُّطٌ واستيلاءٌ."],[9,9,"يَتَوَكَّلُونَ","يَعْتمدون عليه ويُفَوِّضُون أمرَهم إليه."]],"100":[[4,4,"يَتَوَلَّوۡنَهُۥ","يَتِّخِذُونه مُعِينًا لهم ويُطيعونه."],[6,7,"هُم بِهِۦ","بسببِ الشيطانِ وإغوائِه إيّاهم."]],"101":[[1,2,"بَدَّلۡنَآ ءَايَةً","أزَلْناها، أو أنْزَلْنا غيرَها."],[12,12,"مُفۡتَرِۭ","كَذّابٌ تَختَلِقُ الباطِلَ على اللهِ مِن عندِك."]],"102":[[2,3,"رُوحُ ٱلۡقُدُسِ","جبريلُ عليه السلامُ."]],"103":[[7,7,"لِّسَانُ","لُغةُ وكلامُ."],[9,10,"يُلۡحِدُونَ إِلَيۡهِ","يَنْسِبُون إليه التعليمَ."],[11,11,"أَعۡجَمِيٌّ","لا يُفْصِحُ عن مُرادِه."],[15,15,"مُّبِينٌ","في غايةِ الوضوحِ والبيانِ."]],"104":[[6,8,"لَا يَهۡدِيهِمُ ٱللَّهُ","لا يُوَفِّقُهم للإيمانِ؛ لعِلْمِه بعدَمِ قَبولِهم له."]],"105":[[1,1,"يَفۡتَرِي","يَخْتِلقُ."]],"106":[[0,2,"مَن كَفَرَ بِٱللَّهِ","فهم الكاذبون حقًّا، وعليهم غَضَبٌ من الله."],[8,8,"أُكۡرِهَ","أُرْغِمَ على النُّطْقِ بالكفرِ فَتَلفَّظَ به؛ خَوْفًا من هَلاكِه."],[14,16,"شَرَحَ بِٱلۡكُفۡرِ صَدۡرًا","اعتَقَدَه وطابَتْ نفسُه به."]],"107":[[2,3,"ٱسۡتَحَبُّواْ ٱلۡحَيَوٰةَ","اختارُوها وفَضَّلُوها."]],"108":[[2,2,"طَبَعَ","خَتَم."]],"109":[[0,1,"لَا جَرَمَ","حقًّا، أو لا مَحالةَ."]],"110":[[8,8,"فُتِنُواْ","اختُبِرُوا بتعذيبِهم، وتَلَفَّظُوا بالكُفرِ."]],"111":[[4,6,"تُجَـٰدِلُ عَن نَّفۡسِهَا","تُخاصِمُ عن ذاتِها، وتسعى في خَلاصِها."],[7,7,"وَتُوَفَّىٰ","تُعْطى وافيًا كامِلًا."]],"112":[[3,3,"قَرۡيَةً","أي: مكةَ."],[9,9,"رَغَدًا","واسعًا كثيرًا، أو هنيئًا سهلًا."],[18,20,"لِبَاسَ ٱلۡجُوعِ وَٱلۡخَوۡفِ","ما غَشِيَها من صُنوفِ البَلاءِ وإحاطَتِه بها كاللِّباس."]],"113":[[3,3,"مِّنۡهُمۡ","من جنسِهم، يَعْرِفُون نَسَبَه وأمانتَه."]],"114":[[6,8,"وَٱشۡكُرُواْ نِعۡمَتَ ٱللَّهِ","بالاعترافِ بها، واستعمالِها في طاعَتِه."]],"115":[[3,3,"ٱلۡمَيۡتَةَ","ما لم يُذْبَحْ بطريقةٍ شَرْعِيَّةٍ من الحَيَوانِ."],[4,4,"وَٱلدَّمَ","أي: المُراقَ من الذَّبِيحةِ."],[7,11,"وَمَآ أُهِلَّ لِغَيۡرِ ٱللَّهِ بِهِۦ","ما ذُكِرَ عليه غيرُ اسمِ اللهِ عندَ ذَبْحِه."],[12,13,"فَمَنِ ٱضۡطُرَّ","فمَن ألجأَتْه الضَّرورةُ إلى أكْلِ شيءٍ من هذه المُحَرَّماتِ."],[14,15,"غَيۡرَ بَاغٍ","غيرَ طالبٍ للمُحَرَّمِ وهو يَجِدُ غيرَه، أو غيرَ طالبٍ بأَكْلِه التلذُّذَ، أو غيرَ ظالمٍ لمضطرٍ آخرَ يُؤدِّي إلى هَلاكِه."],[16,17,"وَلَا عَادٍ","ولا متجاوزٍ ما يَسُدُّ جَوْعتَه."]],"116":[[2,4,"لِمَا تَصِفُ أَلۡسِنَتُكُمُ","لمجرَّدِ وصْفِ ألسنتِكُم للشيء دونَ دليلٍ."],[10,10,"لِّتَفۡتَرُواْ","تختَلِقُوا."]],"118":[[1,2,"ٱلَّذِينَ هَادُواْ","اليهودِ."]],"119":[[5,5,"ٱلسُّوٓءَ","الذُّنوبَ والمعاصِيَ."],[6,6,"بِجَهَـٰلَةٍ","بِجَهْلٍ منهم لعاقبتِها وإيجابِها سَخَطَ اللهِ."],[12,12,"وَأَصۡلَحُوٓاْ","استقامُوا بعد تَوْبَتِهم."]],"120":[[3,3,"أُمَّةً","إمامًا قُدْوةً جامعًا لخِصالِ الخيرِ."],[4,5,"قَانِتًا لِّلَّهِ","مُطيعًا خاضِعًا له."],[6,6,"حَنِيفًا","مائلًا عن الأديانِ الباطلةِ إلى الدِّينِ الحقِ."]],"121":[[2,2,"ٱجۡتَبَىٰهُ","اختاره اللهُ لرسالتِه."],[3,3,"وَهَدَىٰهُ","أرْشَدَه ووَفَّقه."]],"122":[[3,3,"حَسَنَةً","نِعْمةً حسنةً، كالثَّناءِ الجميلِ عليه إلى يومِ القيامة، والاقتداءِ به."]],"123":[[5,6,"مِلَّةَ إِبۡرَٰهِيمَ","شريعتَه، وهي الإسلامُ."]],"124":[[1,2,"جُعِلَ ٱلسَّبۡتُ","فُرِضَ تَعْظِيمُه والتفرُّغُ للعبادةِ فيه."],[4,6,"ٱلَّذِينَ ٱخۡتَلَفُواْ فِيهِ","هم اليهودُ، حيث أمَرَهم نبيُّهم بتعظيمِ يومِ الجُمُعَةِ، فاختاروا السَّبْتَ."]],"125":[[4,4,"بِٱلۡحِكۡمَةِ","بالطريقةِ الحَكِيمةِ وفْقَ شَرْعِ اللهِ."],[5,6,"وَٱلۡمَوۡعِظَةِ ٱلۡحَسَنَةِ","بالتذكيرِ المناسِبِ للأشخاصِ والأحوالِ."]],"127":[[11,11,"ضَيۡقٍ","حَرَجٍ وغَمٍّ."]]}