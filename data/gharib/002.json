{"1":[[0,0,"الٓمٓ","هذه الحروفُ المقطَّعَةُ تُشيرُ إلى أنّ القرآنَ مركَّبٌ من هذه الحروفِ التي تألَّفَتْ منها لغةُ العربِ، وقد عَجَزَ العربُ وغيرُهم عَنِ الإتيانِ بمثلِ القرآنِ، فدلَّ هذا على أن القرآنَ وحْيٌ من اللهِ."]],"2":[[1,1,"ٱلۡكِتَـٰبُ","القرآنُ."],[2,4,"لَا رَيۡبَۛ فِيهِ","لا شكَّ أنّه مِن عندِ اللهِ."],[6,6,"لِّلۡمُتَّقِينَ","الذين يَخافون اللهَ، ويتَّبعون أحكامَه."]],"3":[[1,1,"يُؤۡمِنُونَ","يُصَدِّقُون."],[2,2,"بِٱلۡغَيۡبِ","بما لا يُدْرَكُ بالحواسِّ والعُقولِ، فلا يُعْرَفُ إلا بالوَحْيِ، كالإيمانِ بالملائكةِ."],[3,3,"وَيُقِيمُونَ","يحافظون على أدائِها في مواقيتِها وفْقَ ما شَرَعَ اللهُ."]],"4":[[2,4,"بِمَآ أُنزِلَ إِلَيۡكَ","إلى محمدٍ ﷺ، مِنَ القرآنِ والسُّنةِ."],[5,8,"وَمَآ أُنزِلَ مِن قَبۡلِكَ","مِن كُتُبٍ كالتَّوراةِ والإنجيلِ"],[9,11,"وَبِٱلۡـَٔاخِرَةِ هُمۡ يُوقِنُونَ","يُصَدِّقُون بدارِ الحياةِ بعد الموتِ، وما فيها مِنَ الحِسابِ."]],"5":[[7,7,"ٱلۡمُفۡلِحُونَ","الفائِزون."]],"6":[[2,2,"كَفَرُواْ","جَحَدُوا ما أُنْزِلَ إليك من ربِّك."],[3,3,"سَوَآءٌ","مُتَساوٍ."],[5,5,"ءَأَنذَرۡتَهُمۡ","أخَوَّفْتَهم، وحَذَّرْتَهم."]],"7":[[0,0,"خَتَمَ","طَبَعَ عليها، فلا تَعِي خيرًا."],[8,8,"غِشَـٰوَةٌ","غطاءٌ، فلم يُوَفِّقْهم للهُدى."],[10,10,"عَذَابٌ","نارُ جَهنَّمَ في الآخِرَةِ."]],"8":[[0,1,"وَمِنَ ٱلنَّاسِ","فريقُ المُنافقين الذين يَقُولون بألسِنَتِهم: صَدَّقْنا، وهم في باطنِهم كاذِبُون."]],"9":[[0,0,"يُخَـٰدِعُونَ","يُظْهِرُون خِلافَ ما يُضْمِرُون."],[8,9,"وَمَا يَشۡعُرُونَ","وما يُحِسُّون بذلك؛ لفسادِ قُلوبهِم."]],"10":[[2,2,"مَّرَضٌ","شكٌّ وفسادٌ."]],"11":[[3,4,"لَا تُفۡسِدُواْ","بالمعاصِي، وإفشاءِ أسرارِ المؤمنين ومُوالاةِ الكافرين."]],"13":[[3,3,"ءَامِنُواْ","صَدِّقُوا بقُلوبِكم، وألسنتِكم، وجَوارِحِكم."],[11,11,"ٱلسُّفَهَآءُ","ضعافُ العقولِ والرأيِ، يَعْنُون بهم الصَّحابةَ."],[17,18,"لَّا يَعۡلَمُونَ","ما هم فيه مِنَ الخُسرانِ."]],"14":[[9,9,"شَيَـٰطِينِهِمۡ","زُعَمائِهم."],[15,15,"مُسۡتَهۡزِءُونَ","مُسْتَخِفُّون بالمؤمنين، ساخرُون منهم."]],"15":[[3,3,"وَيَمُدُّهُمۡ","يُمْهِلُهم."],[5,5,"طُغۡيَـٰنِهِمۡ","ضَلالَتِهم."],[6,6,"يَعۡمَهُونَ","يَتَردَّدُون."]],"16":[[2,4,"ٱشۡتَرَوُاْ ٱلضَّلَـٰلَةَ بِٱلۡهُدَىٰ","استبدَلُوا الكفرَ بالإيمانِ."]],"17":[[0,0,"مَثَلُهُمۡ","شَبَهُ المنافقين."],[3,3,"ٱسۡتَوۡقَدَ","أوقَدَ."],[6,6,"أَضَآءَتۡ","سَطَعَتْ وأنارَتْ."]],"18":[[0,0,"صُمُّۢ","عَنْ سَماعِ الحقِّ سماعَ تَدَبُّر، والصَّمَمُ: الانسدادُ."],[1,1,"بُكۡمٌ","عن النُّطقِ بالحق، والبُكْمُ: الخُرْسُ."],[2,2,"عُمۡيٌ","عَنْ إبصارِ نورِ الهدايةِ."],[4,5,"لَا يَرۡجِعُونَ","لا يعُودون إلى الإيمانِ."]],"19":[[0,0,"أَوۡ","هذا شَبَهُ فريقٍ آخرَ من المنافقين الذين يَظْهَرُ لهم الحقُّ تارةً، ويَشُكُّون فيه تارة."],[1,1,"كَصَيِّبٍ","الصَّيِّب: المَطَرُ الشَّديدُ، والمعنى: كأصحابِ صَيِّبٍ."],[13,13,"ٱلصَّوَٰعِقِ","جَمْعُ صاعِقَةٍ، وهي العذابُ المُهْلِكُ المُحْرِقُ."],[17,18,"مُحِيطُۢ بِٱلۡكَـٰفِرِينَ","لا يَفُوتونه، ولا يُعْجِزُونه."]],"20":[[0,0,"يَكَادُ","يُقارِبُ."],[2,2,"يَخۡطَفُ","يَسْلُبُ من شِدَّةِ لَمَعانِه."],[12,12,"قَامُواْ","وقَفُوا في أماكنِهم مُتَحَيِّرين."]],"21":[[9,10,"لَعَلَّكُمۡ تَتَّقُونَ","لتَتَّقُوه بطاعَتِه."]],"22":[[1,1,"جَعَلَ","صَيَّر."],[4,4,"فِرَٰشًا","بسِاطًا تَسْهُلُ حياتُكم عليه."],[20,20,"أَندَادًا","نُظَراءَ في العبادةِ."],[22,22,"تَعۡلَمُونَ","تَعْلَمُون تَفَرُّدَه بالخَلْقِ والرِّزقِ، واستحقاقَه العبوديةَ."]],"23":[[3,3,"رَيۡبٍ","شكٍ."],[10,11,"مِّن مِّثۡلِهِۦ","تُماثِلُ سورةً منه."],[13,13,"شُهَدَآءَكُم","أعوانَكم الذين يَشْهدون لكم."]],"24":[[3,4,"لَن تَفۡعَلُواْ","مستقبلًا."],[8,8,"وَقُودُهَا","حَطَبُها."],[11,11,"أُعِدَّتۡ","هُيِّئَتْ."]],"25":[[0,0,"وَبَشِّرِ","أخبِرْهم بما يَسُرُّهم."],[9,10,"مِن تَحۡتِهَا","من تحتِ قُصُورِ الجنّاتِ العاليةِ وأشجارِها الظَّليلةِ."],[22,23,"مِن قَبۡلُ","في الدُّنيا."],[26,26,"مُتَشَـٰبِهًا","وجَدُوا طَعمًا جديدًا، وإنْ تَشابَه مع سابقِه."],[30,30,"مُّطَهَّرَةٌ","من الدَّنَسِ الحِسِّي كالَحيْضِ، والمعنويِّ كالكَذِبِ."]],"26":[[2,3,"لَا يَسۡتَحۡيِۦٓ","من الحقِّ أنَ يذْكُرَ شيئًا مّا، صغيرًا أو كبيرًا."],[9,10,"فَمَا فَوۡقَهَا","فما هو أكبرُ منها."],[38,38,"ٱلۡفَـٰسِقِينَ","الخارجين عن طاعةِ الله."]],"27":[[1,1,"يَنقُضُونَ","يَنْكُثون."],[2,3,"عَهۡدَ ٱللَّهِ","العهدَ الذي أخذه عليهم بالتوحيدِ والطّاعةِ."],[4,6,"مِنۢ بَعۡدِ مِيثَـٰقِهِۦ","مِن بعدِ تأكيدِه باليمينِ."]],"28":[[4,4,"أَمۡوَٰتًا","عَدَمًا غيرَ مخلوقِين."],[5,5,"فَأَحۡيَـٰكُمۡ","فأنشأكم بَشَرًا سويًّا."],[9,9,"يُحۡيِيكُمۡ","يوَم الَبْعثِ."]],"29":[[9,11,"ٱسۡتَوَىٰٓ إِلَى ٱلسَّمَآءِ","ارتفعَ وقَصَدَ إلى خَلْق السمواتِ، وتقديرِ ما في كلِّ واحدةٍ."],[12,12,"فَسَوَّىٰهُنَّ","خَلَقَهُنَّ مُسْتَوِياتٍ، ودبَّرَهُنَّ."]],"30":[[8,8,"خَلِيفَةً","قومًا يَخْلُف بعضُهم بعضًا لعِمارةِ الأرضِ."],[15,16,"يَسۡفِكُ ٱلدِّمَآءَ","يُريقُها بغيرِ حَقٍّ."],[18,19,"نُسَبِّحُ بِحَمۡدِكَ","نُنَزِّهُك التنزيهَ اللائقَ."],[20,21,"وَنُقَدِّسُ لَكَ","نُمَجِّدُك، ونُطَهِّرُ ذِكْرَك عَمّا لا يَليقُ بك."]],"31":[[2,2,"ٱلۡأَسۡمَآءَ","أسماءَ الأشياءِ التي يَتَعارَفُ بها الناسُ."],[11,11,"هَـٰٓؤُلَآءِ","الموجوداتِ التي عَلَّمَها آدمَ."]],"32":[[1,1,"سُبۡحَـٰنَكَ","تَنْزيهًا للهِ."]],"33":[[3,3,"بِأَسۡمَآئِهِمۡ","بأسماءِ الأشياءِ التي عَجَزُوا عن معرفتِها."],[18,18,"تُبۡدُونَ","تُظْهِرُون."],[21,21,"تَكۡتُمُونَ","تُخْفُون."]],"34":[[3,4,"ٱسۡجُدُواْ لِـَٔادَمَ","إكرامًا له، وإظهارًا لفَضْلهِ."],[8,8,"أَبَىٰ","تَكَبُّرًا وحَسَدًا."],[9,9,"وَٱسۡتَكۡبَرَ","استعظمَ نفسَه."]],"35":[[8,8,"رَغَدًا","هنيئًا واسعًا."],[17,17,"ٱلظَّـٰلِمِينَ","المتجاوِزين أمرَ اللِه."]],"36":[[0,2,"فَأَزَلَّهُمَا ٱلشَّيۡطَـٰنُ عَنۡهَا","فأوْقَعَهما الشيطانُ في الخطيئةِ ليُبْعِدَهما عَنِ الجنةِ."],[9,10,"بَعۡضُكُمۡ لِبَعۡضٍ","آدمُ، وحواءُ، والشيطانُ."],[16,16,"مَتَـٰعٌ","انتفاعٌ، واستمتاعٌ."],[17,18,"إِلَىٰ حِينٍ","إلى وقتِ انتهاءِ آجالِكم."]],"37":[[4,4,"كَلِمَـٰتٍ","ما ألْهمه اللهُ مِن كلماتٍ للتَّوبةِ."]],"38":[[11,12,"فَلَا خَوۡفٌ","آمِنُون من أهوالِ القيامةِ."],[14,16,"وَلَا هُمۡ يَحۡزَنُونَ","على ما فاتَهم من الدُّنيا."]],"40":[[2,3,"ٱذۡكُرُواْ نِعۡمَتِيَ","اصطفائي للرُّسُلِ منكم، وإنزالَ الكتبِ عليكم، ونجاتكم من فرعونَ."],[7,8,"وَأَوۡفُواْ بِعَهۡدِيٓ","أتِمُّوا وصِيَّتي لكم بالإيمان بكتبي وبرُسُلي جميعًا."],[9,10,"أُوفِ بِعَهۡدِكُمۡ","ما وعَدْتُكم به من الرحمةِ في الدنيا والآخرةِ."]],"41":[[8,10,"أَوَّلَ كَافِرِۭ بِهِۦ","بالقرآنِ."],[11,15,"وَلَا تَشۡتَرُواْ بِـَٔايَـٰتِي ثَمَنًا قَلِيلًا","ولا تَبيعُوا ما آتيكم به من العِلْم بما في كتابِكم من أمرِ محمدٍ ﷺ، بثمَنٍ بَخْس."]],"42":[[0,1,"وَلَا تَلۡبِسُواْ","ولا تَخْلِطُوا."],[4,5,"وَتَكۡتُمُواْ ٱلۡحَقَّ","وتُخْفُوا صفةَ محمدٍ ﷺ في التوراةِ."]],"44":[[2,2,"بِٱلۡبِرِّ","بالطاعةِ، والعملِ الصالحِ."],[7,7,"ٱلۡكِتَـٰبَ","التوراةَ."]],"45":[[4,4,"لَكَبِيرَةٌ","شاقةٌ ثقيلةٌ."],[7,7,"ٱلۡخَـٰشِعِينَ","الخاضِعين لطاعَتهِ."]],"46":[[1,1,"يَظُنُّونَ","يُوقِنون."]],"47":[[10,10,"ٱلۡعَـٰلَمِينَ","عالَمِي زمانِكم؛ بكثرةِ الأنبياءِ، وإنزالِ الكتبِ."]],"48":[[1,1,"يَوۡمًا","يومَ القيامةِ."],[2,4,"لَّا تَجۡزِي نَفۡسٌ","لا يُغني أحدٌ عن أحدٍ شيئًا."],[15,15,"عَدۡلٌ","فِدْيةٌ."]],"49":[[1,1,"نَجَّيۡنَـٰكُم","نَجَّينا آباءَكم."],[10,11,"يَسۡتَحۡيُونَ نِسَآءَكُمۡ","يَسْتَبْقُونَهُن للخِدْمةِ والامتهانِ."],[14,14,"بَلَآءٌ","اختبارٌ."]],"50":[[1,3,"فَرَقۡنَا بِكُمُ ٱلۡبَحۡرَ","فَصَلْنا لكم البحرَ، وجَعَلْنا فيه طُرُقًا يابسةً لعُبورِكم."]],"51":[[6,7,"ٱتَّخَذۡتُمُ ٱلۡعِجۡلَ","أي مَعبْودًا لكم من دونِ اللهِ."]],"53":[[3,3,"ٱلۡكِتَـٰبَ","التوراةَ."],[4,4,"ٱلۡفُرۡقَانَ","الفارقَ بينَ الحقِّ والباطلِ."]],"54":[[13,14,"فَٱقۡتُلُوٓاْ أَنفُسَكُمۡ","بأَنْ يَقْتُلَ بعضُكم بعضًا."]],"55":[[9,9,"جَهۡرَةً","عِيانًا."],[11,11,"ٱلصَّـٰعِقَةُ","نارٌ مِنَ السماءِ."]],"57":[[2,2,"ٱلۡغَمَامَ","السَّحابَ."],[5,5,"ٱلۡمَنَّ","شيءٌ يُشْبه الصَّمْغَ، طَعْمُه كالعَسَلِ."],[6,6,"ٱلسَّلۡوَىٰ","طيرٌ يُشْبِهُ السُّمانى."]],"58":[[4,4,"ٱلۡقَرۡيَةَ","بيتَ المَقْدِسِ."],[9,9,"رَغَدًا","هنيئًا."],[14,14,"حِطَّةٌ","ربَّنا ضَعْ عنا ذُنوبَنا."]],"59":[[12,12,"رِجۡزًا","عذابًا."],[17,17,"يَفۡسُقُونَ","يَخْرُجون عن طاعةِ اللهِ."]],"60":[[1,1,"ٱسۡتَسۡقَىٰ","سألَ اللهَ أنَ يَسْقِيَ قومَه."],[23,24,"وَلَا تَعۡثَوۡاْ","ولا تُفْرِطُوا في الفسادِ."]],"61":[[18,18,"وَقِثَّآئِهَا","جَمْعُ قِثّاءَةٍ، وهو نَبْتٌ ثِمارُه تُشْبِهُ الخِيارَ، ولكنه أطولُ منه."],[19,19,"وَفُومِهَا","الحِنْطَةِ."],[24,26,"ٱلَّذِي هُوَ أَدۡنَىٰ","الطعامَ الذي هو أقلُّ قَدْرًا وقيمةً."],[31,31,"مِصۡرًا","أيَّ مدينةٍ."],[39,39,"ٱلۡمَسۡكَنَةُ","الفاقَةُ، والحاجَةُ."],[40,40,"وَبَآءُو","رَجَعُوا."]],"62":[[3,4,"وَٱلَّذِينَ هَادُواْ","اليهودَ."],[6,6,"ٱلصَّـٰبِـِٔينَ","قومٌ بَقُوا على فِطْرتهم، ولا دينَ مقرَّرٌ لهم."],[21,23,"وَلَا هُمۡ يَحۡزَنُونَ","على ما فاتَهُمْ من أمورِ الدُّنيا."]],"63":[[2,2,"مِيثَـٰقَكُمۡ","العهدَ المؤكَّدَ منكم بالإيمان."],[5,5,"ٱلطُّورَ","جبلَ سيناءَ."],[7,8,"مَآ ءَاتَيۡنَـٰكُم","الكتابَ الذي أعطيناكم وهو التَّوراةُ."],[9,9,"بِقُوَّةٍ","بجِدٍّ."]],"64":[[1,1,"تَوَلَّيۡتُم","عَصَيْتُم."]],"65":[[5,6,"فِي ٱلسَّبۡتِ","في هذا اليومِ الذي أُمِرُوا بتعظيمِه."],[11,11,"خَـٰسِـِٔينَ","أذِلَّةً صاغِرين."]],"66":[[1,1,"نَكَـٰلًا","عقوبةً."],[2,4,"لِّمَا بَيۡنَ يَدَيۡهَا","من الذنوبِ."]],"67":[[12,12,"هُزُوًا","مَوْضِعَ سُخْرِيَةٍ واستِخْفافٍ."]],"68":[[14,14,"فَارِضٌ","المُسِنَّةُ الهَرِمَةُ."],[16,16,"بِكۡرٌ","الصغيرةُ الفتيةُ."],[17,17,"عَوَانُۢ","متوسطةٌ بين البِكْرِ والهَرِمَةِ."]],"69":[[14,15,"فَاقِعٌ لَّوۡنُهَا","شديدةُ الصُّفْرَةِ."]],"70":[[10,10,"تَشَـٰبَهَ","التبسَ."]],"71":[[5,8,"لَّا ذَلُولٌ تُثِيرُ ٱلۡأَرۡضَ","غيرُ مُذَلَّلَةٍ للعَمَلِ في حِراثةِ الأرضِ."],[11,11,"ٱلۡحَرۡثَ","الزرعَ."],[12,12,"مُسَلَّمَةٌ","خاليةٌ مِنَ العيوبِ."],[13,15,"لَّا شِيَةَ فِيهَا","لا لونَ فيها يخالِفُ لونَ جِلْدِها."]],"72":[[7,7,"مُخۡرِجٌ","مُظْهِرٌ."]],"73":[[2,2,"بِبَعۡضِهَا","بجُزْءٍ مِنَ البقرةِ المذبوحةِ."],[8,8,"ءَايَـٰتِهِۦ","معجزاتهِ، وحُجَجَه."]],"75":[[1,3,"أَن يُؤۡمِنُواْ لَكُمۡ","أن يُصَدِّقَ اليهودُ بدينِكم."],[9,10,"كَلَـٰمَ ٱللَّهِ","التوراةَ."],[12,12,"يُحَرِّفُونَهُۥ","يَصْرِفُونه عن معناه."],[16,16,"عَقَلُوهُ","فَهِمُوه بعقولهِم على الوجهِ الصَّحيحِ."]],"76":[[13,14,"بِمَا فَتَحَ","بما بَيَّنَ اللهُ لكم في التوراةِ من أمْرِ محمدٍ ﷺ."],[17,17,"لِيُحَآجُّوكُم","لتكونَ لهم الحُجَّةُ عليكم في الآخرةِ."]],"78":[[0,1,"وَمِنۡهُمۡ أُمِّيُّونَ","ومن اليهودِ طائفةٌ يَجْهَلُون القراءةَ والكتابةَ."],[4,4,"ٱلۡكِتَـٰبَ","التوراةَ وما فيها من صفاتِ محمدٍ ﷺ."],[6,6,"أَمَانِيَّ","أكاذيبَ."]],"79":[[0,0,"فَوَيۡلٌ","فوعيدٌ شديدٌ."],[13,14,"ثَمَنًا قَلِيلًا","عَرَضًا مِنَ الدنيا."]],"80":[[11,11,"عَهۡدًا","ميثاقًا بهذا الزعمِ."]],"81":[[3,3,"سَيِّئَةً","شِرْكًا."]],"83":[[2,2,"مِيثَـٰقَ","العهدَ المؤكَّدَ."],[13,13,"ٱلۡيَتَـٰمَىٰ","الأولادِ الذين ماتَ آباؤُهم وهم دونَ البُلوغِ."],[14,14,"وَٱلۡمَسَـٰكِينِ","الذين لا يَمْلِكُون ما يَكْفيهم."],[17,17,"حُسۡنًا","أطيبَ الكلامِ."],[28,28,"مُّعۡرِضُونَ","مستمرُّون في تكذيبِهم."]],"84":[[2,2,"مِيثَـٰقَكُمۡ","العهدَ المؤكَّدَ في التَّوراة."],[12,12,"أَقۡرَرۡتُمۡ","اعترفتُمْ."]],"85":[[2,2,"هَـٰٓؤُلَآءِ","يا هؤلاءِ."],[10,11,"تَظَـٰهَرُونَ عَلَيۡهِم","يتَقَوّى كلٌّ منكم على إخوانِه بالأعداءِ."],[17,17,"تُفَـٰدُوهُمۡ","تُحَرِّرُوهم مِنَ الأَسْرِ بدَفْعِ الفِدْيَةِ."],[24,24,"ٱلۡكِتَـٰبِ","التوراةِ."]],"86":[[2,4,"ٱشۡتَرَوُاْ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","استحَبُّوها."]],"87":[[4,4,"وَقَفَّيۡنَا","أتْبَعْنا بعضَهم خَلْفَ بعضٍ."],[12,12,"ٱلۡبَيِّنَـٰتِ","المعجزاتِ الواضحاتِ."],[14,15,"بِرُوحِ ٱلۡقُدُسِ","جبريلَ."]],"88":[[0,0,"وَقَالُواْ","وقال بنو إسرائيلَ."],[2,2,"غُلۡفُۢ","مُغَطّاةٌ لا يَنْفُذُ إليها قولُك."]],"89":[[1,1,"جَآءَهُمۡ","جاء اليهودَ."],[2,2,"كِتَـٰبٌ","هو القرآنُ الكريمُ."],[6,6,"مُصَدِّقٌ","موافِقٌ."],[7,8,"لِّمَا مَعَهُمۡ","من التوراة."],[10,11,"مِن قَبۡلُ","مِن قَبْلِ بِعْثَةِ محمدٍ ﷺ."],[12,12,"يَسۡتَفۡتِحُونَ","يَسْتَنْصِرُون بالنبيِّ الذي ينتظرونه."]],"90":[[0,0,"بِئۡسَمَا","قَبُحَ."],[1,1,"ٱشۡتَرَوۡاْ","باعوا."],[9,9,"بَغۡيًا","ظُلمًا وحَسَدًا."],[10,11,"أَن يُنَزِّلَ","من أجْلِ أن يُنَزِّلَ."],[13,14,"مِن فَضۡلِهِۦ","هو تنزيلُ القرآنِ على محمدٍ ﷺ."],[20,20,"فَبَآءُو","فرَجَعُوا."],[21,21,"بِغَضَبٍ","بغَضَبِ اللهِ بسببِ تكذيبِهم للنبيَّ ﷺ."],[22,23,"عَلَىٰ غَضَبٍ","بعد غضبهِ بسببِ تحريفِهم للتوراةِ."]],"91":[[13,14,"بِمَا وَرَآءَهُۥ","بما أنزل اللهُ بعدَ التوراةِ."],[18,19,"لِّمَا مَعَهُمۡ","من التَّوراةِ."]],"92":[[3,3,"بِٱلۡبَيِّنَـٰتِ","بالمُعْجِزاتِ الواضحاتِ."],[5,6,"ٱتَّخَذۡتُمُ ٱلۡعِجۡلَ","أي مَعْبودًا."]],"93":[[2,2,"مِيثَـٰقَكُمۡ","العهدَ المؤكَّدَ."],[5,5,"ٱلطُّورَ","جبلَ الطُّورِ."],[14,17,"وَأُشۡرِبُواْ فِي قُلُوبِهِمُ ٱلۡعِجۡلَ","امتزجَ حُبُّ عبادَةِ العِجْلِ بقُلوبهِم."]],"94":[[8,8,"خَالِصَةً","خاصةً بكم."],[12,13,"فَتَمَنَّوُاْ ٱلۡمَوۡتَ","ادْعُوا بالموتِ على الكاذبِ."]],"95":[[4,4,"قَدَّمَتۡ","كَسَبَتْ."]],"96":[[16,16,"بِمُزَحۡزِحِهِۦ","مُبْعِدِه، ومُنْجِيه."],[19,20,"أَن يُعَمَّرَ","طولُ العُمْرِ."]],"97":[[1,2,"مَن كَانَ","هم اليهودُ الزاعمون أنّ جبريلَ عَدُوٌّ لهم."],[12,14,"لِّمَا بَيۡنَ يَدَيۡهِ","لما قبلَه مِنَ الكُتُب."]],"99":[[4,4,"بَيِّنَـٰتٍ","علاماتٍ دالّاتٍ على نُبُوَّتك."],[9,9,"ٱلۡفَـٰسِقُونَ","الخارجون عن دينِ اللهِ."]],"100":[[1,1,"عَهۡدًا","هو الميثاقُ الذي أعطاه اليهودُ رَبَّهم."],[3,3,"نَّبَذَهُۥ","نَقَضَه."]],"102":[[1,3,"مَا تَتۡلُواْ ٱلشَّيَـٰطِينُ","ما تُحَدِّثُ به الشياطينُ السَّحَرَةَ."],[4,5,"عَلَىٰ مُلۡكِ","على عَهْدِ."],[16,17,"وَمَآ أُنزِلَ","وكذلك اتَّبَعَ اليهودُ السِّحْرَ الذي أُنْزِلَ على الملَكَين. وقد عَلَّم اللهُ الملَكَين السِّحْرَ ابتلاءً منه."],[31,31,"فِتۡنَةٌ","ابتلاءٌ يَختبرُ اللهُ بهما عبادَه، وهو تعليمُ إنذارٍ من السِّحْرِ، لا تعليمُ دعوةٍ."],[32,33,"فَلَا تَكۡفُرۡ","بتعَلُّمِ السِّحْرِ، وطاعةِ الشياطين."],[59,59,"ٱشۡتَرَىٰهُ","اختار السِّحْرَ، واستحَبَّه."],[65,65,"خَلَـٰقٍ","نصيبٍ في الخيرِ."]],"103":[[4,4,"لَمَثُوبَةٌ","ثوابُ اللهِ."]],"104":[[5,5,"رَٰعِنَا","أي: سَمْعَك، فافهَمْ عنا، وأفْهِمْنا."],[7,7,"ٱنظُرۡنَا","انظُرْ إلينا وتَعَهَّدْنا."]],"105":[[17,17,"يَخۡتَصُّ","يُؤْثِرُ."]],"106":[[0,1,"مَا نَنسَخۡ","ما نُبَدِّلْ."],[5,5,"نُنسِهَا","نَمْحُها مِنَ القُلوبِ."]],"107":[[14,14,"وَلِيٍّ","قَيِّمٍ بأمرِكم."]],"108":[[16,17,"سَوَآءَ ٱلسَّبِيلِ","طريقَ اللهِ المستقيم."]],"109":[[6,6,"يَرُدُّونَكُم","يُرْجِعُونكم."],[26,26,"بِأَمۡرِهِۦٓ","بحُكْمِه فيهم."]],"110":[[4,5,"وَمَا تُقَدِّمُواْ","وما تَعْمَلُوا مِن عَمَلٍ."]],"111":[[11,11,"أَمَانِيُّهُمۡ","أوهامُهم الفاسدةُ."],[14,14,"بُرۡهَـٰنَكُمۡ","حُجَّتَكم."]],"112":[[2,2,"أَسۡلَمَ","أخلَصَ لطاعَتِه."],[5,6,"وَهُوَ مُحۡسِنٌ","مُتَّبِعٌ للرسولِ ﷺ."]],"113":[[4,5,"عَلَىٰ شَيۡءٍ","أي: من الدِّينِ الصَّحيحِ."],[12,14,"وَهُمۡ يَتۡلُونَ ٱلۡكِتَـٰبَ","يَقْرَؤون التوراةَ والإنجيلَ، وفيهما الإيمانُ بالأنبياءِ جميعًا."],[17,19,"ٱلَّذِينَ لَا يَعۡلَمُونَ","هم مُشْرِكو العربِ وغيرُهم."],[23,23,"يَحۡكُمُ","يَفْصِلُ، ويَقْضي."]],"114":[[0,1,"وَمَنۡ أَظۡلَمُ","لا أحدَ أظلمُ."],[24,24,"خِزۡيٌ","ذِلَّةٌ وهَوانٌ."]],"115":[[4,4,"تُوَلُّواْ","تَتَوَجَّهُوا."],[5,6,"فَثَمَّ وَجۡهُ","فإنكم مُبْتَغُون وجْهَه."],[10,10,"وَٰسِعٌ","واسعُ الرحمةِ بعبادِه."]],"116":[[4,4,"سُبۡحَـٰنَهُۥ","تَنَزَّهَ عن هذا الباطلِ."],[13,13,"قَـٰنِتُونَ","خاضِعُون له، مُطيعون."]],"117":[[0,0,"بَدِيعُ","مُبْدِعٌ على غيرِ مثالٍ سَبَقَ."]],"118":[[4,4,"لَوۡلَا","هَلّا."],[9,9,"ءَايَةٌ","مُعْجزةٌ."],[17,17,"تَشَـٰبَهَتۡ","في الكُفرِ والعِنادِ."],[23,23,"يُوقِنُونَ","يُصَدِّقُون ويَتَّبِعُون الرسولَ ﷺ."]],"119":[[3,3,"بَشِيرًا","للمؤمنين بخَيْرَي الدُّنيا و الآخرةِ."],[4,4,"وَنَذِيرًا","ومُخَوِّفًا للمعانِدِين بالعذابِ."]],"120":[[8,8,"مِلَّتَهُمۡ","دينَهم."],[13,14,"هُوَ ٱلۡهُدَىٰ","الدِّينُ الصحيحُ."],[15,15,"وَلِيٍّ","قريبٍ يمنعُك من عذابِ اللهِ."]],"121":[[4,5,"حَقَّ تِلَاوَتِهِۦٓ","يَتَّبِعُونه حَقَّ اتِّباعِه."]],"122":[[10,10,"ٱلۡعَـٰلَمِينَ","عالَمِي زَمانِكم بكثرةِ الأنبياءِ، وإنزالِ الكُتُبِ."]],"123":[[2,3,"لَّا تَجۡزِي","لا تُغْني."],[11,11,"عَدۡلٌ","فِدْيَةٌ تُنْجِيها من العذابِ."],[14,14,"شَفَـٰعَةٌ","وساطةٌ في حُصولِ النفعِ."]],"124":[[1,1,"ٱبۡتَلَىٰٓ","اختبرَ."],[4,4,"بِكَلِمَـٰتٍ","بما شَرَع له من تعاليمَ."],[5,5,"فَأَتَمَّهُنَّ","فأدّاهن على الوجهِ الأكمَلِ."],[10,10,"إِمَامًا","قُدوةً للناس."],[12,13,"وَمِن ذُرِّيَّتِي","واجعَلْ بعضَ نَسْلي مَن يُقْتَدى به."],[17,17,"عَهۡدِي","الإمامةُ في الدِّين."]],"125":[[2,2,"ٱلۡبَيۡتَ","الكعبةَ."],[3,3,"مَثَابَةً","مَرْجِعًا ومَجْمَعًا للناسِ."],[8,9,"مَّقَامِ إِبۡرَٰهِـۧمَ","الحَجَرِ الذي وقَفَ عليه."],[11,11,"وَعَهِدۡنَآ","وأَوْحَينا."],[19,19,"ٱلۡعَـٰكِفِينَ","المقيمينَ فيه للعبادةِ."]],"126":[[21,21,"أُمَتِّعُهُۥ","فأَرْزُقُه في حياتهِ."],[24,24,"أَضۡطَرُّهُۥٓ","أُلْجِئُه."],[29,29,"ٱلۡمَصِيرُ","المَرْجِعُ."]],"127":[[3,5,"ٱلۡقَوَاعِدَ مِنَ ٱلۡبَيۡتِ","أُسُس الكعبةِ التي تنهضُ عليها."]],"128":[[2,3,"مُسۡلِمَيۡنِ لَكَ","منقادَيْن لأحكامِك."],[7,7,"مُّسۡلِمَةً","منقادةً."],[9,10,"وَأَرِنَا مَنَاسِكَنَا","بَصِّرْنا بمعالِم عِبادتِنا."]],"129":[[2,2,"فِيهِمۡ","في هذه الأمةِ."],[4,4,"مِّنۡهُمۡ","من ذريةِ إسماعيلَ."],[9,10,"ٱلۡكِتَـٰبَ وَٱلۡحِكۡمَةَ","القرآنَ، والسُنَّةَ."],[11,11,"وَيُزَكِّيهِمۡ","يُطَهِّرُهم من الشِّرْكِ، وسوءِ الأخلاقِ."]],"130":[[1,4,"يَرۡغَبُ عَن مِّلَّةِ إِبۡرَٰهِـۧمَ","يُعْرِضُ عن دينِه."],[7,8,"سَفِهَ نَفۡسَهُۥ","جَهِلَتْ نَفْسُه ما ينفعُها."],[10,10,"ٱصۡطَفَيۡنَـٰهُ","اختَرناه."]],"131":[[4,4,"أَسۡلِمۡ","أخْلِصْ نفسَك لله."]],"132":[[8,8,"ٱصۡطَفَىٰ","اختارَ."]],"133":[[1,1,"كُنتُمۡ","أيُّها اليهودُ."],[2,2,"شُهَدَآءَ","حاضِرِين، فلا تَدَّعُوا الأباطيلَ."],[26,26,"مُسۡلِمُونَ","مُنْقادُون، خاضِعُون."]],"134":[[3,3,"خَلَتۡ","مَضَتْ."],[5,6,"مَا كَسَبَتۡ","ما عَمِلَتْ."]],"135":[[5,5,"تَهۡتَدُواْ","تُصِيبوا الحقَّ."],[7,9,"بَلۡ مِلَّةَ إِبۡرَٰهِـۧمَ","بل الهدايةُ أن نتَّبعَ دينَ إبراهيمَ."],[10,10,"حَنِيفًا","مائلًا عن الباطلِ."]],"136":[[13,13,"وَٱلۡأَسۡبَاطِ","هم الأنبياءُ من ولَدِ يعقوبَ في قبائلِ بني إسرائيلَ الاثنتي عَشْرَةَ."],[30,30,"مُسۡلِمُونَ","خاضعون."]],"137":[[9,9,"تَوَلَّوۡاْ","أعْرَضُوا."],[13,13,"شِقَاقٍ","خلافٍ شديدٍ."],[14,15,"فَسَيَكۡفِيكَهُمُ ٱللَّهُ","سيَكْفيك شَرَّهم."]],"138":[[0,1,"صِبۡغَةَ ٱللَّهِ","الزَمُوا دينَ اللهِ الإسلامَ."],[6,6,"صِبۡغَةً","دِينًا."]],"139":[[1,1,"أَتُحَآجُّونَنَا","أتجادِلُوننا وتخاصِمُوننا؟"],[13,13,"مُخۡلِصُونَ","لا نعبدُ أحدًا غيره."]],"140":[[17,18,"وَمَنۡ أَظۡلَمُ","لا أحدَ أظلمُ."],[20,20,"كَتَمَ","أخْفى، وادَّعى خِلافَها."]],"141":[[3,3,"خَلَتۡ","مَضَتْ."],[6,6,"كَسَبَتۡ","عَمِلَتْ."]],"142":[[1,1,"ٱلسُّفَهَآءُ","الجُهّالُ وضِعافُ العقولِ، وهم اليهودُ."],[4,5,"مَا وَلَّىٰهُمۡ","أيُّ شيءٍ صَرَفَ المسلمين؟"],[6,7,"عَن قِبۡلَتِهِمُ","عن بيتِ المقْدِسِ، وهي قِبلة المسلمين أولَ الإسلامِ."],[19,19,"صِرَٰطٍ","طريقٍ."]],"143":[[3,3,"وَسَطًا","عُدُولًا خِيارًا، لا إفراطَ عندكم، ولا تفْريطَ."],[4,5,"لِّتَكُونُواْ شُهَدَآءَ","لتَشْهَدُوا على الأممِ في الآخرةِ أنّ رُسُلَهم بَلَّغُوا."],[11,11,"شَهِيدًا","يشهدُ أنه بَلَّغَ الرسالةَ إلى أمَّتِه."],[15,17,"ٱلَّتِي كُنتَ عَلَيۡهَآ","التي صَرَفْناك عنها إلى الكعبةِ."],[24,26,"يَنقَلِبُ عَلَىٰ عَقِبَيۡهِ","يَرْتَدُّ عن دينِه."],[27,28,"وَإِن كَانَتۡ","وإنّ تحويلَ الِقْبلَةِ."],[29,29,"لَكَبِيرَةً","لَثقيلةً شاقةً."],[38,39,"لِيُضِيعَ إِيمَـٰنَكُمۡ","يُبْطِلَ صلاتَكم إلى القِبْلَةِ السّابقةِ."]],"144":[[4,5,"فِي ٱلسَّمَآءِ","أي: انتظارًا للوَحْي في شأنِ القِبْلَةِ."],[6,6,"فَلَنُوَلِّيَنَّكَ","فَلنُوَجِّهَنّك."],[9,10,"فَوَلِّ وَجۡهَكَ","اصرِفْ وجْهَك."],[11,11,"شَطۡرَ","جِهَةَ."],[17,17,"فَوَلُّواْ","فَتَوجَّهُوا."],[25,26,"أَنَّهُ ٱلۡحَقُّ","أن تحويلَكَ إلى الكعبةِ هو الثابتُ في كُتُبهِم."]],"145":[[6,6,"ءَايَةٍ","حُجَّةٍ."],[31,31,"ٱلظَّـٰلِمِينَ","لأنفسِهم، المخالِفِين لأمرِ ربِّهم."]],"146":[[0,2,"ٱلَّذِينَ ءَاتَيۡنَـٰهُمُ ٱلۡكِتَـٰبَ","هم أحبارُ اليهود، وعلماءُ النَّصارى."],[3,3,"يَعۡرِفُونَهُۥ","يَعْرِفُون محمدًا، أو يَعْرِفُون أن البيتَ الحرامَ قِبْلَتُهم، وقبلةُ الأنبياءِ السابقين."]],"147":[[6,6,"ٱلۡمُمۡتَرِينَ","الشّاكِّين."]],"148":[[0,1,"وَلِكُلٍّ وِجۡهَةٌ","ولكلِّ أهلِ دينٍ قبلةٌ."],[2,3,"هُوَ مُوَلِّيهَا","مُتَوَجِّهٌ إليها في صلاتِه."],[4,4,"فَٱسۡتَبِقُواْ","فبادِرُوا، وسارِعُوا."],[9,10,"يَأۡتِ بِكُمُ","يومَ القيامةِ."]],"149":[[3,4,"فَوَلِّ وَجۡهَكَ","تَوَجَّهْ."],[5,5,"شَطۡرَ","نَحْوَ."],[8,8,"وَإِنَّهُۥ","وإنّ تَوَجُّهَك إليه."]],"150":[[18,18,"حُجَّةٌ","هي قولُهم حينَ تَوَجَّهَ إلى المسجدِ الحرامِ: اشتاقَ إلى دينِ قومِه."],[20,21,"ٱلَّذِينَ ظَلَمُواْ","هم مشركُو قريشٍ، أو المعاندون أهلُ الكتابِ، فسيَبْقَون على جِدالهم وعِنادهِم."],[26,27,"وَلِأُتِمَّ نِعۡمَتِي","باختيار أكملِ الشَّرائعِ لكم."]],"151":[[0,1,"كَمَآ أَرۡسَلۡنَا","كما أنَعمْنا عليكم باستقبالِ الكعبةِ أرسَلْنا."],[8,8,"يُزَكِّيكُمۡ","يُطَهِّرُكم من الشِّرك، وسوءِ الأخلاقِ."],[11,11,"ٱلۡحِكۡمَةَ","السُّنَّةَ."]],"152":[[0,0,"فَٱذۡكُرُونِيٓ","بالطاعةِ."],[1,1,"أَذۡكُرۡكُمۡ","بالثَّوابِ والمغفرةِ."]],"154":[[9,9,"أَحۡيَآءٌ","حياةً خاصةً بهم في قُبورِهم."],[11,12,"لَّا تَشۡعُرُونَ","لا تُحِسُّون بهذه الحياةِ."]],"155":[[0,0,"وَلَنَبۡلُوَنَّكُم","ولَنَخْتَبِرَنَّكم."]],"156":[[5,6,"إِنَّا لِلَّهِ","إنّا عَبيدٌ له، مُدَبَّرُون بتصريفِه."]],"157":[[2,2,"صَلَوَٰتٌ","مغفرةٌ، وثناءٌ حَسَنٌ."]],"158":[[4,5,"شَعَآئِرِ ٱللَّهِ","منْ معالمِ دينِه، وأعلامِ مَناسِكِه."],[7,8,"حَجَّ ٱلۡبَيۡتَ","قَصَدَه للحجِّ أو العمرةِ."],[11,12,"فَلَا جُنَاحَ","فلا حَرَجَ ولا إثمَ، بل يجبُ السَّعْيُ."],[15,16,"يَطَّوَّفَ بِهِمَا","يَسْعى بينهما."],[18,18,"تَطَوَّعَ","فَعَلَ الطاعةَ مِن نفسِه."]],"159":[[2,2,"يَكۡتُمُونَ","يُخْفُون. وهم أحبارُ اليهودِ، وعلماءُ النصارى، وكلُّ مَن كَتَمَ الحقَّ."],[6,6,"ٱلۡبَيِّنَـٰتِ","الآياتِ الواضحاتِ الدالَّةِ على نُبُوَّةِ محمدٍ ﷺ."],[11,11,"بَيَّنَّـٰهُ","أظْهَرْناه في التوراةِ والإنجيلِ."]],"160":[[3,3,"وَأَصۡلَحُواْ","ما أفْسَدُوه."]],"161":[[8,9,"لَعۡنَةُ ٱللَّهِ","الطَّرْدُ مِن رحمته."]],"162":[[0,1,"خَـٰلِدِينَ فِيهَا","دائمِين في اللَّعْنَةِ والنارِ."],[8,8,"يُنظَرُونَ","يُمْهَلُون لكي يَعْتَذِرُوا."]],"164":[[5,7,"ٱخۡتِلَـٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ","تعاقُبِهما."],[8,8,"ٱلۡفُلۡكِ","السُّفُن."],[26,27,"بَعۡدَ مَوۡتِهَا","بعد قَحْطِها وجَفافِها."],[28,28,"بَثَّ","نَشَر، وفَرَّقَ."],[32,32,"دَآبَّةٍ","كلِّ ما دَبَّ على وجهِ الأرضِ."],[33,34,"وَتَصۡرِيفِ ٱلرِّيَـٰحِ","تَوْجيهِها، وهُبوبِها، وفْقَ ما يريدُ."],[36,36,"ٱلۡمُسَخَّرِ","المُسَيَّرِ."],[40,40,"لَـَٔايَـٰتٍ","لَعلاماتٍ ودَلالاتٍ على قُدْرةِ اللهِ."]],"165":[[7,7,"أَندَادًا","نُظَراءَ كالأصنامِ والأولياءِ."],[9,10,"كَحُبِّ ٱللَّهِ","يَمْنحونهم من التعظيم ما لا يَليقُ إلا باللهِ."],[20,26,"إِذۡ يَرَوۡنَ ٱلۡعَذَابَ أَنَّ ٱلۡقُوَّةَ لِلَّهِ جَمِيعًا","أي: ليعلَمُوا حين يَرَوْنَ عذابَ جهنَّمَ أن اللهَ هو المتفرِّدُ بالقوةِ."]],"166":[[2,3,"ٱلَّذِينَ ٱتُّبِعُواْ","هم الرؤساءُ."],[11,11,"ٱلۡأَسۡبَابُ","الصِّلاتُ من القَرابَةِ والأَتْباعِ وغيرِ ذلك."]],"167":[[6,6,"كَرَّةً","عودةً إلى الدنيا."],[12,12,"كَذَٰلِكَ","أي: كما أراهم عذابه، يُريهم أعمالَهم الفاسدةَ."],[16,16,"حَسَرَٰتٍ","نَداماتٍ."]],"168":[[10,11,"خُطُوَٰتِ ٱلشَّيۡطَـٰنِ","طُرُقَه، وآثارَه."]],"169":[[3,3,"وَٱلۡفَحۡشَآءِ","المعصيةِ البالغةِ القُبْحِ."]],"170":[[11,11,"أَلۡفَيۡنَا","وجَدْنا."],[14,18,"أَوَلَوۡ كَانَ ءَابَآؤُهُمۡ لَا يَعۡقِلُونَ","أي: يَتَّبِعُونهم؟"]],"171":[[0,2,"وَمَثَلُ ٱلَّذِينَ كَفَرُواْ","صِفَتُهم مع مَن يَدْعُوهم إلى الهُدى."],[4,5,"ٱلَّذِي يَنۡعِقُ","هو الرّاعِي الذي يَصيحُ بالبهائمِ، ويَزْجُرُها، وهي لا تَفْهَمُ معنى كلامِه، وإنما تَسْمَعُ صوته."],[12,12,"صُمُّۢ","سَدُّوا أسماعَهم عن الحقِّ."],[13,13,"بُكۡمٌ","أسْكَتُوا ألسنتَهم عن النُّطْقِ بالحقِّ."],[14,14,"عُمۡيٌ","لا يَرَوْن أدلَّةَ الحقِّ."]],"173":[[7,11,"وَمَآ أُهِلَّ بِهِۦ لِغَيۡرِ ٱللَّهِ","هي الذَّبائحُ التي يُذْكَرُ عند ذَبْحِها غيرُ اللهِ."],[14,15,"غَيۡرَ بَاغٍ","غيرَ طالِبٍ للمُحَرَّمِ، مع كونهِ لا يجدُ غيرَ ما ذُكِرَ، مما أحَلَّه اللهُ."],[16,17,"وَلَا عَادٍ","ولا مُتَجاوزٍ حَدَّ الضَّرورةِ."]],"174":[[1,2,"ٱلَّذِينَ يَكۡتُمُونَ","هم أهلُ الكتابِ الذين يُخْفُون."],[3,7,"مَآ أَنزَلَ ٱللَّهُ مِنَ ٱلۡكِتَـٰبِ","من صفةِ محمدٍ ﷺ وغيرِ ذلك من الحقِّ."],[8,11,"وَيَشۡتَرُونَ بِهِۦ ثَمَنًا قَلِيلًا","يأخذون مُقابِلَ الإخفاءِ قليلًا مِن عَرَضِ الدُّنيا."],[17,18,"إِلَّا ٱلنَّارَ","إلا ما يُورِدُهم النارَ."],[19,20,"وَلَا يُكَلِّمُهُمُ","ولا يُطَهِّرُهم"]],"176":[[12,13,"شِقَاقِۭ بَعِيدٍ","مُنازَعَةٍ بعيدةٍ عن الصَّوابِ."]],"177":[[1,1,"ٱلۡبِرَّ","الخيرَ."],[2,3,"أَن تُوَلُّواْ","أن تَتَوَجَّهُوا في الصَّلاةِ."],[5,5,"قِبَلَ","جِهَةَ."],[10,11,"مَنۡ ءَامَنَ","بِرَّ مَن آمَنَ."],[20,21,"عَلَىٰ حُبِّهِۦ","وهو للمالِ مُحِبٌّ."],[26,27,"وَٱبۡنَ ٱلسَّبِيلِ","هو المسافِرُ المحتاجُ."],[29,30,"وَفِي ٱلرِّقَابِ","في تحريرِ العبيدِ، والأسرى."],[41,41,"ٱلۡبَأۡسَآءِ","البؤسِ والفقرِ."],[42,42,"ٱلضَّرَّآءِ","المرضِ."],[44,44,"ٱلۡبَأۡسِ","مواطِنِ القتالِ."]],"178":[[3,3,"كُتِبَ","فَرَضَ اللهُ."],[5,5,"ٱلۡقِصَاصُ","أن يُوقَعَ على الجاني مثلُ ما جَنى."],[14,16,"فَمَنۡ عُفِيَ لَهُۥ","مَن سامَحه وليُّ المقتولِ بالعفوِ عَنِ القِصاصِ والاكتفاءِ بالدِّيَةِ."],[20,20,"فَٱتِّبَاعُۢ","فاتِّباعُ ما أوجبه اللهُ نحوَ القاتِلِ من الدِّيَةِ."],[21,21,"بِٱلۡمَعۡرُوفِ","من غير عُنفٍ من قِبَلِ وليِّ المقتولِ."],[22,23,"وَأَدَآءٌ إِلَيۡهِ","أداءُ ما لَزِمَ وليَّ القاتلِ إلى أولياءِ المقتولِ."],[24,24,"بِإِحۡسَـٰنٍ","من غيرِ تأخيرٍ، ولا نَقْصٍ."],[31,31,"ٱعۡتَدَىٰ","تجاوَزَ بعد أخْذِ الدِّيةِ."]],"179":[[3,3,"حَيَوٰةٌ","أي: آمِنةٌ لكم، وفيه عقوبةٌ لأهلِ السَّفَهِ."],[5,5,"ٱلۡأَلۡبَـٰبِ","العُقولِ السَّليمةِ."]],"180":[[0,0,"كُتِبَ","فَرَضَ اللهُ."],[5,5,"ٱلۡمَوۡتُ","علاماتُه ومقدِّماتُه."],[8,8,"خَيۡرًا","مالًا."],[12,12,"بِٱلۡمَعۡرُوفِ","بالعدلِ."]],"181":[[1,1,"بَدَّلَهُۥ","غَيَّرَ ما وصّى به الميتُ."],[6,6,"إِثۡمُهُۥ","إثمُ التغييرِ."]],"182":[[4,6,"جَنَفًا أَوۡ إِثۡمًا","مَيْلًا عَنِ الحَقِّ على سبيل الخطأ أو العَمْدِ."],[8,8,"بَيۡنَهُمۡ","أطرافِ المَيتِ."],[9,11,"فَلَآ إِثۡمَ عَلَيۡهِ","فلا ذَنْبَ عليه بتغييرِ الوصيةِ."]],"183":[[9,11,"ٱلَّذِينَ مِن قَبۡلِكُمۡ","هم أهلُ الكتابِ."]],"184":[[0,1,"أَيَّامًا مَّعۡدُودَٰتٍ","أيامًا مُحْصَياتٍ، وهي شهرُ رمضانَ."],[9,12,"فَعِدَّةٌ مِّنۡ أَيَّامٍ أُخَرَ","فعليه صيامٌ بقَدْرِ ما أفْطَرَ، من أيامٍ أُخَرَ."],[15,15,"يُطِيقُونَهُۥ","يَتَكَلَّفُون صيامَه ويَشُقُّ عليهم."],[18,18,"مِسۡكِينٍ","هو المحتاجُ الذي لا يَمْلِكُ ما يَكْفيه."],[20,21,"تَطَوَّعَ خَيۡرًا","زاد في قَدْرِ الفِدْيةِ تَبَرُّعًا منه."]],"185":[[6,6,"هُدًى","إرشادًا إلى سبيلِ الحقِّ."],[8,8,"وَبَيِّنَـٰتٍ","دلائلَ واضحةً من البيان."],[11,11,"وَٱلۡفُرۡقَانِ","والفَصْل بينَ الحقِّ والباطلِ."],[36,36,"ٱلۡعِدَّةَ","عدةَ الصيامِ شهرًا، أو عدةَ ما أفْطَرَ فيه المريضُ والمسافرُ."],[37,38,"وَلِتُكَبِّرُواْ ٱللَّهَ","ولِتُعَظِّمُوه بذِكْرِه، وذلك هو التكبيرُ يومَ الفِطْرِ."]],"186":[[11,12,"فَلۡيَسۡتَجِيبُواْ لِي","فليُطيعوني فيما أمَرْتُهُم به، ونَهَيْتُهم عنه."],[16,16,"يَرۡشُدُونَ","يَهْتدون."]],"187":[[4,4,"ٱلرَّفَثُ","الجِماعُ."],[8,8,"لِبَاسٌ","سِتْرٌ وسَكَنٌ."],[17,17,"تَخۡتَانُونَ","تَخُونون. وكانوا يُجامِعُون نساءَهم بعدالعِشاء، وكان هذا مُحَرَّمًا أولَ الإسلامِ."],[24,24,"بَـٰشِرُوهُنَّ","جامِعُوهنَّ."],[25,29,"ٱبۡتَغُواْ مَا كَتَبَ ٱللَّهُ لَكُمۡ","واطْلبُوا ما قدَّره اللهُ من الوَلَدِ."],[35,36,"ٱلۡخَيۡطُ ٱلۡأَبۡيَضُ","ضوءُ الصبحِ."],[38,39,"ٱلۡخَيۡطِ ٱلۡأَسۡوَدِ","سوادِ الليلِ."],[61,61,"ءَايَـٰتِهِۦ","أحكامَه."]],"188":[[4,4,"بِٱلۡبَـٰطِلِ","بسببٍ باطلٍ كاليمينِ الكاذبةِ والرَّشوةِ."],[5,13,"وَتُدۡلُواْ بِهَآ إِلَى ٱلۡحُكَّامِ لِتَأۡكُلُواْ فَرِيقًا مِّنۡ أَمۡوَٰلِ ٱلنَّاسِ","لا تُلْقُوا بأموالِكم إلى الحُكّام؛ لتأكلوا أموالَ طائفةٍ من الناسِ بالحُجَجِ الباطلةِ."],[15,16,"وَأَنتُمۡ تَعۡلَمُونَ","تحريمَ ذلك."]],"189":[[2,2,"ٱلۡأَهِلَّةِ","جمعُ هِلالٍ، أي: عَنْ تَغَيُّر أحوالهِا بزيادةٍ أو نقصانٍ."],[5,5,"مَوَٰقِيتُ","علاماتٌ على أوقات العبادةِ والمعاملاتِ."],[9,9,"ٱلۡبِرُّ","الخير."],[10,14,"بِأَن تَأۡتُواْ ٱلۡبُيُوتَ مِن ظُهُورِهَا","كانوا أولَ الإسلام إذا أحْرَمُوا بحَجّ أو عُمْرَةٍ فَعَلُوا ذلك."],[17,18,"مَنِ ٱتَّقَىٰ","فِعْلُ مَن اتَّقى."]],"190":[[6,7,"وَلَا تَعۡتَدُوٓاْ","لا تَرْتَكِبُوا المَناهيَ كقَتْلِ مَن لا يحِلُّ قَتْلُه."]],"191":[[2,2,"ثَقِفۡتُمُوهُمۡ","وجَدْتُموهم في أيِّ مكانٍ تَمَكَّنْتُم مِن قَتْلهِم."],[7,7,"وَٱلۡفِتۡنَةُ","الشِّرْك باللهِ."]],"192":[[0,1,"فَإِنِ ٱنتَهَوۡاْ","تَرَكُوا ما هم فيه من الكفرِ والقِتالِ."]],"193":[[4,4,"فِتۡنَةٌ","شِرْكٌ بالله، أو فتنةٌ للمسلمين عن دينِهم."],[6,7,"ٱلدِّينُ لِلَّهِ","خالصًا لله، لا يُعْبَدُ معه غيرُه."]],"194":[[0,1,"ٱلشَّهۡرُ ٱلۡحَرَامُ","الشهرُ الذي حَرَّمَ اللهُ القتالَ فيه."],[2,3,"بِٱلشَّهۡرِ ٱلۡحَرَامِ","إذا قاتَلُوكم فيه قاتَلْتُموهم فيه."],[4,5,"وَٱلۡحُرُمَـٰتُ قِصَاصٌ","مَن هَتَكَ حُرْمَةً عليكم فلكم أن تَهْتِكُوا حُرْمَةً عليه، مُساواةً."]],"195":[[8,8,"ٱلتَّهۡلُكَةِ","المَهالِك، وهو كلُّ ما صَدَقَ عليه أنه تَهْلُكَةٌ في الدِّين، أو الدُّنيا."]],"196":[[0,0,"وَأَتِمُّواْ","أدُّوهما تامَّيْنِ من غيرِ مَحْظورٍ."],[5,5,"أُحۡصِرۡتُمۡ","حَبَسَكم حابِسٌ عن إتمامِهما بعد الإحرام بِهما."],[6,7,"فَمَا ٱسۡتَيۡسَرَ","فعليكم ذَبْحُ ما تَيَسَّرَ."],[9,9,"ٱلۡهَدۡيِ","ما يُهدى إلى البيت من الإبِلِ، أو البقر، أو الغنمِ."],[10,12,"وَلَا تَحۡلِقُواْ رُءُوسَكُمۡ","لا تُحِلُّوا من الإحرام بالَحلْقِ إن كنتم مُحْصَرِين."],[16,16,"مَحِلَّهُۥ","الموضع الذي حُصِرْتُم فيه."],[31,32,"أَوۡ نُسُكٍ","أو ذبيحةٍ، وهي شاة لفقراءِ الحرمِ."],[34,34,"أَمِنتُمۡ","كنتم في أمْنٍ وصحةٍ."],[36,39,"تَمَتَّعَ بِٱلۡعُمۡرَةِ إِلَى ٱلۡحَجِّ","أحرمَ بعُمْرَةٍ، ثم أقامَ حلالًا بمكةَ إلى أن يُحْرِمَ بالحجِّ."],[55,55,"ذَٰلِكَ","أي بالهَدْيِ وما تَرَتَّبَ عليه من الصِّيامِ."],[63,65,"حَاضِرِي ٱلۡمَسۡجِدِ ٱلۡحَرَامِ","ساكنِي أرضِ الحَرمِ."]],"197":[[0,2,"ٱلۡحَجُّ أَشۡهُرٌ مَّعۡلُومَـٰتٌ","وقتُ الحجِّ أشهرٌ معلوماتٌ، هي: شوالٌ وذو القِعْدَةِ وعَشْرُ ذي الحِجَّةِ."],[4,4,"فَرَضَ","أوْجَبَ الحَجَّ على نفسِه، وعَزَمَ."],[8,8,"رَفَثَ","الجِماعَ ومقدِّماتِه."],[10,10,"فُسُوقَ","الخُروجَ عن طاعةِ اللهِ بإتيانِ ما نُهِيَ عنه في حال إحرامِه لحَجِّه."],[11,12,"وَلَا جِدَالَ","ولا تنازُعَ، ولا مِراءَ."],[21,21,"وَتَزَوَّدُواْ","خُذُوا زادًا من الطَّعامِ والشَّرابِ، وزادًا من صالحِ الأعمالِ."],[27,28,"يَـٰٓأُوْلِي ٱلۡأَلۡبَـٰبِ","يا أصحاب العقولِ السليمةِ."]],"198":[[2,2,"جُنَاحٌ","حَرَجٌ."],[5,5,"فَضۡلًا","التماسَ الرزقِ بالتجارةِ وقْتَ الحَجِّ."],[9,9,"أَفَضۡتُم","دَفَعْتُم."],[15,16,"ٱلۡمَشۡعَرِ ٱلۡحَرَامِ","المَعْلَمِ الحَرامِ، وهو مُزْدَلِفَةُ."],[18,19,"كَمَا هَدَىٰكُمۡ","على الوَجْهِ الصَّحيحِ الذي هداكم إليه."],[20,21,"وَإِن كُنتُم","ولقد كنتم."]],"199":[[2,5,"مِنۡ حَيۡثُ أَفَاضَ ٱلنَّاسُ","كما عَمِلَ إبراهيمُ عليه السلامُ."]],"200":[[1,2,"قَضَيۡتُم مَّنَـٰسِكَكُمۡ","فَرَغْتُم مِن حَجِّكم، وذَبَحْتُم النُّسُكَ."],[23,23,"خَلَـٰقٍ","نَصِيبٍ."]],"201":[[5,7,"فِي ٱلدُّنۡيَا حَسَنَةً","عافيةً ورزقًا."],[8,10,"وَفِي ٱلۡـَٔاخِرَةِ حَسَنَةً","الَجنّةَ."]],"202":[[2,4,"نَصِيبٌ مِّمَّا كَسَبُواْ","حَظٌّ من أعمالهِم."],[6,7,"سَرِيعُ ٱلۡحِسَابِ","مُحْصٍ أعمالَ عبادِه، ومُجازِيهم بها."]],"203":[[2,4,"فِيٓ أَيَّامٍ مَّعۡدُودَٰتٍ","هي أيامُ الحادي عشر والثاني عشرَ والثالثَ عشرَ مِن ذِي الحِجّةِ، في مِنى."],[6,6,"تَعَجَّلَ","نَفرَ من مِنى في اليومِ الثاني عشرَ."],[9,10,"فَلَآ إِثۡمَ","فلا حَرَجَ، ولا ذَنْبَ عليه في تَعَجُّله."],[12,13,"وَمَن تَأَخَّرَ","فنَفَرَ في اليومِ الثالثَ عَشَرَ."]],"204":[[0,1,"وَمِنَ ٱلنَّاسِ","من المنافقين."],[10,13,"عَلَىٰ مَا فِي قَلۡبِهِۦ","من محبَّةِ الإسلامِ."],[15,16,"أَلَدُّ ٱلۡخِصَامِ","شديدُ العَداوةِ والمخاصَمَةِ."]],"205":[[1,1,"تَوَلَّىٰ","خَرَجَ مِن عندِك."],[8,8,"ٱلۡحَرۡثَ","الزَّرْعَ."],[9,9,"وَٱلنَّسۡلَ","نَسْلَ كلِّ دابَّةٍ."]],"206":[[5,6,"أَخَذَتۡهُ ٱلۡعِزَّةُ","حَمَلَه الكِبْرُ وحَمِيَّةُ الجاهليةِ."],[8,8,"فَحَسۡبُهُۥ","فكافيتُه."],[11,11,"ٱلۡمِهَادُ","الفِراشُ."]],"207":[[3,3,"يَشۡرِي","يَبيعُ."]],"208":[[5,5,"ٱلسِّلۡمِ","شرائعِ الإسلامِ."],[6,6,"كَآفَّةً","في جميعِ أحكامِه، فلا تُضَيِّعُوا منها شيئًا."],[9,10,"خُطُوَٰتِ ٱلشَّيۡطَـٰنِ","طُرُقَه وآثارَه."],[14,14,"مُّبِينٌ","ظاهرُ العَداوةِ."]],"209":[[1,1,"زَلَلۡتُم","أخْطَأْتُم الحقَّ."],[6,6,"ٱلۡبَيِّنَـٰتُ","الحُجَجُ الواضحَةُ."],[10,10,"عَزِيزٌ","في نِقْمَتِه."],[11,11,"حَكِيمٌ","يَضَعُ كلَّ شيءٍ في مَوْضِعِه المناسِبِ."]],"210":[[0,1,"هَلۡ يَنظُرُونَ","ما ينتظرُ هؤلاء الكافرونَ."],[4,5,"يَأۡتِيَهُمُ ٱللَّهُ","على الوجهِ الذي يَليقُ به."],[7,7,"ظُلَلٍ","جمعُ ظُلَّةٍ، وهي ما يُسْتَظَلُّ به."],[9,9,"ٱلۡغَمَامِ","السَّحابِ."],[11,12,"وَقُضِيَ ٱلۡأَمۡرُ","وفُصِلَ القضاءُ بالعَدْلِ."]],"211":[[6,7,"ءَايَةِۭ بَيِّنَةٍ","علامةٍ واضحةٍ، كعَصا موسى ويدِه."],[10,11,"نِعۡمَةَ ٱللَّهِ","الإسلامَ، وما فَرَضَ من شرائعِ دينِه."]],"212":[[0,0,"زُيِّنَ","حُسِّنَ."],[5,5,"وَيَسۡخَرُونَ","ويَسْتهزِئُون."],[11,11,"فَوۡقَهُمۡ","يُدْخِلُهم اللهُ أعلى درجاتِ الجنةِ."]],"213":[[2,3,"أُمَّةً وَٰحِدَةً","جماعةً واحدةً متفقين على دينٍ واحدٍ."],[7,7,"مُبَشِّرِينَ","مَن أطاع اللهَ بالجنةِ."],[8,8,"وَمُنذِرِينَ","ومُحَذِّرينَ مَن عصاه النارَ."],[11,11,"ٱلۡكِتَـٰبَ","الكُتُبَ السماويةَ."],[18,18,"فِيهِ","في الكتابِ الذي أنزلَه اللهُ."],[24,24,"أُوتُوهُ","أُعْطُوا الكتابَ."],[29,29,"ٱلۡبَيِّنَـٰتُ","حُجَجُ اللهِ، وأدِلَّتهُ."],[30,30,"بَغۡيَۢا","حَسَدًا، وحِرْصًا على الدنيا."],[32,33,"فَهَدَى ٱللَّهُ","فوفَّقَ أمةَ محمدٍ ﷺ إلى الحَقِّ."],[47,47,"صِرَٰطٍ","طريقٍ."]],"214":[[9,9,"خَلَوۡاْ","مضَوا."],[13,13,"ٱلۡبَأۡسَآءُ","الفقرُ والشِّدَّةُ."],[14,14,"ٱلضَّرَّآءُ","الأمراضُ."],[15,15,"زُلۡزِلُواْ","أُزعِجُوا إزعاجًا شديدًا."]],"215":[[10,10,"وَٱلۡيَتَـٰمَىٰ","والذين مات آباؤُهم وهم دونَ البُلوغِ."],[11,11,"وَٱلۡمَسَـٰكِينِ","والمحتاجِين الذين لا يملكونَ ما يَكْفيهم."],[12,13,"وَٱبۡنِ ٱلسَّبِيلِ","والمسافرِ المحتاجِ."]],"216":[[0,0,"كُتِبَ","فَرَضَ اللهُ."],[20,21,"وَٱللَّهُ يَعۡلَمُ","ما هو خيرٌ لكم."]],"217":[[0,0,"يَسۡـَٔلُونَكَ","يَسْألك المُشْركون."],[4,5,"قِتَالٍ فِيهِ","هل يَحِلُّ القِتالُ فيه؟"],[10,10,"وَصَدٌّ","ومَنعٌ."],[14,15,"وَكُفۡرُۢ بِهِۦ","وكُفْرٌ باللهِ."],[16,17,"وَٱلۡمَسۡجِدِ ٱلۡحَرَامِ","وصَدٌّ عن المسجدِ الحرامِ كذلك."],[24,24,"وَٱلۡفِتۡنَةُ","الشِّرْكُ."],[25,27,"أَكۡبَرُ مِنَ ٱلۡقَتۡلِ","أعظمُ من القَتْلِ في الشهرِ الحرامِ."],[46,46,"حَبِطَتۡ","بَطَلَتْ، وفَسَدَتْ."]],"219":[[3,3,"وَٱلۡمَيۡسِرِ","القِمارِ."],[6,6,"إِثۡمٌ","أضرارٌ، ومفاسدُ."],[8,8,"وَمَنَـٰفِعُ","مِن جهةِ كَسْبِ المالِ واللَّذَّةِ وغيرِهما، وهذا قبلَ التحريمِ."],[18,18,"ٱلۡعَفۡوَ","الفَضْلَ الزائدَ على الحاجةِ."]],"220":[[7,8,"إِصۡلَاحٌ لَّهُمۡ","مُخالَطَتُهم على وجهِ الإصلاحِ لأموالِهم."],[21,21,"لَأَعۡنَتَكُمۡ","لَأَوقَعكُم فيما فيه الحَرَجُ والمَشَقَّةُ بتحريمِ مخالطَتِهم."],[25,25,"حَكِيمٌ","يتَصَرَّفُ في مُلْكِه بما تَقْتضيه حِكْمَتُه."]],"221":[[2,2,"ٱلۡمُشۡرِكَـٰتِ","الوثنيّاتِ."],[5,5,"وَلَأَمَةٌ","المملوكةُ الرقيقةُ."],[24,24,"أُوْلَـٰٓئِكَ","المشركون رجالًا ونساءً."],[26,27,"إِلَى ٱلنَّارِ","إلى الأعمالِ المُوجبةِ للنارِ."],[33,33,"بِإِذۡنِهِۦ","بأمرهِ، وتوفيقِه."]],"222":[[6,6,"فَٱعۡتَزِلُواْ","اجتنِبُوا الجِماعَ، لا المجالسةَ، أو الملامسةَ."],[10,11,"وَلَا تَقۡرَبُوهُنَّ","ولا تجامِعُوهُنَّ."],[13,13,"يَطۡهُرۡنَ","ينقطِعُ دَمُهُن."],[15,15,"تَطَهَّرۡنَ","اغتسَلْن."],[16,20,"فَأۡتُوهُنَّ مِنۡ حَيۡثُ أَمَرَكُمُ ٱللَّهُ","فجامِعُوهن في الموضعِ الذي أحلَّه اللهُ وهو القُبُلُ."]],"223":[[1,2,"حَرۡثٌ لَّكُمۡ","موضعُ زَرْعٍ لنُطَفِكم."],[5,6,"أَنَّىٰ شِئۡتُمۡ","من أيِّ جهةٍ شِئْتم، في موضع الحَرْثِ."],[7,8,"وَقَدِّمُواْ لِأَنفُسِكُمۡ","من التقرُّبِ إلى اللهِ بفعلِ الخيراتِ."]],"224":[[3,4,"عُرۡضَةً لِّأَيۡمَـٰنِكُمۡ","مانعًا لكم، وحاجزًا من البِرّ، وفِعْلِ الخيرِ. فإذا دُعِيتم إلى فِعْلِه قُلْتم: إنّكم أقْسَمْتُم ألّا تفعلُوه، فالحالِفُ يُمْكِنُه أن يفعلَ البِرَّ، ثم يُكَفِّرَ."],[5,6,"أَن تَبَرُّواْ","مانعًا من بِرِّكم، وإصلاحِكم."]],"225":[[3,3,"بِٱللَّغۡوِ","هو اليمينُ بغير إرادةٍ لها وقَصْدٍ."],[9,10,"كَسَبَتۡ قُلُوبُكُمۡ","قَصَدَتْه قُلوبُكم."]],"226":[[1,1,"يُؤۡلُونَ","يَحْلِفُون ألّا يُجامِعُوا نساءَهم أكثرَ من أربعةِ أشهرٍ."],[4,6,"تَرَبُّصُ أَرۡبَعَةِ أَشۡهُرٍ","عليهم انتظارُ أربعةِ أشهرٍ."],[7,7,"فَآءُو","رَجَعُوا قبلَ فواتِ الأشهرِ الأربعةِ."],[11,11,"غَفُورٌ","لا يُؤاخِذُهم بتلك اليمينِ."]],"227":[[1,2,"عَزَمُواْ ٱلطَّلَـٰقَ","وقَعَ العَزْمُ منهم على الطَّلاقِ باستمرارِهم في اليمينِ."]],"228":[[1,1,"يَتَرَبَّصۡنَ","ينتَظِرْن دُونَ نكاحٍ بعدَ الطَّلاقِ."],[3,4,"ثَلَـٰثَةَ قُرُوٓءٍ","ثلاثةَ أوقاتٍ من الطُّهر أو الحيضِ للتأكدِ من فراغِ الرَّحِم."],[9,9,"يَكۡتُمۡنَ","يُخْفِينَ الحَمْلَ، أو الحيضَ."],[21,21,"وَبُعُولَتُهُنَّ","هم أزواجُ المطلقاتِ."],[22,23,"أَحَقُّ بِرَدِّهِنَّ","أحقُّ بمُراجَعَتِهِنَّ في العِدَّةِ."],[36,36,"دَرَجَةٌ","منزلةٌ زائدةٌ من القِوامةِ على البيتِ، والإنفاقِ، والزيادةِ في الميراث، وغيرِ ذلك."]],"229":[[0,1,"ٱلطَّلَـٰقُ مَرَّتَانِ","أي: الذي تحصُلُ به الرَّجْعَةُ، وهو مرة بعدَ مرة."],[3,3,"بِمَعۡرُوفٍ","حُسْنِ العِشْرةِ بعدَ مراجَعَتِها."],[5,6,"تَسۡرِيحُۢ بِإِحۡسَـٰنٍ","تَخْلِيةُ سبيلِها، مع أداءِ حُقوقِها."],[14,14,"شَيۡـًٔا","ممّا أعْطَيْتُموه من المَهْر ونحوِه على وجهِ المُضارَّةِ."],[15,17,"إِلَّآ أَن يَخَافَآ","يخافَ الزوجان ألّا يقوما بالحقوقِ الزوجيَّةِ. وهي المُخالَعَةُ بالمعروفِ."],[22,23,"فَإِنۡ خِفۡتُمۡ","أي: الأولياءُ، أو المتوسِّطون بين الزوجَيْن."],[31,32,"فِيمَا ٱفۡتَدَتۡ","فيما تدفَعُه المرأةُ للزوجِ مقابلَ الطلاقِ، وهو الخُلْعُ."],[37,38,"فَلَا تَعۡتَدُوهَا","فلا تَتَجاوَزُوها."]],"230":[[0,1,"فَإِن طَلَّقَهَا","أي الطَّلْقَةَ الثالثةَ."],[8,8,"نكِحَ","بزَواجٍ صَحيحٍ وجِماعٍ."],[11,12,"فَإِن طَلَّقَهَا","أي الزوجُ الثاني."],[13,15,"فَلَا جُنَاحَ عَلَيۡهِمَآ","أي على الزوجِ الأولِ والمرأةِ."],[16,17,"أَن يَتَرَاجَعَآ","أن يتزوَّجا بعَقْدٍ جديدٍ، ومَهْرٍ جديدٍ."]],"231":[[3,4,"فَبَلَغۡنَ أَجَلَهُنَّ","فقارَبْنَ انقضاءَ العِدَّةِ."],[5,5,"فَأَمۡسِكُوهُنَّ","فراجِعُوهُنَّ."],[6,6,"بِمَعۡرُوفٍ","مِن غيرِ قَصْدٍ لضِرارٍ."],[8,8,"سَرِّحُوهُنَّ","اترُكُوهُنَّ، حتى تنقضِيَ العِدَّةُ."],[10,12,"وَلَا تُمۡسِكُوهُنَّ ضِرَارًا","لا تَكُنْ مُراجَعَتُهن بقَصْدِ الاعتداءِ، والظلمِ لهن."],[24,24,"هُزُوًا","لَعِبًا بها بالتجرُّؤِ عليها."],[34,34,"وَٱلۡحِكۡمَةِ","السُّنَّةِ."]],"232":[[0,1,"وَإِذَا طَلَّقۡتُمُ","خطابٌ لأولياءِ المطلقةِ دونَ الثلاثِ، إذا خَرَجَتْ من العِدَّةِ، وأرادَتْ زوجَها بنِكاحٍ جديدٍ."],[3,4,"فَبَلَغۡنَ أَجَلَهُنَّ","انتهَتْ عِدَّتُهن من غيرِ مراجعَةٍ لهنَّ."],[5,6,"فَلَا تَعۡضُلُوهُنَّ","فلا يجوزُ لوَلِيِّها أن يَمْنَعَها من التزوُّجِ بعَقْدٍ جديدٍ."],[14,14,"ذَٰلِكُمۡ","تمكينُ الأزواجِ من نكاحِ زوجاتِهِم."],[25,25,"أَزۡكَىٰ","أكثرُ نماءً وأنفعُ."]],"233":[[3,3,"حَوۡلَيۡنِ","سنتَيْنِ."],[10,12,"وَعَلَى ٱلۡمَوۡلُودِ لَهُۥ","هو الأبُ."],[13,13,"رِزۡقُهُنَّ","رِزْقُ المُرضِعاتِ المُطَلَّقاتِ."],[20,20,"وُسۡعَهَا","قَدْرَ طاقَتِها."],[21,24,"لَا تُضَآرَّ وَٰلِدَةُۢ بِوَلَدِهَا","لا يَحِلُّ للوالدَين أن يَجْعلوا المولودَ وسيلةً للمُضارَّةِ بينهما."],[29,32,"وَعَلَى ٱلۡوَارِثِ مِثۡلُ ذَٰلِكَ","أي: عند مَوْتِ الوالدِ وجَبَ على وارثِه مثلُ ما يجبُ على الوالدِ مِنَ النفقةِ والكِسْوةِ."],[34,34,"أَرَادَا","الوالدان."],[35,35,"فِصَالًا","فِطامَ المولودِ عن الرَّضاعةِ قبل السنتَين."],[46,46,"تَسۡتَرۡضِعُوٓاْ","إرضاعَ المولودِ من مُرْضِعَةٍ أخرى."],[51,52,"إِذَا سَلَّمۡتُم","سَلَّم الوالدُ للأمِّ حَقَّها، وسَلَّمَ للمُرْضِعَةِ أجْرَها."]],"234":[[5,5,"يَتَرَبَّصۡنَ","ينتظِرْنَ في منزلِ الزوجِ."],[11,12,"بَلَغۡنَ أَجَلَهُنَّ","انقضَتِ المدةُ المذكورةُ."],[16,17,"فِيمَا فَعَلۡنَ","مِنَ الخروجِ والتَّزيُّنِ والتعرُّضِ للخُطّابِ."]],"235":[[0,1,"وَلَا جُنَاحَ","ولا إثمَ."],[4,8,"عَرَّضۡتُم بِهِۦ مِنۡ خِطۡبَةِ ٱلنِّسَآءِ","لَمَّحْتُم مِن طَلَبِ الزواج مِنَ المُتوفّى عنهن أزواجُهُنَّ، أو المطلقاتِ طلاقًا بائنًا، في أثناءِ العِدَّةِ."],[10,10,"أَكۡنَنتُمۡ","أضْمَرْتُم من نيةِ الزواجِ بهنَّ بعد انتهاءِ عِدَّتِهن."],[18,20,"لَّا تُوَاعِدُوهُنَّ سِرًّا","على النِّكاح."],[24,25,"قَوۡلًا مَّعۡرُوفًا","أي: يُفْهَمُ منه أنّ مِثْلَها يُرْغَبُ فيها."],[30,32,"حَتَّىٰ يَبۡلُغَ ٱلۡكِتَـٰبُ","حتى تنقضِيَ عِدَّتُها."]],"236":[[0,1,"لَّا جُنَاحَ","لا إثمَ. والمرادُ به التَّبِعَةُ من المهرِ ونحوِه."],[3,4,"إِن طَلَّقۡتُمُ","قبلَ المسيسِ، وفَرْضِ المَهْرِ."],[9,11,"أَوۡ تَفۡرِضُواْ لَهُنَّ","قبلَ أن تُحَدِّدوا مَهْرًا لهنَّ."],[13,13,"وَمَتِّعُوهُنَّ","أي: بشيءٍ ينتفِعْنَ به جَبْرًا لهن."],[14,16,"عَلَى ٱلۡمُوسِعِ قَدَرُهُۥ","على المُطَلِّق الغنيِّ قَدْرُ سَعَةِ رزقِه."],[18,18,"ٱلۡمُقۡتِرِ","المُطَلِّقِ الفقيرِ."],[19,19,"قَدَرُهُۥ","قَدَرُ ما يَمْلِكُه."],[22,24,"حَقًّا عَلَى ٱلۡمُحۡسِنِينَ","أي: حَقًّا ثابتًا على الذين يُحْسِنون إلى الُمطَلَّقاتِ."]],"237":[[0,1,"وَإِن طَلَّقۡتُمُوهُنَّ","بعد العَقْدِ."],[5,5,"تَمَسُّوهُنَّ","تُجامِعُوهن."],[7,9,"فَرَضۡتُمۡ لَهُنَّ فَرِيضَةً","التَزمْتُم لهنَّ بمَهْرٍ معينٍ."],[13,15,"إِلَّآ أَن يَعۡفُونَ","إلا أن يَتَسامَحَ المُطَلَّقاتُ، فيترُكْنَ نصفَ المَهْرِ المستحَقِّ لهنَّ."],[16,18,"أَوۡ يَعۡفُوَاْ ٱلَّذِي","أو يتسامَحَ الزوجُ، فيتركَ للمطلقةِ المهرَ كلَّه."],[28,28,"ٱلۡفَضۡلَ","الإحسانَ، والتسامحَ في الحقوقِ."]],"238":[[0,0,"حَـٰفِظُواْ","واظِبُوا."],[3,4,"وَٱلصَّلَوٰةِ ٱلۡوُسۡطَىٰ","هي صلاةُ العَصْرِ."],[7,7,"قَـٰنِتِينَ","خاشِعين ذلِيلِين."]],"239":[[2,2,"فَرِجَالًا","ماشِين."],[4,4,"رُكۡبَانًا","راكبين."],[7,8,"فَٱذۡكُرُواْ ٱللَّهَ","أقيمُوا صلاتَكم كما أُمِرْتُمْ."]],"240":[[7,7,"مَّتَـٰعًا","يُمَتَّعْنَ بالسُّكنى والنفقةِ في منزلِ الزوجِ، وذلك قبلَ النَّسْخِ."],[8,9,"إِلَى ٱلۡحَوۡلِ","إلى سنةٍ كاملةٍ."],[10,11,"غَيۡرَ إِخۡرَاجٍ","لا يُخْرِجُهُنَّ الوَرَثَةُ."],[12,13,"فَإِنۡ خَرَجۡنَ","باختيارِهنَّ قبلَ الحَوْلِ."],[14,15,"فَلَا جُنَاحَ","فلا إثمَ."],[22,23,"مِن مَّعۡرُوفٍ","من أمورٍ مُباحَةٍ."]],"241":[[1,1,"مَتَـٰعُۢ","من كِسوةٍ ونفقةٍ."]],"245":[[3,3,"يُقۡرِضُ","يُنْفِقُ في سبيلِ اللهِ."],[12,12,"يَقۡبِضُ","يُضَيِّقُ في الرِّزقِ."],[13,13,"وَيَبۡصُۜطُ","ويُوَسِّعُ فيه."]],"246":[[3,3,"ٱلۡمَلَإِ","الأشرافِ."],[22,23,"هَلۡ عَسَيۡتُمۡ","هل الأمرُ كما أتَوَقَّعُه منكم، وهو الجُبْنُ عن القتالِ؟"],[25,25,"كُتِبَ","فُرِضَ."],[47,47,"تَوَلَّوۡاْ","فَرُّوا."]],"247":[[11,14,"أَنَّىٰ يَكُونُ لَهُ ٱلۡمُلۡكُ","كيف يكونُ له المُلْكُ، وهو لا يستحِقُّه؟"],[28,28,"ٱصۡطَفَىٰهُ","اختارَه."],[31,31,"بَسۡطَةً","سَعَةً وقوةً."],[41,41,"وَٰسِعٌ","واسعُ الفَضْلِ."]],"248":[[4,4,"ءَايَةَ","علامةَ."],[8,8,"ٱلتَّابُوتُ","الصندوقُ الذي فيه التوراةُ، وكان الأعداءُ قد انتزَعُوه."],[10,10,"سَكِينَةٌ","طمأنينةٌ تُثَبِّتُ قلوبَ المُخْلِصين."],[13,13,"وَبَقِيَّةٌ","هي الألواحُ وعَصا موسى، وغيرُ ذلك."]],"249":[[1,1,"فَصَلَ","خَرَجَ."],[7,7,"مُبۡتَلِيكُم","مُخْتَبِركُم."],[12,13,"فَلَيۡسَ مِنِّي","ليس من أهلِ ديني وطاعتي."],[15,16,"لَّمۡ يَطۡعَمۡهُ","لم يَشْرَبْه."],[21,21,"ٱغۡتَرَفَ","أخَذَ منه قليلًا."],[30,31,"جَاوَزَهُۥ هُوَ","عَبَرَ طالوتُ النهرَ مع القلَّةِ المؤمنَةِ."],[35,35,"قَالُواْ","قال الذين عَبَرُوا، وحَصَلَ معهم استضعافٌ لأنفسهم."],[36,37,"لَا طَاقَةَ","لا قُدْرَةَ."],[44,44,"يَظُنُّونَ","يَسْتيقِنون."]],"250":[[0,1,"وَلَمَّا بَرَزُواْ","ولمّا صارُوا في مُتَّسَعٍ مِنَ الأرضِ."],[2,2,"لِجَالُوتَ","قائدِ الجبابرةِ."]],"251":[[9,9,"وَٱلۡحِكۡمَةَ","النبوَّةَ."],[13,15,"وَلَوۡلَا دَفۡعُ ٱللَّهِ","بأن يَدْفَعَ صالحُهم المفسدين بأنْ يَصُدُّوهم عن محاولةِ الفَسادِ."],[19,20,"لَّفَسَدَتِ ٱلۡأَرۡضُ","لَفَسَدَ ما عليها، واختَلَّ نظامُها."]],"253":[[7,9,"مَّن كَلَّمَ ٱللَّهُ","كموسى عليه السلامُ."],[10,12,"وَرَفَعَ بَعۡضَهُمۡ دَرَجَـٰتٍ","كمحمدٍ ﷺ بعمومِ رسالتِه، وخَتْمِ النبوةِ به."],[17,17,"ٱلۡبَيِّنَـٰتِ","المُعْجِزاتِ الباهراتِ كإحياء الموتى بإذنِ الله."],[19,20,"بِرُوحِ ٱلۡقُدُسِ","جبريلَ عليه السلامُ."],[27,28,"مِنۢ بَعۡدِهِم","من بعدِ هؤلاءِ الرُّسُل."]],"254":[[3,3,"أَنفِقُواْ","بإخراجِ الزَّكاةِ المفروضةِ وغيرها من الصدقاتِ."],[11,12,"لَّا بَيۡعٌ","فيكونَ معه رِبحٌ تَفْتَدَون به أنفسَكم."],[14,15,"وَلَا خُلَّةٌ","ولا صَداقةٌ."],[17,17,"شَفَـٰعَةٌ","شفاعةُ شافعٍ مُؤَثِّرةٌ."]],"255":[[6,6,"ٱلۡقَيُّومُ","القائمُ على كلِّ شيءٍ."],[9,9,"سِنَةٌ","نُعاسٌ."],[41,41,"كُرۡسِيُّهُ","موضعُ قَدَمَي الرَّبِّ، ولا يَعْلَمُ كيفيتَه إلا اللهُ."],[44,45,"وَلَا يَـُٔودُهُۥ","ولا يُثْقِلُه."]],"256":[[0,3,"لَآ إِكۡرَاهَ فِي ٱلدِّينِ","لاتُكْرِهُوا أحدًا على الدُّخولِ في دينِ الإسلامِ."],[6,6,"ٱلرُّشۡدُ","الحقُّ أو الإيمانُ."],[8,8,"ٱلۡغَيِّ","الباطِلُ أو الكفرُ."],[11,11,"بِٱلطَّـٰغُوتِ","بكلِّ ما عُبِدَ من دونِ اللهِ."],[16,17,"بِٱلۡعُرۡوَةِ ٱلۡوُثۡقَىٰ","الطريقةِ المثلى، أو الإسلامِ."],[18,20,"لَا ٱنفِصَامَ لَهَا","لا انقطاعَ، ولا انكسارَ لها."]],"257":[[0,3,"ٱللَّهُ وَلِيُّ ٱلَّذِينَ ءَامَنُواْ","اللَّهُ يَتَوَلّاهم بتوفيقِه."],[5,6,"مِّنَ ٱلظُّلُمَـٰتِ","من ظُلُماتِ الكفرِ."],[7,8,"إِلَى ٱلنُّورِ","إلى نورِ الإيمانِ."],[11,12,"أَوۡلِيَآؤُهُمُ ٱلطَّـٰغُوتُ","أنصارُهم هم الذين يَعْبُد ونَهم من دونِ اللهِ."]],"258":[[0,1,"أَلَمۡ تَرَ","ألم يَنْتهِ عِلْمُك."],[4,4,"حَآجَّ","جادَلَ، وهومَلِكُ بابلَ نَمْرُوذُ."],[6,7,"فِي رَبِّهِۦٓ","في وجودِ ربِّه."],[8,11,"أَنۡ ءَاتَىٰهُ ٱللَّهُ ٱلۡمُلۡكَ","لأنه أعطاه الُملْكَ فتَجَبَّر."],[20,22,"أَنَا۠ أُحۡيِۦ وَأُمِيتُ","أقتلُ مَن أرَدْتُ، وأعفُو عَمَّنْ أرَدْتُ قَتْلَه."],[35,35,"فَبُهِتَ","فَتَحَيَّر، وقامَتْ عليه الحُجَّةُ."]],"259":[[1,1,"كَٱلَّذِي","عُزَيْرٌ."],[4,4,"قَرۡيَةٍ","بيت المقدس."],[6,8,"خَاوِيَةٌ عَلَىٰ عُرُوشِهَا","تَهَدَّمَتْ دُورُها، واشتدَّ خَرابُها."],[10,10,"أَنَّىٰ","كيف؟ وهو استبعادٌ لإحيائِها."],[40,41,"لَمۡ يَتَسَنَّهۡ","لم يتغَيَّرْ."],[46,46,"ءَايَةً","دَلالةً على قدرةِ اللهِ على البعثِ."],[52,52,"نُنشِزُهَا","نرفعُها، ونُرَكِّبُ بعضَها على بعضٍ."]],"260":[[4,4,"أَرِنِي","رؤيةَ العينِ."],[14,15,"لِّيَطۡمَئِنَّ قَلۡبِي","ليُؤْمِنَ قلبي."],[21,22,"فَصُرۡهُنَّ إِلَيۡكَ","فاضْمُمْهُنَّ إليك، واجمَعْهُنَّ، ثم قَطِّعْهُنَّ."],[33,33,"سَعۡيًا","مُسْرِعَةً."]],"261":[[9,11,"أَنۢبَتَتۡ سَبۡعَ سَنَابِلَ","أخْرَجَتْ ساقًا تَشَعَّبَ منه سَبْعُ شُعَبٍ، في كل شُعبةٍ سنبلةٌ."],[18,18,"يُضَـٰعِفُ","الأجْرَ."]],"262":[[9,9,"مَنًّا","التحَدُّثَ بما أعْطى، حتى يَبْلُغَ ذلك المُعْطى، فيؤذِيَه."],[13,13,"أَذًى","التطاولَ على المُعْطى."],[18,20,"وَلَا خَوۡفٌ عَلَيۡهِمۡ","فيما يَسْتقبلونه من أجْر الآخرةِ."],[21,23,"وَلَا هُمۡ يَحۡزَنُونَ","على شيءٍ فاتَهم في الدنيا."]],"263":[[0,1,"قَوۡلٌ مَّعۡرُوفٌ","رَدٌّ جميل يُرَدُّ به السّائلُ."],[2,2,"وَمَغۡفِرَةٌ","وعَفْوٌ عمّا بَدَرَ من السّائلِ مِن إلحاحٍ."]],"264":[[8,8,"كَٱلَّذِي","لا تُبْطِلُوها كما تَبْطُلُ صَدَقَةُ الذي."],[11,12,"رِئَآءَ ٱلنَّاسِ","ليراه الناسُ فَيمدَحُوه."],[20,20,"صَفۡوَانٍ","حجرٍ أملسَ."],[24,24,"وَابِلٌ","مطرٌ غزيرٌ."],[25,26,"فَتَرَكَهُۥ صَلۡدًا","أملسَ يابِسًا لا شي ءَ عليه. وكذلك شأنُ المُرائِي لاتنفَعُه نفقتُه."],[27,28,"لَّا يَقۡدِرُونَ","لا ينتفعون."]],"265":[[7,7,"وَتَثۡبِيتًا","ويقينًا راسخًا بأنّ اللهَ سيَجْزيهم."],[12,12,"بِرَبۡوَةٍ","بأرضٍ عاليةٍ."],[14,14,"وَابِلٌ","مطرٌ غزيرٌ."],[16,16,"أُكُلَهَا","ثَمَرَتَها."],[22,22,"فَطَلٌّ","فالمطرُ الضعيفُ يَكْفيها."]],"266":[[0,1,"أَيَوَدُّ أَحَدُكُمۡ","نَزَلَتِ الآيةُ في رجلٍ غنيٍّ يعملُ بطاعةِ اللهِ، ثم يعملُ بالمعاصي."],[24,24,"إِعۡصَارٌ","ريحٌ شديدةٌ فيها نارٌ مُحرقةٌ."],[28,28,"كَذَٰلِكَ","هكذا حالُ غيرِ المخلصينَ في نفقاتِهم."]],"267":[[4,7,"مِن طَيِّبَـٰتِ مَا كَسَبۡتُمۡ","من جَيِّدِه، وحَلالِه."],[13,15,"وَلَا تَيَمَّمُواْ ٱلۡخَبِيثَ","ولا تَقْصِدُوا بالإنفاقِ الرَّديءَ من المالِ."],[18,23,"وَلَسۡتُم بِـَٔاخِذِيهِ إِلَّآ أَن تُغۡمِضُواْ فِيهِ","وإنْ أُعْطِيتُموه لم تأخُذُوه إلاإذا تَغاضَيْتُم عن رَداءتِه."]],"268":[[1,2,"يَعِدُكُمُ ٱلۡفَقۡرَ","يُخَوِّفُكم، ويُغْرِيكم بالبُخْلِ."],[4,4,"بِٱلۡفَحۡشَآءِ","بالمعاصي."]],"269":[[1,1,"ٱلۡحِكۡمَةَ","الإصابةَ في القولِ والفعلِ."],[15,15,"ٱلۡأَلۡبَـٰبِ","العقولِ السليمةِ."]],"270":[[7,7,"نَّذۡرٍ","ما تُوجِبُه على نفسِك."],[12,12,"لِلظَّـٰلِمِينَ","المانعين لحقِّ اللهِ في المالِ."]],"271":[[0,2,"إِن تُبۡدُواْ ٱلصَّدَقَـٰتِ","إنْ تُظْهِروها."],[3,4,"فَنِعِمَّا هِيَ","فنِعْمَ ما تَصَدَّقْتُم به."]],"272":[[12,12,"فَلِأَنفُسِكُمۡ","يعودُ نَفْعُه عليكم."]],"273":[[2,2,"أُحۡصِرُواْ","لايَسْتطيعون السَّفرَ طَلَبًا للرِّزقِ، لانشغالهِم بالجهادِ."],[8,8,"ضَرۡبًا","سَفَرًا لطَلَبِ الرِّزْق."],[17,17,"بِسِيمَـٰهُمۡ","بعلاماتِهم، وآثارِ الحاجةِ فيهم."],[21,21,"إِلۡحَافًا","إلحاحًا إن اضْطُرُّوا للسؤالِ."]],"275":[[1,2,"يَأۡكُلُونَ ٱلرِّبَوٰاْ","يتعامَلُون به. والرِّبا: ما يُؤَدِّيه المُقْتَرِضُ زيادةً على ما اقترضَ، مشروطةً في العَقْدِ."],[3,4,"لَا يَقُومُونَ","أي: في الآخرةِ حينَ يُبْعَثُون مِن قُبورِهم."],[9,10,"يَتَخَبَّطُهُ ٱلشَّيۡطَـٰنُ","يُوقِعُه في الاضطرابِ."],[12,12,"ٱلۡمَسِّ","الجنونِ."],[30,30,"فَٱنتَهَىٰ","فارتدَعَ."],[32,33,"مَا سَلَفَ","ما مَضى قبلَ التحريمِ، فلا إثمَ عليه فيه."],[37,38,"وَمَنۡ عَادَ","أي: إلى الرِّبا."]],"276":[[0,0,"يَمۡحَقُ","يُذْهِبُ."],[3,3,"وَيُرۡبِي","يُنَمِّي، ويُضاعِفُ الأجْرَ."]],"277":[[13,15,"وَلَا خَوۡفٌ عَلَيۡهِمۡ","في الآخرةِ."],[16,18,"وَلَا هُمۡ يَحۡزَنُونَ","على ما فاتَهم في الدُّنيا."]],"278":[[5,5,"وَذَرُواْ","اترُكُوا طَلبَ."],[6,9,"مَا بَقِيَ مِنَ ٱلرِّبَوٰٓاْ","ما بَقِيَ لكم من زيادةٍ على رؤوسِ أموالِكم."]],"279":[[3,3,"فَأۡذَنُواْ","اعْلَمُوا ذلك، واستَيْقِنُوه."],[13,16,"لَا تَظۡلِمُونَ وَلَا تُظۡلَمُونَ","لا تَأْخُذُون باطلًا لا يَحِلُّ لكم، ولا تُنْقَصُون من أموالِكم."]],"280":[[2,3,"ذُو عُسۡرَةٍ","غيرُقادرٍ على السَّدادِ."],[4,6,"فَنَظِرَةٌ إِلَىٰ مَيۡسَرَةٍ","فعليكم أن تُمْهِلُوه إلى أن يُيَسِّرَ اللهُ عليه الأداءَ."],[7,8,"وَأَن تَصَدَّقُواْ","أي: على المُعْسِرِ."]],"281":[[7,11,"تُوَفَّىٰ كُلُّ نَفۡسٍ مَّا كَسَبَتۡ","تُجازى بما عَمِلَتْ."]],"282":[[4,4,"تَدَايَنتُم","تبايَعْتُمْ، وتَعاطَيْتُم بالدَّين."],[7,8,"أَجَلٍ مُّسَمًّى","وقتٍ معلومٍ."],[23,26,"وَلۡيُمۡلِلِ ٱلَّذِي عَلَيۡهِ ٱلۡحَقُّ","يُمْلي المَدينُ ما عليه من الدَّين."],[30,31,"وَلَا يَبۡخَسۡ","ولا يُنْقِصْ."],[39,39,"سَفِيهًا","مُبَذِّرًا مُتلاعِبًا."],[49,49,"وَلِيُّهُۥ","القائمُ بأَمْرِه."],[65,67,"أَن تَضِلَّ إِحۡدَىٰهُمَا","مَخافةَ أنْ تَنْسى إحداهما."],[71,76,"وَلَا يَأۡبَ ٱلشُّهَدَآءُ إِذَا مَا دُعُواْ","لا يَمْتنعون من الإجابة إذا دُعُوا لإقامةِ الشهادةِ."],[77,78,"وَلَا تَسۡـَٔمُوٓاْ","ولا تَمَلُّوا من كتابةِ الدَّيْن."],[84,85,"إِلَىٰٓ أَجَلِهِۦ","إلى وقتِه المعلومِ."],[87,87,"أَقۡسَطُ","أعدَلُ."],[90,90,"وَأَقۡوَمُ","وأصْوَبُ."],[92,94,"وَأَدۡنَىٰٓ أَلَّا تَرۡتَابُوٓاْ","وأقربُ إلى نَفْيِ الشَّكِّ."],[110,111,"وَلَا يُضَآرَ","لا يجوزُ الإضرارُبهما."],[118,118,"فُسُوقُۢ","خروجٌ عن طاعةِ اللهِ."]],"283":[[7,8,"فَرِهَـٰنٌ مَّقۡبُوضَةٌ","ادفَعُوا إلى صاحبِ الحقِّ شيئًا لضَمانِ حَقِّه."],[25,27,"فَإِنَّهُۥٓ ءَاثِمٌ قَلۡبُهُۥ","فهو ذو قَلْبٍ فاجرٍ."]],"284":[[8,8,"تُبۡدُواْ","تُظْهِروا."]],"285":[[14,15,"لَا نُفَرِّقُ","نُؤْمِنُ بجميعِ الرسُلِ."],[23,23,"غُفۡرَانَكَ","نَطْلُبُ مغفرتَك."]],"286":[[5,5,"وُسۡعَهَا","قَدْرَ ما تُطيقُ."],[6,8,"لَهَا مَا كَسَبَتۡ","أي: مَن فَعَلَ خيرًا نال أجْرَه."],[9,11,"وَعَلَيۡهَا مَا ٱكۡتَسَبَتۡ","أي: ومَن فَعَلَ شرًّا نال جَزاءَه."],[23,23,"إِصۡرًا","عَهْدًا لا نُطيقُ القيامَ به."],[33,37,"مَا لَا طَاقَةَ لَنَا بِهِۦ","ما لانَسْتطيعُه."],[43,44,"أَنتَ مَوۡلَىٰنَا","أنت وليُّنا، وناصِرُنا."]]}