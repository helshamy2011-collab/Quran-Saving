{"1":[[0,0,"يُسَبِّحُ","يُنَزِّهُ."],[11,11,"ٱلۡحَمۡدُ","الثَّناءُ الحسنُ الجميلُ."]],"3":[[4,4,"وَصَوَّرَكُمۡ","خَلَقَكُم."],[8,8,"ٱلۡمَصِيرُ","المَرْجِعُ يَومَ القِيامَةِ."]],"4":[[7,7,"تُسِرُّونَ","تُخْفُونَ."],[9,9,"تُعۡلِنُونَ","تُظْهِرُونَهُ."],[12,13,"بِذَاتِ ٱلصُّدُورِ","بما تُخْفِيهِ النَّفُوسُ."]],"5":[[7,7,"فَذَاقُواْ","حَلَّ بِهِم."],[8,8,"وَبَالَ","سُوءَ عاقِبَةِ."]],"6":[[5,5,"بِٱلۡبَيِّنَـٰتِ","الآياتِ الواضِحاتِ والمُعْجِزاتِ الظّاهراتِ."],[10,10,"وَتَوَلَّواْ","أعْرَضُوا عَنِ الحَقِّ."],[11,12,"وَّٱسۡتَغۡنَى ٱللَّهُ","عَنْ عِبادَتِهِم وإيمانِهِم."],[15,15,"حَمِيدٌ","مَحْمُودٌ في أقوالِهِ وأفعالِهِ وصِفاتِهِ."]],"7":[[5,5,"يُبۡعَثُواْ","يُخْرَجُوا مِن قُبُورِهِم."],[17,17,"يَسِيرٌ","هِيِّنٌ."]],"8":[[3,3,"وَٱلنُّورِ","واهْتَدُوا بالقرآنِ."]],"9":[[2,3,"لِيَوۡمِ ٱلۡجَمۡعِ","لِيومِ الحَشْرِ."],[6,6,"ٱلتَّغَابُنِ","الغَبْنُ والتَّفاوُتُ بَينَ الخَلْقِ."],[12,12,"يُكَفِّرۡ","يَمْحُ."],[19,19,"تَحۡتِهَا","تَحْتِ قُصُورِها وأَشْجارِها."]],"10":[[9,10,"وَبِئۡسَ ٱلۡمَصِيرُ","وساءَ المَرْجِعُ الَّذِي صارُوا إلَيهِ، وهو جَهَنَّمُ."]],"11":[[3,3,"مُّصِيبَةٍ","مَكْرُوهٍ."],[5,6,"بِإِذۡنِ ٱللَّهِ","بمشيئته."],[10,10,"يَهۡدِ","يُوَفِقْهُ اللهُ إلى مَرْضاتِهِ."]],"12":[[5,5,"تَوَلَّيۡتُمۡ","أعْرَضْتُم عَن طاعَةِ اللهِ."]],"13":[[0,4,"ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ","لا مَعْبُودَ بِحَقٍّ سِواهُ."],[7,7,"فَلۡيَتَوَكَّلِ","فَلْيَعْتَمِدوا في كُلِّ الأُمُورِ."]],"14":[[7,8,"عَدُوًّا لَّكُمۡ","أي: يَمْنَعُونَكُم مِنَ الإسْلامِ أو الهِجْرَةِ أو يكُونونَ سَبَبًا لِلْمَعاصِي."],[10,11,"وَإِن تَعۡفُواْ","تَتَجاوَزُوا عَن سَيِّئاتِهِم."],[12,12,"وَتَغۡفِرُواْ","وتَسْتُرُوها عَلَيهِم."]],"15":[[3,3,"فِتۡنَةٌ","اخِتبارٌ لَكُم وشُغْلٌ عَنِ الآخِرَةِ."],[6,6,"أَجۡرٌ","ثَوابٌ."]],"16":[[2,3,"مَا ٱسۡتَطَعۡتُمۡ","أطَقْتُم."],[7,7,"خَيۡرًا","يَكُنْ خَيرًا."],[9,12,"وَمَن يُوقَ شُحَّ نَفۡسِهِۦ","ومَن سَلِمَ مِنَ البُخْلِ والحِرْصِ."],[15,15,"ٱلۡمُفۡلِحُونَ","الظّافِرُونَ بِكُلِّ خَيرٍ."]],"17":[[1,2,"تُقۡرِضُواْ ٱللَّهَ","تُنْفِقُوا أمْوالَكُم في سَبِيلِ اللهِ بِإخْلاصٍ وطِيبِ نَفْسٍ."],[10,10,"شَكُورٌ","مُجازٍ على الطّاعةِ."],[11,11,"حَلِيمٌ","لا يَعْجَلُ بالعُقُوبَةِ عَلى مَن عَصاهُ."]],"18":[[1,1,"ٱلۡغَيۡبِ","ما غابَ."],[2,2,"ٱلشَّهَـٰدَةِ","ما لم يَغِبْ عَنِ الأَبْصارِ."]]}