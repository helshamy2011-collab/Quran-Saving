{"1":[[3,4,"لَا تُقَدِّمُواْ","لا تَقْطَعُوا أمرًْا دُونَ اللهِ ورَسُولِهِ."]],"2":[[16,17,"أَن تَحۡبَطَ","خَشْيَة أن تَبْطُلَ."],[20,21,"لَا تَشۡعُرُونَ","لا تُحِسُّونَ."]],"3":[[2,2,"يَغُضُّونَ","يَخْفِضُونَ."],[9,9,"ٱمۡتَحَنَ","اخْتَبَرَ."]],"4":[[5,5,"ٱلۡحُجُرَٰتِ","غُرَفِ النَّبِيِّ ﷺ."]],"6":[[5,5,"فَاسِقُۢ","خارِجٌ عَن طاعَة اللهِ ورَسُولِهِ بارْتِكابِ الكبائِرِ."],[6,6,"بِنَبَإٍ","بأيِّ خَبَرٍ."],[7,7,"فَتَبَيَّنُوٓاْ","فَتَبَيَّنُوا الحقَّ مِن غَيرِ جِهَةِ الفاسِقِ."],[8,9,"أَن تُصِيبُواْ","خَشْيةَ أن تُصِيبُوا بضُرٍّ."],[11,11,"بِجَهَـٰلَةٍ","مُتَلَبّسِينَ بِعَدَمِ العِلمِ."],[12,12,"فَتُصۡبِحُواْ","فتَصِيرُوا."]],"7":[[11,11,"لَعَنِتُّمۡ","لَوَقَعْتُم في مَشَقَّةٍ وضَرَرٍ وإثْمٍ."],[27,27,"ٱلرَّٰشِدُونَ","المُسْتَقِيمُونَ عَلى طَرِيقِ الحقِّ."]],"9":[[8,8,"بَغَتۡ","اعْتَدَتْ، ولم تَقْبَلِ الصُّلْحَ."],[16,16,"تَفِيٓءَ","تَرْجِعَ."],[25,25,"وَأَقۡسِطُوٓاْ","واعْدِلُوا."],[29,29,"ٱلۡمُقۡسِطِينَ","العادِلِينَ."]],"11":[[4,4,"يَسۡخَرۡ","يَهْزَأْ."],[22,24,"وَلَا تَلۡمِزُوٓاْ أَنفُسَكُمۡ","ولا يِعِبْ بَّعْضُكُم بَعْضا."],[25,26,"وَلَا تَنَابَزُواْ","ولا يَدْعُ بعضُكُم بَعْضًا."],[27,27,"بِٱلۡأَلۡقَـٰبِ","بِما يَكْرَهُ مِنَ الألقابِ."],[29,29,"ٱلِٱسۡمُ","الذِّكْرُ والتَّسمِيَةُ."],[30,30,"ٱلۡفُسُوقُ","ما ذُكِرَ مِنَ السُّخْرِيَةِ واللَّمْزِ والتنابُزِ بالألقابِ."]],"12":[[11,12,"وَلَا تَجَسَّسُواْ","ولا تُفَتِّشُوا عَنْ عَوْراتِ المُسْلِمِينَ، وتَبْحَثُوا عَنْ أخْبارِهِم."],[13,16,"وَلَا يَغۡتَب بَّعۡضُكُم بَعۡضًا","ولا يَذْكُرْ بَعْضُكُم بَعْضًا بِما يَكْرَهُ في غَيبَتِهِ."]],"13":[[8,8,"شُعُوبًا","نَسَبًا بِعِيدًا، وهي أكْثَرُ مِنَ القبائِل."],[9,9,"وَقَبَآئِلَ","نَسَبًا قَرِيبا، وهي تَدْخُل تَحْتَ الشُّعوبِ."],[10,10,"لِتَعَارَفُوٓاْ","لِيَعْرِفَ بَعْضُكُم بَعْضًا."],[12,12,"أَكۡرَمَكُمۡ","أشْرَفَكُم."]],"14":[[1,1,"ٱلۡأَعۡرَابُ","هُمْ في الأَصْلِ سُكّانُ البادِيةِ مِنَ العَرَبِ، والمرادُ هُنا أعْرابُ بَنِي أسَدِ بن خُزَيْمَةَ."],[18,19,"لَا يَلِتۡكُم","لا يَنْقُصْكُمُ."]],"15":[[7,8,"لَمۡ يَرۡتَابُواْ","لَمْ يَشُكُّوا."]],"16":[[1,3,"أَتُعَلِّمُونَ ٱللَّهَ بِدِينِكُمۡ","أتُخْبِرُونَهُ بِطاعَتِكُم؟"]],"17":[[5,6,"لَّا تَمُنُّواْ","لا تَذْكُرُوا إنْعامَكُم."]]}