{"1":[[0,0,"حمٓ","سَبَقَ الكلامُ عَلى الحُرُوفِ المقَطَّعةِ أوَّلَ سُورَةِ البقرةِ."]],"2":[[1,1,"ٱلۡمُبِينِ","الواضِحِ لَفْظًا ومَعْنىً."]],"3":[[4,4,"مُّبَـٰرَكَةٍ","كَثِيرَةِ الخَيراتِ، وهي لَيلةُ القَدْرِ."]],"4":[[1,1,"يُفۡرَقُ","يُقضى ويُفَصَّلُ مِنَ اللوحِ المحْفُوظِ إلى الكَتَبةِ مِنَ الملائِكَةِ."],[4,4,"حَكِيمٍ","مُحْكَمٍ."]],"10":[[0,0,"فَٱرۡتَقِبۡ","فانْتَظِرْ."],[4,4,"بِدُخَانٍ","ظُلْمَةٍ كَهَيئَةِ الدُّخانِ بِسَبِبِ الجَدْبِ."],[5,5,"مُّبِينٍ","واضِحٍ."]],"11":[[0,0,"يَغۡشَى","يَعُمُّ."]],"13":[[0,0,"أَنَّىٰ","كَيفَ."],[2,2,"ٱلذِّكۡرَىٰ","التَّذَكُّرُ والاتِّعاظُ."]],"14":[[1,2,"تَوَلَّوۡاْ عَنۡهُ","أعْرَضُوا عَنْه."],[4,4,"مُعَلَّمٌ","عَلَّمَه بَشَرٌ أو الكَهَنَةُ أو الشَّياطِينُ."]],"16":[[1,1,"نَبۡطِشُ","نُعَذِّبُ، والبَطْشُ أخْذٌ بِشِدَّةٍ."]],"17":[[1,1,"فَتَنَّا","ابْتَلينا واخْتَبَرْنا."]],"18":[[1,1,"أَدُّوٓاْ","سَلِّمُوا وأرْسِلُوا مَعِي."],[3,4,"عِبَادَ ٱللَّهِ","بَنِي إسْرائِيلَ."]],"19":[[0,4,"وَأَن لَّا تَعۡلُواْ عَلَى ٱللَّهِ","لا تَتَكَبَّرُوا على اللهِ بِتَكْذِيبِ رُسُلِه."],[7,7,"بِسُلۡطَـٰنٍ","بِبُرْهانٍ."]],"20":[[1,2,"عُذۡتُ بِرَبِّي","استَجَرْتُ بِاللهِ."],[5,5,"تَرۡجُمُونِ","تَقْتُلُوني رَجْمًا بالحِجارَةِ."]],"21":[[4,4,"فَٱعۡتَزِلُونِ","كُفُّوا عَنْ أذايَ."]],"22":[[5,5,"مُّجۡرِمُونَ","مُشْرِكُونَ بِاللهِ كافِرُونَ."]],"23":[[0,0,"فَأَسۡرِ","اجْعَلْهُم يَسِيُرونَ لَيلًا."]],"24":[[2,2,"رَهۡوًا","ساكِنًا مُسْتَقِرًّا عَلى حالِه مُنْفَرِجًا."]],"26":[[1,2,"وَمَقَامٍ كَرِيمٍ","ومَنازِلَ جَمِيلَةٍ."]],"27":[[0,0,"وَنَعۡمَةٍ","عَيْشٍ لَيِّنٍ رَغْدٍ."],[3,3,"فَـٰكِهِينَ","مُتَنَعِّمِينَ، مُتْرَفِينَ."]],"28":[[0,0,"كَذَٰلِكَ","مِثْلَ ذَلِكَ العِقابِ يُعاقِبُ اللهُ مَن كَذَّبَ، وبَدّلَ نِعْمةَ اللهِ كُفْرًا."],[1,1,"وَأَوۡرَثۡنَـٰهَا","ومَلَّكْناها."]],"29":[[7,7,"مُنظَرِينَ","مُؤَخَّرِينَ عَنِ العُقُوبَةِ."]],"30":[[6,6,"ٱلۡمُهِينِ","المُذِلِّ."]],"31":[[4,4,"عَالِيًا","جَبّارًا."],[5,6,"مِّنَ ٱلۡمُسۡرِفِينَ","مُتَجاوِزًا للحَدِّ في العُلوِّ والتَّكَبُّرِ عَلى عبادِ اللهِ."]],"32":[[5,5,"ٱلۡعَـٰلَمِينَ","عالَمِي زَمانِهِم."]],"33":[[2,2,"ٱلۡـَٔايَـٰتِ","الُمعْجِزاتِ."],[5,5,"بَلَـٰٓؤٌاْ","اخْتِبارٌ بالرَّخاءِ والشِّدَةِ."]],"35":[[7,7,"بِمُنشَرِينَ","بِمَبْعُوثِينَ."]],"37":[[4,4,"تُبَّعٍ","أحَدِ مُلُوكِ اليمنِ الحِمْيَرِيِّينَ مِمَّن جَمَعَ مُلْكَ مَناطِقِ اليمنِ كُلِّها."]],"40":[[1,2,"يَوۡمَ ٱلۡفَصۡلِ","يومَ القَضاءِ بَينَ الخَلْقِ."],[3,3,"مِيقَـٰتُهُمۡ","مَوعِدُ جزائِهِم"]],"41":[[2,2,"يُغۡنِي","يَدْفَعُ."],[3,3,"مَّوۡلًى","صاحِبٌ."]],"43":[[1,2,"شَجَرَتَ ٱلزَّقُّومِ","شَجَرةً كَرِيهةَ الرّائِحَةِ صَغِيرةَ الوَرَقِ مَسْمُومةً خَلَقَها اللهُ في جَهَنَّمَ."]],"44":[[1,1,"ٱلۡأَثِيمِ","الكَثِيرِ الآثامِ، والمرادُ بِه المشْرِكُ."]],"45":[[0,0,"كَٱلۡمُهۡلِ","كالمَعْدَنِ المُذابِ."]],"46":[[1,1,"ٱلۡحَمِيمِ","الماءِ الَّذِي بَلَغَ الغايَةَ فِي الحرارةِ."]],"47":[[1,1,"فَٱعۡتِلُوهُ","ادْفَعُوهُ وقُودُوهُ بِعُنْفٍ."],[3,3,"سَوَآءِ","وسَطِ."]],"48":[[1,1,"صُبُّواْ","أفْرِغُوا."]],"49":[[0,0,"ذُقۡ","قُولُوا لَهُ عَلى وجْهِ الإهانَةِ: أحْسِسْ."],[2,4,"أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ","أي: الذَّلِيلُ المُهانُ، عُكِسَ المَدْلُولُ للتَّهَكُّمِ بِهِ."]],"50":[[5,5,"تَمۡتَرُونَ","تَشُكُّونَ."]],"51":[[3,3,"مَقَامٍ","مَسْكَنٍ."],[4,4,"أَمِينٍ","آمِنٍ صاحِبُه مِنَ الآفاتِ."]],"53":[[2,2,"سُندُسٍ","الرقِيقِ مِنَ الحرِيرِ الخالِصِ."],[3,3,"وَإِسۡتَبۡرَقٍ","الغليظِ مِنَ الحريرِ الخالصِ."],[4,4,"مُّتَقَـٰبِلِينَ","أي: في مَجالِسِهِم ومُحادَثاتِهِم."]],"54":[[1,1,"وَزَوَّجۡنَـٰهُم","قَرنّاهُم."],[2,2,"بِحُورٍ","جَمْعُ حَوْراءَ وهي البيضاءُ."],[3,3,"عِينٍ","واسِعاتِ الأَعْيُنِ."]],"55":[[0,0,"يَدۡعُونَ","يَطْلُبُونَ."]],"56":[[5,6,"ٱلۡمَوۡتَةَ ٱلۡأُولَىٰ","الَّتِي سَلَفَتْ لَهُم في الُّدنيا."]],"58":[[1,1,"يَسَّرۡنَـٰهُ","سَهَّلْنا لَفْظَ القرآنِ ومَعْناهُ."]],"59":[[0,0,"فَٱرۡتَقِبۡ","فانْتَظِر ما وعَدْتُكَ."],[2,2,"مُّرۡتَقِبُونَ","مُنْتَظِرُونَ موتَكَ وقَهْرَكَ."]]}