{"1":[[0,0,"وَٱلذَّٰرِيَـٰتِ","الرِّياحِ المُثِيراتِ للتُّرابِ."]],"2":[[0,0,"فَٱلۡحَـٰمِلَـٰتِ","فالسُّحُبِ الحامِلاتِ."],[1,1,"وِقۡرًا","ثِقَلًا عَظِيمًا مِنَ الماءِ."]],"3":[[0,0,"فَٱلۡجَـٰرِيَـٰتِ","فالسُّفُنِ الجارِياتِ في البِحارِ."],[1,1,"يُسۡرًا","جَرْيًا ذا يُسْرٍ وسُهُولةٍ."]],"4":[[0,0,"فَٱلۡمُقَسِّمَـٰتِ","فالملائِكةِ المُقَسِّماتِ."],[1,1,"أَمۡرًا","أمْرَ اللهِ في خَلْقِهِ."]],"5":[[2,2,"لَصَادِقٌ","لَكائِنٌ حقٌّ يَقِينٌ."]],"6":[[1,1,"ٱلدِّينَ","الحِسابَ."],[2,2,"لَوَٰقِعٌ","لَكائِنٌ لا مَحالةَ."]],"7":[[1,2,"ذَاتِ ٱلۡحُبُكِ","ذاتِ الخَلْقِ الحَسَنِ."]],"8":[[3,3,"مُّخۡتَلِفٍ","مُضْطَرِبٍ."]],"9":[[0,0,"يُؤۡفَكُ","يُصْرَفُ."]],"10":[[0,0,"قُتِلَ","لُعِنَ."],[1,1,"ٱلۡخَرَّٰصُونَ","الكَذّابُونَ الظّانُّونَ غيرَ الحقِّ."]],"11":[[3,3,"غَمۡرَةٍ","لُجَّةِ مِنَ الكُفْرِ."],[4,4,"سَاهُونَ","غافِلُونَ."]],"12":[[1,1,"أَيَّانَ","مَتى."],[2,3,"يَوۡمُ ٱلدِّينِ","يومُ الجَزاءِ."]],"13":[[4,4,"يُفۡتَنُونَ","يُعَذَّبُونَ بالإحْرِاقِ بالنّارِ."]],"14":[[1,1,"فِتۡنَتَكُمۡ","عَذابَكُم."]],"16":[[0,0,"ءَاخِذِينَ","قابِلينَ على وجْهِ الرِّضا."],[2,2,"ءَاتَىٰهُمۡ","أعْطاهُم."],[8,8,"مُحۡسِنِينَ","فاعِلِينَ الحَسَناتِ والطّاعاتِ."]],"17":[[5,5,"يَهۡجَعُونَ","يَنامُونَ."]],"18":[[0,0,"وَبِٱلۡأَسۡحَارِ","جَمْعُ سَحَر، وهُو آخِرُ الليلِ."]],"19":[[2,2,"حَقٌّ","واجِبٌ ثابِتٌ."],[3,3,"لِّلسَّآئِلِ","الَّذِي يُظْهِرُ فَقْرَهُ فَيسْأَلُ النّاسَ."],[4,4,"وَٱلۡمَحۡرُومِ","الفَقِيرِ الُمتَعَفِّفِ."]],"20":[[3,3,"لِّلۡمُوقِنِينَ","لِأَهْلِ اليقِينِ بِأنّ اللهَ ورَسُولَه حَقٌّ."]],"21":[[0,1,"وَفِيٓ أَنفُسِكُمۡ","وفي خَلْقِ أنْفُسِكُم دَلائِلُ وعِبَرٌ."]],"22":[[2,2,"رِزۡقُكُمۡ","مادَّةُ رِزْقِكُم مِنَ الأمْطارِ وما قَدَّرَهُ اللهُ."],[3,4,"وَمَا تُوعَدُونَ","مِنَ الجَزاءِ في الدُّنيا والآخِرةِ."]],"23":[[5,8,"مِّثۡلَ مَآ أَنَّكُمۡ تَنطِقُونَ","فَتَحَقَّقَ الوعِيدُ مِثْلَ نُطْقِكُم الَّذِي لا تَشُكُّونَ فِيهِ."]],"24":[[3,4,"ضَيۡفِ إِبۡرَٰهِيمَ","هُم مِن الملائِكةِ."]],"25":[[4,4,"سَلَـٰمًا","سَلَّمنا سَلاما."],[6,6,"سَلَـٰمٌ","أمْرِي سَلامٌ لَكُم."],[8,8,"مُّنكَرُونَ","لا أعْرِفُهُم."]],"26":[[0,0,"فَرَاغَ","فَمال خِفْيَةً."]],"28":[[0,0,"فَأَوۡجَسَ","أحَسَّ في نَفْسِهِ."],[7,8,"بِغُلَـٰمٍ عَلِيمٍ","هو إسْحاقُ عَلَيهِ السَّلامُ."]],"29":[[3,3,"صَرَّةٍ","صَيْحَةٍ."],[4,4,"فَصَكَّتۡ","فَلَطَمَتْ."],[8,8,"عَقِيمٌ","لا تَحْمِلُ."]],"31":[[1,2,"فَمَا خَطۡبُكُمۡ","فَما شَأنُكُم؟"]],"32":[[4,5,"قَوۡمٍ مُّجۡرِمِينَ","هُم قَومُ لُوطٍ عَلَيهِ السَّلامُ."]],"34":[[0,0,"مُّسَوَّمَةً","عَلَيها عَلامةٌ، وكَلُّ حَجَرٍ عَلَيهِ اسْمُ صاحِبِهِ."],[3,3,"لِلۡمُسۡرِفِينَ","للمُفَرِّطِينَ بِكُفْرِهِم وشِيُوعِ الفاحِشَةِ فِيهِم."]],"36":[[4,4,"بَيۡتٍ","بيتِ لُوطٍ عَلَيهِ السَّلامُ."]],"37":[[0,0,"تَرَكۡنَا","أبْقينا."],[2,2,"ءَايَةً","أثَرًا مِن العَذابِ والخَرابِ يُتَّعظُ بِها."]],"38":[[6,6,"بِسُلۡطَـٰنٍ","بِحُجَّةٍ."]],"39":[[0,0,"فَتَوَلَّىٰ","فَأَعْرَضَ."],[1,1,"بِرُكۡنِهِۦ","بِقُوَّتِهِ وجانِبِهِ."]],"40":[[0,0,"فَأَخَذۡنَـٰهُ","فَأَهْلَكْناهُ."],[2,2,"فَنَبَذۡنَـٰهُمۡ","فَطَرحْناهُم."],[4,4,"ٱلۡيَمِّ","البَحْرِ."],[6,6,"مُلِيمٌ","مُسْتَوْجِبٌ العِقابَ، آتٍ بِما يَلُومُهُ اللهُ عَلَيهِ."]],"41":[[6,6,"ٱلۡعَقِيمَ","التي لا بَرَكَةَ فِيها ولا تَأْتِي بِخَيرٍ."]],"42":[[0,1,"مَا تَذَرُ","ما تَدَعُ."],[8,8,"كَٱلرَّمِيمِ","العَظْمِ الَّذِي بَلِي فَتَفَتَّتَ."]],"43":[[5,5,"تَمَتَّعُواْ","مُباحٌ لكُم أن تَتَمَتَّعُوا بِنِعَمِ الدُّنيا الزّائِلةِ."],[6,7,"حَتَّىٰ حِينٍ","إلى آجالِكُم."]],"44":[[0,0,"فَعَتَوۡاْ","تَكَبَّرُوا فَأَعْرَضُوا."],[4,4,"فَأَخَذَتۡهُمُ","فَأَصابَتْهُم."],[5,5,"ٱلصَّـٰعِقَةُ","الصَّيحَةُ العَظِيمَةُ الُمهْلِكَةُ."],[7,7,"يَنظُرُونَ","إلى عُقُوبَتِهِم بأَعْيُنِهِم فَيَكُونُ أشَدَّ للعُقُوبَةِ."]],"45":[[3,3,"قِيَامٍ","نُهُوضٍ ودِفاعٍ."]],"47":[[1,1,"بَنَيۡنَـٰهَا","خَلَقْناها وجَعَلْناها سَقْفًا لِلأَرْضِ."],[2,2,"بِأَيۡيْدٍ","بِقُوِّةٍ."],[4,4,"لَمُوسِعُونَ","لَمُقْتَدِرُونَ، مِن أوْسَعَ إذا كانَ ذا وُسْعٍ وهي القُدْرَةُ."]],"48":[[1,1,"فَرَشۡنَـٰهَا","جَعَلْناها فِراشًا لاسْتِقْرارِ الخَلْقِ عَلَيها."],[3,3,"ٱلۡمَـٰهِدُونَ","المُوطِّئُونَ الَمُهَيِّئُونَ."]],"49":[[4,4,"زَوۡجَيۡنِ","صِنْفَينِ ذَكَرًا وأُنْثى."]],"50":[[0,0,"فَفِرُّوٓاْ","فارِقُوا الشِّرْكَ المُسَبِّبَ لِعَذابِكُم."]],"53":[[0,0,"أَتَوَاصَوۡاْ","هَلْ أوصْىَ بَعْضُهُم بَعْضًا؟"],[5,5,"طَاغُونَ","مُتَعَدُّونَ، طُغاةٌ عَنْ أمْرِ رَبِّهِم."]],"54":[[0,1,"فَتَوَلَّ عَنۡهُمۡ","فأَعْرِضْ عَنْهُم."],[2,4,"فَمَآ أَنتَ بِمَلُومٍ","فَلَيسَ عَلَيكَ لَوْمٌ في ذَنْبِهِم."]],"55":[[2,2,"ٱلذِّكۡرَىٰ","التَّذْكِيرَ والمَوعِظَةَ."]],"56":[[5,5,"لِيَعۡبُدُونِ","إرادَةَ أن يَعْبُدُونِي إرادَةً شَرْعِيَّةً دِينِيَّةً، وقَدْ تَقَعُ العِبادة وقَدْ لا تَقَعُ."]],"58":[[6,6,"ٱلۡمَتِينُ","الشَّدِيدُ الكامِلُ في قُوَّتِهِ."]],"59":[[3,3,"ذَنُوبًا","حَظًّا ونَصِيبًا."]],"60":[[0,0,"فَوَيۡلٌ","عَذابٌ وهَلاكٌ."]]}