{"1":[[0,1,"سَأَلَ سَآئِلُۢ","دَعا داعٍ مِنَ المُشْرِكِينَ على نَفْسِهِ وقَوْمِهِ."],[2,2,"بِعَذَابٍ","بِنُزُولِ العَذابِ عَلَيهِم."],[3,3,"وَاقِعٍ","مُتَحَقِّقِ الوُقُوعِ."]],"2":[[3,3,"دَافِعٌ","مانِعٌ يَمْنَعُهُ مِنَ اللهِ عَزَّ وجَلَّ."]],"3":[[2,3,"ذِي ٱلۡمَعَارِجِ","صاحِبِ العُلُوِّ والفَواضِلِ."]],"4":[[0,0,"تَعۡرُجُ","تَصْعَدُ."],[2,2,"وَٱلرُّوحُ","جِبْرِيلُ."],[8,10,"خَمۡسِينَ أَلۡفَ سَنَةٍ","أي مِن سَنَواتِ الدُّنيا عَلى الكافِرِ."]],"6":[[1,2,"يَرَوۡنَهُۥ بَعِيدًا","يَرَونَ وقُوعَ العذابِ مُسْتَحِيلًا."]],"8":[[3,3,"كَٱلۡمُهۡلِ","ما أُذِيب مِنَ النُّحاسِ وغَيرِهِ."]],"9":[[2,2,"كَٱلۡعِهۡنِ","كالصُّوفِ."]],"10":[[0,3,"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمًا","ولا يَتَفَرَّغُ قَرِيبٌ للسُّؤالِ عَنْ حالِ قَرِيبِهِ مِنَ الهَولِ والشُّغْلِ بِحالِ نَفْسِهِ."]],"11":[[0,0,"يُبَصَّرُونَهُمۡ","يَرَونَهُم ويَعْرِفُونَهُم، ولا يَسْتَطِيعُ أحَدٌ أن يَنفَعَ أحَدًا."],[1,1,"يَوَدُّ","يَتَمَنّى."],[3,4,"لَوۡ يَفۡتَدِي","لو يُخَلِّصُ نَفْسَهُ بِفِدْيَةٍ."]],"13":[[0,0,"وَفَصِيلَتِهِ","وعَشِيَرتِهِ."],[2,2,"تُـٔۡوِيهِ","تَضُمُّهُ، ويَنْتَمِي إلَيها في القَرابَةِ."]],"14":[[5,5,"يُنجِيهِ","يُنجِيهِ الافْتِداءُ مِنَ العَذابِ."]],"15":[[0,0,"كَلَّآ","لا افْتِداءَ ولا إنْجاءَ."]],"19":[[3,3,"هَلُوعًا","شَدِيدَ الجَزَعِ والحِرْصِ."]],"21":[[2,2,"ٱلۡخَيۡرُ","ما يَنفَعُ الإنْسانَ."],[3,3,"مَنُوعًا","كَثِيرَ المنْعِ للخيرِ."]],"23":[[4,4,"دَآئِمُونَ","مُواظِبُونَ على أدائِها."]],"24":[[3,4,"حَقٌّ مَّعۡلُومٌ","نَصِيبٌ مُعَيَّنٌ لِذَوِي الحاجاتِ."]],"25":[[1,1,"وَٱلۡمَحۡرُومِ","الَّذِي يَتَعَفَّفُ عَن سُؤالِ النّاسِ مَعَ حاجَتِهِ فَلا يَتَفَطَّن لَهُ كَثِيرٌ مِنَ النّاسِ."]],"26":[[2,3,"بِيَوۡمِ ٱلدِّينِ","بيومِ الجَزاءِ."]],"27":[[5,5,"مُّشۡفِقُونَ","خائِفُونَ."]],"28":[[3,4,"غَيۡرُ مَأۡمُونٍ","لا يَأمَنُه أحَدٌ مِمَّنْ عَقَلَ عَنِ اللهِ أمْرَهُ إلا بِأَمانٍ مِنَ اللهِ تَبارَكَ وتَعالى."]],"29":[[2,3,"لِفُرُوجِهِمۡ حَـٰفِظُونَ","يَحْفظُونَ أنْفُسَهُم مِنَ الحَرامِ."]],"30":[[3,6,"أَوۡ مَا مَلَكَتۡ أَيۡمَـٰنُهُمۡ","النِّساءِ الإماءِ."],[8,9,"غَيۡرُ مَلُومِينَ","غَيرُ مؤاخَذِينَ."]],"31":[[2,3,"وَرَآءَ ذَٰلِكَ","غَيرَ الزَّوجاتِ والمملُوكاتِ."],[6,6,"ٱلۡعَادُونَ","المُفْسِدُونَ."]],"32":[[2,2,"لِأَمَـٰنَـٰتِهِمۡ","لأماناتِ اللهِ وأماناتِ النّاسِ الَّتِي اؤْتُمِنُوا عَلَيها."],[3,3,"وَعَهۡدِهِمۡ","عُهُودِهِم مَعَ اللهِ ومَعَ العِبادِ."],[4,4,"رَٰعُونَ","حافِظُونَ."]],"33":[[2,2,"بِشَهَـٰدَٰتِهِمۡ","بِما عِنْدَهُم مِنَ الدَّلالةِ عَلى حَقِّ لِغَيرِهِم."],[3,3,"قَآئِمُونَ","يَهْتَمُّونَ بِها ويَحْفَظُونَها إلى أن تُؤَدّى."]],"34":[[4,4,"يُحَافِظُونَ","يعتَنُونَ باسْتِكْمالِ أرْكانِها وشُرُوطِها وأَوْقاتِها."]],"35":[[3,3,"مُّكۡرَمُونَ","يُكْرَمُونَ بِحُسْنِ اللقاءِ والثَّناءِ وأَنْواعِ اللذّاتِ والمَسارِّ."]],"36":[[0,2,"فَمَالِ ٱلَّذِينَ كَفَرُواْ","فأيُّ شَيءٍ ثَبَتَ لَهُم؟"],[3,3,"قِبَلَكَ","في حالِ كَونِهِم عنِدَك."],[4,4,"مُهۡطِعِينَ","مُسْرِعِينَ، وقَدْ مَدُّوا أعْناقَهُم إليكَ مُقْبِلِينَ عَلَيكَ."]],"37":[[4,4,"عِزِينَ","مُتَفَرِّقِينَ."]],"39":[[3,4,"مِّمَّا يَعۡلَمُونَ","مِن مّاءٍ مَهِينٍ كَغَيرِهِم."]],"40":[[3,3,"ٱلۡمَشَـٰرِقِ","مَشارِقِ الشَّمْسِ والكَواكِبِ."],[4,4,"وَٱلۡمَغَـٰرِبِ","مَغارِبِ الشَّمْسِ والكَواكِبِ."]],"41":[[5,7,"وَمَا نَحۡنُ بِمَسۡبُوقِينَ","وما أحَدٌ يَفُوتُنا ويُعْجِزُنا."]],"42":[[0,0,"فَذَرۡهُمۡ","فاتْرُكْهُم."],[1,1,"يَخُوضُواْ","يَتَكلَّمُوا في باطِلِهِم عَلى غَيرِ هُدىً."],[2,2,"وَيَلۡعَبُواْ","في دُنْياهُم."]],"43":[[3,3,"ٱلۡأَجۡدَاثِ","القُبُورِ."],[4,4,"سِرَاعًا","مُسْرِعِينَ."],[7,7,"نُصُبٍ","أصْنامٍ."],[8,8,"يُوفِضُونَ","يُهَرْوِلُونَ، ويُسْرِعُونَ أيُّهُم يَسْتَلِمُه أوَّلُ؟"]],"44":[[0,0,"خَـٰشِعَةً","ذَلِيلةً مُنْكَسِرَةً."],[2,2,"تَرۡهَقُهُمۡ","تَغْشاهُم."],[3,3,"ذِلَّةٌ","حَقارَةٌ ومَهانَةٌ."]]}