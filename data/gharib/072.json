{"1":[[4,4,"ٱسۡتَمَعَ","لِتِلاوَتِي لِلْقُرآنِ."],[5,5,"نَفَرٌ","جَماعَةٌ."],[12,12,"عَجَبًا","بَدِيعًا في بَلاغَتِهِ وأَحْكامِهِ."]],"2":[[0,2,"يَهۡدِيٓ إِلَى ٱلرُّشۡدِ","يَدْعُو إلى الحقِّ."]],"3":[[1,1,"تَعَـٰلَىٰ","عَلَتْ وارْتَفَعَتْ."],[2,3,"جَدُّ رَبِّنَا","عَظَمَةُ رَبِّنا وجَلالُهُ."],[6,6,"صَـٰحِبَةً","زَوْجةً."]],"4":[[3,3,"سَفِيهُنَا","إبْلِيسُ."],[6,6,"شَطَطًا","قَوْلًا بعِيدًا عَنِ الحقِّ والصَّوابِ."]],"6":[[5,5,"يَعُوذُونَ","يَسْتَجِيرُونَ ويَلُوذُونَ."],[9,9,"فَزَادُوهُمۡ","فَزادَ رِجالُ الجِنِّ الإنسَ باسْتِعاذَتِهم بِهِم."],[10,10,"رَهَقًا","خَوْفًا."]],"7":[[0,0,"وَأَنَّهُمۡ","وأَنَّ كُفارَ الإنْسِ."],[1,3,"ظَنُّواْ كَمَا ظَنَنتُمۡ","حَسِبُوا كما حَسِبْتُم -يا مَعْشرَ الِجنِّ-."],[4,8,"أَن لَّن يَبۡعَثَ ٱللَّهُ أَحَدًا","بَعْدَ الموتِ."]],"8":[[1,2,"لَمَسۡنَا ٱلسَّمَآءَ","طَلَبْنا بُلُوغَ السَّماءِ لاسْتِماعِ كَلامِ أهْلِها."],[5,6,"حَرَسًا شَدِيدًا","مَلائِكةً تَحْرُسُها."],[7,7,"وَشُهُبًا","جَمْعُ شِهابٍ، وهي النُّجُومُ الَّتِي كانتْ تُرْجَمُ بِها الشَّياطِينُ."]],"9":[[2,4,"نَقۡعُدُ مِنۡهَا مَقَـٰعِدَ","نَتَّخِذُ مِنَ السَّماءِ مَواضِعَ."],[5,5,"لِلسَّمۡعِ","لِنَسْتَمِعَ إلى أخْبارِها."],[6,8,"فَمَن يَسۡتَمِعِ ٱلۡـَٔانَ","فَمَن يُحاوِلِ الآنَ اسْتِراقَ السَّمْعِ."],[11,11,"شِهَابًا","شِهابًا بالمِرْصادِ، يُحْرِقُه ويُهْلِكُهُ."]],"10":[[12,12,"رَشَدًا","خَيرًا وهُدىً."]],"11":[[3,5,"وَمِنَّا دُونَ ذَٰلِكَ","ومِنّا قَومٌ دُونَ ذَلِكَ كُفّارٌ وفُسّاقٌ."],[7,7,"طَرَآئِقَ","فِرَقًا ومَذاهِبَ."],[8,8,"قِدَدًا","مخْتَلِفَةً."]],"12":[[1,1,"ظَنَنَّآ","أيْقَنّا."],[2,7,"أَن لَّن نُّعۡجِزَ ٱللَّهَ فِي ٱلۡأَرۡضِ","أن لَن نَفُوتَ اللهَ إذا أرادَ بِنا أمْرًا فِي الأَرْضِ."],[8,10,"وَلَن نُّعۡجِزَهُۥ هَرَبًا","ولَن نسْتَطِيعَ أن نُفْلِتَ مِن عِقابِهِ هَرَبًا."]],"13":[[3,3,"ٱلۡهُدَىٰٓ","القُرآنَ."],[11,11,"بَخۡسًا","نُقْصانًا مِن حَسَناتِه."],[13,13,"رَهَقًا","ظُلمًا يَلْحَقُهُ بِزِيادةٍ في سَيِّئاتِهِ."]],"14":[[2,2,"ٱلۡمُسۡلِمُونَ","الخاضِعُونَ للهِ بالطّاعةِ."],[4,4,"ٱلۡقَـٰسِطُونَ","الجائِرُونَ العُصاةُ."],[6,6,"أَسۡلَمَ","وخَضَعَ للهِ بالطّاعةِ."],[8,8,"تَحَرَّوۡاْ","قَصَدُوا."],[9,9,"رَشَدًا","طَرِيقَ الحقِّ والصَّوابِ."]],"15":[[0,1,"وَأَمَّا ٱلۡقَـٰسِطُونَ","الجائِرُونَ عَن طَرِيقِ الإسْلامِ."],[4,4,"حَطَبًا","وقُودًا."]],"16":[[0,3,"وَأَلَّوِ ٱسۡتَقَـٰمُواْ عَلَى ٱلطَّرِيقَةِ","لَو سارَ الكُفّارُ مِنَ الإنْسِ والِجنِّ على طَرِيقَةِ الإسْلامِ."],[6,6,"غَدَقًا","كَثِيرًا."]],"17":[[0,1,"لِّنَفۡتِنَهُمۡ فِيهِ","لِنَخْتَبِرَهُم."],[5,6,"ذِكۡرِ رَبِّهِۦ","طاعَةِ رَبِّهِ واسْتِماعِ القُرآنِ، والعَمَلِ بِهِ."],[7,7,"يَسۡلُكۡهُ","يُدْخِلْهُ."],[9,9,"صَعَدًا","شَدِيدًا شاقًّا."]],"18":[[0,2,"وَأَنَّ ٱلۡمَسَـٰجِدَ لِلَّهِ","وأَنَّ المساجِدَ لِعبادَة اللهِ وحْدَهُ."],[3,7,"فَلَا تَدۡعُواْ مَعَ ٱللَّهِ أَحَدًا","فلا تَعْبُدُوا فِيها غَيرَهُ."]],"19":[[3,4,"عَبۡدُ ٱللَّهِ","مُحَمَّدٌ ﷺ."],[9,9,"لِبَدًا","جَماعاتٍ مُتَراكِمَةً، بَعْضُها فَوْقَ بَعْضٍ؛ مِن شِدَّةِ ازْدِحامِهِم لِسَماعِ القُرآنِ مِنهُ."]],"21":[[1,5,"إِنِّي لَآ أَمۡلِكُ لَكُمۡ ضَرًّا","لا أقْدِرُ أن أدْفَعَ عَنْكُم ضَرًّا."],[6,7,"وَلَا رَشَدًا","ولا أجْلِبُ لَكُم نَفْعًا."]],"22":[[2,3,"لَن يُجِيرَنِي","لَن يُنْقِذَني مِن عَذابِ اللهِ."],[11,11,"مُلۡتَحَدًا","مَلْجَأً أفِرُّ إلَيهِ مِن عَذابِهِ."]],"23":[[0,4,"إِلَّا بَلَـٰغًا مِّنَ ٱللَّهِ وَرِسَـٰلَـٰتِهِۦ","لَكِنْ أمْلِكُ أنْ أبَلِّغَكُم عَنِ اللهِ ما أمَرَنِي بِتَبْلِيغِهِ لَكُم."]],"24":[[3,4,"مَا يُوعَدُونَ","ما يَعِدُهُم رَبُّهُم."],[8,8,"نَاصِرًا","مُعِينًا."],[10,10,"عَدَدًا","جُنْدًا."]],"25":[[1,2,"إِنۡ أَدۡرِيٓ","ما أعْلَمُ."],[4,5,"مَّا تُوعَدُونَ","ما يَعِدُكُم رَبُّكُم مِنَ العَذابِ وقِيامِ السّاعةِ."],[10,10,"أَمَدًا","مُدَّةً طَوِيلَةً."]],"26":[[1,1,"ٱلۡغَيۡبِ","ما غابَ عَنِ الأبْصارِ."],[2,3,"فَلَا يُظۡهِرُ","فلا يُطْلِعُ."]],"27":[[0,4,"إِلَّا مَنِ ٱرۡتَضَىٰ مِن رَّسُولٍ","إلّا مَن اختارهم اللهُ لِرسالَتِهِ، فَإنَّه يُطْلِعُهُم عَلى بَعْضِ الغَيبِ."],[6,12,"يَسۡلُكُ مِنۢ بَيۡنِ يَدَيۡهِ وَمِنۡ خَلۡفِهِۦ رَصَدًا","يُرْسِلُ مِن أمامِ الرَّسُولِ ومِن خَلْفِهِ ملائِكَةً يحفَظُونَهُ مِنَ الِجنِّ؛ لِئلّا يَسْتَرِقُوهُ ويَهْمِسُوا بِهِ إلى الكَهَنَةِ."]],"28":[[6,8,"وَأَحَاطَ بِمَا لَدَيۡهِمۡ","وعَلِمَ اللهُ بِكُلِّ ما عَنْدَهُم."],[9,12,"وَأَحۡصَىٰ كُلَّ شَيۡءٍ عَدَدَۢا","عَلِمَ اللهُ عَدَدَ الأَشْياءِ كُلِّها."]]}