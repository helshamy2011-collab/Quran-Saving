{"1":[[0,0,"طسٓ","تَقَدَّمَ الكلامُ على مِثْلِه أوَّلَ سُورَةِ البقرةِ."]],"4":[[9,9,"يَعۡمَهُونَ","يَتَرَدَّدُونَ ويَتَحَيَّرُونَ."]],"7":[[5,5,"ءَانَسۡتُ","أبْصَرْتُ ما يُؤْنِسُ."],[12,13,"بِشِهَابٍ قَبَسٍ","بِشُعْلَةِ نارٍ مَقْبُوسَةٍ، أي: مأخُوذَةٍ."],[15,15,"تَصۡطَلُونَ","تَسْتَدْفِئُونَ بِها."]],"8":[[4,7,"بُورِكَ مَن فِي ٱلنَّارِ","أي: إنّ اللهَ باركَ مَن فِي النّارِ ومَن حَولَها مِنَ الملائِكَةِ."]],"10":[[4,4,"تَهۡتَزُّ","تَتَحَرَّكُ بخِفَّةٍ."],[6,6,"جَآنٌّ","حَيَّةٌ خَفِيفَةٌ في سُرْعَةِ حَرَكَتِها."],[7,7,"وَلَّىٰ","هرَبَ."],[9,10,"وَلَمۡ يُعَقِّبۡ","لم يَرْجِعْ."]],"12":[[2,3,"فِي جَيۡبِكَ","في فَتْحَةِ قَمِيصِكَ الَّتي يُدْخَلُ منها الرَّأسُ."],[6,8,"مِنۡ غَيۡرِ سُوٓءٍ","مِن غَيرِ بَرَصٍ ولا مَرَضٍ."],[9,11,"فِي تِسۡعِ ءَايَـٰتٍ","وهي: اليدُ، والعَصا، والسِّنونَ، ونَقْصُ الثَّمراتِ، والطُّوفانُ، والجَرادُ، والقُمَّلُ، والضَّفادِعُ، والدَّمُ."]],"13":[[3,3,"مُبۡصِرَةً","واضِحَةً هادِيةً."]],"14":[[0,1,"وَجَحَدُواْ بِهَا","أنْكَرُوها بألْسِنَتِهِم."],[5,5,"وَعُلُوًّا","تَرَفُّعًا واسْتِكْبارًا عَنِ الإيمانِ بِها."]],"16":[[0,2,"وَوَرِثَ سُلَيۡمَـٰنُ دَاوُۥدَ","أي: نُبوَّتَه وعِلْمَه ومُلْكَه."],[7,8,"مَنطِقَ ٱلطَّيۡرِ","فَهْمَ أغْراضِه كلِّها مِن أصْواتِه."],[9,9,"وَأُوتِينَا","وأُعْطِينا."]],"17":[[0,0,"وَحُشِرَ","وجُمِعَ."],[7,8,"فَهُمۡ يُوزَعُونَ","فهم يُكَفُّونَ عَنِ التَّفرُّقِ، فكان على كُلِّ جِنْسٍ مَن يَرُدُّ أوَّلَهم على آخِرِهم كي يقِفُوا ويسِيرُوا مُنْتَظِمِينَ."]],"18":[[12,13,"لَا يَحۡطِمَنَّكُمۡ","أي: لا تُمَكِّنوهُم مِن قَتْلِكُم وإهْلاكِكُم."]],"19":[[6,6,"أَوۡزِعۡنِيٓ","ألْهِمْنِي ووَفِّقْنِي."]],"21":[[7,8,"بِسُلۡطَـٰنٍ مُّبِينٍ","بِحُجَّةٍ تُبيِّنُ عُذْرَه في غِيابِه."]],"22":[[4,4,"أَحَطتُ","عَلِمْتُ الأمرَ مِن جَميعِ جِهاتِهِ."],[9,9,"وَجِئۡتُكَ","بَلَدٍ باليمنِ سُمِّي باسْمِ «سَبأِ بنِ يَشْجُبَ»،ويقَعُ شَرْقَ صَنْعاء ويُسَمّى الآنَ «مَأْرِبًا»."]],"23":[[8,9,"وَلَهَا عَرۡشٌ","أي: سَرِيرُ المُلْكِ، تَجْلِسُ عليه لإدارةِ مُلْكِها."]],"24":[[11,11,"فَصَدَّهُمۡ","فَصَرَفَهُم."]],"25":[[5,5,"ٱلۡخَبۡءَ","المخْبوُءَ المسْتُورَ."]],"27":[[1,1,"سَنَنظُرُ","أي: سَنَتَأَمَّلُ."]],"28":[[6,7,"تَوَلَّ عَنۡهُمۡ","تَنَحَّ عَنْهُم."]],"31":[[0,1,"أَلَّا تَعۡلُواْ","ألّا تَتَكَبَّرُوا عليَّ."]],"32":[[1,2,"يَـٰٓأَيُّهَا ٱلۡمَلَؤُاْ","يا أيُّها الأشْرافُ."],[3,3,"أَفۡتُونِي","أشِيرُوا عَليَّ."],[8,9,"قَاطِعَةً أَمۡرًا","مُبْرِمَةً أمْرًا."],[11,11,"تَشۡهَدُونِ","تَحْضُرُونِ."]],"33":[[4,5,"وَأُوْلُواْ بَأۡسٍ","أصْحابُ نَجْدةٍ وبَلاءٍ في الحرْبِ."]],"35":[[4,4,"فَنَاظِرَةُۢ","فمُنتَظِرةٌ."]],"37":[[4,7,"لَّا قِبَلَ لَهُم بِهَا","لا طاقَةَ لَهُم بِمُقاوَمَتِها."],[12,12,"صَـٰغِرُونَ","ذَلِيلُونَ مُهانُونَ."]],"39":[[1,1,"عِفۡرِيتٌ","مارِدٌ قويٌّ شَدِيدٌ."]],"40":[[10,11,"أَن يَرۡتَدَّ","أن يَرْجِعَ."],[13,13,"طَرۡفُكَ","نَظَرُكَ."],[23,23,"لِيَبۡلُوَنِيٓ","لِيَخْتَبِرَنِي."],[25,26,"أَمۡ أَكۡفُرُ","أي: بِتَرْكِ شُكْرِ النِّعْمةِ."]],"41":[[1,1,"نَكِّرُواْ","غيِّرُوا."]],"42":[[8,9,"وَأُوتِينَا ٱلۡعِلۡمَ","وأُعْطِينا العِلْمَ بِاللهِ وبِقُدْرَتِه."]],"44":[[3,3,"ٱلصَّرۡحَ","القَصْرَ."],[6,7,"حَسِبَتۡهُ لُجَّةً","ظنَّتْهُ ماءً تتردَّدُ أمْواجُه."],[14,14,"مُّمَرَّدٌ","أمْلَسُ."],[15,16,"مِّن قَوَارِيرَ","مِن زُجاجٍ صافٍ شَفّافٍ."]],"45":[[12,12,"يَخۡتَصِمُونَ","يَتَنازَعُونَ."]],"46":[[4,6,"بِٱلسَّيِّئَةِ قَبۡلَ ٱلۡحَسَنَةِ","أي: بالكُفْرِ قَبْلَ الإيمانِ."]],"47":[[1,2,"ٱطَّيَّرۡنَا بِكَ","تَشاءَمْنا بِكَ، لأنّنا أُصِبْنا بالشَّدائِدِ."],[6,6,"طَـٰٓئِرُكُمۡ","شُؤْمُكُم."],[7,8,"عِندَ ٱللَّهِ","أي: قَدَّرَهُ اللهُ عَلَيكُم."],[12,12,"تُفۡتَنُونَ","تُمتَحَنُونَ وتُخْتَبرُونَ."]],"48":[[4,4,"رَهۡطٍ","رِجالٍ مِن أبْناءِ الأشْرافِ."]],"49":[[1,2,"تَقَاسَمُواْ بِٱللَّهِ","تحالَفُوا باللهِ."],[3,3,"لَنُبَيِّتَنَّهُۥ","لَنَأْتِيَنَّهُ بَغْتَةً في الليلِ، فَنْقتُلَهُ."],[8,9,"مَا شَهِدۡنَا","ما حَضَرْنا."]],"50":[[0,0,"وَمَكَرُواْ","دبَّرُوا الشَّرَّ بِحِيلَةٍ."]],"51":[[6,6,"دَمَّرۡنَـٰهُمۡ","أهْلكْناهُم."]],"52":[[2,2,"خَاوِيَةَۢ","خالِيةً خَرِبةً."]],"56":[[14,14,"يَتَطَهَّرُونَ","يَتَنَزَّهُونَ مِن إتْيانِ الرِّجالِ."]],"57":[[5,6,"مِنَ ٱلۡغَـٰبِرِينَ","مِنَ الباقِينَ في العَذابِ والهَلاكِ."]],"59":[[7,7,"ٱصۡطَفَىٰٓ","اخْتارَ."]],"60":[[11,13,"حَدَآئِقَ ذَاتَ بَهۡجَةٍ","بَساتِينَ ذاتَ مَنظَرٍ حَسَنٍ."],[26,26,"يَعۡدِلُونَ","يَنْحَرِفُونَ عَن طَرِيقِ الحقِّ إلى طَرِيقِ الباطِلِ وهو الشِّركُ."]],"61":[[3,3,"قَرَارًا","مُسْتَقَرًّا."],[5,5,"خِلَـٰلَهَآ","وسَطَها."],[9,9,"رَوَٰسِيَ","جِبالًا ثَوابِتَ."],[12,12,"ٱلۡبَحۡرَيۡنِ","العَذْبِ والمِلْحِ."],[13,13,"حَاجِزًا","فاصِلًا يَمْنَعُ اخْتِلاطَهُما."]],"62":[[2,2,"ٱلۡمُضۡطَرَّ","الَّذي أصابَه بَلاءٌ وشِدَّةٌ."],[8,8,"خُلَفَآءَ","أي: تَخْلُفُونَ مَن سَبَقَكُم في الأرضِ."]],"63":[[9,9,"بُشۡرَۢا","تُبَشِّرُ بالمَطَرِ."]],"64":[[1,2,"يَبۡدَؤُاْ ٱلۡخَلۡقَ","يُنْشِئُه."],[15,15,"بُرۡهَـٰنَكُمۡ","حُجَّتَكُم."]],"65":[[12,13,"أَيَّانَ يُبۡعَثُونَ","مَتى يُبْعثُونَ مِن قُبُورِهِم."]],"66":[[0,4,"بَلِ ٱدَّٰرَكَ عِلۡمُهُمۡ فِي ٱلۡـَٔاخِرَةِ","بَلْ تَكامَلَ علمُهُم بِها عِنْدَما بُعِثُوا يومَ القيامةِ."],[7,9,"فِي شَكٍّ مِّنۡهَا","أي: مِنَ الآخِرةِ في الدُّنيا."],[13,13,"عَمُونَ","أي: غافِلُونَ، فَقُلُوبُهُم عَمْياءُ."]],"67":[[8,8,"لَمُخۡرَجُونَ","لمَبْعُوثُونَ مِن قُبُورِنا."]],"68":[[10,11,"أَسَـٰطِيرُ ٱلۡأَوَّلِينَ","الأكاذيبُ الَّتي كَتَبها المتقدِّمُونَ."]],"70":[[6,6,"ضَيۡقٍ","حَرَجٍ وضِيقِ صَدْرٍ."]],"72":[[4,5,"رَدِفَ لَكُم","لَحِقَكُم، أو اقْتَرَبَ لَكُم."]],"74":[[3,4,"مَا تُكِنُّ","ما تُخْفِي."],[6,7,"وَمَا يُعۡلِنُونَ","وما يُظْهِرُونَ."]],"75":[[2,2,"غَآئِبَةٍ","هو ما يَغيبُ ويَخْفى عَلى الخَلْقِ."],[9,9,"مُّبِينٍ","واضِحٍ."]],"80":[[10,10,"مُدۡبِرِينَ","مُعْرِضِينَ."]],"82":[[1,2,"وَقَعَ ٱلۡقَوۡلُ","أي: وجَبَ العَذابُ."],[6,6,"دَآبَّةً","هي مِن أشْراطِ السّاعةِ الكُبْرى."],[9,9,"تُكَلِّمُهُمۡ","تُحدِّثُهُم."],[14,15,"لَا يُوقِنُونَ","لا يُصَدِّقُونَ."]],"83":[[1,1,"نَحۡشُرُ","نَجْمَعُ."],[9,10,"فَهُمۡ يُوزَعُونَ","فهم يُكَفُّونَ عَنِ التَّفَرُّقِ، فكان على كُلِّ جِنْسٍ مَن يَرُدُّ أوَّلَهم على آخِرِهِم ثُمَّ يُساقُون جميعًا."]],"87":[[3,3,"ٱلصُّورِ","القَرْنِ الَّذي يُنفَخُ فيهِ للبَعْثِ."],[4,4,"فَفَزِعَ","خافَ خَوْفًا شَدِيدًا مِن هَوْلِ النَّفخَةِ."],[17,17,"دَٰخِرِينَ","صاغِرِينَ مُطِيعِينَ."]],"88":[[2,3,"تَحۡسَبُهَا جَامِدَةً","تَظُنُّها ثابِتةً في أماكِنِها."],[6,7,"مَرَّ ٱلسَّحَابِ","مِثْلَ السَّحابِ الَّذي تُسَيِّرُه الرِّياحُ."]],"90":[[3,6,"فَكُبَّتۡ وُجُوهُهُمۡ فِي ٱلنَّارِ","أي: أُلقُوا على وُجُوهِهِم فِيها."]],"91":[[8,8,"حَرَّمَهَا","جَعَلها حَرَمًا آمِنًا لا يُسْفَكُ فيها دَمٌ."]]}