{"3":[[3,4,"نَّبَإِ مُوسَىٰ","خَبَرِ مُوسى."],[6,6,"بِٱلۡحَقِّ","بالصِّدْقِ."]],"4":[[2,2,"عَلَا","تَجَبَّرَ وتكَبَّرَ."],[7,7,"شِيَعًا","طَوائِفَ مُتَفَرِّقةً."],[13,14,"وَيَسۡتَحۡيِۦ نِسَآءَهُمۡ","أي: يَسْتَبْقِيهِنَّ للخِدْمَةِ والامْتِهانِ."]],"5":[[1,2,"أَن نَّمُنَّ","أن نَتَفَضَّلَ."],[9,9,"أَئِمَّةً","قادَةً في الخيرِ."],[11,11,"ٱلۡوَٰرِثِينَ","أي: ورِثُوا أرضَ مِصْرَ بَعْدَ هَلاكِ فِرْعَونَ وقَومِهِ."]],"6":[[0,0,"وَنُمَكِّنَ","ونُثَبِّتَ لهم."],[11,11,"يَحۡذَرُونَ","يَخافُونَ."]],"7":[[0,0,"وَأَوۡحَيۡنَآ","وألْهَمْنا."],[10,11,"فِي ٱلۡيَمِّ","في نَهْرِ النِّيلِ."]],"8":[[0,0,"فَٱلۡتَقَطَهُۥٓ","فأخَذَهُ."],[3,3,"لِيَكُونَ","أي: في المآلِ والعاقِبَةِ."]],"9":[[3,4,"قُرَّتُ عَيۡنٍ","مَصْدرُ سُرورٍ وسَعادةٍ تَقَرُّ العَينُ بِهِ."]],"10":[[1,1,"فُؤَادُ","قَلْبُ."],[4,4,"فَـٰرِغًا","خالِيًا مِن كلِّ شَيءٍ، ليمْلَأَه هَمُّ مُوسى وذِكْرُه."],[7,8,"لَتُبۡدِي بِهِۦ","لَتُظْهِرُ أنَّ مُوسى ابْنُها."],[10,11,"أَن رَّبَطۡنَا","أن ثبَّتناها بالصَّبرِ والثَّباتِ."]],"11":[[2,2,"قُصِّيهِ","اتَّبعِي أثَرَ مُوسى وتَعَرَّفي خَبَرَه."],[5,6,"عَن جُنُبٍ","عن بُعدٍ."]],"12":[[0,1,"وَحَرَّمۡنَا عَلَيۡهِ","أي: مَنَعْناهُ مِن قَبُولِ الرَّضاعَةِ."],[11,11,"يَكۡفُلُونَهُۥ","يقُومُونَ بإرْضاعِه وتَرْبِيَتِهِ."],[15,15,"نَـٰصِحُونَ","مُشْفِقُونَ."]],"13":[[3,5,"كَيۡ تَقَرَّ عَيۡنُهَا","كَي تُسَرَّ أمُّ مُوسى بِسَلامَةِ ولَدِها ورُجُوعِهِ إليها."]],"14":[[2,3,"أَشُدَّهُۥ وَٱسۡتَوَىٰٓ","أي: مُنْتَهى قُوَّتِه، وتكامَلَ عَقْلُه."],[4,6,"ءَاتَيۡنَـٰهُ حُكۡمًا وَعِلۡمًا","أعْطَيناه حِكْمَةً وفَهْمًا ومَعْرِفَةً بالدِّينِ."]],"15":[[2,4,"عَلَىٰ حِينِ غَفۡلَةٍ","وقْتِ غَفْلَةِ أهْلِها."],[17,17,"فَٱسۡتَغَـٰثَهُ","فَطَلَبَ الغَوثَ والنَّصْرَ مِن مُوسى عَلَيهِ الصَّلاةُ والسَّلامُ."],[19,20,"مِن شِيعَتِهِۦ","أي: مِن بَنِي إسْرائِيلَ قَومِ مُوسى عَلَيهِ الصَّلاةُ والسَّلامُ."],[22,24,"ٱلَّذِي مِنۡ عَدُوِّهِۦ","أي: القِبْطِيِّ الَّذي كان مِن قَومِ فِرْعَونَ."],[25,25,"فَوَكَزَهُۥ","ضَرَبَه مُوسى بجُمْعِ كَفِّه."],[27,28,"فَقَضَىٰ عَلَيۡهِ","قَتَلَه."]],"17":[[7,7,"ظَهِيرًا","مُعِينًا."]],"18":[[4,4,"يَتَرَقَّبُ","يَتَوَقَّعُ المكْرُوهَ ويُراقِبُ ما يَحْدُثُ."],[9,9,"يَسۡتَصۡرِخُهُۥ","يَطْلُبُ مِنهُ النَّصْرَ."],[14,14,"لَغَوِيٌّ","لَشَدِيدُ الضَّلالِ وسُوءِ النَّظرِ."]],"19":[[3,4,"أَن يَبۡطِشَ","أن يَأْخُذَ بقوَّةٍ وعُنْفٍ."]],"20":[[3,4,"أَقۡصَا ٱلۡمَدِينَةِ","آخِرِ المدينةِ."],[9,9,"ٱلۡمَلَأَ","أشْرافَ القَومِ."],[10,10,"يَأۡتَمِرُونَ","يَتَشاورُونَ في شَأْنِكَ."],[17,17,"ٱلنَّـٰصِحِينَ","المُشْفِقِينَ."]],"22":[[2,3,"تِلۡقَآءَ مَدۡيَنَ","جِهَةَ مَدْيَنَ."],[9,10,"سَوَآءَ ٱلسَّبِيلِ","أي: الطَّرِيقَ المُسْتَويَ إلى مَدْيَنَ."]],"23":[[1,1,"وَرَدَ","بَلَغَ."],[6,6,"أُمَّةً","جَماعةً."],[14,14,"تَذُودَانِ","تَحبِسانِ غَنَمَهُما عَنِ الماءِ."],[16,17,"مَا خَطۡبُكُمَا","ما شَأْنُكما؟"],[22,23,"يُصۡدِرَ ٱلرِّعَآءُ","يَنْصَرِفَ الرُّعاةُ بِمَواشِيهِم عَنِ الماءِ."]],"24":[[3,5,"تَوَلَّىٰٓ إِلَى ٱلظِّلِّ","رَجَعَ إليه."]],"27":[[10,10,"تَأۡجُرَنِي","تَكُونَ لي أجِيرًا في رَعْيِ الغَنَمِ."],[12,12,"حِجَجٍ","سِنِينَ."]],"28":[[4,5,"أَيَّمَا ٱلۡأَجَلَيۡنِ","أيَّ المُدَّتَينِ."],[6,6,"قَضَيۡتُ","وفَّيتُ به وأتْمَمْتُه."],[14,14,"وَكِيلٌ","شاهِدٌ وحَفِيظٌ."]],"29":[[3,3,"ٱلۡأَجَلَ","المُدَّةَ المُتَّفَقَ عَلَيها وهي عَشْرُ سِنِينَ."],[6,6,"ءَانَسَ","أبصَرَ ما يُؤْنِسُ."],[22,22,"جَذۡوَةٍ","جَمْرَةٍ وشُعْلَةٍ."],[26,26,"تَصۡطَلُونَ","تَسْتَدْفِئُونَ بِها."]],"30":[[4,4,"شَـٰطِيِٕ","جانِبِ."],[8,8,"ٱلۡبُقۡعَةِ","القِطْعَةِ مِنَ الأرْضِ."]],"31":[[5,5,"تَهۡتَزُّ","تتحرَّكُ بخِفَّةٍ."],[7,7,"جَآنٌّ","حَيَّةٌ خَفِيفَةٌ في سُرْعَةِ حرَكَتِها."],[8,8,"وَلَّىٰ","هَرَبَ."],[10,11,"وَلَمۡ يُعَقِّبۡ","لم يَرْجِعْ."],[13,13,"أَقۡبِلۡ","تَقَدَّمْ."]],"32":[[0,0,"ٱسۡلُكۡ","أدْخِلْ."],[2,3,"فِي جَيۡبِكَ","في فَتْحَةِ قَمِيصِكَ الَّتِي يُدْخَلُ مِنها الرَّأسُ."],[6,8,"مِنۡ غَيۡرِ سُوٓءٍ","مِن غَيرِ مَرَضٍ ولا بَرَصٍ."],[11,11,"جَنَاحَكَ","يَدَكَ."],[12,13,"مِنَ ٱلرَّهۡبِ","لِتَأْمَنَ مِنَ الخَوْفِ."],[20,20,"وَمَلَإِيْهِۦٓ","أشْرافِ قومهِ."]],"34":[[8,8,"رِدۡءًا","مُعِينًا."]],"35":[[1,2,"سَنَشُدُّ عَضُدَكَ","سَنُقَوِّيكَ ونُعِينُكَ."],[6,6,"سُلۡطَـٰنًا","حُجَّةً أو مَهابَةً في قُلُوبِ الأعْداءِ."]],"37":[[12,13,"عَـٰقِبَةُ ٱلدَّارِ","العاقِبةُ المحْمُودَةُ في الدّارِ الآخِرَةِ."]],"38":[[3,3,"ٱلۡمَلَأُ","الأشْرافُ مِن قَومِه."],[10,10,"فَأَوۡقِدۡ","فَأَشْعِلْ."],[17,17,"صَرۡحًا","قَصْرًا."],[19,19,"أَطَّلِعُ","أنظُرُ."]],"40":[[2,4,"فَنَبَذۡنَـٰهُمۡ فِي ٱلۡيَمِّ","فَطَرَحْناهُمْ في البَحْرِ، فَأَغْرَقَنْاهُم."]],"42":[[8,9,"مِّنَ ٱلۡمَقۡبُوحِينَ","مِنَ المذْمُومِينَ والمُبْعَدِينَ مِن كُلِّ خَيْرٍ."]],"43":[[8,9,"ٱلۡقُرُونَ ٱلۡأُولَىٰ","الأُمَمَ الماضِيَةَ."]],"44":[[5,7,"قَضَيۡنَآ إِلَىٰ مُوسَى","عَهِدْنا إليهِ وكَلَّفْناهُ."],[8,8,"ٱلۡأَمۡرَ","أي: أمْرَ الرِّسالَةِ."],[11,12,"مِنَ ٱلشَّـٰهِدِينَ","مِنَ الحاضِرِينَ في ذلك الوقتِ."]],"45":[[1,1,"أَنشَأۡنَا","خَلَقْنا."],[2,2,"قُرُونًا","أُمَمًا."],[3,5,"فَتَطَاوَلَ عَلَيۡهِمُ ٱلۡعُمُرُ","امْتَدَّ عَلَيهِمُ الزَّمانُ."],[8,8,"ثَاوِيًا","مُقِيمًا."]],"46":[[3,3,"ٱلطُّورِ","جَبَلِ طُورِ سَيناءَ."]],"47":[[4,6,"بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ","أي: بِسَبَبِ أعْمالِهِم السَّيِّئَةِ."]],"48":[[7,7,"أُوتِيَ","أُعْطِيَ."],[20,20,"سِحۡرَانِ","أي: التَّوراةُ والقرآنُ حَسَبَ زَعْمِهِم، أو هُما ذَوا سِحْرٍ، أي: مُوسى ومُحَمَّدٌ عليهما الصَّلاةُ والسَّلامُ حَسَبَ زَعْمِهِم."]],"51":[[1,3,"وَصَّلۡنَا لَهُمُ ٱلۡقَوۡلَ","أي: نَزَّلْنا عَلَيهِم القرآنَ يَتْبَعُ بَعْضُهُ بَعْضًا."]],"53":[[14,14,"مُسۡلِمِينَ","أي: مُخْلِصِينَ للهِ بالتوحيدِ."]],"54":[[6,6,"وَيَدۡرَءُونَ","يَدْفَعُونَ."]],"55":[[2,2,"ٱللَّغۡوَ","السّاقِطَ مِنَ القَوْلِ."],[12,13,"لَا نَبۡتَغِي","لا نُرِيدُ ولا نُحِبُّ."]],"56":[[1,2,"لَا تَهۡدِي","أي: هِدايةَ توفِيقٍ."]],"57":[[5,5,"نُتَخَطَّفۡ","نُخْتلَسْ ونُسْتَلَبْ قَتْلًا وأسْرًا."],[7,12,"أَوَ لَمۡ نُمَكِّن لَّهُمۡ حَرَمًا ءَامِنًا","أولم نَجْعَلْهُم يَنْعَمُونَ بالأمْنِ والتَّمكِينِ في البلدِ الحرامِ."],[13,14,"يُجۡبَىٰٓ إِلَيۡهِ","يُجْلَبُ إليه."]],"58":[[0,0,"وَكَمۡ","كَثِيرًا."],[4,5,"بَطِرَتۡ مَعِيشَتَهَا","طَغَتْ وكَفَرتْ نِعْمَةَ العَيشِ بالرَّغَدِ."],[16,16,"ٱلۡوَٰرِثِينَ","أي: للعِباد بَعْدَ إهْلاكِهم."]],"59":[[7,8,"فِيٓ أُمِّهَا","وهي مَكَّة المكَرَّمةُ، وتُعْرَفُ بأمِّ القُرى."]],"60":[[0,1,"وَمَآ أُوتِيتُم","وما أُعْطِيتُم."]],"61":[[2,3,"وَعۡدًا حَسَنًا","أي: بِدُخُولِ الجنَّةِ."],[15,16,"مِنَ ٱلۡمُحۡضَرِينَ","أي: مِمَّن أُحْضِرُوا لِلْحِسابِ والعَذابِ."]],"63":[[2,4,"حَقَّ عَلَيۡهِمُ ٱلۡقَوۡلُ","وجَبَ لهم العَذابُ."],[8,8,"أَغۡوَيۡنَآ","أضْلَلْنا."],[12,12,"تَبَرَّأۡنَآ","أي: مِن عِبادتِهم إيّانا."]],"66":[[0,2,"فَعَمِيَتۡ عَلَيۡهِمُ ٱلۡأَنۢبَآءُ","فَخَفِيَتْ عَلَيهِمُ الأَخْبارُ الَّتي كانُوا يَحْتَجُّونَ بِها."]],"68":[[8,8,"ٱلۡخِيَرَةُ","الاخْتِيارُ."]],"69":[[2,3,"مَا تُكِنُّ","ما تُخْفِي."]],"70":[[9,9,"ٱلۡأُولَىٰ","الحَياةِ الأُولى هي الدُّنيا."],[10,10,"وَٱلۡـَٔاخِرَةِ","الدّارِ الآخرةِ."]],"71":[[1,1,"أَرَءَيۡتُمۡ","أي: أخْبِرُونِي."],[7,7,"سَرۡمَدًا","دائِمًا مُسْتَمِرًّا."],[16,16,"بِضِيَآءٍ","بنُورٍ."]],"72":[[17,18,"تَسۡكُنُونَ فِيهِ","تَسْتَقِرُّونَ فِيه مِنَ التَّعَبِ."]],"73":[[6,7,"لِتَسۡكُنُواْ فِيهِ","لِتَسْتَقِرُّوا في اللَّيلِ وتَرْتاحَ أبْدانُكُم."],[8,10,"لِتَبۡتَغُواْ مِن فَضۡلِهِۦ","لِتطْلُبُوا وتَلْتَمِسُوا مِن رِزْقِهِ."]],"75":[[0,0,"وَنَزَعۡنَا","وأَخْرَجْنا."],[4,4,"شَهِيدًا","وهو نَبِيُّ كُلِّ أُمَّةٍ."],[6,7,"هَاتُواْ بُرۡهَـٰنَكُمۡ","أحْضِرُوا حُجَّتَكُم."],[16,16,"يَفۡتَرُونَ","يَخْتَلِقُونَ."]],"76":[[6,7,"فَبَغَىٰ عَلَيۡهِمۡ","تَكَبَّرَ عَلَيهِم."],[8,8,"وَءَاتَيۡنَـٰهُ","وأعْطَيناهُ."],[10,10,"ٱلۡكُنُوزِ","الأمْوالِ المدَّخَرَةِ في الخَزائِنِ."],[14,15,"لَتَنُوٓأُ بِٱلۡعُصۡبَةِ","لَتُثْقِلُ الجَماعَةَ الكَثِيرَةَ."],[16,17,"أُوْلِي ٱلۡقُوَّةِ","أصْحابِ القُوَّةِ، الأقْوِياءِ."],[22,23,"لَا تَفۡرَحۡ","لا تَبْطَرْ فَرَحًا بِكَثْرَةِ المالِ."]],"77":[[0,0,"وَٱبۡتَغِ","والتَمِسْ."],[2,2,"ءَاتَىٰكَ","أعْطاكَ."],[6,8,"وَلَا تَنسَ نَصِيبَكَ","ولا تَترُكْ حَظَّكَ مِنَ الدُّنيا."],[16,17,"وَلَا تَبۡغِ","ولا تَلْتمِسْ."]],"78":[[2,2,"أُوتِيتُهُۥ","أُعْطِيتُ هَذا المالَ."],[14,15,"مِنَ ٱلۡقُرُونِ","مِنَ الأُمَمِ."]],"79":[[14,14,"أُوتِيَ","أُعطِيَ."],[17,18,"لَذُو حَظٍّ","لَصاحِبُ نَصِيبٍ."]],"80":[[2,2,"أُوتُواْ","أُعطُوا."],[4,4,"وَيۡلَكُمۡ","زَجْرٌ لهم عَنْ هَذا التَّمَنِّي."],[12,13,"وَلَا يُلَقَّىٰهَآ","أي: لا يُعطى تِلْكَ الخَصْلَةَ أوِ الجنَّةَ."]],"81":[[0,1,"فَخَسَفۡنَا بِهِۦ","أي: فَجَعَلْنا الأرضَ تَبْتَلِعُهُ وهو حَيٌّ."],[8,8,"فِئَةٍ","جَماعَةٍ."]],"82":[[6,6,"وَيۡكَأَنَّ","كَلِمَةُ تَندُّمٍ وتَفَجُّعٍ، أي: ألمْ تَعْلَمْ."],[8,8,"يَبۡسُطُ","يُوسِّعُ."],[14,14,"وَيَقۡدِرُ","يُضَيِّقُ."],[17,17,"مَّنَّ","أنْعَمَ."],[22,22,"وَيۡكَأَنَّهُۥ","ألَمْ تَعْلَمْ."]],"83":[[7,7,"عُلُوًّا","تَكَبُّرًا."],[12,12,"وَٱلۡعَـٰقِبَةُ","أي: العاقِبةُ المحْمُودَةُ، وهي الجنَّةُ."]],"85":[[2,2,"فَرَضَ","أي: أنْزَلَ وأَوْجَبَ عَلَيكَ العَمَلَ بِمُقْتَضاه."],[5,5,"لَرَآدُّكَ","لَمُرْجِعُكَ."],[6,7,"إِلَىٰ مَعَادٍ","المرادُ بِهِ هُنا «مَكَّةُ»."],[17,18,"ضَلَـٰلٍ مُّبِينٍ","انحِرافٍ واضِحٍ."]],"86":[[2,2,"تَرۡجُوٓاْ","تَتَوَقَّعُ وتَنْتَظِرُ."],[3,4,"أَن يُلۡقَىٰٓ","أي: أن يُنزَّلَ."],[13,13,"ظَهِيرًا","مُعِينًا."]],"87":[[0,1,"وَلَا يَصُدُّنَّكَ","ولا يَصْرِفُنَّكَ."]],"88":[[13,14,"إِلَّا وَجۡهَهُۥ","إلّا إيّاهُ، أو إلّا ما أُرِيدَ به وجْهُه."],[16,16,"ٱلۡحُكۡمُ","القَضاءُ النّافِذُ، يَقْضِي بما شاءَ."]]}