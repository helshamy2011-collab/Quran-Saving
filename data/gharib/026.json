{"2":[[2,2,"ٱلۡكِتَـٰبِ","القرآنِ."]],"3":[[1,2,"بَـٰخِعٌ نَّفۡسَكَ","مُهْلِكُها غَمًّا وحُزْنًا."]],"4":[[6,6,"ءَايَةً","مُعْجِزَةً."],[10,10,"خَـٰضِعِينَ","مُنْقادِينَ بالكُرْهِ مِنهُم."]],"5":[[6,6,"مُحۡدَثٍ","أي: مُجَدَّدٍ إنْزالُه."]],"7":[[9,10,"زَوۡجٍ كَرِيمٍ","صِنْفٍ حَسَنٍ كَثِيرِ النَّفْعِ."]],"8":[[3,3,"لَـَٔايَةً","لَدَلالةً واضِحَةً."]],"11":[[2,3,"أَلَا يَتَّقُونَ","ألا يَخافُونَ عِقابَ اللهِ تعالى؟"]],"14":[[2,2,"ذَنۢبٌ","وهو قَتْلُ القِبْطِيِّ."]],"15":[[3,3,"بِـَٔايَـٰتِنَآ","بِمُعْجزاتِنا وحُجَجِنا."],[4,5,"إِنَّا مَعَكُم","أي: بالعِلْمِ والحِفْظِ والنُّصْرَةِ."]],"18":[[1,2,"أَلَمۡ نُرَبِّكَ","ألم نَرْعَكَ."],[4,4,"وَلِيدًا","صَغِيرًا."]],"19":[[1,1,"فَعۡلَتَكَ","أي: قَتْلَ القِبْطِيِّ."],[5,6,"مِنَ ٱلۡكَـٰفِرِينَ","أي: من الجاحِدِينَ لِنِعْمَتِي."]],"20":[[4,5,"مِنَ ٱلضَّآلِّينَ","مِنَ المُخْطِئِينَ لا المتعَمِّدِينَ."]],"21":[[7,7,"حُكۡمًا","أي: نُبُوَّةً وحِكْمَةً."]],"22":[[2,3,"تَمُنُّهَا عَلَيَّ","تَعُدُّها نِعْمَةً مِنكَ عليّ."],[5,5,"عَبَّدتَّ","جَعَلْتَهُم عَبِيدًا تَذْبَحُ مَن تَشاءُ وتَتْرُكُ مَن تَشاءُ مِن أبْنائِهِم وتَسْتَبْقِي نِساءَهُم لِلْخِدْمَةِ والامْتِهانِ."]],"30":[[3,4,"بِشَيۡءٍ مُّبِينٍ","أي: بِبُرْهانٍ قاطِعٍ."]],"33":[[4,4,"بَيۡضَآءُ","أي: مِن غَيرِ مَرَضٍ ولا بَرَصٍ."]],"34":[[1,1,"لِلۡمَلَإِ","لأشْرافِ قَوْمِهِ."],[5,6,"لَسَـٰحِرٌ عَلِيمٌ","أي: ساحِرٌ ماهِرٌ."]],"36":[[1,1,"أَرۡجِهۡ","أخِّرْهُ."],[5,5,"ٱلۡمَدَآئِنِ","المُدُنِ."],[6,6,"حَـٰشِرِينَ","جامِعِينَ للسَّحَرةِ."]],"45":[[5,5,"تَلۡقَفُ","تَبْتَلِعُ بِسُرْعَةٍ."],[6,7,"مَا يَأۡفِكُونَ","ما يَكْذِبُونَهُ ويُمَوِّهُونَهُ."]],"49":[[17,18,"مِّنۡ خِلَـٰفٍ","أي: بِقَطْعِ اليَدِ اليُمْنى والرِّجْلِ اليُسْرى أو عَكْسِ ذَلِك."],[19,19,"وَلَأُصَلِّبَنَّكُمۡ","ولَأُبالِغَنَّ في شَدِّ أطْرافِكُم ورَبْطِ أجْسادِكُم على جُذُوعِ النَّخْلِ."]],"50":[[1,2,"لَا ضَيۡرَ","لا ضَرَرَ عَلَينا فِيما يُصِيبُنا."],[6,6,"مُنقَلِبُونَ","راجِعُونَ."]],"51":[[9,10,"أَوَّلَ ٱلۡمُؤۡمِنِينَ","أي: مِن قَومِ فِرْعَونَ."]],"52":[[3,5,"أَنۡ أَسۡرِ بِعِبَادِيٓ","أي: اخْرُجْ بِهِم لَيْلًا."],[7,7,"مُّتَّبَعُونَ","يَتَّبِعُكُم فِرْعَونُ وجُنُودُه."]],"53":[[3,3,"ٱلۡمَدَآئِنِ","المُدُنِ."],[4,4,"حَـٰشِرِينَ","جامِعِينَ لِلْجَيشِ."]],"54":[[2,2,"لَشِرۡذِمَةٌ","لَطائِفَةٌ حَقِيرَةٌ قَلِيلةُ العَدَدِ."]],"55":[[1,2,"لَنَا لَغَآئِظُونَ","لَمُغْضِبُونا بِخُرُوجِهِم مِن غَيْرِ إذْنٍ مِنّا."]],"56":[[2,2,"حَـٰذِرُونَ","مُتَيَقِّظُونَ."]],"57":[[2,2,"جَنَّـٰتٍ","بَساتِينَ."]],"60":[[1,1,"مُّشۡرِقِينَ","وقْتَ شُرُوقِ الشَّمْسِ."]],"61":[[2,2,"ٱلۡجَمۡعَانِ","جَمْعُ مُوسى وهُم بنُو إسْرائيلَ، وجَمْعُ فِرْعَونَ وهم القِبْطُ."],[7,7,"لَمُدۡرَكُونَ","لَمُلحَقُون من قِبَلِ فِرْعَونَ وجُنُودِهِ."]],"63":[[7,7,"فَٱنفَلَقَ","أي: انْشَقَّ البَحْرُ إلى اثْنَي عَشْرَ طَرِيقًا."],[10,10,"فِرۡقٍ","قِطْعةٍ من البحْرِ مُرْتَفِعَةٍ."],[11,11,"كَٱلطَّوۡدِ","كالجَبَلِ المُتَطاوِلِ في السَّماءِ."]],"64":[[0,0,"وَأَزۡلَفۡنَا","وقَرَّبْنا."],[1,1,"ثَمَّ","هُناك."],[2,2,"ٱلۡـَٔاخَرِينَ","وهم فِرْعَونُ وقَوْمُه."]],"67":[[3,3,"لَـَٔايَةً","لَعِبرةً عَجِيبةً."]],"71":[[4,5,"لَهَا عَـٰكِفِينَ","على عِبادتِها مُقِيمِينَ على الدَّوامِ."]],"75":[[1,1,"أَفَرَءَيۡتُم","هَل تأمَّلْتُم ما أنْتُم عَلَيه؟"]],"82":[[6,7,"يَوۡمَ ٱلدِّينِ","يومَ الجَزاءِ."]],"83":[[3,3,"حُكۡمًا","عِلْمًا وفَهْمًا."]],"84":[[2,3,"لِسَانَ صِدۡقٍ","ثَناءً حَسَنًا."],[4,5,"فِي ٱلۡـَٔاخِرِينَ","أي: في الَّذينَ يأتُونَ بَعْدِي إلى يومِ القِيامَةِ."]],"87":[[0,1,"وَلَا تُخۡزِنِي","ولا تَفْضَحْنِي."]],"89":[[4,5,"بِقَلۡبٍ سَلِيمٍ","أي: مِنَ النِّفاقِ والكُفْرِ."]],"90":[[0,0,"وَأُزۡلِفَتِ","قُرِّبَتْ."]],"91":[[0,0,"وَبُرِّزَتِ","أُظْهِرَتْ."],[2,2,"لِلۡغَاوِينَ","للضّالِينَ عَن طَرِيقِ الهِدايةِ."]],"94":[[0,1,"فَكُبۡكِبُواْ فِيهَا","أُلْقُوا في جَهَنَّمَ على وُجُوهِهِم مرَّةً بَعْدَ مَرَّةٍ إلى أنِ اسْتَقرُّوا في قَعْرِها."]],"96":[[3,3,"يَخۡتَصِمُونَ","يَتَنازَعُون."]],"97":[[1,2,"إِن كُنَّا","إنَّنا كُنّا."]],"98":[[1,3,"نُسَوِّيكُم بِرَبِّ ٱلۡعَـٰلَمِينَ","نَجْعَلُكُم مِثْلَ رَبِّ العالَمِينَ."]],"100":[[3,3,"شَـٰفِعِينَ","فَيُخَلِّصُونا مِنَ العَذابِ."]],"101":[[2,2,"حَمِيمٍ","قَرِيبٍ ومُشْفِقٍ."]],"102":[[3,3,"كَرَّةً","رَجْعَةً إلى الدُّنيا."]],"111":[[4,4,"ٱلۡأَرۡذَلُونَ","أي: أسافلُ النّاسِ وأَراذِلُهم."]],"116":[[7,7,"ٱلۡمَرۡجُومِينَ","مِنَ المقْتُولِينَ رَمْيًا بالحِجارَةِ."]],"118":[[0,0,"فَٱفۡتَحۡ","فاحْكُمْ."]],"119":[[5,5,"ٱلۡمَشۡحُونِ","المَمْلُوءِ بالنّاسِ والدَّوابِّ والمتاعِ."]],"128":[[2,2,"رِيعٍ","مكانٍ مُرْتَفِعٍ."],[3,3,"ءَايَةً","بِناءً شامِخًا."]],"129":[[1,1,"مَصَانِعَ","حُصُونًا أو قُصُورًا."],[3,3,"تَخۡلُدُونَ","أي: تَبْقَونَ في الدُّنيا ولا تَمُوتُونَ."]],"130":[[1,1,"بَطَشۡتُم","أخَذْتُم بِعُنْفٍ."],[3,3,"جَبَّارِينَ","قاهِرِينَ ظالِمِين."]],"132":[[2,2,"أَمَدَّكُم","أنْعَمَ عليكُم وأَعْطاكُم."]],"133":[[1,1,"بِأَنۡعَـٰمٍ","مِنَ الإبِلِ والبَقَرِ والغَنَمِ."]],"134":[[0,0,"وَجَنَّـٰتٍ","حَدائِقَ وبَساتِينَ."]],"137":[[0,1,"إِنۡ هَـٰذَآ","ما هَذا."],[3,4,"خُلُقُ ٱلۡأَوَّلِينَ","دِينُ الأوَّلِينَ وعاداتُهُم."]],"146":[[2,3,"مَا هَـٰهُنَآ","أي: في الدُّنيا."]],"148":[[2,2,"طَلۡعُهَا","ثَمَرُها."],[3,3,"هَضِيمٌ","مُنْكَسِرٌ مِن لِينِهِ ورُطُوبَتِه."]],"149":[[4,4,"فَـٰرِهِينَ","ماهِرِين بنَحْتِها."]],"153":[[3,4,"مِنَ ٱلۡمُسَحَّرِينَ","مِنَ المغْلُوبِ على عُقُولِهِم بِكَثْرَةِ السِّحرِ."]],"154":[[6,6,"بِـَٔايَةٍ","بِحُجَّةٍ واضِحَةٍ."]],"155":[[3,4,"لَّهَا شِرۡبٌ","لها نَصِيبٌ مِنَ الماءِ."]],"157":[[0,0,"فَعَقَرُوهَا","فَنَحَرُوها."]],"165":[[0,1,"أَتَأۡتُونَ ٱلذُّكۡرَانَ","أتَنْكِحُونَ الرِّجالَ؟"]],"166":[[0,0,"وَتَذَرُونَ","وتَتْرُكُونَ."],[10,10,"عَادُونَ","مُتَجاوِزُونَ ما أباحَهُ اللهُ لَكُم مِنَ الحَلالِ إلى الحَرامِ."]],"168":[[3,4,"مِّنَ ٱلۡقَالِينَ","مِنَ المُبْغِضِينَ أشَدَّ البُغْضِ."]],"171":[[2,3,"فِي ٱلۡغَـٰبِرِينَ","في الباقِينَ في العذابِ والهلاكِ."]],"172":[[1,1,"دَمَّرۡنَا","أهْلَكْنا."]],"176":[[1,2,"أَصۡحَـٰبُ لۡـَٔيۡكَةِ","أصْحابُ الشَّجَرِ المُلْتَفِّ."]],"181":[[4,5,"مِنَ ٱلۡمُخۡسِرِينَ","مِنَ النّاقِصِينَ للحُقُوقِ بالتَّطفِيفِ."]],"182":[[1,1,"بِٱلۡقِسۡطَاسِ","بالميزانِ."]],"183":[[0,1,"وَلَا تَبۡخَسُواْ","ولا تَنْقُصُوا."],[4,5,"وَلَا تَعۡثَوۡاْ","ولا تُفْسِدُوا أشَدَّ الإفْسادِ."]],"184":[[3,4,"وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ","والخَلائِقَ من الأُمَمِ المتقدِّمةِ."]],"185":[[3,4,"مِنَ ٱلۡمُسَحَّرِينَ","مِنَ المغلُوبِ على عُقُولِهِم بِكَثْرَةِ السِّحْرِ."]],"187":[[2,2,"كِسَفًا","قِطَعَ عَذابٍ."]],"189":[[3,4,"يَوۡمِ ٱلظُّلَّةِ","أي: أظَلَّتْهُم سَحابَةٌ، ثُمَّ أمْطَرَتْهُم نارًَا."]],"193":[[2,3,"ٱلرُّوحُ ٱلۡأَمِينُ","جِبْرِيلُ عَلَيهِ السَّلامُ."]],"196":[[0,0,"وَإِنَّهُۥ","وإنَّ ذِكْرَ هَذا القُرآنِ."],[2,3,"زُبُرِ ٱلۡأَوَّلِينَ","كُتُبِ الرُّسُلِ السّابِقِينَ."]],"198":[[4,4,"ٱلۡأَعۡجَمِينَ","الَّذِينَ لا يتكَلَّمُونَ باللغةِ العَربيةِ."]],"200":[[1,1,"سَلَكۡنَـٰهُ","أدْخَلْناه."]],"202":[[1,1,"بَغۡتَةً","فَجْأَةً."]],"203":[[3,3,"مُنظَرُونَ","مُمْهَلُون لِنُؤمِنَ."]],"205":[[2,3,"مَّتَّعۡنَـٰهُمۡ سِنِينَ","أي: طَوَّلْنا لَهُم أعْمارَهُم."]],"207":[[0,2,"مَآ أَغۡنَىٰ عَنۡهُم","أي: لم يَنْفَعْهُم."]],"209":[[0,0,"ذِكۡرَىٰ","أي: تَذْكِيرٌ وتَنْبِيهٌ."]],"211":[[0,2,"وَمَا يَنۢبَغِي لَهُمۡ","ولا يَصِحُّ مِنهُم."]],"212":[[3,3,"لَمَعۡزُولُونَ","لمحْجُوُبونَ."]],"214":[[1,1,"عَشِيرَتَكَ","قَبِيلَتَكَ."]],"215":[[0,1,"وَٱخۡفِضۡ جَنَاحَكَ","ألِنْ جانِبَكَ وتَواضَعْ."]],"219":[[0,0,"وَتَقَلُّبَكَ","وتَصرُّفَكَ أو تَقَلُّبَكَ في الرُّكُوعِ والسُّجُودِ والقِيامِ."]],"222":[[3,3,"أَفَّاكٍ","كَذّابٍ."],[4,4,"أَثِيمٍ","كَثِيرِ الآثامِ."]],"223":[[0,1,"يُلۡقُونَ ٱلسَّمۡعَ","يُلْقُونَ ما سَمِعُوه مِنَ السَّماءِ إلى الكُهّانِ."]],"224":[[2,2,"ٱلۡغَاوُۥنَ","الضّالُّونَ عَنِ الحقِّ."]],"225":[[4,5,"كُلِّ وَادٍ","كلِّ فَنٍّ مِن فُنُونِ الكَذِبِ."],[6,6,"يَهِيمُونَ","يخُوضُونَ."]],"227":[[18,18,"يَنقَلِبُونَ","يَرْجِعُونَ إليهِ."]]}