{"1":[[2,2,"يَغۡشَىٰ","يُغَطِّي بِظلامِهِ الأَرْضَ وما عَلَيها."]],"2":[[2,2,"تَجَلَّىٰ","انكَشَفَ عَن ظَلام الليلِ بضِيائِهِ."]],"3":[[0,3,"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","أقْسَمَ اللهُ بِخَلْقِ الزَّوجِينِ."]],"4":[[0,2,"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","عَمَلَكُم لَمُخْتَلِفٌ بَينَ عامِلٍ للدُّنيا وعامِلٍ للآخِرَةِ."]],"5":[[2,2,"أَعۡطَىٰ","بَذَلَ مِن مّالِهِ."]],"6":[[1,1,"بِٱلۡحُسۡنَىٰ","ب «لا إلَه إلا اللهُ» وما دَلَّتْ عَلَيهِ، وما تَرتَّبَ عَلَيها مِنَ الجَزاءِ."]],"7":[[0,0,"فَسَنُيَسِّرُهُۥ","فَسَنُوَفِّقُهُ."],[1,1,"لِلۡيُسۡرَىٰ","لِعَمَلِ الخيرِ والشَّرِيعةِ السَّهْلَةِ."]],"8":[[2,2,"بَخِلَ","بِمالِهِ."],[3,3,"وَٱسۡتَغۡنَىٰ","عَن جزاءِ اللهِ."]],"9":[[1,1,"بِٱلۡحُسۡنَىٰ","بِالعِوَضِ مِنَ اللهِ."]],"10":[[0,0,"فَسَنُيَسِّرُهُۥ","فسَنُهَيُّئهُ في الدُّنيا."],[1,1,"لِلۡعُسۡرَىٰ","للْخَصْلَةِ العُسْرى، فَتَتَعَسَّرُ عَلَيه أسبابُ الخيرِ."]],"11":[[0,2,"وَمَا يُغۡنِي عَنۡهُ","ولا يَنفَعُهُ."],[5,5,"تَرَدَّىٰٓ","وقَعَ في النّارِ."]],"12":[[2,2,"لَلۡهُدَىٰ","بيانَ طَرِيقِ الهُدى المُوصِلِ إلى اللهِ."]],"13":[[0,2,"وَإِنَّ لَنَا لَلۡـَٔاخِرَةَ","وإنَّ لَنا مُلْكَ الحياةِ الآخِرَةِ."],[3,3,"وَٱلۡأُولَىٰ","والحياةَ الدُّنيا."]],"14":[[0,0,"فَأَنذَرۡتُكُمۡ","فَحَذَّرْتُكُم."],[1,2,"نَارًا تَلَظَّىٰ","نارًا تَتَوهَّجُ، وهي نارُ جَهَنَّمَ."]],"15":[[0,1,"لَا يَصۡلَىٰهَآ","لا يُقاسِي حَرَّها."]],"16":[[1,1,"كَذَّبَ","لم يُصَدِّق نبيَّ اللهِ محمدًا ﷺ."],[2,2,"وَتَوَلَّىٰ","وأَعْرَضَ عَنِ الإيمانِ باللهِ ورسولِه، وطاعَتِهِما."]],"17":[[0,0,"وَسَيُجَنَّبُهَا","وسَيُزَحْزَحُ عَنْها."]],"18":[[1,2,"يُؤۡتِي مَالَهُۥ","يَبْذُلُ مالَهُ."],[3,3,"يَتَزَكَّىٰ","يَطلبُ المزيدَ مِنَ الخيرِ."]],"19":[[0,5,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةٍ تُجۡزَىٰٓ","ولَيسَ إنفاقُه ذاكَ مُكافأةً لِمنْ أسْدى إلَيهِ معرُوفًا."]],"20":[[0,0,"إِلَّا","لَكِنَّهُ."]]}