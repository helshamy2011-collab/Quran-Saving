{"1":[[1,2,"ذَاتِ ٱلۡبُرُوجِ","ذاتِ المنازِل."]],"2":[[0,1,"وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ","أقَسَم اللهُ تَعالى بِاليَومِ الَّذِي وعَدَ اللهُ الخلْقَ أن يَجْمَعَهُم فِيهِ."]],"3":[[0,0,"وَشَاهِدٍ","الرائِي، أو الُمخْبِرِ بِحَقٍّ."],[1,1,"وَمَشۡهُودٍ","المَرئي، أو المشهود عليه بحق."]],"4":[[0,0,"قُتِلَ","لُعِنَ."],[1,2,"أَصۡحَـٰبُ ٱلۡأُخۡدُودِ","الَّذِين شَقُّوا في الأرضِ شَقًّا عَظِيمًا؛ لِتَعذِيبِ المؤمِنِينَ."]],"5":[[2,2,"ٱلۡوَقُودِ","ما تُوقَدُ بِهِ النّارُ مِن حَطَبٍ ونَحوِهِ."]],"6":[[0,1,"إِذۡ هُمۡ","هَؤُلاءِ الكُفّارُ مِن أصحابِ الأُخْدُودِ."],[2,2,"عَلَيۡهَا","عَلى حافَةِ النّارِ الَّتِي في الأُخْدُودِ."]],"7":[[5,5,"شُهُودٌ","حُضُورٌ."]],"8":[[0,1,"وَمَا نَقَمُواْ","وما أنْكَرُوا عَلَيهِم."],[7,7,"ٱلۡعَزِيزِ","الشَّدِيدِ في انْتِقامِهِ مِمَّن انْتَقَمَ مِنهُ."],[8,8,"ٱلۡحَمِيدِ","الَمحْمودِ في أقْوالِهِ وأَفْعالِهِ."]],"9":[[9,9,"شَهِيدٌ","مُطَّلِعٌ لا يَخْفى عَلَيهِ شَيءٌ."]],"10":[[2,2,"فَتَنُواْ","حَرَّقُوا."]],"11":[[8,9,"مِن تَحۡتِهَا","مِن تَحْتِ قُصُورِها وأَشْجارِها."]],"13":[[2,2,"يُبۡدِئُ","يَبْدَأُ الخَلْقَ."],[3,3,"وَيُعِيدُ","الخَلْقَ لِلْحِسابِ."]],"14":[[1,1,"ٱلۡغَفُورُ","لمِن تابَ."],[2,2,"ٱلۡوَدُودُ","كَثِيرُ المحَبَّةِ لأوليائِهِ."]],"15":[[0,1,"ذُو ٱلۡعَرۡشِ","صاحِبُ العرْشِ."],[2,2,"ٱلۡمَجِيدُ","الَّذِي بَلَغَ المُنْتَهى في الفَضلِ."]],"16":[[0,2,"فَعَّالٌ لِّمَا يُرِيدُ","لا يَمْتَنِعُ عَلَيهِ شَيءٌ يُريدُهُ."]],"17":[[2,3,"حَدِيثُ ٱلۡجُنُودِ","خَبَرُ الجُمُوعِ الكافِرةِ المُكَذِّبةِ لأَنْبِيائِها."]],"21":[[3,3,"مَّجِيدٌ","عَظِيمٌ كَرِيمٌ."]],"22":[[0,2,"فِي لَوۡحٍ مَّحۡفُوظِۭ","لا ينالُه تَبْدِيلٌ ولا تَحْرِيفٌ."]]}