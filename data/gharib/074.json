{"1":[[1,1,"ٱلۡمُدَّثِّرُ","المتَغَطِّي بِثِيابِهِ."]],"2":[[0,0,"قُمۡ","أي مِن مَّضْجَعِكَ."],[1,1,"فَأَنذِرۡ","فَحَذِّر النّاس مِن عَذابِ اللهِ."]],"3":[[0,1,"وَرَبَّكَ فَكَبِّرۡ","وخُصَّ رَبَّكَ وحْدَهُ بالتَّعْظِيمِ والعِبادَةِ."]],"4":[[0,1,"وَثِيَابَكَ فَطَهِّرۡ","أي مِنَ النَّجاساتِ."]],"5":[[0,1,"وَٱلرُّجۡزَ فَٱهۡجُرۡ","ودُمْ على هَجْر أعْمالِ الشِّرْكِ كُلِّها."]],"6":[[0,2,"وَلَا تَمۡنُن تَسۡتَكۡثِرُ","ولا تُعْطِ العَطِيَّةَ؛ كَي تَلْتَمِسَ أكْثَرَ مِنها."]],"7":[[0,1,"وَلِرَبِّكَ فَٱصۡبِرۡ","ولِمَرْضاةِ رَبِّكَ فاصْبِرْ عَلى الأَوامِرِ والنَّواهِي."]],"8":[[1,1,"نُقِرَ","نُفِخَ نَفْخَةَ البعثِ والنُّشُورِ."],[3,3,"ٱلنَّاقُورِ","القَرْنِ الَّذِي يُنْفَخُ فِيهِ."]],"11":[[0,3,"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدًا","دَعْنِي -أيُّها الرَّسُولُ- أنا والَّذِي خَلَقْتُه في بَطْنِ أُمِّهِ وحِيدًا لا مالَ لَهُ ولا ولدَ."]],"12":[[3,3,"مَّمۡدُودًا","مبسُوطًا واسِعًا."]],"13":[[1,1,"شُهُودًا","حاضِرِينَ مَعَهُ في «مكَّةَ» لا يغِيبُونَ عَنْهُ."]],"14":[[0,1,"وَمَهَّدتُّ لَهُۥ","ويَسَّرتُ لَهُ سُبُلَ العيشِ."]],"15":[[2,3,"أَنۡ أَزِيدَ","أي في مالِهِ ووَلَدِهِ."]],"16":[[0,0,"كَلَّآ","ليس الأمرُ كما يَزْعُمُ."],[3,3,"لِـَٔايَـٰتِنَا","للقرآنِ."],[4,4,"عَنِيدًا","معانِدًا مُكَذِّبًا."]],"17":[[0,0,"سَأُرۡهِقُهُۥ","سَأُكَلِّفُه."],[1,1,"صَعُودًا","مَشَقَّةً مِنَ العذابِ."]],"18":[[1,1,"فَكَّرَ","في نَفْسِهِ."],[2,2,"وَقَدَّرَ","وهَيَّأ ما يقُولُه مِنَ الطَّعنِ في مُحَمَّدٍ ﷺ والقرآنِ."]],"19":[[0,0,"فَقُتِلَ","فَلُعِنَ، واسْتَحَقَّ بِذَلِكَ الهَلاكَ."],[1,2,"كَيۡفَ قَدَّرَ","كَيفَ أعَدَّ في نفسهِ هَذا الطَّعْنَ."]],"21":[[1,1,"نَظَرَ","تَأَمَّلَ فيما قَدَّرَ وهَيَّأَ مِنَ الطَّعْنِ في القرآنِ."]],"22":[[1,1,"عَبَسَ","قَطَّبَ وجْهَهُ."],[2,2,"وَبَسَرَ","واشْتَدَّ في العُبُوسِ."]],"23":[[1,1,"أَدۡبَرَ","رَجَعَ مُعْرِضًا عَنِ الحقِّ."],[2,2,"وَٱسۡتَكۡبَرَ","وتَعاظَمَ أن يَعْتَرِفَ بِهِ."]],"24":[[1,2,"إِنۡ هَـٰذَآ","ما الَّذِي يَقُولُه مُحَمَّدٌ."],[5,5,"يُؤۡثَرُ","يُنْقلُ عَنِ الأوّلِينَ."]],"25":[[3,4,"قَوۡلُ ٱلۡبَشَرِ","كلامُ المخلُوقيِنَ، تَعَلَّمَهُ مُحَمَّدٌ مِنهُم، ثُمَّ ادَّعى أنَّهُ مِن عندِ اللهِ."]],"26":[[0,0,"سَأُصۡلِيهِ","سَأُدْخِلُهُ."],[1,1,"سَقَرَ","جَهَنَّمَ."]],"27":[[0,1,"وَمَآ أَدۡرَىٰكَ","وما أعلَمَكَ."],[2,3,"مَا سَقَرُ","أيُّ شَيءٍ جَهَنَّمُ؟"]],"28":[[0,1,"لَا تُبۡقِي","لا تَتْرُكُ مِن أجْزاءِ المُعَذَّبِينَ شَيئًا."],[2,3,"وَلَا تَذَرُ","ولا تَتْرُكُ مَن فيها مَيِّتًا، ولَكِنَّها تُحْرِقُهُم كُلَّما جُدِّدَ خَلْقُهُم."]],"29":[[0,0,"لَوَّاحَةٌ","حَرّاقَةٌ، مُغيِّرةٌ، مُسَوِّدةٌ."],[1,1,"لِّلۡبَشَرِ","للجُلودِ، مُفْردُها: بَشَرةٌ."]],"30":[[0,0,"عَلَيۡهَا","يَلِي أمَر جَهَنَّمَ ويَتَسَلَّطُ على أهْلِها بالعَذابِ."],[1,2,"تِسۡعَةَ عَشَرَ","مَلَكًا مِنَ الزَّبانِيَةِ الأَشِداءِ."]],"31":[[2,3,"أَصۡحَـٰبَ ٱلنَّارِ","خَزَنَةَ النّارِ."],[8,8,"عِدَّتَهُمۡ","ذِكْرَ عَدَدِهِم."],[10,10,"فِتۡنَةً","اخْتِبارًا."],[13,13,"لِيَسۡتَيۡقِنَ","وليَحْصُلَ اليقِينُ."],[14,16,"ٱلَّذِينَ أُوتُواْ ٱلۡكِتَـٰبَ","اليهُودُ والنَّصارى."],[21,22,"وَلَا يَرۡتَابَ","ولا يَشُكَّ."],[31,31,"مَّرَضٌ","نِفاقٌ."],[33,37,"مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا","ما الَّذِي أرادَهُ اللهُ بِهذا العَدَدِ؟"],[38,38,"كَذَٰلِكَ","بِمِثْلِ ذَلِكَ الَّذِي ذُكِرَ."],[48,49,"جُنُودَ رَبِّكَ","عَدَدَهُم."],[53,53,"هِيَ","النّارُ."],[55,55,"ذِكۡرَىٰ","تَذْكِرَةٌ ومَوْعِظَةٌ."]],"32":[[0,0,"كَلَّا","ليسَ الأمرُ كَما ذَكَرُوا."]],"33":[[1,2,"إِذۡ أَدۡبَرَ","حِينَ ولّى وذَهَبَ."]],"34":[[2,2,"أَسۡفَرَ","أضاءَ."]],"35":[[0,0,"إِنَّهَا","إنَّ النّارَ."],[2,2,"ٱلۡكُبَرِ","العَظائِمِ."]],"36":[[0,0,"نَذِيرًا","إنْذارًا وتَخْوِيفًا."]],"37":[[4,4,"يَتَقَدَّمَ","يَتَقَرَّبَ إلى رَبِّهِ بِفِعْلِ الطّاعاتِ."],[5,6,"أَوۡ يَتَأَخَّرَ","بِفِعْلِ المعاصِي."]],"38":[[2,3,"بِمَا كَسَبَتۡ","مِن أعْمالِ الخيرِ والشَّرِ."],[4,4,"رَهِينَةٌ","مَحْبُوسَةٌ مَرْهُوَنةٌ بِكَسْبِها."]],"39":[[0,2,"إِلَّآ أَصۡحَـٰبَ ٱلۡيَمِينِ","وهم المسْلِمُونَ المخلِصُونَ."]],"40":[[2,2,"يَتَسَآءَلُونَ","يَسْأَلُ بَعْضُهُم بَعْضًا."]],"41":[[0,1,"عَنِ ٱلۡمُجۡرِمِينَ","عَنِ الكافِرِينَ الَّذينَ أجْرمُوا في حَقِّ أنْفُسِهِم."]],"42":[[0,1,"مَا سَلَكَكُمۡ","ما الَّذِي أدْخَلَكُم."],[3,3,"سَقَرَ","جَهَنَّمَ."]],"45":[[1,1,"نَخُوضُ","نَتَحَدَّثُ بالباطِلِ."],[2,3,"مَعَ ٱلۡخَآئِضِينَ","مَعَ أهْلِ الضَّلالةِ."]],"48":[[2,2,"شَفَـٰعَةُ","طَلَبُ قَضاءِ حاجَةِ المشْفُوعِ لَهُ عِنْدَ المَشْفُوعِ عنْدَهُ."],[3,3,"ٱلشَّـٰفِعِينَ","الملائِكَةِ والنَّبِيِّينَ وغَيرِهِم."]],"49":[[0,1,"فَمَا لَهُمۡ","فما لِهؤُلاءِ المشْرِكِينَ."],[2,3,"عَنِ ٱلتَّذۡكِرَةِ","عَنِ القُرآنِ وما فِيهِ مِنَ المواعِظِ."],[4,4,"مُعۡرِضِينَ","مُنْصَرِفِينَ."]],"50":[[1,1,"حُمُرٌ","حُمُرٌ وحْشِيِّةٌ."],[2,2,"مُّسۡتَنفِرَةٌ","شَدِيَدُة النِّفارِ."]],"51":[[2,2,"قَسۡوَرَةِۭ","أسَدٍ كاسِرٍ."]],"52":[[7,7,"صُحُفًا","كُتُبًا."],[8,8,"مُّنَشَّرَةً","مَفْتُوحَةً مَقْرُوءَةً."]],"53":[[0,0,"كَلَّا","ليسَ الأمرُ كَما زَعَمُوا."],[2,4,"لَّا يَخَافُونَ ٱلۡـَٔاخِرَةَ","لا يُصَدِّقُونَ بالبَعْثِ والجزاءِ."]],"54":[[0,0,"كَلَّآ","حَقًّا."],[1,1,"إِنَّهُۥ","إنَّ القُرآنَ."],[2,2,"تَذۡكِرَةٌ","مَوْعِظَةٌ بَلِيغَةٌ كافِيَةٌ لاتِّعاظِهِم."]],"55":[[2,2,"ذَكَرَهُۥ","اتَّعظَ بِما فِيهِ وانْتَفَعَ بِهُداهُ."]],"56":[[0,1,"وَمَا يَذۡكُرُونَ","وما يَتَّعِظُونَ بِه."],[7,8,"أَهۡلُ ٱلتَّقۡوَىٰ","المسْتَحِقُّ لِأَن يُتَّقى ويُطاعَ."],[9,10,"وَأَهۡلُ ٱلۡمَغۡفِرَةِ","والجديرُ بأن يَغْفِرَ لِمَن آمنَ بِهِ وأطاعَهُ."]]}