{"1":[[0,0,"وَٱلطُّورِ","هُوَ الجَبَلُ الَّذِي كَلَّمَ اللهُ عَلَيهِ مُوسى عَلَيهِ السَّلامُ."]],"2":[[1,1,"مَّسۡطُورٍ","مَكْتُوبٍ، وهُو القُرآنُ."]],"3":[[0,2,"فِي رَقٍّ مَّنشُورٍ","مَكْتُوبٍ في صَحِيفةٍ مَبْسُوطَةٍ."]],"4":[[0,1,"وَٱلۡبَيۡتِ ٱلۡمَعۡمُورِ","هو فَوْقَ السَّماءِ السّابِعةِ تَطُوفُ بِه الملائِكةُ دائِمًا."]],"5":[[0,1,"وَٱلسَّقۡفِ ٱلۡمَرۡفُوعِ","هو السَّماءُ الدُّنيا، جَعَلَها اللهُ سَقْفًا للأرْضِ."]],"6":[[1,1,"ٱلۡمَسۡجُورِ","الممْلُوءِ بالمياهِ."]],"8":[[3,3,"دَافِعٍ","مانِعٍ يَمْنَعُه حِينَ وقُوعِهِ."]],"9":[[1,1,"تَمُورُ","تَتَحرَّكُ وتَضْطَرِبُ."]],"10":[[0,0,"وَتَسِيرُ","تَزُولُ عَنْ أماكِنِها وتَسيرُ كَسَيرِ السَّحابِ."]],"11":[[0,0,"فَوَيۡلٌ","فَهَلاكٌ."]],"12":[[2,3,"فِي خَوۡضٍ","في انْدِفاعٍ في الكَلامِ الباطِلِ."],[4,4,"يَلۡعَبُونَ","يَسْتَهْزِئُونَ."]],"13":[[1,1,"يُدَعُّونَ","يُدْفَعُونَ."],[5,5,"دَعًّا","دَفْعًا بِعُنْفٍ ومهانَةٍ."]],"16":[[0,0,"ٱصۡلَوۡهَا","ادْخُلُوها واحْتَرِقُوا بِنارِها."]],"18":[[0,0,"فَـٰكِهِينَ","طَيِّبَةً أنْفُسُكُم مُتَمَتِّعِينَ عَلى وجْهِ السُّرِورِ."]],"19":[[2,2,"هَنِيٓـَٔۢا","أكْلًا وشُرْبًا هَنِيئًا أي سائِغًا."]],"20":[[0,0,"مُتَّكِـِٔينَ","جالِسِين عَلى وجْهِ التَّمَكُّن والرّاحةِ."],[2,2,"سُرُرٍ","جَمْعُ سَرِيرٍ وهو ما يُضْطَجَعُ عَلَيهِ، وهو مَجْلِسُ المنَعَّمِينَ."],[3,3,"مَّصۡفُوفَةٍ","مُتَقابِلَةٍ."],[4,4,"وَزَوَّجۡنَـٰهُم","قَرَنّاهُم."],[5,5,"بِحُورٍ","بِنِساءٍ شَدِيداتِ بَياضِ العَينِ وسَوادها."],[6,6,"عِينٍ","واسِعاتِ العُيونِ حِسانِهِنَّ."]],"21":[[8,9,"وَمَآ أَلَتۡنَـٰهُم","وما نَقَصْناهُم."],[18,18,"رَهِينٌ","مَحْبُوسٌ مقْرُونٌ."]],"22":[[0,0,"وَأَمۡدَدۡنَـٰهُم","وزِدْناهُم."]],"23":[[0,0,"يَتَنَـٰزَعُونَ","يَتَعاطَونَ، ويُناوِلُ بعضُهم بَعْضًا."],[2,2,"كَأۡسًا","إناءً مَمْلُوءًا مِنَ الخَمْرِ."],[4,4,"لَغۡوٌ","كَلامٌ لا فائِدةَ فِيهِ."],[7,7,"تَأۡثِيمٌ","إثْمٌ ومَعْصِيَةٌ."]],"24":[[6,6,"مَّكۡنُونٌ","مَصُونٌ في أصْدافِهِ."]],"26":[[6,6,"مُشۡفِقِينَ","خائِفِينَ مِن عَذابِ رَبِنا."]],"27":[[5,5,"ٱلسَّمُومِ","نارِ جَهَنَّمَ وحَرارَتِها."]],"28":[[7,7,"ٱلۡبَرُّ","المُحْسِنُ."]],"29":[[3,4,"بِنِعۡمَتِ رَبِّكَ","بمَنِّهِ ولُطْفِهِ."],[5,5,"بِكَاهِنٍ","يُخْبِرُ بالغَيبِ دُونَ عِلْمٍ."]],"30":[[3,3,"نَّتَرَبَّصُ","نَنْتَظِرُ."],[5,6,"رَيۡبَ ٱلۡمَنُونِ","حوادِثَ الدَّهرِ فَيَمُوتُ."]],"32":[[2,2,"أَحۡلَـٰمُهُم","عُقُولُهم."],[7,7,"طَاغُونَ","مُتَجاوِزُونَ الحدَّ."]],"33":[[2,2,"تَقَوَّلَهُۥ","اخْتَلَقَهُ."]],"37":[[6,6,"ٱلۡمُصَۜيۡطِرُونَ","المُتَسَلِّطُونَ."]],"38":[[2,2,"سُلَّمٌ","دَرَجٌ ومَصْعَدٌ إلى السَّماءِ."],[3,3,"يَسۡتَمِعُونَ","الكَلامَ الَّذِي يَجْرِي في السَّماءِ ويَسْتَرِقُونَهُ."],[7,7,"بِسُلۡطَـٰنٍ","بِحُجَّةٍ."]],"40":[[5,5,"مَّغۡرَمٍ","غَرامةٍ مَطْلُوبَةٍ مِنهُم."]],"42":[[2,2,"كَيۡدًا","مَكْرًا."],[6,6,"ٱلۡمَكِيدُونَ","يَعُودُ ضَرَرُ مَكْرِهِم عَلَيهِم."]],"44":[[2,2,"كِسۡفًا","قِطَعًا كِبارًا مِنَ العَذابِ."],[8,8,"مَّرۡكُومٌ","مُتَراكِمٌ بَعْضُهُ فَوْقَ بَعْضٍ."]],"45":[[0,0,"فَذَرۡهُمۡ","فَدَعْهُم."],[6,6,"يُصۡعَقُونَ","يُهلَكُونَ، وهو يومُ القِيامَةِ."]],"46":[[1,2,"لَا يُغۡنِي","لا يَدْفَعُ."]],"47":[[3,5,"عَذَابًا دُونَ ذَٰلِكَ","مِنَ القَتْلِ والسَّبْيِ وعَذابِ القَبْرِ."]],"48":[[4,4,"بِأَعۡيُنِنَا","بِمَرْأىً مِنّا وحِفْظٍ واعْتِناءٍ."],[8,9,"حِينَ تَقُومُ","إلى الصَّلاةِ، وحِينَ تَقُومُ مِنَ النَّومِ."]],"49":[[3,4,"وَإِدۡبَـٰرَ ٱلنُّجُومِ","عِنْدَ صَلاةِ الصُّبْحِ حِينَ يُغَطِّي ضَوءُ الصُّبْحِ النُّجُومَ."]]}