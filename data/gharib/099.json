{"1":[[1,1,"زُلۡزِلَتِ","رُجَّتْ."],[3,3,"زِلۡزَالَهَا","رَجًّا شَدِيدًا."]],"2":[[2,2,"أَثۡقَالَهَا","ما في بَطْنِها مِن مَوتى وكُنُوزٍ."]],"3":[[2,3,"مَا لَهَا","ما الَّذِي حَدَثَ لَها؟"]],"4":[[0,0,"يَوۡمَئِذٍ","يَومَ القيامةِ."],[1,2,"تُحَدِّثُ أَخۡبَارَهَا","تُخْبِرُ الأَرْضُ بِما عُمِلَ عَلَيها مِن خَيرٍ أو شَرٍّ."]],"5":[[2,3,"أَوۡحَىٰ لَهَا","أمَرَها بأن تُخْبِرَ بِما عُمِلَ عَلَيها."]],"6":[[1,2,"يَصۡدُرُ ٱلنَّاسُ","يَرْجِعُ النّاسُ عَن مَوقِفِ الحِسابِ."],[3,3,"أَشۡتَاتًا","أصنافًا مُتَفَرِّقِينَ."],[4,5,"لِّيُرَوۡاْ أَعۡمَـٰلَهُمۡ","لِيُرِيَهُم اللهُ ما عَمِلُوا."]],"7":[[2,3,"مِثۡقَالَ ذَرَّةٍ","وزنَ نَمْلَةٍ صَغِيرَةٍ."],[5,5,"يَرَهُۥ","يَرَ ثَوابَهُ في الآخِرَةِ."]]}