{"1":[[0,0,"هَلۡ","قَدْ."],[3,3,"ٱلۡغَـٰشِيَةِ","القِيامةِ الَّتِي تَغْشى النّاسَ بأهْوالِها."]],"2":[[0,0,"وُجُوهٌ","وُجُوهُ الكُفّارِ."],[2,2,"خَـٰشِعَةٌ","ذَلِيلةٌ بالعذابِ."]],"3":[[0,0,"عَامِلَةٌ","مُجْهَدَةٌ بالعَمَلِ."],[1,1,"نَّاصِبَةٌ","مُتْعَبَةٌ."]],"4":[[0,0,"تَصۡلَىٰ","تُقاسِي نارًا."],[2,2,"حَامِيَةً","شَدِيدَة التَّوَهُّجِ."]],"5":[[3,3,"ءَانِيَةٍ","بَلَغَتْ مُنْتَهى الحرارةِ."]],"6":[[5,5,"ضَرِيعٍ","نَبْتٍ ذي شَوْكٍ لاصِقٍ بالأرْضِ."]],"7":[[2,5,"وَلَا يُغۡنِي مِن جُوعٍ","ولا يَسُدُّ جُوعَهُ."]],"8":[[0,0,"وُجُوهٌ","وُجُوهُ المؤمِنينَ."],[2,2,"نَّاعِمَةٌ","ذاتُ نِعْمَةٍ وكَرامةٍ."]],"9":[[0,0,"لِّسَعۡيِهَا","لِعَمَلِها الَّذِي عَمِلَتْهُ في الدُّنيا."],[1,1,"رَاضِيَةٌ","في الآخِرَةِ حِينَ أُعْطِيَتِ الجنَّةَ بِعَمَلِها."]],"10":[[2,2,"عَالِيَةٍ","رَفِيعةِ المكانِ والمكانةِ."]],"11":[[3,3,"لَـٰغِيَةً","كَلِمةَ لَغْوٍ."]],"12":[[2,2,"جَارِيَةٌ","تَتَدَفَّقُ مِياهُها."]],"14":[[1,1,"مَّوۡضُوعَةٌ","مُعَدَّةٌ للشّارِبِينَ."]],"15":[[0,0,"وَنَمَارِقُ","ووَسائِدُ ومَرافِقُ."],[1,1,"مَصۡفُوفَةٌ","بَعضُها بِجَنبِ بَعْضٍ."]],"16":[[0,0,"وَزَرَابِيُّ","وبُسُطٌ."],[1,1,"مَبۡثُوثَةٌ","كَثِيرةٌ مَفْرُوشَةٌ."]],"18":[[2,3,"كَيۡفَ رُفِعَتۡ","عَنِ الأرْضِ بِلا عَمَدٍ؟"]],"19":[[3,3,"نُصِبَتۡ","رُفِعتْ حتّى كانتْ بارزةً على وجْهِ الأرضِ."]],"20":[[3,3,"سُطِحَتۡ","بُسِطَتْ و مُهِّدتْ."]],"21":[[0,0,"فَذَكِّرۡ","فَعِظْ."],[3,3,"مُذَكِّرٌ","واعِظٌ."]],"22":[[2,2,"بِمُصَيۡطِرٍ","بِمُسَلَّطٍ، فَتُكْرِهَهُم على الإيمانِ."]],"23":[[2,2,"تَوَلَّىٰ","أعْرَضَ وأصَرَّ عَلى الكُفْرِ."]],"24":[[2,3,"ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","النّارَ."]],"25":[[2,2,"إِيَابَهُمۡ","مَرْجِعَهُم بَعْدَ الموتِ."]],"26":[[3,3,"حِسَابَهُم","جَزاءَهُم."]]}