{"1":[[0,0,"وَيۡلٌ","شَرٌّ وهَلاكٌ."],[1,2,"لِّكُلِّ هُمَزَةٍ","لِكُلِّ مُغْتابٍ للنّاسِ."],[3,3,"لُّمَزَةٍ","طَعّانٍ فِيهِم."]],"2":[[1,3,"جَمَعَ مَالًا وَعَدَّدَهُۥ","كانَ همُّه جَمْعَ المالِ وتَعْدادَهُ."]],"3":[[3,3,"أَخۡلَدَهُۥ","جَعَلَه خالِدًا في الدُّنيا."]],"4":[[1,1,"لَيُنۢبَذَنَّ","ليُطْرَحَنَّ."],[2,3,"فِي ٱلۡحُطَمَةِ","في النّارِ الَّتِي تُحَطِّم كُلَّ ما يُلْقى فِيها."]],"5":[[0,1,"وَمَآ أَدۡرَىٰكَ","وأيُّ شيءٍ أعْلَمَكَ؟"]],"6":[[2,2,"ٱلۡمُوقَدَةُ","المسْتَعِرَةُ الَّتِي لا يزُولُ لَهِيبُها."]],"7":[[1,3,"تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","من شِدَّتِها تَنفُذُ مِنَ الأجْسام إلى القُلُوبِ."]],"8":[[2,2,"مُّؤۡصَدَةٌ","مُغْلَقةٌ غَلْقًا مُطْبِقًا."]],"9":[[0,1,"فِي عَمَدٍ","مَوْثُوقِينَ في سَلاسِلَ وأغلالٍ."],[2,2,"مُّمَدَّدَةِۭ","مُطَوَّلَةٍ؛ لئلّا يَخرُجُوا مِنها."]]}