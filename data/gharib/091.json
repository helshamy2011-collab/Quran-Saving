{"1":[[1,1,"وَضُحَىٰهَا","أقْسَمَ اللهُ بإشْراقِ الشَّمْسِ ضُحىً."]],"2":[[2,2,"تَلَىٰهَا","تَبِعَها في الطُّلُوعِ والأُفُول."]],"3":[[2,2,"جَلَّىٰهَا","جَلّى الظُّلْمةَ وكَشَفَها."]],"4":[[2,2,"يَغۡشَىٰهَا","يُغَطِّي الأَرْضَ فيكُونُ ما عَلَيها مُظْلِمًا."]],"5":[[1,2,"وَمَا بَنَىٰهَا","وبِنائِها المُحْكَمِ."]],"6":[[1,2,"وَمَا طَحَىٰهَا","وبَسْطِها."]],"7":[[1,2,"وَمَا سَوَّىٰهَا","وإكْمالِ اللهِ خَلْقَها لأداءِ مُهِمَّتِها."]],"8":[[0,0,"فَأَلۡهَمَهَا","فَبيَّنَ لَها."],[1,1,"فُجُورَهَا","طَرِيقَ الشَّرِّ."],[2,2,"وَتَقۡوَىٰهَا","وطَرِيقَ الخيرِ."]],"9":[[1,1,"أَفۡلَحَ","فاز."],[3,3,"زَكَّىٰهَا","طَهَّرَها، ونَمّاها بالخيرِ."]],"10":[[1,1,"خَابَ","خَسِرَ."],[3,3,"دَسَّىٰهَا","أخْفى نَفْسَهُ في المعاصِي."]],"11":[[2,2,"بِطَغۡوَىٰهَآ","بِبُلُوغِها الغايةَ في العِصْيانِ."]],"12":[[1,1,"ٱنۢبَعَثَ","نَهَضَ لِعَقْرِ النّاقةِ."],[2,2,"أَشۡقَىٰهَا","أكْثَرُ القبيلةِ شَقاوَةً."]],"13":[[4,5,"نَاقَةَ ٱللَّهِ","احْذَرُوا أن تَمَسُّوا النّاقَةَ بسُوءٍ."],[6,6,"وَسُقۡيَـٰهَا","واحذَرُوا أن تَعْتَدُوا على سَقْيِها."]],"14":[[1,1,"فَعَقَرُوهَا","فَنَحَرُوها."],[2,3,"فَدَمۡدَمَ عَلَيۡهِمۡ","فَأَطْبَقَ عليهِم العُقُوبةَ."],[6,6,"فَسَوَّىٰهَا","فَجَعَلَها عَلَيهِم على السَّواءِ، فلم يُفْلِتْ مِنهُم أحَدٌ."]],"15":[[2,2,"عُقۡبَـٰهَا","تَبِعةَ ما أنزَلَهُ بِهِم مِنَ العِقابِ."]]}