{"2":[[2,3,"مِّن ذِكۡرٍ","أي: مِن قُرْآنٍ."],[6,6,"مُّحۡدَثٍ","أي: يَتَجَدَّدُ نُزُولُه."]],"3":[[0,0,"لَاهِيَةً","غافِلةً."],[2,3,"وَأَسَرُّواْ ٱلنَّجۡوَى","اجْتَمَعُوا سِرًّا على أمْرٍ خَفِيٍّ."],[12,12,"ٱلسِّحۡرَ","القرآنَ (على زَعْمِ الكُفّار)."]],"5":[[2,3,"أَضۡغَـٰثُ أَحۡلَـٰمِۭ","أخْلاطُ أحْلامٍ لا حقيقةَ لها."],[4,5,"بَلِ ٱفۡتَرَىٰهُ","بَلِ اخْتَلَقَه."]],"7":[[3,4,"إِلَّا رِجَالًا","أي: مِنَ البَشَرِ فقط."],[8,9,"أَهۡلَ ٱلذِّكۡرِ","أهْلَ العِلْمِ بالكُتُبِ الُمنَزَّلةِ السّابقَةِ."]],"9":[[7,7,"ٱلۡمُسۡرِفِينَ","الُمتَجاوِزِينَ الحَدَّ بِكُفْرِهم بِرَبِّهم."]],"10":[[5,5,"ذِكۡرُكُمۡ","عِزُّكُم وشَرَفُكم إنْ عَمِلْتُم بما جاءَ فيه."]],"11":[[1,1,"قَصَمۡنَا","أهْلَكْنا واسَتْأصَلْنا."],[4,5,"كَانَتۡ ظَالِمَةً","كانَ أهلُها ظالِميَنَ بِكُفْرِهم باللهِ وبِما جاءتْهم به رُسُلُه."],[6,6,"وَأَنشَأۡنَا","خَلَقْنا وأَوْجَدْنا."]],"12":[[1,2,"أَحَسُّواْ بَأۡسَنَآ","أي: عَلِمُوا وتيَقَّنُوا بِوُقُوعِ عَذابِنا بِمُشاهَدَةِ بَوادِرِه."],[6,6,"يَرۡكُضُونَ","يَهرُبُون مُسرِعِينَ."]],"13":[[0,1,"لَا تَرۡكُضُواْ","لا تَهرُبُوا."],[5,6,"أُتۡرِفۡتُمۡ فِيهِ","أُنْعِمْتُم فِيه مِنَ التَّرفِ."],[8,9,"لَعَلَّكُمۡ تُسۡـَٔلُونَ","لَعَلَّكُم تُسْأَلُونَ مِن دُنْياكُم شَيْئًا، قِيلَ لَهُم ذَلك اسْتِهْزاءً بِهِم."]],"14":[[1,1,"يَـٰوَيۡلَنَآ","يا هَلاكَنا."]],"15":[[2,3,"تِّلۡكَ دَعۡوَىٰهُمۡ","أي: كلِمتَهم: «يا ويلَنا» يَدْعُونَ بها، ويُرَدِّدُونَها."],[6,6,"حَصِيدًا","مُسْتَأْصَلِينَ كما يُحصَدُ الزَّرْعُ."],[7,7,"خَـٰمِدِينَ","هالِكِينَ، قدِ انْطَفَأَتْ شَرارَةُ حَياتِهمِ."]],"16":[[6,6,"لَـٰعِبِينَ","عَبَثًا ولَهْوًا وباطِلًا."]],"17":[[4,4,"لَهۡوًا","ما يُتلهّى بِه مِن زَوْجَةٍ ووَلَدٍ."],[6,7,"مِن لَّدُنَّآ","مِن عِنْدِنا مِنَ أهْل السَّماءِ مِنَ الحُورِ العِينِ."]],"18":[[0,1,"بَلۡ نَقۡذِفُ","بل نَرْمِي."],[5,5,"فَيَدۡمَغُهُۥ","فيَمْحَقُه ويَدْحَضُه."],[8,8,"زَاهِقٌ","زائِلٌ وذاهِبٌ."],[10,10,"ٱلۡوَيۡلُ","العَذابُ."]],"19":[[7,10,"لَا يَسۡتَكۡبِرُونَ عَنۡ عِبَادَتِهِۦ","لا يَتَعاظَمُونَ عَن عِبادتِه."],[11,12,"وَلَا يَسۡتَحۡسِرُونَ","لا يُصِيبُهُم إعياءٌ ولا مَلَلٌ مِن عِبادَةِ اللهِ."]],"20":[[3,4,"لَا يَفۡتُرُونَ","لا يَضْعُفُونَ ولا يَسْأمُونَ."]],"21":[[0,6,"أَمِ ٱتَّخَذُوٓاْ ءَالِهَةً مِّنَ ٱلۡأَرۡضِ هُمۡ يُنشِرُونَ","هَلِ اتَّخَذَ المُشْرِكُونَ آلهةً مِنَ الأرْضِ قادِرَةً على إحْياءِ المَوتى؟"]],"22":[[6,6,"لَفَسَدَتَا","لبَطَلَتا، واخْتَلَّ نِظامُهما."],[7,8,"فَسُبۡحَـٰنَ ٱللَّهِ","تَنَزَّهَ اللهُ تعالى."],[11,12,"عَمَّا يَصِفُونَ","عَمّا يَصِفُه الكافِرونَ مِنِ ادِّعاءِ شَريكٍ لَه."]],"24":[[0,1,"أَمِ ٱتَّخَذُواْ","بَلِ اتَّخَذُوا."],[6,7,"هَاتُواْ بُرۡهَـٰنَكُمۡ","ايتُوا بِحُجَّتِكُم على اتِّخاذِكُم الآلِهَةَ المزْعُومةَ."],[9,11,"ذِكۡرُ مَن مَّعِيَ","القرآنُ الذي جِئْتُ به."],[12,14,"وَذِكۡرُ مَن قَبۡلِي","أي: الكُتُبُ السّابِقَةُ."]],"26":[[1,3,"ٱتَّخَذَ ٱلرَّحۡمَـٰنُ وَلَدًا","أي: بزَعْمِهِم أنّ الملائِكةَ بناتُ اللهِ."],[4,4,"سُبۡحَـٰنَهُۥ","تَنَزَّهَ اللهُ عَنْ ذَلِكَ."],[7,7,"مُّكۡرَمُونَ","أكْرَمَهُم الله بِعِبادَتِه وخَصَّصَهم بالفَضائِلِ."]],"27":[[0,2,"لَا يَسۡبِقُونَهُۥ بِٱلۡقَوۡلِ","أي: لا يَتَكَلَّمُونَ إلّا بما يْأمُرُهم بِه ربُّهم؛ لِكَمالِ انْقِيادِهم وطاعَتِهم."]],"28":[[0,3,"يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ","يَعلَمُ كلَّ ما عَمِلُوه."],[4,5,"وَمَا خَلۡفَهُمۡ","وما هم عامِلُونَ في الُمسْتَقْبَل."],[8,10,"إِلَّا لِمَنِ ٱرۡتَضَىٰ","أي: إلا لِمَن رَضِيَ اللهُ بشَفاعَتِهم لَهُ."],[14,14,"مُشۡفِقُونَ","حَذِرونَ أن يَعْصُوه."]],"30":[[8,8,"رَتۡقًا","مُلْتَصِقَتَينِ لا فاصِلَ بَيْنَهما."],[9,9,"فَفَتَقۡنَـٰهُمَا","ففَصَلْناهُما بِقُدرَتِنا."]],"31":[[3,3,"رَوَٰسِيَ","جبالًا ثَوابِتَ."],[4,6,"أَن تَمِيدَ بِهِمۡ","لِئلا تَتَحَرَّكَ الأرضُ وتَضطَرِبَ بِأهْلِها."],[9,10,"فِجَاجًا سُبُلًا","طُرُقًا واسِعةً."]],"32":[[2,2,"سَقۡفًا","أي: سَقْفًا لِلأَرْضِ."],[3,3,"مَّحۡفُوظًا","أي: عَنِ السُّقوطِ، وعَنِ اخْتِراقِ الشَّياطِينِ."]],"33":[[7,7,"كُلٌّ","أي: كلٌّ مِنَ الشَّمسِ والقَمَرِ والنُّجُومِ."],[9,9,"فَلَكٍ","مَدارٍ."],[10,10,"يَسۡبَحُونَ","يدُورُونَ بانْبِساطٍ وسُهُولةٍ."]],"34":[[5,5,"ٱلۡخُلۡدَ","دَوامَ البقاءِ في الدُّنيا."]],"35":[[4,4,"وَنَبۡلُوكُم","نَخْتَبِرُكُم ونَبْتَلِيكُم."],[7,7,"فِتۡنَةً","اخْتِبارًا وابْتِلاءً."]],"36":[[7,7,"هُزُوًا","مُسْتَهْزَأً بِك."],[10,11,"يَذۡكُرُ ءَالِهَتَكُمۡ","يَعِيبُ آلهتَكُم."]],"37":[[0,3,"خُلِقَ ٱلۡإِنسَـٰنُ مِنۡ عَجَلٍ","خُلِقَ الإنسانُ عَجُولًا مُتَسَرِّعًا بِفِطْرَتِه."],[4,5,"سَأُوْرِيكُمۡ ءَايَـٰتِي","أي: بنَصْرِ هذا الدِّينِ وهَلاكِ مَن كَفَرَ به وحارَبَه."]],"38":[[3,3,"ٱلۡوَعۡدُ","أي: الوعدُ بالعذابِ."]],"39":[[5,6,"لَا يَكُفُّونَ","لا يَقْدِرُونَ أن يَمْنَعُوا."]],"40":[[2,2,"بَغۡتَةً","فَجْأَةً."],[3,3,"فَتَبۡهَتُهُمۡ","فتُحَيِّرُهم."],[7,9,"وَلَا هُمۡ يُنظَرُونَ","ولا هم يُؤخَّرُونَ، ولا هم يُمهَلُونَ لتوبَةٍ أو اعْتِذارٍ."]],"41":[[5,5,"فَحَاقَ","نَزَلَ وأَحاطَ."],[7,8,"سَخِرُواْ مِنۡهُم","اسْتَهْزَؤُوا بهم."]],"42":[[2,2,"يَكۡلَؤُكُم","يَحْفَظُكُم ويَحْرُسُكُم."],[5,6,"مِنَ ٱلرَّحۡمَـٰنِ","أي: مِن عَذابِه وعِقابِه إذا حَلَّ بِكُم."],[10,11,"ذِكۡرِ رَبِّهِم","أي: القرآنِ وما فيه مِن مَّواعِظَ."]],"43":[[10,13,"وَلَا هُم مِّنَّا يُصۡحَبُونَ","أي: ولا هم يُجارُون مِن عَذابِنا."]],"44":[[0,1,"بَلۡ مَتَّعۡنَا","بل أمهَلْناهُم؛ لِيَتَمَتَّعُوا."],[13,15,"نَنقُصُهَا مِنۡ أَطۡرَافِهَآ","أي: نَنْقُصُ أرضَ الكفّارِ بالظُّهُورِ والغَلَبَةِ عليها مِن كُلِّ ناحيةٍ وجِهَةٍ، فنَفْتحُها بلَدًا بعد بلَدٍ."],[16,17,"أَفَهُمُ ٱلۡغَـٰلِبُونَ","أي: كيف يكونُون غالِبينَ بعد نَقْصِنا لأَرْضِهم مِن أطْرافِها؟"]],"45":[[2,2,"أُنذِرُكُم","أُخَوِّفُكُم."],[3,3,"بِٱلۡوَحۡيِ","بالقرآنِ."],[6,6,"ٱلصُّمُّ","جمعُ الأصَمّ، وهو الذي لا يَسْمَعُ، والمرادُ الكافرُ الذي لا يُصْغِي لِلْحَقِّ."],[7,7,"ٱلدُّعَآءَ","النِّداءَ."]],"46":[[1,1,"مَّسَّتۡهُمۡ","أصابَتْهُم."],[2,2,"نَفۡحَةٌ","دُفْعَةٌ يسيرةٌ."],[7,7,"يَـٰوَيۡلَنَآ","يا هلاكَنا."]],"47":[[1,2,"ٱلۡمَوَٰزِينَ ٱلۡقِسۡطَ","المَوازِينَ العادلةَ."],[3,4,"لِيَوۡمِ ٱلۡقِيَـٰمَةِ","لِأهْلِ يومِ القيامةِ."],[11,12,"مِثۡقَالَ حَبَّةٍ","وزنَ حَبَّة"],[14,14,"خَرۡدَلٍ","وهو أصغرُ الحُبوبِ، والمرادُ أصْغرُ شَيءٍ."]],"48":[[4,4,"ٱلۡفُرۡقَانَ","المُعْجِزاتِ التي يُمَيَّزُ بها الحقُّ عنِ الباطِلِ."],[5,5,"وَضِيَآءً","أي: التَّوْراةَ التي أضاءتْ لهم أمرَ دينِهِم."],[6,6,"وَذِكۡرًا","يَتَذَكَّرُونَ بما في التَّوراةِ من المواعظِ."]],"49":[[1,2,"يَخۡشَوۡنَ رَبَّهُم","يخافُونَ عذابَه."],[3,3,"بِٱلۡغَيۡبِ","في حالِ غيابِهم عَنْ أعْيُنِ النّاسِ."],[7,7,"مُشۡفِقُونَ","خائِفُونَ."]],"50":[[0,1,"وَهَـٰذَا ذِكۡرٌ","وهذا القرآنُ موعظَة لِمَن اتَّعَظَ به."]],"51":[[3,3,"رُشۡدَهُۥ","هُداه اللائقَ به."],[4,5,"مِن قَبۡلُ","مِن قَبْلِ مُوسى وهارُونَ."]],"52":[[6,6,"ٱلتَّمَاثِيلُ","الأصنامُ التي صَنَعْتُمُوها بِأَيْدِيكُم."],[9,10,"لَهَا عَـٰكِفُونَ","مُقِيمُونَ على عِبادَتِها على الدَّوامِ."]],"54":[[6,7,"ضَلَـٰلٍ مُّبِينٍ","خُسْرانٍ واضِحٍ."]],"55":[[2,2,"بِٱلۡحَقِّ","أي: أجادٌّ أنت فيما تَقُولُ؟"],[6,6,"ٱللَّـٰعِبِينَ","مِن الهازِلِينَ."]],"56":[[7,7,"فَطَرَهُنَّ","خَلَقَهُنَّ."]],"57":[[1,2,"لَأَكِيدَنَّ أَصۡنَـٰمَكُم","لَأَمْكُرَنَّ بأصنامِكُم ولَأَكْسِرَنَّها."]],"58":[[1,1,"جُذَٰذًا","حُطامًا قِطَعًا مُكسَّرةً."]],"60":[[3,3,"يَذۡكُرُهُمۡ","يَعِيبُهم."]],"61":[[3,5,"عَلَىٰٓ أَعۡيُنِ ٱلنَّاسِ","ظاهرًا بِمَرْأىً مِنَ النّاسِ."],[7,7,"يَشۡهَدُونَ","أي: يَشْهَدُونَ عليه أنّه يَذْكُرُهم بِسُوءٍ."]],"65":[[1,3,"نُكِسُواْ عَلَىٰ رُءُوسِهِمۡ","أي: لمّا غُلِبوا في الحُجَّةِ غَيَّروا رأيَهم."]],"67":[[0,1,"أُفٍّ لَّكُمۡ","قُبْحًا لكم."]],"70":[[2,2,"كَيۡدًا","مَكْرًا لهلاكِه."]],"71":[[2,3,"إِلَى ٱلۡأَرۡضِ","هي أرضُ «الشّام»."],[5,6,"بَـٰرَكۡنَا فِيهَا","أي: بِكَثْرَةِ الخيراتِ، وبِكَوْنِها أرْضَ الأنبياءِ عليهمُ الصَّلاةُ والسَّلامُ."]],"72":[[3,4,"وَيَعۡقُوبَ نَافِلَةً","زِيادةً عمّا طَلَبَ إبراهيمُ عليه الصَّلاةُ والسَّلامُ."]],"74":[[2,2,"حُكۡمًا","نُبُوَّةً وفَصْلَ القَضاءِ بينَ الخُصُومِ."],[6,6,"ٱلۡقَرۡيَةِ","هي قريةُ «سَدُوم»."],[10,10,"ٱلۡخَبَـٰٓئِثَ","هي أفعالُهم الُمنْكَرَةُ من إتيانِهم الرِّجالَ، وقَطْعِ السبيلِ وغيرِ ذلك."],[13,14,"قَوۡمَ سَوۡءٍ","قومًا عُرِفُوا بالأعمالِ القبيحةِ."],[15,15,"فَـٰسِقِينَ","خارجِينَ عَن طاعةِ اللهِ."]],"75":[[1,2,"فِي رَحۡمَتِنَآ","أي: في أهلِ رحمتِنا، وهم الأنبياءُ عليهمُ الصَّلاةُ والسَّلامُ."]],"76":[[3,4,"مِن قَبۡلُ","أي: مِن قَبْلِ إبراهيمَ ولوطٍ عليهما الصَّلاةُ والسَّلامُ."],[10,10,"ٱلۡكَرۡبِ","أي: الغَرَقِ بالطُّوفانِ."]],"77":[[5,5,"بِـَٔايَـٰتِنَآ","بِحُجَجِنا الدالَّةِ على صِدْقِه."],[8,9,"قَوۡمَ سَوۡءٍ","قَومًا عُرِفُوا بالسُّوءِ والقُبْحِ."],[10,10,"فَأَغۡرَقۡنَـٰهُمۡ","أي: بالطُّوفانِ الذي حَلَّ بهم."]],"78":[[4,5,"فِي ٱلۡحَرۡثِ","أي: في قَضِيَّةِ الحَرْثِ."],[7,8,"نَفَشَتۡ فِيهِ","انْتَشَرَتْ في الحَرْثِ ليلًا مِن غَيرِ راعٍ."]],"79":[[0,1,"فَفَهَّمۡنَـٰهَا سُلَيۡمَـٰنَ","ففَهَّمنا سُليمانَ المسْأَلةَ بِمُراعاةِ مَصْلَحَةِ الطرفَينِ بالعَدْلِ."],[4,5,"حُكۡمًا وَعِلۡمًا","نُبُوَّةً وعِلْمًا بأحْكامِ اللهِ."],[6,6,"وَسَخَّرۡنَا","طَوَّعْنا."]],"80":[[1,2,"صَنۡعَةَ لَبُوسٍ","صِناعةَ دُروعٍ تُلبَسُ في الحربِ."],[4,4,"لِتُحۡصِنَكُم","لِتَحْمِيَكم وتحفظَكُم."],[5,6,"مِّنۢ بَأۡسِكُمۡ","مِن حَرْبِكُم."]],"81":[[2,2,"عَاصِفَةً","شديدةَ الهَبُوب."],[5,6,"إِلَى ٱلۡأَرۡضِ","أي: أرْضِ بيتِ المقْدِسِ بالشّامِ."]],"82":[[3,4,"يَغُوصُونَ لَهُۥ","يَنْزِلُونَ له في البحرِ لاسْتِخْراجِ ما يُطْلَبُ."],[11,11,"حَـٰفِظِينَ","أي: حفِظَهمُ اللهُ من أنْ يَنْفَلِتُوا عَنْ سُليمانَ ومِن أنْ يُفْسِدُوا أعْمالَهم."]],"83":[[5,6,"مَسَّنِيَ ٱلضُّرُّ","أصابَنِي الضُّرُّ مِن مَّرَضٍ ونَحْوِه."]],"84":[[2,6,"فَكَشَفۡنَا مَا بِهِۦ مِن ضُرٍّ","فَرَفَعْنا عَنْه مَرَضَهُ بِشِفائِنا إيِّاهُ."],[14,14,"وَذِكۡرَىٰ","تَذْكِرَةً."]],"87":[[0,1,"وَذَا ٱلنُّونِ","أي: واذْكُرْ صاحِبَ الحُوتِ، وذو النُّون لَقَبُ نَبِيِّ اللهِ يُونُسَ عليه الصَّلاةُ والسَّلامُ لابْتِلاعِ الحُوتِ لَه."],[4,4,"مُغَـٰضِبًا","غَضْبانَ على قَومِه؛ لِكُفْرِهم."],[6,9,"أَن لَّن نَّقۡدِرَ عَلَيۡهِ","أن لَن نُّضَيِّقَ عليه، ولَن نُّؤاخِذَه بِخُروجِه مِن بَيْنِ قومِه."],[12,12,"ٱلظُّلُمَـٰتِ","هي ظُلْمَةُ الليلِ، وظُلْمَةُ البحرِ، وظُلْمَةُ بَطْنِ الحُوتِ."]],"88":[[2,4,"وَنَجَّيۡنَـٰهُ مِنَ ٱلۡغَمِّ","وخَلَّصْناه مِن غَمِّهِ بإخْراجِنا له مِن بَطْنِ الحُوتِ."]],"89":[[5,7,"لَا تَذَرۡنِي فَرۡدًا","لا تَتْرُكْنِي وحِيدًا لا عَقِبَ لي."]],"90":[[5,7,"وَأَصۡلَحۡنَا لَهُۥ زَوۡجَهُۥٓ","أي: جَعَلْناها صالحةً في أخْلاقِها وصالحةً للحَمْلِ والولادةِ."],[13,14,"وَيَدۡعُونَنَا رَغَبًا","يَعْبُدُونَنا راغِبينَ فيما عِنْدَنا."],[15,15,"وَرَهَبًا","خائِفِينَ من عُقُوبَتِنا."],[18,18,"خَـٰشِعِينَ","مُتَواضِعِينَ مُتَذَلِّلينَ."]],"91":[[1,2,"أَحۡصَنَتۡ فَرۡجَهَا","حَفِظَتْ فَرْجَها مِنَ الحَلالِ والحَرام ولْم يَمَسَّها بَشَرٌ."],[3,6,"فَنَفَخۡنَا فِيهَا مِن رُّوحِنَا","أي: أمَرْنا جبريلَ حتّى نَفَخَ في جَيْبِ قميصِها، فَخَلقَ اللهُ بذلكَ النَّفْخِ عيسى عليه السلام في بَطْنِها."],[9,10,"ءَايَةً لِّلۡعَـٰلَمِينَ","علامةً للخلْقِ على قُدْرِة اللهِ تعالى."]],"92":[[2,2,"أُمَّتُكُمۡ","أي: الأنبياءُ عليهمُ الصَّلاةُ والسَّلامُ."],[3,4,"أُمَّةً وَٰحِدَةً","أي: دينُهم واحدٌ، وهو الإسلامُ."]],"93":[[0,1,"وَتَقَطَّعُوٓاْ أَمۡرَهُم","تَفَرَّقُوا في أمْرِ دِينِهم فِرَقًا."]],"94":[[6,8,"فَلَا كُفۡرَانَ لِسَعۡيِهِۦ","لا جُحَودَ لِعَمَلِه بل يُشْكَرُ سَعْيُه ويُثابُ عليه."]],"95":[[0,0,"وَحَرَٰمٌ","واجِبٌ."]],"96":[[2,4,"فُتِحَتۡ يَأۡجُوجُ وَمَأۡجُوجُ","أي: يُفْتَحُ السَّدُّ عنهما فينطَلِقُونَ."],[8,8,"حَدَبٍ","مَكانٍ مُرْتَفعٍ مِنَ الأَرْضِ."],[9,9,"يَنسِلُونَ","يَتَفَّرقُونَ في الأَرْضِ مُسْرِعِينَ."]],"97":[[1,2,"ٱلۡوَعۡدُ ٱلۡحَقُّ","يومُ القيامةِ."],[5,5,"شَـٰخِصَةٌ","مَفْتُوحَةٌ أجْفانُهم لا تَطْرِفُ."],[14,15,"مِّنۡ هَـٰذَا","أي: يومِ البعثِ والحسابِ."]],"98":[[6,6,"حَصَبُ","حَطَبُ."],[10,10,"وَٰرِدُونَ","داخِلُونَ."]],"100":[[2,2,"زَفِيرٌ","أنينُ تَنَفُّسِهم الشَّدِيدُ."],[5,6,"لَا يَسۡمَعُونَ","مِن هَولِ عَذابِهم."]],"101":[[5,5,"ٱلۡحُسۡنَىٰٓ","السَّعادَةُ بِدُخُولِ الجنَّة."],[7,7,"عَنۡهَا","أي: عَن نّارِ جَهَنَّمَ."]],"102":[[2,2,"حَسِيسَهَا","أي: صَوْتَ لَهِيبِها."]],"103":[[0,1,"لَا يَحۡزُنُهُمُ","لا يُخِيفُهم."],[2,3,"ٱلۡفَزَعُ ٱلۡأَكۡبَرُ","الهولُ العظيمُ يومَ القيامةِ."],[4,4,"تَتَلَقَّىٰهُمُ","تَسْتَقْبِلُهم مُهَنِّئين."]],"104":[[1,2,"نَطۡوِي ٱلسَّمَآءَ","أي: نَطْويها كما يَطْوي الكاتِبُ الوَرَقَةَ التي يَكْتُبُ فيها."],[4,4,"ٱلسِّجِلِّ","الصَّحِيفَةِ، الورقةِ التي يُكتبُ فيها."],[5,5,"لِلۡكُتُبِ","هي ما دُوِّن في الصَّحيفة وكُتِب فيها."],[6,10,"كَمَا بَدَأۡنَآ أَوَّلَ خَلۡقٍ نُّعِيدُهُۥ","أي: نُعيدُ الخَلْقَ حُفاةً عُراةً غُرْلًا يومَ القيامةِ، كما بَدَأْناهم أوَّلَ مرَّةٍ في بُطُونِ أمَّهاتِهم."]],"105":[[3,3,"ٱلزَّبُورِ","كِتابِ داودَ عليه الصلاةُ والسلامُ، أو الكُتُبِ المنزَّلَةِ."],[4,6,"مِنۢ بَعۡدِ ٱلذِّكۡرِ","أي: مِن بَعْدِ الكِتابةِ في الذِّكْرِ، وهو التَّوراةُ، أو اللَّوحُ الَمحْفُوظُ."]],"106":[[0,2,"إِنَّ فِي هَـٰذَا","أي: في هذا المَتْلُوِّ."],[3,3,"لَبَلَـٰغًا","وُصُولًا إلى البُغْيةِ."]],"108":[[10,10,"مُّسۡلِمُونَ","مُسْتَسْلِمُونَ مُنْقادُونَ للهِ تعالى."]],"109":[[0,1,"فَإِن تَوَلَّوۡاْ","فَإنْ أعْرَضُوا عَنِ الإسْلامِ."],[3,3,"ءَاذَنتُكُمۡ","أعْلَمْتُكُم مِن أنَّ بَعْضَكُم لِبَعْضٍ حَرْبٌ، لا صُلْحَ بَيْنَكُم ولا سِلْمَ."],[4,5,"عَلَىٰ سَوَآءٍ","فأنا وأنتم مُسْتَوُونَ في العِلْمِ."],[6,7,"وَإِنۡ أَدۡرِيٓ","لا أدْرِي."]],"111":[[2,4,"لَعَلَّهُۥ فِتۡنَةٌ لَّكُمۡ","أي: لعلَّ الإمهالَ اختبارٌ لَكُمَ."]],"112":[[0,3,"قَـٰلَ رَبِّ ٱحۡكُم بِٱلۡحَقِّ","أي: افصِلْ بَيْنِيَ وبْيَنَ قومِي بِما هُو الحقُّ عِنْدَكَ."]]}