{"1":[[0,0,"حمٓ","سَبقَ الكلامُ على الحروف المقطَّعة أولَ سورة البقرة."]],"4":[[2,3,"وَمَا يَبُثُّ","وما يَنْشُرُ ويُفَرِّقُ."],[5,5,"دَآبَّةٍ","ما يَدِبُّ عَلى الأرضِ غَيرَ الإنْسانِ."],[8,8,"يُوقِنُونَ","يَعْلَمُونَ حَقائِقَ الأَشْياءِ، فيُقِرُّونَ بِها."]],"5":[[0,2,"وَٱخۡتِلَـٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ","تَعاقُبِهِما، أو تَفاوَتِهِما بالطُّولِ والقِصَرِ والظُّلْمَةِ والضِّياءِ."],[9,9,"رِّزۡقٍ","مَطَرٍ يَكُونُ مِنهُ القُوتُ."],[15,16,"وَتَصۡرِيفِ ٱلرِّيَـٰحِ","تَبْدِيلِ اللهِ سبحانه وتعالى للرِّياحِ صُعُودًا ونُزُولًا، واخْتلِافِ جِهاتِ هُبُوبِها."]],"7":[[0,0,"وَيۡلٌ","هَلاكٌ شَدِيدٌ."],[2,2,"أَفَّاكٍ","كَذّابٍ."],[3,3,"أَثِيمٍ","كَثِيرِ الآثامِ."]],"9":[[6,6,"هُزُوًا","مَوْضِعَ سُخْرِيةٍ واسْتِخْفافٍ."]],"10":[[0,1,"مِّن وَرَآئِهِمۡ","من أمامِهم."],[3,5,"وَلَا يُغۡنِي عَنۡهُم","ولا يَنْفَعُهُم."],[15,15,"أَوۡلِيَآءَ","نُصَراءَ."]],"11":[[9,9,"رِّجۡزٍ","أسْوأِ العَذابِ."]],"12":[[6,6,"ٱلۡفُلۡكُ","السُّفُنُ."]],"14":[[3,3,"يَغۡفِرُواْ","يَعْفُوا ويَتجاوَزُوا."],[5,6,"لَا يَرۡجُونَ","لا يَخافُونَ."],[7,8,"أَيَّامَ ٱللَّهِ","بأسَهُ ووَقائِعَه ونِقَمَهُ."]],"15":[[6,6,"فَعَلَيۡهَا","فَعَلى نَفْسِهِ جَنى."]],"16":[[4,4,"ٱلۡكِتَـٰبَ","التَّوْراةَ والإنْجِيلَ."],[5,5,"وَٱلۡحُكۡمَ","الفَهْمَ للكِتابِ والعِلْمَ بِالسُّنَنِ الَّتي لم تَنْزِلْ في الكِتابِ."],[12,12,"ٱلۡعَـٰلَمِينَ","عالمَي أهلِ زَمانِهِم."]],"17":[[1,1,"بَيِّنَـٰتٍ","دَلالاتٍ تُبَيِّنُ الحقَّ مِنَ الباطِلِ."],[11,11,"ٱلۡعِلۡمُ","الكتابُ والنُّبُوَّةُ والدَّلائِلُ الواضِحَةُ الَّتِي تُفَرِّقُ بين الحقِّ والباطِلِ."],[12,12,"بَغۡيَۢا","ظُلْمًا وحَسَدًا."]],"18":[[3,3,"شَرِيعَةٍ","مِنهاجٍ واضِحٍ."],[4,5,"مِّنَ ٱلۡأَمۡرِ","مِن أمْرِ الدِّينِ."],[9,9,"أَهۡوَآءَ","ما تَمِيلُ نُفُوسُهُم إلَيهِ مِمّا يُخالِفُ شَرْعَ اللهِ."]],"19":[[2,2,"يُغۡنُواْ","يَدْفَعُوا."]],"20":[[1,1,"بَصَـٰٓئِرُ","جَمْعُ بصِيرةِ، وهي الحُجَّةُ فِيما يحتاجُونَ إليهِ مِنَ الأحْكامِ."]],"21":[[3,3,"ٱجۡتَرَحُواْ","اكْتَسَبُوا."],[11,13,"سَوَآءً مَّحۡيَاهُمۡ وَمَمَاتُهُمۡ","مُسْتَويةً حالةُ حياتِهِم وحالاتُ موتِهِم."]],"23":[[9,11,"وَخَتَمَ عَلَىٰ سَمۡعِهِۦ","وطَبَع عَلى سَمْعِهَ، فَلا يَسْمَعُ مَواعِظَ اللهِ."],[16,16,"غِشَـٰوَةً","غِطاءً فَلا يَنْتَفِعُ بِبَصَرِهِ."]],"24":[[11,11,"ٱلدَّهۡرُ","مُرورُ السِّنينَ والأَيّامِ."],[16,16,"عِلۡمٍ","يَقِينٍ بَلْ يَقُولُونَ ذَلكَ تَخَرُّصًا."]],"27":[[9,9,"ٱلۡمُبۡطِلُونَ","الَّذِينَ أبْطَلُوا في دَعْواهُم للهِ شَرِيكًا."]],"28":[[3,3,"جَاثِيَةً","بارِكَةً عَلى الرُّكَبِ مُسْتَوفِزَةً."],[8,8,"كِتَـٰبِهَا","كِتابِ أعْمالِها."]],"29":[[1,1,"كِتَـٰبُنَا","كِتابُ أعْمالِكُم الَّذِي دوَّنَتْهُ ملائِكَتِي."],[7,7,"نَسۡتَنسِخُ","نَأمُرُ الحَفَظَةَ أن تَكْتُبَ."]],"32":[[21,21,"بِمُسۡتَيۡقِنِينَ","بِمُتَحَقِّقِينَ."]],"33":[[0,0,"وَبَدَا","وظَهَرَ."],[5,5,"وَحَاقَ","ونَزَلَ وأَحاطَ."]],"34":[[2,2,"نَنسَىٰكُمۡ","نَتْرُكُكُم في عَذابِ جَهَنَّمَ."],[8,8,"وَمَأۡوَىٰكُمُ","ومَسْكَنُكُم."]],"35":[[5,5,"هُزُوًا","مُسْتَهْزَأً بِها."],[6,6,"وَغَرَّتۡكُمُ","وخَدَعَتْكُم."],[10,12,"لَا يُخۡرَجُونَ مِنۡهَا","أي مِنَ النّارِ."],[15,15,"يُسۡتَعۡتَبُونَ","يُرْضِيهِم أحَدٌ بِتَمْكِينِهِم مِنَ التَّوبَةِ."]],"37":[[1,1,"ٱلۡكِبۡرِيَآءُ","السُّلطانُ والعَظَمَةُ."]]}