{"1":[[0,1,"تَبَـٰرَكَ ٱلَّذِي","تَكاثَرَ خَيرُ اللهِ وبِرُّهُ عَلى جَمِيعِ خَلْقِهِ."],[2,3,"بِيَدِهِ ٱلۡمُلۡكُ","التَّصَرُّفُ في مُلْكِ الدُّنيا والآخِرَةِ."]],"2":[[4,4,"لِيَبۡلُوَكُمۡ","لِيَخْتَبِرَكُم."]],"3":[[4,4,"طِبَاقًا","مُتَناسِقَةً."],[11,11,"تَفَـٰوُتٍ","اخْتِلافٍ وتَبايُنٍ."],[12,13,"فَٱرۡجِعِ ٱلۡبَصَرَ","فَأَعِدِ النَّظَرَ."],[17,17,"فُطُورٍ","شُقُوقٍ أو صُدُوعٍ."]],"4":[[3,3,"كَرَّتَيۡنِ","مَرَّةً بَعْدَ مَرَّةٍ."],[4,4,"يَنقَلِبۡ","يَرْجِعْ."],[7,7,"خَاسِئًا","ذَلِيلًا صاغِرًا."],[9,9,"حَسِيرٌ","مُتْعَبٌ كَلِيلٌ."]],"5":[[3,3,"ٱلدُّنۡيَا","القَرِيبةَ."],[4,4,"بِمَصَـٰبِيحَ","بِنُجُومٍ عَظِيمَةٍ مُضِيئةٍ."],[6,6,"رُجُومًا","شُهُبًا مُحْرِقَةً."],[7,7,"لِّلشَّيَـٰطِينِ","لِمُسْتَرِقِي السَّمْعِ مِنَ الشَّياطِينِ."],[11,11,"ٱلسَّعِيرِ","النّارِ المُوقَدَةِ."]],"6":[[5,6,"وَبِئۡسَ ٱلۡمَصِيرُ","وساءَ المَرْجِعُ لهم جَهَنَّمُ."]],"7":[[1,1,"أُلۡقُواْ","طُرِحُوا."],[5,5,"شَهِيقًا","صَوْتًا شَدِيدًا مُنْكَرًا."],[7,7,"تَفُورُ","تَغْلِي غَلَيانًا شَدِيدًا."]],"8":[[1,1,"تَمَيَّزُ","تَتَمَزَّقُ."],[2,3,"مِنَ ٱلۡغَيۡظِ","مِن شِدَّةِ غَضَبِها عَلى الكُفّارِ."],[5,5,"أُلۡقِيَ","طُرِحِ."],[7,7,"فَوۡجٌ","جَماعةٌ مِنَ النّاسِ."],[9,9,"خَزَنَتُهَآ","الملائِكةُ المُوكَّلُونَ بأَمْرِها."],[12,12,"نَذِيرٌ","رَسُولٌ يُحَذِّرُكُم مِن هَذا العَذابِ."]],"10":[[3,3,"نَسۡمَعُ","سَماعَ مَن يَطْلُبُ الحقَّ."],[5,5,"نَعۡقِلُ","نُفَكِّرُ فِيما نُدْعى إلَيهِ."],[10,10,"ٱلسَّعِيرِ","النّارِ المُوقَدَةِ."]],"11":[[2,2,"فَسُحۡقًا","فَبُعْدًا عَن رَّحَمَةِ اللهِ."]],"12":[[4,4,"بِٱلۡغَيۡبِ","وهُمْ غائِبُونَ عَنْ أعْيُنِ النّاسِ، وقَبْلَ مُعايَنَةِ العَذابِ."],[7,7,"وَأَجۡرٌ","ثَوابٌ."]],"13":[[0,0,"أَسِرُّواْ","وأَخْفُوا."],[2,4,"أَوِ ٱجۡهَرُواْ بِهِۦٓ","أعْلِنُوهُ."],[7,8,"بِذَاتِ ٱلصُّدُورِ","بِما يَتَرَدَّدُ في النَّفْسِ مِنَ الخواطِرِ والنِّياتِ."]],"14":[[1,1,"يَعۡلَمُ","اللهُ."],[2,3,"مَنۡ خَلَقَ","المخلُوقِينَ."],[5,5,"ٱللَّطِيفُ","العالِمُ خَبايا الأُمُورِ والمُدَبِّرُ لَها بِرِفْقٍ وحِكْمَةٍ."],[6,6,"ٱلۡخَبِيرُ","العَلِيمُ بِباطِنِ أمرِهِم."]],"15":[[5,5,"ذَلُولًا","سَهْلةً مُمَهَّدَةً تَسْتَقِرُّونَ عَلَيها."],[8,8,"مَنَاكِبِهَا","نواحِيها وجَوانِبِها."],[13,13,"ٱلنُّشُورُ","البَعْثُ مِن قُبُورِكُم لِلْحِسابِ."]],"16":[[0,0,"ءَأَمِنتُم","هَلْ أمِنتُم؟"],[1,3,"مَّن فِي ٱلسَّمَآءِ","الَّذِي فَوقَ السَّماءِ."],[5,7,"يَخۡسِفَ بِكُمُ ٱلۡأَرۡضَ","يَقْلِبَ ظاهِرَ الأرضِ باطِنًا، وباطِنَها ظاهِرًا مُصاحِبةً لِذَواتِكم."],[10,10,"تَمُورُ","تَضْطَرِبُ بِكُم حَتّى تَهْلِكُوا."]],"17":[[8,8,"حَاصِبًا","رِيحًا تَرْجُمُكُم بالحِجارةِ الصَّغِيرةِ."],[11,11,"نَذِيرِ","تَحْذِيرِي لَكُم."]],"18":[[7,7,"نَكِيرِ","إنْكارِي عَلَيهِم بإنْزِالِ العَذابِ بِهِم."]],"19":[[5,5,"صَـٰٓفَّـٰتٍ","باسِطاتٍ أجْنِحَتَها عِنْدَ طَيَرانِها في الهواءِ."],[6,6,"وَيَقۡبِضۡنَ","ويَضْمُمْنَ أجْنِحَتَها."]],"20":[[0,1,"أَمَّنۡ هَـٰذَا","بَلْ مَن هَذا."],[4,5,"جُندٌ لَّكُمۡ","حِزْبٌ لَكُم."],[7,9,"مِّن دُونِ ٱلرَّحۡمَـٰنِ","مِن غَيْرِ الرَّحمنِ."],[10,10,"إِنِ","ما."],[14,14,"غُرُورٍ","خِداعٍ وضَلالٍ مِنَ الشَّيطانِ."]],"21":[[8,8,"لَّجُّواْ","اسْتَمَرُّوا في طُغْيانِهِم وكُفْرِهِم."],[10,10,"عُتُوٍّ","مُعانَدَةٍ واسْتِكْبارٍ"],[11,11,"وَنُفُورٍ","فِرارٍ مِنَ الحقِّ."]],"22":[[2,2,"مُكِبًّا","ساقِطًا عَلى وجْهِهِ."],[5,5,"أَهۡدَىٰٓ","أشَدُّ اسْتِقامةً عَلى الطَّرِيقةِ."],[8,8,"سَوِيًّا","مُسْتَوِيًا."]],"23":[[3,3,"أَنشَأَكُمۡ","أوْجَدَكُم مِن العَدَمِ."],[8,8,"وَٱلۡأَفۡـِٔدَةَ","القُلُوبَ."]],"24":[[3,3,"ذَرَأَكُمۡ","خَلَقَكُم ونَشَرَكُم."],[7,7,"تُحۡشَرُونَ","تُجْمَعُونَ لِلْحِسابِ والجَزاءِ."]],"26":[[7,7,"نَذِيرٌ","مُخَوِّفٌ."],[8,8,"مُّبِينٌ","أُبَيِّنُ لَكُمُ الشَّرائِعَ."]],"27":[[2,2,"زُلۡفَةً","قَرِيبًا مِنهُم."],[3,3,"سِيٓـَٔتۡ","ظَهَرَتْ الذِّلَّةُ والكآبةُ."],[11,12,"بِهِۦ تَدَّعُونَ","تَطْلُبُونَ تَعْجِيلَه في الدُّنيا."]],"28":[[1,1,"أَرَءَيۡتُمۡ","أخْبِرُوني."],[3,3,"أَهۡلَكَنِيَ","أماتَنِي."],[10,10,"يُجِيرُ","يَحْمِي ويَمْنَعُ."]],"29":[[3,4,"ءَامَنَّا بِهِۦ","صَدَّقْنا بِهِ وعَمِلْنا بِشَرْعِهِ."],[6,6,"تَوَكَّلۡنَا","اعْتَمَدْنا في كُلِّ أُمُورِنا."],[11,11,"ضَلَـٰلٍ","بُعْدٍ عَن صِراطِ اللهِ المُسْتَقِيمِ."]],"30":[[1,1,"أَرَءَيۡتُمۡ","أخْبِرُونِي."],[3,3,"أَصۡبَحَ","صارَ."],[5,5,"غَوۡرًا","ذاهِبًا في الأرضِ لا تصِلُونَ إلَيهِ."],[9,9,"مَّعِينِۭ","جارٍ على وجْهِ الأَرْضِ تَراهُ العُيُونُ."]]}