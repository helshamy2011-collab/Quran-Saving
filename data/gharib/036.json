{"1":[[0,0,"يسٓ","سَبَقَ الكلامُ على الحروفِ المُقَطَّعَةِ في أوَّلِ سُورةِ البقرةِ."]],"4":[[1,2,"صِرَٰطٍ مُّسۡتَقِيمٍ","طَرِيقٍ مُعْتَدِلٍ وهو الإسْلامُ."]],"7":[[1,2,"حَقَّ ٱلۡقَوۡلُ","وجَبَ القولُ أي: العذابُ."]],"8":[[4,4,"أَغۡلَـٰلًا","قُيُودًا تَشُدُّ أيدِيَهُم إلى أعناقِهِم تَحتَ أذقانِهم."],[9,9,"مُّقۡمَحُونَ","رافِعُونَ رؤوسَهم غاضُّونَ أبْصارَهُم."]],"9":[[4,4,"سَدًّا","حاجِزًا ومانِعًا."],[8,8,"فَأَغۡشَيۡنَـٰهُمۡ","غَطَّينا أبْصارَهُم."]],"11":[[10,11,"أَجۡرٍ كَرِيمٍ","أجْرٍ حَسَنٍ، وهو دخولُ الجنّةِ."]],"12":[[2,3,"نُحۡيِ ٱلۡمَوۡتَىٰ","نَبْعَثُهُم بَعْدَ الموتِ."],[7,7,"وَءَاثَـٰرَهُمۡ","أي: ما أبْقَوهُ مِنَ الحسَناتِ الَّتي لايَنْقَطِعُ نَفْعُها بَعْدَ الموتِ."],[12,13,"إِمَامٍ مُّبِينٍ","كِتابٍ واضِحٍ، وهو اللَّوحُ المحفُوظُ."]],"13":[[3,4,"أَصۡحَـٰبَ ٱلۡقَرۡيَةِ","أهْلَ القَرْيَةِ، وهي «أنْطاكِيَةُ»."]],"14":[[5,6,"فَعَزَّزۡنَا بِثَالِثٍ","أي: قوَّيناهُما بِرَسُولٍ ثالِثٍ."]],"18":[[2,3,"تَطَيَّرۡنَا بِكُمۡ","تَشاءَمْنا بِكُم."],[7,7,"لَنَرۡجُمَنَّكُمۡ","لَنَقْتُلَنَّكُم رَمْيًا بالِحجارَةِ."]],"19":[[1,2,"طَـٰٓئِرُكُم مَّعَكُمۡ","شُؤْمُكُم مَعَكُم، الذي هو كُفْرُكُم وشِرْكُكُم."]],"20":[[2,3,"أَقۡصَا ٱلۡمَدِينَةِ","مِن مَّكانٍ بَعِيدٍ فِيها."]],"22":[[4,4,"فَطَرَنِي","خَلَقَنِي."]],"23":[[13,14,"وَلَا يُنقِذُونِ","لا يُنَجُّونَنِي مِمّا أنافِيه."]],"24":[[3,4,"ضَلَـٰلٍ مُّبِينٍ","خَطَأٍ ظاهِرٍ."]],"28":[[7,7,"جُندٍ","جَيشٍ."]],"29":[[3,3,"صَيۡحَةً","صَوْتًا مُهلِكًا مِنَ السَّماءِ."],[7,7,"خَـٰمِدُونَ","مَيِّتُونَ لا حَراكَ فِيهِم."]],"30":[[10,10,"يَسۡتَهۡزِءُونَ","يَسْخَرُونَ."]],"31":[[5,6,"مِّنَ ٱلۡقُرُونِ","مِنَ الأُمَمِ الخالِيةِ."]],"32":[[5,5,"مُحۡضَرُونَ","نُحْضِرُهُم للحسابِ والجزاءِ."]],"33":[[0,1,"وَءَايَةٌ لَّهُمُ","دَلالةٌ لَهُم."],[2,3,"ٱلۡأَرۡضُ ٱلۡمَيۡتَةُ","هي الَّتي لا نَباتَ فِيها."],[4,4,"أَحۡيَيۡنَـٰهَا","أي: بإنْزالِ المطرِ عَلَيها وإخراجِ النَّباتِ منها."]],"34":[[2,2,"جَنَّـٰتٍ","بَساتِينَ."]],"36":[[3,3,"ٱلۡأَزۡوَٰجَ","الأَصْنافَ والأَنْواعَ."]],"37":[[0,1,"ءَايَةٌ لَّهُمُ","علامةٌ لَهُم."],[3,4,"نَسۡلَخُ مِنۡهُ","نَنْزِعُ مِنهُ."]],"38":[[2,3,"لِمُسۡتَقَرٍّ لَّهَا","مُسْتَقَرُّها تَحْتَ العَرْشِ، كما جاء في الحديثِ المتَّفقِ عَلَيه."]],"39":[[2,2,"مَنَازِلَ","مسافات، وهي ثمانيةٌ وعِشْرُونَ مَنزِلًا."],[5,6,"كَٱلۡعُرۡجُونِ ٱلۡقَدِيمِ","كالعِذْقِ اليابسِ المتَقَوِّسِ."]],"40":[[4,5,"أَن تُدۡرِكَ","أن تَلْحَقَ."],[13,13,"فَلَكٍ","مَدارٍ."],[14,14,"يَسۡبَحُونَ","يَدُورُونَ في فَلَكِ السَّماءِ بانْبِساطٍ وسُهُولَةٍ."]],"41":[[0,1,"ءَايَةٌ لَّهُمۡ","دليلٌ لَهُم."],[7,7,"ٱلۡمَشۡحُونِ","الممْلُوءِ."]],"43":[[4,5,"صَرِيخَ لَهُمۡ","مُغِيثَ لَهُم."],[8,8,"يُنقَذُونَ","يُخَلَّصُونَ مِنَ الغَرَقِ."]],"45":[[4,6,"مَا بَيۡنَ أَيۡدِيكُمۡ","مِنَ الآخرةِ وأهْوالِها."],[7,8,"وَمَا خَلۡفَكُمۡ","مِن أحْوالِ الدُّنيا وعِقابِها."]],"49":[[1,1,"يَنظُرُونَ","ينتظِرُونَ."],[3,4,"صَيۡحَةً وَٰحِدَةً","هي نَفْخَةُ الفَزَعِ عِنْدَ قِيامِ السّاعةِ."],[7,7,"يَخِصِّمُونَ","يَخْتَصِمُونَ في شُؤونِ حياتِهم غافِلينَ عَن يَوْمِ القيامةِ."]],"50":[[2,2,"تَوۡصِيَةً","وصِيَّةً."]],"51":[[2,2,"ٱلصُّورِ","«القَرْنِ» الذي يُنفَخُ فيه للبعث."],[6,6,"ٱلۡأَجۡدَاثِ","القُبُورِ."],[9,9,"يَنسِلُونَ","يُسْرِعُونَ في الخُرُوجِ."]],"52":[[1,1,"يَـٰوَيۡلَنَا","يا هَلاكَنا."],[2,3,"مَنۢ بَعَثَنَا","مَن أحْيانا؟"],[4,5,"مِن مَّرۡقَدِنَاۜ","مِن قُبُورِنا."]],"53":[[3,4,"صَيۡحَةً وَٰحِدَةً","نَفْخَةً واحِدَةً."],[9,9,"مُحۡضَرُونَ","نُحْضِرُهم للحِسابِ والجَزاءِ."]],"55":[[4,5,"فِي شُغُلٍ","في نَعِيمٍ عَظِيمٍ يُلْهِيهِم عمّا سِواه."],[6,6,"فَـٰكِهُونَ","مُتَلَذِّذُونَ."]],"56":[[5,5,"ٱلۡأَرَآئِكِ","الأَسِرَّةِ المزَيَّنةِ."]],"57":[[4,5,"مَّا يَدَّعُونَ","ما يَشْتَهُونَ."]],"59":[[0,0,"وَٱمۡتَـٰزُواْ","تميَّزُوا، وانفرِدُوا عَنِ المؤمِنِينَ."]],"60":[[1,2,"أَعۡهَدۡ إِلَيۡكُمۡ","أُوصِكُم وأُبَلِّغْكُم."]],"62":[[3,3,"جِبِلًّا","خَلْقًا."]],"64":[[0,0,"ٱصۡلَوۡهَا","ادخُلُوا جَهَنَّمَ وقاسُوا حَرَّها."]],"65":[[1,1,"نَخۡتِمُ","نَطْبَعُ."]],"66":[[2,4,"لَطَمَسۡنَا عَلَىٰٓ أَعۡيُنِهِمۡ","لصَيرَّناها مَمْسُوحَةً لا يُرى لها شِقٌّ ولا جَفْنٌ."],[5,6,"فَٱسۡتَبَقُواْ ٱلصِّرَٰطَ","بادَرُوا إليه."],[7,8,"فَأَنَّىٰ يُبۡصِرُونَ","فكيفَ يُبْصِرُونَ وقد طُمِسَتْ أبْصارُهُم؟"]],"67":[[2,4,"لَمَسَخۡنَـٰهُمۡ عَلَىٰ مَكَانَتِهِمۡ","لَغَيَّرْنا خَلْقَهم في المكانِ الَّذي هم فيهِ."],[7,7,"مُضِيًّا","أي: ذَهابًا إلى الأمامِ."]],"68":[[1,1,"نُّعَمِّرۡهُ","نُطِلْ عُمُرَه."],[2,4,"نُنَكِّسۡهُ فِي ٱلۡخَلۡقِ","نَرُدَّه إلى أرْذَلِ العُمُرِ وأَضْعَفِه."]],"70":[[4,5,"وَيَحِقَّ ٱلۡقَوۡلُ","أي: تَجِبَ كلمةُ العذابِ."]],"71":[[5,7,"مِّمَّا عَمِلَتۡ أَيۡدِينَآ","أي: مما أبْدَعْناهُ وعَمِلْناهُ."],[10,11,"لَهَا مَـٰلِكُونَ","مالِكُونَ أمْرَها، يَتَصَرَّفُونَ بِها كيفَ شاؤُوا."]],"72":[[0,0,"ذَلَّلۡنَـٰهَا","سَخَّرْناها لَهُم."],[3,3,"رَكُوبُهُمۡ","مَرْكُوبُهم الّذي يَرْكَبُونَه."]],"75":[[3,6,"وَهُمۡ لَهُمۡ جُندٌ مُّحۡضَرُونَ","والحالُ أنَّ هذه الآلهةَ قَدْ أُحْضِرَتْ مُجْتَمِعَةً لِتُعايِنَ عذابَ عابِديِها، وهي لا تَسْتَطِيعُ نَصْرَهُم."]],"77":[[5,6,"مِن نُّطۡفَةٍ","هي مَنِيُّ الرَّجُلِ يقْذِفُه في رَحمِ امْرَأتِه."],[9,9,"خَصِيمٌ","كثيرُ الخُصُومَةِ بالباطلِ."]],"78":[[10,10,"رَمِيمٌ","باليةٌ مُتفَتِّتةٌ."]],"79":[[3,3,"أَنشَأَهَآ","خَلَقَها."]],"80":[[9,10,"مِّنۡهُ تُوقِدُونَ","تَقْدَحُونَ منه."]],"83":[[3,3,"مَلَكُوتُ","هو المُلْكُ التّامُّ للأشياءِ كلِّها."]]}