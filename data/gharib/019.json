{"3":[[4,4,"خَفِيًّا","سِرًّا."]],"4":[[3,3,"وَهَنَ","ضَعُفَ."],[6,8,"وَٱشۡتَعَلَ ٱلرَّأۡسُ شَيۡبًا","انْتَشَرَ الشَّيبُ في رَأسِي."],[13,13,"شَقِيًّا","مَحْرُومًا مِن إجابَةِ الدُّعاءِ."]],"5":[[2,2,"ٱلۡمَوَٰلِيَ","العَصَبَةَ وأقْرَبَ القَرابَةِ."],[7,7,"عَاقِرًا","التي لا تَلِدُ."],[12,12,"وَلِيًّا","ولَدًا وارِثًا ومُعِينًا."]],"6":[[0,0,"يَرِثُنِي","يَرِثُ نُبُوَّتي."],[7,7,"رَضِيًّا","مَرْضِيًّا مِنكَ ومِن عِبادِكَ."]],"7":[[11,11,"سَمِيًّا","مُسَمّىً باسْمِه."]],"8":[[2,2,"أَنَّىٰ","كيفَ؟"],[13,13,"عِتِيًّا","النِّهايةَ في كِبَر السِّنِّ."]],"9":[[6,6,"هَيِّنٌ","سَهْلٌ."],[11,13,"وَلَمۡ تَكُ شَيۡـًٔا","ولم تَكُ شيئًا مَذْكُورًا ولا مَوْجُودًا."]],"10":[[4,4,"ءَايَةً","علامةً."],[12,12,"سَوِيًّا","صَحِيحًا مُعافىً."]],"11":[[4,4,"ٱلۡمِحۡرَابِ","المُصَلّى."],[9,10,"بُكۡرَةً وَعَشِيًّا","صَباحًا ومَساءً."]],"12":[[2,2,"ٱلۡكِتَـٰبَ","أي: التَّوْراةَ."],[3,3,"بِقُوَّةٍ","بجِدٍّ واجْتِهادٍ."],[5,5,"ٱلۡحُكۡمَ","الحِكْمَةَ وحُسنَ الفَهْمِ."],[6,6,"صَبِيًّا","صغيَر السِّنِّ."]],"13":[[0,0,"حَنَانًا","رَحْمَةً ومحبةً."],[3,3,"وَزَكَوٰةً","طَهارةً مِنَ الذُّنُوبِ."],[5,5,"تَقِيًّا","خائفًا مِنَ اللهِ، ومُطِيعًا لَه."]],"14":[[0,0,"بَرَّۢا","بارًّا ومطيعًا."],[4,4,"جَبَّارًا","مُتَكَبِّرًا عَنْ طاعِةِ ربِّه، وطاعةِ والدَيْه."],[5,5,"عَصِيًّا","عاصِيًا لِرَبِّه ولِوالِدَيْه."]],"16":[[1,2,"فِي ٱلۡكِتَـٰبِ","في هَذا القُرْآنِ."],[5,5,"ٱنتَبَذَتۡ","تباعَدَتْ واعْتَزَلَتْ."],[9,9,"شَرۡقِيًّا","مَكانًا مِمّا يلِي الشَّرقَ عَنْ أهْلِها."]],"17":[[6,6,"رُوحَنَا","أي: جِبْرِيلَ عليهِ السَّلامُ."],[7,9,"فَتَمَثَّلَ لَهَا بَشَرًا","تصَوَّرَ لَها في صُورَةِ إنْسانٍ."],[10,10,"سَوِيًّا","تامَّ الخَلْقِ."]],"18":[[2,3,"أَعُوذُ بِٱلرَّحۡمَـٰنِ","ألْتَجِئُ وأَسْتَجِيرُ بالرَّحمنِ."]],"19":[[8,8,"زَكِيًّا","طاهِرًا مِنَ الذُّنوبِ."]],"20":[[1,1,"أَنَّىٰ","كيفَ؟"],[5,7,"لَمۡ يَمۡسَسۡنِي بَشَرٌ","لم يَمَسَّني بَشَرٌ بِنِكاحٍ حَلالٍ."],[10,10,"بَغِيًّا","زانيةً."]],"21":[[8,8,"ءَايَةً","علامةً تَدُلُّ على قُدْرَةِ اللهِ."],[10,11,"رَحۡمَةً مِّنَّا","جَعَلَه اللهُ رحمةً لأمِّه ولِمَن آمَنَ به."],[14,14,"مَّقۡضِيًّا","قَضاءً سابِقًا مُقَدَّرًا."]],"22":[[1,1,"فَٱنتَبَذَتۡ","فتباعَدَتْ."]],"23":[[11,12,"نَسۡيًا مَّنسِيًّا","شَيْئًا لا يُعْرَفُ ولا يُذكَرُ."]],"24":[[0,0,"فَنَادَىٰهَا","أي: جبريلُ أو عِيسى."],[9,9,"سَرِيًّا","جَدْوَلَ ماءٍ."]],"25":[[0,0,"هُزِّيٓ","حَرِّكِي."]],"26":[[2,3,"وَقَرِّي عَيۡنًا","وطِيبِي نَفْسًا بِمَولُودِكِ."],[11,11,"نَذَرۡتُ","أوْجَبْتُ على نَفْسِي."],[13,13,"صَوۡمًا","سُكُوتًا."],[17,17,"إِنسِيًّا","أحَدًا مِنَ النّاسِ."]],"27":[[8,9,"شَيۡـًٔا فَرِيًّا","أمْرًا عَظِيمًا مُفْتَرىً."]],"28":[[0,1,"يَـٰٓأُخۡتَ هَـٰرُونَ","يا أُخْتَ الرَّجلِ الصّالحِ هارُونَ."],[5,6,"ٱمۡرَأَ سَوۡءٍ","رَجُلَ سَوْءٍ يأتي الفَواحِشَ."],[10,10,"بَغِيًّا","زانيةً."]],"29":[[8,8,"ٱلۡمَهۡدِ","ما يُهَيَّأ للرَّضِيعِ مِن فِراشٍ ونَحْوِه."],[9,9,"صَبِيًّا","طِفْلًا رَضِيعًا."]],"30":[[5,5,"ٱلۡكِتَـٰبَ","الإنْجِيلَ."]],"31":[[1,1,"مُبَارَكًا","عَظِيمَ الخيرِ والنَّفْعِ"],[8,10,"مَا دُمۡتُ حَيًّا","ما بَقِيِتُ حَيًّا."]],"32":[[0,0,"بَرَّۢا","بارًّا ومُطِيعًا."],[4,4,"جَبَّارًا","مُتَكَبِّرًا."],[5,5,"شَقِيًّا","عاصِيًا لِربِّي."]],"33":[[6,8,"وَيَوۡمَ أُبۡعَثُ حَيًّا","أي: يَوْمَ القِيامةِ."]],"34":[[7,8,"فِيهِ يَمۡتَرُونَ","يَشُكُّ فيه اليهودُ والنَّصارى ويُجادِلُونَ."]],"35":[[0,1,"مَا كَانَ","ما يَنْبَغِي ولا يَلِيقُ."],[7,7,"سُبۡحَـٰنَهُۥٓ","تَقَدَّسَ وتَنَزَّهَ عَن ذَلِكَ."],[9,9,"قَضَىٰٓ","أرادَ."],[15,15,"فَيَكُونُ","أي: كَما أرادَه."]],"36":[[5,7,"هَـٰذَا صِرَٰطٌ مُّسۡتَقِيمٌ","هَذا طريقٌ لا اعْوِجاجَ فِيه."]],"37":[[1,1,"ٱلۡأَحۡزَابُ","الفِرَقُ مِن أهْلِ الكِتابِ."],[4,4,"فَوَيۡلٌ","فهَلاكٌ."],[8,8,"مَّشۡهَدِ","شُهُودِ."],[9,10,"يَوۡمٍ عَظِيمٍ","يومِ القِيامَةِ."]],"38":[[0,2,"أَسۡمِعۡ بِهِمۡ وَأَبۡصِرۡ","ما أقدَرَهم على السَّمعِ والبَصَرِ يوم القيامةِ!"],[8,10,"فِي ضَلَـٰلٍ مُّبِينٍ","في انْحِرافٍ واضحٍ عَن سَبَيلِ الحقِّ."]],"39":[[1,2,"يَوۡمَ ٱلۡحَسۡرَةِ","يومَ النَّدامةِ على ما فرَّطُوا في جَنْبِ اللهِ."]],"41":[[6,6,"صِدِّيقًا","عَظِيمَ الصِّدقِ."]],"42":[[11,12,"وَلَا يُغۡنِي","ولا يَدْفَعُ."]],"43":[[10,10,"أَهۡدِكَ","أُرْشِدْكَ."],[11,12,"صِرَٰطًا سَوِيًّا","طريقًا مُسْتَويًا لا اعْوِجاجَ فيه."]],"44":[[1,3,"لَا تَعۡبُدِ ٱلشَّيۡطَـٰنَ","لا تُطِعِ الشَّيطانَ في عِبادةِ الأصْنام."],[8,8,"عَصِيًّا","مُخالِفًا مُسْتكْبِرًا عَن طاعَةِ اللهِ."]],"45":[[9,10,"لِلشَّيۡطَـٰنِ وَلِيًّا","قَرِينًا لَه في اللَّعنةِ، وقريبًا منه في النّار."]],"46":[[1,4,"أَرَاغِبٌ أَنتَ عَنۡ ءَالِهَتِي","أمُعْرِضٌ أنت عَن عِبادَةِ آلَهتِي."],[9,9,"لَأَرۡجُمَنَّكَ","لَأَقْتُلَنَّك رَمْيًا بِالحِجارَةِ."],[11,11,"مَلِيًّا","زَمانًا طَوِيلًا مِنَ الدَّهْرِ."]],"47":[[1,2,"سَلَـٰمٌ عَلَيۡكَ","تحيةُ تَودِيعٍ ومُتارَكَةٍ، أي: تَسْلَمُ ممّا تَكْرَهُه مِنِّي."],[8,9,"بِي حَفِيًّا","كَثيرَ الِبرِّ واللُّطْفِ."]],"48":[[0,0,"وَأَعۡتَزِلُكُمۡ","وأُفارِقُكُم."],[13,13,"شَقِيًّا","مَحْرُومًا مِن إجابَةِ الدُّعاءِ."]],"50":[[6,7,"لِسَانَ صِدۡقٍ","ثَناءً حَسَنًا."],[8,8,"عَلِيًّا","رفيعَ القَدْرِ باقيًا في النّاسِ."]],"51":[[6,6,"مُخۡلَصًا","مُخْتارًا لِرِسالتِه."]],"52":[[3,3,"ٱلطُّورِ","جَبَلِ طُورِ سَيناءَ."],[5,6,"وَقَرَّبۡنَـٰهُ نَجِيًّا","فشَرَّفْناه بِمُناجاتِنا وتَكْلِيمِنا إيّاه سرًّا."]],"56":[[6,6,"صِدِّيقًا","عظيمَ الصِّدقِ في قولِه وعَمَلِه."]],"57":[[0,0,"وَرَفَعۡنَـٰهُ","أي: ذِكْرَه ومَنزِلَتَه، قيل: إنّه رُفِعَ إلى السَّماءِ الرابعةِ."],[2,2,"عَلِيًّا","رفيعَ القَدْرِ، أو ذا مَكانٍ عالٍ في السَّماءِ."]],"58":[[20,20,"وَٱجۡتَبَيۡنَآ","واصْطَفَينا للرِّسالةِ والنُّبوَّةِ."],[26,26,"خَرُّواْ","وقَعُوا."],[28,28,"وَبُكِيًّا","وباكِينَ مِن خَشْيَتِه سُبْحانَه وتَعالىَ."]],"59":[[0,2,"خَلَفَ مِنۢ بَعۡدِهِمۡ","فجاءَ بَعْدَهُم."],[3,3,"خَلۡفٌ","أتْباعُ سُوءٍ."],[10,10,"غَيًّا","جَزاءَ الغَيِّ، أو وادِيًا في جَهَنَّمَ."]],"61":[[0,1,"جَنَّـٰتِ عَدۡنٍ","جناتِ خُلْدٍ وإقامَةٍ دائِمةٍ."],[6,6,"بِٱلۡغَيۡبِ","أي: غائبةً عَنْهم لا يُشاهِدُونها."],[10,10,"مَأۡتِيًّا","آتِيًا لا مَحالةَ."]],"62":[[3,3,"لَغۡوًا","كَلامًا باطِلًا."],[9,10,"بُكۡرَةً وَعَشِيًّا","أي: على مِقْدارِ ما يَعرِفُونَ من الغَداءِ والعَشاءِ، وإلّا فليسَ في الجنَّةِ بُكْرَةٌ ولا عَشِيَّةٌ."]],"63":[[3,3,"نُورِثُ","نُعْطِي."]],"64":[[0,1,"وَمَا نَتَنَزَّلُ","أي: نَحْنُ الملائكةُ مِنَ السَّماءِ إلى الأرضِ."],[5,8,"لَهُۥ مَا بَيۡنَ أَيۡدِينَا","مما يُسْتَقْبَلُ مِن أُمُورِ الآخِرَةِ."],[9,10,"وَمَا خَلۡفَنَا","مِمّا مَضى مِن أُمُورِ الدُّنْيا."],[11,13,"وَمَا بَيۡنَ ذَٰلِكَ","وما بَيْنَ الدُّنْيا والآخِرةِ."],[17,17,"نَسِيًّا","ناسِيًا لشيءٍ مِنَ الأشياءِ."]],"65":[[6,7,"وَٱصۡطَبِرۡ لِعِبَـٰدَتِهِۦ","واثْبُتْ عَلى طاعةِ الله بِصَبْرٍ ومُواظَبَةٍ."],[11,11,"سَمِيًّا","مُماثِلًا في ذاتِه وأَسْمائِه وصِفاتِه وأفعالِه."]],"68":[[1,1,"لَنَحۡشُرَنَّهُمۡ","لَنَجْمَعَنَّ هَؤلاءِ المُنْكِرِينَ لِلبَعْثِ يومَ القيامةِ."],[7,7,"جِثِيًّا","بارِكِينَ على رُكَبِهِم."]],"69":[[0,1,"ثُمَّ لَنَنزِعَنَّ","ثم لَنَأخُذَنَّ."],[4,4,"شِيعَةٍ","طائِفَةٍ."],[9,9,"عِتِيًّا","تَمرُّدًا وعِصْيانًا للهِ تَعالى."]],"70":[[4,7,"هُمۡ أَوۡلَىٰ بِهَا صِلِيًّا","هُم أوْلى بجَهَنَّمَ دُخُولًا."]],"71":[[2,3,"إِلَّا وَارِدُهَا","إلّا واردٌ النارَ بالمُرُورِ على الصِّراطِ المنْصُوبِ على مَتْنِ جَهَنَّمَ."],[7,8,"حَتۡمًا مَّقۡضِيًّا","أمْرًا مَحْتُومًا قُضِيَ وحُكِمَ أنّه لابُدَّ مِن وُقُوعِه."]],"72":[[4,4,"وَّنَذَرُ","ونَتْرُكُ."]],"73":[[12,13,"خَيۡرٌ مَّقَامًا","أفْضَلُ مَنزِلًا."],[14,15,"وَأَحۡسَنُ نَدِيًّا","وأَحْسَنُ مَجْلِسًا."]],"74":[[3,4,"مِّن قَرۡنٍ","مِن أُمَمٍ."],[5,8,"هُمۡ أَحۡسَنُ أَثَـٰثًا وَرِءۡيًا","أحْسنُ مَتاعًا مِنهُم، وأَجْمَلُ مَنظَرًا."]],"75":[[5,5,"فَلۡيَمۡدُدۡ","فَلْيُمْهِلْهُ اسْتِدْراجًا."],[20,22,"هُوَ شَرٌّ مَّكَانًا","شرٌّ مَسْكَنًا ومُسْتَقَرًّا."],[23,24,"وَأَضۡعَفُ جُندًا","وأَضْعَفُ قوةً ورِجالًا."]],"76":[[5,6,"وَٱلۡبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ","أعمالُ الخيرِ."],[11,12,"وَخَيۡرٌ مَّرَدًّا","وخيرٌ مَرْجِعًا وعاقِبَةً."]],"77":[[5,5,"لَأُوتَيَنَّ","لَأُعْطَينَّ في الآخِرَةِ."]],"78":[[0,1,"أَطَّلَعَ ٱلۡغَيۡبَ","أعَلِمَ الغَيبَ؟"],[6,6,"عَهۡدًا","أي: عَهْدًا بِدُخُولِ الجنَّةِ."]],"79":[[4,5,"وَنَمُدُّ لَهُۥ","ونَزِيدُه في الآخِرَةِ."]],"80":[[0,0,"وَنَرِثُهُۥ","أي: بَعْدَ هَلاكِه فيَصِيرُ لنا مالُه وولدُه."]],"81":[[7,7,"عِزًّا","شُفَعاءَ وأنْصارًا يَتَعزَّزُونَ بِهِم."]],"82":[[3,5,"وَيَكُونُونَ عَلَيۡهِمۡ ضِدًّا","وتَكُونُ هَذهَ الآلهةُ مُخالِفةً لهم تُخاصِمُهُم، على عَكْسِ ما كانُوا يَرْجُونَه مِن هَؤلاءِ."]],"83":[[7,7,"تَؤُزُّهُمۡ","تُهَيِّجُ الكافِرِينَ وتَدْفَعُهُم إلى المَعاصِي."]],"84":[[4,5,"نَعُدُّ لَهُمۡ","نُحْصِي أعْمالَهم وأَعمارَهُم."]],"85":[[5,5,"وَفۡدًا","قادِمِينَ على اللهِ مُكْرَمِينَ."]],"86":[[0,1,"وَنَسُوقُ ٱلۡمُجۡرِمِينَ","أي: نَحُثُّهم على السَّيرِ ونَطْرُدُهم كما تُطْرَدُ البَهائِمُ"],[4,4,"وِرۡدًا","عِطاشًا."]],"89":[[2,3,"شَيۡـًٔا إِدًّا","شَيئًا عَظِيمًا مُنْكَرًا."]],"90":[[2,3,"يَتَفَطَّرۡنَ مِنۡهُ","يَتَشَقَّقْنَ ويَتَفَتَّتْنَ مِن شَناعَتِه."],[4,4,"تَنشَقُّ","وتَتَصَدَّعُ."],[6,7,"وَتَخِرُّ ٱلۡجِبَالُ","أي: تَسْقُطُ وتَنْهَدِمُ."],[8,8,"هَدًّا","أي: مَهْدُودَةً ومَكْسُورَةً."]],"97":[[9,9,"لُّدًّا","شَدِيدِي الخُصُومَةِ بالباطِل."]],"98":[[3,4,"مِّن قَرۡنٍ","مِن أُمَمٍ."],[13,13,"رِكۡزَۢا","صَوْتًا خَفِيًّا."]]}