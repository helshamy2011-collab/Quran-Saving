{"1":[[0,0,"الٓمٓصٓ","سبقَ شرحُ الحروفِ المقطَّعة أولَ سورة البقرة."]],"2":[[7,7,"حَرَجٌ","ضِيقٌ منه لتبليغِه."],[11,11,"وَذِكۡرَىٰ","وتذكيرٍ."]],"3":[[10,10,"أَوۡلِيَآءَ","أنصارًا كالشياطين والأحبارِ."]],"4":[[3,3,"أَهۡلَكۡنَـٰهَا","أرَدْنا إهلاكَها."],[5,5,"بَأۡسُنَا","عذابُنا."],[6,6,"بَيَـٰتًا","نائمين ليلًا."],[9,9,"قَآئِلُونَ","حالَ استراحتِهم وسطَ النهارِ."]],"7":[[1,1,"عَلَيۡهِم","على الرسُلِ والمُرْسَلِ إليهم."],[2,2,"بِعِلۡمٍ","عالمِين بما يُسِرُّون، وما يُعْلِنون."]],"8":[[0,2,"وَٱلۡوَزۡنُ يَوۡمَئِذٍ ٱلۡحَقُّ","وزنُ صحائفِ الأعمالِ بالميزانِ العَدْلِ."],[4,5,"ثَقُلَتۡ مَوَٰزِينُهُۥ","بثِقَلِ ما فيها من أعمالٍ حسنةٍ."]],"10":[[1,1,"مَكَّنَّـٰكُمۡ","جَعَلْنا لكم مكانًا."],[7,7,"مَعَـٰيِشَ","ما تعيشُون به من مَأْكَلٍ، ومَشْرَبٍ."]],"11":[[1,1,"خَلَقۡنَـٰكُمۡ","خَلَقْنا أباكم آدمَ من ترابٍ."],[3,3,"صَوَّرۡنَـٰكُمۡ","صَوَّرْناه على الهيئةِ المفضَّلَةِ."]],"12":[[1,4,"مَا مَنَعَكَ أَلَّا تَسۡجُدَ","ما مَنَعَكَ من السجودِ فأَحْوَجَك ألّا تسجدَ."]],"13":[[1,2,"فَٱهۡبِطۡ مِنۡهَا","فانْزِلْ من الجنةِ."],[7,8,"تَتَكَبَّرَ فِيهَا","تَتَعالى في الجنةِ عن أمري وطاعتي."],[12,12,"ٱلصَّـٰغِرِينَ","الذَّلِيلِين الحقيرِين."]],"14":[[1,1,"أَنظِرۡنِيٓ","أمْهِلْني."],[3,4,"يَوۡمِ يُبۡعَثُونَ","يومَ يُحيي اللهُ الخَلْقَ."]],"15":[[2,3,"مِنَ ٱلۡمُنظَرِينَ","ممن كَتَبْتُ عليهم تأخيرَ الأجَلِ إلى النفخةِ الأولى."]],"16":[[1,2,"فَبِمَآ أَغۡوَيۡتَنِي","فبسببِ إضلالِكَ لي."],[3,4,"لَأَقۡعُدَنَّ لَهُمۡ","لَأَتَرَبَّصَنَّ في إغواءِ بني آدمَ."],[5,6,"صِرَٰطَكَ ٱلۡمُسۡتَقِيمَ","طريقَك القويمَ، وهو الإسلامُ."]],"17":[[14,14,"شَـٰكِرِينَ","ذاكِرين نعمتَك مُثْنِين بها عليك."]],"18":[[3,3,"مَذۡءُومًا","ممقُوتًا مَعِيبًا."],[4,4,"مَّدۡحُورًا","مُبْعَدًا مَطْرودًا."]],"19":[[15,15,"ٱلظَّـٰلِمِينَ","المتجاوِزِين حُدودَ اللهِ."]],"20":[[0,1,"فَوَسۡوَسَ لَهُمَا","فألقى الشيطانُ لآدمَ وحواءَ وسْوَسَةً لإيقاعِهما في معصيةِ اللهِ."],[5,6,"مَا وُۥرِيَ","ما سُتِرَ."],[24,24,"ٱلۡخَـٰلِدِينَ","في الجنةِ، الماكثين فيها أبدًا."]],"21":[[0,0,"وَقَاسَمَهُمَآ","وحَلَفَ الشيطانُ باللهِ لآدمَ وحوّاءَ."]],"22":[[0,0,"فَدَلَّىٰهُمَا","فأوقعهما وجَرَّأهما على ما أراد."],[1,1,"بِغُرُورٍ","بخِداعِه."],[8,8,"وَطَفِقَا","وأَخَذا."],[9,9,"يَخۡصِفَانِ","يَلْصَقانِ على عَوْراتهِما."]],"23":[[2,3,"ظَلَمۡنَآ أَنفُسَنَا","بمخالفةِ أمْرِك."]],"24":[[1,1,"ٱهۡبِطُواْ","انزِلُوا من الجنةِ إلى الأرضِ."],[9,9,"وَمَتَـٰعٌ","ما تتمتعون به."],[10,11,"إِلَىٰ حِينٍ","إلى وقتِ انقضاءِ آجالِكم."]],"25":[[6,6,"تُخۡرَجُونَ","تُبْعَثُون أحياءً من الأرض يومَ القيامةِ."]],"26":[[3,3,"أَنزَلۡنَا","جَعَلْنا لكم."],[6,6,"يُوَٰرِي","يَسْتُرُ."],[8,8,"وَرِيشًا","لباسًا للزِّينةِ والتجمُّلِ."],[9,10,"وَلِبَاسُ ٱلتَّقۡوَىٰ","ولباسُ تقوى الله بفِعْل الأوامرِ واجتنابِ النواهي."]],"27":[[2,3,"لَا يَفۡتِنَنَّكُمُ","لا يَخْدَعَنَّكم الشيطانُ بتزيينِ المعصيةِ."],[18,18,"وَقَبِيلُهُۥ","ذريّةُ الشيطانِ."],[26,26,"أَوۡلِيَآءَ","أنصارًا."]],"28":[[2,2,"فَـٰحِشَةً","قَبيحًا من الفِعْلِ."]],"29":[[3,3,"بِٱلۡقِسۡطِ","بالعدلِ."],[4,5,"وَأَقِيمُواْ وُجُوهَكُمۡ","وأخْلِصُوا لله العبادةَ."],[6,8,"عِندَ كُلِّ مَسۡجِدٍ","في كلِّ موضعٍ من مواضعِ العبادةِ، ولا سِيَّما المساجدُ."],[12,12,"ٱلدِّينَ","الطاعةَ والعبادةَ."]],"30":[[3,4,"حَقَّ عَلَيۡهِمُ","ثَبَتَتْ لهم، ووَجَبَتْ عليهم."]],"31":[[3,3,"زِينَتَكُمۡ","الزينةَ المشروعةَ من ثيابٍ ساترةٍ، ونظافةٍ، وطهارةٍ."],[4,6,"عِندَ كُلِّ مَسۡجِدٍ","عند أداءِ كلِّ صلاةٍ."],[9,10,"وَلَا تُسۡرِفُوٓاْ","ولا تتجاوزُوا حدودَ الاعتدالِ."]],"32":[[3,4,"زِينَةَ ٱللَّهِ","اللِّباسَ الحسنَ الذي جَعَلَه اللهُ زينةً لكم."],[18,18,"خَالِصَةً","مخصوصةً بالمؤمنين."]],"33":[[4,4,"ٱلۡفَوَٰحِشَ","القبائحَ من الأعمالِ."],[8,9,"وَمَا بَطَنَ","وما كان خفيًّا."],[10,10,"وَٱلۡإِثۡمَ","المعاصيَ كلَّها."],[11,11,"وَٱلۡبَغۡيَ","الاعتداءَ على الناس."],[21,21,"سُلۡطَـٰنًا","دليلًا وبرهانًا."],[22,28,"وَأَن تَقُولُواْ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ","وحَرَّم اللهُ أن تَنْسِبوا إليه ما لم يَشْرَعْه."]],"34":[[2,2,"أَجَلٌ","وقتٌ لحُلولِ العقوبةِ."],[6,7,"لَا يَسۡتَأۡخِرُونَ","لا يتأخَّرُون عنه."],[9,10,"وَلَا يَسۡتَقۡدِمُونَ","ولا يتقدَّمُون عليه."]],"35":[[6,6,"يَقُصُّونَ","يَتْلُون ويُبَيِّنُون."],[8,8,"ءَايَـٰتِي","آياتِ كتابي، وأدلَّتي على صِدْقِ ما جاؤُوا به."]],"36":[[3,4,"وَٱسۡتَكۡبَرُواْ عَنۡهَآ","استعْلَوا عن اتِّباع دلائلِ توحيدِ اللهِ."]],"37":[[3,3,"ٱفۡتَرَىٰ","اختلَقَ."],[12,12,"نَصِيبُهُم","حَظُّهم من خيرٍ وشّرٍ في الدَنيا."],[13,14,"مِّنَ ٱلۡكِتَـٰبِ","مما كُتِبَ لهم في اللَّوحِ المحفوظِ."],[18,18,"رُسُلُنَا","مَلَكُ الموتِ وأعوانُه."],[19,19,"يَتَوَفَّوۡنَهُمۡ","يقبِضُون أرواحَهم."],[29,30,"ضَلُّواْ عَنَّا","ذهَبُوا عنّا."],[31,31,"وَشَهِدُواْ","واعتَرفوا."]],"38":[[2,3,"فِيٓ أُمَمٍ","في جملةِ جماعاتٍ من أمثالِكم في الكفر."],[5,5,"خَلَتۡ","سَبَقتْ."],[16,17,"لَّعَنَتۡ أُخۡتَهَا","لَعَنَتِ الجماعةُ الداخلةُ النارَ،نظيرتَها من أهلِ ملَّتِها."],[20,21,"ٱدَّارَكُواْ فِيهَا","اجتمعَتِ الأممُ في النار جميعًا."],[24,24,"أُخۡرَىٰهُمۡ","منزلةً ودخولًا، وهم الأتباعُ."],[25,25,"لِأُولَىٰهُمۡ","منزلةً ودخولًا، وهم الرؤساءُ والقادةُ في الضلالِ."],[31,31,"ضِعۡفًا","زائدًا على مِثْلِه مرَّةً أو مرّاتٍ."],[38,39,"لَّا تَعۡلَمُونَ","لا تدْرِكُون -أيها الأتباعُ- ما لكلِّ فريقٍ منكم من العذابِ."]],"39":[[3,8,"فَمَا كَانَ لَكُمۡ عَلَيۡنَا مِن فَضۡلٍ","نحن القادةُ متساوون معكم-أيُّها الأتباعُ- في الضَّلالِ واستحقاقِ العذابِ."]],"40":[[3,3,"بِـَٔايَـٰتِنَا","بحُجَجِنا وآياتِنا الدالَّةِ على وحْدانيَّتِنا."],[4,5,"وَٱسۡتَكۡبَرُواْ عَنۡهَا","واستعْلَوْا عن التصديقِ بها، والعملِ بَشْرعِنا."],[6,10,"لَا تُفَتَّحُ لَهُمۡ أَبۡوَٰبُ ٱلسَّمَآءِ","لا يَصْعَدُ لهم في الحياةِ إلى اللهِ عملٌ صالحٌ، ولا تُفَتَّحُ لأرواحِهم إذا ماتوا أبوابُ السماءِ."],[14,15,"حَتَّىٰ يَلِجَ","إلا إذا دَخَلَ."],[18,19,"سَمِّ ٱلۡخِيَاطِ","ثَقْبِ الإبرةِ."]],"41":[[3,3,"مِهَادٌ","فراشٌ مِن تحتهم."],[6,6,"غَوَاشٍ","أغطيةٌ من النارِ."]],"42":[[7,8,"إِلَّا وُسۡعَهَآ","إلّا ما تُطيقُ من الأعمالِ."]],"43":[[0,0,"وَنَزَعۡنَا","وأذهبَ اللهُ تعالى."],[4,5,"مِّنۡ غِلٍّ","من حِقْدٍ وضغائنَ كانت من بعضِهم في الدُّنيا."],[7,8,"مِن تَحۡتِهِمُ","من تحتِ غُرَفِهم ومنازلهِم."],[14,15,"هَدَىٰنَا لِهَـٰذَا","وفَّقَنا للعملِ الصالحِ."],[32,32,"أُورِثۡتُمُوهَا","آلَ أمرُكم إليها."]],"44":[[8,10,"مَا وَعَدَنَا رَبُّنَا","على ألسنةِ رُسُلِه من إثابةِ أهلِ طاعتِه."],[14,16,"مَّا وَعَدَ رَبُّكُمۡ","على ألسنةِ رسُلِه من عِقابِ أهلِ معصيتِه."],[20,21,"فَأَذَّنَ مُؤَذِّنُۢ","فنادى منادٍ."],[24,25,"لَّعۡنَةُ ٱللَّهِ","غَضَبُ اللهِ وسَخَطُه."],[27,27,"ٱلظَّـٰلِمِينَ","الذين كفرُوا، وتجاوَزُوا حدودَه."]],"45":[[5,6,"وَيَبۡغُونَهَا عِوَجًا","ويَطْلُبون أن تكونَ سبيلُ اللهِ غيرَ مستقيمةٍ."]],"46":[[0,0,"وَبَيۡنَهُمَا","وبينَ أصحابِ الجنةِ وأصحابِ النارِ."],[1,1,"حِجَابٌ","حاجزٌ عظيمٌ يسمّى ب «الأعراف»."],[2,4,"وَعَلَى ٱلۡأَعۡرَافِ رِجَالٌ","وعلى أعالي ذلك السُّورِ رجالٌ استوَتْ حسناتُهم وسيئاتُهم."],[6,6,"كُلَّۢا","من أهلِ الجنةِ والنارِ."],[7,7,"بِسِيمَىٰهُمۡ","بعلاماتِهم، كبياضِ وجوهِ أهلِ الجنةِ، وسوادِ وجوهِ أهلِ النارِ."],[17,17,"يَطۡمَعُونَ","يَرْجُون دخولَ الجنةِ."]],"47":[[1,1,"صُرِفَتۡ","حُوِّلَتْ."],[3,3,"تِلۡقَآءَ","جِهةَ."]],"48":[[7,9,"مَآ أَغۡنَىٰ عَنكُمۡ","ما نَفَعكم."],[10,10,"جَمۡعُكُمۡ","ما كنتم تَجْمعون من الأموالِ والرجالِ."]],"49":[[0,0,"أَهَـٰٓؤُلَآءِ","أي: الضعفاءُ والفقراءُ."],[3,6,"لَا يَنَالُهُمُ ٱللَّهُ بِرَحۡمَةٍ","لا يُدْخِلُهم الجنةَ."]],"50":[[6,6,"أَفِيضُواْ","صُبُّوا بكثرةٍ."],[12,13,"رَزَقَكُمُ ٱللَّهُ","من الطعام."]],"51":[[1,4,"ٱتَّخَذُواْ دِينَهُمۡ لَهۡوًا وَلَعِبًا","جَعَلُوا ما أمرَهم اللهُ باتِّباعِه لهوًا وباطلًا."],[5,5,"وَغَرَّتۡهُمُ","وخَدَعَتْهم."],[9,9,"نَنسَىٰهُمۡ","نُعامِلُهم معاملةَ الشيء المَنسِيِّ."],[10,11,"كَمَا نَسُواْ","كما تركُوا العملَ."],[13,14,"يَوۡمِهِمۡ هَـٰذَا","يومِ القيامةِ."],[17,18,"بِـَٔايَـٰتِنَا يَجۡحَدُونَ","يُنكرون أدلةَ اللهِ وبراهينَه مع عِلْمِهم بأنها حقٌّ."]],"52":[[2,2,"بِكِتَـٰبٍ","بقرآنٍ أنزَلْناه إليك."],[3,3,"فَصَّلۡنَـٰهُ","بيَّناه أتمَّ بَيانٍ."]],"53":[[0,1,"هَلۡ يَنظُرُونَ","ما ينتظرون."],[3,3,"تَأۡوِيلَهُۥ","ما يَؤولُ إليه أمرُهم من العقابِ."],[9,11,"نَسُوهُ مِن قَبۡلُ","تَرَكُوا الإيمانَ بالقرآنِ في الدنيا."],[23,24,"أَوۡ نُرَدُّ","أو نُعادُ إلى الدنيا."],[31,32,"خَسِرُوٓاْ أَنفُسَهُمۡ","صاروا إلى الهَلاكِ بدخولِهم النارَ وخُلودِهم فيها."],[33,33,"وَضَلَّ","وذَهَبَ."],[37,37,"يَفۡتَرُونَ","يَعْبُدُونه من دونِ اللهِ."]],"54":[[11,11,"ٱسۡتَوَىٰ","علا وارتفعَ، استواءً يَليق بجَلالِه وعَظَمَتِه."],[13,13,"ٱلۡعَرۡشِ","سريرِ المُلْكِ الذي استوى عليه الرحمنُ، وتَحْمِلُه الملائكة، وهو أعظمُ المخلوقات، وهو سَقْفُ الجنةِ."],[14,16,"يُغۡشِي ٱلَّيۡلَ ٱلنَّهَارَ","يُدْخِلُ سبحانَه الليلَ على النهارِ حتى يَذْهَبَ نورُه، ويُدْخِلُ النهارَ على الليل حتى يَذْهَبَ ظلامُه."],[17,17,"يَطۡلُبُهُۥ","كلٌّ من الليلِ والنهارِ يَطْلُبُ الآخَرَ."],[18,18,"حَثِيثًا","طَلَبًا سريعًا دائمًا."],[22,22,"مُسَخَّرَٰتِۭ","مُذَلَّلاتٍ خاضعاتٍ."],[25,26,"لَهُ ٱلۡخَلۡقُ","إيجادُ الأشياءِ من العَدَمِ."],[27,27,"وَٱلۡأَمۡرُ","التدبيرُ والتصرُّفُ في مخلوقاتِه كما يشاءُ."],[28,29,"تَبَارَكَ ٱللَّهُ","كَثُرَتْ بَرَكَتُه واتسعَتْ."]],"55":[[2,2,"تَضَرُّعًا","تَذَلُّلًا."],[3,3,"وَخُفۡيَةً","سِرًّا."],[7,7,"ٱلۡمُعۡتَدِينَ","المتجاوِزِين حدودَ ما شَرَعَه اللهُ."]],"56":[[4,5,"بَعۡدَ إِصۡلَـٰحِهَا","ببعثةِ الرسلِ وعُمْرانِها بطاعةِ اللهِ."]],"57":[[4,4,"بُشۡرَۢا","مُبَشِّراتٍ بالمطرِ قبلَ نزولِه."],[5,7,"بَيۡنَ يَدَيۡ رَحۡمَتِهِۦ","أمامَ نزولِ المطرِ."],[10,10,"أَقَلَّتۡ","حَمَلَتْ."],[12,12,"ثِقَالًا","مُحمَّلًا بالمطرِ."],[14,15,"لِبَلَدٍ مَّيِّتٍ","لأرضٍ لا نباتَ فيها ولا مَرْعى."]],"58":[[0,3,"وَٱلۡبَلَدُ ٱلطَّيِّبُ يَخۡرُجُ نَبَاتُهُۥ","مَثَلٌ ضربَه اللهُ للمؤمنِ بأنه طَيِّبٌ وعَمَلَه طيبٌ."],[6,7,"وَٱلَّذِي خَبُثَ","مَثَلٌ ضَرَبَه اللهُ للكافرِ بأنه خبيثٌ وعَمَلَه خبيثٌ."],[11,11,"نَكِدًا","عسِرًا رديئًا لا نَفْعَ فيه."],[13,13,"نُصَرِّفُ","نُبَيِّنُ."],[14,14,"ٱلۡـَٔايَـٰتِ","الحُجَجَ والبراهينَ."]],"60":[[1,1,"ٱلۡمَلَأُ","أشرافُ القومِ وسادتُهم."],[7,7,"ضَلَـٰلٍ","ذَهابٍ عن الحقِّ والصوابِ."]],"62":[[5,7,"وَأَعۡلَمُ مِنَ ٱللَّهِ","وأَعْلَمُ مما أوحاه الله إليَّ من شريعتِه."]],"64":[[5,5,"ٱلۡفُلۡكِ","السفينةِ."],[9,9,"بِـَٔايَـٰتِنَآ","بحُجَجِنا الواضحةِ."],[13,13,"عَمِينَ","جَمْعُ عَمٍ، أي: لا تُبْصِرُ قلوبُهم الحقَّ والإيمان."]],"65":[[1,1,"عَادٍ","قومِ هودٍ عليه السلام، وهم قبيلةٌ من العربِ."]],"66":[[9,9,"سَفَاهَةٍ","خِفَّةِ عقلٍ وحَماقةٍ."],[11,11,"لَنَظُنُّكَ","لَنُوقِنُ بأنك."]],"68":[[6,6,"أَمِينٌ","على ما أقولُ من وحْيِ اللهِ."]],"69":[[13,13,"خُلَفَآءَ","تَخْلُفُون في الأرض مَن قبلَكم."],[21,21,"بَصۜۡطَةً","قوةً وضَخامةً وطُولًا."],[23,24,"ءَالَآءَ ٱللَّهِ","جَمْعُ إلىً، وهي نِعَمُه الكثيرةُ عليكم."]],"70":[[5,5,"وَنَذَرَ","ونَتْرُكَ."],[11,12,"بِمَا تَعِدُنَآ","بما تُخَوِّفُنا به من العذابِ."]],"71":[[6,6,"رِجۡسٌ","عذابٌ."],[7,7,"وَغَضَبٌ","سُخْطٌ وانتقامٌ."],[10,11,"أَسۡمَآءٍ سَمَّيۡتُمُوهَآ","أصنامٍ سَمَّيتُموها آلهةً."],[19,19,"سُلۡطَـٰنٍ","حُجَّةٍ ومَعْذِرةٍ تعتذرون بها."],[20,20,"فَٱنتَظِرُوٓاْ","نزولَ عذابِ الله عليكم."]],"72":[[5,6,"وَقَطَعۡنَا دَابِرَ","وأهْلَك اللهُ الكفارَ من قومِ عادٍ، واستأصَلَهم بالريحِ."]],"73":[[1,1,"ثَمُودَ","قومِ صالحٍ عليه السلام، وهم قبيلةٌ من العربِ."],[15,15,"بَيِّنَةٌ","برهانٌ على صِدْقِ نبيِّكم."],[22,22,"ءَايَةً","دليلًا على نبوَّتي."],[23,23,"فَذَرُوهَا","فاترُكُوها."],[30,30,"بِسُوٓءٍ","بأيِّ أذى."]],"74":[[3,3,"خُلَفَآءَ","تَخْلُفُون في الأرضِ مَن قبلَكم."],[7,7,"وَبَوَّأَكُمۡ","ومَكَّن لكم وأَنْزَلَكم."],[8,9,"فِي ٱلۡأَرۡضِ","أرضِ الحِجْرِ."],[13,13,"قُصُورًا","بيوتًا عظيمةً."],[20,21,"وَلَا تَعۡثَوۡاْ","ولا تُفْرِطُوا في الفَساد."]],"75":[[3,3,"ٱسۡتَكۡبَرُواْ","استَعْلَوْا عن الإيمان."]],"77":[[0,1,"فَعَقَرُواْ ٱلنَّاقَةَ","فنَحرُوها."],[2,2,"وَعَتَوۡاْ","وتجاوَزُوا الحَدَّ في الاستِكْبار."],[9,10,"بِمَا تَعِدُنَآ","بما تتوعَّدُنا به من العَذابِ."]],"78":[[1,1,"ٱلرَّجۡفَةُ","الزَّلزلةُ الشديدةُ من الأرضِ."],[5,5,"جَـٰثِمِينَ","لاصِقِين بالأرضِ على رُكَبهِم ووُجوهِهم، لا حَراكَ بهم."]],"79":[[0,0,"فَتَوَلَّىٰ","فأَعْرَضَ."]],"80":[[5,5,"ٱلۡفَـٰحِشَةَ","الفَعْلَةَ المُنْكَرةُ، وهي إتيانُ الرِّجالِ."]],"81":[[4,6,"مِّن دُونِ ٱلنِّسَآءِ","تاركين ما أحلَّه اللهُ لكم من نسائِكم."],[10,10,"مُّسۡرِفُونَ","متجاوِزُون ما أحلَّه اللهُ لكم إلى الحَرامِ."]],"82":[[12,12,"يَتَطَهَّرُونَ","يتنزَّهُون عن إتيانِ الرجالِ في أدبارِهم."]],"83":[[6,6,"ٱلۡغَـٰبِرِينَ","الهالِكين الباقين في العذابِ."]],"84":[[0,1,"وَأَمۡطَرۡنَا عَلَيۡهِم","وأرسل اللهُ على الكفارِ من قومِ لوطٍ."],[2,2,"مَّطَرًا","حجارةً متتابعةً."]],"85":[[1,1,"مَدۡيَنَ","قومِ شُعَيبٍ عليه السَّلام، وهم قبيلةٌ من العربِ."],[15,15,"بَيِّنَةٌ","حُجَّةٌ ظاهرةٌ."],[18,18,"فَأَوۡفُواْ","فأتِمُّوا."],[21,22,"وَلَا تَبۡخَسُواْ","ولا تَنْقُصُوا."],[29,30,"بَعۡدَ إِصۡلَـٰحِهَا","بشرائعِ الأنبياءِ، وعُمْرانِها بطاعَةِ اللهِ."]],"86":[[3,3,"صِرَٰطٍ","طريقٍ."],[4,4,"تُوعِدُونَ","تُخَوِّفون الناسَ بالقَتْل إن لم يُعْطُوكم أموالَهم."],[12,13,"وَتَبۡغُونَهَا عِوَجًا","وتُريدون أن تكونَ سبيلُ اللهِ مائلة وفْقَ أهوائِكم."]],"87":[[11,11,"فَٱصۡبِرُواْ","فانتظرُوا أيُّها المكذِّبون."],[13,15,"يَحۡكُمَ ٱللَّهُ بَيۡنَنَا","يَفْصِلَ بينَنا وبينكَم."]],"88":[[3,3,"ٱسۡتَكۡبَرُواْ","استعلَوْا عن الإيمانِ."],[16,16,"مِلَّتِنَا","دينِنا."]],"89":[[34,34,"ٱفۡتَحۡ","احكُمْ."],[41,41,"ٱلۡفَـٰتِحِينَ","الحاكمين."]],"91":[[1,1,"ٱلرَّجۡفَةُ","الزَّلزلةُ الشديدةُ من الأرضِ."],[5,5,"جَـٰثِمِينَ","لاصِقين بالأرضِ على رُكَبِهم ووجوهِهم، لا حَراكَ بهم."]],"92":[[3,6,"كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَا","كأنّ قومَ شُعَيبٍ لم يُقيموا في ديارِهم، و يتمتَّعوا فيها."]],"93":[[0,0,"فَتَوَلَّىٰ","فأَعرَضَ."],[11,11,"ءَاسَىٰ","أحْزَنُ."]],"94":[[4,5,"مِّن نَّبِيٍّ","أي: كذَّبه قومُه."],[7,7,"أَخَذۡنَآ","ابتلَينا."],[9,9,"بِٱلۡبَأۡسَآءِ","البؤسِ وضيقِ المعيشةِ."],[10,10,"وَٱلضَّرَّآءِ","ما يَضرُّ الإنسانَ في نفسِه أو معيشتِه."],[12,12,"يَضَّرَّعُونَ","يُظْهِرُون الخضوعَ والاستكانةَ للهِ."]],"95":[[3,3,"ٱلسَّيِّئَةِ","الحالِ السيئةِ من البلاءِ والجَدْبِ."],[4,4,"ٱلۡحَسَنَةَ","الحالَ الحسنةَ من الرَّخاءِ والنِّعمةِ والعافيةِ."],[5,6,"حَتَّىٰ عَفَواْ","حتى كَثُروا وكَثُرَتْ أموالُهم."],[13,13,"فَأَخَذۡنَـٰهُم","فأهلَكْناهم."],[14,14,"بَغۡتَةً","فَجْأةً."]],"96":[[5,5,"وَٱتَّقَوۡاْ","واجتَنَبُوا ما نهاهم اللهُ عنه."],[8,11,"بَرَكَـٰتٍ مِّنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِ","ما يتتابعُ عليهم من الخير من كلِّ وجْهٍ."]],"97":[[5,5,"بَأۡسُنَا","عذابُ اللهِ."],[6,6,"بَيَـٰتًا","ليلًا."]],"98":[[8,8,"يَلۡعَبُونَ","يشتغلون بما لا يعودُ عليهم بفائدةٍ."]],"99":[[1,2,"مَكۡرَ ٱللَّهِ","استدراجَه للمكذِّبين بما أنعمَ به عليهم، وعقوبتَهم."]],"100":[[1,1,"يَهۡدِ","يتبيَّنْ."],[3,4,"يَرِثُونَ ٱلۡأَرۡضَ","بالسُّكنى."],[5,7,"مِنۢ بَعۡدِ أَهۡلِهَآ","من بعدِ إهلاكِ أهلِها السابقين."],[13,13,"وَنَطۡبَعُ","ونَخْتِمُ."],[17,18,"لَا يَسۡمَعُونَ","الموعظةَ سماعَ منتفعٍ بها."]],"101":[[2,2,"نَقُصُّ","نَذْكُرُ."],[5,5,"أَنۢبَآئِهَا","أخبارِها."],[9,9,"بِٱلۡبَيِّنَـٰتِ","بالحُجَجِ الظاهرةِ الدالَّةِ على صِدْقِهم."],[22,22,"ٱلۡكَـٰفِرِينَ","الذين كَتَبَ اللهُ عليهم ألّا يُؤمنوا."]],"102":[[3,4,"مِّنۡ عَهۡدٍ","مِن وفاءٍ بما وصّاهم اللهُ به."],[8,8,"لَفَـٰسِقِينَ","لخارجينَ عن طاعةِ اللهِ وامتثالِ أمرِه."]],"103":[[5,5,"بِـَٔايَـٰتِنَآ","بالمعجزاتِ الظاهرةِ الدالَّةِ على صِدْقِه."],[7,7,"فِرۡعَوۡنَ","لَقَبٌ لكلِّ مَن مَلَك مِصْرَ في القديم."],[9,10,"فَظَلَمُواْ بِهَا","فَجحَدُوا وكَفَروا بها."]],"105":[[0,0,"حَقِيقٌ","جديرٌ وحَرِيٌّ."],[11,11,"بِبَيِّنَةٍ","ببُرهانٍ وحُجَّةٍ واضحةٍ على صِدْقِ ما أقولُ."]],"107":[[4,4,"ثُعۡبَانٌ","حَيَّةٌ عظيمةٌ."],[5,5,"مُّبِينٌ","ظاهرةٌ لكلِّ مَن يَراها."]],"108":[[0,1,"وَنَزَعَ يَدَهُۥ","وأخرجَ يدَه من فتحةِ قميصِه، أو من تحتِ إبْطِه."]],"109":[[1,1,"ٱلۡمَلَأُ","أشرافُ القومِ وسادَتُهم."]],"110":[[6,6,"تَأۡمُرُونَ","تُشيرون عليَّ أيها الأشرافُ."]],"111":[[1,2,"أَرۡجِهۡ وَأَخَاهُ","أخِّرْ موسى وأخاه هارونَ، ولا تَفْصِلْ في شأنِهما الآن."],[4,5,"فِي ٱلۡمَدَآئِنِ","في مُدُنِ مِصْرَ وأقاليمِها."],[6,6,"حَـٰشِرِينَ","مَن يَحْشُرُ السَّحَرَةَ فيَجْمَعُهم إليك."]],"116":[[4,6,"سَحَرُوٓاْ أَعۡيُنَ ٱلنَّاسِ","صَرَفُوها عن حقيقةِ إدراكِها، فخُيِّلَ إلى الأبصارِ أنّ ما فعلُوه حقيقةٌ."],[7,7,"وَٱسۡتَرۡهَبُوهُمۡ","وأخافوا الناسَ إخافةً شديدةً."]],"117":[[8,8,"تَلۡقَفُ","تبتلِعُ بسرعة."],[9,10,"مَا يَأۡفِكُونَ","ما يُلْقُونه من الحِبال والعِصِيِّ، ويُوهِمونَ الناسَ أنه حقٌّ."]],"118":[[0,1,"فَوَقَعَ ٱلۡحَقُّ","فظهر الحقُّ في أمرِ موسى عليه السلام."]],"119":[[2,2,"وَٱنقَلَبُواْ","وانصرفَ فرعونُ وقومُه."],[3,3,"صَـٰغِرِينَ","أذلّاءَ بما لَحِقَهم من الهزيمةِ والخَيبةِ."]],"123":[[6,7,"ءَاذَنَ لَكُمۡ","أسْمَحَ لكم بالإيمان بما يَدْعُو إليه موسى."],[10,11,"لَمَكۡرٌ مَّكَرۡتُمُوهُ","إن إيمانَكم بالله وإقرارَكم بنبوَّةِ موسى لَحيلةٌ احتَلْتُموها."]],"124":[[3,4,"مِّنۡ خِلَـٰفٍ","بقَطْع اليدِ اليمنى والرِّجلِ اليسرى، أو اليدِ اليسرى والرِّجلِ اليمنى."],[6,6,"لَأُصَلِّبَنَّكُمۡ","لَأُبالِغَنَّ في شَدِّ أطرافِكم وتعليقِكم على جُذوع النَّخْلِ."]],"125":[[4,4,"مُنقَلِبُونَ","راجِعُون إلى اللهِ."]],"126":[[0,1,"وَمَا تَنقِمُ","ولَسْتَ تَعِيبُ منا -يا فرعونُ- وتُنْكِرُ."],[6,7,"بِـَٔايَـٰتِ رَبِّنَا","بحُجَجِه وأدلَّتِه."],[11,11,"أَفۡرِغۡ","أنْزِلْ وأسبِغْ."]],"127":[[5,5,"أَتَذَرُ","أتَتْرُك."],[8,10,"لِيُفۡسِدُواْ فِي ٱلۡأَرۡضِ","في أرضِ مصرَ بتغييرِ دينِ الناسِ إلى عبادةِ اللهِ وحدَه."],[11,12,"وَيَذَرَكَ وَءَالِهَتَكَ","وقد تَرَكَك وتَرَكَ عبادةَ آلهتِك؟"],[16,17,"وَنَسۡتَحۡيِۦ نِسَآءَهُمۡ","ونَسْتبقيهنَّ أحياءً للخدمةِ والامتهانِ."],[20,20,"قَـٰهِرُونَ","عالُون عليهم بقَهْرِ المُلْكِ والسلطانِ."]],"129":[[2,5,"مِن قَبۡلِ أَن تَأۡتِيَنَا","برسالةِ اللهِ إلينا."],[6,9,"وَمِنۢ بَعۡدِ مَا جِئۡتَنَا","برسالةِ اللهِ."],[16,18,"وَيَسۡتَخۡلِفَكُمۡ فِي ٱلۡأَرۡضِ","ويَجْعَلَكم خلفاءَ في أرضِ مصرَ بعد هَلاكِ فرعونَ وقومِه."]],"130":[[1,1,"أَخَذۡنَآ","ابتَلَيْنا."],[4,4,"بِٱلسِّنِينَ","بالقحطِ والجَدْبِ."]],"131":[[2,2,"ٱلۡحَسَنَةُ","العافيةُ والرَّخاءُ والخِصْبُ."],[8,8,"سَيِّئَةٌ","بلاءٌ وجَدْبٌ."],[9,9,"يَطَّيَّرُواْ","يتشاءمُوا."],[15,15,"طَـٰٓئِرُهُمۡ","ما يُصيبُهم من البلاءِ والجَدْبِ."],[16,17,"عِندَ ٱللَّهِ","بقضاءِ اللهِ وقَدَرِه."]],"132":[[4,5,"مِنۡ ءَايَةٍ","من دَلالةٍ وحُجَّةٍ."]],"133":[[4,4,"وَٱلۡقُمَّلَ","حشراتٌ تُفْسِدُ الثمار، وتَقْضي على الحَيَوانِ والنباتِ."],[6,6,"وَٱلدَّمَ","فصارَتْ مياهُ القِبْط دمًا، ولم يَجِدوا ماءً صالحًا للشُّربِ."],[8,8,"مُّفَصَّلَـٰتٍ","مُفَرَّقاتٍ بعضُها في إثرِ بعضٍ."]],"134":[[1,1,"وَقَعَ","نَزَلَ."],[3,3,"ٱلرِّجۡزُ","العذابُ."],[9,11,"بِمَا عَهِدَ عِندَكَ","بما أوحى إليك مِن رَفْعِ العذاب بالتوبةِ."]],"135":[[10,10,"يَنكُثُونَ","يَنْقُضُون عُهودَهم، ويبْقَوْن على كُفْرِهم وضلالهِم."]],"136":[[7,7,"بِـَٔايَـٰتِنَا","بحُجَجِنا، وما أرَيْناهم من المعجزاتِ على يدِ موسى."],[10,10,"غَـٰفِلِينَ","مُعْرِضِين."]],"137":[[4,4,"يُسۡتَضۡعَفُونَ","يُسْتَذَلُّون للخِدْمَةِ والامتهانِ."],[5,7,"مَشَـٰرِقَ ٱلۡأَرۡضِ وَمَغَـٰرِبَهَا","بلادَ الشامِ."],[12,14,"كَلِمَتُ رَبِّكَ ٱلۡحُسۡنَىٰ","ما وعَدَهم من تمكينِهم في الأرضِ ونَصْرِه إياهم على فرعونَ وقومِه."],[28,28,"يَعۡرِشُونَ","يَبْنُون من الأبنيةِ والقصورِ وغيرِهما."]],"138":[[7,7,"يَعۡكُفُونَ","يُقيمون ويُواظِبون من أجلِ العبادةِ."]],"139":[[2,5,"مُتَبَّرٌ مَّا هُمۡ فِيهِ","مُهْلَكٌ ما هم فيه من الدِّين الباطِل والشِّرْكِ بالله."]],"140":[[6,6,"فَضَّلَكُمۡ","بكثرةِ الأنبياء وإهلاكِ عدوِّكم."],[7,8,"عَلَى ٱلۡعَـٰلَمِينَ","من أهلِ عَصْرِكم."]],"141":[[5,5,"يَسُومُونَكُمۡ","يُذيقُونكم."],[10,11,"وَيَسۡتَحۡيُونَ نِسَآءَكُمۡ","ويَسْتَبْقُون نساءَكم للخِدْمَةِ والامتهانِ."],[14,14,"بَلَآءٌ","اختبارٌ ونعمةٌ."]],"142":[[18,18,"وَأَصۡلِحۡ","واحمِلْ بني إسرائيلَ على عبادةِ اللهِ وطاعتِه."]],"143":[[12,13,"لَن تَرَىٰنِي","لن تَقْدِرَ على رؤيتي في الدنيا."],[24,26,"تَجَلَّىٰ رَبُّهُۥ لِلۡجَبَلِ","ظَهَرَ ربُّه للجَبَلِ على الوجهِ اللائقِ بجَلالِه."],[28,28,"دَكًّا","مُسْتويًا بالأرض."],[29,29,"وَخَرَّ","وسقط."],[31,31,"صَعِقًا","مَغْشِيًّا عليه؛ لعِظَمِ ما رأى."],[39,40,"أَوَّلُ ٱلۡمُؤۡمِنِينَ","بك من قومي."]],"144":[[3,3,"ٱصۡطَفَيۡتُكَ","اختَرْتُك."],[7,7,"وَبِكَلَـٰمِي","وبتكليمي إياك من غيرِ واسطةٍ."]],"145":[[2,3,"فِي ٱلۡأَلۡوَاحِ","ألواحِ التوراةِ."],[4,6,"مِن كُلِّ شَيۡءٍ","يحتاجون إليه في دينِهم، وما يُصْلِحُ معاشَهم."],[11,12,"فَخُذۡهَا بِقُوَّةٍ","فخُذِ التوراةَ بجِدٍّ واجتهاد."],[16,16,"بِأَحۡسَنِهَا","بحَسَنِها، وكلُّها حَسَنٌ بما شَرَعَ اللهُ فيها."],[18,19,"دَارَ ٱلۡفَـٰسِقِينَ","مصيرَهم في الآخرة، وهي النارُ."]],"146":[[1,2,"عَنۡ ءَايَـٰتِيَ","عن فَهْمِ حُجَجِ الله وأدلَّتِه وكتابِه."],[26,26,"ٱلۡغَيِّ","الضلالِ."]],"147":[[5,6,"حَبِطَتۡ أَعۡمَـٰلُهُمۡ","بطَلَتْ أعمالُهم، فلا ثوابَ عليها."]],"148":[[3,4,"مِنۢ بَعۡدِهِۦ","مِن بعدِ ما فارَقَهم لمناجاةِ ربِّه."],[7,8,"عِجۡلًا جَسَدًا","معبودًا مِن ذَهَبِهم على صورةِ العجلِ بلا رُوحٍ."],[9,10,"لَّهُۥ خُوَارٌ","له صوتٌ يُشْبِهُ صوتَ البقرِ."]],"149":[[0,3,"وَلَمَّا سُقِطَ فِيٓ أَيۡدِيهِمۡ","ولما نَدِمُوا على عبادةِ العجلِ عند رجوعِ موسى عليه السلام."]],"150":[[6,6,"أَسِفًا","حزينًا على عبادةِ قومِه العجلَ."],[12,14,"أَعَجِلۡتُمۡ أَمۡرَ رَبِّكُمۡ","أستعجَلْتم مجيئي إليكم وما وصَّيتُكم به من التوحيدِ، فَعَبدْتُم العِجْلَ؟"],[30,31,"فَلَا تُشۡمِتۡ","فلا تَسُرَّ."]],"152":[[14,14,"ٱلۡمُفۡتَرِينَ","المكذِّبين المبتدِعين."]],"154":[[14,14,"يَرۡهَبُونَ","يخافون أشدَّ الخوفِ من ربِّهم."]],"155":[[5,5,"لِّمِيقَـٰتِنَا","للوقتِ الذي واعَدَ اللهُ موسى أن يَلْقاه فيه؛ للتوبةِ والاعتذارِ عَمّا فعلَ سُفَهاءُ بني إسرائيل."],[8,8,"ٱلرَّجۡفَةُ","الزَّلزلةُ الشديدةُ."],[20,20,"ٱلسُّفَهَآءُ","ضِعافُ العقولِ."],[22,25,"إِنۡ هِيَ إِلَّا فِتۡنَتُكَ","ما عبادةُ قومي للعِجْلِ إلا ابتلاءٌ واختبارٌ."]],"156":[[0,1,"وَٱكۡتُبۡ لَنَا","واجعَلْنا ممَّن كَتَبْتَ له."],[5,5,"حَسَنَةً","الصالحاتِ من الأعمالِ."],[23,23,"يَتَّقُونَ","يخافون اللهَ ويخشَونَ عقابَه."],[28,28,"بِـَٔايَـٰتِنَا","بدلائلِ توحيدِنا."]],"157":[[4,4,"ٱلۡأُمِّيَّ","الذي لا يقرأُ ولا يكتبُ."],[6,6,"يَجِدُونَهُۥ","يَجِدونَ صفتَه ونبوَّتَه."],[22,22,"ٱلۡخَبَـٰٓئِثَ","من المطاعمِ والمشاربِ والمناكحِ."],[23,24,"وَيَضَعُ عَنۡهُمۡ","ويَرْفَعُ عنهم بالتخفيفِ أو الإذهاب."],[25,29,"إِصۡرَهُمۡ وَٱلۡأَغۡلَـٰلَ ٱلَّتِي كَانَتۡ عَلَيۡهِمۡ","ما أُلْزِمُوا العملَ به من التكاليفِ الشاقةِ في التوراة."],[33,33,"وَعَزَّرُوهُ","وعَظَّموه ووَقَّرُوه."],[36,36,"ٱلنُّورَ","القرآنَ."]],"158":[[27,27,"وَكَلِمَـٰتِهِۦ","ما أُنْزِلَ إلى النبي ﷺ من ربِّه والنبيين من قبلِه."]],"159":[[4,5,"يَهۡدُونَ بِٱلۡحَقِّ","يستقيمون على الحقِّ، ويَدْعُون الناسَ إلى الهدايةِ."]],"160":[[0,0,"وَقَطَّعۡنَـٰهُمُ","وفَرَّقْنا قومَ موسى من بني إسرائيلَ."],[3,3,"أَسۡبَاطًا","جمعُ سِبْطٍ، وهو ولَدُ الوَلَدِ، والمرادُ: قبائلُ بعددِ الأسباطِ مِن ولَدِ يعقوبَ."],[15,15,"فَٱنۢبَجَسَتۡ","فانفجرَتْ."],[27,27,"ٱلۡغَمَـٰمَ","السَّحابَ."],[30,30,"ٱلۡمَنَّ","شيءٌ يُشْبِهُ الصَّمْغَ، طعمُه كالعَسَل."],[31,31,"وَٱلسَّلۡوَىٰ","طائرٌ يُشْبِهُ السُّمانى."]],"161":[[5,5,"ٱلۡقَرۡيَةَ","بيتَ المَقْدِسِ:"],[11,11,"حِطَّةٌ","مسألتُنا حِطَّةٌ، أي: حُطَّ عنا ذنوبَنا."],[14,14,"سُجَّدًا","خاضِعين للهِ تواضُعًا."]],"162":[[11,11,"رِجۡزًا","عذابًا."]],"163":[[5,6,"حَاضِرَةَ ٱلۡبَحۡرِ","قريبةً من البحرِ الأحمرِ مُشْرِفةً عليه."],[7,8,"إِذۡ يَعۡدُونَ","إذ يعتدي أهلُ القريةِ بصيدِ السمكِ."],[9,10,"فِي ٱلسَّبۡتِ","في يومِ السبتِ الذي أُمِرُوا بتعظيمِه."],[16,16,"شُرَّعًا","ظاهرةً على وجهِ البحرِ قريبةً من الشاطئ."],[17,19,"وَيَوۡمَ لَا يَسۡبِتُونَ","وفي سائرِ الأيام غيرِ يومِ السبتِ."],[23,23,"نَبۡلُوهُم","نَخْتَبِرُهم."]],"164":[[13,14,"قَالُواْ مَعۡذِرَةً","نَعِظُهم لنُعْذَرَ فيهم عندَ اللهِ."]],"165":[[14,14,"بَـِٔيسِۭ","أليمٍ شديدٍ."]],"166":[[1,1,"عَتَوۡاْ","تمرَّدوا وتكبَّروا."]],"167":[[1,1,"تَأَذَّنَ","أعلمَ."],[3,3,"لَيَبۡعَثَنَّ","ليُسَلِّطَنَّ."],[9,9,"يَسُومُهُمۡ","يُذيقُهم."]],"168":[[0,0,"وَقَطَّعۡنَـٰهُمۡ","وفَرَّقْنا بني إسرائيلَ."],[9,9,"وَبَلَوۡنَـٰهُم","واخَتَبْرناهم."]],"169":[[0,0,"خَلۡفٌ","مَن يَخْلُفُ غيرَه بالسُّوءِ."],[7,9,"عَرَضَ هَـٰذَا ٱلۡأَدۡنَىٰ","ما يَعْرِضُ لهم من متاعِ الدنيا مِن دنيءِ المكاسبِ، كالرِّشوةِ والتحريفِ."],[15,16,"عَرَضٌ مِّثۡلُهُۥ","متاعٌ زائلٌ من أنواعِ الكسبِ الحرامِ."],[21,22,"مِّيثَـٰقُ ٱلۡكِتَـٰبِ","ما أخذه اللهُ عليهم من العهودِ في التوراةِ على العملِ بها."],[30,32,"وَدَرَسُواْ مَا فِيهِ","وعَلِمُوا ما في التوراةِ، فضيَّعوها وتَرَكُوا العملَ بها."]],"170":[[1,1,"يُمَسِّكُونَ","يتمسَّكون."]],"171":[[1,1,"نَتَقۡنَا","اقتلَعْنا ورَفَعْنا."],[5,5,"ظُلَّةٌ","سَحابةٌ تُظِلُّهم."],[6,6,"وَظَنُّوٓاْ","وأيقَنُوا."],[8,9,"وَاقِعُۢ بِهِمۡ","إن لم يقبَلُوا أحكامَ التوراةِ."],[13,13,"بِقُوَّةٍ","بجِدٍّ واجتهادٍ."],[14,16,"وَٱذۡكُرُواْ مَا فِيهِ","بالعملِ بما فيه."]],"172":[[1,1,"أَخَذَ","استخرج."],[9,11,"وَأَشۡهَدَهُمۡ عَلَىٰٓ أَنفُسِهِمۡ","وقرَّرَهم -جميعًا- بتوحيدِه بما أوْدَعَه في فِطَرِهم."],[17,18,"أَن تَقُولُواْ","لئلا تقولوا."]],"173":[[11,11,"أَفَتُهۡلِكُنَا","أفتعذِّبُنا."],[14,14,"ٱلۡمُبۡطِلُونَ","الذين أبْطَلُوا أعمالهم بالإشراكِ بالله."]],"174":[[1,1,"نُفَصِّلُ","نبيِّنُ."]],"175":[[0,0,"وَٱتۡلُ","واقصُصْ."],[2,2,"نَبَأَ","خبرَ رجلٍ من بني إسرائيلَ."],[4,5,"ءَاتَيۡنَـٰهُ ءَايَـٰتِنَا","أتاه اللهُ علمًا ببعض الكتبِ المنزَّلَةِ."],[6,7,"فَٱنسَلَخَ مِنۡهَا","ثم كَفَرَ بها وجَعَلَها وراءَ ظهرِه."],[8,9,"فَأَتۡبَعَهُ ٱلشَّيۡطَـٰنُ","لَحِقه فأدركَه فصارَ قرينَه."],[12,12,"ٱلۡغَاوِينَ","الضالِّين الراسِخين في الضلالِ."]],"176":[[2,2,"لَرَفَعۡنَـٰهُ","لَرَفَعْنا قَدْرَه بالعلمِ والعملِ بها."],[5,7,"أَخۡلَدَ إِلَى ٱلۡأَرۡضِ","رَكَنَ إلى الدُّنيا، واطمأَنَّ بها."]],"177":[[0,0,"سَآءَ","قَبُحَ."],[8,8,"يَظۡلِمُونَ","بالتكذيب وأنواع المعاصي."]],"178":[[0,2,"مَن يَهۡدِ ٱللَّهُ","مَن يُوَفِّقْه للإيمانِ والعَمَلِ الصالحِ."]],"179":[[1,1,"ذَرَأۡنَا","خَلَقْنا."],[9,11,"لَّا يَفۡقَهُونَ بِهَا","لا يفْهمون بها الحقَّ ولا يَعْقلون."],[23,23,"كَٱلۡأَنۡعَـٰمِ","كالبَهائمِ التي لا تفقَهُ ما يُقالُ لها، ولا تُمَيِّزُ."]],"180":[[3,4,"فَٱدۡعُوهُ بِهَا","فاطْلُبُوا من الله بأسمائِه ما تُريدون."],[5,5,"وَذَرُواْ","واترُكُوا."],[7,9,"يُلۡحِدُونَ فِيٓ أَسۡمَـٰٓئِهِۦ","يَميلون بها عَمّا جُعِلَتْ له."]],"181":[[3,4,"يَهۡدُونَ بِٱلۡحَقِّ","يَسْتقيمون على الحقِّ، ويَدْعُون الناسَ إلى الهدايةِ."],[5,6,"وَبِهِۦ يَعۡدِلُونَ","وبالحقِّ يقْضُون بينَ الناسِ."]],"182":[[3,3,"سَنَسۡتَدۡرِجُهُم","سَنُدْنِيهم -في حالِ اغْتِرارِهم- إلى ما يُهْلِكُهم ويضاعِفُ عِقابَهم."]],"183":[[0,1,"وَأُمۡلِي لَهُمۡ","وأمْهِلُهم مدةً طويلةً."],[4,4,"مَتِينٌ","قويٌّ لا يُدْفَعُ."]],"184":[[5,5,"جِنَّةٍ","جُنونٍ."]],"185":[[3,3,"مَلَكُوتِ","المُلْكِ العظيمِ. (زِيدت فيه الواوُ والتاء للمبالغةِ)."],[20,20,"بَعۡدَهُۥ","بعد القرآنِ العظيمِ."]],"186":[[6,6,"وَيَذَرُهُمۡ","ويَتْرُكُهم."],[8,8,"طُغۡيَـٰنِهِمۡ","ضَلالِهم وكُفْرِهم."],[9,9,"يَعۡمَهُونَ","يتردَّدُون مُتَحَيِّرين."]],"187":[[4,4,"مُرۡسَىٰهَا","قيامُها."],[10,11,"لَا يُجَلِّيهَا","لا يُظْهِرُها."],[15,18,"ثَقُلَتۡ فِي ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ","ثَقُلَ عِلْمُ قيامِ الساعةِ، وخَفِيَ على أهلِ السمواتِ والأرض."],[22,22,"بَغۡتَةً","فجأةً."],[25,26,"حَفِيٌّ عَنۡهَا","عالِمٌ بها، مُسْتَقْصٍ بالسؤالِ عنها."]],"189":[[4,5,"نَّفۡسٍ وَٰحِدَةٍ","هي آدمُ عليه السلام."],[6,7,"وَجَعَلَ مِنۡهَا","وخَلَقَ منها."],[8,8,"زَوۡجَهَا","هي حواءُ."],[9,10,"لِيَسۡكُنَ إِلَيۡهَا","ليأنسَ ويطمئِنَّ بها."],[12,12,"تَغَشَّىٰهَا","جامَعَها، والمرادُ جنسُ الزوجين مِن ذريةِ آدمَ."],[16,17,"فَمَرَّتۡ بِهِۦ","استمرَّ بذلك الحَمْلِ إلى تمامهِ."],[19,19,"أَثۡقَلَت","صارت ذات ثِقَلٍ بكِبَرِ الحَمْلِ."],[25,25,"صَـٰلِحًا","أي: خَلْقًا سَوِيًّا صالحًا."]],"190":[[3,3,"جَعَلَا","أي: الزوجان من ذريةِ آدمَ."],[4,5,"لَهُۥ شُرَكَآءَ","أي: للهِ في ذلك الوَلَدِ، كنَحْوِ تسميتِه: عبدَ العُزّى."]],"195":[[0,0,"أَلَهُمۡ","ألهذه الآلهة؟"],[7,7,"يَبۡطِشُونَ","يأخذُون بها، فَيدْفَعُون عنكم."],[24,25,"فَلَا تُنظِرُونِ","فلا تُمْهلوني بعد تدبيرِ كَيْدِكم."]],"196":[[1,1,"وَلِـِّۧيَ","مُتَوَلِّي حِفْظي وجميعِ أموري."],[5,5,"ٱلۡكِتَـٰبَ","القرآنَ العظيمَ."]],"199":[[0,0,"خُذِ","اقْبَلْ أنتَ وأمَّتُكَ."],[1,1,"ٱلۡعَفۡوَ","ما تيسَّرَ من أخلاقِ الناسِ وأعمالِهم."],[3,3,"بِٱلۡعُرۡفِ","هو كلُّ ما عُرِفَ حُسْنُه في الشَّرْعِ والعَقْلِ."]],"200":[[1,1,"يَنزَغَنَّكَ","يُصِيبَنَّك وسْوَسَةٌ."],[5,6,"فَٱسۡتَعِذۡ بِٱللَّهِ","فاستَجِرْ به والَجأْ إليه."]],"201":[[2,2,"ٱتَّقَوۡاْ","خافُوا اللهَ بفِعْلِ أوامرِه وتَرْكِ نواهِيه."],[5,7,"طَـٰٓئِفٌ مِّنَ ٱلشَّيۡطَـٰنِ","عارضٌ من وسْوَسَتِه."],[8,8,"تَذَكَّرُواْ","عقابَ اللهِ وثوابَه."],[11,11,"مُّبۡصِرُونَ","مُنْتَهُون عن المعصيةِ على بَصيرةٍ."]],"202":[[0,0,"وَإِخۡوَٰنُهُمۡ","وإخوانُ الشَّياطين."],[1,1,"يَمُدُّونَهُمۡ","يَزيدُونهم."],[3,3,"ٱلۡغَيِّ","الضَّلالِ."],[5,6,"لَا يُقۡصِرُونَ","لا يَكُفُّون عن الإغواءِ."]],"203":[[3,3,"بِـَٔايَةٍ","بعلامةٍ دالَّةٍ على صِدْقِك."],[6,6,"ٱجۡتَبَيۡتَهَا","اختلَقْتَها واخترَعْتَها."],[15,15,"هَـٰذَا","أي القرآنُ المجيدُ."],[16,16,"بَصَآئِرُ","جمعُ بَصيرةٍ، وهي الحُجَجُ والبراهينُ التي يُسْتَبصَرُ بها."],[19,19,"وَهُدًى","بيانٌ يَهْدي المؤمنين."]],"205":[[4,4,"تَضَرُّعًا","تَذَلُّلًا وخُضوعًا."],[5,5,"وَخِيفَةً","خائفًا منه تعالى."],[6,7,"وَدُونَ ٱلۡجَهۡرِ","متوسِّطًا بين الَجهْرِ والإسرارِ."],[10,10,"بِٱلۡغُدُوِّ","أولِ النهارِ."],[11,11,"وَٱلۡـَٔاصَالِ","جمعُ أصيلٍ، وهو من العَصْرِ إلى المغربِ، والمرادُ: آخرُ النهارِ."]],"206":[[8,8,"وَيُسَبِّحُونَهُۥ","يُنَزِّهُونه عن كلِّ ما لا يليقُ به."]]}