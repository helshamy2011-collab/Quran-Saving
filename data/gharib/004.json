{"1":[[6,8,"مِّن نَّفۡسٍ وَٰحِدَةٍ","هي آدَمُ."],[11,11,"زَوۡجَهَا","هي حَوّاءُ، خُلِقَتْ من ضِلْعٍ من أضلاعِ آدمَ."],[12,13,"وَبَثَّ مِنۡهُمَا","نَشَر من آدمَ وحَواءَ."],[20,21,"تَسَآءَلُونَ بِهِۦ","يَسْألُ به بعضُكم بعضًا، فيقولُ السائلُ: أسألُك باللهِ."],[22,22,"وَٱلۡأَرۡحَامَ","واتقوا الأرحامَ أن تقطعُوها."]],"2":[[0,0,"وَءَاتُواْ","وأَعطُوا يا أوصياءَ اليتامى."],[1,1,"ٱلۡيَتَـٰمَىٰٓ","هم مَن ماتَ آباؤهم وهم دونَ البلوغ. وإعطاؤُهم المالَ إذا وصَلُوا سِنَّ البُلوغِ، وأصبح لديهم قُدْرَةٌ على حِفْظِ المالِ."],[3,6,"وَلَا تَتَبَدَّلُواْ ٱلۡخَبِيثَ بِٱلطَّيِّبِ","ولا تأخُذوا الجيِّدَ من أموالهِم، وتجعلُوا مكانَه الرديءَ من أموالِكم."],[7,11,"وَلَا تَأۡكُلُوٓاْ أَمۡوَٰلَهُمۡ إِلَىٰٓ أَمۡوَٰلِكُمۡ","ولا تَخْلِطُوا أموالَهم بأموالِكم، فتأكلُوها مع أموالِكم."],[14,14,"حُوبًا","إثْمًا وظُلمًا."]],"3":[[3,3,"تُقۡسِطُواْ","تَعْدِلُوا."],[4,5,"فِي ٱلۡيَتَـٰمَىٰ","في يَتامى النساءِ اللاتي تحتَ أيديكم بألّا تُعْطُوهنَّ مهورَهنَّ كغيرِهنَّ، فلا تَنْكِحُوهن، وانكِحُوا غيرَهن."],[8,8,"طَابَ","حَلَّ."],[25,27,"أَدۡنَىٰٓ أَلَّا تَعُولُواْ","أقربُ إلى ألّا تَجُوروا، ولا تَميلوا."]],"4":[[2,2,"صَدُقَـٰتِهِنَّ","مُهورِهنَّ."],[3,3,"نِحۡلَةً","عَطِيةً واجبةً."],[8,9,"شَيۡءٍ مِّنۡهُ","شيءٍ من المَهْرِ، فوَهَبْنَه لكم."]],"5":[[2,2,"ٱلسُّفَهَآءَ","المضَيِّعين لما لِهم بسوءِ تَدْبيرِهم."],[8,8,"قِيَـٰمًا","قِوامَكم في مَعايِشكم."]],"6":[[0,0,"وَٱبۡتَلُواْ","واختبِرُوهم لمعرفةِ قُدُراتِهم."],[4,5,"بَلَغُواْ ٱلنِّكَاحَ","وصَلُوا إلى سِنِّ البلوغِ."],[7,9,"ءَانَسۡتُم مِّنۡهُمۡ رُشۡدًا","عَلِمْتُمْ منهم صَلاحًا في العقلِ والدِّين."],[15,15,"إِسۡرَافًا","بغيرِ ما أباحَه اللهُ لكم."],[16,16,"وَبِدَارًا","ومُبادرةً لأَكْلِها."],[17,18,"أَن يَكۡبَرُواْ","قبل أن يكبَرُوا فيأ خُذُوها منكم."],[27,27,"بِٱلۡمَعۡرُوفِ","بقَدْرِ حاجتِه عند الضرورةِ على وجْه القَرْضِ."],[32,32,"فَأَشۡهِدُواْ","بأَنْ يَشْهَدَ شهودٌ معكم."],[36,36,"حَسِيبًا","محاسِبًا."]],"7":[[0,0,"لِّلرِّجَالِ","للذُّكورِ من أولادِ الميتِ صغارًا وكبارًا."]],"8":[[3,4,"أُوْلُواْ ٱلۡقُرۡبَىٰ","ممَّن لا حَقَّ لهم في التَّرِكَةِ."],[7,8,"فَٱرۡزُقُوهُم مِّنۡهُ","على وجهِ الاستحبابِ."]],"9":[[10,11,"فَلۡيَتَّقُواْ ٱللَّهَ","في ذلك النهيُ عن الإجحافِ بالورثةِ الضعفاءِ، فلايزيدُ في وصيَّتِه لغيرِهمِ على الثلث، وكذلك إنْ تَرَكهم أغنياءَ حَسُنَ أن يُوصيَ لغيرِهم."]],"10":[[12,12,"سَعِيرًا","نارًا مُوقدةً."]],"11":[[4,7,"لِلذَّكَرِ مِثۡلُ حَظِّ ٱلۡأُنثَيَيۡنِ","إذا لم يكن هناك وارثٌ غيرُ أولادِه."],[40,41,"فَلِأُمِّهِ ٱلثُّلُثُ","ولأبيه الباقي."],[48,50,"مِنۢ بَعۡدِ وَصِيَّةٍ","هذه القِسْمَةُ للتَّرِكَةِ بعد إخراجِ وصيةِ الميتِ بما لايتجاوزُ الثلثَ."]],"12":[[8,9,"لَّهُنَّ وَلَدٌ","ذكرًا أو أنثى."],[18,20,"مِنۢ بَعۡدِ وَصِيَّةٍ","من بعدِ إنفاذِ وصِيَّتِهنّ الجائزةِ."],[32,33,"لَّكُمۡ وَلَدٌ","ذَكَرًا أو أنثى، منهن، أو من غيرِهنّ."],[53,53,"كَلَـٰلَةً","هو الميتُ الذي لا ولَدَ له ولا والدَ"],[57,59,"أَخٌ أَوۡ أُخۡتٌ","من أُمّ."],[80,81,"غَيۡرَ مُضَآرٍّ","لا ضَرَرَ فيه على الوَرَثَةِ، فإنْ قَصَدَ صاحبُها الضَّرَرَ لوَرَثَتِه فهو باطلٌ لا يَنْفُذُ."]],"14":[[12,12,"مُّهِينٌ","مُخْزٍ."]],"15":[[2,2,"ٱلۡفَـٰحِشَةَ","الزِّنى."],[11,11,"فَأَمۡسِكُوهُنَّ","فاحبِسُوهُنَّ، وكان هذا قبل نَسْخِها."],[21,21,"سَبِيلًا","مَخْرَجًا، والسبيلُ هو: الحُكْمُ بالرَّجْمِ للمُحْصَنِ والمحصَنةِ، والجلْدِ مئةَ جَلْدَةٍ، وتَغْريبِ عامٍ لغيرهما."]],"16":[[1,1,"يَأۡتِيَـٰنِهَا","أي: فاحشةَ الزِّنى."],[3,3,"فَـَٔاذُوهُمَا","بالضَّرْبِ، والهَجْرِ والتوبيخِ، ثم نُسِخَ بالجلْدِ والرَّجْمِ."]],"17":[[2,3,"عَلَى ٱللَّهِ","فهو الذي يقبَلُها."],[7,7,"بِجَهَـٰلَةٍ","بجَهْلٍ منهم لعاقِبَتِها، وإيجابِها لسَخَطِ اللهِ."]],"19":[[9,9,"كَرۡهًا","هُنَّ كارهاتٌ لذلك، وكانوا في الجاهليَّةِ يجعلون نِساءَ الآباءِ والأقاربِ من التَّرِكَةِ، فيتزوَّجُون بهنَّ."],[10,11,"وَلَا تَعۡضُلُوهُنَّ","لا يَحِلُّ لكم أن تَحْبِسُوا زوجاتِكم عندَكم مع عَدَمِ رغبتِكم فيهن، وذلك لقَصْدِ أن يفتَدِينَ ببعضِ المهْرِ من الحبْسِ."],[19,20,"بِفَـٰحِشَةٍ مُّبَيِّنَةٍ","بالزِّنى البيِّنِ، أو بذاءةِ اللسانِ، أو النُّشوزِ."]],"20":[[7,7,"إِحۡدَىٰهُنَّ","هي مَن تُريدون طَلاقَها."],[8,8,"قِنطَارًا","مالًا كثيرًا مَهْرًا لها."],[14,14,"بُهۡتَـٰنًا","ظُلمًا بغيرِ حَقّ."]],"21":[[3,3,"أَفۡضَىٰ","بالجِماعِ."],[9,10,"مِّيثَـٰقًا غَلِيظًا","إمساكَهُنَّ بمعروفٍ، أو تَسْرِيحَهُنَّ بإحسانٍ."]],"22":[[10,10,"سَلَفَ","مضى في الجاهلية، فلا مُؤاخَذَةَ فيه."],[14,14,"وَمَقۡتًا","وبُغْضًا، أي: يُبْغِضُ اللهُ فاعلَه."]],"23":[[2,2,"أُمَّهَـٰتُكُمۡ","ويَدْخُلُ فيه الجَدّاتُ."],[3,3,"وَبَنَاتُكُمۡ","ويشْمَلُ بناتِ الأولادِ."],[4,4,"وَأَخَوَٰتُكُمۡ","الشقيقاتُ، أو لأبٍ، أو لأمّ."],[17,18,"وَأُمَّهَـٰتُ نِسَآئِكُمۡ","سواءٌ أدخَلْتُمْ بنسائكم أم لا."],[19,19,"وَرَبَـٰٓئِبُكُمُ","وبناتُ نسائِكم من غيرِكم، اللاتي يتربَّينَ في بيوتِكم، فإن لم يكونوا كذلك، ولم تَدْخُلوا بأمَّهاتِهن وطَلَّقْتموهن، أو مِتْنَ قبلَ الدُّخولِ، فلا جُناحَ عليكم أن تنكِحُوهنّ."],[36,37,"وَحَلَـٰٓئِلُ أَبۡنَآئِكُمُ","زوجاتُ أبنائِكم ممَّن دَخَلَ الابنُ بها، أو لَم يدْخُلْ."]],"24":[[0,0,"وَٱلۡمُحۡصَنَـٰتُ","يَحْرُمُ نِكاحُ ذَواتِ الأزواج غيرِ المَسْبِيّات."],[4,6,"مَا مَلَكَتۡ أَيۡمَـٰنُكُمۡ","مَن سَبَيْتم في الجهادِ، فيَحِلُّ النكاحُ بعد الاستِبْراءِ بحَيْضَةٍ، من غير طلاقِ زوجِها الحربيِّ لها."],[12,14,"مَّا وَرَآءَ ذَٰلِكُمۡ","مِن سِواهنّ."],[18,18,"مُّحۡصِنِينَ","أعِفّاءَ."],[19,20,"غَيۡرَ مُسَـٰفِحِينَ","غيرَ زانِين."],[26,26,"أُجُورَهُنَّ","مُهورَهُنَّ وهذا في النِّكاحِ الشَّرْعيِّ."],[34,36,"مِنۢ بَعۡدِ ٱلۡفَرِيضَةِ","من زيادةٍ أو نقصانٍ في المهْرِ، فذلك سائغٌ عند التَّراضي."]],"25":[[4,4,"طَوۡلًا","قُدرةً وسَعَةً، وهو المَهْرُ لنِكاحِ الحَرائرِ."],[19,21,"بَعۡضُكُم مِّنۢ بَعۡضٍ","في النسَبِ والدِّينِ."],[23,24,"بِإِذۡنِ أَهۡلِهِنَّ","بموافقةِ سَيّدِهن؛ لأنّ منافعَهنّ له."],[33,33,"أَخۡدَانٍ","ولا مُسِرّاتٍ بالزِّنى باتخاذِ أصدقاءَ."],[39,39,"فَعَلَيۡهِنَّ","فعلى الإماءِ خمسون جَلْدَةً، ونَفْيُ ستةِ أشهرٍ، وليس على الإماءِ رَجْمٌ لأنه لايَتَنَصَّفُ."],[46,46,"ذَٰلِكَ","أي: ما أُبيحَ لكم من نِكاحِ الإماءِ."],[48,49,"خَشِيَ ٱلۡعَنَتَ","خوفَ الوقوعِ في الزِّنى والمشقَّةِ."],[51,52,"وَأَن تَصۡبِرُواْ","عن نكاحِ الإماء مع العفَّةِ."]],"26":[[5,5,"سُنَنَ","طُرُقَ الأنبياءِ وأتباعِهم لتَقْتَدُوا بها."]],"27":[[7,8,"يَتَّبِعُونَ ٱلشَّهَوَٰتِ","يَنْقادُون لشهَواتِ أنفسِهم من أهلِ الباطلِ."],[10,10,"تَمِيلُواْ","تَنْحَرفُوا عن الدِّينِ بإتيانِكم ما حَرَّمَ عليكم."]],"28":[[2,3,"أَن يُخَفِّفَ","أن يُيَسِّرَ عليكم."]],"29":[[7,7,"بِٱلۡبَـٰطِلِ","كالرِّبا والقِمار."],[11,11,"تِجَـٰرَةً","موافِقَةً للشَّرعِ."],[15,17,"وَلَا تَقۡتُلُوٓاْ أَنفُسَكُمۡ","بألّا تُهْلِكُوها بارتكابِ المعاصي، وألّا يقتلَ بعضُكم بعضًا، وألّا يقتلَ نفسَه حقيقةً."]],"30":[[2,2,"ذَٰلِكَ","ما نهى اللهُ عنه مما تقدَّم."],[3,3,"عُدۡوَٰنًا","متجاوِزًا حَدَّ الشَّرْعِ."]],"31":[[2,5,"كَبَآئِرَ مَا تُنۡهَوۡنَ عَنۡهُ","هي كلُّ ذَنْبٍ رَتَّبَ اللهُ عليه الحَدَّ، أو صَرَّح بالوعيدِ فيه."],[8,8,"سَيِّـَٔاتِكُمۡ","الصَّغائرَ."],[10,11,"مُّدۡخَلًا كَرِيمًا","الجنةَ."]],"32":[[2,8,"مَا فَضَّلَ ٱللَّهُ بِهِۦ بَعۡضَكُمۡ عَلَىٰ بَعۡضٍ","ما فَضَّل اللهُ به غيرَكم عليكم في المواهِبِ والأرزاقِ."],[10,10,"نَصِيبٌ","مقدارٌ من الجزاءِ بحسَبِ العملِ."],[19,20,"مِن فَضۡلِهِۦٓ","من عَوْنِه، وتوفيقِه."]],"33":[[0,0,"وَلِكُلٍّ","ولكلِّ واحدٍ."],[2,2,"مَوَٰلِيَ","ورَثَةٌ يرثُون."],[8,9,"عَقَدَتۡ أَيۡمَـٰنُكُمۡ","تحالَفْتُم معهم بالأيمانِ على النُّصرةِ، وإعطائِهم قَدْرًا من الميراثِ، وهذا منسوخٌ."]],"34":[[1,1,"قَوَّٰمُونَ","أهلُ قيامٍ بمصالحهنَّ."],[4,6,"بِمَا فَضَّلَ ٱللَّهُ","بما خَصَّهم من القِوامةِ والتفضيلِ، كالإنفاقِ وكفايةِ المؤونةِ."],[15,15,"قَـٰنِتَـٰتٌ","مطيعاتٌ لله، قائماتٌ بحقوقِ الزوج."],[16,17,"حَـٰفِظَـٰتٌ لِّلۡغَيۡبِ","حافظاتٌ لمايَجبُ حِفْظُه عند غَيبةِ أزواجِهنَّ عنهن."],[18,20,"بِمَا حَفِظَ ٱللَّهُ","بحِفْظِ اللهِ، وتوفيقِه لهن."],[23,23,"نُشُوزَهُنَّ","استعلاءَهن على أزواجِهنَّ."],[24,24,"فَعِظُوهُنَّ","بالكلمةِ الطيبةِ، إن نفعَتْ."],[27,27,"ٱلۡمَضَاجِعِ","جَمْعُ مَضْجَع، وهو الفِراشُ، فلا تَقْرَبُوهنَّ، إنْ نَفَعَ ذلك."],[28,28,"وَٱضۡرِبُوهُنَّ","ضَرْبًا غيرَ مُبَرِّحٍ أومؤثِّرٍ."],[31,34,"فَلَا تَبۡغُواْ عَلَيۡهِنَّ سَبِيلًا","فاحذَرُوا ظُلْمَهنَّ."]],"35":[[4,4,"فَٱبۡعَثُواْ","أي: إلى الزوجَيْن."],[5,5,"حَكَمًا","عَدْلًا ممَّنْ يَصْلُحُ لذلك."],[16,16,"بَيۡنَهُمَآ","بينَ الزوجَين، أو الحكَمَين."]],"36":[[10,10,"وَٱلۡيَتَـٰمَىٰ","الأولادِ الذين ماتَ أباؤُهم وهم دونَ البُلوغ."],[11,11,"وَٱلۡمَسَـٰكِينِ","الذين لا يملِكُون ما يَكْفيهم."],[16,16,"ٱلۡجُنُبِ","البعيدِ."],[17,18,"وَٱلصَّاحِبِ بِٱلۡجَنۢبِ","الرفيقِ في السَّفَر والحَضَرِ."],[19,20,"وَٱبۡنِ ٱلسَّبِيلِ","المسافرِ المحتاجِ."],[21,23,"وَمَا مَلَكَتۡ أَيۡمَـٰنُكُمۡ","الرقيقِ ذكورًا وإناثًا."]],"37":[[11,11,"وَأَعۡتَدۡنَا","وأَعْدَدْنا."],[14,14,"مُّهِينًا","مُخْزِيًا."]],"38":[[3,4,"رِئَآءَ ٱلنَّاسِ","من أجلِ الرِّياءِ والسُّمعةِ."],[15,15,"قَرِينًا","مُلازِمًا له، ويعملُ بطاعتِه."]],"39":[[0,1,"وَمَاذَا عَلَيۡهِمۡ","وأيُّ ضررٍ يَلْحقهم؟"]],"40":[[2,5,"لَا يَظۡلِمُ مِثۡقَالَ ذَرَّةٍ","لا يُنْقِصُ أحدًا من جزاءِ عَمَلِه مقدارَ ذَرّة."]],"41":[[0,0,"فَكَيۡفَ","فكيف يكون حالُ الناسِ يومَ القيامةِ؟"],[8,8,"بِكَ","أيها الرسولُ."],[9,10,"عَلَىٰ هَـٰٓؤُلَآءِ","على أمَّتِك."],[11,11,"شَهِيدًا","شاهدًا على الأمَّةِ بما عَمِلت."]],"42":[[7,9,"تُسَوَّىٰ بِهِمُ ٱلۡأَرۡضُ","يجعلهم الله والأرضَ سواءً، فيصيرون ترابًا."],[10,11,"وَلَا يَكۡتُمُونَ","ولا يُخْفُون عن اللهِ شيئًا، وسوف تَشْهَدُ على عَمَلِهم جَوارحُهم."]],"43":[[6,7,"وَأَنتُمۡ سُكَـٰرَىٰ","نَزَلَ هذا الحكمُ قبلَ تحريمِ الخمرِ."],[15,16,"عَابِرِي سَبِيلٍ","مَن كان مُجتازًا من باب المسجد، أوهو المسافر."],[32,32,"لَـٰمَسۡتُمُ","جامَعْتُمْ."],[37,39,"فَتَيَمَّمُواْ صَعِيدًا طَيِّبًا","فاقصِدوا ترابًا طاهرًا."]],"44":[[5,7,"نَصِيبًا مِّنَ ٱلۡكِتَـٰبِ","حَظًّا من العِلْم بالتوراةِ."],[13,13,"ٱلسَّبِيلَ","الطريقَ المستقيمَ."]],"45":[[5,5,"وَلِيًّا","يَتَوَلّاكم."]],"46":[[2,2,"هَادُواْ","هم اليهودُ."],[3,4,"يُحَرِّفُونَ ٱلۡكَلِمَ","بتغييرِ اللفظِ أو المعنى أو هما جميعًا."],[11,12,"غَيۡرَ مُسۡمَعٍ","لا سَمِعْتَ، وهذا من قَبيلِ الاستهزاءِ."],[13,13,"وَرَٰعِنَا","افهَمْ عنا، وأفْهِمْنا."],[14,15,"لَيَّۢا بِأَلۡسِنَتِهِمۡ","يَلْوُون ألسنتَهم عن الحق."],[24,24,"وَٱسۡمَعۡ","دونَ «غيرَ مُسْمَعٍ»."],[25,25,"وَٱنظُرۡنَا","انتظِرْنا نَفْهَمْ عنك، بَدَلَ «راعِنا»."],[29,29,"وَأَقۡوَمَ","وأصوبَ قولًا."],[31,31,"لَّعَنَهُمُ","طَرَدَهم من رحمتِه."]],"47":[[8,9,"لِّمَا مَعَكُم","من الكُتُبِ."],[12,17,"أَن نَّطۡمِسَ وُجُوهًا فَنَرُدَّهَا عَلَىٰٓ أَدۡبَارِهَآ","نَمْحُوَ الوجوهَ، ونجعلَ أبصارَها في أدبارِ الوجوهِ."],[22,23,"أَصۡحَـٰبَ ٱلسَّبۡتِ","هم اليهودُ الذين نُهُوا عن الصَّيدِ في يومِ السبت، فلم يَنْتَهُوا."],[27,27,"مَفۡعُولًا","كائنًا لا محالةَ."]],"49":[[4,4,"يُزَكُّونَ","يُثْنُون، وهم اليهودُ."]],"51":[[5,5,"نَصِيبًا","حَظًّا."],[9,10,"بِٱلۡجِبۡتِ وَٱلطَّـٰغُوتِ","هما كلُّ معبودٍ من دونِ اللهِ، أو مُطاعٍ في معصيته."]],"53":[[2,2,"نَصِيبٌ","حَظٌّ."],[5,7,"فَإِذًا لَّا يُؤۡتُونَ","إن جُعِلَ لهم ذلك فإذن لايُعْطُون، لشِدَّةِ بُخْلِهم."],[9,9,"نَقِيرًا","النُّقطةَ في ظَهْر النَّواةِ، أو وسَطِها."]],"54":[[2,2,"ٱلنَّاسَ","محمدًا وأصحابَه."],[8,8,"فَضۡلِهِۦ","النبوَّةِ، والنصْرِ."],[9,12,"فَقَدۡ ءَاتَيۡنَآ ءَالَ إِبۡرَٰهِيمَ","فكيف لا يَحْسُدون آلَ إبراهيمَ، واليهودُ يعترفون به؟ فما آتينا محمدًا ليس ببِدْعٍ حتى يُحْسَدَ عليه."],[14,14,"ٱلۡحِكۡمَةَ","ما أُوحِي إليهم من غيرِ الكتابِ."],[16,17,"مُّلۡكًا عَظِيمًا","مُلْكَ سليمانَ."]],"55":[[10,10,"سَعِيرًا","نارًا تُوقَدُ عليهم."]],"56":[[8,8,"نَضِجَتۡ","احترقَتْ."]],"57":[[16,16,"مُّطَهَّرَةٌ","من كلِّ دَنَسٍ يكونُ في نساءِ أهلِ الدُّنيا."],[19,19,"ظَلِيلًا","كثيفًا ممتدًّا."]],"58":[[17,17,"نِعِمَّا","نِعْمَ الشيءُ."]],"59":[[7,8,"وَأُوْلِي ٱلۡأَمۡرِ","الأئمةَ، ومَن ولّاه المسلمون، مالم يَكُنْ في طاعتِهم معصيةٌ."],[14,14,"فَرُدُّوهُ","أرْجِعُوا الحُكْمَ فيه."],[27,27,"تَأۡوِيلًا","عاقبةً ومَرْجِعًا."]],"60":[[8,9,"أُنزِلَ إِلَيۡكَ","هوالقرآنُ."],[18,18,"ٱلطَّـٰغُوتِ","غيرِ ما شَرَع الله."]],"61":[[12,12,"يَصُدُّونَ","يُعْرِضُون."]],"62":[[0,0,"فَكَيۡفَ","فكيف يكون حالُهم؟"],[15,15,"وَتَوۡفِيقًا","بين الخُصومِ."]],"63":[[9,9,"وَعِظۡهُمۡ","خَوِّفْهم من النِّفاقِ."],[15,15,"بَلِيغًا","مُؤَثِّرًا، زاجرًا لهم."]],"65":[[7,8,"شَجَرَ بَيۡنَهُمۡ","وقَعَ بينَهم من نِزاعٍ."],[14,14,"حَرَجًا","ضِيقًا."],[17,17,"وَيُسَلِّمُواْ","ويَنْقادوا."]],"66":[[2,2,"كَتَبۡنَا","فَرَضْنا."],[5,6,"ٱقۡتُلُوٓاْ أَنفُسَكُمۡ","أن يقتُلَ بعضُكم بعضًا."],[19,21,"مَا يُوعَظُونَ بِهِۦ","مايُنْصَحُون به."],[26,26,"تَثۡبِيتًا","تَصْديقًا."]],"68":[[1,1,"صِرَٰطًا","طريقًا."]],"71":[[3,4,"خُذُواْ حِذۡرَكُمۡ","بالاستعدادِ لعدوِّكم."],[6,6,"ثُبَاتٍ","جَمْعُ ثُبَة، وهي الجماعةُ بعدَ جماعةٍ."]],"72":[[16,16,"شَهِيدًا","حاضِرًا، فيُصِبْني شيءٌ."]],"73":[[6,11,"كَأَن لَّمۡ تَكُنۢ بَيۡنَكُمۡ وَبَيۡنَهُۥ مَوَدَّةٌ","كأنه ليس منكم، ولا بينَكم وبينَه مودةُ الإيمانِ؛ حَسَدًا منه."]],"74":[[5,5,"يَشۡرُونَ","يَبِيعون."]],"75":[[18,18,"ٱلۡقَرۡيَةِ","مكَّةَ."]],"76":[[11,11,"ٱلطَّـٰغُوتِ","البَغْيِ والفسادِ في الأرضِ."],[16,17,"كَيۡدَ ٱلشَّيۡطَـٰنِ","تدبيرَه."]],"77":[[6,7,"كُفُّوٓاْ أَيۡدِيَكُمۡ","لا تُقاتِلوا، وذلك قبلَ الإذنِ بالجِهادِ."],[35,35,"أَجَلٍ","وقتٍ."],[47,47,"فَتِيلًا","مقدارَ الخيطِ في شِقِّ نَواةِ التمرةِ."]],"78":[[7,8,"بُرُوجٍ مُّشَيَّدَةٍ","حُصونٍ مَنيعةٍ."],[14,15,"مِنۡ عِندِكَ","أيُّها الرسولُ، وهذا من جَهْلِهم."]],"79":[[10,11,"فَمِن نَّفۡسِكَ","بذَنْبٍ اكْتَسَبْتَه."],[17,17,"شَهِيدًا","على صِدْقِ رسالتِك."]],"80":[[7,7,"تَوَلَّىٰ","أعْرَضَ عن طاعةِ الله ورسولِه."],[11,11,"حَفِيظًا","حافظًا لما يعملون، مُحاسِبًا."]],"81":[[1,1,"طَاعَةٌ","أمْرُنا طاعةٌ."],[3,3,"بَرَزُواْ","خَرَجُوا."],[6,6,"بَيَّتَ","دَبَّر بلَيْلٍ."],[9,11,"غَيۡرَ ٱلَّذِي تَقُولُ","غيرَ ما أعْلَنُوه من الطاعةِ."],[23,23,"وَكِيلًا","ناصرًا."]],"83":[[1,1,"جَآءَهُمۡ","جاء هذه الطائفةَ المُبَيِّتَةَ."],[7,8,"أَذَاعُواْ بِهِۦ","أفشَوْه، وأعْلَنُوه."],[17,19,"لَعَلِمَهُ ٱلَّذِينَ يَسۡتَنۢبِطُونَهُۥ","لَعَلِمَ حقيقةَ معناه أهلُ الفقهِ والاستنباطِ منهم، فهم يعلمون ما ينبغي أن يُفْشى، أو يُكْتَمَ."]],"84":[[4,7,"لَا تُكَلَّفُ إِلَّا نَفۡسَكَ","لا تُلْزَمُ فِعْلَ غيرِك، ولا تُؤاخَذُ به."],[8,9,"وَحَرِّضِ ٱلۡمُؤۡمِنِينَ","وحُضَّهم على الجهادِ."],[13,13,"يَكُفَّ","يَمْنَعَ."],[14,14,"بَأۡسَ","شدَّةَ."],[21,21,"تَنكِيلًا","عقوبةً."]],"85":[[2,3,"شَفَـٰعَةً حَسَنَةً","هي السَّعْيُ لحصولِ الآخَرينَ على الخيرِ."],[7,7,"مِّنۡهَا","نصيبٌ مِن ثوابِها."],[14,14,"كِفۡلٌ","نَصِيبٌ من إثمِها."],[21,21,"مُّقِيتًا","قديرًا، أو حفيظًا شاهدًا."]],"86":[[14,14,"حَسِيبًا","مُجازِيًا."]],"88":[[4,4,"فِئَتَيۡنِ","فِرْقَتَين."],[6,6,"أَرۡكَسَهُم","رَدَّهم إلى الكفرِ، وأوقعَهم فيه."],[21,21,"سَبِيلًا","طَريقًا."]],"89":[[6,6,"سَوَآءً","كُفّارًا مِثْلَهم."],[10,10,"أَوۡلِيَآءَ","أصفياءَ."],[17,17,"تَوَلَّوۡاْ","أعرضُوا."]],"90":[[2,4,"يَصِلُونَ إِلَىٰ قَوۡمِۭ","يَتَّصِلُون بقومٍ."],[7,7,"مِّيثَـٰقٌ","عَهْدٌ."],[10,10,"حَصِرَتۡ","ضاقَتْ."],[29,29,"ٱلسَّلَمَ","الاستسلامَ."]],"91":[[1,1,"ءَاخَرِينَ","من المنافقين."],[11,11,"ٱلۡفِتۡنَةِ","الشِّركِ."],[12,12,"أُرۡكِسُواْ","ارتَدُّوا، ووَقَعُوا."],[16,16,"يَعۡتَزِلُوكُمۡ","يَنْصَرِفُوا عنكم."],[19,19,"ٱلسَّلَمَ","الاستسلامَ."],[25,25,"ثَقِفۡتُمُوهُمۡ","وجَدْتُموهم."],[30,30,"سُلۡطَـٰنًا","حُجَّةً بَيِّنَةً على قَتْلِهِم، أو أسْرِهم."]],"92":[[7,7,"خَطَـًٔا","مِن غيرِ عَمْدٍ."],[19,21,"إِلَّآ أَن يَصَّدَّقُواْ","إلا أن يَتَصدَّقُوا بها عليه، ويَعْفُوا."],[39,39,"مِّيثَـٰقٌ","عهدٌ."]],"94":[[8,8,"فَتَبَيَّنُواْ","كُونُوا على بَيِّنَةٍ فيمَن تقتُلونه."],[14,14,"ٱلسَّلَـٰمَ","بدا منه شيءٌ من علاماتِ الإسلام، لأنه قد يكونُ مؤمنًا يُخفي إيمانَه."],[26,28,"كُنتُم مِّن قَبۡلُ","تُخْفُون إيمانَكم عن قومِكم المشركين."],[29,31,"فَمَنَّ ٱللَّهُ عَلَيۡكُمۡ","فأعَزَّكم بالإيمانِ، والقوةِ."]],"95":[[2,2,"ٱلۡقَـٰعِدُونَ","المتخلِّفون عن الجهادِ."],[6,7,"أُوْلِي ٱلضَّرَرِ","أصحابِ الأعذارِ."],[22,22,"وَكُلًّا","وكلَّ أحدٍ من المجاهدين والقاعدين، من أهلِ الأعذارِ."],[25,25,"ٱلۡحُسۡنَىٰ","الجنةَ."]],"96":[[0,0,"دَرَجَـٰتٍ","منازلَ."]],"97":[[4,5,"ظَالِمِيٓ أَنفُسِهِمۡ","بقُعودِهم في دارِ الكفرِ، وتَرْكِ الهجرةِ."]],"98":[[6,8,"لَا يَسۡتَطِيعُونَ حِيلَةً","لايَقْدِرُون على دَفْعِ الظُّلمِ عنهم."]],"100":[[8,8,"مُرَٰغَمًا","مُتَحَوَّلًا."],[10,10,"سَعَةً","في الرِّزقِ."]],"101":[[1,1,"ضَرَبۡتُمۡ","سافَرْتُم."],[14,14,"يَفۡتِنَكُمُ","يَعْتدِيَ عليكم."]],"102":[[1,1,"كُنتَ","أي: في ساحةِ القتالِ، وأُقيمَت الصلاةُ."],[10,11,"وَلۡيَأۡخُذُوٓاْ أَسۡلِحَتَهُمۡ","هم الطائفةُ التي تُصَلِّي معه، تحملُ سلاحَها، وتُصَلي مع الإمامِ رَكعةً واحدةً، ثم يأخُذون مكانَ الطائفةِ التي لم تُصَلِّ."],[14,14,"فَلۡيَكُونُواْ","هم الطائفةُ القائمةُ بإزاءِ العدوِّ."],[15,16,"مِن وَرَآئِكُمۡ","من وراءِ المُصَلِّين."],[22,23,"فَلۡيُصَلُّواْ مَعَكَ","وهم الذين لم يُصَلُّوا، فيُصَلُّون مع الإمامِ رَكْعَةً."],[35,38,"فَيَمِيلُونَ عَلَيۡكُم مَّيۡلَةً وَٰحِدَةً","فَيقْضُون عليكم."],[39,40,"وَلَا جُنَاحَ","ولا إثمَ."]],"103":[[11,12,"فَأَقِيمُواْ ٱلصَّلَوٰةَ","كاملةً برُكوعِها وسجودِها."],[19,19,"مَّوۡقُوتًا","في أوقاتٍ معلومةٍ."]],"104":[[0,1,"وَلَا تَهِنُواْ","ولا تَضْعُفوا."],[2,4,"فِي ٱبۡتِغَآءِ ٱلۡقَوۡمِ","في طَلَبِ عَدوِّكم."],[7,7,"تَأۡلَمُونَ","من القتالِ."],[12,12,"وَتَرۡجُونَ","من الثوابِ والنَّصْرِ."]],"105":[[8,10,"بِمَآ أَرَىٰكَ ٱللَّهُ","بما أوْحى إليك، وبَصَّرَكَ به."],[14,14,"خَصِيمًا","مُدافِعًا عنهم."]],"107":[[0,1,"وَلَا تُجَـٰدِلۡ","ولا تُدافِعْ، وتخاصِمْ."],[4,4,"يَخۡتَانُونَ","يَخُونون بمعصيةِ اللهِ."],[12,12,"خَوَّانًا","كثيرَ الخيانةِ."],[13,13,"أَثِيمًا","كثيرَ الذَّنْبِ."]],"108":[[0,0,"يَسۡتَخۡفُونَ","يَسْتَتِرُون."],[7,8,"وَهُوَ مَعَهُمۡ","بعِلْمِه."],[10,10,"يُبَيِّتُونَ","يُدَبِّرُون ليلًا."]],"109":[[17,17,"وَكِيلًا","مُجادِلًا يقومُ بأمرِهم."]],"110":[[4,5,"يَظۡلِمۡ نَفۡسَهُۥ","بارتكابِ معصيةٍ."]],"111":[[4,6,"يَكۡسِبُهُۥ عَلَىٰ نَفۡسِهِۦ","يَضُرُّها."]],"112":[[4,4,"إِثۡمًا","ذَنبًا عن عَمْدٍ."],[10,11,"ٱحۡتَمَلَ بُهۡتَـٰنًا","تَحَمَّلَ كَذِبًا."],[13,13,"مُّبِينًا","بَيِّنًا."]],"113":[[1,2,"فَضۡلُ ٱللَّهِ","بالنبوَّةِ، فعَصَمَك بتوفيقِه."],[9,9,"يُضِلُّوكَ","يُزِلُّوك عن الحقِّ."],[22,22,"ٱلۡحِكۡمَةَ","السُّنَّةَ."]],"114":[[5,5,"نَّجۡوَىٰهُمۡ","كلامِهم سِرًّا."],[11,11,"مَعۡرُوفٍ","أعمالِ البِرِّ، والخيرِ."]],"115":[[1,1,"يُشَاقِقِ","يُخالِفْ، ويُعادِ."],[6,6,"تَبَيَّنَ","ظَهَرَ."],[13,15,"نُوَلِّهِۦ مَا تَوَلَّىٰ","نَتْرُكْه وما تَوَجَّه إليه."]],"116":[[8,10,"مَا دُونَ ذَٰلِكَ","ما دونَ الشِّرك."]],"117":[[5,5,"إِنَـٰثًا","أوثانًا لها أسماءٌ مؤنثةٌ."],[10,10,"مَّرِيدًا","متمرِّدًا على اللهِ، وهو إبليسُ."]],"118":[[0,1,"لَّعَنَهُ ٱللَّهُ","طَرَدَه من رَحْمَتِه."],[6,7,"نَصِيبًا مَّفۡرُوضًا","جُزْءًا منهم معلومًا، وبَيَّن ذلك بما بعدَه."]],"119":[[0,0,"وَلَأُضِلَّنَّهُمۡ","ولَأَصْرِفَنَّهم عن طريقِ الهدايةِ."],[1,1,"وَلَأُمَنِّيَنَّهُمۡ","لَأَعِدَنَّهم بالأماني الكاذبةِ."],[3,3,"فَلَيُبَتِّكُنَّ","لَأَدْعُوَنَّهم إلى تَقْطِيعِ."],[8,9,"خَلۡقَ ٱللَّهِ","في الفِطْرَةِ والهيئةِ."]],"120":[[0,0,"يَعِدُهُمۡ","بالوعودِ الكاذبةِ."],[1,1,"وَيُمَنِّيهِمۡ","بالأماني الباطلةِ."],[6,6,"غُرُورًا","خديعةً."]],"121":[[6,6,"مَحِيصًا","مَلْجَأً."]],"122":[[20,20,"قِيلًا","قولًا."]],"123":[[0,1,"لَّيۡسَ بِأَمَانِيِّكُمۡ","لا يُنالُ هذا الفضلُ بالأماني."]],"124":[[15,15,"نَقِيرًا","النُّقطةَ في ظَهْرِ النَّواةِ."]],"125":[[7,8,"وَهُوَ مُحۡسِنٌ","عاملٌ للحَسَناتِ."],[10,10,"مِلَّةَ","دينَ."],[12,12,"حَنِيفًا","مائلًا عن العقائدِ الفاسدةِ."],[16,16,"خَلِيلًا","صَفِيًّا."]],"127":[[7,9,"وَمَا يُتۡلَىٰ عَلَيۡكُمۡ","أي: والقرآنُ الذي يُتْلى عليكم يُفْتِيكم فيهنَّ."],[24,24,"وَٱلۡمُسۡتَضۡعَفِينَ","أي: ما يُتْلى عليكم في اليتامى، والمستضعفين."],[30,30,"بِٱلۡقِسۡطِ","بالعَدْلِ."]],"128":[[4,4,"بَعۡلِهَا","زَوْجِها."],[5,5,"نُشُوزًا","استعلاءً بنفسِه عنها."],[8,9,"فَلَا جُنَاحَ","فلا حَرَجَ."],[17,19,"وَأُحۡضِرَتِ ٱلۡأَنفُسُ ٱلشُّحَّ","وجُبِلَتِ الأنفسُ على شُحِّ كلٍّ من الزوجَيْن بنصيبِه."]],"129":[[2,3,"أَن تَعۡدِلُواْ","العَدْلَ التامَّ في مَيْلِ القلبِ."],[8,9,"فَلَا تَمِيلُواْ","فلا تُعْرِضُوا عن المرغوبِ عنها."],[12,12,"فَتَذَرُوهَا","فَتتْرُكوها."],[13,13,"كَٱلۡمُعَلَّقَةِ","لا هيَ مُطَلَّقةٌ، ولا هي ذاتُ زوجٍ."]],"130":[[2,4,"يُغۡنِ ٱللَّهُ كُلًّا","يَجْعَلْه مُسْتغنيًا عن الآخَر."]],"131":[[14,14,"وَإِيَّاكُمۡ","وصَّينا أُمَّةَ محمدٍ ﷺ."]],"132":[[9,9,"وَكِيلًا","قائمًا بشؤونِ خَلْقِه."]],"134":[[3,4,"ثَوَابَ ٱلدُّنۡيَا","عَرَضَ الدنيا."],[5,9,"فَعِندَ ٱللَّهِ ثَوَابُ ٱلدُّنۡيَا وَٱلۡـَٔاخِرَةِ","هَلّا طَلَب بعَمَلِه ما عندَ اللهِ من ثوابِ الدنيا والآخرةِ."]],"135":[[4,4,"قَوَّٰمِينَ","ليتكرَّرْ منكم القيامُ."],[5,5,"بِٱلۡقِسۡطِ","بالعَدْلِ، والإقرارِ بما عليكم من الحقوقِ."],[6,7,"شُهَدَآءَ لِلَّهِ","مُؤَدِّين للشَّهادةِ، لمرضاةِ اللهِ."],[14,15,"إِن يَكُنۡ","المشهودُ عليه."],[20,21,"أَوۡلَىٰ بِهِمَا","أحقُّ منكم بكلِّ واحدٍ منهما."],[25,26,"أَن تَعۡدِلُواْ","مخافةَ أن تَعْدِلُوا عن الحقِّ، فتَجُوروا."],[28,28,"تَلۡوُۥٓاْ","تُحَرِّفُوا الشهادةَ."],[29,30,"أَوۡ تُعۡرِضُواْ","بتَرْكِ أدائِها، أو كِتمانِها."]],"137":[[19,19,"سَبِيلَۢا","طريقًا."]],"139":[[3,3,"أَوۡلِيَآءَ","أنصارًا."],[7,7,"أَيَبۡتَغُونَ","أيَطْلُبون؟"],[9,9,"ٱلۡعِزَّةَ","النُّصْرَةَ، والمنَعَةَ."]],"140":[[24,24,"مِّثۡلُهُمۡ","في الكفرِ، لأنكم رَضِيتم بالكفرِ والاستهزاءِ."]],"141":[[0,2,"ٱلَّذِينَ يَتَرَبَّصُونَ بِكُمۡ","المنافقون ينتظرون ما يَحُلُّ بكم."],[6,6,"فَتۡحٌ","نَصْرٌ، وغنيمةٌ."],[19,19,"نَسۡتَحۡوِذۡ","نساعِدْكم، ونَغْلِبْ عليكم."],[21,21,"وَنَمۡنَعۡكُم","بتَخْذِيلهم، وتَثْبيطِهم عنكم."],[35,35,"سَبِيلًا","تَسَلُّطًا، وطريقًا ما داموا عاملين بالحقِّ."]],"142":[[2,3,"يُخَـٰدِعُونَ ٱللَّهَ","بما يُظْهِرُونه من الإيمان، ويُبْطِنون الكفرَ، ظنًّا منهم أنه يَخْفى عليه."],[4,5,"وَهُوَ خَـٰدِعُهُمۡ","يُوصِلُ إليهم العقوبةَ بطريقٍ خَفِيّ."],[12,12,"يُرَآءُونَ","يَقْصِدُون بصَلاتِهم الرياءَ والسُّمْعةَ."]],"143":[[0,0,"مُّذَبۡذَبِينَ","لايَسْتقِرُّون على حالٍ، بل هم مُتَحَيِّرون."],[15,15,"سَبِيلًا","طريقًا إلى الحقِّ."]],"144":[[15,16,"سُلۡطَـٰنًا مُّبِينًا","حُجَّةً ظاهرةً على كَذِبِكم في إيمانِكم."]],"145":[[3,3,"ٱلدَّرۡكِ","الطَّبَقَةِ."]],"148":[[8,9,"مَن ظُلِمَ","فلا حَرَجَ أن يُخْبِرَ بما أُسِيءَ إليه."]],"150":[[19,20,"بَيۡنَ ذَٰلِكَ","بين الإيمانِ والكُفرِ، دِينًا متوسِّطًا بينهما."]],"152":[[12,12,"أُجُورَهُمۡ","ثوابَهم."]],"153":[[18,18,"جَهۡرَةً","عِيانًا نَنْظُرُ إليه."],[20,20,"ٱلصَّـٰعِقَةُ","النارُ نَزَلَتْ عليهم، فأهلَكَتْهُم."],[35,35,"سُلۡطَـٰنًا","حُجَّةً تُؤَيِّدُ صِدْقَ نبوَّتهِ."]],"154":[[2,2,"ٱلطُّورَ","جَبَلَ الطُّورِ."],[3,3,"بِمِيثَـٰقِهِمۡ","امتَنَعُوا عن الالتزامِ بالعَهْدِ المؤكَّدِ للعملِ بالتَوْراة، فَرفَعَ اللهُ عليهم جَبَلَ الطُّور، فقَبِلُوها."],[7,7,"ٱلۡبَابَ","بابَ بيتِ المَقْدِسِ."],[8,8,"سُجَّدًا","خاضِعين لله، لكنهم دَخَلُوا يزحَفُون على أستاهِهم."],[11,14,"لَا تَعۡدُواْ فِي ٱلسَّبۡتِ","لا تَعْتَدُوا بالصَّيدِ يومَ السَّبْتِ، ولكنهم خالَفُوا."],[17,18,"مِّيثَـٰقًا غَلِيظًا","عهدًا مؤكَّدًا، فنقضُوه."]],"155":[[0,2,"فَبِمَا نَقۡضِهِم مِّيثَـٰقَهُمۡ","لَعَنّاهم بسببِ نَقْضِهم العهودَ المؤكَّدةَ."],[12,12,"غُلۡفُۢ","عليها أغطِيَةٌ، لاتفقَهُ ما تقولُ."],[14,14,"طَبَعَ","خَتَمَ."],[20,21,"إِلَّا قَلِيلًا","إلا إيمانًا قليلًا كإيمانِهم بموسى عليه السلامُ والتوراةِ."]],"156":[[4,4,"بُهۡتَـٰنًا","افتراءً برَمْيِها بالزِّنى."]],"157":[[14,15,"شُبِّهَ لَهُمۡ","قَتَلُوا رجلًا يُشْبِهُه."],[33,33,"يَقِينَۢا","مُتَيَقِّنِين بأنه عيسى، بل كانوا شاكِّين مُتَوَهِّمين فيه."]],"159":[[5,6,"لَيُؤۡمِنَنَّ بِهِۦ","أي: بعدَ نُزولِه آخرَ الزَّمانِ."],[13,13,"شَهِيدًا","شاهدًا عليهم بتكذيبِ مَن كذَّبه، وغالى فيه."]],"161":[[9,9,"وَأَعۡتَدۡنَا","وأَعْدَدْنا."]],"162":[[1,1,"ٱلرَّٰسِخُونَ","المُتَمَكِّنون."],[14,15,"وَٱلۡمُقِيمِينَ ٱلصَّلَوٰةَ","أي: وأمدَحُ هؤلاء."]],"163":[[16,16,"وَٱلۡأَسۡبَاطِ","الأنبياءِ الذين كانوا في قبائِلِ بني إسرائيلَ الاثنتي عشرةَ مِن ولدِ يعقوبَ."],[24,24,"زَبُورًا","اسمُ الكتابِ الذي أُنْزلَ على داودَ، وهو صُحُفٌ مكتوبةٌ."]],"165":[[1,1,"مُّبَشِّرِينَ","أي: بثوابي."],[2,2,"وَمُنذِرِينَ","بعقابي."],[9,10,"بَعۡدَ ٱلرُّسُلِ","بعد إرسالِ الرُّسُلِ."]],"166":[[10,12,"وَكَفَىٰ بِٱللَّهِ شَهِيدًا","حَسْبُك اللهُ شاهدًا على صِدْقِك."]],"170":[[13,18,"فَإِنَّ لِلَّهِ مَا فِي ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ","أي: فإنه غَنِيٌّ عنكم، وعن إيمانِكم لأنه مالكُ ما في السمواتِ والأرضِ."]],"171":[[2,3,"لَا تَغۡلُواْ","لا تُجاوِزُوا الحقَّ، فتُفْرِطُوا."],[19,19,"وَكَلِمَتُهُۥٓ","وخَلَقَه بالكلمةِ التي أرسلَ جبريلَ بها إلى مريمَ، وهي قولُه: «كن» فكان."],[23,24,"وَرُوحٌ مِّنۡهُ","كان إنسانًا بإحياءِ اللهِ له بقولِه: «كن»."],[28,30,"وَلَا تَقُولُواْ ثَلَـٰثَةٌ","ولا تجعلُوا عيسى وأمَّه مع اللهِ شريكَيْن."],[52,52,"وَكِيلًا","مُدَبِّرًا، وكَلَ الخَلْقُ أمورَهم إليه."]],"172":[[0,1,"لَّن يَسۡتَنكِفَ","لن يأْنَفَ، ويَسْتَكْبِرَ."]],"174":[[4,4,"بُرۡهَـٰنٌ","محمدٌ ﷺ."],[9,9,"نُورًا","قرآنًا."]],"175":[[4,5,"وَٱعۡتَصَمُواْ بِهِۦ","تَمَسَّكُوا به."],[13,14,"صِرَٰطًا مُّسۡتَقِيمًا","طريقًا لاعِوَجَ فيه."]],"176":[[0,0,"يَسۡتَفۡتُونَكَ","يَطْلُبون حُكْمَك."],[4,5,"فِي ٱلۡكَلَـٰلَةِ","في ميراثِ مَن مات، وليس له ولدٌ، ولا والد."],[25,27,"فَإِن كَانَتَا ٱثۡنَتَيۡنِ","مَن مات كَلالةً وله أختان."],[39,39,"حَظِّ","نصيبِ."],[44,45,"أَن تَضِلُّواْ","لئلّا تَضِلُّوا عن الحقِّ."]]}