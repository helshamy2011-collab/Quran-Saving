{"1":[[0,0,"حمٓ","سبق شَرْحُ الحروفِ المقطَّعةِ أوَّلَ سُورةِ البَقَرَةِ."]],"3":[[8,9,"وَأَجَلٍ مُّسَمًّى","وتَعْيِينِ ساعَةٍ مُحَدَّدَةٍ لِبَقائِهِما."]],"4":[[14,14,"شِرۡكٌ","شِرْكَةٌ ونَصِيبٌ."],[19,21,"مِّن قَبۡلِ هَـٰذَآ","مِن قَبْل هذا القرآنِ."],[23,23,"أَثَـٰرَةٍ","بَقِيَّةٍ تُؤْثَرُ عَنِ الأوَّلِينَ."]],"6":[[3,4,"كَانُواْ لَهُمۡ","كانَتِ الأصْنامُ للعابِدِينَ."]],"8":[[6,8,"فَلَا تَمۡلِكُونَ لِي","فَلا تَقْدِرُونَ على أن تَرُدُّوا عَنِّي."],[15,15,"تُفِيضُونَ","وتُكْثِرُونَ القَوْلَ فِيهِ، وتَخُوضُونَ وتتوسَّعُونَ."]],"9":[[3,3,"بِدۡعًا","أوَّلَ مَبْعُوثٍ، فَقَدْ كانَ قَبْلِي رُسُلٌ."]],"10":[[1,1,"أَرَءَيۡتُمۡ","أخْبِرُونِي."],[10,10,"شَاهِدٌ","هُوَ عَبْدُاللهِ بْنُ سَلامٍ."],[14,15,"عَلَىٰ مِثۡلِهِۦ","أي القُرآنِ، مِنَ المعانِي الموجُودَةِ في التَّوراةِ."]],"11":[[8,10,"مَّا سَبَقُونَآ إِلَيۡهِ","ما سَبَقَنا فُقَراءُ المسِلمِينَ إلى الإيمانِ."],[17,17,"إِفۡكٌ","كَذِبٌ."]],"12":[[4,4,"إِمَامًا","يُقْتَدى بِهِ في الدِّينِ."],[8,8,"مُّصَدِّقٌ","لِكِتاب مُوسى وغيرِه من كُتُب اللهِ."]],"15":[[6,6,"كُرۡهًا","مَشَقَّةً."],[10,10,"وَفِصَـٰلُهُۥ","وفِطامُهُ."],[16,16,"أَشُدَّهُۥ","نِهايةَ قُوَّتِهِ البَدَنِيَّةِ والعقْلِيَّةِ."],[22,22,"أَوۡزِعۡنِيٓ","ألْهِمْنِي."]],"16":[[10,12,"فِيٓ أَصۡحَـٰبِ ٱلۡجَنَّةِ","في جُمْلة أصْحابِ الجنَّة."]],"17":[[3,3,"أُفٍّ","اسْمُ فِعْلٍ مَعْناه: أتَضَجَّرُ."],[7,7,"أُخۡرَجَ","أُبْعَثَ بَعْدَ الموتِ."],[9,9,"خَلَتِ","مَضَتِ."],[10,10,"ٱلۡقُرُونُ","جَمْعُ قَرْنٍ وهو الأُمَّةُ الَّتي تَقارَبَ زَمانُ حياتِها أي: فماتُوا ولم يُبْعَثْ مِنهُم أحَدٌ؟"],[14,15,"يَسۡتَغِيثَانِ ٱللَّهَ","يَطْلُبانِ عَوْنَهُ."],[16,16,"وَيۡلَكَ","هَلاكًا لَكَ."],[26,26,"أَسَـٰطِيرُ","القِصَصُ الباطِلةُ."]],"18":[[2,4,"حَقَّ عَلَيۡهِمُ ٱلۡقَوۡلُ","وجَبَ عَلَيهِمُ القَوْلُ بالعَذابِ."]],"20":[[6,6,"أَذۡهَبۡتُمۡ","يقُولُ اللهُ لَهُم ذَلِكَ."],[16,16,"ٱلۡهُونِ","الهَوانِ والذُّلِّ."],[26,26,"تَفۡسُقُونَ","تَخْرُجُونَ عَن طاعَةِ اللهِ بالشِّرْكِ."]],"21":[[6,6,"بِٱلۡأَحۡقَافِ","الرِّمالِ الكثِيرَةِ الَّتي لَمْ تَبْلُغْ أن تَكُونَ جَبَلًا، وتَقَعُ في جَنُوبِ الجزِيرَةِ العَرَبِيَّةِ، وهي مَنازلُ عادٍ قَومِ هُودٍ."],[9,9,"ٱلنُّذُرُ","جَمْعُ النَّذِيرِ وهو الرَّسُولُ."]],"22":[[2,2,"لِتَأۡفِكَنَا","لِتَصْرِفَنا."]],"24":[[1,1,"رَأَوۡهُ","أي العذابَ."],[2,2,"عَارِضًا","كالسَّحابِ الَّذي يَعْتَرِضُ جَوَّ السَّماءِ."],[4,4,"أَوۡدِيَتِهِمۡ","منازِلِهم في السُّهُولِ."]],"25":[[1,2,"كُلَّ شَيۡءِۭ","ما مِن شَأنِه أن تُدَمِّرَهُ مِنَ الإنْسانِ والحيوانِ والدِّيارِ."],[9,9,"مَسَـٰكِنُهُمۡ","أي آثارُ المساكِنِ وبقاياها."]],"26":[[2,5,"فِيمَآ إِن مَّكَّنَّـٰكُمۡ فِيهِ","في الَّذِي لَم نَجْعَل لَّكُم القُدْرَةَ عَلَيهِ."],[10,10,"وَأَفۡـِٔدَةً","عُقُولًا."],[12,12,"أَغۡنَىٰ","نَفَعَ."],[23,23,"يَجۡحَدُونَ","يُنْكِرُونَ."],[26,27,"وَحَاقَ بِهِم","ونَزَلَ وأَحاطَ بِهِم."],[28,31,"مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","العَذابُ الَّذِي كانُوا يَسْخَرُونَ مِنهُ."]],"27":[[6,7,"وَصَرَّفۡنَا ٱلۡـَٔايَـٰتِ","بيَّنّا لَهُم أنْواعَ الأَدِلَّةِ."]],"28":[[0,0,"فَلَوۡلَا","فَهَلّا."],[7,7,"قُرۡبَانًا","لِأَجْلِ التَّقَرُّبِ بِهِم إلى اللهِ، وهو مُعْتَرِضٌ بَيْنَ (ٱتَّخَذُواْ) ومَفْعُولِهِ: (ءالِهَةَۢ)."],[10,11,"ضَلُّواْ عَنۡهُمۡ","غابُوا عَنْهُم."],[13,13,"إِفۡكُهُمۡ","كَذِبُهُم في زَعمِهِم أنَّ الأصْنامَ شُرَكاءُ لله."],[16,16,"يَفۡتَرُونَ","يَخْتَلِقُونَه مِن كَونِ الأصْنامِ تُقَرِّبُهُم إلى اللهِ."]],"29":[[1,2,"صَرَفۡنَآ إِلَيۡكَ","أمَلْناهُم إلَيكَ وأَقْبَلْنا بِهِم نَحْوَك."],[3,3,"نَفَرًا","جَماعَةً."],[11,11,"أَنصِتُواْ","وجِّهُوا أسْماعَكُم إلى الكَلامِ."],[13,13,"قُضِيَ","فُرِغَ مِن قِراءتِه."],[14,14,"وَلَّوۡاْ","انْصَرفُوا."],[17,17,"مُّنذِرِينَ","المُنْذِرُ: المُخْبِرُ بِخَبرِ مُخِيفٍ."]],"30":[[9,12,"مُصَدِّقًا لِّمَا بَيۡنَ يَدَيۡهِ","مُصَدِّقًا لما سَبَقَه مِن كُتُبِ اللهِ الَّتِي أنْزَلَها على رُسُلِه."]],"31":[[2,3,"دَاعِيَ ٱللَّهِ","رَسُولَ اللهِ محمَّدًا ﷺ."],[10,10,"وَيُجِرۡكُم","ويَمْنَعْكُم."]],"32":[[5,8,"فَلَيۡسَ بِمُعۡجِزٍ فِي ٱلۡأَرۡضِ","فَلا يَفُوتُ عِقابَ الله."],[13,13,"أَوۡلِيَآءُ","نُصَراءُ."]],"33":[[8,10,"وَلَمۡ يَعۡيَ بِخَلۡقِهِنَّ","ولَمْ يَعْجَزْ عَنْ خَلْقِهِنَّ."]],"35":[[3,6,"أُوْلُواْ ٱلۡعَزۡمِ مِنَ ٱلرُّسُلِ","هُمْ: نُوحٌ وإبراهيمُ وموسى وعِيسى ومُحَمَّدٌ عَلَيهِمُ الصَّلاةُ والسَّلامُ."],[7,8,"وَلَا تَسۡتَعۡجِل","الَهلاكَ."],[15,16,"لَمۡ يَلۡبَثُوٓاْ","لم يَمْكُثُوا."],[21,21,"بَلَـٰغٌ","هَذا بَلاغٌ للنّاسِ."],[26,26,"ٱلۡفَـٰسِقُونَ","الخارِجُونَ عَنِ الإيمانِ بالإشْراكِ."]]}