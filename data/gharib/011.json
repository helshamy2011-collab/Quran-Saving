{"1":[[2,3,"أُحۡكِمَتۡ ءَايَـٰتُهُۥ","جُعِلَتْ مُحْكَمَةً مُتقنةً، لا نَقْصَ فيها ولا عَيْبَ."],[5,5,"فُصِّلَتۡ","بُيِّنَتْ فيها الأحكامُ والقِصصُ والمواعظُ."]],"3":[[7,8,"مَّتَـٰعًا حَسَنًا","بطِيبِ الحياةِ وسَعَةِ الرِّزقِ."],[9,11,"إِلَىٰٓ أَجَلٍ مُّسَمًّى","إلى وقتِ انقضاءِ آجالِكم."],[15,15,"فَضۡلَهُۥ","جزاءَ فَضْلِه في الدُّنيا والآخرةِ."],[18,18,"تَوَلَّوۡاْ","تُعْرِضُوا."]],"5":[[2,3,"يَثۡنُونَ صُدُورَهُمۡ","يَطْوُونها على الكفرِ والعَداوةِ."],[8,9,"يَسۡتَغۡشُونَ ثِيَابَهُمۡ","يَتَغَطَّوْن بها."]],"6":[[2,2,"دَآبَّةٍ","كلُّ حَيَوانٍ يَمْشي -على هيئتهِ- على الأرضِ."],[10,10,"مُسۡتَقَرَّهَا","مكانَ استقرارِها في حياتِها وبعدَ مَماتِها."],[11,11,"وَمُسۡتَوۡدَعَهَا","موضعَ استيداعِها بعد موتِها."],[14,15,"كِتَـٰبٍ مُّبِينٍ","واضحٍ، وهو اللَّوحُ المحفوظُ."]],"7":[[9,9,"عَرۡشُهُۥ","العرشُ: سريرُ المُلْكِ الذي استوى عليه الرحمنُ، وتحمِلُه الملائكةُ، وهو أعظمُ المخلوقاتِ، وهو سَقْفُ الجنَّةِ."],[12,12,"لِيَبۡلُوَكُمۡ","لِيَخْتَبِرَكم."],[14,15,"أَحۡسَنُ عَمَلًا","أعْمَلُ بطاعةِ اللهِ وأَوْرَعُ عن مَحارمِه."]],"8":[[5,6,"أُمَّةٍ مَّعۡدُودَةٍ","وقتٍ معلومٍ."],[16,16,"وَحَاقَ","أحاطَ."]],"9":[[3,4,"مِنَّا رَحۡمَةً","نِعْمةً مِن نِعَمِنا الكثيرةِ."],[6,7,"نَزَعۡنَـٰهَا مِنۡهُ","سَلَبْناها منه."],[9,9,"لَيَـُٔوسٌ","شديدُ اليأسِ من رحمةِ اللهِ."],[10,10,"كَفُورٌ","كثيرُ الجُحودِ للنِّعَمِ."]],"10":[[4,5,"ضَرَّآءَ مَسَّتۡهُ","بَلْوى أصابَتْه."],[8,8,"ٱلسَّيِّـَٔاتُ","المصائبُ والشَّدائدُ."],[11,11,"لَفَرِحٌ","بَطِرٌ بالنِّعْمةِ مُغْتَرٌّ بها."],[12,12,"فَخُورٌ","كثيرُ التعاظُمِ على الناسِ."]],"12":[[2,5,"بَعۡضَ مَا يُوحَىٰٓ إِلَيۡكَ","ما يَشُقُّ على المشركين سماعُه، ويُثيرُ غضَبَهم."],[9,10,"أَن يَقُولُواْ","خشيةَ أن يقولوا على وجهِ التكذيبِ والاستهزاءِ."],[11,11,"لَوۡلَآ","هَلّا."],[26,26,"وَكِيلٌ","حفيظٌ يُدَبِّرُ جميعَ شؤونِ خَلْقهِ."]],"13":[[2,2,"ٱفۡتَرَىٰهُ","أتى به مِن عندِ نفسِه."],[8,8,"مُفۡتَرَيَـٰتٍ","مُخْتَلَقاتٍ من عندِ أنفسِكم."],[9,11,"وَٱدۡعُواْ مَنِ ٱسۡتَطَعۡتُم","واستعينُوا بمَن أمكنكم الاستعانةُ به."]],"15":[[6,8,"نُوَفِّ إِلَيۡهِمۡ أَعۡمَـٰلَهُمۡ","نُعْطِهم جزاءَ أعمالِهم في الدنيا."],[12,13,"لَا يُبۡخَسُونَ","لا يُنْقَصُون شيئًا ممّا قُسِمَ لهم."]],"16":[[8,8,"وَحَبِطَ","بَطَلَ في الآخرةِ نَفْعُ ما عَمِلوه."]],"17":[[3,5,"بَيِّنَةٍ مِّن رَّبِّهِۦ","حُجَّةٍ وبَصيرةٍ من اللهِ."],[6,6,"وَيَتۡلُوهُ","يَتْبَعُه ويُقَوِّيه."],[7,8,"شَاهِدٌ مِّنۡهُ","يَشْهَدُ على كَوْنِ القرآنِ من عندِ اللهِ."],[11,12,"كِتَـٰبُ مُوسَىٰٓ","التوراةُ."],[13,13,"إِمَامًا","يُؤتَمُّ به في الدِّين، ويُقْتدى به."],[14,14,"وَرَحۡمَةً","نِعْمَةً عظيمةً من اللهِ."],[22,22,"ٱلۡأَحۡزَابِ","الكفارِ الذين جَمَعهم تكذيبُ رسولِ اللهِ عليه الصلاة والسلام، وكَيْدُهم له."],[28,29,"مِرۡيَةٍ مِّنۡهُ","شَكٍّ من تنزيلِ القرآنِ من اللهِ."]],"18":[[8,10,"يُعۡرَضُونَ عَلَىٰ رَبِّهِمۡ","سيُعْرَضون على اللهِ في موقفِ الحسابِ."],[12,12,"ٱلۡأَشۡهَـٰدُ","جَمْعُ شاهِدٍ، وهم: الملائكةُ والأنبياءُ والمؤمنون."],[19,20,"لَعۡنَةُ ٱللَّهِ","غَضَبُه وسُخْطُه."]],"19":[[1,1,"يَصُدُّونَ","يَمْنَعُون الناسَ."],[3,4,"سَبِيلِ ٱللَّهِ","الطريقِ المُوصِلَةِ إليه، وهي دينُ الإسلامِ."],[5,6,"وَيَبۡغُونَهَا عِوَجًا","ويُريدون أن تكونَ سبيلُ اللهِ مائلةً وفْقَ أهوائِهم."]],"20":[[3,3,"مُعۡجِزِينَ","فائتين من عذابِ اللهِ بالهَرَبِ."],[13,13,"أَوۡلِيَآءَ","أنصارٍ."]],"21":[[4,4,"وَضَلَّ","ذَهَبَ."],[8,8,"يَفۡتَرُونَ","يَكْذِبُون على اللهِ من ادِّعاءِ الشفعاءِ، الذين يَتَوَهَّمُون شفاعتَهم."]],"22":[[0,1,"لَا جَرَمَ","حقًا، أو لا مَحالةَ."]],"23":[[5,7,"وَأَخۡبَتُوٓاْ إِلَىٰ رَبِّهِمۡ","أنابُوا إليه وخَضَعُوا له."]],"24":[[1,1,"ٱلۡفَرِيقَيۡنِ","فريقَي الكُفْرِ والإيمانِ."]],"25":[[7,8,"نَذِيرٌ مُّبِينٌ","بَيِّنُ الإنذارِ بما أُرْسِلْتُ به."]],"27":[[1,1,"ٱلۡمَلَأُ","الأشرافُ والسّادةُ."],[17,17,"أَرَاذِلُنَا","سَفَلَةُ الناسِ منا وفُقَراؤُنا."],[18,19,"بَادِيَ ٱلرَّأۡيِ","أي: اتّبعُوك من غيرِ تفكيرٍ ولا رَوِيَّةٍ."]],"28":[[2,2,"أَرَءَيۡتُمۡ","أخْبِرُوني."],[6,6,"بَيِّنَةٍ","حُجَّةٍ وبرهانٍ، تَشْهَدُ بالنبوَّةِ."],[9,12,"وَءَاتَىٰنِي رَحۡمَةً مِّنۡ عِندِهِۦ","وهي الرِّسالةُ."],[13,13,"فَعُمِّيَتۡ","أُخْفِيَتْ."]],"31":[[4,5,"خَزَآئِنُ ٱللَّهِ","خزائنُ رزقِه، وما لا يَصِلُ إليه عِلْمُ الناسِ."],[16,17,"تَزۡدَرِيٓ أَعۡيُنُكُمۡ","تَسْتَحْقِرُهم وتَسْتهينُ بهم."],[21,21,"خَيۡرًا","توفيقًا وإيمانًا وأجرًا."]],"33":[[9,9,"بِمُعۡجِزِينَ","بفائتين من عذابِ اللهِ بالهَرَبِ."]],"34":[[13,13,"يُغۡوِيَكُمۡ","يُضِلَّكم."]],"35":[[6,7,"فَعَلَيَّ إِجۡرَامِي","فعَلَيَّ إثمي وعُقوبتُه."],[10,11,"مِّمَّا تُجۡرِمُونَ","ممّا تَقْترفونه من الكفرِ والتكذيب."]],"36":[[12,13,"فَلَا تَبۡتَئِسۡ","لا تَحْزَنْ."]],"37":[[1,1,"ٱلۡفُلۡكَ","السَّفينةَ."],[2,2,"بِأَعۡيُنِنَا","بمَرْأى مِنّا وأنت في حِفْظِنا."],[3,3,"وَوَحۡيِنَا","وبأَمْرِنا لك ومَعُونَتِنا."],[4,8,"وَلَا تُخَـٰطِبۡنِي فِي ٱلَّذِينَ ظَلَمُوٓاْ","لا تَطْلُبْ مني إمهالَهم."]],"39":[[5,5,"يُخۡزِيهِ","يُهينُه ويُذِلُّه."],[6,7,"وَيَحِلُّ عَلَيۡهِ","ويَنْزِلُ به."],[8,9,"عَذَابٌ مُّقِيمٌ","دائمٌ لا ينقطِعُ، وهو النارُ."]],"40":[[4,5,"وَفَارَ ٱلتَّنُّورُ","ونَبَعَ الماءُ بقوَّةٍ من المكانِ الذي يُخْبَزُ فيه."],[9,12,"مِن كُلٍّ زَوۡجَيۡنِ ٱثۡنَيۡنِ","من كلِّ نوعٍ من أنواعِ الحيَواناتِ ذكرًا وأنثى."],[14,18,"إِلَّا مَن سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ","إلّا مَن تَقَدَّمَ حُكْمُ اللهِ عليه بأنه من المُغْرَقين."]],"41":[[5,5,"مَجۡرٜىٰهَا","جَرْيُها على وجهِ الماء."],[6,6,"وَمُرۡسَىٰهَآ","ومُنْتَهى سَيْرِها."]],"42":[[11,11,"مَعۡزِلٍ","مكانٍ عَزَلَ نفسَه فيه عن المؤمنين."]],"43":[[1,1,"سَـَٔاوِيٓ","سألتجِئُ وأتحَصَّنُ."],[8,9,"لَا عَاصِمَ","لا مانعَ ولا حافِظَ."]],"44":[[2,2,"أَقۡلِعِي","أمْسِكِي عن إنزالِ المطرِ."],[6,7,"وَغِيضَ ٱلۡمَآءُ","نَقَصَ وغارَ في الأرضِ."],[8,9,"وَقُضِيَ ٱلۡأَمۡرُ","تَمَّ حُكْمُ اللهِ بإهلاكِ قومِ نوحٍ."],[10,12,"وَٱسۡتَوَتۡ عَلَى ٱلۡجُودِيِّ","استقرَّتِ السفينةُ على جَبَلِ الجوديِّ."],[14,14,"بُعۡدًا","هَلاكًا."]],"47":[[3,4,"أَعُوذُ بِكَ","أعتصِمُ وأستجيرُ بك."]],"48":[[3,4,"بِسَلَـٰمٍ مِّنَّا","بأمانٍ وسَلامةٍ منّا."],[5,6,"وَبَرَكَـٰتٍ عَلَيۡكَ","خيراتٍ ونِعَمٍ دائمةٍ عليك."],[11,12,"وَأُمَمٌ سَنُمَتِّعُهُمۡ","وهم الكفارُ."]],"50":[[1,1,"عَادٍ","قومِ هودٍ عليه السلام، وهم قبيلةٌ من العَرَبِ."],[16,16,"مُفۡتَرُونَ","كاذِبُون في إشراكِكم باللهِ."]],"51":[[10,10,"فَطَرَنِيٓ","خَلَقَني."]],"52":[[7,7,"ٱلسَّمَآءَ","المطرَ."],[9,9,"مِّدۡرَارًا","كثيرًا مُتتابعًا من غيرِ إضْرارٍ."],[14,15,"وَلَا تَتَوَلَّوۡاْ","لا تُعْرِضُوا عَمّا دَعَوْتُكم إليه."]],"53":[[4,4,"بِبَيِّنَةٍ","بحُجَّةٍ واضحةٍ."],[9,10,"عَن قَوۡلِكَ","من أجلِ قولِك."]],"54":[[0,1,"إِن نَّقُولُ","ما نقولُ."],[3,3,"ٱعۡتَرَىٰكَ","أصابَكَ."],[6,6,"بِسُوٓءٍ","بجُنونٍ؛ لنَهْيِك عن عبادتِها."]],"55":[[2,2,"فَكِيدُونِي","فاجتهِدُوا في إلحاقِ الضَّرَرِ بي."],[5,6,"لَا تُنظِرُونِ","لا تُمْهِلُوني بما تُريدون كيدَه."]],"56":[[1,3,"تَوَكَّلۡتُ عَلَى ٱللَّهِ","فَوَّضْتُ أمري إليه، واعتمَدْتُ عليه."],[8,8,"دَآبَّةٍ","كلُّ حَيَوانٍ يَمْشِي -على هيئتِه- على الأرضِ."],[11,12,"ءَاخِذُۢ بِنَاصِيَتِهَآ","مالِكُها وقادرٌ عليها."]],"57":[[8,11,"وَيَسۡتَخۡلِفُ رَبِّي قَوۡمًا غَيۡرَكُمۡ","يأتي بقومٍ آخَرين بَعْدَكم."],[20,20,"حَفِيظٌ","رقيبٌ مُهَيْمِنٌ."]],"58":[[1,2,"جَآءَ أَمۡرُنَا","أي: بهَلاكِ قومِ هودٍ."],[13,13,"غَلِيظٍ","شديدٍ، وهو الرِّيحُ الباردةُ التي أُهلِكَتْ بها عادٌ."]],"59":[[10,10,"جَبَّارٍ","متكبِّرٍ."],[11,11,"عَنِيدٍ","لا يَقْبَلُ الحقَّ ولا يَتْبَعُه."]],"60":[[4,4,"لَعۡنَةً","سُخْطًا من اللهِ، وبُعْدًا من رحمتِه."],[13,13,"بُعۡدًا","هَلاكًا."]],"61":[[1,1,"ثَمُودَ","قومِ صالحٍ عليه السلامُ، وهم قبيلةٌ من العَرَبِ."],[14,16,"أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ","ابتدأ خَلْقَكم منها."],[17,18,"وَٱسۡتَعۡمَرَكُمۡ فِيهَا","جَعَلَكم عُمّارَها وسكّانَها."]],"62":[[5,5,"مَرۡجُوًّا","نرجو أن تكونَ فينا سَيِّدًا مُطاعًا."],[20,20,"مُرِيبٍ","مُوقِعٍ في القلقِ وعَدَمِ الاطمئنانِ."]],"63":[[2,2,"أَرَءَيۡتُمۡ","أخْبِروني."],[6,8,"بَيِّنَةٍ مِّن رَّبِّي","حُجَّةٍ وبُرْهانٍ منه."],[11,11,"رَحۡمَةً","أي: النبوَّةَ والحِكْمةَ."],[21,21,"تَخۡسِيرٍ","إيقاعٍ في الخُسْرانِ وإبعادٍ عن الخير."]],"64":[[5,5,"ءَايَةً","علامةً دالَّةً على صِدْقي."],[6,6,"فَذَرُوهَا","فاترُكوها."],[13,13,"بِسُوٓءٍ","بأيِّ أذى."]],"65":[[0,0,"فَعَقَرُوهَا","فنَحَرُوا الناقةَ."],[2,4,"تَمَتَّعُواْ فِي دَارِكُمۡ","استَمْتِعُوا بالعيشِ في بلدِكم."]],"66":[[1,2,"جَآءَ أَمۡرُنَا","أي: بهَلاكِ قومِ صالحٍ."],[11,11,"خِزۡيِ","ذُلِّ ومَهانَةِ."]],"67":[[3,3,"ٱلصَّيۡحَةُ","الصوتُ الشديدُ المُهلِكُ."],[7,7,"جَـٰثِمِينَ","لاصِقِين بالأرضِ على رُكَبهِم ووُجوهِهم لا حَراكَ بهم."]],"68":[[0,3,"كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَآ","كأنّ قومَ صالحٍ لم يُقيموا في ديارِهم ويَتمتَّعُوا فيها."],[10,10,"بُعۡدًا","هَلاكًا."]],"69":[[2,2,"رُسُلُنَآ","الملائكةُ."],[4,4,"بِٱلۡبُشۡرَىٰ","ببِشارَتِه بالولَدِ."],[14,14,"حَنِيذٍ","مَشْويٍّ في النارِ، أو على حِجارةٍ مُحمّاةٍ بها."]],"70":[[6,6,"نَكِرَهُمۡ","أنكرَ عَدَمَ أكلِهم."],[7,9,"وَأَوۡجَسَ مِنۡهُمۡ خِيفَةً","أحَسَّ في نفسِه خوْفًا منهم."]],"72":[[1,1,"يَـٰوَيۡلَتَىٰٓ","كلمةٌ أرادَتْ بها التعجُّبَ."],[6,6,"بَعۡلِي","زوجي."],[7,7,"شَيۡخًا","كبيرًا في السِّن."]],"73":[[12,12,"حَمِيدٌ","محمودٌ في صفاتِه وأفعالِه."],[13,13,"مَّجِيدٌ","ذو شَرَفٍ وكَرَمٍ، أو كثيرُ الخيرِ والإحسانِ."]],"74":[[4,4,"ٱلرَّوۡعُ","الخوفُ."]],"75":[[2,2,"لَحَلِيمٌ","صَبُورٌ على الأذى، كثيرُ الصَّفْحِ عَمَّن ناله بمَكْروهٍ."],[3,3,"أَوَّٰهٌ","كثيرُ التضرُّعِ إلى اللهِ."],[4,4,"مُّنِيبٌ","رَجّاعٌ إلى اللهِ في أمورِه كلِّها."]],"76":[[6,8,"جَآءَ أَمۡرُ رَبِّكَ","أي: بهَلاكِ قومِ لوطٍ."]],"77":[[4,5,"سِيٓءَ بِهِمۡ","ساءَه حُضورُهم وأحْزَنَه."],[6,8,"وَضَاقَ بِهِمۡ ذَرۡعًا","ضَعُفَتْ طاقَتُه عن تَدْبيرِ خَلاصِهم."],[12,12,"عَصِيبٌ","شديدٌ شَرُّه وبلاؤُه."]],"78":[[2,2,"يُهۡرَعُونَ","يُسْرِعُون المشيَ إليه؛ لطَلَبِ الفاحشةِ."],[11,12,"هَـٰٓؤُلَآءِ بَنَاتِي","نساؤُكم بناتي فتزوَّجُوهنَّ."],[18,19,"وَلَا تُخۡزُونِ","لا تَفْضَحُوني ولا تُهينوني."],[25,25,"رَّشِيدٌ","حَسَنُ التقديرِ للأمورِ."]],"79":[[7,8,"مِنۡ حَقٍّ","من حاجةٍ أو رغبةٍ."]],"80":[[1,5,"لَوۡ أَنَّ لِي بِكُمۡ قُوَّةً","لو وجَدْتُ مُعِينًا منكم لَمَنعْتُكم من أضيافي."],[6,10,"أَوۡ ءَاوِيٓ إِلَىٰ رُكۡنٍ شَدِيدٍ","أو ألجأُ إلى عشيرةٍ قويَّة تمنعني منكم."]],"81":[[8,9,"فَأَسۡرِ بِأَهۡلِكَ","فاخرُجْ أنتَ وأهلُك المؤمنون."],[10,12,"بِقِطۡعٍ مِّنَ ٱلَّيۡلِ","بآخِر الليلِ."],[17,18,"إِلَّا ٱمۡرَأَتَكَ","فلا تَسْرِ بها."]],"82":[[1,2,"جَآءَ أَمۡرُنَا","أي: بهلاكِ قومِ لوطٍ."],[3,5,"جَعَلۡنَا عَـٰلِيَهَا سَافِلَهَا","جَعَلْنا عاليَ قُراهم سافِلَها فقَلَبْناها عليهم."],[6,6,"وَأَمۡطَرۡنَا","أرْسَلْنا."],[10,10,"سِجِّيلٍ","من طِينٍ مُتَحَجِّر."],[11,11,"مَّنضُودٍ","مُتتابعٍ في النزولِ."]],"83":[[0,2,"مُّسَوَّمَةً عِندَ رَبِّكَ","مُعَلَّمَةً عند الله بعَلامةٍ تميِّزُها."]],"84":[[1,1,"مَدۡيَنَ","قومِ شُعيبٍ عليه السلام، وهم قبيلةٌ من العربِ."],[24,25,"يَوۡمٍ مُّحِيطٍ","لا يَفْلِتُ فيه أحدٌ من العذاب."]],"85":[[1,1,"أَوۡفُواْ","أتِمُّوا."],[4,4,"بِٱلۡقِسۡطِ","بالعدلِ من غيرِ زيادةٍ ولا نقصٍ."],[5,6,"وَلَا تَبۡخَسُواْ","ولا تَنْقُصُوا."],[9,10,"وَلَا تَعۡثَوۡاْ","ولا تُفْرِطُوا في الفسادِ."]],"86":[[0,3,"بَقِيَّتُ ٱللَّهِ خَيۡرٌ لَّكُمۡ","ما أبقى اللهُ لكم من الحَلالِ فيه بَرَكَةٌ وخيرٌ لكم."],[10,10,"بِحَفِيظٍ","برقيبٍ أُحْصِي أعمالَكم."]],"87":[[18,18,"ٱلۡحَلِيمُ","العاقلُ المتأنِّي."],[19,19,"ٱلرَّشِيدُ","الحَسَنُ التدبيرِ في المالِ."]],"88":[[6,6,"بَيِّنَةٍ","حُجَّةٍ واضحةٍ."],[12,12,"حَسَنًا","واسعًا حلالًا."],[27,28,"وَمَا تَوۡفِيقِيٓ","وما هدايتي إلى إصابةِ الحقِّ والإصلاحِ."],[32,32,"تَوَكَّلۡتُ","اعتمَدْتُ وفوَّضْتُ أمري."],[33,34,"وَإِلَيۡهِ أُنِيبُ","أرْجِعُ في كلِّ أموري."]],"89":[[1,3,"لَا يَجۡرِمَنَّكُمۡ شِقَاقِيٓ","لا تَحْمِلَنَّكم مُعاداتي."],[17,21,"وَمَا قَوۡمُ لُوطٍ مِّنكُم بِبَعِيدٍ","أي: وما إهلاكُهم بزمانٍ ولا مكانٍ بعيدٍ منكم."]],"90":[[8,8,"وَدُودٌ","كثيرُ المودَّةِ والمحبَّةِ لِمَن تابَ إليه وأنابَ."]],"91":[[2,3,"مَا نَفۡقَهُ","لا نَفْهَمُ ولا نُدْرِكُ."],[12,12,"رَهۡطُكَ","عشيرتُك الأقربون."],[13,13,"لَرَجَمۡنَـٰكَ","لَقَتَلْناك رَجْمًا بالحجارةِ."]],"92":[[7,9,"وَٱتَّخَذۡتُمُوهُ وَرَآءَكُمۡ ظِهۡرِيًّا","نَبَذْتُم أمرَ اللهِ وراءَ ظُهورِكم، فلم تَمْتثلُوا له."],[14,14,"مُحِيطٌ","لا يَخْفى عليه شيءٌ من أقوالِكم وأفعالِكم."]],"93":[[2,3,"عَلَىٰ مَكَانَتِكُمۡ","حالتِكم التي أنتم عليها من الكفر."],[11,11,"يُخۡزِيهِ","يُهينُه ويُذِلُّه."],[15,15,"وَٱرۡتَقِبُوٓاْ","وانتظِرُوا عاقبةَ أمرِكم."],[18,18,"رَقِيبٌ","مُنتظِرٌ."]],"94":[[1,2,"جَآءَ أَمۡرُنَا","أي: بهَلاكِ قومِ شُعيبٍ."],[13,13,"ٱلصَّيۡحَةُ","وهي الصوتُ الشديدُ المُهلِكُ."],[17,17,"جَـٰثِمِينَ","لاصِقين بالأرض على رُكَبِهم ووجوهِهم لاحَراكَ بهم."]],"95":[[0,3,"كَأَن لَّمۡ يَغۡنَوۡاْ فِيهَآ","كأنّ قومَ شعيبٍ لم يُقيموا في ديارهم ويتمتَّعوا فيها."],[5,5,"بُعۡدًا","هَلاكًا."]],"96":[[3,3,"بِـَٔايَـٰتِنَا","بالتوراةِ، وبما أعْطَيْناه من أدلَّةٍ على توحيدِنا."],[4,5,"وَسُلۡطَـٰنٍ مُّبِينٍ","حُجَّةٍ بينةٍ على صِدْقِه."]],"97":[[2,2,"وَمَلَإِيْهِۦ","أشرافِ قومهِ وسادتِهم."],[9,9,"بِرَشِيدٍ","مُصيبٍ للحقِّ وللطريقِ السَّديدِ."]],"98":[[0,1,"يَقۡدُمُ قَوۡمَهُۥ","يتقدَّمُهم."],[4,5,"فَأَوۡرَدَهُمُ ٱلنَّارَ","فأدخَلَهم فيها."],[7,8,"ٱلۡوِرۡدُ ٱلۡمَوۡرُودُ","المَدْخَلُ الذي يَدْخُلونه، وهو النارُ."]],"99":[[0,0,"وَأُتۡبِعُواْ","أُلْحِقُوا."],[1,2,"فِي هَـٰذِهِۦ","أي: الدنيا."],[3,3,"لَعۡنَةً","إبعادًا عن اللهِ."],[7,8,"ٱلرِّفۡدُ ٱلۡمَرۡفُودُ","العطاءُ المعطى لهم، وهو لعنةُ الدنيا والآخرةِ."]],"100":[[4,5,"نَقُصُّهُۥ عَلَيۡكَ","نُخْبِرُك به."],[7,7,"قَآئِمٌ","له آثارٌ باقية."],[8,8,"وَحَصِيدٌ","ما لا أثَر له."]],"101":[[5,7,"فَمَآ أَغۡنَتۡ عَنۡهُمۡ","فما نَفَعَتْهم."],[17,19,"جَآءَ أَمۡرُ رَبِّكَ","أي: بهَلاكِهم."],[22,23,"غَيۡرَ تَتۡبِيبٍ","غيرَ تَخْسيرٍ وإهلاكٍ."]],"103":[[3,3,"لَـَٔايَةً","لَعِبْرَةً وعِظةً."]],"106":[[7,7,"زَفِيرٌ","إخراجُ النَّفَسِ من الصَّدْرِ؛ من شِدَّةِ الحُزْنِ."],[8,8,"وَشَهِيقٌ","رَدُّ النَّفَسِ إلى الصَّدْرِ مع طولٍ فيه."]],"108":[[16,17,"غَيۡرَ مَجۡذُوذٍ","غيرَ مقطوعٍ عنهم."]],"109":[[3,3,"مِرۡيَةٍ","شَكٍّ."]],"110":[[3,3,"ٱلۡكِتَـٰبَ","التوراةَ."],[7,10,"كَلِمَةٌ سَبَقَتۡ مِن رَّبِّكَ","وهي حُكْمُه بتأخيرِ عذابِ الخَلْقِ إلى يومِ القيامةِ."],[17,17,"مُرِيبٍ","مُوقِعٍ في القَلَقِ وعدمِ الاطمئنانِ."]],"112":[[6,7,"وَلَا تَطۡغَوۡاْ","ولا تتجاوَزُوا حدودَ اللهِ."]],"113":[[0,1,"وَلَا تَرۡكَنُوٓاْ","ولا تَمِيلُوا بمَوَدَّةٍ."],[13,13,"أَوۡلِيَآءَ","أنصارٍ."]],"114":[[4,6,"وَزُلَفًا مِّنَ ٱلَّيۡلِ","جَمْعُ زُلْفَة، أي: ساعاتٍ من أوَّلِه."]],"116":[[0,0,"فَلَوۡلَا","فهَلّا."],[3,3,"ٱلۡقُرُونِ","جَمْعُ قَرْنٍ، وهم القومُ المقتَرنون في زمانٍ واحدٍ."],[6,7,"أُوْلُواْ بَقِيَّةٍ","أصحابُ خيرٍ وصلاحٍ."],[21,23,"مَآ أُتۡرِفُواْ فِيهِ","ما مُتِّعُوا فيه من لذّاتِ الدُّنيا ونعيمِها."]],"119":[[6,6,"وَتَمَّتۡ","وجَبَتْ."],[7,8,"كَلِمَةُ رَبِّكَ","حُكْمُه وقضاؤُه."],[12,12,"ٱلۡجِنَّةِ","الجِنِّ."]],"120":[[1,2,"نَّقُصُّ عَلَيۡكَ","نُخْبِرُك ونُبيِّنُ لك."],[7,7,"نُثَبِّتُ","نُقَوِّي ونُطَمْئِنُ."]],"121":[[6,6,"مَكَانَتِكُمۡ","حالتِكم التي أنتم عليها من الكفرِ."]],"123":[[0,3,"وَلِلَّهِ غَيۡبُ ٱلسَّمَـٰوَٰتِ وَٱلۡأَرۡضِ","عِلْمُ جميعِ ما هو غائبٌ عن العبادِ فيهما."],[9,10,"وَتَوَكَّلۡ عَلَيۡهِ","اعتمِدْ وفَوِّضْ أمْرَك إليه وحدَه."]]}