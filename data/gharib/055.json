{"4":[[1,1,"ٱلۡبَيَانَ","النُّطْقَ والتَّعْبِيرَ عَمّا في الضَّمائِرِ."]],"5":[[2,2,"بِحُسۡبَانٍ","يَجْرِيانِ بِحِسابٍ مُتْقَنٍ."]],"7":[[3,3,"ٱلۡمِيزَانَ","العَدْلَ الَّذِي شَرَعَهُ لِعِبادِهِ."]],"8":[[0,1,"أَلَّا تَطۡغَوۡاْ","لِئَلّا تَعْتَدُوا."]],"9":[[2,2,"بِٱلۡقِسۡطِ","بالعَدْلِ."],[3,4,"وَلَا تُخۡسِرُواْ","ولا تُنْقِصُوا."]],"10":[[1,1,"وَضَعَهَا","مَهَّدَها."],[2,2,"لِلۡأَنَامِ","لِلْخَلْقِ."]],"11":[[4,4,"ٱلۡأَكۡمَامِ","جَمْعُ كِمٍّ وهو وِعاءُ الثَّمرَةِ."]],"12":[[1,2,"ذُو ٱلۡعَصۡفِ","ذُو القِشْرِ."],[3,3,"وَٱلرَّيۡحَانُ","كُلُّ نَبْتٍ طَيِّبِ الرّائِحةِ."]],"13":[[1,1,"ءَالَآءِ","نِعَمِ."]],"14":[[1,1,"ٱلۡإِنسَـٰنَ","أي أباه، وهو آدَمُ."],[2,3,"مِن صَلۡصَـٰلٍ","مِن طِينٍ يابِسٍ."],[4,4,"كَٱلۡفَخَّارِ","الطينِ الَّذِي طُبِخَ بالنّارِ."]],"15":[[1,1,"ٱلۡجَآنَّ","إبْلِيسَ."],[3,3,"مَّارِجٍ","لَهَبِ الَّنارِ المُخْتَلِطِ بَعْضُهُ بِبَعْضٍ."]],"17":[[1,1,"ٱلۡمَشۡرِقَيۡنِ","مَشْرِقَي الشَّمْسِ في الشِّتاءِ والصَّيفِ."],[3,3,"ٱلۡمَغۡرِبَيۡنِ","مَغْرِبَيِ الشَّمسِ في الشِّتاءِ والصَّيفِ."]],"19":[[0,0,"مَرَجَ","خَلَطَ."],[1,1,"ٱلۡبَحۡرَيۡنِ","الماءَ العَذْبَ والمِلْحَ."],[2,2,"يَلۡتَقِيَانِ","في مَرْأى العَينِ."]],"20":[[1,1,"بَرۡزَخٌ","حاجِزٌ."],[2,3,"لَّا يَبۡغِيَانِ","لا يطْغى أحَدُهُما عَلى الآخَرِ."]],"22":[[2,2,"ٱللُّؤۡلُؤُ","الدُّرُّ."],[3,3,"وَٱلۡمَرۡجَانُ","صِغارُ اللُّؤلُؤ."]],"24":[[1,1,"ٱلۡجَوَارِ","السُّفُنُ الضَّخْمَةُ الَّتِي تَجْرِي في البَحْرِ."],[2,2,"ٱلۡمُنشَـَٔاتُ","المَرْفُوعاتُ الشِّراعِ."],[5,5,"كَٱلۡأَعۡلَـٰمِ","كالجِبالِ."]],"26":[[2,2,"عَلَيۡهَا","عَلى وجْهِ الأرْضِ."],[3,3,"فَانٍ","هالِكٌ."]],"27":[[4,4,"ٱلۡجَلَـٰلِ","ذُو العَظَمَةِ والكِبْرِياءِ."],[5,5,"وَٱلۡإِكۡرَامِ","والفَضْلِ والجُودِ."]],"31":[[0,0,"سَنَفۡرُغُ","سنفرغ لحسابكم ومجازاتكم بأعْمالِكُم."],[2,3,"أَيُّهَ ٱلثَّقَلَانِ","أيُّها الإنْسُ والجِنُّ."]],"33":[[6,6,"تَنفُذُواْ","تَخْرُجُوا."],[8,8,"أَقۡطَارِ","أطْرافِ."],[15,15,"بِسُلۡطَـٰنٍ","بِقُوَّةٍ وحُجَّةٍ."]],"35":[[2,2,"شُوَاظٌ","لَهَبٌ."],[5,5,"وَنُحَاسٌ","مُذابٌ يُصَبُّ على رُؤُوسِكُم."],[6,7,"فَلَا تَنتَصِرَانِ","فَلا يَنْصُرُ بَعْضُكُم بَعْضًا."]],"37":[[1,1,"ٱنشَقَّتِ","تَفَطَّرَتْ يَوْمَ القِيامَةِ."],[4,4,"وَرۡدَةً","حَمْراءَ كَلَونِ الوَرْدِ."],[5,5,"كَٱلدِّهَانِ","كالزَّيتِ الَمغْلِيِّ والرَّصاصِ المُذابِ."]],"41":[[2,2,"بِسِيمَـٰهُمۡ","بعَلاماتِهِم."],[4,4,"بِٱلنَّوَٰصِي","بمُقَدِّمَةِ رُؤُوسِهِم."]],"44":[[3,3,"حَمِيمٍ","الماءِ الشَّدِيدِ الحَرارَةِ."],[4,4,"ءَانٍ","بالغٍ مُنْتَهاهُ في الحرارةِ."]],"46":[[2,3,"مَقَامَ رَبِّهِۦ","وقْتَ قِيامِهِ بين يَدَي رَبِّهِ."]],"48":[[1,1,"أَفۡنَانٍ","أغْصانٍ نَضِرَةٍ مِنَ الفَواكِهِ والثِّمارِ."]],"52":[[4,4,"زَوۡجَانِ","صِنْفانِ."]],"54":[[3,3,"بَطَآئِنُهَا","جَمْعُ بِطانَةٍ وهي: ما يَلِي الأرْضَ مِنَ الفِراشِ."],[5,5,"إِسۡتَبۡرَقٍ","غَلِيظِ الحرِيرِ الخالِصِ."],[6,6,"وَجَنَى","وثَمَرُ."],[8,8,"دَانٍ","قَرِيبٌ إليهِم."]],"56":[[0,0,"فِيهِنَّ","في هَذِه الفُرُشِ."],[1,2,"قَـٰصِرَٰتُ ٱلطَّرۡفِ","لا يَصْرِفْنَ أبْصارَهُنَّ إلى غَيرِ أزْواجِهِنَّ."],[3,4,"لَمۡ يَطۡمِثۡهُنَّ","لم يَطَأْهُنَّ."]],"58":[[1,1,"ٱلۡيَاقُوتُ","حَجَرٌ مِنَ الأحْجارِ الكَرِيمَةِ، ذُو ألْوانٍ."],[2,2,"وَٱلۡمَرۡجَانُ","صِغارُ اللُّؤلُؤِ."]],"62":[[0,1,"وَمِن دُونِهِمَا","ومِن دُونِ الجنَّتَينِ السّابِقَتَينِ في الدَّرَجِ."]],"64":[[0,0,"مُدۡهَآمَّتَانِ","خَضْراوانِ، وقَدِ اشْتَدَّتْ خُضْرَتُهُما حَتّى مالَتْ إلى السَّوادِ."]],"66":[[2,2,"نَضَّاخَتَانِ","فَوّارتانِ بالماءِ لا تَنْقَطِعانِ."]],"70":[[0,0,"فِيهِنَّ","في هَذِه الجنّاتِ الأرْبَعِ."],[1,1,"خَيۡرَٰتٌ","زَوْجاتٌ طيِّباتُ الأخْلاقِ."],[2,2,"حِسَانٌ","حِسانُ الوُجُوهِ."]],"72":[[0,0,"حُورٌ","نِساءٌ ذَواتُ حَوَرٍ، وهو شِدَّةُ بَياضِ العَينِ وشِدَّةُ سَوادِها."],[1,1,"مَّقۡصُورَٰتٌ","مَسْتُوراتٌ مَصُوناتٌ."],[3,3,"ٱلۡخِيَامِ","البُيوتِ."]],"76":[[2,2,"رَفۡرَفٍ","وسائِدَ ذَواتِ أغْطِيَةٍ."],[4,4,"وَعَبۡقَرِيٍّ","وفُرُشٍ بَدِيعَةٍ."]],"78":[[0,0,"تَبَـٰرَكَ","كَثُرَ خَيرُهُ."],[4,4,"ٱلۡجَلَـٰلِ","العَظَمَةِ والمَجْدِ."],[5,5,"وَٱلۡإِكۡرَامِ","لِأَوْلِيائِهِ."]]}