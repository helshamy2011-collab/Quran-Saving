{"1":[[6,6,"أَنذِرۡ","حَذِّرْ."]],"7":[[5,8,"جَعَلُوٓاْ أَصَـٰبِعَهُمۡ فِيٓ ءَاذَانِهِمۡ","أي لِئَلّا يَسْمَعُوا دَعْوةَ الحقِّ."],[9,10,"وَٱسۡتَغۡشَوۡاْ ثِيَابَهُمۡ","تَغَطَّوا بِثيابِهِم عَلى أعْيُنِهِم كَي لا يَرَونِي."],[11,11,"وَأَصَرُّواْ","أي عَلى ما هُم فِيهِ مِنَ الكُفْرِ."]],"8":[[3,3,"جِهَارًا","ظاهِرًا عَلَنًا."]],"9":[[2,3,"أَعۡلَنتُ لَهُمۡ","كَلامًا ظاهِرًا."]],"11":[[0,1,"يُرۡسِلِ ٱلسَّمَآءَ","يُنْزِلِ اللهُ المَطَرَ."],[3,3,"مِّدۡرَارًا","كَثِيرَ الدَّرِّ والصَّبِّ."]],"12":[[0,0,"وَيُمۡدِدۡكُم","ويُعْطِكُم."]],"13":[[2,5,"لَا تَرۡجُونَ لِلَّهِ وَقَارًا","لا تَخافُونَ عَظَمَةَ اللهِ وسُلْطانَهُ."]],"14":[[0,2,"وَقَدۡ خَلَقَكُمۡ أَطۡوَارًا","أطوارًا مُتَدَرِّجَةً: نُطْفَةً ثم عَلَقَةً ثم مُضْغَةً ثم عِظامًا ولحمًا."]],"15":[[7,7,"طِبَاقًا","مُتَطابِقَةً بعضُها فَوقَ بَعْضٍ."]],"16":[[6,6,"سِرَاجًا","مُضِيئًا."]],"17":[[0,1,"وَٱللَّهُ أَنۢبَتَكُم","أنْشأَ أصْلَكُم."],[4,4,"نَبَاتًا","إنْشاءً."]],"18":[[3,3,"وَيُخۡرِجُكُمۡ","يَومَ البَعْثِ"]],"19":[[4,4,"بِسَاطًا","مُمهَّدةً كالبِساطِ."]],"20":[[2,2,"سُبُلًا","طُرُقًا."],[3,3,"فِجَاجًا","واسِعةً."]],"22":[[2,2,"كُبَّارًا","عَظِيمًا."]],"23":[[1,3,"لَا تَذَرُنَّ ءَالِهَتَكُمۡ","لا تَترُكُوا عِبادةَ آلهتِكُم."],[4,12,"وَلَا تَذَرُنَّ وَدًّا وَلَا سُوَاعًا وَلَا يَغُوثَ وَيَعُوقَ وَنَسۡرًا","ولا تَتْرُكُوا عِبادةَ هَذِهِ الأصْنامِ الَّتِي هي تَماثِيلُ رجالٍ صالِحِينَ."]],"24":[[2,2,"كَثِيرًا","مِنَ النّاسِ."],[5,5,"ٱلظَّـٰلِمِينَ","لِأَنفُسِهِم بالكُفْرِ والعِنادِ."],[7,7,"ضَلَـٰلًا","بُعْدًا عَن الحقِّ."]],"25":[[0,1,"مِّمَّا خَطِيٓـَٔـٰتِهِمۡ","بِسَبَبِ ذُنُوبِهِم وإصْرارِهِم عَلى الكُفْرِ والطُّغْيانِ."],[2,2,"أُغۡرِقُواْ","بالطُّوفانِ."],[11,11,"أَنصَارًا","مَن يَنْصُرُهُم، أو يَدْفَعُ عَنْهُم عَذابَ اللهِ."]],"26":[[3,4,"لَا تَذَرۡ","لا تَتْرُكْ."],[9,9,"دَيَّارًا","أحَدًا حَيًّا عَلى الأرْضِ، يَدُورُ ويَتَحَرَّكُ."]],"27":[[1,2,"إِن تَذَرۡهُمۡ","إن تَتْرُكْهُم دُونَ إهْلاكٍ."],[7,8,"إِلَّا فَاجِرًا","إلا مائِلًا عَنِ الحقِّ."],[9,9,"كَفَّارًا","شَدِيدَ الكُفْرِ بِكَ والعِصْيانِ لَك."]],"28":[[14,14,"تَبَارَۢا","هَلاكًا وخُسْرانًا في الدُّنيا والآخِرَةِ."]]}