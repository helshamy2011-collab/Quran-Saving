{"1":[[0,0,"أَلۡهَىٰكُمُ","شَغَلَكُم عَن طاعَةِ اللهِ."],[1,1,"ٱلتَّكَاثُرُ","التَّفاخُرُ بِكَثْرةِ الأَمْوالِ والأولادِ."]],"2":[[0,2,"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","وانْشَغَلتُم بِذَلِكَ إلى أن دُفِنتم في المقابِر."]],"3":[[0,0,"كَلَّا","ما هَكَذا ينبغي أن يُلْهيَكُم التكاثُرُ بالأَمْوالِ."],[1,2,"سَوۡفَ تَعۡلَمُونَ","أنَّ الدّارَ الآخِرةَ خَيرٌ لَكُم."]],"5":[[1,4,"لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","لو تَعْلَمُونَ حَقَّ العِلْمِ لانْزَجَرْتُم، ولَبادَرْتُم إلى إنقاذِ أنفُسِكُم مِنَ الهَلاكِ."]],"6":[[0,1,"لَتَرَوُنَّ ٱلۡجَحِيمَ","لَتُبصِرُنَّ الجحِيمَ."]],"7":[[0,3,"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","ثُمَّ لَتُبْصِرُنَّها دُونَ رَيبٍ."]],"8":[[2,2,"يَوۡمَئِذٍ","يومَ القِيامةِ."],[3,4,"عَنِ ٱلنَّعِيمِ","عَن كُلِّ أنَواعِ النَّعِيمِ."]]}