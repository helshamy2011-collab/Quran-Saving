{"1":[[0,0,"يُسَبِّحُ","يُنَزِّهُ."],[8,8,"ٱلۡمَلِكِ","المالِكِ لِكُلِّ شَيءٍ المتَصَرِّفِ فِيهِ بِلا مُنازِعٍ."],[9,9,"ٱلۡقُدُّوسِ","المنَزَّهِ عَن كُلِّ نَقْصٍ."],[10,10,"ٱلۡعَزِيزِ","الَّذِي لا يُغالَبُ"],[11,11,"ٱلۡحَكِيمِ","المحْكِم فِي تَدْبِيرِهِ وصُنْعِهِ."]],"2":[[4,4,"ٱلۡأُمِّيِّـۧنَ","العربِ الَّذِينَ لا يَقْرَؤُونَ ولا يَكْتُبُونَ."],[9,9,"ءَايَـٰتِهِۦ","القُرْآنَ."],[10,10,"وَيُزَكِّيهِمۡ","ويُطَهِّرهم مِنَ العقائِدِ الفاسِدَةِ والأخْلاقِ السَّيِّئةِ."],[12,12,"ٱلۡكِتَـٰبَ","القُرْآنَ."],[13,13,"وَٱلۡحِكۡمَةَ","والسُّنَّةَ."]],"3":[[0,0,"وَءَاخَرِينَ","وأَرْسَلَهُ إلى آخَرِينَ."],[1,1,"مِنۡهُمۡ","مِنَ العَرَبِ ومِن غَيْرِهِم."],[2,4,"لَمَّا يَلۡحَقُواْ بِهِمۡ","لَمْ يَجِيئُوا بَعْدُ، وسَيَجِيئُونَ."]],"4":[[1,2,"فَضۡلُ ٱللَّهِ","مِمّا تَفَضَّلَ اللهُ بِهِ عَلى هَؤلاءِ دُونَ غَيرِهِم."],[8,9,"ٱلۡفَضۡلِ ٱلۡعَظِيمِ","الإحْسانِ والعَطاءِ الجَزِيلِ."]],"5":[[0,0,"مَثَلُ","شَبَهُ."],[2,3,"حُمِّلُواْ ٱلتَّوۡرَىٰةَ","كُلِّفُوا العَمَلَ بِها."],[5,6,"لَمۡ يَحۡمِلُوهَا","لم يَعْمَلُوا بِها."],[10,10,"أَسۡفَارَۢا","كُتُبًا لا يَدْرِي ما فِيها."],[11,11,"بِئۡسَ","قَبُحَ."],[19,20,"لَا يَهۡدِي","لا يُوفِّقُ."]],"6":[[3,3,"هَادُوٓاْ","تَمَسَّكُوا بالِملَّةِ اليهُودِيَّةِ."],[7,8,"أَوۡلِيَآءُ لِلَّهِ","أحِبّاءُ للهِ."]],"7":[[3,5,"بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ","بِسببِ ما اكْتَسَبُوا في هذه الدُّنيا مِنَ الآثامِ."]],"8":[[6,7,"فَإِنَّهُۥ مُلَـٰقِيكُمۡ","آتٍ إلَيكُم وقْتَ مَجِيءِ آجالِكُم."],[8,9,"ثُمَّ تُرَدُّونَ","ثم تُرْجَعُونَ يَومَ القِيامةِ."],[12,12,"ٱلۡغَيۡبِ","ما غابَ."],[13,13,"ٱلشَّهَـٰدَةِ","ما حَضَرَ."]],"9":[[4,4,"نُودِيَ","نادى المؤَذِّنُ."],[9,9,"فَٱسۡعَوۡاْ","فامْضُوا وأَقْبِلُوا إلَيها."],[11,12,"ذِكۡرِ ٱللَّهِ","الموعظةِ في خُطْبَةِ الإمامِ."],[13,13,"وَذَرُواْ","واتْرُكُوا."]],"10":[[6,9,"وَٱبۡتَغُواْ مِن فَضۡلِ ٱللَّهِ","واطْلُبُوا مِن رِزْقِ اللهِ."],[14,14,"تُفۡلِحُونَ","تَفُوزُونَ بِخَيرَيِ الدُّنيا والآخِرَةِ."]],"11":[[4,4,"لَهۡوًا","صارِفًا عَنِ الصَّلاةِ."],[5,5,"ٱنفَضُّوٓاْ","تَفَرَّقُوا."],[8,8,"قَآئِمًا","أي: عَلى الِمنْبَرِ."]]}