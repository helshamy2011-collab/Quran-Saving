{"1":[[0,0,"وَيۡلٌ","عذابٌ شَدِيدٌ."],[1,1,"لِّلۡمُطَفِّفِينَ","وهُمُ الَّذِينَ يَبْخَسُونَ المِكْيالَ والِميزانَ."]],"2":[[0,4,"ٱلَّذِينَ إِذَا ٱكۡتَالُواْ عَلَى ٱلنَّاسِ","الَّذِينَ إذا اشْتَرَوا مِنَ النّاسِ مَكِيلًا أو مَوزُونًا."],[5,5,"يَسۡتَوۡفُونَ","يَطْلُبُونَ وفاءَ نَصِيبِهِم."]],"3":[[0,1,"وَإِذَا كَالُوهُمۡ","وإذا باعُوا النّاس مَكِيلا."],[3,3,"وَّزَنُوهُمۡ","باعُوا النّاسَ مَوزُونًا."],[4,4,"يُخۡسِرُونَ","يَنْقُصُونَ في المِكيالِ والِميزانِ."]],"4":[[1,1,"يَظُنُّ","يَعْتَقِدُ."]],"7":[[0,0,"كَلَّآ","ليسَ الأَمْرُ كَما يَظُنُّ هَؤُلِاءِ الكُفّارُ، أنّهم غَيرُ مَبْعُوثِينَ."],[2,3,"كِتَـٰبَ ٱلۡفُجَّارِ","صَحِيفةَ أعْمالِ المُشْرِكِينَ."],[4,5,"لَفِي سِجِّينٍ","أسْفَلِ الأرْضِ السّابِعَةِ."]],"8":[[0,1,"وَمَآ أَدۡرَىٰكَ","وأيُّ شَيءٍ أعْلَمكَ؟"]],"9":[[1,1,"مَّرۡقُومٌ","مَكْتُوبٌ كِتابَةً بَيِّنةً."]],"10":[[0,0,"وَيۡلٌ","عذابٌ شَدِيدٌ."]],"11":[[2,3,"بِيَوۡمِ ٱلدِّينِ","بُوقُوعِ يَومِ الجَزاءِ."]],"12":[[5,5,"مُعۡتَدٍ","ظالِمٍ."],[6,6,"أَثِيمٍ","كَثِيرِ الإثْمِ."]],"13":[[5,6,"أَسَـٰطِيرُ ٱلۡأَوَّلِينَ","أباطِيلُ السّابِقِينَ."]],"14":[[2,7,"رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكۡسِبُونَ","غَطّى عَلى قُلُوبِهِم كَثْرَةُ ما يَرْتَكِبُونَهُ مِنَ الذُّنُوبِ."]],"15":[[2,3,"عَن رَّبِّهِمۡ","عَن رُّؤْيَةِ رَبِّهِم -جَلَّ وعَلا-."],[5,5,"لَّمَحۡجُوبُونَ","لَمَمْنُوعُونَ."]],"16":[[2,3,"لَصَالُواْ ٱلۡجَحِيمِ","لَداخِلُو النّارِ."]],"18":[[0,0,"كَلَّآ","حَقًّا."],[2,2,"كِتَـٰبَ","صَحائِفَ أعْمالِ."],[3,3,"ٱلۡأَبۡرَارِ","الأَتْقِياءِ."],[4,5,"لَفِي عِلِّيِّينَ","لَفِي المراتِبِ العالِيَةِ في الجنَّةِ."]],"20":[[0,1,"كِتَـٰبٌ مَّرۡقُومٌ","مَكْتُوبٌ كِتابَةً بَيِّنةً."]],"21":[[0,0,"يَشۡهَدُهُ","يَطَّلِعُ عَلَيهِ."]],"22":[[1,1,"ٱلۡأَبۡرَارَ","أهْلَ الصِّدْقِ والطّاعَةِ."],[2,3,"لَفِي نَعِيمٍ","لَفِي الجنَّةِ يَتَنَعَّمُونَ."]],"23":[[1,1,"ٱلۡأَرَآئِكِ","الأَسِرَّةِ."],[2,2,"يَنظُرُونَ","يَنْظُرُونَ إلى رَبِّهِم، وإلى ما أعَدَّ لَهُم مِن خَيراتٍ."]],"24":[[3,4,"نَضۡرَةَ ٱلنَّعِيمِ","بَهْجَةَ النَّعِيمِ وحُسْنَه."]],"25":[[2,2,"رَّحِيقٍ","خَمْرٍ صافِيةٍ."],[3,3,"مَّخۡتُومٍ","مُحْكَمٍ إناؤُها."]],"26":[[0,0,"خِتَـٰمُهُۥ","آخِرُهُ."],[1,1,"مِسۡكٌ","رائِحَةُ مِسْكٍ."],[4,5,"فَلۡيَتَنَافَسِ ٱلۡمُتَنَـٰفِسُونَ","فَليَتَسابَقِ المُتَسابِقُونَ."]],"27":[[0,2,"وَمِزَاجُهُۥ مِن تَسۡنِيمٍ","وخَلْطُه مِن عَينٍ في الجنَّةِ تُعْرَفُ ب«تَسْنِيمٍ»."]],"28":[[1,2,"يَشۡرَبُ بِهَا","مِنها."],[3,3,"ٱلۡمُقَرَّبُونَ","الملائكةُ المُقرَّبُونَ مِنَ اللهِ."]],"29":[[2,2,"أَجۡرَمُواْ","ارْتَكَبُوا الإثمَ العَظِيمَ، وهو الشِّرْكُ."],[7,7,"يَضۡحَكُونَ","يَهْزَؤُونَ."]],"30":[[3,3,"يَتَغَامَزُونَ","يُشِيرُونَ بأطْرافِ العُيُونِ سُخْرِيَةً بِهم."]],"31":[[0,1,"وَإِذَا ٱنقَلَبُوٓاْ","رَجَعُوا."],[5,5,"فَكِهِينَ","مُتَفَكِّهِينَ بالسُّخْرِيَةِ مِنَ المؤُمِنِينَ."]],"32":[[1,1,"رَأَوۡهُمۡ","رَأى هَؤُلاءِ الكُفّارُ أصْحابَ مُحَمَّدٍ ﷺ."]],"33":[[3,3,"حَـٰفِظِينَ","رُقَباءَ عَلى أصْحابِ مُحَمَّدٍ ﷺ."]],"35":[[1,1,"ٱلۡأَرَآئِكِ","المجالِسِ الفاخِرَةِ."],[2,2,"يَنظُرُونَ","يَنْظُرُ المؤمِنُونَ إلى ما أعْطاهُم اللهُ مِنَ الكَرامةِ والنَّعِيم في الجنَّةِ."]],"36":[[0,2,"هَلۡ ثُوِّبَ ٱلۡكُفَّارُ","هل جُوزِي الكُفّارُ مِن جِنْسِ أعمالِهِم؟"]]}