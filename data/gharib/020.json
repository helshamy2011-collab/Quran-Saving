{"2":[[4,4,"لِتَشۡقَىٰٓ","لِتَتْعبَ بفَرْطِ تأسُّفِكَ على كُفْرِهِم."]],"3":[[1,1,"تَذۡكِرَةً","عِظَةً وعِبْرةً."]],"5":[[2,2,"ٱلۡعَرۡشِ","هو سَرِيَرُ المُلْكِ الذي اسْتَوى عَلَيه الرحمنُ، وتَحمِلُه الملائِكةُ، وهو أعْظَمُ المخْلُوقاتِ، وهو سَقْفُ الجنَّةِ."],[3,3,"ٱسۡتَوَىٰ","عَلا وارْتَفَعَ، اسْتِواءً يلِيقُ بِجَلالِه وعَظَمَتِه."]],"6":[[9,11,"وَمَا تَحۡتَ ٱلثَّرَىٰ","باطِنِ الأَرْضِ."]],"9":[[2,3,"حَدِيثُ مُوسَىٰٓ","خبرُ مُوسى بن عِمْرانَ عليه الصَّلاةُ والسَّلامُ، لمّا رَجَعَ مِن مَدْيَنَ إلى مِصْرَ."]],"12":[[8,8,"طُوًى","اسْمِ الوادِي الُمقَدَّسِ."]],"14":[[10,10,"لِذِكۡرِيٓ","لِتَذْكُرَني فِيها."]],"16":[[0,1,"فَلَا يَصُدَّنَّكَ","فلا يَصْرِفَنَّكَ."],[9,9,"فَتَرۡدَىٰ","فَتَهْلَكَ."]],"18":[[3,4,"أَتَوَكَّؤُاْ عَلَيۡهَا","أعْتَمِدُ عَلَيها في المَشْيِ."],[5,6,"وَأَهُشُّ بِهَا","وأَهُزُّ بِها الشَّجَرَ لِيَسْقُطَ مِنه الوَرَقُ."],[11,11,"مَـَٔارِبُ","حاجاتٌ ومَنافعُ."]],"22":[[2,3,"إِلَىٰ جَنَاحِكَ","جَنبِك تَحْتَ العَضُدِ."],[6,8,"مِنۡ غَيۡرِ سُوٓءٍ","مِن غَيرِ مَرَضٍ ولا بَرَصٍ."]],"24":[[4,4,"طَغَىٰ","تَجاوَزَ حَدَّه بالتَّمَرُّدِ على ربِّه."]],"27":[[0,3,"وَٱحۡلُلۡ عُقۡدَةً مِّن لِّسَانِي","وأَطْلِقْ عَنْ لِساني العُقْدَةَ التي فِيه."]],"29":[[2,2,"وَزِيرًا","مُعِينًا في إبْلاغِ رِسالتِكَ."]],"31":[[0,2,"ٱشۡدُدۡ بِهِۦٓ أَزۡرِي","قَوِّني به وشُدَّ به ظَهْري."]],"32":[[1,2,"فِيٓ أَمۡرِي","في النُّبوَّةِ وتَبْلِيغِ الرِّسالةِ."]],"36":[[2,3,"أُوتِيتَ سُؤۡلَكَ","أُعطِيتَ كلَّ ما سألتَ."]],"37":[[0,2,"وَلَقَدۡ مَنَنَّا عَلَيۡكَ","ولَقَدْ أنْعَمْنا عَلَيكَ."],[3,4,"مَرَّةً أُخۡرَىٰٓ","نِعْمَةً أُخْرى بإنْجائِكَ مِن بَطْشِ فِرْعَونَ وجُنُودِه حِينَ كُنْتَ رَضِيعًا."]],"38":[[1,1,"أَوۡحَيۡنَآ","ألْهَمْنا."]],"39":[[1,1,"ٱقۡذِفِيهِ","ضَعِيه."],[3,3,"ٱلتَّابُوتِ","الصُّنْدُوقِ الخَشَبِيِّ."],[4,6,"فَٱقۡذِفِيهِ فِي ٱلۡيَمِّ","فاطْرَحِيه في النِّيلِ."],[15,18,"وَأَلۡقَيۡتُ عَلَيۡكَ مَحَبَّةً مِّنِّي","أي: أحْبَبْتُك، فَصِرْتَ بِذَلكَ مَحْبُوبًا بَيْنَ العِبادِ."],[19,21,"وَلِتُصۡنَعَ عَلَىٰ عَيۡنِيٓ","ولِتُرَبّى بِمَرأىً مِنِّي."]],"40":[[12,14,"كَيۡ تَقَرَّ عَيۡنُهَا","كي تُسَرَّ أُمُّ مُوسى بِسَلامةِ ولَدِها ورُجُوعِه إليها."],[22,22,"وَفَتَنَّـٰكَ","وابْتَلَيناك."],[31,32,"عَلَىٰ قَدَرٍ","عَلى مَوْعِدٍ مُوافِقٍ للوقْتِ الُمقدَّرِ في عِلْمِ اللهِ تَعالى."]],"41":[[0,1,"وَٱصۡطَنَعۡتُكَ لِنَفۡسِي","هَيَّأْتُكَ لِتَبْلِيغِ الرِّسالةِ عَنِّي."]],"42":[[4,5,"وَلَا تَنِيَا","ولا تَضْعُفا."]],"43":[[4,4,"طَغَىٰ","جاوَزَ الحَدَّ في الكُفْرِ والظُّلْمِ."]],"45":[[4,6,"أَن يَفۡرُطَ عَلَيۡنَآ","أن يُعاجِلَنا ويُبادِرَ بالعُقُوبَةِ."],[7,9,"أَوۡ أَن يَطۡغَىٰ","أو أن يَتَمَرَّدَ على الحقِّ فلا يَقْبَلَه."]],"47":[[9,10,"وَلَا تُعَذِّبۡهُمۡ","أي: ولا تُعَذِّبْهم بِذَبْحِ أبْنائِهِم واسْتِحْياءِ بَناتِهِم وتَكْلِيفِهِم بِما لا يُطِيقُونَ مِنَ الأَعْمالِ."]],"50":[[6,6,"خَلۡقَهُۥ","أي: صورتَه اللائِقَةَ بخاصَّتِه ومَنفَعَتِه."]],"51":[[1,4,"فَمَا بَالُ ٱلۡقُرُونِ ٱلۡأُولَىٰ","فما شأنُ الأممِ السّابِقَةِ؟"]],"52":[[4,5,"فِي كِتَـٰبٍ","وهو اللَّوحُ الَمحْفُوظُ."],[6,8,"لَّا يَضِلُّ رَبِّي","أي: لا يُخْطِئُ ربِّي في أفْعالِه وأَحْكامِه."],[9,10,"وَلَا يَنسَى","أيَّ شيءٍ ممّا عَلِمه مِنها."]],"53":[[4,4,"مَهۡدًا","أي: مُيَسَّرةً للانْتِفاعِ بِها، فَصارَتْ كالفِراشِ والِمْهادِ لكلِّ واحدٍ مِنكُم."],[5,8,"وَسَلَكَ لَكُمۡ فِيهَا سُبُلًا","وجَعَل لَكُم فِيها طُرُقًا كَثِيرَةً."],[15,18,"أَزۡوَٰجًا مِّن نَّبَاتٍ شَتَّىٰ","أنْواعًا مُخْتَلِفَةً مِنَ النَّباتِ."]],"54":[[7,8,"لِّأُوْلِي ٱلنُّهَىٰ","لِذَوي العُقُولِ السَّلِيمَةِ."]],"56":[[2,2,"ءَايَـٰتِنَا","أدلَّتَنا وحُجَجَنا."],[5,5,"وَأَبَىٰ","وامْتَنَعَ عَن قَبُولِ الحَقِّ."]],"58":[[12,13,"مَكَانًا سُوًى","في مَكانٍ مُعْتَدِلٍ مُسْتَوٍ بَيْنَنا وبَيْنَكَ."]],"59":[[2,3,"يَوۡمُ ٱلزِّينَةِ","يومُ العيدِ حِينَ يتزيَّنُ الناسُ."],[4,5,"وَأَن يُحۡشَرَ","وأن يُجْمَعَ."]],"61":[[4,5,"لَا تَفۡتَرُواْ","لا تَخْتَلِقُوا."],[9,9,"فَيُسۡحِتَكُم",". فَيَسْتَأْصِلَكُم ويُبِيدَكُمْ."],[12,12,"خَابَ","خَسِرَ وهَلَكَ."]],"62":[[3,4,"وَأَسَرُّواْ ٱلنَّجۡوَىٰ","تَحادَثَ السَّحَرةُ سِرًّا في خَفاءٍ."]],"63":[[11,12,"بِطَرِيقَتِكُمُ ٱلۡمُثۡلَىٰ","بِطَرِيقةِ السِّحْرِ العظيمةِ التي أنْتُم عَلَيها."]],"64":[[0,1,"فَأَجۡمِعُواْ كَيۡدَكُمۡ","فأَحْكِمُوا مَكْرَكُم، ولا تَجْعَلُوهُ مُتَفَرِّقًا."],[8,9,"مَنِ ٱسۡتَعۡلَىٰ","مَن عَلا عَلى صاحِبِه فَغَلَبَهُ وقَهَرَهُ."]],"67":[[0,0,"فَأَوۡجَسَ","فَأَضْمَرَ."],[3,3,"خِيفَةً","خَوْفًا."]],"68":[[4,5,"أَنتَ ٱلۡأَعۡلَىٰ","أنتَ الغالِبُ على هَؤلاءِ السَّحَرةِ."]],"69":[[4,4,"تَلۡقَفۡ","تَبْتَلِعْ بِسُرْعَةٍ."],[11,13,"وَلَا يُفۡلِحُ ٱلسَّاحِرُ","ولا يَظْفَرَ السَّحرةُ بِبُغْيتِهِم."]],"71":[[16,16,"خِلَـٰفٍ","مُخالِفًا بينها: يدًا مِن جِهَةٍ ورِجْلًا مِنَ الجِهَةِ الأخْرى."],[17,17,"وَلَأُصَلِّبَنَّكُمۡ","ولَأُبالِغَنّ في شَدِّ أطْرافِكَم ورَبْطِ أجْسادِكُم."],[18,20,"فِي جُذُوعِ ٱلنَّخۡلِ","على جُذُوعِ النَّخْلِ."],[25,25,"وَأَبۡقَىٰ","وأَدْوَمُ، لا يَنْقَطِعُ."]],"72":[[1,2,"لَن نُّؤۡثِرَكَ","لن نُفَضِّلَكَ."]],"74":[[4,4,"مُجۡرِمًا","كافِرًا."],[8,12,"لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","أي: لا يمُوتُ فيها فَيَسْتَرِيحَ، ولا يحيا حياةً يتلذَّذُ بِها."]],"76":[[0,1,"جَنَّـٰتُ عَدۡنٍ","جَنّاتُ إقامَةٍ دائمةٍ."],[10,11,"مَن تَزَكَّىٰ","مَن تَطهَّرَ مِنَ الكُفْرِ والمَعاصِي."]],"77":[[4,5,"أَنۡ أَسۡرِ","أنِ اخْرُجْ ليلًا بِعِبادِي."],[7,8,"فَٱضۡرِبۡ لَهُمۡ","فاجْعَلْ لهم."],[12,12,"يَبَسًا","يابسًا لا ماءٌ فِيها ولا طِينٌ."],[13,15,"لَّا تَخَـٰفُ دَرَكًا","لا تخافُ مِن فِرْعَونَ وجُنُودِهِ أن يَلْحَقَ بكُم فيُدْرِكَكُم."],[16,17,"وَلَا تَخۡشَىٰ","ولا تَخْشى مِنَ الغَرَقِ في البَحْرِ."]],"78":[[3,7,"فَغَشِيَهُم مِّنَ ٱلۡيَمِّ مَا غَشِيَهُمۡ","فَغَمَرَهُم مِن مّاءِ البَحْرِ ما لا يَعْلَمُ كُنهَه إلّا اللهُ."]],"80":[[12,12,"ٱلۡمَنَّ","شيءٌ يُشْبِهُ الصَّمْغَ، طَعْمُه كالعَسَلِ."],[13,13,"وَٱلسَّلۡوَىٰ","طَيرٌ يُشْبِهُ السُّمانى."]],"81":[[5,7,"وَلَا تَطۡغَوۡاْ فِيهِ","ولا تَحْمِلنَّكُم العافيةُ والسَّعَةُ في الرِّزقِ على تَجاوُزِ الحدِّ في العِصْيانِ."],[8,9,"فَيَحِلَّ عَلَيۡكُمۡ","فيَنْزِلَ بِكُم."],[16,16,"هَوَىٰ","هَلَكَ وخَسِرَ."]],"82":[[7,8,"ثُمَّ ٱهۡتَدَىٰ","ثُمَّ التَزَمَ الهِدايةَ واسْتَقامَ عَلَيها."]],"84":[[3,4,"عَلَىٰٓ أَثَرِي","خَلْفي سَوفَ يَلْحَقُون بِي."],[8,8,"لِتَرۡضَىٰ","لِتَزْدادَ عَنِّي رِضًا."]],"85":[[2,3,"قَدۡ فَتَنَّا","قد ابتلينا."],[7,7,"وَأَضَلَّهُمُ","دَعاهُم إلى الضَّلالَةِ التي هِيَ عِبادةُ العِجْلِ."],[8,8,"ٱلسَّامِرِيُّ","مَنسُوبٌ إلى «قبيلةِ السّامِرَة» قيل: كان إسْرائِيليًا، وقيل: كانَ قِبْطيًا."]],"86":[[5,5,"أَسِفًا","حَزِينًا كَئِيبًا."],[11,12,"وَعۡدًا حَسَنًا","أي: بإنزالِ التَّوراةِ."],[15,15,"ٱلۡعَهۡدُ","الزَّمانُ."],[24,25,"فَأَخۡلَفۡتُم مَّوۡعِدِي","خالفْتُم ما وعَدْتُّمُونِي مِن عِبادَةِ اللهِ وحْدَه."]],"87":[[4,4,"بِمَلۡكِنَا","باخْتِيارِنا."],[7,7,"أَوۡزَارًا","أثْقالًا."],[8,10,"مِّن زِينَةِ ٱلۡقَوۡمِ","مِن حُلِيِّ قومِ فِرْعَونَ."],[11,11,"فَقَذَفۡنَـٰهَا","فَأَلْقَينا الحُلِيَّ في النّارِ."],[12,14,"فَكَذَٰلِكَ أَلۡقَى ٱلسَّامِرِيُّ","أي: فَكَذَلِك ألْقى السّامِريُّ ما كان مَعَهُ مِن تُرْبَةِ حافِرِ فَرَسِ جِبْريلَ عليه السَّلامُ."]],"88":[[2,3,"عِجۡلًا جَسَدًا","مَعْبُودًا مِن ذَهَبِهِم على صُورَةِ العِجْلِ بلا رُوحٍ."],[4,5,"لَّهُۥ خُوَارٌ","له صَوْتٌ يُشْبِهُ صوتَ البَقَرِ."],[11,11,"فَنَسِيَ","فَغَفَلَ عنه مُوسى نِسْيانًا."]],"89":[[2,5,"أَلَّا يَرۡجِعُ إِلَيۡهِمۡ قَوۡلًا","لا يُكَلِّمُهم ولا يَرُدُّ عَلِيهِم جَوابًا."]],"90":[[8,9,"فُتِنتُم بِهِۦ","بِهَذا العِجْلِ."]],"91":[[1,4,"لَن نَّبۡرَحَ عَلَيۡهِ عَـٰكِفِينَ","لَن نَزالَ مُقيمِينَ على عِبادَةِ العِجْل."]],"94":[[15,17,"وَلَمۡ تَرۡقُبۡ قَوۡلِي","ولَمْ تَعْمَلْ بوَصِيَّتِي لَكَ فِيهِم."]],"95":[[1,2,"فَمَا خَطۡبُكَ","أي: ما الَّذِي حَمَلَكَ على ما صَنَعْتَ؟"]],"96":[[6,7,"فَقَبَضۡتُ قَبۡضَةً","فَأَخَذْتُ بِكَفِّي تُرابًا."],[8,10,"مِّنۡ أَثَرِ ٱلرَّسُولِ","مِن أثَرِ حافِرِ فرسِ جِبْرِيلَ عليهِ السلامُ."],[11,11,"فَنَبَذۡتُهَا","فألقيتُ حَفْنَةَ التُّرابِ على الحُليِّ التي صُنِعَ منها العِجلُ."],[13,15,"سَوَّلَتۡ لِي نَفۡسِي","زَيَّنَتْ لي نَفْسِي ما صَنَعْتُ."]],"97":[[8,9,"لَا مِسَاسَ","أي لا يَمَسَّكَ أحدٌ، ولا تَمَسَّ أحدًا في الدُّنيا، فَتَعِيشَ مَنبُوذًا."],[11,12,"لَكَ مَوۡعِدًا","أي: في الآخرةِ لِعِقابِك."],[13,14,"لَّن تُخۡلَفَهُۥ","لَن يُخْلِفَكَ اللهُ إيّاهُ."],[19,21,"ظَلۡتَ عَلَيۡهِ عَاكِفًا","أقمتَ مواظِبًا على عبادتِه."],[23,24,"ثُمَّ لَنَنسِفَنَّهُۥ","ثم لنَذْرُوَنَّه حَتّى لا يَبْقى منه أثَرٌ."],[26,26,"ٱلۡيَمِّ","البَحرِ."]],"99":[[12,12,"ذِكۡرًا","القرآنَ؛ لِما فيه مِنَ التَّذْكِيرِ."]],"100":[[7,7,"وِزۡرًا","إثمًا عَظِيمًا."]],"102":[[3,3,"ٱلصُّورِ","القَرْنِ الذي يُنفَخُ فيه للبعثِ."],[4,4,"وَنَحۡشُرُ","نَسُوقُ."],[7,7,"زُرۡقًا","زُرْقَ العُيونِ والأجْسادِ من هَوْلِ المصيبة."]],"103":[[0,1,"يَتَخَـٰفَتُونَ بَيۡنَهُمۡ","يَتَسارُّونَ فِيما بَيْنَهم."]],"104":[[6,7,"أَمۡثَلُهُمۡ طَرِيقَةً","أعْلَمُهم وأَكْمَلُهم رأيًا."]],"105":[[4,6,"يَنسِفُهَا رَبِّي نَسۡفًا","يَقْلعُها رَبي مِن أُصُولِها فَتَتَطايرُ كالصُّوفِ المنفُوشِ."]],"106":[[0,0,"فَيَذَرُهَا","فَيَتْرُكُ الأرضَ."],[1,1,"قَاعًا","أرْضًا لا نَباتٌ فيها ولا بناءٌ."],[2,2,"صَفۡصَفًا","مَلْساءَ مُسْتَوِيَةً."]],"107":[[3,3,"عِوَجًا","مَيْلًا."],[4,5,"وَلَآ أَمۡتًا","ولا ارْتفِاعًا ولا انْخِفاضًا."]],"108":[[3,4,"لَا عِوَجَ","لا مَحِيدَ لهم من اتِّباعِ داعِي اللهِ إلى المَحْشَرِ."],[12,12,"هَمۡسًا","صَوْتًا خَفِيًّا."]],"110":[[1,3,"مَا بَيۡنَ أَيۡدِيهِمۡ","أي: مِن أمْرِ القِيامةِ."],[4,5,"وَمَا خَلۡفَهُمۡ","أي: مِن أمْرِ الدُّنْيا."]],"111":[[0,0,"وَعَنَتِ","ذلَّتْ وخَضَعَتْ."],[3,3,"ٱلۡقَيُّومِ","الدّائِمِ القَيّامِ بِتَدْبِيرِ الخَلْقِ وحِفْظِهِم."],[5,5,"خَابَ","خَسِرَ وهَلَكَ."],[8,8,"ظُلۡمًا","شِرْكًا باللهِ."]],"112":[[8,10,"ظُلۡمًا وَلَا هَضۡمًا","ظُلْمًا بِزيادةِ سَيِّئاتِه في الآخِرةِ، ولا هَضْمًا بِنَقْصِ حَسَناتِه فيها."]],"113":[[10,13,"أَوۡ يُحۡدِثُ لَهُمۡ ذِكۡرًا","أي: يُحدِثُ فِيهم هذا القرآنُ تَذَكُّرًا واعْتِبارًا."]],"114":[[4,6,"وَلَا تَعۡجَلۡ بِٱلۡقُرۡءَانِ","لا تُسارِعْ بِقِراءتِه."],[7,12,"مِن قَبۡلِ أَن يُقۡضَىٰٓ إِلَيۡكَ وَحۡيُهُۥ","من قَبْلِ أن يَفرغَ جبريلُ ويُتِمَّ إليك الوحيَ."]],"115":[[1,3,"عَهِدۡنَآ إِلَىٰٓ ءَادَمَ","وصَّيناهُ، أو أوحينا إليه."],[10,10,"عَزۡمًا","قوَّةً في الإرادةِ يَحْفَظُ بها ما أُمِرَ به."]],"116":[[8,8,"أَبَىٰ","امْتَنَعَ مِنَ السُّجُودِ اسْتِكْبارًا."]],"117":[[11,11,"فَتَشۡقَىٰٓ","فتعانيَ المتاعِبَ والمشاقَّ في الدُّنيا."]],"118":[[2,4,"أَلَّا تَجُوعَ فِيهَا","أي: لا يُصِيبَكَ في الجنَّةِ جُوعٌ."],[5,6,"وَلَا تَعۡرَىٰ","أي: لا تَعْرى فيها عن الملابِسِ."]],"119":[[1,3,"لَا تَظۡمَؤُاْ فِيهَا","لا يُصِيبُكَ في الجنَّةِ عَطَشٌ."],[4,5,"وَلَا تَضۡحَىٰ","ولا يُصيبُك حرُّ شَمْسٍ."]],"120":[[8,9,"شَجَرَةِ ٱلۡخُلۡدِ","هي الشجرةُ التي مَن أكَلَ مِنها لم يَمُتْ."],[11,12,"لَّا يَبۡلَىٰ","لا يَنْقَطِعُ."]],"121":[[5,6,"وَطَفِقَا يَخۡصِفَانِ","وجَعلا يَلْصَقان."],[14,14,"فَغَوَىٰ","فَضَلَّ طَريقَ الصَّوابِ."]],"122":[[1,1,"ٱجۡتَبَـٰهُ","اصْطَفاه."]],"123":[[1,1,"ٱهۡبِطَا","انْزِلا مِنَ الجَنَّةِ إلى الأرضِ."],[14,15,"فَلَا يَضِلُّ","أي: عَن طَرِيقِ الهِدايةِ."],[16,17,"وَلَا يَشۡقَىٰ","لا يَشْقى في الآخرةِ بعِقابِ اللهِ."]],"124":[[3,3,"ذِكۡرِي","أي: عَن ذِكْرِي الَّذِي أُذَكِّرهُ بِهِ مِن قُرآنٍ وغَيْرِهِ."],[7,7,"ضَنكًا","ضَيِّقةً شاقَّةً في حَياتِه وقَبْرِه."]],"126":[[4,4,"فَنَسِيتَهَا","أي: بِتَرْكِ الإيمانِ بها."],[7,7,"تُنسَىٰ","تُتْرَكُ في النّارِ."]],"127":[[2,3,"مَنۡ أَسۡرَفَ","تَجاوَزَ حدودَ ما شَرَعَ اللهُ."],[11,11,"وَأَبۡقَىٰٓ","أدْوَمُ مِن عذابِ الدُّنيا، فلا يَنْقَطِعُ."]],"128":[[1,2,"يَهۡدِ لَهُمۡ","أي: يَدُلَّهم على طَريقِ الرَّشادِ."],[6,7,"مِّنَ ٱلۡقُرُونِ","مِنَ الأُمَمِ الماضيةِ."],[14,14,"لَـَٔايَـٰتٍ","لَعِبَرًا وعِظاتٍ."],[15,16,"لِّأُوْلِي ٱلنُّهَىٰ","لأصْحابِ العقولِ السَّلِيمةِ."]],"129":[[5,6,"لَكَانَ لِزَامًا","لَلازَمَهم الهَلاكُ عاجِلًا؛ بسببِ كُفْرِهم."]],"130":[[13,14,"ءَانَآيِٕ ٱلَّيۡلِ","ساعاتِ الليلِ."],[19,19,"تَرۡضَىٰ","أي: تُثابُ على عَمَلِك بما يُرضِيكَ."]],"131":[[0,2,"وَلَا تَمُدَّنَّ عَيۡنَيۡكَ","لا تُكَرِّرِ النَّظَرَ إلى المُشْرِكِينَ مُسْتَحْسِنًا."],[7,8,"أَزۡوَٰجًا مِّنۡهُمۡ","أصْنافًا مِن الكفّارِ."],[9,10,"زَهۡرَةَ ٱلۡحَيَوٰةِ","زينتَها وبَهْجَتَها التي لا تَدُومُ."],[12,12,"لِنَفۡتِنَهُمۡ","لِنَبْتليَهم."]],"132":[[3,4,"وَٱصۡطَبِرۡ عَلَيۡهَا","داوِمْ على إقامةِ الصَّلاةِ بِصَبْرٍ."]],"133":[[3,3,"بِـَٔايَةٍ","بِمُعْجِزَةٍ."],[8,12,"بَيِّنَةُ مَا فِي ٱلصُّحُفِ ٱلۡأُولَىٰ","أي: هذا القرآنُ مصدِّقٌ لما في الكُتُبِ السّابِقَةِ مِنَ الحقِّ."]],"134":[[4,5,"مِّن قَبۡلِهِۦ","أي: من قبْلِ أن نُرسِلَ إليهم رَسُولًا."],[16,18,"أَن نَّذِلَّ وَنَخۡزَىٰ","أن يُصيَبنا ذُلٌّ وخِزيٌ بعذابِكَ في الدُّنيا والآخِرةِ."]],"135":[[1,2,"كُلٌّ مُّتَرَبِّصٌ","كلٌّ مِنّا ومِنكُم منتظِرٌ دوائرَ الزمانِ."],[3,3,"فَتَرَبَّصُواْ","فانْتَظِرُوا."]]}