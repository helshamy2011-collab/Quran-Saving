{"1":[[2,3,"إِذَا طَلَّقۡتُمُ","إذا أرَدْتُم أن تُطَلِّقُوا."],[6,6,"لِعِدَّتِهِنَّ","مُسْتَقْبِلاتٍ لِعِدَّتِهِنَّ، أي: في طُهْرٍ لم يَقَعْ فِيه جِماعٌ، أو في حَمْلٍ ظاهِرٍ."],[7,7,"وَأَحۡصُواْ","واحْفَظُوا."],[21,21,"بِفَـٰحِشَةٍ","بِفعْلَةٍ مُنْكَرَةٍ ظاهِرَةٍ كالزِّنى."],[27,27,"يَتَعَدَّ","يَتجاوَزْه."],[37,40,"يُحۡدِثُ بَعۡدَ ذَٰلِكَ أَمۡرًا","يُوقِعُ في قَلْبِ الزَّوجِ الَمحَبَّةَ لِرَجْعَتِها بَعْدَ الطَّلْقةِ والطَّلْقَتيَنِ."]],"2":[[1,2,"بَلَغۡنَ أَجَلَهُنَّ","قارَبْنَ نِهايةَ عِدَّتِهِنَّ."],[3,3,"فَأَمۡسِكُوهُنَّ","فَراجِعُوهُنَّ."],[4,4,"بِمَعۡرُوفٍ","بحُسْنِ مُعاشَرَةٍ وإنْفاقٍ عَلَيهِنَّ."],[6,6,"فَارِقُوهُنَّ","اتْرُكُوهُنَّ حتّى تَنْقَضِيَ عِدَّتُهُنَّ."],[7,7,"بِمَعۡرُوفٍ","مَعَ إعْطائِهنَّ حُقُوقَهُنَّ مِن غَيرِ مُضارَّةٍ بِهِنَّ."],[12,14,"وَأَقِيمُواْ ٱلشَّهَـٰدَةَ لِلَّهِ","أدُّوا الشَّهادةَ خالصةً للهِ."],[29,29,"مَخۡرَجًا","مِن كُلِّ ضِيقٍ."]],"3":[[3,4,"لَا يَحۡتَسِبُ","لا يَخْطُرُ على بالِهِ ولا يَكُونُ في حِسابِهِ."],[10,10,"حَسۡبُهُۥٓ","كافِيهِ في جَمِيعِ أُمُورِهِ."],[13,14,"بَـٰلِغُ أَمۡرِهِۦ","يَقْضِي ما يُرِيدُ."],[20,20,"قَدۡرًا","أجَلًا يَنْتَهِي إلَيهِ."]],"4":[[6,7,"إِنِ ٱرۡتَبۡتُمۡ","شَكَكْتُم فَلَمْ تَدْرُوا ما عِدّتُهُنَّ؟"],[14,15,"وَأُوْلَـٰتُ ٱلۡأَحۡمَالِ","ذواتُ الحمْلِ مِنَ النِّساءِ."],[16,16,"أَجَلُهُنَّ","عِدَّتُهُنَّ."]],"5":[[8,10,"يُكَفِّرۡ عَنۡهُ سَيِّـَٔاتِهِۦ","يَمْحُ عَنْهُ ذُنُوبَهُ."],[11,13,"وَيُعۡظِمۡ لَهُۥٓ أَجۡرًا","ويُجْزِلْ لَهُ الثَّوابَ."]],"6":[[4,5,"مِّن وُجۡدِكُمۡ","على قَدْرِ سَعَتِكُم وطاقَتِكُم."],[6,7,"وَلَا تُضَآرُّوهُنَّ","ولا تُلْحِقُوا بِهِنَّ ضَرَرًا."],[12,13,"أُوْلَـٰتِ حَمۡلٍ","ذَواتِ حَمْلٍ."],[24,25,"وَأۡتَمِرُواْ بَيۡنَكُم","ولْتتَشاوَرُوا."],[26,26,"بِمَعۡرُوفٍ","ما عُرِف مِن سَماحِةٍ وطِيبِ نَفْسٍ."],[27,28,"وَإِن تَعَاسَرۡتُمۡ","وإن لَم تَتَّفِقُوا على إرضاعِ الأُمِّ."]],"7":[[1,2,"ذُو سَعَةٍ","ذُو غِنىً."],[5,7,"وَمَن قُدِرَ عَلَيۡهِ","ضُيِّقَ عَلَيهِ."],[17,19,"إِلَّا مَآ ءَاتَىٰهَا","إلّا عَلى قَدْرِ ما أعْطاها مِنَ المالِ."]],"8":[[0,0,"وَكَأَيِّن","وكَثيرٍ."],[3,3,"عَتَتۡ","عَصى أهْلُها وتَجاوَزُوا الحدَّ في مَعْصِيَةِ اللهِ."],[13,13,"نُّكۡرًا","عَظِيمًا مُنْكَرًا."]],"9":[[0,2,"فَذَاقَتۡ وَبَالَ أَمۡرِهَا","فَتَجَرَّعُوا سُوءَ عاقِبَةِ عِصْيانِهِم."],[4,5,"عَـٰقِبَةُ أَمۡرِهَا","آخِرُ أمْرِها."]],"10":[[7,8,"يَـٰٓأُوْلِي ٱلۡأَلۡبَـٰبِ","أصْحابَ العُقُولِ."],[15,15,"ذِكۡرًا","قُرآنًا."]],"11":[[5,5,"مُبَيِّنَـٰتٍ","مُوَضِّحاتٍ لَكُم الحقَّ."],[12,12,"ٱلظُّلُمَـٰتِ","ظُلُماتِ الكُفْرِ."],[14,14,"ٱلنُّورِ","نُورِ الإيمانِ."],[33,33,"رِزۡقًا","في الجنَّةِ."]],"12":[[5,6,"وَمِنَ ٱلۡأَرۡضِ","وخَلَقَ سَبْعًا مِنَ الأَرَضِينَ."],[9,9,"ٱلۡأَمۡرُ","مَّما أوْحاهُ اللهُ إلى رُسُلِهِ وما يُدَبِّرُ بِهِ خَلْقَهُ."],[10,10,"بَيۡنَهُنَّ","بَينَ السَّمواتِ والأَرْضِ."]]}