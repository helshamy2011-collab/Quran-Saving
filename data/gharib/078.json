{"1":[[0,0,"عَمَّ","عَنْ أيِّ شَيءٍ."],[1,1,"يَتَسَآءَلُونَ","يَسْأَلُ بعضُ كُفّارِ قُريشٍ بَعْضًا."]],"2":[[1,2,"ٱلنَّبَإِ ٱلۡعَظِيمِ","الخبرِ العَظِيمِ الشَّأنِ، وهو القُرآنُ العَظِيمُ الَّذي يُنْبِئُ عَنِ البَعْثِ."]],"4":[[0,0,"كَلَّا","ليسَ الأمْرُ كَما يَزْعُمُ هَؤلاءِ المشْرِكُونَ."],[1,1,"سَيَعۡلَمُونَ","أي: عاقبةَ تَكْذِيبِهِم."]],"6":[[3,3,"مِهَـٰدًا","مُمَهَّدَةً لَكُم كالفِراشِ."]],"7":[[1,1,"أَوۡتَادًا","رَواسِيَ."]],"8":[[1,1,"أَزۡوَٰجًا","أصْنافًا ذَكَرًا وأُنْثى."]],"9":[[2,2,"سُبَاتًا","راحةً لأبدانِكُم، وتَسْكُنونَ؟"]],"10":[[2,2,"لِبَاسًا","تَلْبَسُكُم ظُلْمَتُهُ، كَما يَسْتُرُ الثَّوبُ لابِسَهُ."]],"11":[[2,2,"مَعَاشًا","تَنتَشِرُونَ فِيهَ لِمصالِحِكُم."]],"12":[[2,2,"سَبۡعًا","سَبْعَ سَمَواتٍ."],[3,3,"شِدَادًا","مَتِينَةَ البِناءِ، مُحْكَمةَ الخَلْقِ والإنْشاءِ."]],"13":[[1,1,"سِرَاجًا","شَمْسًا."],[2,2,"وَهَّاجًا","وقّادًا مُضِيئًا."]],"14":[[2,2,"ٱلۡمُعۡصِرَٰتِ","السُّحُبِ المُمْطِرَةِ."],[4,4,"ثَجَّاجًا","منصَبًّا بِكَثْرِةٍ."]],"16":[[1,1,"أَلۡفَافًا","مُلْتَفَّةً بعْضُها بِبَعْضٍ."]],"17":[[1,2,"يَوۡمَ ٱلۡفَصۡلِ","بينَ الخلْقِ، وهوَ يومُ القِيامَةِ."],[4,4,"مِيقَـٰتًا","وقْتًا ومِيعادًا مُحَدَّدًا للأولِينَ والآخِرِينَ."]],"18":[[1,3,"يُنفَخُ فِي ٱلصُّورِ","يَنفُخُ المَلَكُ في «القَرْنِ» إيذانًا بالبَعْثِ."],[5,5,"أَفۡوَاجًا","أُمَمًا، كلُّ أُمَّةٍ مع إمامِهِم."]],"19":[[0,0,"وَفُتِحَتِ","شُقِّقَتْ وصُدِّعتْ."],[3,3,"أَبۡوَٰبًا","ذاتَ أبوابٍ كَثِيرةٍ."]],"20":[[0,1,"وَسُيِّرَتِ ٱلۡجِبَالُ","ونُسِفَتِ الجِبالُ."],[3,3,"سَرَابًا","يَظُنُّ مَن يَراهُ مِن بُعْدٍ ماءً، وهو في الحقِيقَةِ هَباءٌ."]],"21":[[3,3,"مِرۡصَادًا","تَرْقُبُ مَن يجتازُها."]],"22":[[0,0,"لِّلطَّـٰغِينَ","للكافِرِينَ الَّذِينَ طَغَوا."],[1,1,"مَـَٔابًا","مَرْجِعًا."]],"23":[[0,0,"لَّـٰبِثِينَ","ماكِثِينَ."],[2,2,"أَحۡقَابًا","دُهُورًا مُتَعاقِبةً لا تَنْقَطِعُ."]],"24":[[0,1,"لَّا يَذُوقُونَ","لا يُحِسُّونَ."],[3,3,"بَرۡدًا","نَسِيمًا باردًا."],[5,5,"شَرَابًا","ماءً يُرْوي."]],"25":[[1,1,"حَمِيمًا","ماءً حارًّا."],[2,2,"وَغَسَّاقًا","وصَدِيدَ أهْلِ النّارِ."]],"26":[[1,1,"وِفَاقًا","مُوافِقًا لأَعْمالِهِم."]],"27":[[2,4,"لَا يَرۡجُونَ حِسَابًا","لا يَتَوَقَّعُونَ وُقُوعَ الجَزاءِ يَومَ القِيامَةِ."]],"28":[[1,1,"بِـَٔايَـٰتِنَا","بِما جاءَتْهُم بِهِ الرُّسُلُ."]],"29":[[3,3,"كِتَـٰبًا","كَتَبْناهُ في اللَّوحِ المَحْفُوظِ."]],"31":[[2,2,"مَفَازًا","فَوْزًا بِدُخُولِهِم الجنَّةَ."]],"33":[[0,0,"وَكَوَاعِبَ","نَواهِدَ، أثْداؤُهنَّ مُرْتَفِعَةٌ لم تَتَدَلَّ."],[1,1,"أَتۡرَابًا","مُسْتَوِياتٍ في سِنٍّ واحِدةٍ."]],"34":[[1,1,"دِهَاقًا","مَمْلُوءةً خَمْرًا."]],"35":[[0,3,"لَّا يَسۡمَعُونَ فِيهَا لَغۡوًا","باطِلًا مِنَ القول."],[4,5,"وَلَا كِذَّٰبًا","ولا تَكْذِيبًا."]],"36":[[4,4,"حِسَابًا","كَثِيرًا كافيًا لَهُم."]],"37":[[6,9,"لَا يَمۡلِكُونَ مِنۡهُ خِطَابًا","لا يَسْتَطِيعُونَ خِطابًا يُبَلِّغُونَهُ إلى اللهِ."]],"38":[[2,2,"ٱلرُّوحُ","جِبْريِلُ."],[4,4,"صَفًّا","مُصْطَفِّينَ."],[13,13,"صَوَابًا","حَقًّا وسَدادًا."]],"39":[[1,2,"ٱلۡيَوۡمُ ٱلۡحَقُّ","الثابِتُ الَّذِي لا رَيْبَ في وُقُوعِهِ."],[8,8,"مَـَٔابًا","مَرْجِعًا."]],"40":[[1,1,"أَنذَرۡنَـٰكُمۡ","حَذَّرْناكُم."],[7,9,"مَا قَدَّمَتۡ يَدَاهُ","ما عَمِلَ من خِيرٍ أو شَرٍّ."],[12,14,"يَـٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","فلم أُبْعَثْ."]]}