{"1":[[0,1,"سُبۡحَـٰنَ ٱلَّذِيٓ","تنزيهًا لله عن كلِّ سوءٍ، وتعظيمًا لشأنِه على كمالِ قدرتِه."],[2,2,"أَسۡرَىٰ","الإسراءُ هو سَيْرُ الليلِ."],[3,3,"بِعَبۡدِهِۦ","محمد ﷺ بجسَدِه ورُوحِه، حالَ اليَقَظةِ."],[12,13,"بَـٰرَكۡنَا حَوۡلَهُۥ","أكْثَرْنا فيه الخيرَ بالخِصْبِ والثِّمارِ والمياهِ، وببَعْثِ كثيرٍ من الأنبياءِ منه."],[15,16,"مِنۡ ءَايَـٰتِنَآ","من عجائبِ قدرةِ اللهِ وأدِلَّةِ وحْدانيتِه."]],"2":[[2,2,"ٱلۡكِتَـٰبَ","التوراةَ."],[11,11,"وَكِيلًا","معبودًا تُفَوِّضون إليه أمورَكم."]],"3":[[0,4,"ذُرِّيَّةَ مَنۡ حَمَلۡنَا مَعَ نُوحٍ","يا سُلالةَ الذين نَجّاهم اللهُ من الغَرَقِ مع نوحٍ، لا تُشْرِكوا بالله."]],"4":[[0,3,"وَقَضَيۡنَآ إِلَىٰ بَنِيٓ إِسۡرَٰٓءِيلَ","وأَعْلَمْناهم."],[5,5,"ٱلۡكِتَـٰبِ","التوراةِ."],[7,8,"فِي ٱلۡأَرۡضِ","في بيتِ المَقْدِسِ والشامِ."],[10,10,"وَلَتَعۡلُنَّ","لتَتَجاوَزُنَّ الحَدَّ في التكبُّرِ والظُّلْمِ."]],"5":[[2,3,"وَعۡدُ أُولَىٰهُمَا","مَوْعِدُ أُولى مَرَّتَي الإفسادِ."],[4,4,"بَعَثۡنَا","سَلَّطْنا."],[8,9,"أُوْلِي بَأۡسٍ","ذوي شجاعةٍ وقُوَّةٍ في الحروب."],[11,11,"فَجَاسُواْ","طافُوا وعاثُوا."],[12,13,"خِلَـٰلَ ٱلدِّيَارِ","وسْطَها بالإفسادِ."],[16,16,"مَّفۡعُولًا","نافِذًا لابُدَّ من وقُوعِه."]],"6":[[3,4,"ٱلۡكَرَّةَ عَلَيۡهِمۡ","الغَلَبَةَ والانتصارَ على عَدُوِّكم."],[10,10,"نَفِيرًا","عددًا وعشيرةً."]],"7":[[9,10,"وَعۡدُ ٱلۡـَٔاخِرَةِ","مَوْعِدُ المرَّةِ الثانيةِ من الإفسادِ."],[11,12,"لِيَسُـُٔواْ وُجُوهَكُمۡ","ليجعَلُوا آثارَ الإهانةِ والَمذَلَّةِ باديةً فيها."],[19,19,"وَلِيُتَبِّرُواْ","يُدَمِّرُوا ويُهْلِكُوا."],[20,21,"مَا عَلَوۡاْ","ما استَوْلَوْا عليه."],[22,22,"تَتۡبِيرًا","تَدْميرًا كاملًا."]],"8":[[4,5,"وَإِنۡ عُدتُّمۡ","يا بني إسرائيلَ إلى الإفسادِ والظُّلمِ."],[6,6,"عُدۡنَا","إلى عقابِكم ومَذلَّتِكم."],[10,10,"حَصِيرًا","سِجْنًا يُحْبَسون فيه."]],"9":[[3,3,"يَهۡدِي","يُرْشِدُ الناسَ ويَدْعُوهم."],[5,6,"هِيَ أَقۡوَمُ","أحسنُ الطرقِ وأصوبُها."]],"10":[[5,5,"أَعۡتَدۡنَا","أعدَدْنا."]],"11":[[3,4,"دُعَآءَهُۥ بِٱلۡخَيۡرِ","مثلَ ما يَدْعُو بالخيرِ."]],"12":[[3,3,"ءَايَتَيۡنِ","علامتَين في الدَّلالةِ على وحْدانيَّة اللهِ وقدرتِه."],[5,6,"ءَايَةَ ٱلَّيۡلِ","علامتَه، وهي القمرُ."],[8,9,"ءَايَةَ ٱلنَّهَارِ","علامتَه، وهي الشمسُ."],[10,10,"مُبۡصِرَةً","مضيئةً ومُبْصَرًا بها."],[12,12,"فَضۡلًا","رِزْقًا؛ لأنّ النهارَ وقتٌ للتصرُّفِ في شؤونِ المعاشِ."],[18,18,"وَٱلۡحِسَابَ","حسابَ الأشهرِ والأيامِ."]],"13":[[3,3,"طَـٰٓئِرَهُۥ","ما عَمِلَه من خيرٍ أو شّرٍ."],[10,10,"كِتَـٰبًا","وهو صحيفةُ أعمالِه."],[11,11,"يَلۡقَىٰهُ","يَراه."],[12,12,"مَنشُورًا","مفتوحًا غيرَ مَطْوِيٍّ."]],"14":[[6,6,"حَسِيبًا","مُحاسِبًا."]],"15":[[10,12,"وَلَا تَزِرُ وَازِرَةٌ","ولا تحمِلُ نفسٌ آثمةٌ."],[13,14,"وِزۡرَ أُخۡرَىٰ","إثْمَ نفسٍ مُذْنبةٍ غيرِها."]],"16":[[5,5,"أَمَرۡنَا","بطاعةِ الله وتوحيدِه واتِّباعِ رُسُلِه."],[6,6,"مُتۡرَفِيهَا","مُنَعَّمِيها، وهم الرؤساءُ والكبراءُ فيها."],[7,7,"فَفَسَقُواْ","فخَرَجُوا عن أمرِ ربِّهم وعَصَوْه."],[9,9,"فَحَقَّ","وجَبَ."],[11,11,"ٱلۡقَوۡلُ","الوعيدُ والعذابُ."],[12,13,"فَدَمَّرۡنَـٰهَا تَدۡمِيرًا","أهْلَكْناها إهلاكًا مُسْتأصِلًا."]],"17":[[0,0,"وَكَمۡ","وكثيرًا."],[3,3,"ٱلۡقُرُونِ","الأُمَمِ المكذِّبةِ."]],"18":[[3,3,"ٱلۡعَاجِلَةَ","الحياةَ الدنيا."],[15,15,"يَصۡلَىٰهَا","يَدْخُلها."],[16,16,"مَذۡمُومًا","مَلُومًا."],[17,17,"مَّدۡحُورًا","مَطْرودًا من رحمةِ اللهِ."]],"19":[[11,11,"مَّشۡكُورًا","مقبولًا عندَ اللهِ، وسيُثِيبُهم عليه."]],"20":[[0,1,"كُلًّا نُّمِدُّ","نَزيدُ كُلًّا من الفريقَين من غيرِ انقطاعٍ."],[5,6,"عَطَآءِ رَبِّكَ","رزقِه."],[11,11,"مَحۡظُورًا","ممنوعًا عن أحدٍ."]],"22":[[6,6,"فَتَقۡعُدَ","فتَصيرَ."],[7,7,"مَذۡمُومًا","من اللهِ وملائكتِه وصالحي المؤمنين."]],"23":[[0,0,"وَقَضَىٰ","حَكَمَ وأَمَرَ."],[18,18,"أُفٍّ","كلمةٌ تَدُلُّ على التضجُّرِ والاستثقالِ."],[19,20,"وَلَا تَنۡهَرۡهُمَا","لا يَصْدُرْ منك إليهما قولٌ قبيحٌ."],[24,24,"كَرِيمًا","طَيِّبًا حَسَنًا مَقْرونًا بالاحترامِ والحياءِ."]],"24":[[0,3,"وَٱخۡفِضۡ لَهُمَا جَنَاحَ ٱلذُّلِّ","وكُنْ متواضِعًا مُتَذَلِّلًا لأمِّك وأبيك."],[4,5,"مِنَ ٱلرَّحۡمَةِ","لرِقَّتِك ورحمتِك بهما."]],"25":[[10,10,"لِلۡأَوَّٰبِينَ","الرَّجّاعين إلى اللهِ بالتوبةِ والإنابةِ."]],"26":[[0,0,"وَءَاتِ","وأعْطِ."],[4,4,"وَٱلۡمِسۡكِينَ","الذي لا يَمْلِكُ ما يَكْفيه ويَسُدُّ حاجتَه."],[5,6,"وَٱبۡنَ ٱلسَّبِيلِ","المسافرَ المنقطعَ عن مالِه في سَفَرِه، وإن كان غنيًا في بلدِه."],[7,8,"وَلَا تُبَذِّرۡ","لا تُنْفِقْ مالَكَ في غيرِ موضِعِه الموافِقِ للشَّرعِ."]],"27":[[3,4,"إِخۡوَٰنَ ٱلشَّيَـٰطِينِ","أشباهَهم وقُرَناءَهم في الفسادِ والمعاصي."]],"28":[[3,4,"ٱبۡتِغَآءَ رَحۡمَةٍ","طَلَبًا لرزقٍ تنتظرُه."],[11,11,"مَّيۡسُورًا","لَيِّنًا لطيفًا."]],"29":[[3,3,"مَغۡلُولَةً","مقبوضَةً عن الإنفاقِ في الخيرِ."],[6,9,"وَلَا تَبۡسُطۡهَا كُلَّ ٱلۡبَسۡطِ","لا تُسْرِفْ، ولا تتوسَّعْ في النفقةِ فوقَ طاقَتِك."],[12,12,"مَّحۡسُورًا","نادمًا على إسرافِك وضَياعِ مالِك."]],"30":[[2,3,"يَبۡسُطُ ٱلرِّزۡقَ","يُوَسِّعُه."],[6,6,"وَيَقۡدِرُ","ويُضَيِّقُه."]],"31":[[4,4,"إِمۡلَـٰقٍ","فَقْرٍ."],[11,11,"خِطۡـًٔا","إثمًا."]],"32":[[5,5,"فَـٰحِشَةً","فَعْلَةً قبيحةً ظاهرةَ القُبْحِ."],[6,7,"وَسَآءَ سَبِيلًا","بئسَ الطريقُ طريقُه."]],"33":[[11,12,"فَقَدۡ جَعَلۡنَا","بما أذِنَ فيه الشَّرْعُ، كالقِصاصِ."],[13,13,"لِوَلِيِّهِۦ","لِمَن يَلي أمرَه مِن وارثٍ أو حاكمٍ."],[14,14,"سُلۡطَـٰنًا","حُجَّةً في طَلَبِ قَتْلِ القاتلِ أو الدِّيَةِ."],[15,18,"فَلَا يُسۡرِف فِّي ٱلۡقَتۡلِ","لا يُجاوِزِ الحَدَّ المشروعَ فيه."]],"34":[[3,3,"ٱلۡيَتِيمِ","مَن مات أبوه وهو دونَ سِنِّ البُلوغِ."],[6,7,"هِيَ أَحۡسَنُ","بالطريقةِ الحُسنى."],[9,10,"يَبۡلُغَ أَشُدَّهُۥ","قوتَه على حِفْظِ مالِه، وحُسْنِ التصرُّفِ فيه."],[16,16,"مَسۡـُٔولًا","يُسأَل صاحبُ العهدِ عنه، ويحاسَبُ يومَ القيامةِ."]],"35":[[5,6,"بِٱلۡقِسۡطَاسِ ٱلۡمُسۡتَقِيمِ","بالميزانِ السَّوِيِّ."],[10,10,"تَأۡوِيلًا","مآلًا وعاقبةً عندَ اللهِ."]],"36":[[0,1,"وَلَا تَقۡفُ","لا تَتَّبِعْ."],[2,6,"مَا لَيۡسَ لَكَ بِهِۦ عِلۡمٌ","ما لا عِلْمَ لك به من قولٍ أو فِعْلٍ."],[10,10,"وَٱلۡفُؤَادَ","القلبَ."],[15,15,"مَسۡـُٔولًا","أي: صاحبُها، يُسْأَلُ عَمّا فَعَلَ بها."]],"37":[[4,4,"مَرَحًا","فَخْرًا وتكبُّرًا."],[6,8,"لَن تَخۡرِقَ ٱلۡأَرۡضَ","تَثْقُبَها بمَشْيِك عليها بهذه الصفةِ."]],"38":[[0,1,"كُلُّ ذَٰلِكَ","ما تَقَدَّم ذِكْرُه من الأوامرِ والنَّواهي."],[2,3,"كَانَ سَيِّئُهُۥ","السَّيِّئُ منه، هو الَمنْهِيّاتُ."]],"39":[[6,6,"ٱلۡحِكۡمَةِ","الأحكامِ المُحْكَمَةِ التي لا يَتَطرَّقُ إليها الفسادُ."],[17,17,"مَّدۡحُورًا","مَطْرودًا من رحمةِ اللهِ."]],"40":[[0,0,"أَفَأَصۡفَىٰكُمۡ","اختاركم وخَصَّكم."]],"41":[[1,1,"صَرَّفۡنَا","بيَّنّا، ونَوَّعْنا القولَ في أساليبَ مختلفةٍ."]],"42":[[12,12,"سَبِيلًا","طريقًا إلى المغالَبَةِ."]],"43":[[0,0,"سُبۡحَـٰنَهُۥ","تنزيهًا لله."]],"44":[[11,12,"يُسَبِّحُ بِحَمۡدِهِۦ","يُنَزِّهُ اللهَ تنزيهًا مَقْرونًا بالثناءِ والحمدِ له."],[14,15,"لَّا تَفۡقَهُونَ","لا تَفْهَمُون ولا تُدْرِكُون."],[19,19,"حَلِيمًا","لا يُعاجِلُ بالعقوبةِ مَنِ انطمَسَتْ بَصيرتُه فعَصاه."]],"45":[[10,11,"حِجَابًا مَّسۡتُورًا","مانِعًا ساتِرًا، يَمْنَعُ عقولَهم عن فَهْمِ القُرآنِ والانتفاعِ به؛ عقوبةً لهم على كُفرِهم."]],"46":[[3,3,"أَكِنَّةً","أغْطِيَةً."],[8,8,"وَقۡرًا","ثِقْلًا وصَمَمًا عن استماعِ القرآنِ وتَدَبُّرِه."],[14,14,"وَحۡدَهُۥ","داعيًا لتوحيدِه، ناهيًا عن الشِّرك بِه."],[15,17,"وَلَّوۡاْ عَلَىٰٓ أَدۡبَـٰرِهِمۡ","أدْبَرُوا راجِعين."],[18,18,"نُفُورًا","نافِرين من قولِك؛ تَكَبُّرًا عن الحقّ."]],"47":[[2,4,"بِمَا يَسۡتَمِعُونَ بِهِۦٓ","بما يستمعون القرآنَ، وقَصْدُهم السخريةُ والتكذيبُ."],[8,10,"وَإِذۡ هُمۡ نَجۡوَىٰٓ","ونَعْلَمُ ما هم مُتَسارُّون بينهم في شأنِكِ."],[18,18,"مَّسۡحُورًا","أصابَه السِّحْرُ فاختلطَ عَقْلُه."]],"48":[[0,0,"ٱنظُرۡ","تأمَّلْ وتَعَجَّبْ."],[2,4,"ضَرَبُواْ لَكَ ٱلۡأَمۡثَالَ","شَبَّهُوك فقالُوا: ساحِرٌ، وتارةً شاعرٌ، وتارةً مجنونٌ، مع عِلْمِهم بخِلافِه."],[5,5,"فَضَلُّواْ","انحرَفُوا."],[8,8,"سَبِيلًا","طريقًا إلى الحقِّ والصوابِ."]],"49":[[4,4,"وَرُفَـٰتًا","أجزاءً مُتَكَسِّرةً مُتَفتتةً."]],"51":[[3,5,"يَكۡبُرُ فِي صُدُورِكُمۡ","يَعْظُمُ ويُسْتَبْعَدُ في عقولِكم قَبولُه للحياةِ، كالسمواتِ."],[8,8,"يُعِيدُنَا","يُرْجِعُنا إلى الحياةِ بعدَ موتِنا."],[11,11,"فَطَرَكُمۡ","خَلَقَكم من غيرِ مثالٍ سابقٍ."],[14,16,"فَسَيُنۡغِضُونَ إِلَيۡكَ رُءُوسَهُمۡ","سيُحَرِّكُونها استهزاءً وتعجُّبًا."],[18,19,"مَتَىٰ هُوَ","أي: البعثُ."]],"52":[[1,1,"يَدۡعُوكُمۡ","يُناديكم خالقُكم على لسانِ المَلَكِ؛ للخروجِ من قبورِكم."],[3,3,"بِحَمۡدِهِۦ","بأمرِ اللهِ، حامدين اللهَ على كمالِ قدرتِه."]],"53":[[8,8,"يَنزَغُ","يُفْسِدُ ويُوَسْوِسُ."],[15,15,"مُّبِينًا","واضحَ العداوةِ."]],"54":[[13,13,"وَكِيلًا","مُفَوَّضًا إليك أمرُهم."]],"55":[[7,9,"فَضَّلۡنَا بَعۡضَ ٱلنَّبِيِّـۧنَ","بالفضائلِ وإنزالِ الكتبِ."],[14,14,"زَبُورًا","الكتابُ المنزَّلُ على داودَ عليه السلام، وكلُّه تحميدٌ وثناءٌ على اللهِ."]],"56":[[8,9,"كَشۡفَ ٱلضُّرِّ","إزالتَه."],[12,12,"تَحۡوِيلًا","نَقْلَه إلى غيرِكم، أوتبديلَه من حالٍ إلى أخرى."]],"57":[[1,2,"ٱلَّذِينَ يَدۡعُونَ","اتخذهم المُشْركون آلهةً، كالملائكة والأنبياء."],[3,3,"يَبۡتَغُونَ","يَطْلبون باجتهادٍ."],[6,6,"ٱلۡوَسِيلَةَ","القُرْبةَ بالطاعةِ والدرجةِ العُليا."],[7,8,"أَيُّهُمۡ أَقۡرَبُ","يَطْلُبها الذي هو أقربُ إلى اللهِ، فكيف بمَن دونَه؟"],[17,17,"مَحۡذُورًا","حقيقًا بأن يَحْذَرَه العِبادُ."]],"58":[[0,2,"وَإِن مِّن قَرۡيَةٍ","وما مِن قريةٍ كَذَّب أهلُها."],[15,16,"فِي ٱلۡكِتَـٰبِ","في اللَّوحِ المحفوظِ."],[17,17,"مَسۡطُورًا","مَكْتوبًا."]],"59":[[4,4,"بِٱلۡـَٔايَـٰتِ","بالمُعْجزاتِ التي اقترحها المشركون."],[13,13,"مُبۡصِرَةً","معجزةً واضحةً."],[14,15,"فَظَلَمُواْ بِهَا","فكفَرُوا بها فأَهْلَكَهم اللهُ."]],"60":[[5,6,"أَحَاطَ بِٱلنَّاسِ","عِلْمًا وقُدرةً، فهُم في قَبْضَتِه، ولا يَخْرجُون عن مشيئتِه."],[9,9,"ٱلرُّءۡيَا","ما عاينَه النبيُّ ﷺ ليلةَ الإسراءِ والمعراجِ من عجائبِ مخلوقاتِ اللهِ."],[13,13,"فِتۡنَةً","ابتلاءً وامتحانًا."],[15,16,"وَٱلشَّجَرَةَ ٱلۡمَلۡعُونَةَ","شجرةَ الزَّقُّومِ، جَعَلَها اللهُ ابتلاءً لبعضِ الناس الذين أنكروا خَلْقَ شجرةٍ في النارِ."],[19,19,"وَنُخَوِّفُهُمۡ","نُخَوِّفُ المشركين بأصنافِ الوعيدِ والعذابِ."],[23,23,"طُغۡيَـٰنًا","تجاوُزًا للحَدِّ في الكفرِ والضَّلالِ."]],"61":[[3,4,"ٱسۡجُدُواْ لِـَٔادَمَ","تحيةً وإكرامًا له وإظهارًا لفضلِه، لا عِبادةً."]],"62":[[1,1,"أَرَءَيۡتَكَ","أخْبِرْني."],[11,12,"لَأَحۡتَنِكَنَّ ذُرِّيَّتَهُۥٓ","لأَسْتَوْلِيَنَّ عليهم بالإغواءِ والإضلالِ."],[13,14,"إِلَّا قَلِيلًا","مَن عَصَمَه اللهُ تعالى مِن عبادِه."]],"64":[[0,0,"وَٱسۡتَفۡزِزۡ","واستَخِفَّ، أو أزْعِجْ."],[4,4,"بِصَوۡتِكَ","بدَعْوَتِك إياهم إلى المعاصي والآثام."],[5,6,"وَأَجۡلِبۡ عَلَيۡهِم","واستحِثَّهم، واجْمَعْ عليهم كلَّ ما تَقْدِرُ عليه مِن جنودِك."],[7,8,"بِخَيۡلِكَ وَرَجِلِكَ","من كلِّ راكبٍ وماشٍ في المعصيةِ والفَسادِ."],[9,11,"وَشَارِكۡهُمۡ فِي ٱلۡأَمۡوَٰلِ","بتحريضِهم على كَسْبِ الأموالِ المحرَّمةِ، وإنفاقِها فيما يُغضبُ اللهَ."],[12,12,"وَٱلۡأَوۡلَـٰدِ","وبتَزْيِينِ إنجابِهم عن طريقِ الزِّنى، أو التخلُّصِ منهم، وتجاوزِ حدودِ الشَّرعِ."],[18,18,"غُرُورًا","وعْدًا باطلًا خادعًا."]],"65":[[5,5,"سُلۡطَـٰنٌ","تَسَلُّطٌ وقوةٌ على إغوائِهم."],[8,8,"وَكِيلًا","حافِظًا لعبادِه."]],"66":[[2,2,"يُزۡجِي","يُجْري ويُسَيِّرُ برِفْقٍ."],[4,4,"ٱلۡفُلۡكَ","السُّفُنَ."],[7,7,"لِتَبۡتَغُواْ","لتَطْلُبُوا."],[8,9,"مِن فَضۡلِهِۦٓ","مِن رزقِ اللهِ."]],"67":[[2,2,"ٱلضُّرُّ","الشِّدَّةُ وخَوْفُ الغَرَقِ."],[5,5,"ضَلَّ","غابَ عن عقولِكم."],[6,9,"مَن تَدۡعُونَ إِلَّآ إِيَّاهُ","الذين تَعْبُدُونهم من الآلهةِ، وتَذَكَّرْتُم اللهَ وحدَه."]],"68":[[2,5,"يَخۡسِفَ بِكُمۡ جَانِبَ ٱلۡبَرِّ","يُغَوِّرَ بكم الأرضَ، ويُغيِّبَكم فيها."],[9,9,"حَاصِبًا","المَطَرَ الذي فيه حِجارةٌ من السماء، أو ريحًا شديدة تَرْمي بالحصى الصِّغارِ."],[14,14,"وَكِيلًا","حَفيظًا وناصِرًا من الله."]],"69":[[4,4,"فِيهِ","في البحر."],[9,9,"قَاصِفًا","شديدةً عاصفةً، تُكَسِّرُ كلَّ ما أتَتْ عليه."],[21,21,"تَبِيعًا","مُطالِبًا بما فَعَلْنا، ونصيرًا يأخذُ بالثأرِ لكم."]],"70":[[1,3,"كَرَّمۡنَا بَنِيٓ ءَادَمَ","بالرسُلِ والرِّسالات، وغيرِها من النِّعَمِ. ومَنحْناهم عقولًا يُدْرِكون بها ويُمَيِّزون."]],"71":[[0,0,"يَوۡمَ","أي: يومَ القيامةِ."],[4,4,"بِإِمَـٰمِهِمۡ","بمَنِ اقتَدَوْا به في الدُّنيا من كتابٍ، أو نبيّ، أو قائدٍ."],[7,7,"كِتَـٰبَهُۥ","كتابَ أعمالِه."],[14,14,"فَتِيلًا","مِقْدارَ الخيطِ الذي في شَقِّ النَّواة."]],"72":[[2,4,"فِي هَـٰذِهِۦٓ أَعۡمَىٰ","في الدُّنيا أعمى القَلْبِ والبَصيرةِ."]],"73":[[0,1,"وَإِن كَادُواْ","ولقد قارَبَ المشركون."],[2,2,"لَيَفۡتِنُونَكَ","لَيَصْرِفُونك ويَخْدَعُونك في ظَنِّهم."],[7,8,"لِتَفۡتَرِيَ عَلَيۡنَا","لِتَتَقَوَّلَ علينا مَّما اقترحُوه عليك."],[11,12,"لَّٱتَّخَذُوكَ خَلِيلًا","خَصُّوك بالصداقةِ الخاصَّةِ."]],"74":[[5,5,"تَرۡكَنُ","تميلُ."]],"75":[[2,5,"ضِعۡفَ ٱلۡحَيَوٰةِ وَضِعۡفَ ٱلۡمَمَاتِ","عذابًا مُضاعَفًا مِثْلَي ما يُعَذَّبُ به غيرُك في الدنيا والآخِرَةِ."]],"76":[[2,2,"لَيَسۡتَفِزُّونَكَ","لَيُزعِجُونك بعَداوتهم لِيُخْرِجُوك."],[3,4,"مِنَ ٱلۡأَرۡضِ","من مكةَ."],[7,7,"وَإِذًا","لو أخرجُوك."],[10,10,"خِلَـٰفَكَ","بَعْدَك."]],"77":[[10,10,"تَحۡوِيلًا","تَبْديلًا."]],"78":[[2,3,"لِدُلُوكِ ٱلشَّمۡسِ","وقتِ ميلِها عن وسَطِ السماءِ، وهو الزَّوالُ في الظَّهيرةِ."],[5,6,"غَسَقِ ٱلَّيۡلِ","إقبالِ ظُلْمَتِه وسَوادِه."],[7,8,"وَقُرۡءَانَ ٱلۡفَجۡرِ","وأقمْ صَلاةَ الفجرِ."],[13,13,"مَشۡهُودًا","تَحْضُرُها ملائكةُ الليلِ، وملائكةُ النهارِ."]],"79":[[2,3,"فَتَهَجَّدۡ بِهِۦ","فاقْرأ القرآنَ في صلاةِ الليلِ."],[4,5,"نَافِلَةً لَّكَ","زيادةً لك، وفضيلةً ورَفْعَ دَرَجاتٍ."],[10,11,"مَقَامًا مَّحۡمُودًا","شافِعًا للناسِ عند فَصْلِ القضاءِ بينَهم، يحْمَدُكَ فيه الأوَّلون والآخِرون."]],"80":[[3,4,"مُدۡخَلَ صِدۡقٍ","إدخالًا مَرْضِيًّا لا أرى فيه ما أكْرَهُ."],[6,7,"مُخۡرَجَ صِدۡقٍ","إخراجًا مَرْضِيًّا مما هوشَرٌّ لي."],[12,12,"سُلۡطَـٰنًا","حُجَّةً بيِّنةً ثابتةً، أو قوَّةً وعِزًّا."],[13,13,"نَّصِيرًا","ناصرًا ومُعِينًا على مَن خالفني."]],"81":[[2,2,"ٱلۡحَقُّ","الإسلامُ."],[3,4,"وَزَهَقَ ٱلۡبَـٰطِلُ","ذَهَبَ وبَطَل الشِّرْكُ."]],"82":[[12,12,"خَسَارًا","ضَلالًا وهَلاكًا؛ بسبب كُفْرِهم."]],"83":[[5,6,"وَنَـَٔا بِجَانِبِهِۦ","تباعَدَ عن شُكْرِ اللهِ وطاعَتِه؛ تَكَبُّرًا."],[9,9,"ٱلشَّرُّ","الشِّدَّةُ والضَّرَرُ."],[11,11,"يَـُٔوسًا","شديدَ اليأسِ من رحمةِ الله."]],"84":[[4,4,"شَاكِلَتِهِۦ","ما يُجانِسُ أخلاقَه التي اعتادَ عليها."]],"85":[[5,7,"مِنۡ أَمۡرِ رَبِّي","مما استأثرَ اللهُ تعالى بعِلْمِها."]],"86":[[2,5,"لَنَذۡهَبَنَّ بِٱلَّذِيٓ أَوۡحَيۡنَآ إِلَيۡكَ","لَمَحَوْنا القرآنَ من القلوبِ والمصاحِفِ، حتى لا يَبْقى له أثرٌ."],[12,12,"وَكِيلًا","مَن يَلْتزِمُ باستردادِه بعد الذَّهابِ به."]],"87":[[0,3,"إِلَّا رَحۡمَةً مِّن رَّبِّكَ","لكن رحمةً من اللهِ أبقَيْنا القرآنَ فلم نُذْهِبْه."]],"88":[[18,18,"ظَهِيرًا","مُعِينًا على تحقيقِ مُرادِهم."]],"89":[[1,1,"صَرَّفۡنَا","بَيَّنّا ونَوَّعْنا بأساليبَ مختلفةٍ."],[7,8,"كُلِّ مَثَلٍ","كلِّ معنى يَحْصُلُ الاتعاظُ به."],[13,13,"كُفُورًا","جُحودًا للحَقِّ."]],"90":[[9,9,"يَنۢبُوعًا","عَيْنًا لا يَجِفُّ ماؤُها."]],"91":[[3,3,"جَنَّةٌ","حديقةٌ."],[7,8,"فَتُفَجِّرَ ٱلۡأَنۡهَـٰرَ","تُجْرِيها بقُوَّةٍ."]],"92":[[6,6,"كِسَفًا","قِطَعًا."],[11,11,"قَبِيلًا","مقابَلَةً وعِيانًا."]],"93":[[5,5,"زُخۡرُفٍ","ذَهَبٍ."],[7,7,"تَرۡقَىٰ","تَصْعَدَ."],[19,20,"سُبۡحَانَ رَبِّي","تَنْزيهًا للهِ عن اقتراحاتهم، وتَعجُّبًا من شِدَّةِ كُفْرِهم."]],"95":[[7,7,"مُطۡمَئِنِّينَ","ساكنِين فيها."]],"97":[[19,19,"وَبُكۡمًا","لايَنْطِقُون."],[20,20,"وَصُمًّا","لا يَسْمَعُون."],[21,21,"مَّأۡوَىٰهُمۡ","مَصيرُهم."],[24,24,"خَبَتۡ","سَكَنَ لَهَبُها."],[26,26,"سَعِيرًا","تَوَقُّدًا واشتِعالًا."]],"98":[[0,0,"ذَٰلِكَ","الموصوفُ من العذابِ."],[9,9,"وَرُفَـٰتًا","أجزاءً من العذابِ."]],"99":[[15,15,"أَجَلًا","وقْتًا مُحَدَّدًا للموتِ والحسابِ."],[16,18,"لَّا رَيۡبَ فِيهِ","لا شَكَّ في وقوعِه."],[22,22,"كُفُورًا","جُحودًا للحَقِّ."]],"100":[[5,6,"رَحۡمَةِ رَبِّيٓ","رِزْقِه وسائرِ نِعَمِه."],[13,13,"قَتُورًا","بخيلًا مَنُوعًا."]],"101":[[4,5,"ءَايَـٰتِۭ بَيِّنَـٰتٍ","معجزاتٍ واضحاتِ الدَّلالةِ على نُبُوَّتِه."],[6,6,"فَسۡـَٔلۡ","سؤالَ تقريرٍ على صِدْقِك."],[17,17,"مَسۡحُورًا","أصابكَ السِّحْرُ فاختلطَ عَقْلُكَ."]],"102":[[5,5,"هَـٰٓؤُلَآءِ","المعجزاتِ التسعَ."],[10,10,"بَصَآئِرَ","دَلالاتٍ وعِبَرًا يُستَدَلُّ بها على وحدانيةِ اللهِ وقدرتِه."],[12,12,"لَأَظُنُّكَ","لمَوقِنٌ أنك."],[14,14,"مَثۡبُورًا","مُهْلَكًا، أو ممنوعًا عن الخير، مطبوعًا على الشَّرِّ."]],"103":[[2,2,"يَسۡتَفِزَّهُم","يُزْعِجَهم بعَداوتِه ليُخْرِجَهم."],[3,4,"مِّنَ ٱلۡأَرۡضِ","من أرضِ «مصرَ»."]],"104":[[6,6,"ٱلۡأَرۡضَ","أرضَ «مصرَ والشام»."],[9,10,"وَعۡدُ ٱلۡـَٔاخِرَةِ","يومُ القيِامةِ."],[13,13,"لَفِيفًا","جميعًا مختلِطِين من كلِّ نوعٍ لا تتعارفُون."]],"106":[[1,1,"فَرَقۡنَـٰهُ","أوْضَحْناه، وفَرَقْنا فيه بين الحقِّ والباطِل."],[5,6,"عَلَىٰ مُكۡثٍ","على تَمَهُّلٍ وتَأَنٍّ؛ ليَفْهموه ويَتَيَسَّرَلهم حِفْظُه."],[7,8,"وَنَزَّلۡنَـٰهُ تَنزِيلًا","على حَسَبِ الحوادث والمصالحِ والأحوالِ."]],"107":[[10,11,"مِن قَبۡلِهِۦٓ","من قَبْلِ القرآنِ."],[15,17,"يَخِرُّونَ لِلۡأَذۡقَانِ سُجَّدًا","يَسْقُطون بسرعةٍ ساجدين على وجوهِهم؛ تعظيمًا لله وشُكْرًا له."]],"108":[[1,2,"سُبۡحَـٰنَ رَبِّنَآ","تنزيهًا له على قُدرتِه التامةِ، وأنه لا يُخْلِفُ الميعادَ."],[7,7,"لَمَفۡعُولًا","مُنْجَزًا واقعًا."]],"109":[[4,4,"خُشُوعًا","سُكونًا وضَراعةً وخُضوعًا."]],"110":[[14,14,"بِصَلَاتِكَ","بقراءتِك في الصلاةِ."],[15,16,"وَلَا تُخَافِتۡ","ولا تُسِرَّ."],[18,18,"وَٱبۡتَغِ","اقْصِدْ."],[19,20,"بَيۡنَ ذَٰلِكَ","بينَ الجَهْرِ بقراءتِك والإسرارِ بها."],[21,21,"سَبِيلًا","طريقًا وسَطًا."]],"111":[[16,18,"وَلِيٌّ مِّنَ ٱلذُّلِّ","ناصرٌ ومُعِينٌ لذُلٍّ يَلْحَقُه، فهو الغَنِيُّ العزيزُ القَوِيُّ."],[19,20,"وَكَبِّرۡهُ تَكۡبِيرَۢا","عَظِّمْه تعظيمًا تامًّا مع كمالِ التنزيهِ."]]}