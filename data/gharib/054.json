{"1":[[1,1,"ٱلسَّاعَةُ","القِيامَةُ."],[2,2,"وَٱنشَقَّ","انْفَلَقَ فِلْقَتَينِ."]],"2":[[2,2,"ءَايَةً","بُرْهانًا عَلى صِدْقِ الرَّسُولِ مُحَمَّدٍ ﷺ."],[6,6,"مُّسۡتَمِرٌّ","ذاهِبٌ مُضْمَحِلٌّ لا دَوامَ لَهُ."]],"3":[[2,2,"أَهۡوَآءَهُمۡ","ما تُحِبُّهُ أنفُسُهُم مِنَ الضَّلالِ والتَّكْذِيبِ."],[4,4,"أَمۡرٍ","مِن خَيرٍ أوْ شَرٍّ."],[5,5,"مُّسۡتَقِرٌّ","واقِعٌ بأَهْلِهِ يَوْمَ القِيامَةِ."]],"4":[[6,6,"مُزۡدَجَرٌ","كِفايَةٌ لِرَدْعِهم."]],"5":[[0,0,"حِكۡمَةُۢ","هَذا القُرْآنُ فِيهِ حِكْمَةٌ عَظِيمةٌ."],[1,1,"بَـٰلِغَةٌ","بالِغَةٌ غايَتَها."],[2,2,"فَمَا","فأيُّ شَيءٍ."],[3,3,"تُغۡنِ","تَدْفَعُ أوْ تَنْفَعُ."],[4,4,"ٱلنُّذُرُ","الإنْذاراتُ."]],"6":[[0,0,"فَتَوَلَّ","فَأَعْرِضْ."],[4,4,"ٱلدَّاعِ","المَلَكُ بنَفْخِهِ في «القَرْنِ»."],[7,7,"نُّكُرٍ","فَظِيعٍ مُنْكَرٍ وهو موقِفُ الحِسابِ."]],"7":[[0,0,"خُشَّعًا","ذَلِيلَةً."],[4,4,"ٱلۡأَجۡدَاثِ","القُبُورِ."],[7,7,"مُّنتَشِرٌ","مُنْبَثٌّ عَلى وجْهِ الأرْضِ."]],"8":[[0,0,"مُّهۡطِعِينَ","مُسْرِعِينَ مادِّينَ أعْناقَهُم."],[2,2,"ٱلدَّاعِ","صوتِ المَلَكِ."],[7,7,"عَسِرٌ","شَدِيدُ الهَوْلِ."]],"9":[[8,8,"وَٱزۡدُجِرَ","وانْتَهَرُوهُ مُتَوَعِّدِينَ إيّاهُ بأنْواعِ الأَذى."]],"10":[[3,3,"مَغۡلُوبٌ","ضَعِيفٌ عَن مُقاوَمةِ هَؤُلاءِ."],[4,4,"فَٱنتَصِرۡ","لِي بِعِقابٍ مِن عِنْدِكَ."]],"11":[[4,4,"مُّنۡهَمِرٍ","كَثِيرٍ مُتَدَفِّقٍ."]],"12":[[0,0,"وَفَجَّرۡنَا","وشَقَقْنا."],[2,2,"عُيُونًا","مِن عُيُونٍ مُتَفَجِّرَةٍ بالماءِ."],[3,4,"فَٱلۡتَقَى ٱلۡمَآءُ","فالتَقى ماءُ السَّماءِ وماءُ الأرْضِ."],[5,8,"عَلَىٰٓ أَمۡرٍ قَدۡ قُدِرَ","عَلى إهْلاكِهِم الَّذِي قَدَّرَهُ اللهُ لَهُم."]],"13":[[2,3,"ذَاتِ أَلۡوَٰحٍ","سَفِيَنةٍ ذاتِ ألْواحٍ."],[4,4,"وَدُسُرٍ","ومَسامِيرَ شُدَّتْ بِها."]],"14":[[1,1,"بِأَعۡيُنِنَا","بِمَرْأىً مِنّا وحِفْظٍ."]],"15":[[0,1,"وَلَقَد تَّرَكۡنَـٰهَآ","ولَقَدْ أبْقَينا قِصَّةَ نُوحٍ."],[2,2,"ءَايَةً","عِبْرةً."],[5,5,"مُّدَّكِرٍ","مُتَّعِظٍ."]],"17":[[1,1,"يَسَّرۡنَا","سَهَّلْنا."],[3,3,"لِلذِّكۡرِ","لِلتِّلاوَةِ والحِفْظِ والفَهْمِ والتَّدَبُّرِ."]],"19":[[4,4,"صَرۡصَرًا","شَدِيدَةَ البَرْدِ والصَّوتِ."],[7,7,"نَحۡسٍ","شُؤْمٍ."],[8,8,"مُّسۡتَمِرٍّ","اسْتَمَرَّ بِهِمُ العَذابُ إلى أن وافى بِهِمْ جَهَنَّمَ."]],"20":[[0,1,"تَنزِعُ ٱلنَّاسَ","تَقَلَعُ النّاسَ مِنَ الأرْضِ، فتَصْرَعُهم عَلى رُؤوسِهِم، فَتَنْدَقُّ رِقابُهُم وتَنْفَصِلُ عَنْ أجْسامِهِم."],[3,3,"أَعۡجَازُ","أُصُولُ."],[5,5,"مُّنقَعِرٍ","مُنْقَلِعٍ."]],"23":[[2,2,"بِٱلنُّذُرِ","بالآياتِ الَّتِي أُنْذِرُوا بِها."]],"24":[[8,8,"ضَلَـٰلٍ","بُعْدٍ عَنِ الصَّوابِ."],[9,9,"وَسُعُرٍ","جُنُونٍ."]],"25":[[0,0,"أَءُلۡقِيَ","أأُنْزِلَ."],[1,1,"ٱلذِّكۡرُ","الوَحْيُ والقُرآنُ."],[8,8,"أَشِرٌ","صاحِبُ بَطَرٍ وتَكَبُّرٍ."]],"27":[[1,1,"مُرۡسِلُواْ","مُخْرِجُو."],[5,5,"فَٱرۡتَقِبۡهُمۡ","اخْتِبارًا."],[5,5,"فَٱرۡتَقِبۡهُمۡ","فانْتَظِرْ ما يَحُلُّ عَلَيهِم مِنَ العَذابِ."],[6,6,"وَٱصۡطَبِر","واصْبِرْ عَلى الأَذى الَّذِي يُصِيبُكَ مِنَ المدْعُوِّينَ."]],"28":[[0,0,"وَنَبِّئۡهُمۡ","وأَخْبِرْهُم."],[3,3,"قِسۡمَةُۢ","مَقْسُومٌ."],[4,4,"بَيۡنَهُمۡ","بَيْنَ ثَمُودَ والنّاقَةِ."],[5,6,"كُلُّ شِرۡبٍ","كُلُّ نَصِيبٍ مِن الشَّرابِ."],[7,7,"مُّحۡتَضَرٌ","يَحْضُرُهُ صاحِبُهُ ويَسْتَحِقُّهُ."]],"29":[[2,2,"فَتَعَاطَىٰ","فَتَناوَلَ النّاقَةَ بِيَدِهِ لِيَعْقِرَها."],[3,3,"فَعَقَرَ","فَقَتَلَ."]],"31":[[6,6,"كَهَشِيمِ","كالشَّجَرِ اليابِسِ الَّذِي يَسْقُطُ ويَتَناثَرُ."],[7,7,"ٱلۡمُحۡتَظِرِ","الَّذِي يُرِيدُ أن يَعْمَلَ سِياجًا لِحِفْظِ المواشِي فَيَحْتَطِبَ لِذَلِكَ."]],"34":[[3,3,"حَاصِبًا","رِيحًا شَدِيدَةً تَرْمِيهِم بِحِجارَةٍ."],[8,8,"بِسَحَرٍ","في آخِرِ الليلِ."]],"35":[[4,4,"نَجۡزِي","نُثِيبُ."],[5,6,"مَن شَكَرَ","مَن آمَنَ بِاللهِ ووَحّدَهُ."]],"36":[[0,1,"وَلَقَدۡ أَنذَرَهُم","خَوَّفَهُم."],[2,2,"بَطۡشَتَنَا","بَأْسَنا وعَذابَنا."],[3,3,"فَتَمَارَوۡاْ","فَشَكُّوا."],[4,4,"بِٱلنُّذُرِ","بالإنْذارِ."]],"38":[[1,2,"صَبَّحَهُم بُكۡرَةً","جاءَهُم وقْتَ الصَّباحِ."],[4,4,"مُّسۡتَقِرٌّ","نازلٌ بِهم."]],"41":[[2,3,"ءَالَ فِرۡعَوۡنَ","أتْباعَ فِرْعَونَ."],[4,4,"ٱلنُّذُرُ","الإنْذارُ تِلْو الإنْذارِ مِن مُوسى عَلَيهِ السَّلامُ بالعُقُوبةِ عَلى كُفْرِهِم."]],"42":[[1,1,"بِـَٔايَـٰتِنَا","بِأَدلَّتِنا الدّالّةِ عَلى وحْدانِيَّتِنا ونُبُوَّةِ أنْبِيائِنا."],[3,3,"فَأَخَذۡنَـٰهُمۡ","فَعاقَبْناهُم."],[5,5,"عَزِيزٍ","لا يُغالَبُ."],[6,6,"مُّقۡتَدِرٍ","قادِرٍ عَلى هَلاكِكُم."]],"43":[[0,0,"أَكُفَّارُكُمۡ","يا مَعْشَرَ العَرَبِ."],[6,6,"بَرَآءَةٌ","مِنَ العذابِ ألّا يُصِيبَكُم ما أصابَهُم."],[8,8,"ٱلزُّبُرِ","الكُتُبِ المنَزَّلةِ عَلى الأنبياءِ المُتقَدِّمِينَ."]],"44":[[3,3,"جَمِيعٌ","نَحْنَ يَدٌ واحِدَةٌ عَلى مَن خالَفَنا."],[4,4,"مُّنتَصِرٌ","نَغْلِبُ غَيرَنا."]],"45":[[1,1,"ٱلۡجَمۡعُ","جَمْعُ كُفّارِ مَكَّةَ أمامَ المُؤمِنِينَ."]],"46":[[4,4,"أَدۡهَىٰ","أفْظَعُ وأَعْظَمُ."],[5,5,"وَأَمَرُّ","أشدُّ مَرارَةً مِنَ القَتْلِ والأَسْرِ."]],"47":[[3,3,"ضَلَـٰلٍ","تِيهٍ عَنِ الحقِّ."],[4,4,"وَسُعُرٍ","جُنُونٍ أو نارٍ تَسْتَعِرُ عَلَيهِم."]],"48":[[1,1,"يُسۡحَبُونَ","يُجَرُّونَ."],[7,8,"مَسَّ سَقَرَ","شِدَّةَ عَذابِ جَهَنَّمَ."]],"49":[[4,4,"بِقَدَرٍ","بمِقَدارٍ قَدَّرْناهُ، وسَبَق عِلْمُنا بِهِ، وكِتابَتُنا لَهُ في اللَّوحِ المَحْفُوظِ."]],"50":[[3,3,"وَٰحِدَةٌ","قَوْلَةٌ واحِدَةٌ، وهي «كُنْ»."],[4,5,"كَلَمۡحِۭ بِٱلۡبَصَرِ","فَيُوجَدُ في أقْصَرِ وقْتٍ."]],"51":[[2,2,"أَشۡيَاعَكُمۡ","أشْباهَكُم في الكُفْرِ مِنَ الأُمَمِ السّابِقَةِ."],[5,5,"مُّدَّكِرٍ","مُتَّعِظٍ."]],"52":[[4,4,"ٱلزُّبُرِ","الكُتَبِ الَّتِي كَتَبَتْها الحَفَظَةُ."]],"53":[[3,3,"مُّسۡتَطَرٌ","مُسَطَّرٌ في صَحائِفِهم."]],"55":[[1,2,"مَقۡعَدِ صِدۡقٍ","مَجْلِسِ حَقٍّ."],[4,4,"مَلِيكٍ","اللهِ الملِكِ العَظِيمِ."],[5,5,"مُّقۡتَدِرِۭ","عَظِيمِ القُدْرَةِ."]]}