{"4":[[3,3,"يُؤۡتُونَ","يُعْطُونَ."],[8,8,"يُوقِنُونَ","يُؤْمِنُونَ."]],"5":[[7,7,"ٱلۡمُفۡلِحُونَ","الفائِزُونَ."]],"6":[[4,5,"لَهۡوَ ٱلۡحَدِيثِ","هُوَ كلُّ ما يُلْهِي عَن طاعةِ اللهِ."],[10,11,"بِغَيۡرِ عِلۡمٍ","جَهْلًا بِعاقِبَةِ ذَلِكَ."],[12,12,"وَيَتَّخِذَهَا","ويَتَّخِذَ سَبيلَ اللهِ وآياتِ كِتابِه."],[13,13,"هُزُوًا","مُسْتهْزَأً بهِا."]],"7":[[4,4,"وَلَّىٰ","أعْرَضَ وأَدْبَرَ."],[5,5,"مُسۡتَكۡبِرًا","مُتَكبِّرًا."],[12,12,"وَقۡرًا","ثِقَلًا أو صَمَمًا فلا يَنْتَفِعُ بِما يَسْمَعُ."]],"9":[[4,4,"حَقًّا","أي: وعْدًا حَقًّا ثابِتًا."]],"10":[[3,3,"عَمَدٍ","دَعائِمَ، مُفْرَدُه عِمادٌ."],[8,8,"رَوَٰسِيَ","أي: جِبالًا ثَوابِتَ."],[9,11,"أَن تَمِيدَ بِكُمۡ","أي: لِئلا تَتَحَرَّكَ الأرْضُ وتَضْطَرِبَ بِكم."],[12,12,"بَثَّ","نَشَر وفَرَّقَ."],[25,26,"زَوۡجٍ كَرِيمٍ","صِنْفٍ حَسَنٍ كَثِيرِ المَنفَعَةِ."]],"11":[[12,13,"ضَلَـٰلٍ مُّبِينٍ","عُدُولٍ واضِحٍ عَنِ الطَّرِيقِ المُسْتَقِيمِ."]],"12":[[2,2,"لُقۡمَـٰنَ","هو رَجُلٌ صالِحٌ كانَ مِن حُكَماءِ بني إسرْائِيلَ."],[3,3,"ٱلۡحِكۡمَةَ","العقلَ والفهمَ وإصابةَ القولِ."],[13,13,"كَفَرَ","أي: جَحَدَ نِعَمَ اللهِ بِعَدَمِ شُكْرِها."]],"14":[[5,5,"وَهۡنًا","ضَعْفًا."],[8,8,"وَفِصَـٰلُهُۥ","فِطامُه عَنِ الرَّضاعَةِ."],[16,16,"ٱلۡمَصِيرُ","المَرْجِعُ."]],"15":[[1,1,"جَـٰهَدَاكَ","بَذَلا الجُهْدَ وحاوَلا أن يُجْبِراكَ."],[13,13,"وَصَاحِبۡهُمَا","عاشِرْهُما."],[20,21,"أَنَابَ إِلَيَّ","رَجَع إليّ بالإخْلاصِ والتَّوبة."],[24,24,"مَرۡجِعُكُمۡ","مَصِيرُكُم."],[25,25,"فَأُنَبِّئُكُم","فَأُخْبِرُكُم."]],"16":[[1,1,"إِنَّهَآ","أي: السَّيِّئةَ أو الحَسَنَةَ."],[4,5,"مِثۡقَالَ حَبَّةٍ","وزْنَ حَبَّةٍ."],[7,7,"خَرۡدَلٍ","وهْوَ أصْغَرُ الحُبُوبِ، والمرادُ أصغرُ شيءٍ."],[9,10,"فِي صَخۡرَةٍ","في باطِنِ جَبَلٍ."]],"17":[[4,4,"بِٱلۡمَعۡرُوفِ","المعْرُوفُ كُلُّ فِعْلٍ يُعْرَفُ حُسْنُه بالشَّرْعِ أو العَقْلِ."],[7,7,"ٱلۡمُنكَرِ","وهْوَ كُلُّ فِعْلٍ يُنكِرُه الشَّرعُ أوِ العَقْلُ."],[14,16,"مِنۡ عَزۡمِ ٱلۡأُمُورِ","أي: مِنَ الأمُورِ الَّتي يَنْبَغِي العَزْمُ والحِرْصُ عليها."]],"18":[[0,2,"وَلَا تُصَعِّرۡ خَدَّكَ","أي: لا تُمِلْه عُجْبًا واسْتِكْبارًا."],[8,8,"مَرَحًا","فَرَحًا وبَطَرًا."],[14,14,"مُخۡتَالٍ","مُتَكَبِّرٍ."],[15,15,"فَخُورٍ","مُتَباهٍ بنفسه."]],"19":[[0,2,"وَٱقۡصِدۡ فِي مَشۡيِكَ","أي: تَوَسَّطْ فِيه مَعَ تَواضُعٍ وسَكِينَةٍ."],[3,3,"وَٱغۡضُضۡ","واخْفِضْ."],[7,8,"أَنكَرَ ٱلۡأَصۡوَٰتِ","أي: أقبَحَها."]],"20":[[4,5,"سَخَّرَ لَكُم","ذَلَّلَ لَكُم."],[12,12,"وَأَسۡبَغَ","عَمَّ وأَتَمَّ."],[20,20,"يُجَـٰدِلُ","يُخاصِمُ."],[21,22,"فِي ٱللَّهِ","أي: في تَوحِيدِه وإخْلاصِ العِبادَةِ لَهُ."]],"21":[[19,20,"عَذَابِ ٱلسَّعِيرِ","عَذابِ جَهَنَّمَ المُسْتَعِرَةِ."]],"22":[[1,4,"يُسۡلِمۡ وَجۡهَهُۥٓ إِلَى ٱللَّهِ","يُفوِّضْ إلِيهِ أمْرَهُ ويُخلِصْ لَهُ عِبادَتَه."],[6,6,"مُحۡسِنٌ","مُطِيعٌ للهِ في أمْرِهِ ونَهْيِهِ."],[8,8,"ٱسۡتَمۡسَكَ","تمسَّكَ واعْتَصَمَ."],[9,10,"بِٱلۡعُرۡوَةِ ٱلۡوُثۡقَىٰ","العَهْدِ الأوْثَقِ والسَّبَبِ الأقْوى."],[13,14,"عَـٰقِبَةُ ٱلۡأُمُورِ","مَرْجِعُها."]],"23":[[7,7,"فَنُنَبِّئُهُم","فَنُخْبِرُهُم."]],"24":[[3,3,"نَضۡطَرُّهُمۡ","نُلْجِئُهُم ونَسُوقُهُم."],[5,6,"عَذَابٍ غَلِيظٍ","أي: فَظِيعٍ وثَقِيلٍ، وهُوَ عَذابُ جَهَنَّمَ."]],"27":[[8,8,"يَمُدُّهُۥ","أي: يَزِيدُه، فَيَصِيرُ ما في البِحارِ كلِّها مِدادًا."],[13,14,"مَّا نَفِدَتۡ","ما فَنِيَتْ."]],"28":[[5,6,"كَنَفۡسٍ وَٰحِدَةٍ","أي: كَخَلْقِ نَفْسٍ واحِدَةٍ وبَعْثِها."]],"29":[[4,4,"يُولِجُ","يُدخِلُ."],[12,12,"سَخَّرَ","ذلَّلَ."],[19,19,"مُّسَمًّى","مَعْلُومٍ مُحدَّدٍ."]],"31":[[3,3,"ٱلۡفُلۡكَ","السُّفُنَ."],[9,9,"لِيُرِيَكُم","ليُظْهِرَ لَكُم."],[10,11,"مِّنۡ ءَايَـٰتِهِۦٓ","أي: مِن آياتِه الدّالَّةِ عَلى قُدْرَتِه."],[15,15,"لَـَٔايَـٰتٍ","لدَلالاتٍ."],[17,18,"صَبَّارٍ شَكُورٍ","أي: صَبّارٍ عَلى الضَّرّاءِ، وشَكُورٍ عَلى السَّرّاءِ."]],"32":[[1,1,"غَشِيَهُم","عَلاهُم وغَطّاهُم."],[3,3,"كَٱلظُّلَلِ","أي: كَشَيءٍ يكُونُ ظِلًّا مِثْلِ الِجبالِ والسَّحابِ."],[14,14,"مُّقۡتَصِدٌ","مُتَوَسِّطٌ في عَمَلِهِ وعِبادَتِه."],[16,16,"يَجۡحَدُ","يُنكِرُ."],[17,17,"بِـَٔايَـٰتِنَآ","بحُجَجِنا."],[20,20,"خَتَّارٍ","غَدّارٍ ناقِضٍ لِلْعهَدِ."],[21,21,"كَفُورٍ","جَحُودٍ للنِّعَمِ لا يَشْكُرُها."]],"33":[[4,5,"وَٱخۡشَوۡاْ يَوۡمًا","أي: خافُوه واسْتَعِدُّوا لَهُ."],[6,7,"لَّا يَجۡزِي","لا يُغْنِي."],[22,23,"فَلَا تَغُرَّنَّكُمُ","فلا تَخْدَعَنَّكُم."],[29,29,"ٱلۡغَرُورُ","ما يَغُرُّ ويَخْدَعُ مِن شَيطانٍ وغَيرِهِ."]],"34":[[6,6,"ٱلۡغَيۡثَ","المَطَرَ."],[12,12,"تَدۡرِي","تَعْلَمُ."]]}