{"1":[[0,0,"الٓمٓ","سَبَقَ الكَلامُ عَلى مِثْلهِ في أوَّلِ سُورةِ البقرةِ."]],"2":[[2,4,"لَا رَيۡبَ فِيهِ","لاشَكَّ فِيه."]],"3":[[0,1,"أَمۡ يَقُولُونَ","بل أيقُولُ المشرِكُونَ."],[2,2,"ٱفۡتَرَىٰهُ","اختَلَقَ محمدٌ ﷺ القرآنَ مِن تِلْقاءِ نَفْسِهِ."],[13,13,"نَّذِيرٍ","أي: رَسُولٍ مُنْذِرٍ."]],"4":[[11,13,"ٱسۡتَوَىٰ عَلَى ٱلۡعَرۡشِ","عَلا وارْتَفَعَ سُبْحانَه وتَعالى عَلى عَرْشِهِ كَما يَليقُ بِجَلالِهِ."],[13,13,"ٱلۡعَرۡشِ","هُوَ سَريرُ المُلْكِ الَّذي اسْتَوى عَلَيهِ الرَّحْمَنُ، وتَحْمِلُهُ الملائِكَةُ، وهْوَ أعْظَمُ المْخلُوقاتِ، وهو سَقْفُ الجنَّةِ."],[19,19,"وَلِيٍّ","ناصِرٍ يَنْصُرُكُم."],[23,23,"تَتَذَكَّرُونَ","تَتَّعِظُونَ."]],"5":[[0,1,"يُدَبِّرُ ٱلۡأَمۡرَ","يَقْضِي القَضاءَ."],[7,7,"يَعۡرُجُ","يَصْعَدُ."]],"7":[[1,3,"أَحۡسَنَ كُلَّ شَيۡءٍ","أحْكَمَهُ وأَتْقَنَهُ."],[9,9,"طِينٍ","تُرابٍ."]],"8":[[2,2,"نَسۡلَهُۥ","ذُرِّيَّتَه."],[4,4,"سُلَـٰلَةٍ","نُطْفَةٍ مَسْلُولَةٍ."],[7,7,"مَّهِينٍ","ذَلِيلٍ."]],"9":[[1,1,"سَوَّىٰهُ","أتمَّ خَلْقَهُ."],[10,10,"وَٱلۡأَفۡـِٔدَةَ","القُلُوبَ."]],"10":[[2,4,"ضَلَلۡنَا فِي ٱلۡأَرۡضِ","ضِعْنا فِيها وصِرْنا تُرابًا."],[13,13,"كَـٰفِرُونَ","مُنْكِرُونَ."]],"11":[[1,1,"يَتَوَفَّىٰكُم","يَقبِضُ أرْواحَكُم."],[5,6,"وُكِّلَ بِكُمۡ","وُكِّلَ بِقَبْضِ أرْواحِكِم."]],"12":[[4,5,"نَاكِسُواْ رُءُوسِهِمۡ","أي: مُطْرِقُوها خِزْيًا ونَدامَةً."],[15,15,"مُوقِنُونَ","مُصَدِّقُونَ."]],"13":[[5,5,"هُدَىٰهَا","رُشْدَها، وتَوفِيقَها لِلْإيمانِ."],[7,7,"حَقَّ","وجَبَ وثَبَتَ."]],"14":[[10,10,"ٱلۡخُلۡدِ","الدّائِمِ."]],"15":[[1,1,"يُؤۡمِنُ","يُصَدِّقُ."],[5,6,"ذُكِّرُواْ بِهَا","وُعِظِوُا بِها."],[7,7,"خَرُّواْ","سَقَطوُا."]],"16":[[0,0,"تَتَجَافَىٰ","تَرْتَفِعُ وتَتَنَحّى."],[2,3,"عَنِ ٱلۡمَضَاجِعِ","عَنِ الفُرُشِ الَّتِي يُضْطَجَعُ عَلَيها."]],"17":[[6,8,"مِّن قُرَّةِ أَعۡيُنٍ","مِن موجِباتِ المسَرَّةِ والفَرَحِ."]],"19":[[8,8,"نُزُلَۢا","ما يُهيَّأُ للنَّزيلِ ضِيافَةً وإكْرامًا."]],"20":[[3,3,"فَمَأۡوَىٰهُمُ","المكانُ الَّذي يَأْوُونَ إليه."]],"21":[[2,3,"ٱلۡعَذَابِ ٱلۡأَدۡنَىٰ","وهو ما يُصِيبُهُم في الدُّنيا مِنَ البَلاءِ والِمحَنَ."],[5,6,"ٱلۡعَذَابِ ٱلۡأَكۡبَرِ","وهو ما يُصِيبُهُم يومَ القِيامةِ مِن عَذابِ جَهَنَّمَ."]],"22":[[3,3,"ذُكِّرَ","وُعِظَ."]],"23":[[6,7,"فِي مِرۡيَةٍ","في شَكٍّ."],[8,9,"مِّن لِّقَآئِهِۦ","أي: مِن لِقاءِ مُوسى عَلَيهِ الصَّلاةُ والسَّلامُ."]],"25":[[3,3,"يَفۡصِلُ","يَقْضِي."]],"26":[[7,8,"مِّنَ ٱلۡقُرُونِ","مِنَ الأُمَمِ السّابقِةِ."],[15,15,"لَـَٔايَـٰتٍ","لَعِبَرًا وعِظاتٍ."]],"27":[[7,7,"ٱلۡجُرُزِ","الأرْضِ اليابِسةِ الغَلِيظَةِ الجرْداءِ الَّتي لا نَباتَ فِيها."]],"28":[[2,3,"هَـٰذَا ٱلۡفَتۡحُ","هذا القضاءُ بين العِبادِ."]],"29":[[10,10,"يُنظَرُونَ","يُمْهَلُونَ لِيؤْمِنُوا."]],"30":[[2,2,"وَٱنتَظِرۡ","أي: انْتَظِرْ ما اللهُ صانِعٌ بِهِم."]]}