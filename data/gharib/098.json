{"1":[[8,8,"مُنفَكِّينَ","تاركِينَ كُفْرَهُم."],[11,11,"ٱلۡبَيِّنَةُ","العَلامةُ الَّتِي وُعِدُوا بِها في الكُتُبِ السّابِقَةِ."]],"2":[[4,4,"صُحُفًا","قُرآنًا في صُحُفٍ."]],"3":[[1,2,"كُتُبٌ قَيِّمَةٌ","أخْبارٌ صادِقَةٌ، تهدِي إلى الحقِّ."]],"4":[[9,10,"جَآءَتۡهُمُ ٱلۡبَيِّنَةُ","تَبيَّنُوا أنُّه النَّبِيُّ الَّذِي وُعِدُوا بِهِ."]],"5":[[5,7,"مُخۡلِصِينَ لَهُ ٱلدِّينَ","قاصِدِينَ بِعِبادَتِهِم وجْهَهُ."],[8,8,"حُنَفَآءَ","مائِلِينَ عَنِ الشِّركِ إلى الإيمانِ."],[14,15,"دِينُ ٱلۡقَيِّمَةِ","دِينُ الاسْتِقامةِ، وهو الإسلامُ."]],"6":[[14,14,"شَرُّ","أشَدُّ شَرًّا."]],"7":[[8,8,"ٱلۡبَرِيَّةِ","الخَلْقِ."]],"8":[[3,4,"جَنَّـٰتُ عَدۡنٍ","جَنّاتُ إقامَةٍ واسْتِقرارٍ في مُنْتَهى الحُسْنِ."],[6,7,"مِن تَحۡتِهَا","مِن تَحْتِ قُصُورِها وأشجارِها."],[19,20,"خَشِيَ رَبَّهُۥ","خافَ اللهَ واجْتَنَبَ مَعاصيَهُ."]]}