{"1":[[4,4,"ٱلۡحَكِيمِ","المُحْكَمِ في لَفْظِه ومعناه."]],"2":[[16,17,"قَدَمَ صِدۡقٍ","أجرًا حسنًا؛ بما قَدَّموا من صالحِ الأعمالِ."]],"3":[[11,11,"ٱسۡتَوَىٰ","علا وارتفعَ، استواءً يَليق بجَلالِه وعَظَمَتِه."],[14,15,"يُدَبِّرُ ٱلۡأَمۡرَ","يَقْضِي أمورَ الدنيا والآخرةِ، ويُصَرِّفُها وحدَه على أكملِ الوجوهِ."],[19,22,"إِلَّا مِنۢ بَعۡدِ إِذۡنِهِۦ","إلا أنْ يأذنَ اللهُ له بالشفاعةِ."]],"4":[[1,1,"مَرۡجِعُكُمۡ","مَعادُكم يومَ القيامةِ."],[16,16,"بِٱلۡقِسۡطِ","بالعَدْلِ."],[22,22,"حَمِيمٍ","ماءٍ شديدِ الحرارةِ."]],"5":[[4,4,"ضِيَآءً","ذاتَ ضياءٍ في النهار."],[6,6,"نُورًا","ذاتَ نورٍ في الليل."],[7,8,"وَقَدَّرَهُۥ مَنَازِلَ","وهَيَّأ للقَمَرِ منازلَ لا يتَعدّاها."],[12,12,"وَٱلۡحِسَابَ","ولتعلمُوا حسابَ الأشهرِ والأيامِ."],[16,16,"ذَٰلِكَ","أي: الَخلْقُ والتقديرُ."],[17,18,"إِلَّا بِٱلۡحَقِّ","إلا لحكمةٍ عظيمةٍ بالغةٍ."],[19,19,"يُفَصِّلُ","يُبَيِّنُ."],[20,20,"ٱلۡـَٔايَـٰتِ","الحُجَجَ والأدَّلةَ الدالَّةَ على عَظَمَتِه."]],"6":[[2,4,"ٱخۡتِلَـٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ","إتيانِ أحدِهما بعد الآخَرِ."]],"7":[[2,4,"لَا يَرۡجُونَ لِقَآءَنَا","لا يتوقَّعُون حسابَ الآخرةِ."],[8,9,"وَٱطۡمَأَنُّواْ بِهَا","رَكَنُوا إليها."],[13,13,"ءَايَـٰتِنَا","الكونيةِ والشرعيةِ."],[14,14,"غَـٰفِلُونَ","ساهُون ومُعْرِضُون."]],"9":[[5,5,"يَهۡدِيهِمۡ","يُرْشِدُهم، ويُوَفِّقُهم إلى العملِ المُوصِلِ إلى الجنة."],[9,10,"مِن تَحۡتِهِمُ","مِن تحتِ غُرَفِهم ومنازلهِم."]],"10":[[0,3,"دَعۡوَىٰهُمۡ فِيهَا سُبۡحَـٰنَكَ ٱللَّهُمَّ","دعاؤُهم الذي يَدْعُون به في الجنةِ التسبيحُ والتنزيهُ لله."],[4,4,"وَتَحِيَّتُهُمۡ","من اللهِ وملائكتِه لهم، وتحيةُ بعضِهم بعضًا."],[6,6,"سَلَـٰمٌ","دعاءٌ لهم بالسَّلامةِ من كلِّ مكروهٍ."]],"11":[[4,4,"ٱلشَّرَّ","إجابةَ دعائِهم في الشرِّ."],[5,6,"ٱسۡتِعۡجَالَهُم بِٱلۡخَيۡرِ","تعجيلَ اللهِ لهم بالخيرِ."],[7,9,"لَقُضِيَ إِلَيۡهِمۡ أَجَلُهُمۡ","لأُهْلِكُوا جميعًا."],[10,10,"فَنَذَرُ","نَتْرُكُ."],[16,16,"طُغۡيَـٰنِهِمۡ","تجاوُزِهم الَحدَّ في إنكارِ البعثِ."],[17,17,"يَعۡمَهُونَ","يتردَّدُون متحَيِّرين."]],"12":[[1,1,"مَسَّ","أصاب."],[3,3,"ٱلضُّرُّ","الشِّدَّةُ والمكروهُ."],[5,5,"لِجَنۢبِهِۦٓ","مُضْطجعًا على جَنْبِه."],[14,17,"مَرَّ كَأَن لَّمۡ يَدۡعُنَآ","استمرَّ على ما كان عليه قبل أن يُبْتلى."],[23,23,"لِلۡمُسۡرِفِينَ","المتجاوِزِين الَحدَّ في الكفرِ والمعاصي."]],"13":[[2,2,"ٱلۡقُرُونَ","جَمْعُ قَرْن، وهم: القومُ المقتَرِنون في زمانٍ واحدٍ."],[6,6,"ظَلَمُواْ","أشرَكُوا وكَذَّبُوا."],[9,9,"بِٱلۡبَيِّنَـٰتِ","الدَّلالاتِ الواضحاتِ الدالَّةِ على صدقِهم."]],"14":[[2,2,"خَلَـٰٓئِفَ","جَمْعُ خليفة، وهو مَن يَخْلُفُ غيرَه."]],"15":[[4,4,"بَيِّنَـٰتٍ","واضحاتٍ."],[7,9,"لَا يَرۡجُونَ لِقَآءَنَا","لا يتَوقَّعُون حسابَ الآخرةِ."],[14,15,"أَوۡ بَدِّلۡهُ","أو غَيِّرْ فيه بما ليس منه."]],"16":[[7,9,"وَلَآ أَدۡرَىٰكُم بِهِۦ","ولا أعْلَمَكم به على لساني."],[13,13,"عُمُرًا","زَمَنًا طويلًا، وهو أربعون سنةً."]],"17":[[3,3,"ٱفۡتَرَىٰ","اختَلَق."]],"18":[[11,11,"شُفَعَـٰٓؤُنَا","يَشْفَعُون لنا."],[17,19,"بِمَا لَا يَعۡلَمُ","وهو أنّ له شفيعًا عندَه بغيرِ إذنِه."],[25,25,"سُبۡحَـٰنَهُۥ","تنزيهًا له."]],"19":[[4,5,"أُمَّةً وَٰحِدَةً","على دينٍ واحدٍ، وهو الإسلامُ."],[7,11,"وَلَوۡلَا كَلِمَةٌ سَبَقَتۡ مِن رَّبِّكَ","وهي تأخيرُه القضاءَ بينَهم إلى يومِ القيامةِ."],[12,13,"لَقُضِيَ بَيۡنَهُمۡ","عاجلًا في الدُّنيا."]],"20":[[1,1,"لَوۡلَآ","هَلّا."],[4,4,"ءَايَةٌ","علامةٌ حِسِّيةٌ مما اقترحُوه، كجَعْلِ الجبالِ ذَهَبًا."],[8,10,"إِنَّمَا ٱلۡغَيۡبُ لِلَّهِ","نُزولُ الآيةِ غَيْبٌ، واللهُ هو المختصُّ به."]],"21":[[2,2,"ٱلنَّاسَ","المشركين."],[3,3,"رَحۡمَةً","يُسْرًا ورَخاءً."],[6,6,"ضَرَّآءَ","شِدَّةً وبَلاءً."],[10,12,"مَّكۡرٌ فِيٓ ءَايَاتِنَا","بالتكذيبِ والاستهزاءِ بها."],[15,16,"أَسۡرَعُ مَكۡرًا","أسرعُ استدراجًا وعقوبةً لكم."],[18,18,"رُسُلَنَا","الكَتَبةَ من الملائكةِ."]],"22":[[10,10,"ٱلۡفُلۡكِ","السُّفُنِ."],[14,14,"طَيِّبَةٍ","سَهْلَةِ الهُبوبِ، موافِقَةٍ للغَرَضِ والمنفعةِ."],[19,19,"عَاصِفٌ","شديدةُ الهبوبِ."],[25,25,"وَظَنُّوٓاْ","أيقَنُوا."],[27,28,"أُحِيطَ بِهِمۡ","وقَعَ عليهم الهلاكُ."],[33,33,"ٱلدِّينَ","الدُّعاءَ."]],"23":[[4,6,"يَبۡغُونَ فِي ٱلۡأَرۡضِ","يُفْسِدُون فيها متجاوِزينَ الحَدَّ في المعاصي."],[12,14,"بَغۡيُكُمۡ عَلَىٰٓ أَنفُسِكُم","مَصِيرُ فسادِكم عائدٌ عليكم."],[15,17,"مَّتَـٰعَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","تتمتعون به مَتاعًا زائلًا."]],"24":[[1,3,"مَثَلُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","حالُها في سُرْعَةِ انقضائِها وذَهابِ لَذّاتِها."],[8,11,"فَٱخۡتَلَطَ بِهِۦ نَبَاتُ ٱلۡأَرۡضِ","فَنَبتَ بماءِ المطر أنواعٌ من النباتِ، تشابَكَتْ واختلَطَ بعضُها ببعض."],[18,20,"أَخَذَتِ ٱلۡأَرۡضُ زُخۡرُفَهَا","ظَهَرَ حُسْنُها واستكمَلَت بهاءَها."],[21,21,"وَٱزَّيَّنَتۡ","وتَزَيَّنَتْ بأصنافِ النباتِ وأشكالِه وألوانِه."],[22,22,"وَظَنَّ","أيقنَ."],[25,26,"قَـٰدِرُونَ عَلَيۡهَآ","مُتَمَكِّنون مِن جَنْي ثمارِها والانتفاعِ بها."],[28,28,"أَمۡرُنَا","قضاؤُنا بهَلاكِ ما عليها من النباتِ والزينةِ."],[32,33,"فَجَعَلۡنَـٰهَا حَصِيدًا","فجَعَلْنا زَرْعَها كالنَّباتِ المقطوعِ."],[34,36,"كَأَن لَّمۡ تَغۡنَ","كأن لم تَكُنِ الزروعُ قائمةً على ظَهْرِ الأرض."],[37,37,"بِٱلۡأَمۡسِ","في الماضي القريب."],[39,39,"نُفَصِّلُ","نُبَيِّنُ."],[40,40,"ٱلۡـَٔايَـٰتِ","الحُجَجَ والأدلَّةَ الواضحةَ."]],"25":[[3,4,"دَارِ ٱلسَّلَـٰمِ","الجنةِ."],[5,5,"وَيَهۡدِي","وُيَوفِّقُ."],[9,10,"صِرَٰطٍ مُّسۡتَقِيمٍ","الطريقِ الواضحِ، وهو دينُ الإسلامِ."]],"26":[[2,2,"ٱلۡحُسۡنَىٰ","الجنةُ."],[3,3,"وَزِيَادَةٌ","النظرُ إلى وجهِ اللهِ الكريمِ في الجنةِ."],[4,5,"وَلَا يَرۡهَقُ","لا يَغْشى ولا يعلوُ."],[7,7,"قَتَرٌ","غبارٌ فيه سَوادٌ."],[9,9,"ذِلَّةٌ","هَوانٌ وكآبةٌ."]],"27":[[1,1,"كَسَبُواْ","عَمِلُوا."],[10,11,"مِّنَ ٱللَّهِ","من عذابِه."],[12,13,"مِنۡ عَاصِمٍ","من مانعٍ."],[17,17,"قِطَعًا","أجزاءً."]],"28":[[8,9,"أَنتُمۡ وَشُرَكَآؤُكُمۡ","أنتم وآلهتكُم، حتى تَرَوْا ما يُفْعَلُ بكم."],[10,11,"فَزَيَّلۡنَا بَيۡنَهُمۡ","فرَّقْنا بينَ المشركين ومَعْبُوديهم."]],"30":[[1,1,"تَبۡلُواْ","تَخْتَبِرُ وتَعْلَمُ."],[4,5,"مَّآ أَسۡلَفَتۡ","ما قَدَّمَتْ مِن عَمَلٍ."],[11,11,"وَضَلَّ","ذَهَبَ وبَطَلَ."],[15,15,"يَفۡتَرُونَ","يَعْبُدون مِن آلهةٍ مزعومةٍ."]],"31":[[20,21,"يُدَبِّرُ ٱلۡأَمۡرَ","يَقْضي أمورَ الدُّنيا والآخرةِ ويُصَرِّفُها وحدَه على أكملِ الوجوهِ."]],"32":[[9,10,"فَأَنَّىٰ تُصۡرَفُونَ","فكيف تُصْرَفون عن عبادةِ اللهِ إلى عبادةِ غيره؟"]],"33":[[1,1,"حَقَّتۡ","وجَبَتْ."],[2,3,"كَلِمَتُ رَبِّكَ","حُكْمُه وقضاؤُه."],[6,6,"فَسَقُوٓاْ","خرجُوا عن طاعةِ اللهِ وكفرُوا به."]],"34":[[15,16,"فَأَنَّىٰ تُؤۡفَكُونَ","فكيف تُصْرَفون عن الحقِّ إلى الباطلِ؟"]],"35":[[5,7,"يَهۡدِيٓ إِلَى ٱلۡحَقِّ","يُرْشِدُ إليه."],[10,11,"يَهۡدِي لِلۡحَقِّ","يُرْشِدُ ويُوَفِّقُ إليه."],[20,21,"لَّا يَهِدِّيٓ","لا يهتدي بنفسه."]],"36":[[4,4,"ظَنًّا","تَخْمينًا وتوهُّمًا."]],"37":[[10,13,"تَصۡدِيقَ ٱلَّذِي بَيۡنَ يَدَيۡهِ","مُصَدِّقًا للكتبِ التي أنزلها اللهُ على أنبيائِه."],[14,15,"وَتَفۡصِيلَ ٱلۡكِتَـٰبِ","ومُفَصِّلًا لما شَرَعَه اللهُ فيه من العقائِد والأحكامِ."]],"38":[[7,9,"وَٱدۡعُواْ مَنِ ٱسۡتَطَعۡتُم","واستَعِينُوا بمَن أمْكَنَكم الاستعانةُ به."]],"39":[[1,1,"كَذَّبُواْ","سارَعُوا إلى التكذيبِ."],[2,5,"بِمَا لَمۡ يُحِيطُواْ بِعِلۡمِهِۦ","أي: بالقرآنِ، قبل أن يُدْرِكُوا ما اشتملَ عليه."],[6,8,"وَلَمَّا يَأۡتِهِمۡ تَأۡوِيلُهُۥ","ولَمّا يأتِهم عاقبةُ ما تَوَعَّدَهم اللهُ به في القرآنِ."]],"42":[[6,6,"ٱلصُّمَّ","الذين لا ينتفِعُون بسماعِ القرآنِ، ولا يَقْبَلُون ما فيه."]],"43":[[2,3,"يَنظُرُ إِلَيۡكَ","يعايِنُ دلائلَ نبوَّتِك الصادقةِ، فلا ينتفعُ بها."]],"45":[[3,4,"لَّمۡ يَلۡبَثُوٓاْ","لم يَمْكُثوا في الدنيا."],[9,10,"يَتَعَارَفُونَ بَيۡنَهُمۡ","يَعْرِفُ بعضُهم بعضًا كحالِهم في الدنيا."]],"46":[[5,6,"أَوۡ نَتَوَفَّيَنَّكَ","أي: قبلَ تعذيبِهم."],[11,14,"شَهِيدٌ عَلَىٰ مَا يَفۡعَلُونَ","مُطَّلِعٌ على أعمالِهم، ومُجازِيهم عليها."]],"47":[[4,5,"جَآءَ رَسُولُهُمۡ","في الدنيا، وبَلَّغَهم فكذَّبُوه، أو في الآخرةِ للشهادةِ عليهم."],[8,8,"بِٱلۡقِسۡطِ","بالعَدْلِ."]],"48":[[2,3,"هَـٰذَا ٱلۡوَعۡدُ","قيامُ الساعةِ والعذابُ الذي تُخَوِّفنا به."]],"49":[[13,13,"أَجَلٌ","مدةٌ معلومةٌ لانقضاءِ آجالِهم."],[17,18,"فَلَا يَسۡتَـٔۡخِرُونَ","لا يتأخَّرُون عنه."],[20,21,"وَلَا يَسۡتَقۡدِمُونَ","لا يتقدَّمُون عليه."]],"50":[[1,1,"أَرَءَيۡتُمۡ","أخْبِرُوني."],[5,5,"بَيَـٰتًا","ليلًا."],[8,10,"مَّاذَا يَسۡتَعۡجِلُ مِنۡهُ","أيُّ شيءٍ من أنواعِ العذابِ يَسْتعجلُونه؟"]],"51":[[6,6,"ءَآلۡـَٔـٰنَ","أتؤمنون بالعذابِ حين لا ينفعُكم الإيمانُ؟"]],"52":[[5,6,"عَذَابَ ٱلۡخُلۡدِ","الدائمَ الذي لا ينقطعُ، وهوجَهَنَّمُ."]],"53":[[0,0,"وَيَسۡتَنۢبِـُٔونَكَ","ويستخبِرُك المشركون عن العذابِ."],[4,5,"إِي وَرَبِّيٓ","نَعَمْ وربِّي."],[8,10,"وَمَآ أَنتُم بِمُعۡجِزِينَ","بفائتين من عذابِ اللهِ بالهَرَبِ."]],"54":[[4,4,"ظَلَمَتۡ","أشرَكَتْ وكَفَرَتْ."],[8,9,"لَٱفۡتَدَتۡ بِهِۦ","لَجَعَلَتْه فِدْيَةً لها من عذابِ الآخرةِ."],[10,11,"وَأَسَرُّواْ ٱلنَّدَامَةَ","أخْفَوا الغَمَّ والحَسْرَةَ."],[17,17,"بِٱلۡقِسۡطِ","بالعَدْلِ."]],"57":[[4,4,"مَّوۡعِظَةٌ","هو القرآنُ العظيمُ."]],"58":[[1,2,"بِفَضۡلِ ٱللَّهِ","الذي تَفَضَّلَ به عليكم، وهو الإسلامُ والإيمانُ."],[3,3,"وَبِرَحۡمَتِهِۦ","التي رَحِمَكم بها، وهي إنزالُ القرآنِ."]],"59":[[1,1,"أَرَءَيۡتُم","أخْبِروني."],[2,4,"مَّآ أَنزَلَ ٱللَّهُ","ما خَلَقه اللهُ لأجلِ نَفْعِكم."],[16,19,"أَمۡ عَلَى ٱللَّهِ تَفۡتَرُونَ","تَكْذِبُون بنسبةِ التحريمِ والتحليلِ إليه."]],"60":[[0,6,"وَمَا ظَنُّ ٱلَّذِينَ يَفۡتَرُونَ عَلَى ٱللَّهِ ٱلۡكَذِبَ","أيُّ شيءٍ ظَنُّهم، وما يُصْنَعُ بهم فيه؟"]],"61":[[2,3,"فِي شَأۡنٍ","في أمْرٍمن أمورِك."],[16,16,"شُهُودًا","رُقَباءَ مُطَّلِعِين عليه."],[18,19,"تُفِيضُونَ فِيهِ","تَشْرَعُون فيه وتَعْمَلُونه."],[20,21,"وَمَا يَعۡزُبُ","ما يَغِيبُ ولا يَبْعُدُ."],[25,26,"مِّثۡقَالِ ذَرَّةٍ","وزنِ أصغرِ نملةٍ."],[40,41,"كِتَـٰبٍ مُّبِينٍ","واضحٍ، وهو اللَّوحُ المحفوظُ."]],"62":[[7,9,"وَلَا هُمۡ يَحۡزَنُونَ","على ما فاتهم من حُظوظِ الدُّنيا."]],"64":[[1,1,"ٱلۡبُشۡرَىٰ","البِشارةُ بما يَسُرُّهم."],[7,10,"لَا تَبۡدِيلَ لِكَلِمَـٰتِ ٱللَّهِ","لا إخلافَ لوَعْدِ اللهِ."]],"65":[[4,6,"ٱلۡعِزَّةَ لِلَّهِ جَمِيعًا","الغَلَبَةَ، والقوةَ والقدرةَ التامةَ له تعالى."]],"66":[[20,20,"ٱلظَّنَّ","الشَّكَّ."],[24,24,"يَخۡرُصُونَ","يَكْذِبُون فيما يَنْسُبونَه إلى اللهِ."]],"67":[[8,8,"مُبۡصِرًا","مُضِيئًا يُبْصِرُ فيه الناسُ."],[12,12,"لَـَٔايَـٰتٍ","دَلالاتٍ وحججًا."]],"68":[[4,4,"سُبۡحَـٰنَهُۥ","تَنْزِيهًا له عَمّا نَسَبُوه إليه."],[14,15,"إِنۡ عِندَكُم","ليس لَدَيكم."],[17,17,"سُلۡطَـٰنِۭ","حُجَّةٍ وبُرهانٍ."]],"70":[[5,5,"مَرۡجِعُهُمۡ","مَصِيرُهم."]],"71":[[10,11,"كَبُرَ عَلَيۡكُم","عَظُمَ وثَقُلَ عليكم."],[12,12,"مَّقَامِي","إقامتي بينكم."],[13,13,"وَتَذۡكِيرِي","ووَعْظِي إياكم."],[14,15,"بِـَٔايَـٰتِ ٱللَّهِ","بحُجَجِه وبَراهينِه."],[16,18,"فَعَلَى ٱللَّهِ تَوَكَّلۡتُ","اعتمَدْتُ وفوَّضْتُ أمري إليه."],[19,20,"فَأَجۡمِعُوٓاْ أَمۡرَكُمۡ","اكتُمُوه واعزِمُوا عليه."],[21,21,"وَشُرَكَآءَكُمۡ","وادْعُوا آلهتَكم؛ لنُصْرَتِكم."],[27,27,"غُمَّةً","مُسْتَتِرًا خَفِيًّا."],[29,30,"ٱقۡضُوٓاْ إِلَيَّ","افعَلُوا ما تُريدون بي من العقوبةِ."],[31,32,"وَلَا تُنظِرُونِ","ولا تُمهِلُوني."]],"72":[[1,1,"تَوَلَّيۡتُمۡ","أعْرَضْتُم عن الإيمان."]],"73":[[5,5,"ٱلۡفُلۡكِ","السَّفينةِ."],[7,7,"خَلَـٰٓئِفَ","أي: يَخْلُفُون الذين هَلَكُوا بالغَرَقِ."]],"74":[[8,8,"بِٱلۡبَيِّنَـٰتِ","بالمعجزاتِ الدالَّةِ على صِدْقِهم."],[18,18,"نَطۡبَعُ","نَخْتِمُ."],[21,21,"ٱلۡمُعۡتَدِينَ","المتجاوِزين حُدودَ اللهِ."]],"75":[[8,8,"وَمَلَإِيْهِۦ","أشرافِ قومِه."]],"76":[[2,2,"ٱلۡحَقُّ","المعجزاتُ التي أظْهرها موسى عليه السلام."]],"78":[[2,2,"لِتَلۡفِتَنَا","لتَصْرِفَنا."],[9,9,"ٱلۡكِبۡرِيَآءُ","المُلْكُ والسُّلْطانُ."],[11,11,"ٱلۡأَرۡضِ","أرضِ مصرَ."]],"79":[[5,5,"عَلِيمٍ","مُتْقِنٍ للسِّحْرِ."]],"82":[[0,2,"وَيُحِقُّ ٱللَّهُ ٱلۡحَقَّ","يُثَبِّتُه ويُظْهِره."],[3,3,"بِكَلِمَـٰتِهِۦ","بقضائِه وأمْرِه."]],"83":[[13,13,"يَفۡتِنَهُمۡ","يُعَذِّبَهم؛ ليَحْمِلَهم على الرجوعِ عن الإيمان."],[16,16,"لَعَالٍ","متكبِّرٌ متطاولٌ."],[21,21,"ٱلۡمُسۡرِفِينَ","المتجاوِزِين الحَدَّ في الكفرِ والفسادِ."]],"85":[[7,7,"فِتۡنَةً","موضعَ ابتلاءٍ واختبارٍ."]],"87":[[5,5,"تَبَوَّءَا","اتَّخِذا."],[9,10,"وَٱجۡعَلُواْ بُيُوتَكُمۡ","أي: اجعَلُوها مساجدَ تُصَلُّون فيها عند الخوفِ."]],"88":[[17,19,"ٱطۡمِسۡ عَلَىٰٓ أَمۡوَٰلِهِمۡ","أهْلِكْها وأتْلِفْها."],[20,22,"وَٱشۡدُدۡ عَلَىٰ قُلُوبِهِمۡ","اخْتِمْ عليها."]],"90":[[0,3,"وَجَـٰوَزۡنَا بِبَنِيٓ إِسۡرَٰٓءِيلَ ٱلۡبَحۡرَ","قَطَعْناه بهم حتى تَرَكُوه وراءَهم."],[4,4,"فَأَتۡبَعَهُمۡ","لَحِقَهم."],[7,8,"بَغۡيًا وَعَدۡوًا","ظُلْمًا واعتداءً."],[11,12,"أَدۡرَكَهُ ٱلۡغَرَقُ","أحاطَ به، وقَرُبَ هَلاكُه."]],"91":[[0,0,"ءَآلۡـَٔـٰنَ","آلآن تُؤْمِنُ حين نَزَلَ بك الموتُ؟"]],"92":[[1,1,"نُنَجِّيكَ","نَجْعَلُكَ على مُرْتفَعٍ من الأرضِ."],[2,2,"بِبَدَنِكَ","بجَسَدِك الذي لا رُوحَ فيه."],[5,5,"خَلۡفَكَ","بَعْدَك من الناسِ."],[6,6,"ءَايَةً","عِبرةً يعتبرون بك."]],"93":[[1,1,"بَوَّأۡنَا","أنْزَلْنا وأسْكَنّا."],[4,5,"مُبَوَّأَ صِدۡقٍ","مَنزلًا كريمًا مختارًا."],[16,16,"يَقۡضِي","يَحْكُمُ."]],"94":[[10,10,"ٱلۡكِتَـٰبَ","التوراةَ والإنجيلَ."],[21,21,"ٱلۡمُمۡتَرِينَ","الشاكِّين."]],"95":[[5,6,"بِـَٔايَـٰتِ ٱللَّهِ","بحُجَجِه وأدِلَّتِه."]],"96":[[2,2,"حَقَّتۡ","وجَبَتْ."]],"97":[[3,3,"ءَايَةٍ","عِبْرةٍ وموعظةٍ."]],"98":[[0,0,"فَلَوۡلَا","فهَلّا."],[14,14,"ٱلۡخِزۡيِ","الذُّلِّ والهَوانِ."],[19,20,"إِلَىٰ حِينٍ","إلى وقتِ انقضاءِ آجالِهم."]],"100":[[9,9,"ٱلرِّجۡسَ","عذابَ اللهِ وغَضَبَه."]],"101":[[1,1,"ٱنظُرُواْ","تَفَكَّرُوا واعتَبِرُوا."],[8,8,"ٱلۡـَٔايَـٰتُ","الدلائلُ والعِبَرُ."],[9,9,"وَٱلنُّذُرُ","جَمْعُ نَذِير، وهم: الرسُلُ."]],"102":[[3,8,"مِثۡلَ أَيَّامِ ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلِهِمۡ","مثلَ ما حَلَّ بالأممِ السابقةِ من العذابِ."]],"104":[[20,20,"يَتَوَفَّىٰكُمۡ","يُمِيتُكم."]],"105":[[1,3,"أَقِمۡ وَجۡهَكَ لِلدِّينِ","استقِمْ على دينِ الإسلامِ مُخْلِصًا لله في عبادتِك وعَمَلِك."],[4,4,"حَنِيفًا","مائلًا عن الأديانِ الباطلةِ."]],"106":[[15,15,"ٱلظَّـٰلِمِينَ","المُشْركين."]],"107":[[3,3,"بِضُرٍّ","بشدَّةٍ أو بلاءٍ."],[11,11,"بِخَيۡرٍ","برَخاءٍ أو نِعْمةٍ."]],"108":[[5,5,"ٱلۡحَقُّ","القرآنُ العظيمُ."],[21,21,"بِوَكِيلٍ","بحَفيظٍ أحفَظُ أمورَكم."]]}