{"1":[[7,7,"أَوۡلِيَآءَ","خُلَصاءَ وأحبّاءَ."],[8,10,"تُلۡقُونَ إِلَيۡهِم بِٱلۡمَوَدَّةِ","أي: فتُخْبِرُونَهُم بِأَخْبارِ الرَّسُولِ ﷺ وسَرائِر المسْلِمِينَ."],[30,30,"وَٱبۡتِغَآءَ","طَلَبَ."],[32,32,"تُسِرُّونَ","تَنْقُلُونَ إلَيهِمُ الأخْبارَ سِرًّا."],[46,47,"سَوَآءَ ٱلسَّبِيلِ","طَرِيقَ الحقِّ والصَّوابِ."]],"2":[[0,1,"إِن يَثۡقَفُوكُمۡ","إن يَظْفَرْ بِكُم هَؤلاءِ الَّذِينَ تُسِرُّونَ إليهِم بالمودّةِ."],[5,6,"وَيَبۡسُطُوٓاْ إِلَيۡكُمۡ","ويَمُدُّوا إلَيكُم."],[9,9,"بِٱلسُّوٓءِ","بالقَتْلِ، والسَّبْيِ، والشَّتْمِ."]],"3":[[2,2,"أَرۡحَامُكُمۡ","قراباتُكُم."],[7,8,"يَفۡصِلُ بَيۡنَكُمۡ","يَفْرُقُ اللهُ بَيْنَكُم، فيُدْخِلُ أهلَ طاعَتهِ الجَّنَةَ، وأهلَ مَعْصِيتِه النّارَ."]],"4":[[3,3,"أُسۡوَةٌ","قُدْوَةٌ"],[20,21,"كَفَرۡنَا بِكُمۡ","أنْكَرْنا ما أنتُم عَلَيهِ مِنَ الكُفْرِ."],[22,22,"وَبَدَا","وظَهَر."],[47,47,"تَوَكَّلۡنَا","اعْتَمَدْنا."],[49,49,"أَنَبۡنَا","رَجَعْنا بالتَّوبَةِ"],[51,51,"ٱلۡمَصِيرُ","المرْجِعُ يومَ القِيامَةِ."]],"5":[[3,3,"فِتۡنَةً","مَفْتُونِينَ بِتَسْلِيطِ الكُفّارِ عَلَينا."],[11,11,"ٱلۡعَزِيزُ","الَّذِي لا يُغالَبُ."],[12,12,"ٱلۡحَكِيمُ","في أفْعالِهِ وأَقْوالِهِ."]],"6":[[4,4,"أُسۡوَةٌ","قُدْوَةٌ."],[8,9,"يَرۡجُواْ ٱللَّهَ","يَطْمَعُ في الخيرِ مِنَ اللهِ."],[12,13,"وَمَن يَتَوَلَّ","ومَن يُعْرضْ عَمّا أمَرهُ اللهُ بِهِ."],[17,17,"ٱلۡغَنِيُّ","عَنْ عِبادِهِ."],[18,18,"ٱلۡحَمِيدُ","في ذاتِه وصِفاتِه، المحْمُودُ عَلى كُلِّ حالٍ."]],"7":[[0,1,"عَسَى ٱللَّهُ","وعَدَ اللهُ."]],"8":[[14,14,"تَبَرُّوهُمۡ","تُحْسِنُوا مُعامَلَتَهُم."],[15,16,"وَتُقۡسِطُوٓاْ إِلَيۡهِمۡ","وتَعْدِلُوا فِيهِم."]],"9":[[6,7,"فِي ٱلدِّينِ","بِسَببِ الدِّينِ."],[11,11,"وَظَـٰهَرُواْ","وعاوَنُوا الكُفّارَ."],[14,15,"أَن تَوَلَّوۡهُمۡ","بالنُّصْرَةِ والمحبَّةِ."],[16,17,"وَمَن يَتَوَلَّهُمۡ","ومَنَ يَتَّخِذْهُم أنْصارًا عَلى المؤمِنِينَ."]],"10":[[6,6,"مُهَـٰجِرَٰتٍ","مِن دارِ الكُفْرِ إلى دارِ الإسْلامِ."],[7,7,"فَٱمۡتَحِنُوهُنَّ","فاخْتَبرُوا إيمانَهُنَّ."],[26,26,"وَءَاتُوهُم","وأعْطُوا أزواجَ اللاتِي أسْلَمْنَ."],[27,28,"مَّآ أَنفَقُواْ","مِثْلَ ما أعْطَوهُنَّ مِنَ المهُورِ."],[36,36,"أُجُورَهُنَّ","مُهُورَهُنَّ."],[39,39,"بِعِصَمِ","بِنِكاحِ، وأصْلُه جَمْعُ عِصْمَةٍ وهي: ما اعتُصِمَ بِهِ من العَقْدِ والسَّبَبِ."],[40,40,"ٱلۡكَوَافِرِ","الزَّوجاتِ الكافِراتِ."]],"11":[[1,1,"فَاتَكُمۡ","فَرَرْنَ ولَحِقْنَ."],[7,7,"فَعَاقَبۡتُمۡ","كانَتِ العُقْبى لَكُم، وهي الغِنيمَةُ."]],"12":[[5,5,"يُبَايِعۡنَكَ","يُعاهِدْنَكَ."],[7,11,"أَن لَّا يُشۡرِكۡنَ بِٱللَّهِ شَيۡـًٔا","ألّا يَجْعَلْنَ مَعَ اللهِ شَرِيكًا في عِبادَتِهِ."],[19,22,"وَلَا يَأۡتِينَ بِبُهۡتَـٰنٍ يَفۡتَرِينَهُۥ","ولا يأتِينَ بِكَذِبٍ في مَولُودٍ مِن غَيرِ أزْواجِهِنَّ فيُلْحِقْنَهُ بِهِم."],[30,30,"فَبَايِعۡهُنَّ","فعاهِدْهُنَّ."]],"13":[[3,5,"لَا تَتَوَلَّوۡاْ قَوۡمًا","لا تَتَّخِذُوهُم أخِلّاءَ."],[11,12,"مِنَ ٱلۡـَٔاخِرَةِ","مِن ثَوابِ اللهِ في الآخِرَةِ، أوْ كَما يَئِسَ الكُفّارُ مِن بَعْثِ مَوْتاهُم."]]}