{"1":[[0,0,"الٓمٓ","سَبَقَ شَرْحُها في الآية"]],"2":[[6,6,"ٱلۡقَيُّومُ","القائمُ بنفسِه، والمُقيمُ لأحوالِ خَلْقِه."]],"3":[[2,2,"ٱلۡكِتَـٰبَ","القرآنَ."],[4,7,"مُصَدِّقًا لِّمَا بَيۡنَ يَدَيۡهِ","يَشْهَدُ على صِدْقِ ما قبلَه من كُتُبٍ."]],"4":[[5,5,"ٱلۡفُرۡقَانَ","ما يُفَرِّقُ بينَ الحقِّ والباطلِ، وهو القرآنُ."]],"6":[[5,6,"كَيۡفَ يَشَآءُ","مِن ذَكَرٍ وأنثى، وشَقِيٍّ وسعيدٍ، وغيرِ ذلك."]],"7":[[7,7,"مُّحۡكَمَـٰتٌ","واضحاتُ المعنى، ظاهراتُ الدَّلالةِ."],[9,10,"أُمُّ ٱلۡكِتَـٰبِ","أصلُه الذي يُرْجَعُ إليه عندَ الاشتِباهِ."],[12,12,"مُتَشَـٰبِهَـٰتٌ","لا يتعَيَّنُ معناها، ولا تَظْهَرُ دَلالتُها."],[17,17,"زَيۡغٌ","مَيْلٌ."],[18,21,"فَيَتَّبِعُونَ مَا تَشَـٰبَهَ مِنۡهُ","يَتَّبعون الآياتِ المتشابهاتِ، فيُشَكِّكُون بها على المؤمنين."],[22,23,"ٱبۡتِغَآءَ ٱلۡفِتۡنَةِ","طَلَبًا منهم للتَّلبيسِ عليهم في دينِهم."],[24,25,"وَٱبۡتِغَآءَ تَأۡوِيلِهِۦ","ولتأويلِهم لها على الوجه الذي يوافِقُ مذهبَهم."],[31,31,"وَٱلرَّٰسِخُونَ","والمتمَكِّنُونَ."],[37,37,"كُلٌّ","كلُّ القرآنِ."],[41,42,"وَمَا يَذَّكَّرُ","وما يتدبَّرُ المعانيَ على وجْهِها الصحيحِ."],[44,45,"أُوْلُواْ ٱلۡأَلۡبَـٰبِ","أصحابُ العقولِ السليمةِ."]],"8":[[1,3,"لَا تُزِغۡ قُلُوبَنَا","لاتَصْرِفْ قلوبَنا عن الإيمانِ بك."]],"10":[[3,5,"لَن تُغۡنِيَ عَنۡهُمۡ","لن تنفعَهم، ولن تُنْجِيَهم."],[9,10,"مِّنَ ٱللَّهِ","من عقوبتهِ، إن أحَلَّها بهم عاجلًا في الدنيا."],[14,15,"وَقُودُ ٱلنَّارِ","حَطَبُ النارِ."]],"11":[[0,2,"كَدَأۡبِ ءَالِ فِرۡعَوۡنَ","شَأْنُ الكافرين في تكذيبهِم ومايَنْزِلُ بهم من العقوبةِ مِثْلُ شأنِ آلِ فرعونَ."],[8,9,"فَأَخَذَهُمُ ٱللَّهُ","فعاجَلَهم بالعُقوبةِ."]],"12":[[1,2,"لِّلَّذِينَ كَفَرُواْ","لليهودِ."],[4,4,"وَتُحۡشَرُونَ","وتُجْمَعون، وتُساقُون."],[8,8,"ٱلۡمِهَادُ","الفِراشُ."]],"13":[[3,3,"ءَايَةٌ","دَلالَةٌ عظيمةٌ."],[6,6,"ٱلۡتَقَتَا","أي: في معركةِ بدرٍ."],[14,15,"يَرَوۡنَهُم مِّثۡلَيۡهِمۡ","يرى المشركون المسلمين في العددِ مثلَيْهم."],[26,26,"لَعِبۡرَةً","لعِظَةً."],[27,28,"لِّأُوْلِي ٱلۡأَبۡصَـٰرِ","لأصحابِ البصائرِ."]],"14":[[0,0,"زُيِّنَ","حُسِّنَ."],[7,8,"وَٱلۡقَنَـٰطِيرِ ٱلۡمُقَنطَرَةِ","والأموالِ الكثيرةِ."],[13,13,"ٱلۡمُسَوَّمَةِ","المُعَلَّمَةِ الحِسانِ."],[14,14,"وَٱلۡأَنۡعَـٰمِ","من الإبِلِ والبقرِوالغَنَمِ."],[15,15,"وَٱلۡحَرۡثِ","الأرضِ المتخَذَةِ للزِّراعةِ."],[23,23,"ٱلۡمَـَٔابِ","المَرْجِعِ."]],"15":[[3,4,"مِّن ذَٰلِكُمۡ","ممّا حُسِّنَ للناسِ في الحياةِ الدُّنيا."],[17,17,"مُّطَهَّرَةٌ","من الحَيْضِ والنِّفاسِ، وسوءِ الخُلُقِ."],[18,18,"وَرِضۡوَٰنٌ","ورِضا."]],"16":[[8,8,"وَقِنَا","ونَجِّنا."]],"17":[[1,1,"وَٱلصَّـٰدِقِينَ","الذين صَدَقُوا اللهَ، فعَمِلُوا بماجاء به."],[2,2,"وَٱلۡقَـٰنِتِينَ","والمطيعين له."],[5,5,"بِٱلۡأَسۡحَارِ","بآخِرِ الليلِ."]],"18":[[7,7,"وَٱلۡمَلَـٰٓئِكَةُ","أي: يَشْهَدُون كذلك."],[11,11,"بِٱلۡقِسۡطِ","بالعَدْلِ."]],"19":[[11,15,"مِنۢ بَعۡدِ مَا جَآءَهُمُ ٱلۡعِلۡمُ","أي: المقتضي لعَدَمِ الاختلافِ، بما تَضَمَّنَتْه كُتُبُهم المنزَّلةُ."],[16,17,"بَغۡيَۢا بَيۡنَهُمۡ","حَسَدًا وطَلَبًا للدُّنيا، فصَدَّهم عن اتِّباعِ الَحقِّ."],[24,25,"سَرِيعُ ٱلۡحِسَابِ","يحفَظُ ذلك عليهم بغيرِ كُلْفَةٍ."]],"20":[[1,1,"حَآجُّوكَ","جادَلُوك أيُّها الرسولُ."],[3,3,"أَسۡلَمۡتُ","أخلَصْتُ."],[6,7,"وَمَنِ ٱتَّبَعَنِ","وكذلك أسْلَمَ وجهَه مَنِ اتَّبعَني."],[12,12,"وَٱلۡأُمِّيِّـۧنَ","مُشْركي العربِ الذين لايكتبُون."],[19,19,"تَوَلَّوۡاْ","أعْرَضُوا."]],"21":[[12,12,"بِٱلۡقِسۡطِ","بالعَدْلِ."]],"22":[[2,2,"حَبِطَتۡ","بَطَلَتْ."]],"23":[[2,3,"إِلَى ٱلَّذِينَ","إلى اليهودِ الذين كانوا في زمن النبيِّ ﷺ مِمَّن أُوتي عِلْمًا."],[5,7,"نَصِيبًا مِّنَ ٱلۡكِتَـٰبِ","حَظًّا من التوراةِ."],[10,11,"كِتَـٰبِ ٱللَّهِ","التوراةِ."],[15,15,"يَتَوَلَّىٰ","يأبى."]],"24":[[0,0,"ذَٰلِكَ","الانصرافُ عن الحقِّ."],[9,9,"وَغَرَّهُمۡ","وخَدَعَهم."],[14,14,"يَفۡتَرُونَ","يختلِقُون من الأكاذيبِ في ادِّعائِهم أنهم أبناءُ اللهِ وأحِبّاؤُه."]],"25":[[0,0,"فَكَيۡفَ","أي: فكيف يكونُ حالهُم؟"],[7,7,"وَوُفِّيَتۡ","وجُوزِيَتْ."],[10,11,"مَّا كَسَبَتۡ","ما عَمِلَتْ من خيرٍ أو شَرٍّ."]],"26":[[8,8,"تَنزِعُ","تَسْلُبُ."]],"27":[[0,0,"تُولِجُ","تُدْخِلُ."],[8,11,"وَتُخۡرِجُ ٱلۡحَيَّ مِنَ ٱلۡمَيِّتِ","تُخْرِجُ الإنسانَ الحَيَّ من النُّطْفةِ الميتةِ."],[12,15,"وَتُخۡرِجُ ٱلۡمَيِّتَ مِنَ ٱلۡحَيِّ","تُخْرِجُ النُّطْفَةَ الميتة من الإنسانِ الحيِّ."],[19,20,"بِغَيۡرِ حِسَابٍ","بغير مُحاسَبةٍ."]],"28":[[0,4,"لَّا يَتَّخِذِ ٱلۡمُؤۡمِنُونَ ٱلۡكَـٰفِرِينَ أَوۡلِيَآءَ","لا تَتَّخِذُوا أيها المؤمنون الكافرين أنصارًا."],[16,20,"إِلَّآ أَن تَتَّقُواْ مِنۡهُمۡ تُقَىٰةً","إلاأن تكونوا ضِعافًا، فرَخَّص لكم في مُهادنتِهم اتقاءً لشَرِّهم."],[26,26,"ٱلۡمَصِيرُ","رجوعُ الخلائقِ للحِسابِ."]],"29":[[7,7,"تُبۡدُوهُ","تُظْهِرُوه."]],"30":[[8,8,"مُّحۡضَرًا","مُوَفَّرًا."],[18,18,"أَمَدَۢا","زَمَنًا وأجَلًا."]],"32":[[5,5,"تَوَلَّوۡاْ","أعْرَضُوا."]],"33":[[2,2,"ٱصۡطَفَىٰٓ","اختار."],[9,10,"عَلَى ٱلۡعَـٰلَمِينَ","جَعَلَهم أفضلَ أهلِ زمانِهم."]],"34":[[0,3,"ذُرِّيَّةَۢ بَعۡضُهَا مِنۢ بَعۡضٍ","تَسَلْسَلَ الفَضْلُ في ذَراريهم."]],"35":[[2,3,"ٱمۡرَأَتُ عِمۡرَٰنَ","أمُّ مريمَ."],[6,6,"نَذَرۡتُ","جَعَلْتُه لخِدْمَةِ بيتِ المقدسِ."],[11,11,"مُحَرَّرًا","خالصًا لعبادتِك."]],"36":[[5,6,"وَضَعۡتُهَآ أُنثَىٰ","أي: لاتَصْلُحُ للخِدْمةِ."],[11,13,"وَلَيۡسَ ٱلذَّكَرُ كَٱلۡأُنثَىٰ","ليس الذَّكَرُ الذي أرَدْتُ للخدمةِ كالأنثى التي لا تَصْلُحُ لذلك."],[18,18,"أُعِيذُهَا","أُحَصِّنُها."],[23,23,"ٱلرَّجِيمِ","المَطْرودِ من رحمتك."]],"37":[[4,6,"وَأَنۢبَتَهَا نَبَاتًا حَسَنًا","تَوَلّى ابْنَتَها، فكَمُلَتْ بذلك أحوالُها."],[13,13,"ٱلۡمِحۡرَابَ","مَحَلَّ عبادتهِ."]],"38":[[0,0,"هُنَالِكَ","عند رؤيةِ زكريّا ما عندَ مريمَ من رزقِ اللهِ، وفَضْلهِ."],[10,11,"ذُرِّيَّةً طَيِّبَةً","ولَدًا مباركًا. وتُطْلَقُ الذُّرِّيَّةُ على الجمعِ والواحدِ."]],"39":[[6,6,"ٱلۡمِحۡرَابِ","مُقَدَّم المسجدِ، وهو مكانُ عبادتِه."],[11,14,"مُصَدِّقَۢا بِكَلِمَةٍ مِّنَ ٱللَّهِ","يُصَدِّقُ بعيسى عليه السلامُ."],[15,15,"وَسَيِّدًا","شريفًا في العِلْمِ والعبادةِ."],[16,16,"وَحَصُورًا","يَكُفُّ عن النساءِ، فيمتنعُ عنهنَّ مع القُدرةِ."]],"40":[[2,2,"أَنَّىٰ","من أيِّ وجهٍ؟"],[8,8,"ٱلۡكِبَرُ","الشيخوخةُ."],[10,10,"عَاقِرٌ","عَقيمٌ."],[12,13,"كَذَٰلِكَ ٱللَّهُ","هَيِّنٌ عليه أن يخلقَ ولدًا من الكبيرِ والعقيمِ."]],"41":[[4,4,"ءَايَةً","علامةً أسْتَدِلُّ بها على وجودِ الوَلَدِ."],[13,13,"رَمۡزًا","إشارةً وإيماءً."],[18,18,"بِٱلۡعَشِيِّ","مِن زوالِ الشمسِ إلى أن تَغِيبَ."],[19,19,"وَٱلۡإِبۡكَـٰرِ","من مَطْلَعِ الفجرِ إلى وقتِ الضُّحى."]],"42":[[6,6,"ٱصۡطَفَىٰكِ","اختارَكِ لطاعتِه."],[11,11,"ٱلۡعَـٰلَمِينَ","عالَمِي زمانِك."]],"43":[[1,1,"ٱقۡنُتِي","أخْلِصي الطاعةَ لربِّك."]],"44":[[6,8,"وَمَا كُنتَ لَدَيۡهِمۡ","أي: نحن نُعْلِمُك أخبارَهم."],[10,11,"يُلۡقُونَ أَقۡلَـٰمَهُمۡ","يُجْرُون القُرْعَةَ، بإلقاءِ سِهامِهم على كَفالةِ مريمَ، فأصابَتْ زكريا."]],"45":[[7,8,"بِكَلِمَةٍ مِّنۡهُ","يكونُ وجودُه بكلمةٍ من اللهِ، وهي قولُه: «كن»، فيكونُ."],[14,14,"وَجِيهًا","له الجاهُ العظيمُ عندَ اللهِ."]],"46":[[2,3,"فِي ٱلۡمَهۡدِ","في مَضْجَعِ الصبيِّ في رَضاعِه."],[4,4,"وَكَهۡلًا","مَن كان بينَ سِنِّ الشَّبابِ والشيخوخةِ."]],"47":[[2,2,"أَنَّىٰ","من أيِّ وجه؟"]],"48":[[1,1,"ٱلۡكِتَـٰبَ","الكتابةَ."]],"49":[[7,7,"بِـَٔايَةٍ","بعلامةٍ دالَّةٍ على أني مُرْسَلٌ من اللهِ."],[18,18,"فِيهِ","في ذلك الخَلْقِ."],[24,24,"ٱلۡأَكۡمَهَ","مَن وُلِدَ أعمى."],[25,25,"وَٱلۡأَبۡرَصَ","مَن يَظْهَرُ في جِلْده بياضٌ."],[34,34,"تَدَّخِرُونَ","تُخَبِّئون لوقتِ الحاجةِ."]],"50":[[0,0,"وَمُصَدِّقًا","وجِئتُكم مُصَدِّقًا."],[8,11,"بَعۡضَ ٱلَّذِي حُرِّمَ عَلَيۡكُمۡ","مثلَ لحومِ الإبلِ، والشُّحومِ، وغيرِها."]],"51":[[6,6,"صِرَٰطٌ","طريقٌ."]],"52":[[8,9,"إِلَى ٱللَّهِ","مُتَوَجِّهًا إلى اللهِ."],[11,11,"ٱلۡحَوَارِيُّونَ","هم أصْفِياءُ عيسى عليه السلامُ."]],"53":[[8,8,"ٱلشَّـٰهِدِينَ","الذين شَهِدُوا بالحقِّ، وأقَرُّوا بالتوحيدِ."]],"54":[[0,0,"وَمَكَرُواْ","أرادوا قَتْلَ عيسى عليه السلام."],[1,2,"وَمَكَرَ ٱللَّهُ","بحَقٍّ على ما يَلِيقُ به، وذلك من إلقائِه شَبَهَ عيسى على بعض أتباعِه حتى قَتَلُوه، ورَفْعِ عيسى إليه."]],"55":[[5,5,"مُتَوَفِّيكَ","قابضُك من الأرضِ."],[8,8,"وَمُطَهِّرُكَ","ومُخَلِّصُك."],[13,14,"ٱلَّذِينَ ٱتَّبَعُوكَ","هم خُلَّصُ أصحابِك الذين لم يَغْلُوا فيك."],[15,17,"فَوۡقَ ٱلَّذِينَ كَفَرُوٓاْ","ظاهرين على الذين جَحَدُوا نبوَّتَك."]],"56":[[6,7,"فِي ٱلدُّنۡيَا","بالقَتْلِ والصَّغارِ."]],"57":[[5,6,"فَيُوَفِّيهِمۡ أُجُورَهُمۡ","فيُعْطِيهم ثوابَ أعمالِهم كاملًا."]],"58":[[3,4,"مِنَ ٱلۡـَٔايَـٰتِ","من الدَّلائلِ الواضحةِ على صحةِ رسالتِك."],[5,6,"وَٱلذِّكۡرِ ٱلۡحَكِيمِ","القُرآنِ الذي يَفْصِلُ بينَ الحَقِّ والباطلِ"]],"59":[[5,6,"كَمَثَلِ ءَادَمَ","مَثَلُه كمَثَلِ خَلْقِ آدمَ من غير أبٍ، ولا أمٍّ."]],"60":[[6,6,"ٱلۡمُمۡتَرِينَ","الشاكِّين."]],"61":[[1,2,"حَآجَّكَ فِيهِ","جادَلَك في عيسى."],[19,19,"نَبۡتَهِلۡ","نَتَوَجَّهْ إلى اللهِ بالدُّعاء."]],"63":[[1,1,"تَوَلَّوۡاْ","أعْرَضُوا عن تصديِقك."]],"64":[[6,6,"سَوَآءِۭ","عَدْلٍ وحَقّ، نلتزمُ بها."],[17,21,"وَلَا يَتَّخِذَ بَعۡضُنَا بَعۡضًا أَرۡبَابًا","ماكان بطاعةِ الأتباعِ للرؤساءِ فيما أمروهُم به من المعاصِي."],[30,30,"مُسۡلِمُونَ","خاضِعُون لرَبِّنا."]],"65":[[3,5,"تُحَآجُّونَ فِيٓ إِبۡرَٰهِيمَ","تُجادِلُون في أنّ إبراهيمَ على مِلَّتِكم."]],"66":[[2,2,"حَـٰجَجۡتُمۡ","جادَلْتُم."],[3,6,"فِيمَا لَكُم بِهِۦ عِلۡمٌ","في أمْرِ دينِكم مِمّا تعتقدون صِحَّتَه."]],"67":[[8,8,"حَنِيفًا","مُتَّبِعًا أمْرَ الله."],[9,9,"مُّسۡلِمًا","خاشِعًا لربِّه، مُلْتَزِمًا بأحكامِه."]],"68":[[1,1,"أَوۡلَى","أحَقُّ."],[6,7,"وَهَـٰذَا ٱلنَّبِيُّ","محمدٌ ﷺ."]],"69":[[5,6,"لَوۡ يُضِلُّونَكُمۡ","عن الإسلامِ."]],"70":[[2,5,"لِمَ تَكۡفُرُونَ بِـَٔايَـٰتِ ٱللَّهِ","لِمَ تَجْحَدُون بآياتِ اللهِ التي أنزلها على رُسُلهِ في كُتُبِكم؟"],[6,7,"وَأَنتُمۡ تَشۡهَدُونَ","أنه الحقُّ، فتَجِدُونه مكتوبًا عندَكم ثم تُنْكِرونه."]],"71":[[3,3,"تَلۡبِسُونَ","تَخْلِطُون."],[4,4,"ٱلۡحَقَّ","الذي في كُتُبِكم."],[5,5,"بِٱلۡبَـٰطِلِ","بما حَرَّفْتُموه بأيدِيكم."],[6,7,"وَتَكۡتُمُونَ ٱلۡحَقَّ","وتُخْفُون ما في كُتبِكم من مَبْعَثِ محمدٍ ﷺ."]],"72":[[5,5,"ءَامِنُواْ","صَدِّقوا."],[11,12,"وَجۡهَ ٱلنَّهَارِ","أوَّلَه."],[15,16,"لَعَلَّهُمۡ يَرۡجِعُونَ","لعلَّهم يَتَشَكَّكُون في دينِهم، ويَرْجِعُون عنه."]],"73":[[0,1,"وَلَا تُؤۡمِنُوٓاْ","ولاتُصَدِّقوا."],[11,16,"أَن يُؤۡتَىٰٓ أَحَدٌ مِّثۡلَ مَآ أُوتِيتُمۡ","لا تُصَدِّقُوهم لئلا يَعْلَمُوا مثلَ ما عَلِمْتُم."],[18,18,"يُحَآجُّوكُمۡ","يَتَّخِذُوه حُجَّةً."]],"74":[[5,6,"ذُو ٱلۡفَضۡلِ","ذو العَطاءِ"]],"75":[[6,6,"بِقِنطَارٍ","على كثيرٍ من المالِ."],[21,21,"قَآئِمًا","أي: بالمطالبةِ."],[28,28,"ٱلۡأُمِّيِّـۧنَ","العربِ."],[29,29,"سَبِيلٌ","حَرَجٌ في أموالهِم؛ لأنّ اللهَ أحَلَّها لنا."]],"76":[[1,3,"مَنۡ أَوۡفَىٰ بِعَهۡدِهِۦ","مَن أدّى أمانتَه."]],"77":[[2,4,"يَشۡتَرُونَ بِعَهۡدِ ٱللَّهِ","يَسْتبدلون بوصيةِ اللهِ باتِّباعِ محمدٍ ﷺ."],[5,5,"وَأَيۡمَـٰنِهِمۡ","الكاذبةِ."],[9,10,"لَا خَلَـٰقَ","لا نصِيبَ."],[22,23,"وَلَا يُزَكِّيهِمۡ","ولا يُطَهِّرُهم مِن دَنَسِ ذُنوبِهم."]],"78":[[3,5,"يَلۡوُۥنَ أَلۡسِنَتَهُم بِٱلۡكِتَـٰبِ","يُحَرِّفُون الكلامَ، ويُبَدِّلون آياتِ اللهِ."]],"79":[[20,20,"رَبَّـٰنِيِّـۧنَ","جَمْعُ رَبّانِيّ، وهو الذي يُصْلِحُ أمورَ الناسِ، ويقومُ بها."]],"81":[[3,4,"مِيثَـٰقَ ٱلنَّبِيِّـۧنَ","العهدَ المؤكَّدَ على الأنبياءِ في تصديقِ بعضِهم بعضًا."],[5,5,"لَمَآ","لَئِنْ."],[24,24,"إِصۡرِي","عَهْدِي الُموَثَّقَ."]],"82":[[1,1,"تَوَلَّىٰ","أعْرَضَ."],[6,6,"ٱلۡفَـٰسِقُونَ","الخارجون عن طاعةِ اللهِ."]],"83":[[3,3,"يَبۡغُونَ","يريدون."],[5,5,"أَسۡلَمَ","استسلمَ، وخَضَعَ."],[10,10,"طَوۡعًا","طَواعيةً، كالملائكةِ والأنبياءِ."],[11,11,"وَكَرۡهًا","رَغْمًا عنه، كمَن أسلمَ مخافةَ القتلِ."]],"84":[[13,13,"وَٱلۡأَسۡبَاطِ","الأنبياءِ الذين كانُوا في قبائلِ بني إسرائيل مِن ولَدِ يعقوبَ."],[28,28,"مُسۡلِمُونَ","مُنقادُون بالطاعةِ."]],"86":[[1,1,"يَهۡدِي","يُوَفِّقُ للإيمانِ، ويُرْشِدُ للصَّوابِ."],[12,12,"ٱلۡبَيِّنَـٰتُ","الدَّلائلُ الواضحاتُ."]],"87":[[4,5,"لَعۡنَةَ ٱللَّهِ","الطَّرْدَ من رحمةِ اللهِ."]],"88":[[6,8,"وَلَا هُمۡ يُنظَرُونَ","ولا يُؤَخَّرُ عنهم لمعذِرَةٍ يَعْتَذِرُون بها."]],"89":[[6,6,"وَأَصۡلَحُواْ","ما أفسَدُوه."]],"90":[[8,10,"لَّن تُقۡبَلَ تَوۡبَتُهُمۡ","عند حُضورِ الموتِ."]],"91":[[13,15,"وَلَوِ ٱفۡتَدَىٰ بِهِۦٓ","ولو دَفَعَ هذا المالَ ليَفْتَدِيَ نفسَه من العذابِ."]],"92":[[2,2,"ٱلۡبِرَّ","الجنةَ."]],"93":[[6,8,"إِلَّا مَا حَرَّمَ","هو يعقوبُ، إذ حَرَّمَ على نفسِه -دونَ أتباعِه- لمرضٍ ألَمَّ به، ولمّا نَزَلَتِ التوراةُ حَرَّمَ اللهُ على بني إسرائيلَ بعضَ الأطعمةِ لظُلْمِهم."],[21,23,"إِن كُنتُمۡ صَـٰدِقِينَ","في دَعْواكم أنّ اللهَ أنزلَ في التوراةِ تحريمَ ماحَرَّمه يعقوبُ على نفسِه."]],"95":[[1,2,"صَدَقَ ٱللَّهُ","فيما أخبرَ به."],[6,6,"حَنِيفًا","مستقيمًا لا عِوَجَ فيه."]],"96":[[6,6,"بِبَكَّةَ","بمكةَ."],[7,7,"مُبَارَكًا","تُضاعَفُ فيه الحَسَناتُ."]],"97":[[1,1,"ءَايَـٰتُۢ","علاماتٌ."],[3,4,"مَّقَامُ إِبۡرَٰهِيمَ","وهو الحَجَرُ الذي كان يَقِفُ عليه حين كان يرفعُ القَواعدَ من البيت."],[17,17,"سَبِيلًا","سَعَةً."],[18,19,"وَمَن كَفَرَ","ومَن جَحَدَ وُجوبَه."]],"98":[[3,6,"لِمَ تَكۡفُرُونَ بِـَٔايَـٰتِ ٱللَّهِ","لِمَ تُنْكِرُون ما في كتبِكم من دلائلَ على أن الدينَ هو الإسلامُ؟"]],"99":[[4,4,"تَصُدُّونَ","تمنعون."],[11,11,"عِوَجًا","مَيْلًا عن القصدِ، والاستقامةِ."],[13,13,"شُهَدَآءُ","عالِمُون أنّ ما جِئْتُ به هو الحقُّ."]],"100":[[10,13,"يَرُدُّوكُم بَعۡدَ إِيمَـٰنِكُمۡ كَـٰفِرِينَ","يُلْقُوا إليكم الشُّبَهَ، فتَرْجِعُوا جاحِدِين للحقِّ."]],"101":[[5,6,"ءَايَـٰتُ ٱللَّهِ","القرآنُ الكريمُ."],[7,8,"وَفِيكُمۡ رَسُولُهُۥ","يُبَلِّغُها لكم، وهو حُجَّةٌ أخرى للهِ عليكم."],[10,11,"يَعۡتَصِم بِٱللَّهِ","يتمسَّكْ بدِينِه، وطاعتِه."],[13,13,"هُدِيَ","وُفِّقَ."],[15,15,"صِرَٰطٍ","طريقٍ."]],"102":[[11,11,"مُّسۡلِمُونَ","مُذْعِنُون له بالطاعةِ."]],"103":[[0,2,"وَٱعۡتَصِمُواْ بِحَبۡلِ ٱللَّهِ","وتمسَّكُوا بدينِ اللهِ."],[13,13,"فَأَلَّفَ","فجَمَعَ."],[18,18,"إِخۡوَٰنًا","مُتَحابِّين."],[21,21,"شَفَا","حافَةٍ وطَرفٍ."]],"104":[[2,2,"أُمَّةٌ","جماعةٌ."]],"105":[[2,3,"كَٱلَّذِينَ تَفَرَّقُواْ","من أهلِ الكتابِ."],[9,9,"ٱلۡبَيِّنَـٰتُ","الحُجَجُ الواضحاتُ."]],"106":[[1,2,"تَبۡيَضُّ وُجُوهٌ","هم أهلُ السَّعادَةِ."],[3,4,"وَتَسۡوَدُّ وُجُوهٌ","هم أهلُ الشَّقاءِ."],[9,9,"أَكَفَرۡتُم","فُيقال لهم توبيخًا"]],"108":[[5,5,"بِٱلۡحَقِّ","بالصِّدْقِ واليقينِ."]],"109":[[9,10,"تُرۡجَعُ ٱلۡأُمُورُ","مَصِيرُ أمْرِ جميعِ الخَلْقِ، فيُجازي كُلًّا بما يستحِقُّ."]],"110":[[0,0,"كُنتُمۡ","أنتم يا أمةَ محمدٍ ﷺ، على الشَّرْطِ المذكورِ."],[22,22,"ٱلۡفَـٰسِقُونَ","الخارِجُون عن دينِ اللهِ."]],"111":[[2,3,"إِلَّآ أَذًى","إلا ما يُؤْذِي أسماعَكم من الكَذِبِ على اللهِ والتحريفِ."],[6,7,"يُوَلُّوكُمُ ٱلۡأَدۡبَارَ","يُهْزَموا."]],"112":[[2,2,"ٱلذِّلَّةُ","الهَوانُ والصَّغارُ."],[5,5,"ثُقِفُوٓاْ","وُجِدُوا."],[6,9,"إِلَّا بِحَبۡلٍ مِّنَ ٱللَّهِ","إلا بعَهْدٍ من الله يأمَنُون به على أنفسِهم."],[10,12,"وَحَبۡلٍ مِّنَ ٱلنَّاسِ","بذِمَّةٍ من الناسِ."],[13,13,"وَبَآءُو","واستحَقُّوا غَضَبَ اللهِ."],[19,19,"ٱلۡمَسۡكَنَةُ","ذُلُّ الفاقةِ والفقرِ."]],"113":[[5,6,"أُمَّةٌ قَآئِمَةٌ","جماعةٌ ثابتةٌ على الحقِّ."],[10,11,"ءَانَآءَ ٱلَّيۡلِ","جَمْعُ إنى، وهي ساعاتُه."]],"115":[[4,5,"فَلَن يُكۡفَرُوهُ","فلن يُعْدَمُوا ثوابَه."]],"116":[[3,4,"لَن تُغۡنِيَ","لن تَدْفَعَ عنهم."],[9,10,"مِّنَ ٱللَّهِ","من عذابِ اللهِ."]],"117":[[1,2,"مَا يُنفِقُونَ","في وجوهِ الخيرِ."],[10,10,"صِرٌّ","بَرْدٌ شديدٌ."],[11,13,"أَصَابَتۡ حَرۡثَ قَوۡمٍ","هَبَّتْ علىَ زَرْعِ قومٍ كانوا يَرْجُون خيرَه. وكذلك إنفاقُ الكافرِ لا ينفَعُه."]],"118":[[5,7,"بِطَانَةً مِّن دُونِكُمۡ","أصفياءَ مِن دونِ المؤمنين، تُطْلِعُونَهم على أسرارِكم."],[8,10,"لَا يَأۡلُونَكُمۡ خَبَالًا","لا يُقَصِّرُون في إفسادِ حالِكم."],[12,13,"مَا عَنِتُّمۡ","مَشَقَّتَكم."],[26,26,"ٱلۡـَٔايَـٰتِ",": الحُجَجَ."]],"119":[[5,7,"وَتُؤۡمِنُونَ بِٱلۡكِتَـٰبِ كُلِّهِۦ","وتؤمنون بالكُتُبِ المنَّزلَةِ كلها، وهم لا يُؤمنون بكتابِكم."],[17,18,"مِنَ ٱلۡغَيۡظِ","من شِدَّةِ الغَضَبِ."]],"120":[[14,14,"كَيۡدُهُمۡ","أذى مَكْرِهم."]],"121":[[1,3,"غَدَوۡتَ مِنۡ أَهۡلِكَ","خَرَجْتَ من بيتِك يومَ أُحُدٍ."],[4,5,"تُبَوِّئُ ٱلۡمُؤۡمِنِينَ","تَتَّخِذُ لهم."]],"122":[[2,2,"طَّآئِفَتَانِ","هما بنو سَلِمَةَ وبنو حارثةَ، حَدَّثَتْهم أنفسُهم يومَ أُحُدٍ بالرُّجوعِ عن لقاءِ العدوِّ، ولكنَّ اللهَ عَصَمَهم."],[5,5,"تَفۡشَلَا","تَجْبُنا."],[7,7,"وَلِيُّهُمَا","الدافعُ عنهما الضَّعْفَ."]],"123":[[2,2,"أَذِلَّةٌ","قليلو العَدَدِ والعُدَّةِ."]],"124":[[12,12,"مُنزَلِينَ","من السماءِ يُقاتِلون معكم."]],"125":[[4,4,"وَيَأۡتُوكُم","ويأتي كفارُ مكةَ لقتالِكم."],[5,7,"مِّن فَوۡرِهِمۡ هَـٰذَا","مِن ساعَتِهم هذه."],[14,14,"مُسَوِّمِينَ","مُعْلِمِين أنفسَهم بعلاماتٍ واضِحاتٍ."]],"126":[[0,1,"وَمَا جَعَلَهُ","وما جَعَلَ هذا الإمدادَ بالملائكةِ."]],"127":[[0,1,"لِيَقۡطَعَ طَرَفًا","ليُهلِكَ فريقًامن الكفّارِ بالقَتْلِ."],[5,6,"أَوۡ يَكۡبِتَهُمۡ","أو يُغِيظَهم، ويُحْزِنَهم."],[7,8,"فَيَنقَلِبُواْ خَآئِبِينَ","فيعودُوا غيرَ ظافِرين بمَطْلَبِهم."]],"130":[[6,7,"أَضۡعَـٰفًا مُّضَـٰعَفَةً","كانوا في الجاهليةِ إذا حانَ موعِدُ السَّدادِ يقولُ المقترضُ: أخِّرْ عني، وأَزِيدُك."]],"134":[[3,3,"ٱلسَّرَّآءِ","في اليُسْرِ وسَعَةِ العيشِ."],[4,4,"وَٱلضَّرَّآءِ","الضِّيقِ والشدةِ."],[5,5,"وَٱلۡكَـٰظِمِينَ","الذين يُمْسِكون مافي أنفسِهم من الغيظِ بالصبر."],[7,7,"وَٱلۡعَافِينَ","والذين يَصْفَحُون عمَّن ظَلَمَهم."]],"135":[[3,3,"فَـٰحِشَةً","هي الفعْلَةُ القبيحةُ الخارجةُ عَمّا أذِنَ اللهُ."],[5,6,"ظَلَمُوٓاْ أَنفُسَهُمۡ","بارتكابِ مادونَ الفاحشةِ."],[7,8,"ذَكَرُواْ ٱللَّهَ","ذكَروا وعيدَه على المعصية."],[16,17,"وَلَمۡ يُصِرُّواْ","ولم يَثْبُتوا على ما أتَوا من الذُّنوبِ."],[21,22,"وَهُمۡ يَعۡلَمُونَ","قُبْحَه."]],"136":[[13,14,"أَجۡرُ ٱلۡعَـٰمِلِينَ","ثوابُ المطيعين."]],"137":[[1,1,"خَلَتۡ","مضَتْ."],[4,4,"سُنَنٌ","ماسَنَّه اللهُ في الأممِ المكذِّبة والسُّنَّةُ: المثالُ المُتَّبَعُ."],[11,12,"عَـٰقِبَةُ ٱلۡمُكَذِّبِينَ","قد أُمْهِلُ المكذِّبين وأسْتَدْرِجُهم إلى أجَلٍ، ثم أُحِلُّ بهم عُقوبتي، وهذا ماحدَث مع المشركين يومَ أُحُدٍ."]],"138":[[0,0,"هَـٰذَا","الذي أوضَحْتُه لكم بما تَقَدَّم أو القرآنُ."]],"139":[[0,1,"وَلَا تَهِنُواْ","ولا تضْعُفُوا بالذي نالَكم يومَ أُحُدٍ."],[5,5,"ٱلۡأَعۡلَوۡنَ","الغالِبُون على عَدُوِّكم بالنصرِ."]],"140":[[2,2,"قَرۡحٌ","جِراْحٌ وقَتْلٌ يومَ أُحُد."],[7,7,"مِّثۡلُهُۥ","يومَ بدرٍ."],[10,10,"نُدَاوِلُهَا","يُصَرِّفُها اللهُ، فيظفَرُ المؤمنُ بالكافر، والكافرُ بالمؤمن."],[17,19,"وَيَتَّخِذَ مِنكُمۡ شُهَدَآءَ","ويُكَرِّمَ أقوامًا بالشهادةِ."]],"141":[[0,0,"وَلِيُمَحِّصَ","ولِيَخْتبرَ."],[4,4,"وَيَمۡحَقَ","ويُهْلِكَهم."]],"142":[[5,6,"وَلَمَّا يَعۡلَمِ","أي: عِلْمًا ظاهرًا للخَلْقِ."]],"143":[[3,3,"ٱلۡمَوۡتَ","أسبابَه. وكان قومٌ من الصَّحابة مِمَّنْ لم يَشْهدوا بدرًا تمنَّوا أن يجاهِدُوا."],[8,9,"فَقَدۡ رَأَيۡتُمُوهُ","حَصَلَ ذلك يومَ أُحُدٍ، ولكن فَرَّ بعضُهم، وصَبَر بعضُهم."]],"144":[[5,5,"خَلَتۡ","مَضَتْ، فسوف يَقْبِضُه اللهُ إليه عند انقضاءِ أجَلِه."],[13,15,"ٱنقَلَبۡتُمۡ عَلَىٰٓ أَعۡقَـٰبِكُمۡ","ارتَددْتُم عن دينِكم."],[20,22,"فَلَن يَضُرَّ ٱللَّهَ","فلن يُوهِنَ ذلك عزةَ اللهِ ولا سُلطانَه، وإنما يَضُرُّ نفسَه."],[26,26,"ٱلشَّـٰكِرِينَ","على نِعْمَةِ الإسلامِ، الثابتين على دينِهم."]],"145":[[6,7,"بِإِذۡنِ ٱللَّهِ","بقَدَرِه حتى يَسْتوفيَ مُدَّتَه."],[8,8,"كِتَـٰبًا","كَتَبَ اللهُ ذلك كتابًا."],[9,9,"مُّؤَجَّلًا","مؤقتًا لا يتقدَّمُ على أجَلهِ ولا يتأخَّرُ."],[14,15,"نُؤۡتِهِۦ مِنۡهَا","أي: ما قُسِم له فيها من رزقٍ."]],"146":[[0,0,"وَكَأَيِّن","كثيرٌ."],[5,6,"رِبِّيُّونَ كَثِيرٌ","جموعٌ كثيرةٌ من أصحابِهم، أو علماءُ."],[8,8,"وَهَنُواْ","ضَعُفُوا."],[16,17,"وَمَا ٱسۡتَكَانُواْ","ما ذَلُّوا لعَدُوِّهم."]],"147":[[10,10,"وَإِسۡرَافَنَا","من الذُّنوبِ الكَبائرِ."]],"148":[[2,3,"ثَوَابَ ٱلدُّنۡيَا","بالنصر، والتمكينِ في الأرض."],[4,6,"وَحُسۡنَ ثَوَابِ ٱلۡـَٔاخِرَةِ","وخيرَ جزاءِ الآخرةِ."],[7,9,"وَٱللَّهُ يُحِبُّ ٱلۡمُحۡسِنِينَ","مَن أحسنَ عبادتَه لربِّه."]],"149":[[7,9,"يَرُدُّوكُمۡ عَلَىٰٓ أَعۡقَـٰبِكُمۡ","يُضِلُّوكم عن طريقِ الحقِّ."]],"150":[[2,2,"مَوۡلَىٰكُمۡ","ناصِرُكم."]],"151":[[0,5,"سَنُلۡقِي فِي قُلُوبِ ٱلَّذِينَ كَفَرُواْ ٱلرُّعۡبَ","لأنّ المشركين عَزَمُوا على استئصالِ المسلمين بعد أُحُدٍ، ولكنَّ اللهَ قَذَفَ فيهم الرُّعْبَ، فرجَعوا عَمّا هَمُّوا به."],[13,13,"سُلۡطَـٰنًا","دليلًا على استحقاقِها العبادةَ."],[17,17,"مَثۡوَى","مكانُ الإقامةِ."]],"152":[[1,3,"صَدَقَكُمُ ٱللَّهُ وَعۡدَهُۥٓ","حَقَّقَ ما وعَدَكم مِن نَصْرٍ في أُحُدٍ قبلَ تَرْكِ الرُّماةِ مقاعِدَهم."],[5,5,"تَحُسُّونَهُم","تستأصِلُونهم بالقَتْلِ."],[9,9,"فَشِلۡتُمۡ","جَبُنتم. وجواب «إذا» مقدرٌ: امتُحِنْتُم."],[10,10,"وَتَنَـٰزَعۡتُمۡ","اختلَفْتم: هل تَبْقَون في مَواقِعِكم، أو تتركونها للغَنائم؟"],[29,29,"صَرَفَكُمۡ","رَدَّكم عنهم بالهزيمةِ."],[31,31,"لِيَبۡتَلِيَكُمۡ","ليَخْتَبِرَكم."]],"153":[[1,1,"تُصۡعِدُونَ","تَسِيرون في مستوى الأرضِ وبُطونِ الأوديةِ هاربين."],[2,3,"وَلَا تَلۡوُۥنَ","لاتَلْتَفِتُون إلى أحَدٍ."],[8,9,"فِيٓ أُخۡرَىٰكُمۡ","في الطائفةِ المتأخرةِ."],[10,10,"فَأَثَـٰبَكُمۡ","فجازاكم."],[11,12,"غَمَّۢا بِغَمٍّ","الغَمُّ الأولُ ما أُشيعَ من قَتْل الرسولِ ﷺ، والثاني: ما نالهم من القَتْلِ والجِراحِ."],[15,17,"عَلَىٰ مَا فَاتَكُمۡ","من نَصْرٍ وغنيمةٍ. وفَعَلَ بكم ذلك تدريبًا لاحتمالِ الشدائدِ."]],"154":[[6,6,"أَمَنَةً","أمانًا."],[9,10,"طَآئِفَةً مِّنكُمۡ","هم أهلُ الإخلاصِ."],[13,14,"أَهَمَّتۡهُمۡ أَنفُسُهُمۡ","خَلاصُ أنفسِهم من القَتْلِ، وهم المنافقون."],[19,20,"ظَنَّ ٱلۡجَـٰهِلِيَّةِ","بأنّ الإسلامَ لن تقومَ له قائمةٌ."],[22,27,"هَل لَّنَا مِنَ ٱلۡأَمۡرِ مِن شَيۡءٍ","هل كان لنا من اختيارٍ في الخروجِ للقتالِ؟"],[33,33,"يُخۡفُونَ","من الحَسْرةِ على خروجِهم للقتالِ."],[60,61,"إِلَىٰ مَضَاجِعِهِمۡ","إلى المواضع التي كُتِبَ عليهم أنْ يُقْتَلَوا فيها."],[64,66,"مَا فِي صُدُورِكُمۡ","من الشَّكِّ، والنفاق."],[67,67,"وَلِيُمَحِّصَ","ليمِيزَ الخبيثَ من الطَّيِّبِ."]],"155":[[2,2,"تَوَلَّوۡاْ","فَرُّوا."],[5,6,"ٱلۡتَقَى ٱلۡجَمۡعَانِ","أي: يومَ أُحُدٍ، والجَمْعان: المؤمنون، والمشركون."],[8,8,"ٱسۡتَزَلَّهُمُ","أوْقَعَهم."],[11,12,"مَا كَسَبُواْ","من الذُّنوبِ."]],"156":[[5,6,"كَٱلَّذِينَ كَفَرُواْ","من المنافقين."],[10,12,"ضَرَبُواْ فِي ٱلۡأَرۡضِ","سَفَرًا للبحث عن معاشِهم فماتوا."],[15,15,"غُزًّى","غازين."],[25,25,"ذَٰلِكَ","هذا القولُ."]],"157":[[12,13,"مِّمَّا يَجۡمَعُونَ","ممّا يجْمَعُه أهلُ الدنيا."]],"159":[[0,1,"فَبِمَا رَحۡمَةٍ","فبرحمةٍ."],[8,8,"فَظًّا","سَيِّئَ الخُلُقِ جافيًا."],[11,11,"لَٱنفَضُّواْ","لَتَفرَّقُوا عنك."],[18,18,"وَشَاوِرۡهُمۡ","لتقتديَ بك الأمةُ، وذلك في غير ما ورَدَ به الشَّرعُ."],[21,22,"فَإِذَا عَزَمۡتَ","عَقِبَ المُشاورةِ، وقَصَدْتَ إمضاءَ الأمرِ."]],"161":[[3,4,"أَن يَغُلَّ","أن يَخُونَ أصحابَه بأن يأخذَ من الغنيمةِ غيرَ ما اخْتَصَّه اللهُ."],[8,9,"بِمَا غَلَّ","بما أخَذَه حاملًا له ليُفضحَ به."]],"162":[[4,6,"كَمَنۢ بَآءَ بِسَخَطٍ","كمَن رَجَعَ بغضبٍ شديدٍ."]],"163":[[0,1,"هُمۡ دَرَجَـٰتٌ","ذوو دَرَجاتٍ، فدَرجاتُ مَنِ اتَّبعَ رضوانَه ليسَتْ كدرجاتِ الآخَرين."]],"164":[[1,1,"مَنَّ","أنعمَ."],[9,10,"مِّنۡ أَنفُسِهِمۡ","من أهلِ لسانِهم."],[14,14,"وَيُزَكِّيهِمۡ","ويُطَهِّرُهم."],[17,17,"وَٱلۡحِكۡمَةَ","والسُّنَّةَ."],[18,19,"وَإِن كَانُواْ","وإنّهم كانوا."]],"165":[[2,2,"مُّصِيبَةٌ","يومَ أُحدٍ."],[4,5,"أَصَبۡتُم مِّثۡلَيۡهَا","يومَ بدرٍ من المشركين."],[7,8,"أَنَّىٰ هَـٰذَا","كيف يكونُ هذا، ونحن مسلمون فينا نبيُّ اللهِ؟"],[11,13,"مِنۡ عِندِ أَنفُسِكُمۡ","عقوبةٌ لكم بسببِ مخالفتِكم أمْرَ رسولِكم."]],"166":[[2,4,"يَوۡمَ ٱلۡتَقَى ٱلۡجَمۡعَانِ","يومَ أُحُدٍ."],[5,6,"فَبِإِذۡنِ ٱللَّهِ","بعِلْمِه."]],"167":[[11,11,"ٱدۡفَعُواْ","كونوا عَوْنًا لنا بتكثيرِكم سَوادَنا."]],"168":[[4,5,"لَوۡ أَطَاعُونَا","بتَرْكِ الخروجِ من المدينةِ."],[9,9,"فَٱدۡرَءُواْ","فادفَعُوا."]],"169":[[9,9,"أَحۡيَآءٌ","حياةً بَرْزَخيةً."],[10,11,"عِندَ رَبِّهِمۡ","في الجنةِ."]],"170":[[6,6,"وَيَسۡتَبۡشِرُونَ","ويَفْرحون."],[13,15,"أَلَّا خَوۡفٌ عَلَيۡهِمۡ","فيما يَسْتقبلون من أمورِ الآخرةِ."],[16,18,"وَلَا هُمۡ يَحۡزَنُونَ","على مافاتَهم في الدنيا."]],"172":[[0,1,"ٱلَّذِينَ ٱسۡتَجَابُواْ","هم الذين خرجُوا يَتَعَقَّبون المشركين في «حمراءِ الأسَدِ»، بعد هزيمتِهم في أُحُدٍ."],[8,8,"ٱلۡقَرۡحُ","الجراحُ من معركةِ أُحُدٍ."]],"173":[[1,3,"قَالَ لَهُمُ ٱلنَّاسُ","هم بعضُ المشركين، قالوا: إن أبا سفيان ومَن معه سيعودون إليكم."],[13,14,"حَسۡبُنَا ٱللَّهُ","اللهُ كافِينا."]],"174":[[0,0,"فَٱنقَلَبُواْ","فرَجَعُوا من حمراءِ الأسَدِ."]],"175":[[3,4,"يُخَوِّفُ أَوۡلِيَآءَهُۥ","يُخَوِّفُكم بأوليائِه."]],"176":[[16,16,"حَظًّا","نصيبًا."]],"177":[[2,2,"ٱشۡتَرَوُاْ","استبدلُوا."]],"178":[[0,3,"وَلَا يَحۡسَبَنَّ ٱلَّذِينَ كَفَرُوٓاْ","إذا أطَلْنا أعمارَهم، ومَتَّعْناهم."],[4,6,"إِنَّمَا نُمۡلِي لَهُمۡ","نُؤَخِّرُ أجَلَهم، وعذابَهم."],[9,9,"إِثۡمًا","ظلمًا وطُغيانًا."]],"179":[[3,3,"لِيَذَرَ","لِيَدَعَ."],[5,8,"عَلَىٰ مَآ أَنتُمۡ عَلَيۡهِ","من التباسِ المؤمن مِنكم بالمنافقِ."],[18,19,"عَلَى ٱلۡغَيۡبِ","الذي يَعْلَمُه من عبادِه، فتَعْرِفُوا المؤمنَ منهم من المنافقِ، ولكنه يَمِيزُهم بالمِحَنِ."],[22,22,"يَجۡتَبِي","يَصْطَفي مِن رُسُله ليُطْلِعَه على شيءٍ من غيبهِ."]],"180":[[16,16,"سَيُطَوَّقُونَ","سيكونُ طَوْقًا من نارٍ يُوضَعُ في أعناقِهم."]],"181":[[4,5,"ٱلَّذِينَ قَالُوٓاْ","هم اليهودُ."],[6,8,"إِنَّ ٱللَّهَ فَقِيرٌ","يَطْلبُ منا أن نُقْرِضَه مالًا، وهذا للتشكيكِ على المسلمين."]],"182":[[1,3,"بِمَا قَدَّمَتۡ أَيۡدِيكُمۡ","من المعاصي."]],"183":[[4,5,"عَهِدَ إِلَيۡنَآ","في التوراةِ."],[11,11,"بِقُرۡبَانٍ","بصَدَقَةٍ يُتَقَرَّبُ بها إلى الله، فتنزلُ نارٌ من السماءِ فتحرقُها."]],"184":[[8,8,"بِٱلۡبَيِّنَـٰتِ","بالمعجزاتِ الواضحاتِ."],[9,9,"وَٱلزُّبُرِ","الكتبِ التي أنزلها اللهُ."]],"185":[[21,22,"مَتَـٰعُ ٱلۡغُرُورِ","مُتْعَةٌ زائلةٌ، فلا تَغْترُّوا بها."]],"186":[[0,0,"لَتُبۡلَوُنَّ","لَتُخْتَبَرُنَّ."],[1,2,"فِيٓ أَمۡوَٰلِكُمۡ","بإخراجِ النفقاتِ الواجبةِ والمُسْتَحَبَّةِ، وبالجوائح التي تُصيبها."],[3,3,"وَأَنفُسِكُمۡ","بما يجبُ عليكم من الطاعاتِ، وما يَحُلُّ بكم من الجِراح، وفَقْدِ الأحبابِ."],[21,23,"مِنۡ عَزۡمِ ٱلۡأُمُورِ","من الأمورِ التي يُتنافَسُ فيها."]],"187":[[3,3,"مِيثَـٰقَ","العهدَ المُوَثَّقَ."],[11,11,"فَنَبَذُوهُ","تركُوا العملَ به"],[14,17,"وَٱشۡتَرَوۡاْ بِهِۦ ثَمَنًا قَلِيلًا","أخذُوا ثمنًا بَخْسًا مقابلَ كِتْمانِهم الحقَّ، وتحريفِهم كتبَهم."]],"188":[[2,3,"ٱلَّذِينَ يَفۡرَحُونَ","أهلَ الكتابِ ومَن كان مثلَهم من الذين أخَذَ ميثاقَهم."],[4,5,"بِمَآ أَتَواْ","بكِتْمانهم أنّ النبيَّ ﷺ مُرْسَلٌ بالحقِّ."],[14,14,"بِمَفَازَةٍ","بمَنجاةٍ."]],"190":[[5,7,"وَٱخۡتِلَـٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ","في تَعاقُبِهِما واختلافِهما طُولًا وقِصَرًا."],[8,8,"لَـَٔايَـٰتٍ","لَدلائلَ."],[10,10,"ٱلۡأَلۡبَـٰبِ","العقولِ السليمةِ."]],"191":[[7,7,"وَيَتَفَكَّرُونَ","ويتدبَّرون."],[16,16,"بَـٰطِلًا","عَبَثًا."],[17,17,"سُبۡحَـٰنَكَ","نُنَزِّهُك."]],"192":[[6,6,"أَخۡزَيۡتَهُۥ","أهَنْتَه، وهو الخالدُ فيها."]],"193":[[3,3,"مُنَادِيًا","هو محمدٌ ﷺ."],[19,19,"ٱلۡأَبۡرَارِ","الصالحين."]],"194":[[6,7,"وَلَا تُخۡزِنَا","ولاتَفْضَحْنا بذنوبِنا."]],"195":[[13,15,"بَعۡضُكُم مِّنۢ بَعۡضٍ","هم سَواءُ في الجزاءِ على العملِ."]],"196":[[0,4,"لَا يَغُرَّنَّكَ تَقَلُّبُ ٱلَّذِينَ كَفَرُواْ","لا تَغْتَرَّ بما عليه أهلُ الكفرِ من تَصَرُّفِهم في الأرضِ وضَرْبِهم فيها."]],"197":[[3,3,"مَأۡوَىٰهُمۡ","مصيرُهم."],[6,6,"ٱلۡمِهَادُ","الفِراشُ والمَضْجَعُ."]],"198":[[12,12,"نُزُلًا","هوما يُهَيَّأ للنَّزيلِ ضِيافةً."]],"199":[[19,20,"ثَمَنًا قَلِيلًا","من حُطامِ الدُّنيا، فلايكتُمون ما أنزلَ اللهُ ولايُحَرِّفُونه."]],"200":[[3,3,"وَصَابِرُواْ","أي غالِبُوا أعداءَكم في الصَّبْرِ."],[4,4,"وَرَابِطُواْ","وأقِيمُوا على جهادِ العَدُوِّ."]]}