{"1":[[2,2,"ٱنشَقَّتۡ","تَصَدَّعتْ يومَ القِيامَةِ."]],"2":[[0,1,"وَأَذِنَتۡ لِرَبِّهَا","وأَطاعَتْ أمْرَ رَبِّها."],[2,2,"وَحُقَّتۡ","وحُقَّ لَها أن تَنقادَ لِأَمْرِهِ."]],"3":[[2,2,"مُدَّتۡ","بُسِطَتْ ووُسِّعَتْ."]],"4":[[0,2,"وَأَلۡقَتۡ مَا فِيهَا","وقَذَفَتْ ما في بَطْنِها مِنَ الأمْواتِ."],[3,3,"وَتَخَلَّتۡ","لم يَبْقَ شَيءٌ مِمّا في بَطْنِها."]],"5":[[0,1,"وَأَذِنَتۡ لِرَبِّهَا","وانْقادَتْ لِرَبِها فِيما أمَرها بِهِ."]],"6":[[3,3,"كَادِحٌ","ساعٍ إلى اللهِ."],[7,7,"فَمُلَـٰقِيهِ","تُلاقِي الله يَومَ القِيامَةِ."]],"7":[[2,3,"أُوتِيَ كِتَـٰبَهُۥ","أُعطِيَ صَحِيفةَ أعمالِهِ."]],"8":[[3,3,"يَسِيرًا","سَهْلا."]],"9":[[0,0,"وَيَنقَلِبُ","ويَرْجِعُ."]],"10":[[3,3,"كِتَـٰبَهُۥ","صَحِيفةَ أعْمالِهِ."]],"11":[[2,2,"ثُبُورًا","بِالهَلاكِ."]],"12":[[0,1,"وَيَصۡلَىٰ سَعِيرًا","ويَدْخُلُ النّارَ مُقاسِيًا حَرَّها."]],"13":[[4,4,"مَسۡرُورًا","مَغْرُورًا لا يُفَكِّرُ في العواقِبِ."]],"14":[[4,4,"يَحُورَ","يَرْجِعَ إلى خالِقِه لِلْحِسابِ."]],"16":[[2,2,"بِٱلشَّفَقِ","باحْمِرارِ الأُفُقِ عِنْدَ الغُرُوب."]],"17":[[1,2,"وَمَا وَسَقَ","وما جَمَعَ من الدَّوابِّ والحَشراتِ والهَوامِّ وغَيرِ ذَلِكَ."]],"18":[[2,2,"ٱتَّسَقَ","تَكامَلَ نُورُهُ."]],"19":[[1,3,"طَبَقًا عَن طَبَقٍ","أطوارًا مُتَعَدِّدَةً وأَحْوالًا مُتَبايِنَةً: مِنَ النُّطْفَةِ إلى العَلَقَةِ إلى المُضْغةِ إلى نَفْخِ الرُّوحِ، إلى الموتِ، إلى البعْثِ والنُّشُورِ."]],"20":[[0,3,"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","فأيُّ شَيءٍ يَمْنَعُهُم مِنَ الإيمانِ بَعْدَ ما وُضِّحَتْ لَهُمُ الآياتُ؟"]],"21":[[4,5,"لَا يَسۡجُدُونَ","لا يَخْضَعُونَ للهِ، ولا يُسَلِّمُونَ بِما جاءَ في القُرآنِ."]],"23":[[2,3,"بِمَا يُوعُونَ","بِما يَكْتُمُونَ مِن العِنادِ مَعَ عِلْمِهِم بأنّ ما جاءَ بهِ القرآنُ حَقٌّ."]],"24":[[0,0,"فَبَشِّرۡهُم","أي هَؤُلاءِ المكذِّبِينَ."]],"25":[[7,8,"غَيۡرُ مَمۡنُونِۭ","غَيرُ مَقْطُوعٍ ولا مَنقُوصٍ."]]}