{"1":[[0,0,"ٱلۡحَآقَّةُ","القِيامة الواقِعةُ حَقًّا الَّتِي يَتَحَقَّقُ فِيها الوعْدُ والوَعِيدُ."]],"3":[[0,1,"وَمَآ أَدۡرَىٰكَ","وأيُّ شَيءٍ عَرَّفَكَ حَقيقَةَ القيامَةِ؟"]],"4":[[3,3,"بِٱلۡقَارِعَةِ","بالقِيامَةِ الَّتِي تَقْرَعُ القُلُوبَ بِأهْوالِها."]],"5":[[3,3,"بِٱلطَّاغِيَةِ","بالصَّيحَةِ العَظِيمَةِ الَّتِي جاوزَتِ الحدَّ في شِدَّتِها."]],"6":[[4,4,"صَرۡصَرٍ","بارِدَةٍ."],[5,5,"عَاتِيَةٍ","شَدِيدَةٍ الهُبُوبِ."]],"7":[[0,1,"سَخَّرَهَا عَلَيۡهِمۡ","سَلَّطَها اللهُ عَلَيهِم."],[6,6,"حُسُومًا","مُتَتابِعَةً."],[10,10,"صَرۡعَىٰ","مَوْتى."],[12,13,"أَعۡجَازُ نَخۡلٍ","أُصُولُ نَخْلٍ."],[14,14,"خَاوِيَةٍ","خَرِبَةٍ مُتآكِلَةِ الأَجْوافِ."]],"8":[[4,4,"بَاقِيَةٍ","نَفْسٍ باقِيةٍ دُونَ هَلاكٍ."]],"9":[[4,4,"وَٱلۡمُؤۡتَفِكَـٰتُ","وأَهلُ قُرى قَوْمِ لُوطٍ الَّذِينَ انْقَلَبَتْ بِهم دِيارُهُم."],[5,5,"بِٱلۡخَاطِئَةِ","بِسَبَبِ الفَعْلَةِ المنكرَةِ مِنَ الكُفْرِ والفواحِشِ."]],"10":[[3,3,"فَأَخَذَهُمۡ","فَأَهْلَكَهُم."],[5,5,"رَّابِيَةً","بالِغةً في الشِّدَّةِ."]],"11":[[2,3,"طَغَا ٱلۡمَآءُ","جاوَزَ حَدَّهُ حتّى عَلا وارْتَفَعَ فَوْقَ كُلِّ شَيءٍ."],[4,4,"حَمَلۡنَـٰكُمۡ","حَمَلْناكُم وأنتُم في أصْلابِ آبائِكُم وأُمَّهاتِكُم."],[6,6,"ٱلۡجَارِيَةِ","السَّفِينَةِ الَّتِي تَجْرِي في الماءِ."]],"12":[[0,0,"لِنَجۡعَلَهَا","لِنَجْعَلَ الواقِعةَ الَّتِي نَجا فِيها المُؤمِنُونَ، وأُغْرِقَ فِيها الكافِرُونَ."],[2,2,"تَذۡكِرَةً","عِبْرةً وعِظَةً."],[3,3,"وَتَعِيَهَآ","وتَحْفَظَها."]],"13":[[3,3,"ٱلصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فيه المَلَكُ عِنْدَ قِيامِ السّاعةِ."]],"14":[[0,2,"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ","رُفِعَت عن أماكِنِها."],[3,5,"فَدُكَّتَا دَكَّةً وَٰحِدَةً","دُقَّتا دَقَّةً واحِدَةً."]],"15":[[1,2,"وَقَعَتِ ٱلۡوَاقِعَةُ","قامَتِ القِيامةِ."]],"16":[[0,0,"وَٱنشَقَّتِ","انْصَدَعَتْ مُتَشَقِّقَةً."],[4,4,"وَاهِيَةٌ","ضَعِيفَةٌ لا تَماسُكَ فِيها."]],"17":[[0,2,"وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَا","والملائِكَةُ على أطْرافِها."],[4,5,"عَرۡشَ رَبِّكَ","وهو سَرِيرُ الملْكِ الَّذِي تَحْمِلُه الملائِكةُ، واسْتَوى عَلَيهِ الرحمنُ، وهو أعْظَمُ المَخْلُوقاتِ، وهو سَقْفُ جَنَّةِ الفِرْدَوسِ."],[8,8,"ثَمَـٰنِيَةٌ","أي من الملائِكةِ العِظامِ."]],"18":[[1,1,"تُعۡرَضُونَ","أي: عَلى اللهِ."],[2,5,"لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةٌ","لا تَخْفى عَلى اللهِ نَفْسٌ خافِيةٌ مِنكُم."]],"19":[[6,6,"هَآؤُمُ","تعالَوا."]],"20":[[1,1,"ظَنَنتُ","أيْقَنْتُ."],[4,4,"حِسَابِيَهۡ","جَزائِي يومَ القيامةِ."]],"21":[[3,3,"رَّاضِيَةٍ","مَرْضِيَّةٍ."]],"22":[[2,2,"عَالِيَةٍ","مُرْتَفِعَةِ المكانِ والدَّرجاتِ."]],"23":[[0,0,"قُطُوفُهَا","ثِمارُها."],[1,1,"دَانِيَةٌ","قَرِيبَةُ التَّناوُلِ."]],"24":[[2,2,"هَنِيٓـَٔۢا","أكْلًا وشُرْبًا يَهْنأُ بِهما صاحِبُهُما."],[4,4,"أَسۡلَفۡتُمۡ","قدَّمْتُم."],[6,7,"ٱلۡأَيَّامِ ٱلۡخَالِيَةِ","أيّامِ الدُّنيا الماضِيةِ."]],"26":[[3,3,"حِسَابِيَهۡ","جَزائِي."]],"27":[[0,0,"يَـٰلَيۡتَهَا","ياليتَ الموتَةَ الَّتِي مِتُّها في الدُّنيا."],[2,2,"ٱلۡقَاضِيَةَ","القاطِعةَ لِأَمْرِي فلا أُبْعَثُ."]],"28":[[0,1,"مَآ أَغۡنَىٰ","ما نَفَعَ."]],"29":[[0,0,"هَلَكَ","غابَ."],[2,2,"سُلۡطَـٰنِيَهۡ","مُلْكِي."]],"30":[[1,1,"فَغُلُّوهُ","اجْعَلُوا القَيْدَ في عُنُقِه."]],"31":[[2,2,"صَلُّوهُ","أدْخِلُوهُ."]],"32":[[2,2,"سِلۡسِلَةٍ","مَجْمُوعِ حَلَقٍ مِن حَدِيدٍ داخِلٍ بَعْضُها فِي بَعْضٍ."],[3,3,"ذَرۡعُهَا","مِقْدارُ طُولِها بالذِّراعِ."],[6,6,"فَٱسۡلُكُوهُ","فَأَدْخِلُوه في السِّلْسِلَةِ."]],"34":[[0,1,"وَلَا يَحُضُّ","ولا يَحُثُّ."]],"35":[[3,3,"هَـٰهُنَا","يَومَ القِيامةِ."],[4,4,"حَمِيمٌ","قَرِيبٌ يدفعُ عنَه العذابَ."]],"36":[[4,4,"غِسۡلِينٍ","صَدِيدِ أهْلِ النّارِ وما يَسِيلُ مِن أجْسادِهِم."]],"37":[[3,3,"ٱلۡخَـٰطِـُٔونَ","المذْنِبُونَ أشَدَّ الذَّنبِ وهو الإشْراكُ."]],"38":[[2,3,"بِمَا تُبۡصِرُونَ","مِنَ الأرضِ والجِبالِ والبِحارِ والبَشَرِ والسَّمواتِ ونحوِها."]],"39":[[0,2,"وَمَا لَا تُبۡصِرُونَ","مِنَ الأرواحِ والملائِكةِ وأُمُورِ الآخِرَةِ."]],"40":[[1,3,"لَقَوۡلُ رَسُولٍ كَرِيمٍ","يَنْطِقُ بِهِ مُحَمَّدٌ ﷺ، والكَلامُ كَلامُ المُرسِلِ سُبْحانَهُ وتَعالى."]],"41":[[4,6,"قَلِيلًا مَّا تُؤۡمِنُونَ","تُؤْمِنُونَ إيمانا قَلِيلا لا يُنْجِيكُم مِن الخُلُود في النّارِ."]],"42":[[3,5,"قَلِيلًا مَّا تَذَكَّرُونَ","تَتَذَكَّرُونَ تَذَكُّرًا قَلِيلًا."]],"44":[[0,4,"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ","ولَو كَذَبَ عَلَينا بأنّا قُلْنا قَوْلًا لم نَقُلْه."]],"45":[[0,2,"لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ","لَأَخَذْناهُ بِقُوَّةٍ وقُدْرَةٍ."]],"46":[[3,3,"ٱلۡوَتِينَ","هو عِرْقٌ عُلِّقَ به القلبُ ويَسْقِي الجسدَ بالدَّمِ، فإذا قُطِعَ مات صاحِبُه."]],"47":[[4,5,"عَنۡهُ حَـٰجِزِينَ","يَمنعُونَ مِنهُ عِقابَنا."]],"48":[[1,1,"لَتَذۡكِرَةٌ","لَعِظَةٌ."]],"50":[[0,0,"وَإِنَّهُۥ","أي التَّكْذِيبَ."],[1,1,"لَحَسۡرَةٌ","لَنَدامةٌ عَظِيمَةٌ."]],"51":[[1,2,"لَحَقُّ ٱلۡيَقِينِ","الخبرُ الصِّدقُ."]],"52":[[0,0,"فَسَبِّحۡ","فَنَزِّهْ."]]}