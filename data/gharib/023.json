{"1":[[1,1,"أَفۡلَحَ","فازَ بِالنَّجاةِ مِنَ النّارِ."]],"2":[[4,4,"خَـٰشِعُونَ","خاضِعُونَ بِقُلوبِهِم وجَوارِحِهِم."]],"3":[[2,4,"عَنِ ٱللَّغۡوِ مُعۡرِضُونَ","أي: تارِكُونَ لِكُلِّ ما لا خَيرَ فِيه مِنَ العَبَثِ."]],"5":[[3,3,"حَـٰفِظُونَ","أي: ممّا حَرَّم الله مِنَ الزِّنى وسائرِ الفواحِشِ."]],"7":[[1,3,"ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ","طَلَبَ التَّمَتُّعَ بِغَيرِ ما أحَلَّه اللهُ."],[6,6,"ٱلۡعَادُونَ","المُجاوِزُونَ حُدَودَ اللهِ."]],"8":[[4,4,"رَٰعُونَ","حافِظُونَ."]],"11":[[2,2,"ٱلۡفِرۡدَوۡسَ","أعْلى مَنازِلِ الجنَّةِ وأَوسَطَها، وهو أفْضَلُها."]],"12":[[2,2,"ٱلۡإِنسَـٰنَ","آدَمَ."],[3,6,"مِن سُلَـٰلَةٍ مِّن طِينٍ","أي: مِن طِينٍ مأخُوذٍ مِن جَمِيعِ الأرضِ."]],"13":[[2,2,"نُطۡفَةً","هي مَنِيُّ الرَّجُلِ يَقْذِفُه في رَحِمِ امْرَأَتِه."],[4,5,"قَرَارٍ مَّكِينٍ","مُسْتَقِرٍّ مُتمَكِّنٍ، وهو رَحِمُ المرْأَةِ."]],"14":[[3,3,"عَلَقَةً","دَمًا أحْمرَ غَلِيظًا."],[6,6,"مُضۡغَةً","قِطْعَةَ لَحْمِ قَدْرَ ما يُمَضَغُ."],[10,12,"فَكَسَوۡنَا ٱلۡعِظَـٰمَ لَحۡمًا","أي: أنْبَتْنا على كُلِّ عَظْمٍ لَحْمًا مُناسِبًا."],[15,16,"خَلۡقًا ءَاخَرَ","مُباينًا لِلْأَوَّلِ، وذلِكَ بِنَفْخِ الرُّوحِ فيه بَعْدَ أنْ كانَ جمادًا."]],"16":[[4,4,"تُبۡعَثُونَ","تُحْيَوْن مِن قُبُورِكُم؛ لَلْحِسابِ."]],"17":[[3,4,"سَبۡعَ طَرَآئِقَ","سَبْعَ سَمَواتٍ جُعِلَ بعضُها فَوْقَ بَعْضٍ."]],"18":[[4,4,"بِقَدَرٍ","أي: بِمِقْدارِ الحاجَةِ."],[5,7,"فَأَسۡكَنَّـٰهُ فِي ٱلۡأَرۡضِ","أي: جَعَلْناه مُسْتَقِرًّا فِيها."],[9,11,"عَلَىٰ ذَهَابِۭ بِهِۦ","أي: على إذْهابِ هذا الماءِ."]],"19":[[3,3,"جَنَّـٰتٍ","بساتِينَ."]],"20":[[0,0,"وَشَجَرَةً","هي شَجَرَةُ الزَّيتُونِ."],[3,3,"طُورِ","هو جَبَلٌ ب «سَيْناءَ»."],[6,6,"بِٱلدُّهۡنِ","أي: مُلْتَبِسًا ثَمَرُها بالزَّيتِ."],[7,7,"وَصِبۡغٍ","إدامٍ يُغْمَسُ فيه الخُبْزُ."]],"21":[[4,4,"لَعِبۡرَةً","لَعِظَةً وآيةً على القُدْرَةِ والرَّحْمَةِ."]],"22":[[0,0,"وَعَلَيۡهَا","أي: وعلى الإبِلِ من الأنعامِ."],[2,2,"ٱلۡفُلۡكِ","السُّفُنِ."]],"24":[[1,1,"ٱلۡمَلَؤُاْ","أشرافُ القومِ وسادَتُهم."],[12,13,"أَن يَتَفَضَّلَ","أن يتَرَأَّسَ ويَشْرُفَ عليكم."]],"25":[[5,5,"جِنَّةٌ","أي: جُنُونٌ أو مَسٌّ من الجِنِّ."],[6,6,"فَتَرَبَّصُواْ","فانْتَظِرُوا."],[9,9,"حِينٍ","أي: وقتٍ مّا."]],"27":[[5,5,"بِأَعۡيُنِنَا","بِمَرْأىً مِنّا."],[9,9,"أَمۡرُنَا","أي: بِعَذابِهم بالطُّوفانِ."],[10,10,"وَفَارَ","نَبَعَ الماءُ وخَرَجَ بِقُوَّةٍ."],[11,11,"ٱلتَّنُّورُ","هو المكانُ الذي يُخْبزُ فِيه."],[12,12,"فَٱسۡلُكۡ","أدْخِلْ."],[14,15,"مِن كُلٍّ","أي: من كُلِّ الأَحْياءِ."],[16,16,"زَوۡجَيۡنِ","ذَكَرًا وأنْثى."],[21,23,"سَبَقَ عَلَيۡهِ ٱلۡقَوۡلُ","أي: سَبَق القضاءُ بِهلاكِه؛ لِكُفْرِه كزَوْجَتِكَ وابْنِكَ."]],"28":[[1,1,"ٱسۡتَوَيۡتَ","اعْتَدَلَتْ، أي: بَعْدَ رُكُوبِكَ في السَّفِينةِ."],[6,6,"ٱلۡفُلۡكِ","السَّفِينةِ."]],"29":[[3,3,"مُنزَلًا","إنْزِالًا أومَكانَ إنْزالٍ."]],"30":[[3,3,"لَـَٔايَـٰتٍ","عِبَرًا وحُجَجًا يُسْتَدَلُّ بها على سُنَنِ اللهِ في أمْثالِ هؤلاءِ مِنَ الكَفَرةِ والمُشْرِكِينَ."],[4,5,"وَإِن كُنَّا","وإننا كُنّا."],[6,6,"لَمُبۡتَلِينَ","لمُخْتَبِريِنَ الناسَ بهذه الآياتِ."]],"31":[[0,1,"ثُمَّ أَنشَأۡنَا","أحْدَثْنا وخَلَقْنا."],[4,5,"قَرۡنًا ءَاخَرِينَ","جِيلًا آخَرَ: هم قَومُ عادٍ أو قومُ ثمُودَ."]],"32":[[2,3,"رَسُولًا مِّنۡهُمۡ","هو هودٌ أو صالحٌ عليهما الصَّلاةُ والسَّلامُ."]],"33":[[1,1,"ٱلۡمَلَأُ","الأشْرافُ."],[7,8,"بِلِقَآءِ ٱلۡـَٔاخِرَةِ","أي: بِلقاءِ اللهِ يومَ القِيامةِ."],[9,9,"وَأَتۡرَفۡنَـٰهُمۡ","جَعَلْناهُم في تَرَفٍ وسَعَةٍ حتّى بَطِرُوا."]],"34":[[6,6,"لَّخَـٰسِرُونَ","أي: بِتَرْكِكُم آلِهَتَكم واتِّباعِكُم الرسولَ عليه السلام."]],"35":[[8,8,"مُّخۡرَجُونَ","أي: من قُبُورِكُم أحياءً."]],"36":[[0,0,"هَيۡهَاتَ","بَعُدَ، أي: ما تُوعدُونَ به أيُّها القومُ."],[2,3,"لِمَا تُوعَدُونَ","هو البعثُ بَعْدَ الموتِ."]],"37":[[7,9,"وَمَا نَحۡنُ بِمَبۡعُوثِينَ","أي: بَعْدَ المماتِ."]],"38":[[0,3,"إِنۡ هُوَ إِلَّا رَجُلٌ","هو هُودٌ أو صالحٌ عليهما الصَّلاةُ والسَّلامُ."],[4,4,"ٱفۡتَرَىٰ","اختَلَقَ."],[11,11,"بِمُؤۡمِنِينَ","بِمُصَدِّقِينَ."]],"40":[[1,2,"عَمَّا قَلِيلٍ","أي: بَعْدَ زَمَنٍ قَريبٍ."]],"41":[[1,1,"ٱلصَّيۡحَةُ","صَوْتٌ شَدِيدٌ مُهْلِكٌ."],[2,2,"بِٱلۡحَقِّ","أي: يَسْتَحِقُّونَ ذَلك العذابَ؛ لِكُفْرِهم وطُغْيانِهم."],[3,4,"فَجَعَلۡنَـٰهُمۡ غُثَآءً","أي: أمْواتًا كَغُثاءِ السَّيلِ الذي يَطْفُو على الماءِ."],[5,5,"فَبُعۡدًا","أي: عَن رَّحْمَةِ اللهِ."]],"42":[[1,1,"أَنشَأۡنَا","خلَقْنا وأوْجَدْنا."],[4,5,"قُرُونًا ءَاخَرِينَ","أقْوامًا آخَرِينَ مِثْلَ قَوْمِ لُوطٍ وشُعَيبٍ وأيُّوبَ ويونسَ عليهمُ الصَّلاةُ والسَّلامُ."]],"43":[[0,1,"مَا تَسۡبِقُ","ما تَتَقَدَّمُ."],[4,4,"أَجَلَهَا","الوَقْتَ المَحْدُودَ لهلاكِها."],[5,6,"وَمَا يَسۡتَـٔۡخِرُونَ","ولا يتأخَّرُونَ."]],"44":[[3,3,"تَتۡرَا","يَتْبَعُ بعضُهم بَعْضًا."],[14,14,"أَحَادِيثَ","أخْبارًا يَتَحَدَّثُ الناسُ بها للعِبْرَةِ وغيرِها."],[15,15,"فَبُعۡدًا","أي: بُعْدًا عَن رَّحْمَةِ اللهِ."]],"45":[[5,5,"بِـَٔايَـٰتِنَا","أي: بالمُعْجِزاتِ التِّسْعِ، وهي: العَصا واليدُ البيضاءُ والسِّنونَ المُجْدِبةُ ونَقْصُ الثَّمَراتِ، والطُّوفانُ والجَرادُ والقُمَّلُ والضَّفادِعُ والدَّمُ"],[6,7,"وَسُلۡطَـٰنٍ مُّبِينٍ","بُرْهانٍ مُظْهِرٍ لِلْحَقِّ."]],"46":[[2,2,"وَمَلَإِيْهِۦ","وأشْرافِ قَومِه."],[6,6,"عَالِينَ","مُسْتَعْلِينَ على النّاسِ بالبَغْيِ والظُّلْمِ."]],"47":[[5,6,"لَنَا عَـٰبِدُونَ","أي: مُنْقادُون اْنِقيادَ العَبِيدِ."]],"50":[[4,4,"ءَايَةً","علامةً على عَظِيمِ قُدْرَتِنا."],[5,5,"وَءَاوَيۡنَـٰهُمَآ","وجَعَلْنا لَهُما مأْوىً ومْنزِلًا."],[7,7,"رَبۡوَةٍ","بُقْعَةٍ مُرْتَفِعَةٍ."],[8,9,"ذَاتِ قَرَارٍ","أي: فيها أسْبابُ الاسْتِقْرارِ من الزَّرِعِ والثِّمارِ."],[10,10,"وَمَعِينٍ","وماءٍ جارٍ تَسْتَمْتِعُ بِرُؤيَتِه العُيونُ."]],"51":[[3,4,"مِنَ ٱلطَّيِّبَـٰتِ","مايُسْتَطابُ مِنَ الحَلالِ."]],"52":[[2,3,"أُمَّتُكُمۡ أُمَّةً","دِينُكُم دِينٌ واحِدٌ وهو دَعْوةُ جَمِيعِ الأنْبِياءِ إلى عِبادَةِ اللهِ وحْدَه لا شَرِيكَ لَه."]],"53":[[0,2,"فَتَقَطَّعُوٓاْ أَمۡرَهُم بَيۡنَهُمۡ","تَفرَّقَ الأتْباعُ في أمْرِ دِينِهِم."],[3,3,"زُبُرًا","قِطَعًا وفِرَقًا."],[8,8,"فَرِحُونَ","مَسْرُورُونَ."]],"54":[[0,0,"فَذَرۡهُمۡ","فاتْرُكْهُم."],[1,2,"فِي غَمۡرَتِهِمۡ","في غَفْلَتِهِم التي غَمَرَتْهُم وغَطَّتْهم مِن كُلِّ الجِهاتِ."],[3,4,"حَتَّىٰ حِينٍ","إلى وقْتِ نُزُولِ العَذاب بِهِم."]],"55":[[0,0,"أَيَحۡسَبُونَ","أيظُنُّونَ."],[2,2,"نُمِدُّهُم","نُعْطِيهِم اسْتِدْراجًا"]],"57":[[6,6,"مُّشۡفِقُونَ","وجِلُونَ وحَذِرُونَ."]],"60":[[1,3,"يُؤۡتُونَ مَآ ءَاتَواْ","يُعْطُونَ ما أعْطَوا مِنَ الصَّدقاتِ."],[5,5,"وَجِلَةٌ","خائِفَةٌ."]],"63":[[2,3,"فِي غَمۡرَةٍ","في غَفْلَةٍ."],[8,10,"مِّن دُونِ ذَٰلِكَ","مِن دُونِ الشِّركِ."]],"64":[[3,3,"مُتۡرَفِيهِم","مُنَعَّمِيهِم الذين أبْطَرَتْهُم النِّعَمُ."],[7,7,"يَجۡـَٔرُونَ","يَصْرُخُونَ مُسْتَغِيثِينَ."]],"65":[[0,1,"لَا تَجۡـَٔرُواْ","لا تَصْرُخُوا."]],"66":[[8,8,"تَنكِصُونَ","تَرْجِعُونَ وراءَكُم مُعْرِضِينَ عَنْ سَماعِ الآياتِ."]],"67":[[1,2,"بِهِۦ سَـٰمِرًا","أي: مُتَسامِرِينَ باللَّيلِ حَولَ الكَعْبَةِ."],[3,3,"تَهۡجُرُونَ","تَتَكَلَّمُونَ بِساقِطِ القولِ."]],"68":[[0,2,"أَفَلَمۡ يَدَّبَّرُواْ ٱلۡقَوۡلَ","أفلم يَتَفَكَّرُوا في القرآنِ."]],"70":[[3,3,"جِنَّةُۢ","جُنُونٌ."]],"71":[[11,11,"بِذِكۡرِهِمۡ","بالقرآنِ الذي فِيهِ عِزُّهُم وشَرفُهُم."]],"72":[[2,2,"خَرۡجًا","أجْرًا مِنَ المالِ."],[3,4,"فَخَرَاجُ رَبِّكَ","ثوابُ اللهِ وعَطاؤُه."]],"73":[[3,4,"صِرَٰطٍ مُّسۡتَقِيمٍ","دِينٍ قَوِيمٍ وهو الإسْلامُ."]],"74":[[7,7,"لَنَـٰكِبُونَ","لمائِلُونَ ومُنْحَرِفُونَ عَنْه."]],"75":[[5,6,"مِّن ضُرٍّ","مِن جَدْبٍ وجُوعٍ."],[7,7,"لَّلَجُّواْ","لَتَمادَوا واسْتَمَرُّوا."],[8,9,"فِي طُغۡيَـٰنِهِمۡ","في كُفْرِهِم وعِنادِهِم."],[10,10,"يَعۡمَهُونَ","يَتَرَدَّدُونَ."]],"76":[[3,4,"فَمَا ٱسۡتَكَانُواْ","فما خَضَعُوا وما أظْهَرُوا المَسْكَنَةَ."],[6,7,"وَمَا يَتَضَرَّعُونَ","وما يَتَذَلَّلُونَ للهِ تعالى بالدُّعاءِ."]],"77":[[11,11,"مُبۡلِسُونَ","آيِسُونَ مِن كُلِّ خَيرٍ، مُتَحَيِّرُونَ."]],"79":[[2,2,"ذَرَأَكُمۡ","خَلَقَكُم وبَثَّكُم."]],"80":[[5,7,"ٱخۡتِلَـٰفُ ٱلَّيۡلِ وَٱلنَّهَارِ","تَعاقُبُهُما وتَفاوُتُهُما."]],"81":[[5,5,"ٱلۡأَوَّلُونَ","آباؤهُم وأَسْلافُهُم المُتَقَدِّمون."]],"82":[[7,7,"لَمَبۡعُوثُونَ","أي: من قُبُورِنا أحْياءً."]],"83":[[10,11,"أَسَـٰطِيرُ ٱلۡأَوَّلِينَ","الأكاذِيبُ الَّتي كَتَبَها المُتَقَدِّمُونَ."]],"85":[[3,4,"أَفَلَا تَذَكَّرُونَ","أنَّ اللهَ قادِرٌ على البَعْثِ والنُّشُورِ."]],"87":[[3,4,"أَفَلَا تَتَّقُونَ","أفلا تَخافُونَ عِقابَ اللهِ على كُفْرِكُم وشِرْكِكُم؟"]],"88":[[3,5,"مَلَكُوتُ كُلِّ شَيۡءٍ","مالِكُ كُلِّ شَيءٍ والمُتَصَرِّفُ فِيه."],[7,7,"يُجِيرُ","يُغِيثُ ويَحْمِي غيرَه."],[8,10,"وَلَا يُجَارُ عَلَيۡهِ","ولا يُغِيثُ ولا يَحْمِي أحَدٌ منه أحَدًا."]],"89":[[3,4,"فَأَنَّىٰ تُسۡحَرُونَ","فَكَيفَ تُصْرَفَونَ عَنِ الحقِّ؟"]],"90":[[4,4,"لَكَـٰذِبُونَ","أي: في شِرْكِهِم وإنْكارِهِم البَعْثَ."]],"91":[[11,15,"لَّذَهَبَ كُلُّ إِلَـٰهِۭ بِمَا خَلَقَ","أي: لانْفَردَ كُلُّ مَعْبُودٍ بِمَخْلُوقاتِه."],[16,16,"وَلَعَلَا","ولَغَلَبَ."],[20,21,"سُبۡحَـٰنَ ٱللَّهِ","تَنَزَّه وتَقَدَّسَ."],[22,23,"عَمَّا يَصِفُونَ","أي: من كَذِبِهِم وبُهْتانِهِم بِأَنَّ له شَرِيكًا أوْ ولَدًَا."]],"92":[[2,2,"وَٱلشَّهَـٰدَةِ","وما يُشاهَدُ."]],"93":[[4,5,"مَا يُوعَدُونَ","أي: مِنَ العَذابِ."]],"97":[[5,5,"هَمَزَٰتِ","نَزَغاتٍ ووَساوِسَ."]],"98":[[3,4,"أَن يَحۡضُرُونِ","أي: مِن حُضُورِ الشَّياطِينِ في أُمُورِي."]],"99":[[7,7,"ٱرۡجِعُونِ","رُدُّوني إلى الدُّنيا."]],"100":[[8,9,"هُوَ قَآئِلُهَا","يَقُولُها باللِّسانِ ولا يَعْمَلُ بِمُقْتَضاها."],[12,12,"بَرۡزَخٌ","هو الحاجِزُ الَّذي بين الموتِ والبَعْثِ."]],"101":[[3,3,"ٱلصُّورِ","القَرْنِ الذي يُنفَخُ فيه للَبعْثِ."],[4,6,"فَلَآ أَنسَابَ بَيۡنَهُمۡ","أي: فلا تَنْفَعُهم أنْسابُهم، ولا يَتَفاخَرُونَ بها مِن هَوْلِ الموْقِفِ."],[8,9,"وَلَا يَتَسَآءَلُونَ","أي: لا يَسْأَلُ أحَدٌ أحَدًا."]],"102":[[1,2,"ثَقُلَتۡ مَوَٰزِينُهُۥ","أي: بِكَثْرةِ حسناتِهِ."],[5,5,"ٱلۡمُفۡلِحُونَ","الفائِزُونَ بالجنَّةِ والنَّجاةِ مِنَ النّارِ."]],"103":[[1,2,"خَفَّتۡ مَوَٰزِينُهُۥ","أي: قَلَّتْ أعْمالُه الصّالِحَةُ."],[5,6,"خَسِرُوٓاْ أَنفُسَهُمۡ","أي: ضَيَّعُوها."]],"104":[[0,0,"تَلۡفَحُ","تَحْرِقُ."],[5,5,"كَـٰلِحُونَ","عابِسُونَ تَقَلَّصَتْ شِفاهُهُم عن أسْنانِهِم؛ مِن إحْراقِ النّارِ وُجُوهَهُم."]],"105":[[2,2,"ءَايَـٰتِي","أي: آياتُ القُرآن."]],"106":[[4,4,"شِقۡوَتُنَا","هي المَلَذّاتُ والشَّهَواتُ التي كُتِبَتْ عَلَينا في سابِقِ عِلْمِكَ وساقَتْنا إلى الشِّقاءِ."]],"107":[[3,4,"فَإِنۡ عُدۡنَا","فَإن رَّجَعْنا إلى الضَّلالِ."]],"108":[[1,2,"ٱخۡسَـُٔواْ فِيهَا","امْكُثُوا في النّارِ أذِلّاءَ صاغِرِينَ."]],"110":[[1,1,"سِخۡرِيًّا","مَهْزُوءًا بهم."]],"113":[[7,7,"ٱلۡعَآدِّينَ","أي: المُتَمَكِّنِينَ مِن مَّعْرِفَةِ العَدَدِ مِنَ الملائِكَةِ أو مِنَ النّاسِ."]],"115":[[3,3,"عَبَثًا","لَعِبًا مِن غَيرِ فائِدةٍ ولاحِكْمَةٍ."]],"116":[[2,2,"ٱلۡمَلِكُ","الَّذي يَحِقُّ لَهُ المُلْكُ على الإطْلاقِ"],[3,3,"ٱلۡحَقُّ","الثّابِتُ الَّذي لا يَزُولُ."],[9,9,"ٱلۡعَرۡشِ","هو سَرِيرُ المُلْكِ الَّذي اسْتَوى عليه الرَّحمنُ، وتَحْمِلُه الملائِكةُ، وهو أعْظَمُ المَخْلُوقاتِ، وهو سَقْفُ الجنَّةِ."]]}