{"1":[[0,1,"لَآ أُقۡسِمُ","أحْلِفُ."]],"2":[[0,1,"وَلَآ أُقۡسِمُ","وأحْلِفُ."],[2,3,"بِٱلنَّفۡسِ ٱللَّوَّامَةِ","بالأنْفُسِ الَّتِي تَلُومُ صاحِبَها على تَرْكِ الطّاعاتِ وفِعْلِ السَّيئاتِ."]],"3":[[0,0,"أَيَحۡسَبُ","أيَظُنُّ."],[2,4,"أَلَّن نَّجۡمَعَ عِظَامَهُۥ","أن لَن نَّقَدِرَ على جَمْعِ عِظامِهِ بَعْدَ تَفَرُّقِها."]],"4":[[0,0,"بَلَىٰ","بَلْ سَنَجْمَعُها."],[3,5,"أَن نُّسَوِّيَ بَنَانَهُۥ","نُعيدَ خَلْقَ أصابِعِه أو أنامِلِه مُقَوَّمةً مُتْقَنةً."]],"5":[[3,3,"لِيَفۡجُرَ","لِيَبْقى على فجُورِهِ."],[4,4,"أَمَامَهُۥ","فِيما يَسْتَقْبِلُ مِن أيامِ عُمُرِهِ."]],"6":[[1,1,"أَيَّانَ","مَتى."]],"7":[[1,2,"بَرِقَ ٱلۡبَصَرُ","تَحَيَّر البَصَرُ ودُهِشَ فَزِعًا مما رَأى مِن أهْوالِ يَومِ القِيامَةِ."]],"8":[[0,1,"وَخَسَفَ ٱلۡقَمَرُ","وذَهبَ نُورُ القَمَرِ."]],"9":[[0,2,"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","في ذَهابِ ضَوْئِهِما."]],"11":[[0,0,"كَلَّا","ليسَ الأمرُ كَما تَتَمَنّاهُ."],[1,2,"لَا وَزَرَ","لا مَلْجأَ لَكَ ولا مَنجى."]],"12":[[3,3,"ٱلۡمُسۡتَقَرُّ","مَصِيرُ الخلائِقِ يومَ القِيامةِ."]],"13":[[3,5,"بِمَا قَدَّمَ وَأَخَّرَ","بِجَمِيعِ أعْمالِهِ: مِن خَيرٍ وشَرٍّ، ما قدَّمَهُ مِنها في حياتِهِ وما أخَّرَهُ."]],"14":[[2,4,"عَلَىٰ نَفۡسِهِۦ بَصِيرَةٌ","بَصِيرٌ بِنَفْسِهِ، يعلَمُ اسْتِحْقاقَهُ لِلْعِقابِ."]],"15":[[0,2,"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","حتّى في حِينِ إخْبارِه باعْتِذاراتِهِ الكاذِبةِ."]],"16":[[0,5,"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ","لا تُحَرِّكْ –أيُّها النَّبِيُّ- بالقُرآنِ لِسانَكَ حتّى نُزُولِ الوحْيِ؛ لِأَجْلِ أن تَتَعَجَّلَ بِحِفْظِهِ، مخافَةَ أن يَتَفَلَّتَ مِنكَ."]],"17":[[2,2,"جَمۡعَهُۥ","في صَدرِكَ."],[3,3,"وَقُرۡءَانَهُۥ","أن تَقْرَأَهُ بِلِسانِكَ مَتى شِئْتَ."]],"18":[[0,1,"فَإِذَا قَرَأۡنَـٰهُ","فَإذا قَرَأَهُ عَلَيكَ رَسُولُنا جِبْرِيلُ."],[2,3,"فَٱتَّبِعۡ قُرۡءَانَهُۥ","فاسْتمِعْ لِقِراءتِه وأَنْصِتْ لَهُ، ثُمُّ اقْرَأْهُ كَما أقْرَأَكَ إيّاهُ."]],"19":[[3,3,"بَيَانَهُۥ","تَوْضِيحَ ما أشْكَلَ عَلَيكَ فَهْمُهُ مِن مَّعانِيهِ وأَحْكامِهِ."]],"20":[[0,0,"كَلَّا","ليسَ الأمرُ كَما زَعَمْتُم أن لّا بَعْثَ ولا جَزاءَ."],[3,3,"ٱلۡعَاجِلَةَ","الدُّنيا وزِينَتَها."]],"22":[[0,0,"وُجُوهٌ","وُجُوهُ أهْلِ السَّعادةِ."],[1,1,"يَوۡمَئِذٍ","يومَ القيامةِ."],[2,2,"نَّاضِرَةٌ","مُشْرِقَةٌ مُتَأَلِّقَةٌ."]],"23":[[0,2,"إِلَىٰ رَبِّهَا نَاظِرَةٌ","تَنْظُرُ إلى خالِقِها فَتَتَمَتَّعُ بِذَلِكَ."]],"24":[[0,0,"وَوُجُوهٌ","ووُجُوهُ الأشْقِياءِ."],[1,1,"يَوۡمَئِذِۭ","يَومَ القِيامَةِ."],[2,2,"بَاسِرَةٌ","عابِسَةٌ كالِحَةٌ."]],"25":[[0,0,"تَظُنُّ","تَتَوقَّعُ."],[4,4,"فَاقِرَةٌ","مُصِيَبةٌ عَظِيمَةٌ."]],"26":[[0,0,"كَلَّآ","حَقًّا."],[2,3,"بَلَغَتِ ٱلتَّرَاقِيَ","وصَلَتْ الرُّوحُ إلى الحُلْقُومِ."]],"27":[[0,0,"وَقِيلَ","وقالَ بَعْضُ الحاضِرِينَ لِبَعْضٍ."],[1,2,"مَنۡۜ رَاقٍ","هَل مِن راقٍ يَرْقِيهِ ويَشْفيهِ؟"]],"28":[[0,0,"وَظَنَّ","وأَيقَنَ المُحْتَضِرُ."],[1,1,"أَنَّهُ","الأمرَ الَّذِي نَزَلَ بِهِ."],[2,2,"ٱلۡفِرَاقُ","فراقُ الدُّنيا؛ لِمُعايَنَتِهِ مَلائِكَةَ الموْتِ."]],"29":[[0,2,"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","واتَّصَلَتْ شِدَّةُ آخِر الدُّنيا بِشِدَّةِ أوّلِ الآخِرَةِ."]],"30":[[3,3,"ٱلۡمَسَاقُ","المرْجِعُ."]],"31":[[0,1,"فَلَا صَدَّقَ","فلا آمنَ الكافِرُ بالرَّسُولِ ﷺ والقرآنِ."]],"32":[[1,1,"كَذَّبَ","بالقرآنِ."],[2,2,"وَتَوَلَّىٰ","وأَعْرَضَ عَنِ الإيمانِ."]],"33":[[4,4,"يَتَمَطَّىٰٓ","يَتَبَخْتَرُ مُخْتالًا في مِشْيتِهِ."]],"34":[[0,1,"أَوۡلَىٰ لَكَ","هَلاكٌ لَكَ."],[2,2,"فَأَوۡلَىٰ","فَهَلاكٌ."]],"36":[[1,1,"ٱلۡإِنسَـٰنُ","هو المُنْكِرُ لِلْبَعثِ."],[4,4,"سُدًى","هَمَلًا لا يُحاسَبُ؟"]],"37":[[2,2,"نُطۡفَةً","ماءً قَلِيلًا."],[3,3,"مَّنِيٍّ","ماءِ الرَّجُلِ."],[4,4,"يُمۡنَىٰ","يُراقُ ويُصَبُّ في الأرحامِ."]],"38":[[2,2,"عَلَقَةً","قِطْعَةً مِن دمٍ جامِدٍ."],[4,4,"فَسَوَّىٰ","فعَدَّلَ صُورَتَهُ وقَوَّمَها في أحْسَنِ تَقْوِيمٍ."]],"39":[[2,2,"ٱلزَّوۡجَيۡنِ","الصِّنْفَينِ."]],"40":[[5,6,"يُحۡـِۧيَ ٱلۡمَوۡتَىٰ","يُعيدُ الخلْقَ بَعْدَ فَنائِهِم."]]}