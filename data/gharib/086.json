{"1":[[1,1,"وَٱلطَّارِقِ","أقْسَمَ اللهُ سُبحانَهُ بالنَّجْمِ الَّذِي يَطْرُقُ ليلًا."]],"2":[[0,1,"وَمَآ أَدۡرَىٰكَ","وأيُّ شَيءٍ أعْلَمَكَ؟."],[2,3,"مَا ٱلطَّارِقُ","ما عِظَمُ هذا النَّجمِ؟"]],"3":[[0,1,"ٱلنَّجۡمُ ٱلثَّاقِبُ","النَّجمُ المُضِيءُ المُتَوهِّجُ."]],"4":[[0,0,"إِن","ما."],[3,3,"لَّمَّا","إلّا."],[4,5,"عَلَيۡهَا حَافِظٌ","أُوكِلَ بها مَلَكٌ رَقِيبٌ يَحْفَظُ عَلَيها أعْمالَها."]],"6":[[2,3,"مَّآءٍ دَافِقٍ","مَنيٍّ مُنْصَبٍّ بِسُرعَةٍ في الرَّحِم."]],"7":[[3,3,"ٱلصُّلۡبِ","العَمُودِ العَظْميِّ في وسَطِ الظَّهْرِ، وهو ذُو الفِقْراتِ."],[4,4,"وَٱلتَّرَآئِبِ","جَمْع ترِيبةٍ، وهي عظامُ الصَّدرِ الَّتِي بَينَ التَّرقُوَتَينِ والثَّديينِ."]],"8":[[2,2,"رَجۡعِهِۦ","إعادَتِهِ إلى الحياةِ بَعْدَ الموتِ."]],"9":[[1,1,"تُبۡلَى","تُخْتَبرُ."],[2,2,"ٱلسَّرَآئِرُ","ما يُخْفيهِ الإنسانُ مِنَ العقائِدِ والأعْمالِ."]],"10":[[3,3,"قُوَّةٍ","يدفعُ بِها عَن نَّفْسِهِ."]],"11":[[1,2,"ذَاتِ ٱلرَّجۡعِ","ذاتِ المطَرِ الَّذِي يَرْجِعُ و يَتَكَرَّرُ."]],"12":[[2,2,"ٱلصَّدۡعِ","التَّشَقُّقِ بِما يَتَخلَّلُها مِن نَّباتٍ."]],"13":[[2,2,"فَصۡلٌ","فاصِلٌ بَيْنَ الحقِّ والباطِلِ."]],"14":[[2,2,"بِٱلۡهَزۡلِ","باللَّعِبِ والباطِل."]],"15":[[1,2,"يَكِيدُونَ كَيۡدًا","يُخْفونَ قَصْدَ الضُّرِّ ويُظْهِرُونَ خِلافَه."]],"16":[[0,1,"وَأَكِيدُ كَيۡدًا","لإظْهارِ الحقِّ."]],"17":[[0,1,"فَمَهِّلِ ٱلۡكَـٰفِرِينَ","فأنْظِرْهُم."],[2,2,"أَمۡهِلۡهُمۡ","أنْظِرْهُم."],[3,3,"رُوَيۡدَۢا","مُهلةً غيرَ طويلةٍ."]]}