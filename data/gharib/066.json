{"2":[[4,5,"تَحِلَّةَ أَيۡمَـٰنِكُمۡ","تَحْلِيلَ قَسَمِكُم بأَداءِ الكَفّارَةِ عَنْها، وهي إطْعامُ عَشْرَةِ مَساكِينَ أوْ كِسْوتُهُم أو تَحْرِيرُ رَقَبَةٍ، فَمَن لَمْ يَجِدْ فَصِيامُ ثَلاثَةِ أيّامٍ."],[7,7,"مَوۡلَىٰكُمۡ","ناصِرُكُم ومُتَوَلّي أُمُورِكُم."]],"3":[[10,11,"وَأَظۡهَرَهُ ٱللَّهُ","وأَطْلَعَهُ اللهُ عَلى إفْشائِها سِرَّهُ."],[13,14,"عَرَّفَ بَعۡضَهُۥ","أعْلَمَ حَفْصَةَ بَعْضَ ما أخْبرَتْ بِهِ."]],"4":[[5,5,"صَغَتۡ","مالَتْ."],[7,9,"وَإِن تَظَـٰهَرَا عَلَيۡهِ","وإن تَعاوَنا عَلَيهِ بِما يَسُوءُهُ."],[13,13,"مَوۡلَىٰهُ","وليُّهُ وناصِرُهُ."],[20,20,"ظَهِيرٌ","أعْوانٌ لَهُ عَلى مَن يُعادُونَهُ."]],"5":[[9,9,"مُسۡلِمَـٰتٍ","خاضِعاتٍ للهِ بالطّاعةِ."],[11,11,"قَـٰنِتَـٰتٍ","مُطِيعاتٍ للهِ."],[14,14,"سَـٰٓئِحَـٰتٍ","صائِماتٍ."]],"6":[[3,3,"قُوٓاْ","احْفَظُوا."],[14,15,"لَّا يَعۡصُونَ","لا يخالِفُونَ."]],"7":[[3,4,"لَا تَعۡتَذِرُواْ","لا تْلتَمِسُوا الأَعْذارَ."]],"8":[[3,3,"تُوبُوٓاْ","ارْجِعُوا عَن ذُنُوبِكُم."],[6,7,"تَوۡبَةً نَّصُوحًا","رُجُوعًا لا مَعْصِيَةَ بَعْدَهُ."],[8,9,"عَسَىٰ رَبُّكُمۡ","يَتَحَقَّقُ رَجاؤُكُم بِوَعْدِ ربِّكُم."],[11,11,"يُكَفِّرَ","يَمْحُوَ."],[17,18,"مِن تَحۡتِهَا","من تَحْتِ قُصُورِها وأَشْجارِها."],[17,18,"مِن تَحۡتِهَا","لا يَلْحِقُ بِهِم هَوانًا وذُلًّا بِسَبَبِ العَذابِ، بَلْ يُعْلي شَأْنَهُم."],[29,29,"يَسۡعَىٰ","يسِيرُ."],[30,31,"بَيۡنَ أَيۡدِيهِمۡ","أمامَهُم."],[35,35,"أَتۡمِمۡ","أدِمْ، أو زِدْ."]],"9":[[5,6,"وَٱغۡلُظۡ عَلَيۡهِمۡ","واسْتَعْمِلْ مَعَهُم الشِّدَّةَ في جِهادِهِم."],[7,7,"وَمَأۡوَىٰهُمۡ","ومَسْكَنُهُم الَّذِي يصيرُونَ إلَيهِ في الآخِرَةِ."],[9,10,"وَبِئۡسَ ٱلۡمَصِيرُ","وقَبُحَ ذَلِكَ المَرْجِعُ الَّذِي يَرْجِعُونَ إلَيهِ."]],"10":[[15,15,"فَخَانَتَاهُمَا","أي في الدِّين بالكُفْرِ."],[16,17,"فَلَمۡ يُغۡنِيَا","فَلَمْ يَدْفَعا."]],"12":[[4,4,"أَحۡصَنَتۡ","حَفِظَتْ."],[6,6,"فَنَفَخۡنَا","أمَرْنا جِبْرِيلَ أن يَنْفُخَ في جَيْبِ قَمِيصِها."],[16,16,"ٱلۡقَـٰنِتِينَ","المُطِيعِينَ للهِ."]]}