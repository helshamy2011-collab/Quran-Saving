{"1":[[4,6,"إِنَّ زَلۡزَلَةَ ٱلسَّاعَةِ","هي حَرَكَةُ الأرضِ مِن أسْفَلِها، واضْطِرابُها الذي يَحدُثُ عِنْدَ قِيامِ السّاعةِ."]],"2":[[2,2,"تَذۡهَلُ","تَغْفُلُ وتَنْسى."],[7,7,"تَضَعُ","تُسْقِطُ، وتُلْقِي جَنِينَها."],[14,14,"سُكَـٰرَىٰ","أي: كالسُّكارى؛ مِن شِدَّةِ الخوفِ."]],"3":[[3,3,"يُجَـٰدِلُ","يُخاصِمُ."],[11,11,"مَّرِيدٍ","مُتَمَرِّدٍ على اللهِ."]],"4":[[0,1,"كُتِبَ عَلَيۡهِ","قُدِّرَ على الشَّيطانِ."],[3,4,"مَن تَوَلَّاهُ","مَنِ اتَّخَذَه ولِيًّا وتَبِعَه."],[7,7,"وَيَهۡدِيهِ","ويُوصِلُه ويَسُوقُه."],[9,10,"عَذَابِ ٱلسَّعِيرِ","عذابِ جَهَنَّمَ الُموْقَدَةِ."]],"5":[[5,5,"رَيۡبٍ","شَكٍّ."],[13,14,"مِن نُّطۡفَةٍ","هي مَنِيُّ الرَّجُلِ يَقْذِفُه في رَحِم امْرَأتِه."],[17,17,"عَلَقَةٍ","الدَّم الأحْمَرِ الغَلِيظِ."],[20,20,"مُّضۡغَةٍ","قِطْعَةِ لَحْمٍ صَغِيرةٍ قَدْرَ ما يُمْضَغُ."],[21,21,"مُّخَلَّقَةٍ","ما وُلِد تامَّ الخَلْقِ."],[22,23,"غَيۡرِ مُخَلَّقَةٍ","ما تُسْقِطُه الرَّحِمُ قَبْلَ أن يَتِمَّ خَلْقُه."],[26,26,"وَنُقِرُّ","نُثَبِّتُ ونُبْقِي."],[46,48,"إِلَىٰٓ أَرۡذَلِ ٱلۡعُمُرِ","أخَسِّه، وهو الهَرمُ والخَرَفُ؛ حتى لا يَعْقِلَ."],[57,57,"هَامِدَةً","يابِسةً لا نَباتَ فيها."],[62,62,"ٱهۡتَزَّتۡ","تَحرَّكَتْ بالنَّباتِ تَتَفَتَّحُ عَنْه."],[63,63,"وَرَبَتۡ","زادَتْ وضاعفَتْ النَّباتَ بِنُزُولِ المطرِ."],[65,68,"مِن كُلِّ زَوۡجِۭ بَهِيجٍ","مِن كُلِّ صِنْفٍ حَسَنٍ ولونٍ مُسْتَحْسَنٍ."]],"7":[[8,11,"يَبۡعَثُ مَن فِي ٱلۡقُبُورِ","أي: يَبْعَثُهم أحْياءً."]],"8":[[3,3,"يُجَـٰدِلُ","يُخاصِمُ."]],"9":[[0,1,"ثَانِيَ عِطۡفِهِۦ","لاويًا عُنُقَه في استكبارٍ عَنِ الحَقِّ."],[9,9,"خِزۡيٌ","ذُلٌّ وهَوانٌ."]],"11":[[5,6,"عَلَىٰ حَرۡفٍ","على ضَعْفٍ وشَكٍّ."],[14,14,"فِتۡنَةٌ","ابْتِلاءٌ وشِدَّةٌ."],[15,17,"ٱنقَلَبَ عَلَىٰ وَجۡهِهِۦ","رَجَعَ عمّا كان عليه مِنَ الاسْتِقامَةِ."],[23,24,"ٱلۡخُسۡرَانُ ٱلۡمُبِينُ","الخَسارةُ العَظِيمَةُ والصَّفْقَةُ الخاسِرةُ."]],"13":[[7,7,"ٱلۡمَوۡلَىٰ","النَّصِيرُ."],[9,9,"ٱلۡعَشِيرُ","الصّاحِبُ المُعاشِرُ."]],"14":[[9,10,"مِن تَحۡتِهَا","أي: مِن تَحْتِ قُصُورِها."]],"15":[[10,10,"فَلۡيَمۡدُدۡ","فليَشْدُدْ."],[11,11,"بِسَبَبٍ","بحَبْلٍ."],[12,13,"إِلَى ٱلسَّمَآءِ","أي: سَماءِ بيتِه، وهو سَقْفُه."],[14,15,"ثُمَّ لۡيَقۡطَعۡ","أي: ذلك الحبلَ، لِيَخْنُقَ بِه نَفْسَه."],[19,19,"كَيۡدُهُۥ","مَكْرُه وحِيلَتُه."],[20,21,"مَا يَغِيظُ","ما يَجِدُ في نَفْسِه مِنَ الغَيظِ والغَضَبِ."]],"16":[[3,3,"بَيِّنَـٰتٍ","واضحاتٍ."]],"17":[[3,4,"ٱلَّذِينَ هَادُواْ","اليهُودَ."],[5,5,"ٱلصَّـٰبِـِٔينَ","هم قَومٌ باقُونَ على فِطْرَتِهم، ولا دِينَ مقرَّرَ لهم يَتَّبِعونه."],[7,7,"وَٱلۡمَجُوسَ","هم عَبَدَةُ النّارِ."],[12,13,"يَفۡصِلُ بَيۡنَهُمۡ","يَقْضِي بَيْنَهم."],[21,21,"شَهِيدٌ","رَقِيبٌ يُحصِي أعمالَ خَلْقِه كلَّها."]],"18":[[0,1,"أَلَمۡ تَرَ","ألم تَعلَمْ."],[4,5,"يَسۡجُدُ لَهُۥ","يَنْقادُ له ويَخْضَعُ."],[22,23,"حَقَّ عَلَيۡهِ","وجَبَ عليه."]],"19":[[1,1,"خَصۡمَانِ","فريقانِ: وهم المؤمِنُونَ والكُفّارُ."],[2,2,"ٱخۡتَصَمُواْ","اخْتَلَفُوا."],[3,4,"فِي رَبِّهِمۡ","في دِينِ ربِّهم."],[7,8,"قُطِّعَتۡ لَهُمۡ","جُعِلَتْ لَهم."],[16,16,"ٱلۡحَمِيمُ","الماءُ البالغُ نِهايةَ الحرارةِ."]],"20":[[0,1,"يُصۡهَرُ بِهِۦ","يُذابُ به."]],"21":[[1,1,"مَّقَـٰمِعُ","مَطارِقُ."]],"22":[[5,6,"مِنۡ غَمٍّ","مِنَ أجْلِ ما نالَهُم مِنَ الغَمِّ والكَرْبِ."]],"23":[[12,13,"يُحَلَّوۡنَ فِيهَا","يُلْبَسُونَ في الجنَّةِ الحُليَّ."],[15,15,"أَسَاوِرَ","مفردُه سِوارٌ: وهو ما يُلبَسُ في اليد للتزيُّنِ، ويُحِيطُ بالمِعْصَمِ."]],"24":[[0,0,"وَهُدُوٓاْ","هَداهُمُ اللهُ ووَفَّقَهم."],[1,4,"إِلَى ٱلطَّيِّبِ مِنَ ٱلۡقَوۡلِ","إلى كَلِمةِ التَّوحِيدِ أنْ لا إلَهَ إلا اللهُ."],[6,8,"إِلَىٰ صِرَٰطِ ٱلۡحَمِيدِ","الصِّراطِ المحمُودِ وهو الإسْلام."]],"25":[[12,12,"سَوَآءً","مُسْتَوِيًا."],[13,14,"ٱلۡعَـٰكِفُ فِيهِ","المقيمُ فيه المُلازمُ له."],[15,15,"وَٱلۡبَادِ","القادمُ إليه مِن غَيْرِ أهْلِه."],[19,19,"بِإِلۡحَادِۭ","بِعُدُولٍ عَنِ القَصْدِ."]],"26":[[1,2,"بَوَّأۡنَا لِإِبۡرَٰهِيمَ","أي: بَيَّنّا له."],[10,11,"وَطَهِّرۡ بَيۡتِيَ","أي: مِنَ الشِّركِ والكُفْرِ وسائِرِ النَّجاساتِ."]],"27":[[0,2,"وَأَذِّن فِي ٱلنَّاسِ","أي: أعْلِمْهم بإعْلانٍ."],[5,5,"رِجَالًا","جَمْعُ راجِلٍ، وهو مَن جاء يَمْشِي على رِجْلَيه."],[6,8,"وَعَلَىٰ كُلِّ ضَامِرٍ","أي: ورُكبانًا على كلِّ بعيرٍ مَهزولٍ أتْعَبَه طولُ السَّفَرِ."],[12,13,"فَجٍّ عَمِيقٍ","طَرِيقٍ بَعِيدٍ."]],"28":[[7,8,"أَيَّامٍ مَّعۡلُومَـٰتٍ","أيّامٍ مُعَيَّنةٍ هي: عاشرُ ذِي الحِجَّةِ وثلاثةُ أيّامٍ بَعْدَه."],[9,14,"عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلۡأَنۡعَـٰمِ","أي: على ذَبْحِ ما رَزَقَهُم مِن بهِيَمَةِ الأنعامِ، وهي: الإبِلُ والَبَقرُ والغَنَمُ."],[18,19,"ٱلۡبَآئِسَ ٱلۡفَقِيرَ","هو الفقيرُ الذي اشْتَدَّ فَقْرُه."]],"29":[[0,2,"ثُمَّ لۡيَقۡضُواْ تَفَثَهُمۡ","ثم لِيُزِيلُوا وسَخَهم بعد خُرُوجِهِم مِن إحْرامِهِم."],[3,4,"وَلۡيُوفُواْ نُذُورَهُمۡ","ولْيُوَفُّوا بما أوجَبُوه على أنْفُسِهم مِن أعْمالِ البِرِّ في الحجِّ وغيرِه."],[6,7,"بِٱلۡبَيۡتِ ٱلۡعَتِيقِ","وهو الكَعْبةُ، وقد أعْتَقَها اللهُ مِن تَسَلُّطِ الجبّارينَ عَلَيها."]],"30":[[3,4,"حُرُمَـٰتِ ٱللَّهِ","جَمْعُ حُرْمَةٍ، وهي ما وجَبَ القيامُ به، وحَرُمَ التَّفْرِيطُ فيه."],[18,20,"ٱلرِّجۡسَ مِنَ ٱلۡأَوۡثَـٰنِ","أي: مِن عِبادَةِ الأوثانِ، فإنها رِجْسٌ."],[23,23,"ٱلزُّورِ","الكذِبِ والافْتِراءِ على اللهِ."]],"31":[[0,1,"حُنَفَآءَ لِلَّهِ","مُسْتَقِيمِينَ على الحقِّ."],[9,9,"خَرَّ","سَقَطَ."],[12,12,"فَتَخۡطَفُهُ","فَتَسْلُبُه وتَذْهبُ بِه."],[15,16,"تَهۡوِي بِهِ","تَقْذِفُه وتَرْمِي بِه."],[20,20,"سَحِيقٍ","بَعِيدٍ."]],"32":[[3,4,"شَعَـٰٓئِرَ ٱللَّهِ","هي معالمُ دِينِه، ومِنها شَعِيرةُ الحَجِّ."]],"33":[[3,5,"إِلَىٰٓ أَجَلٍ مُّسَمًّى","وهو وقتُ ذَبْحِها."],[6,7,"ثُمَّ مَحِلُّهَآ","أي: حيثُ يَحِلُّ ذَبْحُها."]],"34":[[3,3,"مَنسَكًا","ذَبْحًا يَذْبَحُونَه أو عِيدًا أو حَجًّا يَحُجُّونَه."],[7,9,"عَلَىٰ مَا رَزَقَهُم","على ذَبْحِ ما رَزَقَهُم."],[19,19,"ٱلۡمُخۡبِتِينَ","الخاشِعِينَ المخْلصِيِنَ."]],"35":[[4,4,"وَجِلَتۡ","خافتْ."]],"36":[[0,0,"وَٱلۡبُدۡنَ","وهي الإبِلُ والبَقَرُ مما يُجْزِئُ ذَبْحُه عَنْ سَبْعةٍ."],[13,13,"صَوَآفَّ","أي: قائِماتٍ، بأن تُقامَ على قَوائِمِها الأرْبَعِ، ثم تُعْقَلَ إحْدى يَدَيها."],[15,16,"وَجَبَتۡ جُنُوبُهَا","سقَطَتْ جُنوبُها على الأرضِ."],[20,20,"ٱلۡقَانِعَ","الفقيرَ المُتَعَفِّفَ عَنِ السُّؤالِ."],[21,21,"وَٱلۡمُعۡتَرَّ","الُمحتاجَ الَّذي يَسْأَلُ."]],"37":[[8,9,"ٱلتَّقۡوَىٰ مِنكُمۡ","إخْلاصُكم لله وخَشْيَتُكُم مِنه."]],"38":[[2,2,"يُدَٰفِعُ","يَدْفْعُ ويَرُدُّ."],[11,11,"خَوَّانٍ","كثيرِ الخِيانَةِ."],[12,12,"كَفُورٍ","جَحُودٍ لِنِعَمِ اللهِ."]],"39":[[0,1,"أُذِنَ لِلَّذِينَ","أي: شُرِعَ لهم القِتالُ."]],"40":[[18,18,"صَوَٰمِعُ","مَعابدُ رُهْبانِ النَّصارى."],[19,19,"بِيَعٌ","كَنائِسُ النَّصارى."],[20,20,"صَلَوَٰتٌ","كنائِسُ اليهُودِ."]],"44":[[0,1,"وَأَصۡحَـٰبُ مَدۡيَنَ","قومُ شُعَيبٍ عليه الصَّلاة والسَّلامُ."],[4,4,"فَأَمۡلَيۡتُ","فأَمهَلْتُ."],[6,7,"ثُمَّ أَخَذۡتُهُمۡ","أي: بالعقاب فَأَهْلَكْتُهم."],[10,10,"نَكِيرِ","أي: إنْكارِي عَلَيهم."]],"45":[[0,0,"فَكَأَيِّن","فَكَثِيرًا."],[5,5,"ظَالِمَةٌ","أي: أهلُها بالكُفْرِ والشِّركِ."],[7,9,"خَاوِيَةٌ عَلَىٰ عُرُوشِهَا","ساقِطةٌ على سُقُوفِها."],[10,11,"وَبِئۡرٍ مُّعَطَّلَةٍ","وبِئْرٍ مَهْجُورَةٍ بِمَوْتِ أهْلِها."],[12,13,"وَقَصۡرٍ مَّشِيدٍ","وقَصْرٍ مُجَصَّصٍ مَرْفُوعِ البُنْيانِ، خَرِبَ بِمَوتِ أهْلِه."]],"47":[[12,13,"مِّمَّا تَعُدُّونَ","أي: مما تَحْسُبُونَ من سِنِي الدُّنيا."]],"48":[[3,4,"أَمۡلَيۡتُ لَهَا","أمْهَلْتُها."],[6,6,"ظَالِمَةٌ","أي: أهلُها بالكفرِ والشِّركِ."],[7,8,"ثُمَّ أَخَذۡتُهَا","أي: أهْلَكْتُها."],[10,10,"ٱلۡمَصِيرُ","المرْجِعُ."]],"50":[[6,7,"وَرِزۡقٌ كَرِيمٌ","ورِزْقٌ حَسَنٌ لا يَنْقَطِعُ، وهو الجنَّةُ."]],"51":[[0,3,"وَٱلَّذِينَ سَعَوۡاْ فِيٓ ءَايَـٰتِنَا","والذين اجْتَهَدُوا في مُحارَبةِ القرآنِ وإبْطالِ آياتِه وحُجَجِه."],[4,4,"مُعَـٰجِزِينَ","ظانِّينَ أنّهم يُعْجِزُونَنا ويَغْلِبُوننا."],[6,7,"أَصۡحَـٰبُ ٱلۡجَحِيمِ","أهلُ النارِ الموقَدَةِ."]],"52":[[10,10,"تَمَنَّىٰٓ","قَرَأَ ما نَزَلَ عَلَيهِ."],[11,14,"أَلۡقَى ٱلشَّيۡطَـٰنُ فِيٓ أُمۡنِيَّتِهِۦ","أي: ألْقى في قِراءتِه الوَساوِسَ والشُّبُهاتِ."],[15,16,"فَيَنسَخُ ٱللَّهُ","أي: فَيُزِيلُه."],[17,19,"مَا يُلۡقِي ٱلشَّيۡطَـٰنُ","أي: ما يُلْقِيهِ مِن وساوِسَ وشُبُهاتٍ."],[20,23,"ثُمَّ يُحۡكِمُ ٱللَّهُ ءَايَـٰتِهِۦ","ثُمَّ يُثَبِّتُ اللهُ آياتِه كما نَزَلَتْ ويَحفْظُها مِنَ التَّبْدِيل."]],"53":[[4,4,"فِتۡنَةً","ابْتلِاءً واخْتِبارًا."],[8,8,"مَّرَضٌ","شكٌّ ونِفاقٌ."],[9,10,"وَٱلۡقَاسِيَةِ قُلُوبُهُمۡ","أي: غَلُظَتْ قُلُوبُهم عَن قَبُولِ الحَقِّ."],[14,15,"شِقَاقِۭ بَعِيدٍ","خِلافٍ بَعِيدٍ عَنِ الصَّوابِ."]],"54":[[4,7,"أَنَّهُ ٱلۡحَقُّ مِن رَّبِّكَ","أنّ القرآنَ هو الحقُّ النازِلُ مِن عِنْدِ اللهِ عَلَيكَ."],[10,11,"فَتُخۡبِتَ لَهُۥ","فَتَخْشَعَ لَهُ وتَخْضَعَ."]],"55":[[4,6,"فِي مِرۡيَةٍ مِّنۡهُ","في شَكٍّ مِن هَذا القُرآنِ."],[10,10,"بَغۡتَةً","فَجْأةً."],[14,15,"يَوۡمٍ عَقِيمٍ","هو يومُ القيامةِ الَّذي لا خيرَ فيه للكفارِ، ولا يومَ بَعْدَه."]],"56":[[0,0,"ٱلۡمُلۡكُ","السُّلْطانُ القاهِرُ."],[1,1,"يَوۡمَئِذٍ","أي: يومَ القيامةِ."]],"57":[[7,7,"مُّهِينٌ","مُخْزٍ ومُذِلٌّ."]],"58":[[11,12,"رِزۡقًا حَسَنًا","وهو الجنَّةُ."]],"59":[[1,1,"مُّدۡخَلًا","مكانَ دخولٍ، وهو الجنَّةُ."]],"60":[[7,9,"ثُمَّ بُغِيَ عَلَيۡهِ","ثُمَّ اعْتُدِيَ عليه بالظُّلْمِ."]],"61":[[3,3,"يُولِجُ","يُدخِلُ."]],"62":[[6,9,"مَا يَدۡعُونَ مِن دُونِهِۦ","ما يَعْبُدُه الُمشْرِكُون مِن دُونِ اللهِ مِنَ الأصْنامِ وغَيرِها."],[15,15,"ٱلۡعَلِيُّ","أي: على خَلْقِه ذاتًا وقدْرًا وقَهْرًا."]],"63":[[7,7,"مَآءً","مَطَرًا."]],"64":[[11,11,"ٱلۡحَمِيدُ","المحمودُ المُسْتَحِقُّ لِلْحمْدِ في كُلِّ حالٍ."]],"65":[[4,4,"سَخَّرَ","ذَلَّلَ."],[9,9,"ٱلۡفُلۡكَ","السُّفُنَ."],[14,15,"يُمۡسِكُ ٱلسَّمَآءَ","يَحْفظُ السَّماءَ."]],"66":[[9,9,"لَكَفُورٌ","لَجَحُودٌ."]],"67":[[3,3,"مَنسَكًا","شَرِيعةً خاصَّةً."],[4,5,"هُمۡ نَاسِكُوهُ","هم عامِلُونَ به."],[6,9,"فَلَا يُنَـٰزِعُنَّكَ فِي ٱلۡأَمۡرِ","فلا يَحِقُّ لَهُم أنْ يخاصِمُوكَ في شَرِيعَتِكَ."],[15,16,"هُدًى مُّسۡتَقِيمٍ","دِينٍ قَوِيمٍ لا اعْوِجاجَ فِيه."]],"70":[[11,12,"فِي كِتَـٰبٍ","أي: في اللَّوحِ المحْفُوظِ."]],"71":[[8,8,"سُلۡطَـٰنًا","حُجَّةً وبُرْهانًا."],[15,15,"لِلظَّـٰلِمِينَ","للمُشْرِكِينَ."]],"72":[[10,10,"ٱلۡمُنكَرَ","الأمرَ الذي يُنْكَرُ مِنَ العُبُوسِ والغَضَبِ والكَراهَةِ."],[12,12,"يَسۡطُونَ","يَبْطِشُونَ."],[19,21,"بِشَرٍّ مِّن ذَٰلِكُمُ","بِشَرٍّ مِن غَيظِكُم على مَن يَتْلُو عليكُم آياتِ اللهِ."],[27,28,"وَبِئۡسَ ٱلۡمَصِيرُ","ساءَ وقَبُحَ المكانُ الذي يَرجِعُونَ إليه."]],"73":[[4,5,"فَٱسۡتَمِعُواْ لَهُۥٓ","أي: سَماعَ تَدَبُّرٍ."],[8,8,"تَدۡعُونَ","تَعْبُدُونَ."],[14,14,"ذُبَابًا","ذُبابةً واحِدةً مَعَ صِغَرِها."],[18,19,"وَإِن يَسۡلُبۡهُمُ","أي: وإن يَأْخُذِ الذُّبابُ شيئًا مِن هَذهِ المعْبُوداتِ."],[22,24,"لَّا يَسۡتَنقِذُوهُ مِنۡهُ","أي: لا يَقْدِرُوا -لِعَجْزِهِم- على اسْتِرْدادِ ما أُخِذَ مِنهم."],[26,26,"ٱلطَّالِبُ","هو المَعبُودُ مِن دُونِ اللهِ."],[27,27,"ٱلۡمَطۡلُوبُ","هو الذُّبابُ."]],"74":[[0,4,"مَا قَدَرُواْ ٱللَّهَ حَقَّ قَدۡرِهِۦٓ","ما عَظَّمَ المشْرِكُونَ اللهَ تَعالى حقَّ تَعْظِيمِهِ."]],"75":[[1,1,"يَصۡطَفِي","يَخْتارُ."]],"76":[[1,3,"مَا بَيۡنَ أَيۡدِيهِمۡ","أي: أعْمالَهم التي عَمِلُوها."],[4,5,"مَا خَلۡفَهُمۡ","أي: أعْمالَهم التي سَيَعْمَلُونَها."]],"78":[[0,2,"وَجَـٰهِدُواْ فِي ٱللَّهِ","أي: في سَبِيِلهِ لإعْلاءِ كَلِمَتِهِ."],[5,6,"هُوَ ٱجۡتَبَىٰكُمۡ","اصْطَفاكُم اللهُ لِحَمْلِ دِينِه."],[12,13,"مِنۡ حَرَجٍ","مِن ضِيقٍ ومَشَقَّةٍ بتكْلِيفٍ يَشُقُّ عَلَيكُم."],[20,21,"مِن قَبۡلُ","أي: في الكُتُبِ المُنَزَّلةِ السّابِقَةِ."],[29,31,"شُهَدَآءَ عَلَى ٱلنَّاسِ","أي: على الأممِ السّابَقَةِ أنّ رُسُلَهم قد بَلَّغَتْهم رِسالاتِ ربِّهم."],[36,37,"وَٱعۡتَصِمُواْ بِٱللَّهِ","أي: اجْعَلُوه عِصْمةً لكم مما تَحْذَرُونَ، والتَجِئُوا إليه في جميعِ أُمُورِكُم."],[38,39,"هُوَ مَوۡلَىٰكُمۡ","هو ناصِرُكُم، ومُتَوَلِّي أمورِكُم."]]}