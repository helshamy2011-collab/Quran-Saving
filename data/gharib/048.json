{"1":[[1,2,"فَتَحۡنَا لَكَ","قَضَينا لَكَ."],[4,4,"مُّبِينًا","عَظِيما."]],"2":[[13,13,"صِرَٰطًا","طَرِيقًا."]],"4":[[3,3,"ٱلسَّكِينَةَ","الطُّمأنِينَةَ."]],"6":[[7,8,"ظَنَّ ٱلسَّوۡءِ","الظَّنَّ السَّيِّئَ."],[10,11,"دَآئِرَةُ ٱلسَّوۡءِ","الشِّدَّةُ المُحِيطَةُ الَّتِي تسُوءُهُم."],[15,15,"وَلَعَنَهُمۡ","وطَردَهُمْ مِن رحْمَتِهِ."]],"9":[[3,3,"وَتُعَزِّرُوهُ","وتَنْصُروا الله بِنصْرِ دِينِهِ."],[4,4,"وَتُوَقِّرُوهُ","وتُعَظِّمُوا اللهَ."],[6,6,"بُكۡرَةً","أوَّلَ النَّهارِ."],[7,7,"وَأَصِيلًا","آخِرَ النَّهارِ."]],"10":[[2,2,"يُبَايِعُونَكَ","يُعاهِدُونَكَ على الطّاعةِ."],[11,11,"نَّكَثَ","نَقَضَ بَيْعَتَهُ."],[13,15,"يَنكُثُ عَلَىٰ نَفۡسِهِۦ","يَعُودُ وبالُ ذلِكَ عَلى نَفْسِهِ."]],"11":[[2,2,"ٱلۡمُخَلَّفُونَ","الَّذِينَ تَخَلَّفُوا عَنِ الخُروجِ مَعَكَ إلى مكَّةَ."]],"12":[[4,4,"يَنقَلِبَ","يَرْجِعَ."],[19,19,"بُورًا","هَلْكى."]],"13":[[6,6,"أَعۡتَدۡنَا","أعْدَدْنا."],[8,8,"سَعِيرًا","نارًا مُؤَجَّجَةً."]],"15":[[5,5,"مَغَانِمَ","غَنائِمِ خَيبَرَ."],[7,7,"ذَرُونَا","اتْرُكُونا."],[12,13,"كَلَـٰمَ ٱللَّهِ","وعْدَهُ لَكُم بِغنائِمِ خَيبَرَ، واخْتِصاصِها بِمَن شَهِدَ الحُدَيبِيَةَ."]],"16":[[7,8,"أُوْلِي بَأۡسٍ","أصْحابِ قُوَّةٍ."],[19,20,"وَإِن تَتَوَلَّوۡاْ","تُعْرِضُوا."]],"17":[[3,3,"حَرَجٌ","إثْمٌ في تَخَلُّفِهِ عَنِ الجِهادِ."]],"18":[[6,6,"يُبَايِعُونَكَ","يُعاهِدُونَكَ عَلى الطّاعِة والنُّصْرَةِ."],[14,14,"ٱلسَّكِينَةَ","الطُّمأنِينةَ."],[16,16,"وَأَثَـٰبَهُمۡ","جازاهُم."],[17,18,"فَتۡحًا قَرِيبًا","هو فَتْحُ «خَيْبَرَ»."]],"20":[[7,7,"هَـٰذِهِۦ","غَنائِمَ خَيبرَ."],[8,8,"وَكَفَّ","ومَنَعَ."]],"21":[[0,0,"وَأُخۡرَىٰ","وعَدَكُم رَبُّكُم فَتْحَ بَلْدَةٍ أُخْرى وهي مكَّةُ."]],"23":[[0,1,"سُنَّةَ ٱللَّهِ","سَنَّ اللهُ ذَلِكَ سُنَّةً أي: جَعَلَهُ عادَةً لَهُ يَنْصُرُ المؤمِنينَ إذا نَصَرَوا دِينَهُ."]],"24":[[7,8,"بِبَطۡنِ مَكَّةَ","الحُدَيبِيَةِ."],[12,13,"أَظۡفَرَكُمۡ عَلَيۡهِمۡ","أيَّدكُم عَلَيهِم، ومَكَّنَكُم مِن رِّقابِهِم."]],"25":[[7,7,"وَٱلۡهَدۡيَ","ما يُهْدى إلى الكَعْبَةِ مِنَ الأنْعامِ، أي: حَبَسُوا الهَدْيَ."],[8,8,"مَعۡكُوفًا","مَحْبُوسًا."],[11,11,"مَحِلَّهُۥ","مَكانَ حِلِّ نَحْرِه، وهو الحَرَمُ."],[20,20,"تَطَـُٔوهُمۡ","تُهْلِكُوهُم."],[23,23,"مَّعَرَّةُۢ","إثْمٌ وعَيبٌ وغَرامَةُ دِيَةٍ."],[32,33,"لَوۡ تَزَيَّلُواْ","لو تَمَيَّزُوا وفارَقُوا."]],"26":[[1,1,"جَعَلَ","وضَعَ."],[6,6,"ٱلۡحَمِيَّةَ","الأَنفَةَ الَّتِي لا مُوجِبَ لَها."],[7,8,"حَمِيَّةَ ٱلۡجَـٰهِلِيَّةِ","الحَمِيّةَ المنْسُوبةَ إلى الجاهِليَّةِ لحَقارَتِها وشَناعَتِها."],[11,11,"سَكِينَتَهُۥ","الثَّباتَ والطُّمأنِينَةَ."],[16,16,"وَأَلۡزَمَهُمۡ","جَعَلَها لازِمةً لَهُم لا يُفارِقُونَها."],[17,18,"كَلِمَةَ ٱلتَّقۡوَىٰ","قولَ: لا إلَه إلّا اللهُ."]],"27":[[1,4,"صَدَقَ ٱللَّهُ رَسُولَهُ ٱلرُّءۡيَا","صَدَّقَ اللهُ رَسُولَهُ في الرُّؤيا."],[26,27,"فَتۡحًا قَرِيبًا","هو فَتْحُ خَيبرَ."]],"28":[[4,4,"بِٱلۡهُدَىٰ","بِالبَيانِ الواضِحِ."],[5,6,"وَدِينِ ٱلۡحَقِّ","دِينِ الإسْلامِ."],[7,7,"لِيُظۡهِرَهُۥ","ليُعْلِيَهُ ويُشَرِّفَهُ."],[13,13,"شَهِيدًا","شاهِدا."]],"29":[[18,18,"سِيمَاهُمۡ","عَلامةُ طاعَتِهِم للهِ."],[21,23,"مِّنۡ أَثَرِ ٱلسُّجُودِ","نُورٍ وسَمْتٍ حَسَنٍ."],[25,25,"مَثَلُهُمۡ","صِفَتُهُم وحالَتُهُم العجِيبَةُ."],[33,33,"شَطۡـَٔهُۥ","فُرُوعَهُ وفِراخَهُ."],[34,34,"فَـَٔازَرَهُۥ","فَقَوّى الفَرْعُ أصْلَهُ."],[35,35,"فَٱسۡتَغۡلَظَ","غَلُظَ غِلَظًا شَدِيدًا في نَوعِهِ."],[38,38,"سُوقِهِۦ","جَمعُ ساقٍ، وهو الأصْلُ الَّذِي تَخرُجُ فِيهِ السَّنابلُ والأغْصانُ."]]}