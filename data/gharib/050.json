{"1":[[0,0,"قٓ","سَبَقَ الكلامُ على الحُروفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البقرةِ."],[2,2,"ٱلۡمَجِيدِ","ذي المجْدِ والشَّرَفِ."]],"2":[[10,10,"عَجِيبٌ","مُسْتَغْرَبٌ يُتَعَجَّبُ مِنهُ."]],"3":[[5,5,"رَجۡعُۢ","بَعْثٌ."]],"4":[[3,4,"تَنقُصُ ٱلۡأَرۡضُ","تُفْنِي مِن أجْسامِهِم."],[8,8,"حَفِيظُۢ","مَحفُوظٌ."]],"5":[[8,8,"مَّرِيجٍ","مُخْتَلِطٍ مُضْطَرِبٍ."]],"6":[[11,11,"فُرُوجٍ","شُقُوقٍ وُصُدُوعٍ."]],"7":[[1,1,"مَدَدۡنَـٰهَا","بَسَطْناها."],[4,4,"رَوَٰسِيَ","جِبالًا ثَوابِتَ."],[9,9,"زَوۡجِۭ","نَوْعٍ وجِنْسٍ."],[10,10,"بَهِيجٍ","حَسَنِ المنْظَر."]],"8":[[0,0,"تَبۡصِرَةً","تَجْعَلُ المرءَ مُبْصِرًا."],[1,1,"وَذِكۡرَىٰ","تُذَكِّرُ النّاسِي."],[4,4,"مُّنِيبٍ","رَجّاعٍ إلى اللهِ."]],"9":[[4,4,"مُّبَـٰرَكًا","كَثِيرَ الخيَرِ والمنافِعِ."],[8,9,"وَحَبَّ ٱلۡحَصِيدِ","وحَبَّ الزَّرْعِ المحْصُودِ."]],"10":[[1,1,"بَاسِقَـٰتٍ","مُرْتَفِعاتٍ."],[3,3,"طَلۡعٌ","هُو أوَّلُ ما يَظْهَرُ مِن ثَمَرِ التَّمْرِ وهُو غِلافُ العُنْقُودِ."],[4,4,"نَّضِيدٌ","مَنضُودٌ، مُصَفَّفٌ بعْضُهُ فَوْقَ بَعْضٍ."]],"11":[[5,5,"مَّيۡتًا","أجْدَبَتْ وقَحَطَتْ."],[6,6,"كَذَٰلِكَ","كَما أحْيا اللهُ هَذِه الأَرْضَ الميتَةَ."],[7,7,"ٱلۡخُرُوجُ","خَرُوجُ النّاسِ يَومَ البعْثِ."]],"12":[[5,5,"ٱلرَّسِّ","البِئْرِ."]],"14":[[0,1,"وَأَصۡحَـٰبُ ٱلۡأَيۡكَةِ","أصْحابُ الشَّجَرِ المُلْتَفِّ وهم قُوُم شُعَيبٍ عَلَيهِ السَّلامُ."],[2,3,"وَقَوۡمُ تُبَّعٍ","هُم سَبأٌ، وتُبَّعٌ هُوَ أحَدُ مُلُوكِ اليمَنِ."],[7,7,"فَحَقَّ","صَدَقَ وتَحَقَّقَ."],[8,8,"وَعِيدِ","إنذارِي بالعُقُوبةِ."]],"15":[[0,0,"أَفَعَيِينَا","أفَعَجَزْنا."],[6,6,"لَبۡسٍ","اشْتِباهٍ وشَكٍّ."],[8,9,"خَلۡقٍ جَدِيدٍ","قِيامِ الخَلْقِ في البَعْثِ."]],"16":[[4,6,"مَا تُوَسۡوِسُ بِهِۦ","تُحَدِّث بِه."],[12,13,"حَبۡلِ ٱلۡوَرِيدِ","عِرْقِ العُنُقِ المُتَّصِلِ بالقلبِ."]],"17":[[1,1,"يَتَلَقَّى","يُسَجِّلُ."],[2,2,"ٱلۡمُتَلَقِّيَانِ","المَلَكانِ المُوكَّلانِ بِكِتابَةِ أعْمالِ النّاسِ وأَقْوالِهِم."],[3,4,"عَنِ ٱلۡيَمِينِ","عَن يَمِينِ الإنْسانِ."],[7,7,"قَعِيدٌ","مُقاعِدٌ، مِثْلُ جَلِيسٍ للمُجالِسِ."]],"18":[[6,6,"رَقِيبٌ","مَلَكٌ يَرْقُبُ قَوْلَهُ ويَكْتُبُهُ."],[7,7,"عَتِيدٌ","حاضِرٌ مُعَدٌّ لِذَلِكَ."]],"19":[[1,2,"سَكۡرَةُ ٱلۡمَوۡتِ","شِدَّةُ غَمَراتِ الموتِ."],[8,8,"تَحِيدُ","تَفِرُّ وتَهْرُبُ."]],"20":[[2,2,"ٱلصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إسْرافِيلُ."],[4,5,"يَوۡمُ ٱلۡوَعِيدِ","أي الَّذِي تَوَعَّدَ اللهُ بِه الكُفّارَ."]],"21":[[4,4,"سَآئِقٌ","مَلَكٌ يَسُوقُ الإنْسانَ إلى المَحْشَرِ."],[5,5,"وَشَهِيدٌ","مَلَكٌ يَشْهَدُ عَلى النَّفْسِ بِما عَمِلَتْ."]],"22":[[11,11,"حَدِيدٌ","قَوِيُّ الَّنفاذِ في المرئِي."]],"23":[[1,1,"قَرِينُهُۥ","المَلَكُ الكاتِبُ الشَّهِيدُ عَلَيهِ."],[5,5,"عَتِيدٌ","مُهَيَّأٌ محفُوظٌ."]],"24":[[5,5,"عَنِيدٍ","مُعانِدٍ لِلْحَقِّ."]],"25":[[2,2,"مُعۡتَدٍ","ظالِمٍ مُتَجاوِزٍ لْلِحَقِّ."],[3,3,"مُّرِيبٍ","شاكٍّ."]],"27":[[1,1,"قَرِينُهُۥ","شَيْطانُه الَّذِي كانَ مُوَكَّلًا بِهِ في الدُّنيا."],[3,4,"مَآ أَطۡغَيۡتُهُۥ","ما أضْلَلْتُهُ."],[8,8,"ضَلَـٰلِۭ","طَرِيقٍ بَعِيدٍ عن سَبِيلِ الهُدى."]],"28":[[5,7,"قَدَّمۡتُ إِلَيۡكُم بِٱلۡوَعِيدِ","أعْلَمْتُكُم ما يَنْتَظِرُ العاصِيَ مِن العُقُوبَةِ."]],"30":[[8,8,"مَّزِيدٍ","زِيادةٍ في وارِدِيها."]],"31":[[0,0,"وَأُزۡلِفَتِ","وقُرِّبَتْ."],[3,4,"غَيۡرَ بَعِيدٍ","مَكانًا غَيرَ بَعِيدٍ مِنَ المُتَّقِينَ."]],"32":[[4,4,"أَوَّابٍ","كَثِيرِ الرُّجُوعِ مِن ذُنُوبِهِ."],[5,5,"حَفِيظٍ","حافظٍ لِكُلِّ عَمَلٍ صالِحٍ قَرَّبَهُ إلى ربِّهِ."]],"33":[[3,3,"بِٱلۡغَيۡبِ","في حالِ غِيابهِ عَنْ أعْيُنِ النّاسِ."],[6,6,"مُّنِيبٍ","تائبٍ مِن ذُنُوبِهِ."]],"34":[[1,1,"بِسَلَـٰمٍ","وأَنْتُم سالِمُونَ."],[3,4,"يَوۡمُ ٱلۡخُلُودِ","هُوَ الَّذِي لا زَوالَ لَهُ ولا مَوْتَ."]],"35":[[5,5,"مَزِيدٌ","النَّظَرُ إلى وجْهِ اللهِ الكريمِ."]],"36":[[3,4,"مِّن قَرۡنٍ","مِن أُمَّةٍ."],[8,8,"بَطۡشًا","قُوَّةً وسَطْوَةً."],[9,9,"فَنَقَّبُواْ","فَطَوَّفُوا."],[14,14,"مَّحِيصٍ","مَهْرَبٍ مِن عَذابِ اللهِ."]],"37":[[7,7,"قَلۡبٌ","عَقْلٌ."],[9,10,"أَلۡقَى ٱلسَّمۡعَ","أصْغى السَّمْعَ، واسْتَمَعَ بِأُذُنَيْهِ."],[12,12,"شَهِيدٌ","حاضِرٌ بِقَلْبِهِ."]],"38":[[9,10,"وَمَا مَسَّنَا","وما أصابَنا."],[12,12,"لُّغُوبٍ","تَعَبٍ."]],"40":[[3,4,"وَأَدۡبَـٰرَ ٱلسُّجُودِ","عَقِبَ الصَّلَواتِ."]],"41":[[0,0,"وَٱسۡتَمِعۡ","أيُّها النَّبِيُّ لِما أُخْبِرُكَ بِهِ مِن أهْوالِ يَوْمِ القِيامَةِ."],[3,3,"ٱلۡمُنَادِ","هُوَ المَلَكُ المُوَكَّلُ بِنَفْخِ الصُّورِ."],[5,6,"مَّكَانٍ قَرِيبٍ","صَخْرَةِ بَيتِ المَقْدِسِ."]],"42":[[3,3,"بِٱلۡحَقِّ","بِالصِّدْقِ."],[5,6,"يَوۡمُ ٱلۡخُرُوجِ","يومُ البَعْثِ مِنَ القُبُورِ."]],"44":[[1,1,"تَشَقَّقُ","تَتَصَدَّعُ."],[4,4,"سِرَاعًا","مُسْرِعِينَ."]],"45":[[7,7,"بِجَبَّارٍ","بِمُسَلَّطٍ عَلَيهِم تُجْبِرُهُم عَلى الإيمانِ."]]}