{"1":[[2,2,"كُوِّرَتۡ","لُفَّتْ، وذَهَبَ ضَوْءُها."]],"2":[[2,2,"ٱنكَدَرَتۡ","تَناثَرَتْ، فَذَهَبَ نُورُها."]],"3":[[2,2,"سُيِّرَتۡ","سُيِّرَتْ عن وجْهِ الأرْضِ فَصارَتْ هَباءً."]],"4":[[1,1,"ٱلۡعِشَارُ","النُوقُ الحوامِلُ."],[2,2,"عُطِّلَتۡ","تُرِكَتْ وأُهْمِلَتْ."]],"5":[[1,1,"ٱلۡوُحُوشُ","الحيواناتُ الوَحْشِيِّةُ."],[2,2,"حُشِرَتۡ","جُمِعَتْ واخْتَلَطَتْ، لِيَقْتَصَّ اللهُ مِن بَعْضِها لِبَعْضٍ."]],"6":[[2,2,"سُجِّرَتۡ","أُوقِدَتْ."]],"7":[[2,2,"زُوِّجَتۡ","قُرِنَتْ بأَمثالِها."]],"8":[[1,1,"ٱلۡمَوۡءُۥدَةُ","الطِّفْلةُ المدفُونةُ حَيَةً."],[2,2,"سُئِلَتۡ","سُؤالَ تَطْيِيبٍ لها ولَومٍ لِوائِدِها."]],"10":[[1,1,"ٱلصُّحُفُ","صُحُفُ الأَعْمالِ."],[2,2,"نُشِرَتۡ","عُرِضَتْ."]],"11":[[2,2,"كُشِطَتۡ","أُزِيلَتْ مِن مَّكانِها."]],"12":[[2,2,"سُعِّرَتۡ","أُوقِدَتْ."]],"13":[[2,2,"أُزۡلِفَتۡ","قُرِّبَتْ مِن أهْلِها."]],"14":[[3,3,"أَحۡضَرَتۡ","قَدَّمَتْ من خَيرٍ أو شَرٍّ."]],"15":[[2,2,"بِٱلۡخُنَّسِ","بِالنُّجُومِ المُخْتَفِيَةِ أنْوارُها نهارًا."]],"16":[[0,0,"ٱلۡجَوَارِ","الجارِيةِ."],[1,1,"ٱلۡكُنَّسِ","المسْتَتِرَةِ في أبْراجِها."]],"17":[[2,2,"عَسۡعَسَ","أقْبَلَ بِظَلامِهِ."]],"18":[[2,2,"تَنَفَّسَ","ظَهَرَ ضِياؤُه."]],"19":[[0,0,"إِنَّهُۥ","إنَّ القُرآنَ."],[2,3,"رَسُولٍ كَرِيمٍ","هو جِبْرِيلُ -عَلَيه السَّلامُ-."]],"20":[[3,4,"ذِي ٱلۡعَرۡشِ","اللهِ."],[5,5,"مَكِينٍ","صاحبِ مَكانَةٍ رَفِيعَةٍ."]],"21":[[1,1,"ثَمَّ","هُناكَ."],[2,2,"أَمِينٍ","مُؤْتَمَنٍ على الوَحْيِ الَّذِي يَنْزِلُ بِه."]],"22":[[1,1,"صَاحِبُكُم","مُحَمَّدٌ ﷺ الَّذِي تَعْرِفُونَهُ."]],"23":[[0,1,"وَلَقَدۡ رَءَاهُ","ولَقَدْ رَأى مُحَمَّدٌ جِبْرِيلَ."],[2,3,"بِٱلۡأُفُقِ ٱلۡمُبِينِ","بالأُفُقِ العَظِيمِ."]],"24":[[2,3,"عَلَى ٱلۡغَيۡبِ","بِتَبْلِيغ الوَحْيِ."],[4,4,"بِضَنِينٍ","ببَخِيلٍ."]],"25":[[4,4,"رَّجِيمٍ","مَطْرُودٍ منِ رَّحْمَةِ اللهِ."]],"26":[[0,1,"فَأَيۡنَ تَذۡهَبُونَ","فَأَينَ تَذْهَبُ بِكُم عُقُولُكُم فَي التَّكْذِيبِ بالقُرآنِ بَعْدَ هذِه الحُجَجِ القاطِعَةِ؟"]],"27":[[3,3,"ذِكۡرٌ","مَوعِظَةٌ."]],"28":[[4,4,"يَسۡتَقِيمَ","على الحقِّ والإيمانِ."]]}