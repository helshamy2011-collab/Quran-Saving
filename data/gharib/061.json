{"2":[[5,7,"مَا لَا تَفۡعَلُونَ","ما لا تَقُومُونَ بالوفاءِ بهِ."]],"3":[[1,1,"مَقۡتًا","بُغْضًا."]],"4":[[7,7,"صَفًّا","أي مَصْفُوفِينَ."],[10,10,"مَّرۡصُوصٌ","مُتَراصٌّ مُحْكَمٌ."]],"5":[[14,14,"زَاغُوٓاْ","مالُوا عَنِ الحقِّ مع عِلْمِهِم به."],[15,17,"أَزَاغَ ٱللَّهُ قُلُوبَهُمۡ","صَرَفَها عَن قَبُولِ الهِدايَةِ."],[22,22,"ٱلۡفَـٰسِقِينَ","الخارِجِيِنَ عَنِ الطّاعةِ."]],"6":[[12,14,"لِّمَا بَيۡنَ يَدَيَّ","لِما جاءَ قَبْلي."],[17,17,"وَمُبَشِّرَۢا","ومُخْبِرًا بِمَجِيءِ الرَّسُولِ ﷺ."],[26,26,"بِٱلۡبَيِّنَـٰتِ","بالدَّلائِلِ الواضِحاتِ الدّالّةِ عَلى نُبُوَّتِهِ."]],"7":[[0,1,"وَمَنۡ أَظۡلَمُ","لا أحَدَ أظْلَمُ."],[3,3,"ٱفۡتَرَىٰ","اختَلَقَ."]],"8":[[1,3,"لِيُطۡفِـُٔواْ نُورَ ٱللَّهِ","لِيَقْضُوا عَلى دِينِ اللهِ."],[6,7,"مُتِمُّ نُورِهِۦ","سيُتِمُّ هَذا الإسلامَ حَتّى يَنْتَشِرَ."]],"9":[[4,4,"بِٱلۡهُدَىٰ","بالقُرآنِ."],[5,6,"وَدِينِ ٱلۡحَقِّ","ودِينِ الإسْلامِ."],[7,7,"لِيُظۡهِرَهُۥ","ليُعْلِيَهُ."]],"12":[[6,7,"مِن تَحۡتِهَا","مِن تَحْتِ قُصُورِها وأَشْجارِها."],[13,13,"عَدۡنٍ","إقامَةٍ دائِمَةٍ."]],"13":[[0,0,"وَأُخۡرَىٰ","ونِعْمَةٌ أُخْرى."],[6,6,"قَرِيبٌ","عاجِلٌ."]],"14":[[11,11,"لِلۡحَوَارِيِّـۧنَ","هُمْ أصْفِياءُ عِيسى –عَلَيهِ السَّلامُ- وخُلَّصُ أصحابِهِ."],[34,34,"ظَـٰهِرِينَ","غالِبِينَ: إما بالحُجَّةِ أو بِبِعْثَةِ مُحَمَّدٍ ﷺ."]]}