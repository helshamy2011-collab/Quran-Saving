{"1":[[10,10,"عِوَجَا","اختِلافًا، ولا اختِلالًا فيِ ألفاظِه ولا فيِ معانيه."]],"2":[[0,0,"قَيِّمًا","مستقيمًا معتدلًا، لا إفراطَ فيه ولا تفريطَ."],[2,3,"بَأۡسًا شَدِيدًا","عقوبةً عاجلةً في الدنيا وآجِلَةً في الآخرةِ."],[13,14,"أَجۡرًا حَسَنًا","ثوابًا جزيلًا، هو الجنةُ."]],"5":[[7,7,"كَبُرَتۡ","عَظُمَتْ في الشَّناعَةِ والقُبْحِ."]],"6":[[1,2,"بَـٰخِعٌ نَّفۡسَكَ","مُهْلِكُها ومُجْهِدُها."],[3,4,"عَلَىٰٓ ءَاثَـٰرِهِمۡ","بعدَ تَوَلِّي قومِك عنك."],[9,9,"ٱلۡحَدِيثِ","القرآنِ."],[10,10,"أَسَفًا","حُزْنًا وغَضَبًا؛ لحِرْصِك على إيمانهم."]],"7":[[7,7,"لِنَبۡلُوَهُمۡ","لِنَخْتَبِرَهم."]],"8":[[4,4,"صَعِيدًا","تُرابًا."],[5,5,"جُرُزًا","لا نباتَ فيه."]],"9":[[4,4,"ٱلۡكَهۡفِ","النَّقْبِ المتَّسِعِ في الجبل، وهو أكبرُ من المغارة."],[5,5,"وَٱلرَّقِيمِ","اللَّوْحِ الذي كُتِبَتْ فيه أسماءُ أهلِ الكهفِ."]],"10":[[1,4,"أَوَى ٱلۡفِتۡيَةُ إِلَى ٱلۡكَهۡفِ","لجَؤُوا إليه؛ لعبادةِ اللهِ، وفِرارًا بدِينهم."],[11,11,"وَهَيِّئۡ","يَسِّرْ."],[15,15,"رَشَدًا","اهتداءً إلى الحق، وسَدادًا في العمل."]],"11":[[0,2,"فَضَرَبۡنَا عَلَىٰٓ ءَاذَانِهِمۡ","أنَمْناهم نومًا عميقًا؛ بحيث لا يَسْمعون."]],"12":[[1,1,"بَعَثۡنَـٰهُمۡ","أيقَظْناهم مِن نومِهم."],[4,4,"ٱلۡحِزۡبَيۡنِ","الفريقَين المختلفَين في مُدَّةِ بقائِهم في الكهفِ."],[8,8,"أَمَدًا","غايةً ومُدَّة."]],"14":[[0,2,"وَرَبَطۡنَا عَلَىٰ قُلُوبِهِمۡ","قَوَّيْناها بالصَّبْرِ والتثبيتِ على الحقِّ."],[18,18,"شَطَطًا","قولًا بعيدًا مجانِبًا للحقِّ."]],"15":[[0,0,"لَّوۡلَا","هَلّا."],[9,10,"بِسُلۡطَـٰنِۭ بَيِّنٍ","دليلٍ واضحٍ."],[14,14,"ٱفۡتَرَىٰ","اختَلَقَ."],[17,17,"كَذِبًا","بنسبةِ الشريكِ إلى اللهِ تعالى."]],"16":[[1,1,"ٱعۡتَزَلۡتُمُوهُمۡ","فارَقْتُم قومَكم؛ فِرارًا بدِينِكم."],[6,6,"فَأۡوُۥٓاْ","الجَؤُوا."],[9,9,"يَنشُرۡ","يَبْسُطْ ويُوَسِّعْ."],[14,14,"وَيُهَيِّئۡ","يُيَسِّرْ."],[18,18,"مِّرۡفَقًا","ما تنتفعون به من أسبابِ العيشِ."]],"17":[[4,4,"تَّزَٰوَرُ","تميلُ."],[7,8,"ذَاتَ ٱلۡيَمِينِ","جهةَ يمينِ الكهفِ."],[11,11,"تَّقۡرِضُهُمۡ","تَتْرُكُهم وتتجاوَزُهم."],[16,17,"فَجۡوَةٍ مِّنۡهُ","مُتَّسَعٍ من الكهفِ وفَضائِه، فلا يتأَذَّون من جَوِّه، أو من حرارةِ الشمس، ويأتيهم الهواءُ النافعُ."],[20,21,"ءَايَـٰتِ ٱللَّهِ","دلائلِ قُدرتِه."],[23,24,"يَهۡدِ ٱللَّهُ","يوفِّقه."],[32,32,"وَلِيًّا","مُعِينًا وناصِرًا."]],"18":[[3,3,"رُقُودٌ","نِيامٌ."],[12,12,"بِٱلۡوَصِيدِ","بفِناءِ الكَهْفِ، كأنه يَحْرُسُهم."],[21,21,"رُعۡبًا","خَوفًا وفَزَعًا."]],"19":[[0,0,"وَكَذَٰلِكَ","وكما أنَمْناهم وحَفِظْناهم مدةً طويلة."],[1,1,"بَعَثۡنَـٰهُمۡ","أيْقَظْناهم من نومِهم كما كانوا."],[22,22,"بِوَرِقِكُمۡ","بنقُودِكم الفِضِّيَّةِ."],[27,27,"أَيُّهَآ","أيُّ أهلِ المدينةِ."],[28,29,"أَزۡكَىٰ طَعَامًا","أحَلُّ وأطيبُ."],[33,33,"وَلۡيَتَلَطَّفۡ","وليتكلَّفِ اللُّطْفَ والرِّفْقَ في المعاملةِ، حتى لا ينكشِفَ أمرُنا."]],"20":[[2,3,"يَظۡهَرُواْ عَلَيۡكُمۡ","يَطَّلِعُوا على مكانِكم ويَعْلَمُوا به."],[4,4,"يَرۡجُمُوكُمۡ","يَقْتُلوكم بالرَّجْمِ بالحجارةِ."],[8,8,"مِلَّتِهِمۡ","دينِهم الباطلِ."]],"21":[[0,0,"وَكَذَٰلِكَ","وكما أنَمْناهم السنينَ الطِّوالَ، ثم أيْقَظْناهم بعدَها."],[1,2,"أَعۡثَرۡنَا عَلَيۡهِمۡ","أطْلَعْنا عليهم أهلَ زمانِهم."],[5,6,"وَعۡدَ ٱللَّهِ","بالبعثِ."],[16,16,"أَمۡرَهُمۡ","في أمرِ القِيامةِ، فمِن مُقِرٍّ لها وجاحِدٍ، أو في أمْرِ الفِتْيَةِ المؤمنين وما اطَّلعوا عليه مِن أحوالِهم."],[25,28,"ٱلَّذِينَ غَلَبُواْ عَلَىٰٓ أَمۡرِهِمۡ","أصحابُ الكلمةِ والنفوذِ."]],"22":[[8,9,"رَجۡمَۢا بِٱلۡغَيۡبِ","قولًا بلا عِلْمٍ ولا اطِّلاعٍ."],[17,17,"بِعِدَّتِهِم","بعَدَدِهم."],[22,24,"فَلَا تُمَارِ فِيهِمۡ","فلا تجادِلْ في شأنِ أصحابِ الكهفِ وعَدَدِهم أحدًا من الخائضين فيه."],[25,27,"إِلَّا مِرَآءً ظَـٰهِرًا","إلا جِدالًا واضحًا بذِكْرِ ما قَصَصْنا عليك مِن شأنِهم دونَ زيادةٍ."]],"24":[[4,5,"وَٱذۡكُر رَّبَّكَ","بقولِ: إنْ شاء الله."],[11,11,"يَهۡدِيَنِ","يُوَفِّقَني."],[14,15,"مِنۡ هَـٰذَا","من قصةِ أصحابِ الكهفِ في الدِّلالةِ على نُبَوَّتي."],[16,16,"رَشَدًا","هدايةً ودَلالة للناسِ على ذلك."]],"25":[[0,2,"وَلَبِثُواْ فِي كَهۡفِهِمۡ","ومَكَثَ الفِتْيانُ فيه نِيامًا."]],"26":[[9,11,"أَبۡصِرۡ بِهِۦ وَأَسۡمِعۡ","ما أبصَرَ اللهَ وأسمَعَه بكلِّ موجودٍ، فهو لا يَغِيبُ عنه شيء!"],[12,13,"مَا لَهُم","ليس للخَلْقِ."],[17,17,"وَلِيٍّ","مُعينٍ وناصرٍ."],[21,21,"حُكۡمِهِۦٓ","قَضائِه وتشريعِه."]],"27":[[14,14,"مُلۡتَحَدًا","مَلْجَأً ومَلاذًا."]],"28":[[0,1,"وَٱصۡبِرۡ نَفۡسَكَ","احبِسْها في طاعةِ اللهِ."],[6,7,"بِٱلۡغَدَوٰةِ وَٱلۡعَشِيِّ","أولِ النهار وآخرِه، والمرادُ دوامُ العبادةِ."],[10,13,"وَلَا تَعۡدُ عَيۡنَاكَ عَنۡهُمۡ","لا تَصْرِفْ نَظَرَكَ عنهم إلى غيرِهِم."],[21,22,"أَغۡفَلۡنَا قَلۡبَهُۥ","جَعَلْناه غافلًا."],[29,29,"فُرُطًا","ضَياعًا وهَلاكًا ومُتَجاوِزًا فيه الاعتدالَ."]],"29":[[1,1,"ٱلۡحَقُّ","ما جئتكُم به هو الحقُّ."],[4,9,"فَمَن شَآءَ فَلۡيُؤۡمِن وَمَن شَآءَ فَلۡيَكۡفُرۡ","تهديدٌ ووعيدٌ لمن اختارَ الكفرَ بعد بيانِ الحقِّ ووُضوحِه."],[16,16,"سُرَادِقُهَا","سُورُها المحيطُ بها."],[21,21,"كَٱلۡمُهۡلِ","ماءٌ غليظٌ كالمُنْصَهِر من المعادنِ، أو كعَكَرِ الزيتِ، بَلَغَ منتهى الحَرارةِ."],[27,27,"مُرۡتَفَقًا","منزِلًا ومُقامًا."]],"31":[[2,3,"جَنَّـٰتُ عَدۡنٍ","جِنانُ إقامةٍ دائمةٍ."],[8,8,"يُحَلَّوۡنَ","يُزَيَّنُون."],[18,18,"سُندُسٍ","رقيقِ الحَريرِ."],[19,19,"وَإِسۡتَبۡرَقٍ","ما غَلُظَ من الحريرِ وثَخُنَ."],[23,23,"ٱلۡأَرَآئِكِ","الأَسِرَّةِ المزيَّنَةِ بفاخِرِ السَّتائرِ."]],"32":[[0,1,"وَٱضۡرِبۡ لَهُم","واذكُرْ للمؤمنين والكافرين المستكبرِين وأَوْرِدْ لهم."],[6,6,"جَنَّتَيۡنِ","حديقتَين."],[9,10,"وَحَفَفۡنَـٰهُمَا بِنَخۡلٍ","جَعَلْنا النَّخْلَ محيطًا بكلٍّ منهما."]],"33":[[2,3,"ءَاتَتۡ أُكُلَهَا","أثمرَتْ ثمرَها الذي يُؤْكَلُ."],[4,6,"وَلَمۡ تَظۡلِم مِّنۡهُ","ولم تَنْقُصْ من إثمارها عَبْرَ السنينَ."]],"34":[[1,2,"لَهُۥ ثَمَرٌ","لصاحبِ البستانينِ أنواعٌ من المال سِوى حديقتَيه."],[12,12,"نَفَرًا","أولادًا وخَدَمًا وأعوانًا."]],"35":[[3,4,"ظَالِمٌ لِّنَفۡسِهِۦ","كافرٌ بالبعثِ، مُعْجَبٌ بمالِه."],[9,9,"تَبِيدَ","تَهْلِكَ وتَفْنى."]],"36":[[3,3,"قَآئِمَةً","كائنةً وواقعةً."],[11,11,"مُنقَلَبًا","مَرْجِعًا وعاقبةً."]],"38":[[0,0,"لَّـٰكِنَّا۠","لكنْ أنا أقولُ."]],"39":[[0,0,"وَلَوۡلَآ","وهَلّا."]],"40":[[9,9,"حُسۡبَانًا","جَمْعُ حُسْبانَةٍ، وهو العذابُ كالصَّواعِقِ."],[13,13,"صَعِيدًا","أرضًا أو ترابًا."],[14,14,"زَلَقًا","لا نَباتَ فيها، ومَلْساءُ لا تَثْبُتُ عليها قَدَمٌ. والمرادُ أنها عَدِيمةُ النَّفْعِ."]],"41":[[3,3,"غَوۡرًا","غائِرًا ذاهبًا في أسفلِ الأرضِ."]],"42":[[0,1,"وَأُحِيطَ بِثَمَرِهِۦ","وأُهلِكَتْ أموالُ الكافرِ بما فيها حديقتاه، كما تَوَقَّعَ المؤمنُ."],[3,4,"يُقَلِّبُ كَفَّيۡهِ","دَلالةً على نَدَمِه وأَسَفِه وحَسْرَتِه."],[10,12,"خَاوِيَةٌ عَلَىٰ عُرُوشِهَا","متهدِّمةٌ سَقَطَ بعضُها على بعضٍ، خاليةٌ مما كان فيها."]],"43":[[3,3,"فِئَةٌ","جماعةٌ ممَّنِ افتَخَرَ بهم."],[8,10,"وَمَا كَانَ مُنتَصِرًا","ما كان ممتنعًا بنفسِه وقوَّتِه عندَ انتقامِ اللهِ منه."]],"44":[[0,0,"هُنَالِكَ","في مثلِ هذه الشَّدائدِ، أو يومِ القيامةِ."],[1,2,"ٱلۡوَلَـٰيَةُ لِلَّهِ","النُّصْرَةُ للهِ وحدَه لا يَقْدِرُ عليها غيرُه."],[8,8,"عُقۡبًا","عاقبةً لمَن تَوَلّاهم."]],"45":[[0,1,"وَٱضۡرِبۡ لَهُم","اذكُرْ للناسِ وأَوْرِدْ."],[2,4,"مَّثَلَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","صِفَتَها في زينتِها، وتَقَلُّبَها وسُرْعَةَ زوالِها."],[14,14,"هَشِيمًا","يابسًا مُتَكَسِّرًا، بعد خُضْرَتِه ونَضارَتِه."],[15,16,"تَذۡرُوهُ ٱلرِّيَـٰحُ","تُذْهِبُه وتُفَرِّقُه إلى كلِّ جهةٍ."],[22,22,"مُّقۡتَدِرًا","كاملَ القُدْرةِ على كلِّ شيءٍ."]],"46":[[2,4,"زِينَةُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","فيهما جَمالٌ ونَفْعٌ وقوَّةٌ."],[5,6,"وَٱلۡبَـٰقِيَـٰتُ ٱلصَّـٰلِحَـٰتُ","الأعمالُ الصالحةُ بما فيها: التسبيحُ، والتحميدُ، والتكبيرُ، والتهليلُ."],[12,12,"أَمَلًا","ما كان يأمُلُه صاحبُها في الدُّنيا عندَ اللهِ في الآخِرة."]],"47":[[1,2,"نُسَيِّرُ ٱلۡجِبَالَ","نُزيلُها عن أماكنِها، ونُسَيِّرها في الجوِّ كالسَّحابِ."],[5,5,"بَارِزَةً","ظاهرةً للأَعْيُنِ لا يَسْتُرها شيءٌ."],[6,6,"وَحَشَرۡنَـٰهُمۡ","جَمَعْنا الأوَّلِين والآخِرين لموقفِ الحسابِ."],[8,8,"نُغَادِرۡ","نَتْرُكْ."]],"48":[[3,3,"صَفًّا","مُصْطَفِّين جميعًا لا يَغِيبُ أحدٌ منهم."],[6,9,"كَمَا خَلَقۡنَـٰكُمۡ أَوَّلَ مَرَّةِۭ","مِثْلَ خَلْقِنا الأولِ لكم: فُرادى، حُفاةَ الأقدامِ، عُراةَ الأجسامِ، غيرَ مَخْتُونين."],[10,11,"بَلۡ زَعَمۡتُمۡ","يا مُنْكِري البَعْثِ."],[15,15,"مَّوۡعِدًا","لبَعْثِكم ومُجازاتِكم على أعمالِكم."]],"49":[[1,1,"ٱلۡكِتَـٰبُ","صحائفُ أعمالِ العبادِ."],[4,4,"مُشۡفِقِينَ","خائفين."],[8,8,"يَـٰوَيۡلَتَنَا","يا هَلاكَنا، نداءٌ منهم على أنفسِهم بالخُسْرانِ والهَلاكِ."],[12,13,"لَا يُغَادِرُ","لا يَتْرُك."],[18,18,"أَحۡصَىٰهَا","عَدَّها وأثْبتَها."]],"50":[[3,4,"ٱسۡجُدُواْ لِـَٔادَمَ","تحيةً وإكرامًا له وإظهارًا لفَضْلِه، لا عبادةً."],[11,14,"فَفَسَقَ عَنۡ أَمۡرِ رَبِّهِۦٓ","خَرَجَ عن طاعةِ ربِّه بتَرْكِ السُّجودِ؛ تَكَبُّرًا."],[17,17,"أَوۡلِيَآءَ","أعوانًا."]],"51":[[0,1,"مَّآ أَشۡهَدتُّهُمۡ","أي: إبليسَ وذريتَه."],[12,12,"عَضُدًا","أعوانًا وأنصارًا في شأنٍ من شؤوني."]],"52":[[6,6,"فَدَعَوۡهُمۡ","استغاثُوا بهم."],[12,12,"مَّوۡبِقًا","مَهْلِكًا في جَهَنَّمَ يَهْلِكُون فيه."]],"53":[[3,3,"فَظَنُّوٓاْ","أيقَنوا."],[5,5,"مُّوَاقِعُوهَا","واقِعُونَ فيها وداخِلُوها."],[9,9,"مَصۡرِفًا","مكانًا يَنْصَرِفُون ويَلْجَؤُون إليه."]],"54":[[1,1,"صَرَّفۡنَا","بَيَّنّا ونوَّعْنا بأساليبَ مختلفةٍ."],[7,8,"كُلِّ مَثَلٍ","كلِّ معنى يَحْصُلُ الاتِّعاظُ به."],[13,13,"جَدَلًا","خُصومةً في الباطل."]],"55":[[13,14,"سُنَّةُ ٱلۡأَوَّلِينَ","سُنَّةُ اللهِ في إهلاكِ السابقين بالاستئصال."],[18,18,"قُبُلًا","صُنوفًا وأنواعًا، أو مَوُاجَهَةً ومقابَلَةً."]],"56":[[10,11,"لِيُدۡحِضُواْ بِهِ","ليُزِيلُوا بجِدالِهم وباطِلِهم."],[17,17,"هُزُوًا","استهزاءً وسُخْريَةً."]],"57":[[16,16,"أَكِنَّةً","أغطيةً مانعةً."],[17,18,"أَن يَفۡقَهُوهُ","لِئلّا يَفْهَمُوا القرآنَ؛ عُقوبةً لهم."],[21,21,"وَقۡرًا","ثِقَلًا في السَّمعِ."]],"58":[[13,13,"مَّوۡعِدٌ","أي: مُقَدَّرٌ لعذابهِم."]],"59":[[0,1,"وَتِلۡكَ ٱلۡقُرَىٰٓ","مِنَ الأممِ السابقةِ."],[6,6,"لِمَهۡلِكِهِم","لهَلاكِهم."]],"60":[[3,3,"لِفَتَىٰهُ","تلميذِه وخادِمِه يُوشَعَ بنِ نونٍ."],[4,5,"لَآ أَبۡرَحُ","لا أزال أسِيرُ."],[8,9,"مَجۡمَعَ ٱلۡبَحۡرَيۡنِ","مُلتقاهما."],[11,12,"أَمۡضِيَ حُقُبًا","أسيرُ زمنًا طويلًا."]],"61":[[8,10,"فِي ٱلۡبَحۡرِ سَرَبًا","طريقًا فيه، كالشَّقِّ في الأرضِ."]],"62":[[1,1,"جَاوَزَا","فارَقا مكانَهما."],[5,5,"غَدَآءَنَا","طعامَنا أوَّلَ النهارِ."],[11,11,"نَصَبًا","تَعَبًا."]],"63":[[1,1,"أَرَءَيۡتَ","أتَذْكُرُ؟"],[2,5,"إِذۡ أَوَيۡنَآ إِلَى ٱلصَّخۡرَةِ","حين لَجَأْنا إليها للراحةِ."],[16,16,"سَبِيلَهُۥ","طريقَه."],[19,19,"عَجَبًا","يُتعَجَّبُ منه."]],"64":[[4,4,"نَبۡغِ","نَطْلبُه، وهو علامةٌ على مكانِ العبدِ الصّالحِ."],[5,5,"فَٱرۡتَدَّا","رَجَعا."],[6,7,"عَلَىٰٓ ءَاثَارِهِمَا","على طريقِهما الذي جاءا منه."],[8,8,"قَصَصًا","يَتْبَعان آثارَ مسيرِهما، حتى وصَلا إلى الصَّخْرةِ."]],"65":[[1,3,"عَبۡدًا مِّنۡ عِبَادِنَآ","هو الخَضِرُ، وهو نبيٌّ توفّاه الله."],[5,5,"رَحۡمَةً","نبوَّةً."]],"66":[[10,10,"رُشۡدًا","إصابةً للحقِّ وصَوابًا أسترشِدُ به."]],"68":[[7,7,"خُبۡرًا","عِلْمًا ومعرفةً بحقيقتِه."]],"70":[[5,6,"عَن شَيۡءٍ","أي: تُنْكِرُه عليَّ في عِلْمِكَ."],[8,11,"أُحۡدِثَ لَكَ مِنۡهُ ذِكۡرًا","أبتدِئُكَ ببيانِه وتَوْضيحِ ما خَفِيَ عليك."]],"71":[[0,0,"فَٱنطَلَقَا","فسار موسى والخَضِرُ يَمْشِيان على الساحلِ."],[13,14,"شَيۡـًٔا إِمۡرًا","أمرًا عظيمًا مُنْكَرًا."]],"73":[[5,6,"وَلَا تُرۡهِقۡنِي","لا تُحَمِّلني وتُكَلِّفني."],[7,9,"مِنۡ أَمۡرِي عُسۡرًا","في صُحْبتي إياك وتَعَلُّمي منك مشقَّةً."]],"74":[[9,9,"زَكِيَّةَۢ","نقيةً طاهرةً لم تبلُغْ حَدَّ التكليفِ."],[10,11,"بِغَيۡرِ نَفۡسٍ","بغيرِ حَقٍّ من قِصاصٍ عليها."],[15,15,"نُّكۡرًا","مُنْكَرًا عظيمًا."]],"76":[[10,12,"مِن لَّدُنِّي عُذۡرًا","إلى الغايةِ التي أعْذُرُكَ في فِراقي بسببِها."]],"77":[[6,7,"ٱسۡتَطۡعَمَآ أَهۡلَهَا","طَلَبا من أهلِ القريةِ الطعامَ على وجْهِ الضِّيافَةِ."],[8,8,"فَأَبَوۡاْ","امتنعُوا."],[14,14,"يُرِيدُ","يَقْرُبُ ويُوشِكُ."],[15,16,"أَن يَنقَضَّ","أن يسقطَ؛ بسببِ مَيَلانِه."],[17,17,"فَأَقَامَهُۥ","سوّاه الخَضرُ وعَدَّلَ ميلَه."]],"78":[[5,5,"سَأُنَبِّئُكَ","سأُخْبِرُكَ."],[6,6,"بِتَأۡوِيلِ","بحقيقةِ مَقْصِدي من أفعالي."]],"79":[[3,3,"لِمَسَـٰكِينَ","محتاجِين لا يملِكُون ما يَكْفيهم ويَسُدُّ حاجتَهم."],[9,9,"أَعِيبَهَا","أُحْدِثَ فيها عَيْبًا بخَرْقِها."],[11,11,"وَرَآءَهُم","أمامَهم."],[14,15,"كُلَّ سَفِينَةٍ","صالحةٍ غيرِ مَعِيبةٍ."],[16,16,"غَصۡبًا","قَهْرًا وظُلْمًا."]],"80":[[7,7,"يُرۡهِقَهُمَا","يَدْفَعَ والدَيه إلى تجاوُزِ حدودِ اللهِ والكفرِ."]],"81":[[6,6,"زَكَوٰةً","دِينًا وصَلاحًا."],[8,8,"رُحۡمًا","رحمةً بوالدَيه وبِرًّا بهما."]],"82":[[9,9,"كَنزٌ","مالٌ مَدْفونٌ من الذَّهَبِ والفِضَّةِ."],[17,18,"يَبۡلُغَآ أَشُدَّهُمَا","قوَّتَهما وكمالَ عَقْلِهما."],[28,29,"ذَٰلِكَ تَأۡوِيلُ","الذي بَيَّنْتُ لك أسبابَه هو مآلُ تلك الأمورِ."]],"83":[[0,0,"وَيَسۡـَٔلُونَكَ","أي: كفارُ قريشٍ بتَلْقينٍ من اليهود."],[2,3,"ذِي ٱلۡقَرۡنَيۡنِ","عبدٌ صالحٌ مَلَّكه اللهُ الأرضَ، وأعطاه العِلْمَ والحكمةَ، حتى بَلَغَ سلطانُه المشرقَ والمغربَ، فسُمِّيَ ذا القَرْنين، فكأنه حاز قَرْنَي الدنيا."],[8,8,"ذِكۡرًا","خَبَرًا تتذكَّرون به."]],"84":[[1,2,"مَكَّنَّا لَهُۥ","سَهَّلْنا لَه التَّصَرُّفَ كَيفَ شاءَ."],[9,9,"سَبَبًا","طَرِيقًا يُوصِلُه إلى مُرادِهِ."]],"85":[[0,0,"فَأَتۡبَعَ","سَلَك وسارَ."],[1,1,"سَبَبًا","طريقًا نَحْوَ الغَرْبِ."]],"86":[[3,4,"مَغۡرِبَ ٱلشَّمۡسِ","مَوْضِعَ غُرُوبِها، وهُوَ نِهايةُ الأَرْضِ مِنَ الغَرْبِ."],[8,8,"عَيۡنٍ","نَبْعٍ جارِيةٍ بالماءِ أو غيرِه."],[9,9,"حَمِئَةٍ","ذاتِ طينٍ أسْودَ."],[18,18,"تُعَذِّبَ","بالقتلِ أو غيرِه إنْ لم يُؤمِنُوا."],[23,23,"حُسۡنًا","بِدعوتِهم إلى الهُدى والرَّشادِ."]],"87":[[3,3,"ظَلَمَ","نفسَه بكُفْرِه بِرَبِّه."],[12,12,"نُّكۡرًا","مُنْكَرًا عَظِيمًا في جَهَنَّمَ."]],"88":[[7,7,"ٱلۡحُسۡنَىٰ","الجنَّةُ."],[12,12,"يُسۡرًا","سَهْلًا لا مَشَقَّةَ فِيه."]],"89":[[2,2,"سَبَبًا","طَرِيقًا نَحْوَ الشَّرْقِ."]],"90":[[3,4,"مَطۡلِعَ ٱلشَّمۡسِ","مَوْضِعَ طُلُوعِها، وهُوَ نِهايةُ الأرْضِ مِنَ الشَّرْقِ."],[14,14,"سِتۡرًا","ساترًا مِنَ البِناء أوْ الأَشْجار."]],"91":[[0,0,"كَذَٰلِكَ","كما وصَفْنا أمْرَ ذِي القَرنْيَنِ مِن بُلُوغِه المَغْرِبَ والمشْرِقَ."],[5,5,"خُبۡرًا","عِلْمًا ومَعْرِفةً."]],"93":[[4,4,"ٱلسَّدَّيۡنِ","الجَبَلَينِ."]],"94":[[4,5,"يَأۡجُوجَ وَمَأۡجُوجَ","أُمَّتانِ عظِيمتان مِن بَنِي آدَمَ مَوْجُودتانِ."],[12,12,"خَرۡجًا","نَصِيبًا وأجْرًا مِنَ المالِ."],[18,18,"سَدًّا","حاجِزًا."]],"95":[[11,11,"رَدۡمًا","حاجِزًا قَوِيًّا."]],"96":[[1,2,"زُبَرَ ٱلۡحَدِيدِ","قِطَعَه الكَبيرةَ."],[7,7,"ٱلصَّدَفَيۡنِ","جانِبَي الجبَلَينِ."],[16,16,"أُفۡرِغۡ","أصُبَّ."],[18,18,"قِطۡرًا","نُحاسًا مُذابًا."]],"97":[[3,3,"يَظۡهَرُوهُ","يَعْلُوه ويَصْعَدُوا إليه."],[7,7,"نَقۡبًا","ثَقْبًا؛ لِصَلابَتِه وسَماكَتِه."]],"98":[[7,8,"وَعۡدُ رَبِّي","وعْدُ رَبِّي بِخُرُوجِ يأجُوجَ ومَأجُوجَ."],[10,10,"دَكَّآءَ","مُنْهَدِمًا مُسْتَويًا بالأَرض."]],"99":[[3,3,"يَمُوجُ","يضْطَرِبُ ويَخْتَلِطُ بَعْضُهم في بَعْضٍ."],[8,8,"ٱلصُّورِ","القَرْنِ الذي يُنْفَخُ فيه للبعثِ."]],"100":[[0,0,"وَعَرَضۡنَا","أبْرَزْنا."]],"101":[[4,4,"غِطَآءٍ","سِتْرٍ وحِجابٍ."],[6,6,"ذِكۡرِي","هُو القرآنُ والآياتُ الكونيةُ."],[8,10,"لَا يَسۡتَطِيعُونَ سَمۡعًا","لا يُطِيقُونَ سَماعَ الحُجَجِ والبَراهِينِ بُغْضًا وعِنادًا."]],"102":[[6,8,"مِن دُونِيٓ أَوۡلِيَآءَ","مِن غيرِي آلهةً."],[10,10,"أَعۡتَدۡنَا","أعْدَدْنا وأحْضَرْنا."],[13,13,"نُزُلًا","مَنزِلًا مُعَدًّا لهم."]],"104":[[1,2,"ضَلَّ سَعۡيُهُمۡ","ضاعَ عَمَلُهم."],[7,10,"يَحۡسَبُونَ أَنَّهُمۡ يُحۡسِنُونَ صُنۡعًا","يَظُنُّونَ أنّهم مُحْسِنُونَ في أعْمالِهم."]],"105":[[6,6,"فَحَبِطَتۡ","فبَطَلَتْ."],[13,13,"وَزۡنًا","قَدْرًا وثِقَلًا."]],"106":[[8,8,"هُزُوًا","مُسْتَهْزَأً بِهما."]],"107":[[7,8,"جَنَّـٰتُ ٱلۡفِرۡدَوۡسِ","أعلى مَناِزلِ الجنِّةِ وأَوْسَطُها، وهي أفْضَلُها."],[9,9,"نُزُلًا","مَنزِلًا مُعدًّا لهم."]],"108":[[2,3,"لَا يَبۡغُونَ","لا يُرِيدُونَ."]],"109":[[4,4,"مِدَادًا","حِبْرًا للأقْلامِ."],[7,7,"لَنَفِدَ","لَفَنِيَ."],[12,13,"كَلِمَـٰتُ رَبِّي","عِلْمُه وحِكَمُه وما أوْحاه إلى ملائِكَتِه ورُسُلِه."],[17,17,"مَدَدًا","زِيادةً."]],"110":[[13,13,"يَرۡجُواْ","يخافُ عذابَ ربِّه، ويَرْجُو ثَوابَه يومَ لِقائِه."]]}