{"1":[[0,0,"وَٱلنَّـٰزِعَـٰتِ","أُقْسِمُ بالملائِكةِ الَّتِي تَنْزِعُ أرْواحَ الكُفّارِ."],[1,1,"غَرۡقًا","نَزْعًا غَرْقًا، أي مُغْرِقًا، أي تَنْزِعُ الأرْواحَ من أقاصِي الأَجْسادِ."]],"2":[[0,0,"وَٱلنَّـٰشِطَـٰتِ","والملائِكَةِ الَّتِي تَقْبِضُ أرْواحَ المؤمِنِينَ."],[1,1,"نَشۡطًا","بِنَشاطٍ ورِفقٍ."]],"3":[[0,0,"وَٱلسَّـٰبِحَـٰتِ","والملائِكَةِ الَّتِي تَسْبَحُ في نُزُولِها مِنَ السَّماءِ وصُعُودِها إليها."]],"4":[[0,0,"فَٱلسَّـٰبِقَـٰتِ","فالملائِكَةِ الَّتِي تُسارِعُ إلى تَنِفيذِ أمْرِ اللهِ."]],"5":[[0,1,"فَٱلۡمُدَبِّرَٰتِ أَمۡرًا","فالملائِكةِ المُنَفِّذاتِ أمْرَ رَبِّها."]],"6":[[0,2,"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","يومَ تَضْطَرِبُ الأرضُ بالنَّفْخَةِ الأُولى نَفْخَةِ الإماتَةِ."]],"7":[[0,1,"تَتۡبَعُهَا ٱلرَّادِفَةُ","تَتْبَعُها نَفْخَةٌ أُخْرى لِبَعْثِ الخَلْقِ."]],"8":[[0,0,"قُلُوبٌ","قُلُوبُ الكُفّارِ."],[2,2,"وَاجِفَةٌ","مُضْطَرِبَةٌ مِن شِدَّةِ الخوفِ."]],"9":[[1,1,"خَـٰشِعَةٌ","ذَلِيلَةٌ مِن هَوْلِ ما تَرى."]],"10":[[1,2,"أَءِنَّا لَمَرۡدُودُونَ","أنُرَدُّ بَعْدَ مَوتِنا؟."],[4,4,"ٱلۡحَافِرَةِ","إلى أوَّلِ حالِنا، فَنَصِيرُ أحياءً بَعْدَ مَوْتِنا."]],"11":[[0,3,"أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً","أنُرَدُّ وقَدْ صِرْنا عِظامًا بالِيةً."]],"12":[[3,4,"كَرَّةٌ خَاسِرَةٌ","رَجْعَةٌ خائِبةٌ كاذِبةٌ."]],"13":[[2,3,"زَجۡرَةٌ وَٰحِدَةٌ","نَفْخَةٌ واحِدَةٌ."]],"14":[[2,2,"بِٱلسَّاهِرَةِ","على وجْهِ الأَرْضِ."]],"16":[[4,4,"ٱلۡمُقَدَّسِ","الُمطَهَّرِ المبارَكِ."],[5,5,"طُوًى","وادٍ في جانِبِ جَبَلِ الطُّورِ."]],"17":[[4,4,"طَغَىٰ","أفْرَطَ في العِصْيانِ."]],"18":[[1,2,"هَل لَّكَ","أتَوَدُّ."],[5,5,"تَزَكَّىٰ","تُطَهِّرَ نَفْسَكَ."]],"20":[[0,0,"فَأَرَىٰهُ","فَأَرى مُوسى فِرْعَونَ."],[1,2,"ٱلۡـَٔايَةَ ٱلۡكُبۡرَىٰ","العلامةَ العُظْمى: العَصا واليدَ."]],"22":[[1,1,"أَدۡبَرَ","ولّى مُعْرِضًا عَنِ الإيمانِ."],[2,2,"يَسۡعَىٰ","في مُعارَضَةِ مُوسى."]],"23":[[0,0,"فَحَشَرَ","فَجَمَعَ النّاسَ."]],"25":[[0,1,"فَأَخَذَهُ ٱللَّهُ","فَعاقَبَهُ."],[2,3,"نَكَالَ ٱلۡـَٔاخِرَةِ","عَذابَ الآخِرَةِ."],[4,4,"وَٱلۡأُولَىٰٓ","وعَذابَ الدُّنيا."]],"26":[[3,3,"لَعِبۡرَةً","لَمَوْعِظَةً."]],"27":[[0,4,"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُ","أبَعْثُكُم-أيُّها الناسُ- بَعْدَ الموتِ أشَدُّ في تَقْدِيرِكُم أم خَلْقُ السَّماءِ؟"],[5,5,"بَنَىٰهَا","خَلَقَها."]],"28":[[0,1,"رَفَعَ سَمۡكَهَا","رَفَعَها فَوقَكُم كالبِناءِ فَأَعلى سَقْفَها في الهواءِ."],[2,2,"فَسَوَّىٰهَا","فعَدَّلَ أجْزاءَها بإتْقان."]],"29":[[0,1,"وَأَغۡطَشَ لَيۡلَهَا","وأَظْلَمَ لَيلَها."],[2,3,"وَأَخۡرَجَ ضُحَىٰهَا","وأَبْرَزَ نَهارَها."]],"30":[[1,2,"بَعۡدَ ذَٰلِكَ","بَعْدَ خَلْقِ السَّماءِ."],[3,3,"دَحَىٰهَآ","بَسَطَها وأَوْدَعَ فِيها منافِعَها."]],"31":[[3,3,"وَمَرۡعَىٰهَا","وأَنبَتَ فِيها ما يُرعى مِنَ النباتاتِ."]],"32":[[1,1,"أَرۡسَىٰهَا","أثْبتَها في الأرضِ."]],"33":[[0,1,"مَتَـٰعًا لَّكُمۡ","مَنفَعَةً لَكُم."]],"34":[[2,3,"ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","القِيامَةُ الكُبْرى والشِدَّةُ العُظْمى وهي النَّفْخَةُ الثّانِيةُ."]],"35":[[1,4,"يَتَذَكَّرُ ٱلۡإِنسَـٰنُ مَا سَعَىٰ","يُعْرَضُ عَلى الإنسانِ عَمَلُهُ، فَيَتَذَكَّرُهُ ويَعْتَرِفُ بِهِ."]],"36":[[0,0,"وَبُرِّزَتِ","وأُظهِرَتْ."]],"37":[[2,2,"طَغَىٰ","أفْرَطَ في العِصيانِ."]],"38":[[0,2,"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","وفَضَّل الحياةَ الدُّنيا على الآخِرَةِ."]],"39":[[3,3,"ٱلۡمَأۡوَىٰ","المصِيرُ والمآلُ."]],"40":[[3,4,"مَقَامَ رَبِّهِۦ","القِيامَ بينَ يَدَيِ اللهِ لِلحِسابِ."],[8,8,"ٱلۡهَوَىٰ","الأَهْواءِ الفاسِدةِ."]],"41":[[3,3,"ٱلۡمَأۡوَىٰ","مَسْكَنُهُ."]],"42":[[3,4,"أَيَّانَ مُرۡسَىٰهَا","مَتى وقْتُ السّاعةِ؟"]],"43":[[0,3,"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ","لَسْتَ في شَيءٍ مِن عِلْمِها."]],"44":[[0,2,"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","مَرَدُّ ذَلِكَ إلى اللهِ عَزَّ وجَلَّ."]],"45":[[2,2,"مُنذِرُ","مُحذِّرٌ مِنها."]],"46":[[6,6,"عَشِيَّةً","ما بَينَ الظُّهْرِ إلى غُرُوبِ الشَّمسِ."],[8,8,"ضُحَىٰهَا","ما بَينَ طُلُوعِ الشَّمسِ إلى نِصْفِ النَّهارِ."]]}