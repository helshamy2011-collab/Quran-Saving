{"1":[[2,2,"فَاطِرِ","مُبْدِعٍ عَلى غَيرِ مِثالٍ سَبَقَ."],[8,9,"أُوْلِيٓ أَجۡنِحَةٍ","أصْحابَ أجْنِحَةٍ."]],"2":[[0,1,"مَّا يَفۡتَحِ","أي: ما يُرسِلْ ويُعْطِ."],[5,5,"رَّحۡمَةٍ","نِعْمَةٍ."],[7,7,"مُمۡسِكَ","مانِعَ."],[12,12,"مُرۡسِلَ","مُعْطِيَ."]],"3":[[19,20,"فَأَنَّىٰ تُؤۡفَكُونَ","فَكَيفَ تُصْرَفُونَ عَن تَوحِيدِهِ؟."]],"5":[[3,4,"وَعۡدَ ٱللَّهِ","أي: بالبعْثِ والثَّوابِ والعِقابِ."],[5,5,"حَقٌّ","ثابِتٌ وكائِنٌ لا محالةَ."],[6,7,"فَلَا تَغُرَّنَّكُمُ","فَلا تَخْدَعَنَّكُم."],[13,13,"ٱلۡغَرُورُ","الشَّيطانُ."]],"6":[[8,8,"حِزۡبَهُۥ","أي: أتْباعَهُ."],[12,12,"ٱلسَّعِيرِ","النّارِ الموقَدَةِ."]],"7":[[11,12,"أَجۡرٌ كَبِيرٌ","وهو الجنَّةُ."]],"8":[[1,2,"زُيِّنَ لَهُۥ","أي: حَسَّنَ له الشَّيطانُ."],[3,4,"سُوٓءُ عَمَلِهِۦ","عَمَلُه السَّيِّئُ والقبيحُ."],[15,19,"فَلَا تَذۡهَبۡ نَفۡسُكَ عَلَيۡهِمۡ حَسَرَٰتٍ","فلا تُهِلكْ نفسَك حُزْنًا على كُفْرِهِم."]],"9":[[4,4,"فَتُثِيرُ","فَتُحَرِّكُ."],[9,9,"مَّيِّتٍ","جَدْب."],[13,14,"بَعۡدَ مَوۡتِهَا","بَعْدَ يُبْسِها وجَفافِها."],[16,16,"ٱلنُّشُورُ","بَعْثُ الموتى مِن قُبُورِهِم للجزاءِ."]],"10":[[8,8,"يَصۡعَدُ","يَرْتَقِي."],[9,10,"ٱلۡكَلِمُ ٱلطَّيِّبُ","الكلامُ الطَّيِّبُ مِن ذِكْرٍ ودُعاءٍ وتِلاوَةٍ."],[13,13,"يَرۡفَعُهُۥ","أي: يَرفَعُه اللهُ إلَيهِ ويَقْبَلُه."],[15,16,"يَمۡكُرُونَ ٱلسَّيِّـَٔاتِ","أي: يَمْكُرُونَ المكَراتِ السَّيِّئاتِ، وهي مَذْكُورةٌ في قوله تعالى:"],[23,23,"يَبُورُ","يَفسُدُ ويَبْطُلُ."]],"11":[[5,6,"مِن نُّطۡفَةٍ","هي مَنِيُّ الرجلِ يَقْذِفُه في رَحِمِ امْرَأَتِه."],[9,9,"أَزۡوَٰجًا","ذُكُورًا وإناثًا تَزَوَّجَ بعضُهم بَعْضًا."],[14,15,"لَا تَضَعُ","لاتَلِدُ."],[19,19,"مُّعَمَّرٍ","طَوِيلِ العُمُرِ."]],"12":[[5,5,"فُرَاتٌ","حُلْوٌ شَدِيدُ الحَلاوَةِ."],[6,7,"سَآئِغٌ شَرَابُهُۥ","سَهْلٌ مُرُورُهُ في الحَلْقِ."],[10,10,"أُجَاجٌ","شَدِيدُ المُلوحَةِ."],[14,15,"لَحۡمًا طَرِيًّا","هو السَّمَكُ."],[17,17,"حِلۡيَةً","هي اللُّؤلُؤُ والمَرْجانُ."],[20,20,"ٱلۡفُلۡكَ","السُّفُنَ."],[22,22,"مَوَاخِرَ","جوارِيَ تَشُقُّ الماءَ شَقًّا."],[23,23,"لِتَبۡتَغُواْ","لِتَطْلُبُوا."]],"13":[[0,0,"يُولِجُ","يُدخِلُ."],[13,14,"لِأَجَلٍ مُّسَمًّى","لِوقْتٍ مَعْلُومٍ."],[27,27,"قِطۡمِيرٍ","القِشْرَةِ الرَّقيقَةِ على نَواةِ التَّمْرَةِ."]],"14":[[14,15,"وَلَا يُنَبِّئُكَ","ولا يُخْبِرُكَ."]],"15":[[3,3,"ٱلۡفُقَرَآءُ","المحْتاجُونَ."]],"17":[[4,4,"بِعَزِيزٍ","بمُمْتَنِعٍ."]],"18":[[0,1,"وَلَا تَزِرُ","لا تَحْمِلُ."],[2,2,"وَازِرَةٌ","أي: نفسٌ مُذْنِبَةٌ."],[7,7,"مُثۡقَلَةٌ","أي: نَفْسٌ أثْقَلَتْها الذُّنوبُ."],[9,9,"حِمۡلِهَا","ذُنُوبِها التي أثْقَلَتْها."],[21,21,"يَخۡشَوۡنَ","يخافُونَ."],[27,27,"تَزَكَّىٰ","تَطَهَّرَ مِنَ الشِّرْكِ والمعاصِي."],[33,33,"ٱلۡمَصِيرُ","المرْجِعُ."]],"19":[[2,2,"ٱلۡأَعۡمَىٰ","مَن فَقَدَ بَصَرَه، والمُرادُ بِه هُنا الكافِرُ لأنّهُ عَمِيَ عَن دِينِ الحقِّ."]],"21":[[3,3,"ٱلۡحَرُورُ","الرِّيحُ الحارَّةُ."]],"23":[[3,3,"نَذِيرٌ","رَسُولٌ مُنْذِرٌ مِن عَذابِ اللهِ."]],"24":[[3,4,"بَشِيرًا وَنَذِيرًا","بَشِيرًا لِأَهْلِ الطّاعةِ ونَذَيرًا لِأَهْلِ المعْصِيةِ."],[11,11,"نَذِيرٌ","نَبِيٌّ مُنْذِرٌ مِن عَذابِ اللهِ."]],"25":[[9,9,"بِٱلۡبَيِّنَـٰتِ","بالمعْجِزاتِ الواضِحةِ."],[10,10,"وَبِٱلزُّبُرِ","بالكُتُبِ التي فيها مَواعِظُ."],[11,12,"وَبِٱلۡكِتَـٰبِ ٱلۡمُنِيرِ","الكُتُبِ الَّتي أنارَتْ طَرِيقَ الشَّرْعِ والهِدايَةِ، ومْنِها القرآنُ الكريمُ."]],"27":[[15,15,"جُدَدُۢ","جَمْعُ جُدَّةٍ، وهي الطَّرِيقَةُ والخِطَّةُ في الشَّيءِ تكونُ واضِحةً فِيهِ."],[20,20,"وَغَرَابِيبُ","جمع غِرْبِيبٍ، وهو شَديدُ السَّوادِ يُشْبِهُ لَونُه لَونَ الغُرابِ."]],"29":[[14,15,"لَّن تَبُورَ","لَن تَكْسُدَ، ولَن تَهْلِكَ."]],"32":[[3,4,"ٱلَّذِينَ ٱصۡطَفَيۡنَا","الَّذِيِنَ اخْتَرْناهُم."],[8,9,"ظَالِمٌ لِّنَفۡسِهِۦ","أي: بِأن وقَعَ في بَعْضِ المعاصِي."],[11,11,"مُّقۡتَصِدٌ","أي: بِأَداءِ الواجِباتِ واجْتِنابِ المُحَرَّماتِ."],[13,14,"سَابِقُۢ بِٱلۡخَيۡرَٰتِ","أي: مُسارعٌ مُجْتَهِدٌ في الأعْمالِ الصّالحةِ فَرْضِها ونَفْلِها."]],"33":[[3,3,"يُحَلَّوۡنَ","يُزيَّنُونَ بالحِلْيةَ."],[6,6,"أَسَاوِرَ","مُفْرَدُه سِوارٌ: وهو ما يُلْبَسُ في اليدِ مِنَ الحُلِيِّ ويُحِيطُ بالمِعْصَمِ."],[12,12,"حَرِيرٌ","ثِيابٌ رَقِيقَةٌ."]],"34":[[6,6,"ٱلۡحَزَنَ","أي: كُلَّ ما يُحْزِنُ ويُغِمُّ."]],"35":[[1,1,"أَحَلَّنَا","أنزَلنا."],[2,3,"دَارَ ٱلۡمُقَامَةِ","دارَ الإقامةِ الدّائمةِ، وهي الجنَّةُ."],[9,9,"نَصَبٌ","تَعَبٌ ومَشَقَّةٌ."],[13,13,"لُغُوبٌ","إعياءٌ مِنَ التَّعَبِ وفُتُورٌ."]],"36":[[5,7,"لَا يُقۡضَىٰ عَلَيۡهِمۡ","أي: بالموتِ."],[17,17,"كَفُورٍ","مُتَمادٍ في الكُفْرِ مُصِرٍّ عليه."]],"37":[[1,1,"يَصۡطَرِخُونَ","يَصْرُخُونَ بِشِدَّةٍ مُسْتَغِيثِينَ."],[13,17,"مَّا يَتَذَكَّرُ فِيهِ مَن تَذَكَّرَ","أي: مِثْلُه كافٍ للاتِّعاظِ لِمنْ أرادَ أن يَتَّعِظَ فِيهِ."],[19,19,"ٱلنَّذِيرُ","وهو الرَّسولُ ﷺ."]],"39":[[3,3,"خَلَـٰٓئِفَ","يَخْلُفُ بَعْضُكُم بَعْضًا."],[17,17,"مَقۡتًا","بُغْضًا وغَضَبًا."],[23,23,"خَسَارًا","هَلاكًا وخُسْرانًا."]],"40":[[1,2,"أَرَءَيۡتُمۡ شُرَكَآءَكُمُ","أخْبرُونِي عَن شُركائِكُم."],[19,19,"ءَاتَيۡنَـٰهُمۡ","أعْطَيناهُم."],[32,32,"غُرُورًا","خِداعًا."]],"42":[[2,3,"جَهۡدَ أَيۡمَـٰنِهِمۡ","مُجْتَهِدِينَ فِيها بالحَلِفِ بأغْلَظِها."],[18,18,"نُفُورًا","بُعْدًا عَنِ الحقِّ وفِرارًا مِنه."]],"43":[[5,6,"لَا يَحِيقُ","لا يُحِيطُ ولا يَنْزِلُ."],[7,8,"ٱلۡمَكۡرُ ٱلسَّيِّئُ","أي: وبالُ مَكْرِهِم السَّيِّئِ."],[14,15,"سُنَّتَ ٱلۡأَوَّلِينَ","طَرِيقَةَ اللهِ فِيهِم وعادَتَهُ بِتَعْذِيبِهِم لِتكْذِيبِهِم."]],"44":[[18,18,"لِيُعۡجِزَهُۥ","لِيَفُوتَه."]],"45":[[1,1,"يُؤَاخِذُ","يُعاقِبُ."],[13,13,"يُؤَخِّرُهُمۡ","يُمْهِلُهُم."]]}