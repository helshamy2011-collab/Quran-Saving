{"1":[[0,1,"هَلۡ أَتَىٰ","قَدْ مَضى."],[4,6,"حِينٌ مِّنَ ٱلدَّهۡرِ","وقْتٌ طويلٌ مِنَ الزَّمانِ قَبلَ أن تُنفَخَ فيه الُّروحُ."],[7,10,"لَمۡ يَكُن شَيۡـًٔا مَّذۡكُورًا","لمَ يكُنْ شَيئًا يُذكرُ."]],"2":[[4,5,"نُّطۡفَةٍ أَمۡشَاجٍ","مِن نُّطْفَةٍ مُخْتَلِطَةٍ مِن مّاءِ الرَّجُلِ وماءِ المرأةِ."],[6,6,"نَّبۡتَلِيهِ","أي بتكاليفِ الشَّريعةِ."]],"3":[[1,1,"هَدَيۡنَـٰهُ","بيَّنّا له."],[2,2,"ٱلسَّبِيلَ","طَرِيقَ الهُدى والضَّلالِ."],[6,6,"كَفُورًا","جاحِدًا."]],"4":[[1,1,"أَعۡتَدۡنَا","أعْدَدْنا."],[3,3,"سَلَـٰسِلَاْ","حِلَقًا غَلِيظَةً مِن حَدِيدٍ تُشَدُّ بِها أرْجُلُهُم."],[4,4,"وَأَغۡلَـٰلًا","قُيُودًا تُغَلُّ بِها أيْدِيهِم."],[5,5,"وَسَعِيرًا","ونارًا يُحرَقُونَ بِها."]],"5":[[1,1,"ٱلۡأَبۡرَارَ","أهْلَ الطّاعةِ والإخلاصِ الَّذِينَ يُؤَدّونَ حقَّ اللهِ."],[4,4,"كَأۡسٍ","إناءٍ للخَمْرِ."],[6,6,"مِزَاجُهَا","ما خُلِطَ بالخمْرِ لِتَخْفِيفِ حِدَّتِهِ."],[7,7,"كَافُورًا","أحْسَنَ أنْواعِ الطِّيبِ."]],"6":[[1,2,"يَشۡرَبُ بِهَا","يَشْرَبُ مِنها."],[3,4,"عِبَادُ ٱللَّهِ","هم الأبرارُ."],[5,5,"يُفَجِّرُونَهَا","يَسْتَقُونَ مِنها حيثُ شاؤُوا."],[6,6,"تَفۡجِيرًا","إجراءً سَهْلا."]],"7":[[0,0,"يُوفُونَ","يُؤَدُّونَ وافيًا دُونَ نَقْصٍ ولا تَقْصِيرٍ."],[1,1,"بِٱلنَّذۡرِ","ما أوْجَبُوهُ على أنْفُسِهِم مِن فِعْلِ الخيرِ المُتَقرَّبِ بِهِ إلى اللهِ."],[2,3,"وَيَخَافُونَ يَوۡمًا","ويخافُونَ عِقابَ اللهِ يومَ القِيامةِ."],[6,6,"مُسۡتَطِيرًا","مُنْتَشِرًا."]],"8":[[2,3,"عَلَىٰ حُبِّهِۦ","مَعَ حُبِّهِم لَهُ وحاجَتِهِم إلَيهِ."],[4,4,"مِسۡكِينًا","مُحْتاجًا."],[5,5,"وَيَتِيمًا","وطِفْلًا ماتَ أبُوهُ ولا مالَ لَهُ."],[6,6,"وَأَسِيرًا","الَّذِي تَمَّ أسْرُهُ في الحرْبِ."]],"9":[[2,3,"لِوَجۡهِ ٱللَّهِ","اْبتِغاءَ مَرْضاةِ اللهِ."],[7,7,"جَزَآءً","عِوَضًا."]],"10":[[5,5,"عَبُوسًا","تَكْلَحُ فِيهِ الوُجُوهُ."],[6,6,"قَمۡطَرِيرًا","تَتَقَطَّبُ الجِباهُ مِن فَظاعَةِ أمْرِهِ."]],"11":[[5,5,"وَلَقَّىٰهُمۡ","جَعَلَهُم يَلْقَونَ."],[6,6,"نَضۡرَةً","نُورًا في وُجُوهِهِم."]],"13":[[0,0,"مُّتَّكِـِٔينَ","جالِسِينَ على وجْهِ التَّمَكُّنِ والرّاحَةِ."],[3,3,"ٱلۡأَرَآئِكِ","الأَسِرَّةِ المزيَّنَةِ بفاخرِ الثِّيابِ والسُّتُورِ."],[7,7,"شَمۡسًا","حرَّ شَمْسٍ؛ لِعَدَمِ وُجُودِها."],[9,9,"زَمۡهَرِيرًا","شِدّةَ بَرْدٍ."]],"14":[[0,1,"وَدَانِيَةً عَلَيۡهِمۡ","وقَريبةً مِنهُم."],[2,2,"ظِلَـٰلُهَا","أشْجارُ الجنَّةِ مُظَلَّلَةٌ عَليهِم."],[3,3,"وَذُلِّلَتۡ","وسُهِّلَ لَهُم."],[4,4,"قُطُوفُهَا","أخْذُ ثِمارِها."]],"15":[[0,1,"وَيُطَافُ عَلَيۡهِم","ويَدُورُ عَلَيهِم الَخَدمُ."],[2,4,"بِـَٔانِيَةٍ مِّن فِضَّةٍ","بأواني الطَّعامِ وأَوْعِيَتِهِ الفِضِّيَّةِ."],[7,7,"قَوَارِيرَا۠","مِنَ الزُّجاجِ."]],"16":[[3,4,"قَدَّرُوهَا تَقۡدِيرًا","قدَّرها السُّقاةُ على مِقْدارِ ما يَشْتَهِي الشارِبُونَ لا تَزِيدُ ولا تَنْقُصُ."]],"17":[[2,2,"كَأۡسًا","إناءً مَمْلُوءًا خمَرًا."],[4,4,"مِزَاجُهَا","ما تُخْلَطُ بِهِ."]],"18":[[3,3,"سَلۡسَبِيلًا","الماءُ السَّهْلُ المَساغِ."]],"19":[[2,2,"وِلۡدَٰنٌ","غِلْمانٌ دائِمُونَ."],[7,7,"لُؤۡلُؤًا","دُرًّا مُضِيئًا."],[8,8,"مَّنثُورًا","مُفَرَّقًا."]],"20":[[1,2,"رَأَيۡتَ ثَمَّ","أبْصَرْتَ أيَّ مَكانٍ في الجنَّةِ."]],"21":[[0,0,"عَـٰلِيَهُمۡ","يَعْلُوهُم ويُجَمِّلُ أبْدانَهُم."],[1,3,"ثِيَابُ سُندُسٍ خُضۡرٌ","ثِيابٌ بطائِنُها مِنَ الحريرِ الرَّقِيقِ الأخْضَرِ."],[4,4,"وَإِسۡتَبۡرَقٌ","وظاهِرُها مِنَ الحريرِ الغلِيظِ."],[5,5,"وَحُلُّوٓاْ","وأُلْبِسُوا للزِّينَةِ."],[6,6,"أَسَاوِرَ","جَمْعُ سِوارٍ، وهو ما يُلْبسُ في المِعْصَمِ مِنَ الحُليِّ."],[12,12,"طَهُورًا","لا رِجْسَ فِيهِ ولا دَنَسَ."]],"22":[[6,6,"سَعۡيُكُم","عَمَلُكُم في الدُّنيا."],[7,7,"مَّشۡكُورًا","مَرْضِيًّا عِنْدَ اللهِ مَقْبُولًا."]],"24":[[0,2,"فَٱصۡبِرۡ لِحُكۡمِ رَبِّكَ","فاصْبِرْ لحُكْمِ رَبِّكَ القَدَريِّ واقْبَلْهُ، ولِحُكْمِهِ الدِّينِيِّ فامْضِ عَلَيهِ."],[6,6,"ءَاثِمًا","عاصِيًا."],[7,8,"أَوۡ كَفُورًا","أو مُبالِغًا في الكُفْرِ والضَّلالِ."]],"25":[[3,3,"بُكۡرَةً","أوَّلَ النَّهارِ."],[4,4,"وَأَصِيلًا","آخِرَ النَّهارِ."]],"26":[[2,3,"فَٱسۡجُدۡ لَهُۥ","فاخْضَعْ لِربِّكَ."],[4,4,"وَسَبِّحۡهُ","وصَلِّ لَهُ، وتهجَّدْ لَهُ."]],"27":[[3,3,"ٱلۡعَاجِلَةَ","الدُّنيا."],[7,7,"ثَقِيلًا","عَظِيمَ الشَّدائِدِ."]],"28":[[2,2,"وَشَدَدۡنَآ","وأحكمنا."],[3,3,"أَسۡرَهُمۡ","خَلْقَهُم."],[6,7,"بَدَّلۡنَآ أَمۡثَـٰلَهُمۡ","أهْلَكْناهُم، وجِئْنا بِقَوْمٍ مُطِيعِينَ."]],"29":[[2,2,"تَذۡكِرَةٌ","عِظَةٌ للعالَمِينَ."],[8,8,"سَبِيلًا","طَرِيقًا يُوصِلُهُ إلى مَغْفِرَةِ اللهِ ورِضْوانِهِ."]]}