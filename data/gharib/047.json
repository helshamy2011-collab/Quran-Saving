{"1":[[6,6,"أَضَلَّ","أبْطلَ."]],"2":[[13,13,"كَفَّرَ","سَتَرَ."],[17,17,"بَالَهُمۡ","شَأْنَهُم."]],"3":[[14,14,"يَضۡرِبُ","يُبَيِّنُ."],[17,17,"أَمۡثَـٰلَهُمۡ","أحُوالَهُم الَّتي تُميِّزُهُم."]],"4":[[1,1,"لَقِيتُمُ","قاتَلْتُم."],[4,5,"فَضَرۡبَ ٱلرِّقَابِ","فاضْرِبُوا مِنهُم الأَعْناقَ."],[8,8,"أَثۡخَنتُمُوهُمۡ","أضْعَفْتُمُوهُم بِكَثْرةِ القَتْلِ وبالَغْتُم في قَتْلِهِم."],[9,9,"فَشُدُّواْ","فأحْكِمُوا."],[10,10,"ٱلۡوَثَاقَ","قَيْدَ الأسْرىَ."],[12,12,"مَنَّۢا","إطْلاقًا مِنَ الأَسْرِ."],[15,15,"فِدَآءً","مُبادَلةً بالمالِ أو بأسْرى مُسْلِمِينَ."],[16,19,"حَتَّىٰ تَضَعَ ٱلۡحَرۡبُ أَوۡزَارَهَا","حَتّى يَنْتَهِيَ الُمحارِبُونَ عَنْ قِتالِكُم."]],"6":[[2,2,"عَرَّفَهَا","بَيَّنها."]],"8":[[2,2,"فَتَعۡسًا","فَخِزْيًا لَهُم وشَقاءً وبَلاءً."]],"9":[[6,6,"فَأَحۡبَطَ","فَأَبْطَلَ."]],"10":[[15,15,"أَمۡثَـٰلُهَا","أمْثالُ عاقِبةِ تَكْذِيبِ الأُمَمِ السّابِقةِ مِنَ التَّدْمِيرِ والهَلاكِ."]],"11":[[3,3,"مَوۡلَىٰ","ولِيٌّ وناصِرٌ."]],"12":[[20,20,"مَثۡوًى","مَنزِلٌ."]],"13":[[0,2,"وَكَأَيِّن مِّن قَرۡيَةٍ","وكَثِيرٍ مِن أهْلِ قَرْيَةٍ."],[6,7,"مِّن قَرۡيَتِكَ","مِن أهْلِ قَرْيَتِكَ."]],"15":[[0,0,"مَّثَلُ","صِفَةُ."],[10,10,"ءَاسِنٍ","مُتَغَيِّرٍ."],[20,20,"لَّذَّةٍ","ذاتِ لَذّةٍ."],[41,41,"حَمِيمًا","تَناهى في شِدَّةِ حَرِّهِ."]],"16":[[15,15,"ءَانِفًا","الآنَ، أي أوَّلَ وقْتٍ يَقْرُبُ مِنّا."],[18,18,"طَبَعَ","خَتَمَ."]],"18":[[0,1,"فَهَلۡ يَنظُرُونَ","فَما يَنْتَظِرُونَ."],[6,6,"بَغۡتَةً","فَجْأَةً."],[9,9,"أَشۡرَاطُهَا","عَلاماتُها."],[14,14,"ذِكۡرَىٰهُمۡ","تَذَكُّرُهُم ما ضَيَّعُوا مِن طاعَةِ اللهِ."]],"19":[[12,12,"مُتَقَلَّبَكُمۡ","تَصَرُّفَكُم في يَقَظَتِكُم نَهارًا."],[13,13,"وَمَثۡوَىٰكُمۡ","ومُسْتَقَرَّكُم في نَوْمِكُم لَيلًا."]],"20":[[3,3,"لَوۡلَا","هَلّا."],[9,9,"مُّحۡكَمَةٌ","لا نَسْخَ فِيها."],[17,17,"مَّرَضٌ","شَكٌّ في دينِ اللهِ ونِفاقٌ."],[21,22,"ٱلۡمَغۡشِيِّ عَلَيۡهِ","المُحْتضَرِ الذَّي في سَكْرةِ الموتِ لا يَطْرِفُ بَصَرُه."],[23,24,"مِنَ ٱلۡمَوۡتِ","خَوْفَ الموتِ."],[25,26,"فَأَوۡلَىٰ لَهُمۡ","ولِيَهُم شرٌّ فَلْيَحْذَرُوا."]],"21":[[4,5,"عَزَمَ ٱلۡأَمۡرُ","جَدَّ وعُزِمَ عَلَيهِ."]],"22":[[0,1,"فَهَلۡ عَسَيۡتُمۡ","فَلَعَلَّكُم."],[3,3,"تَوَلَّيۡتُمۡ","أعْرَضْتُم."]],"23":[[2,2,"لَعَنَهُمُ","أبْعَدَهُم."]],"24":[[1,1,"يَتَدَبَّرُونَ","يتأمَّلُونَ."],[3,3,"أَمۡ","بَلْ."],[4,6,"عَلَىٰ قُلُوبٍ أَقۡفَالُهَآ","قُلُوبُهم مُقْفَلَةٌ فلا يَصِلُ إلَيها ذِكْرُ اللهِ."]],"25":[[12,12,"سَوَّلَ","زَيَّنَ."],[14,15,"وَأَمۡلَىٰ لَهُمۡ","أطالَ لَهُم أمَلَهُم."]],"27":[[0,0,"فَكَيۡفَ","فَكَيفَ حالُهُم؟"],[2,2,"تَوَفَّتۡهُمُ","قَبَضَتْ أرْواحَهُم."]],"29":[[0,1,"أَمۡ حَسِبَ","بَلْ أظَنَّ؟"],[10,10,"أَضۡغَـٰنَهُمۡ","أحْقادَهُم وعَداوَتَهُم."]],"30":[[4,4,"بِسِيمَـٰهُمۡ","بِعَلاماتٍ ظاهِرَةٍ فِيهِم."],[7,8,"لَحۡنِ ٱلۡقَوۡلِ","فَحْوى الكلامِ ومَعْناهُ."]],"31":[[0,0,"وَلَنَبۡلُوَنَّكُمۡ","ولَنَخْتَبِرَنَّكُم."]],"32":[[7,7,"وَشَآقُّواْ","وخالَفُوا."],[19,19,"وَسَيُحۡبِطُ","وسَيُبْطِلُ."]],"35":[[4,4,"ٱلسَّلۡمِ","الصُّلْحِ."],[10,10,"يَتِرَكُمۡ","يَنْقُصَكُم."]],"37":[[2,2,"فَيُحۡفِكُمۡ","فيُلِحَّ عليكُم، ويُبالِغْ في طَلَبِها."]]}