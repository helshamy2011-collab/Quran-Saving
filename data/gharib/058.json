{"1":[[5,5,"تُجَـٰدِلُكَ","تُراجِعُكَ الكَلامَ في زَوْجِها وهي خَوْلَةُ بِنْتُ ثَعْلَبةَ وزَوْجُها أوسُ بنُ الصّامتِ."],[13,13,"تَحَاوُرَكُمَآ","تَخاطُبَكُما ومُراجَعَتَكُما الكَلامَ."]],"2":[[1,1,"يُظَـٰهِرُونَ","يَقُولُ الرَّجُلُ مِنهُم لِزوجَتِهِ: «أنْتِ عَليَّ كَظَهْرِ أُمِّي» أي في حُرْمَةِ النِّكاحِ."]],"3":[[4,7,"ۡ ثُمَّ يَعُودُونَ لِمَا قَالُواْ","ثُمَّ يَرْجِعُونَ عَن قَوْلِهِم ويَعْزِمُونَ على وطْءِ نِسائِهِم."],[13,13,"يَتَمَآسَّا","يَمَسَّ أحَدُهُما الآخَرَ، وهي كِنايةٌ عَنِ الِجماعِ."]],"4":[[15,15,"مِسۡكِينًا","هو الَّذِي لا يَمْلِكُ ما يَكْفِيهِ ويَسُدُّ حاجَتَهُ."]],"5":[[2,2,"يُحَآدُّونَ","يُشاقُّونَ ويُخالِفُونَ."],[5,5,"كُبِتُواْ","خُذِلُوا وأُهِينُوا."],[17,17,"مُّهِينٌ","مُذِلٌّ."]],"6":[[7,8,"أَحۡصَىٰهُ ٱللَّهُ","كَتَبهُ في اللَّوح المحْفُوظِ، وحَفِظَهُ عَلَيهم في صحائفِ أعْمالِهِم."],[14,14,"شَهِيدٌ","شاهِدٌ يَعْلَمُهُ ويُحِيطُ بِهِ، فلا يعْزُبُ عنه شَيءٌ مِنهُ."]],"7":[[14,14,"نَّجۡوَىٰ","مُناجاةٍ ومُسارَّةٍ وما يَكْتُمُهُ النّاسُ مِن أحادِيثِهِم."],[17,18,"هُوَ رَابِعُهُمۡ","مُشاهِدُهُم بِعِلْمِهِ، وهو عَلى عَرْشِهِ."],[24,27,"وَلَآ أَدۡنَىٰ مِن ذَٰلِكَ","ولا أقَلَّ مِن ذَلِكَ."],[31,32,"هُوَ مَعَهُمۡ","بِعِلْمِه وهُوَ فَوْقَ العَرْشِ."]],"8":[[6,6,"ٱلنَّجۡوَىٰ","حَدِيثِ السِّرِّ الَّذِي يُثيرُ الشَّكَ في نُفُوسِ المؤمِنينَ."],[12,12,"وَيَتَنَـٰجَوۡنَ","يَتَحَدَّثُونَ سِرًّا."],[19,19,"حَيَّوۡكَ","سَلَّمُوا عَلَيكَ."],[33,33,"حَسۡبُهُمۡ","كافِيهِم مِنَ العَذابِ."],[35,35,"يَصۡلَوۡنَهَا","يَدْخُلُونَها ويُقاسُونَ حَرَّها."],[36,37,"فَبِئۡسَ ٱلۡمَصِيرُ","فَساءَ المنْقَلَبُ والمرْجِعُ."]],"11":[[6,6,"تَفَسَّحُواْ","لِيُوسِّعْ بَعْضُكُم لِبَعْضٍ المَجالِسَ."],[10,12,"يَفۡسَحِ ٱللَّهُ لَكُمۡ","يُوَسِّعِ اللهُ عَلَيكُم في الدُّنيا والآخِرةِ."],[15,15,"ٱنشُزُواْ","قُومُوا من مجالِسِكُم."],[17,17,"يَرۡفَعِ","يَرْفَعْ مَكانَةً."],[25,25,"دَرَجَـٰتٍ","مَراتِبَ رَفِيَعةً في دِينِهِم."]],"12":[[4,5,"نَـٰجَيۡتُمُ ٱلرَّسُولَ","أرَدْتُم أن تُكَلِّمُوا رَسُولَ اللهِ ﷺ سرًّا."],[14,14,"وَأَطۡهَرُ","وأَزْكى لِقُلُوبِكُم مِنَ المأثَمِ."]],"13":[[0,0,"ءَأَشۡفَقۡتُمۡ","أخَشِيتُم الفَقْرَ عَقِبَ تَقْدِيمِ الصَّدَقةِ؟"]],"14":[[4,5,"تَوَلَّوۡاْ قَوۡمًا","اتخذوهم أصدقاءَ يُحِبُّونهم وينصرونهم."]],"16":[[2,2,"جُنَّةً","وِقايِةً وسِتْرَةً."],[9,9,"مُّهِينٌ","مُذِلٌّ في النّارِ."]],"17":[[0,1,"لَّن تُغۡنِيَ","لَن تَدْفَعَ."]],"19":[[0,0,"ٱسۡتَحۡوَذَ","غَلَبَ واسْتَولى."],[3,3,"فَأَنسَىٰهُمۡ","جَعَلَهُم يَتْرُكُونَ."],[4,5,"ذِكۡرَ ٱللَّهِ","تَوْحِيدَ اللهِ، والعَمَلَ بِطاعَتِهِ."]],"20":[[2,2,"يُحَآدُّونَ","يُخالِفُونَ."],[7,7,"ٱلۡأَذَلِّينَ","مِن جُمْلةِ الأذِلّاءِ المغلوبِينَ المهانِينَ."]],"21":[[0,0,"كَتَبَ","قَضى وكَتَبَ في اللَّوحِ المحْفُوظِ."],[2,2,"لَأَغۡلِبَنَّ","لَتَكونَنَّ الغَلَبةُ بِالقُوَّةِ للهِ ولِرُسُلِهِ."],[8,8,"عَزِيزٌ","مانِعٌ حِزْبَهُ مِن أن يُذَلَّ."]],"22":[[7,7,"يُوَآدُّونَ","يُحِبُّونَ ويُوالُونَ."],[9,9,"حَآدَّ","عادى."],[20,20,"عَشِيرَتَهُمۡ","أقْرِباءَهُم."],[22,22,"كَتَبَ","ثَبَّتَ."],[26,26,"وَأَيَّدَهُم","قَوّاهُم."],[27,27,"بِرُوحٍ","بِنَصْرٍ وتأْيِيدٍ."],[43,44,"حِزۡبَ ٱللَّهِ","أولياؤُهُ."],[50,50,"ٱلۡمُفۡلِحُونَ","الفائِزُونَ بِسَعادةِ الدُّنيا والآخِرَةِ."]]}