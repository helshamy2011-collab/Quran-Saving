{"1":[[0,0,"حمٓ","سَبَقَ الكَلامُ على الحُرُوفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرةِ."]],"2":[[0,0,"وَٱلۡكِتَـٰبِ","القُرآنِ."],[1,1,"ٱلۡمُبِينِ","الواضِح لَفْظًا ومَعْنىً."]],"4":[[2,3,"أُمِّ ٱلۡكِتَـٰبِ","اللَّوحِ المحْفُوظِ."],[5,5,"لَعَلِيٌّ","رَفِيعٌ."],[6,6,"حَكِيمٌ","مُحْكَمٌ لا اخْتِلافَ فِيهِ ولا تَناقُضَ."]],"5":[[0,2,"أَفَنَضۡرِبُ عَنكُمُ ٱلذِّكۡرَ","أفَنُعْرِضُ عَنْكُم ونَتْرُكُ إنْزالَ القُرآنِ إلَيكُم."],[3,3,"صَفۡحًا","أي: إعْراضًا."],[7,7,"مُّسۡرِفِينَ","مُتَجاوِزِينَ الحدَّ في الإعْراضِ عَنِ القُرآنِ."]],"6":[[0,0,"وَكَمۡ","كَثِيرًا."],[5,5,"ٱلۡأَوَّلِينَ","القُرُونِ الَّتي مَضَتْ."]],"8":[[3,3,"بَطۡشًا","قُوَّةً وبأسًا."],[5,5,"مَثَلُ","عُقُوبةُ."]],"10":[[4,4,"مَهۡدًا","فِراشًا وبِساطًا."],[8,8,"سُبُلًا","طُرُقًا لِمَعاشِكُم ومَتاجِرِكُم."]],"11":[[4,4,"مَآءَۢ","مَطَرًا."],[5,5,"بِقَدَرٍ","بِمِقْدارِ الحاجَةِ."],[6,6,"فَأَنشَرۡنَا","فَأَحْيَيْنا."],[8,8,"بَلۡدَةً","قِطْعَةً واسِعَةً مِنَ الأرْضِ."],[9,9,"مَّيۡتًا","مُقْفِرًا مِنَ النَّباتِ والزَّرْعِ."],[11,11,"تُخۡرَجُونَ","تُبْعَثُونَ يومَ القيامةِ."]],"12":[[2,2,"ٱلۡأَزۡوَٰجَ","الأصْنافَ مِن حَيوانٍ ونَباتٍ ذُكُورًا وإناثًا."],[7,7,"ٱلۡفُلۡكِ","السُّفُنِ."],[8,8,"وَٱلۡأَنۡعَـٰمِ","البَهائِمِ كالإبِلِ والخيلِ والبِغالِ والحمِيرِ."]],"13":[[13,13,"سَخَّرَ","ذَلَّلَ وطَوَّعَ."],[19,19,"مُقۡرِنِينَ","مُطِيقِينَ."]],"14":[[3,3,"لَمُنقَلِبُونَ","راجِعُونَ."]],"15":[[4,4,"جُزۡءًا","نَصِيبًا."]],"16":[[0,0,"أَمِ","بَلِ."],[1,1,"ٱتَّخَذَ","أتَزْعُمُونَ أنَّ الله اتَّخَذَ."],[5,5,"وَأَصۡفَىٰكُم","وأَخْلَصَكُم."]],"17":[[4,4,"ضَرَبَ","جَعَلَ."],[6,6,"مَثَلًا","شبيهًا."],[7,7,"ظَلَّ","صارَ."],[11,11,"كَظِيمٌ","حَزِينٌ مملُوءٌ بالهَمِّ والكَرْبِ."]],"18":[[1,1,"يُنَشَّؤُاْ","يُرَبّى."],[3,3,"ٱلۡحِلۡيَةِ","الزِّينةِ."],[6,6,"ٱلۡخِصَامِ","الِجدالِ."]],"19":[[7,8,"أَشَهِدُواْ خَلۡقَهُمۡ","أحَضَرُوا حِينَ خَلْقِهِم؟"]],"20":[[14,14,"يَخۡرُصُونَ","يَكْذِبُونَ."]],"21":[[7,7,"مُسۡتَمۡسِكُونَ","يَعْمَلُونَ به ويَدِينُونَ بما فِيهِ."]],"22":[[6,6,"أُمَّةٍ","طَرِيقةٍ ودِينٍ."],[8,9,"عَلَىٰٓ ءَاثَـٰرِهِم","وراءَهُم."],[10,10,"مُّهۡتَدُونَ","مُتَّبِعُونَ."]],"23":[[11,11,"مُتۡرَفُوهَآ","الرُّؤَساءُ الَّذيِنَ أطْغَتْهُم النِّعْمَةُ."]],"25":[[0,1,"فَٱنتَقَمۡنَا مِنۡهُمۡ","عاقَبْناهُم على ذُنُوبِهِم."],[5,5,"عَـٰقِبَةُ","آخِرُ أمْرٍ."]],"26":[[6,6,"بَرَآءٌ","بَرِيءٌ."]],"27":[[2,2,"فَطَرَنِي","خَلَقَنِي."],[4,4,"سَيَهۡدِينِ","سَيُوَفِّقُنِي لاتِّباعِ سَبِيلِ الرُّشْدِ."]],"28":[[0,2,"وَجَعَلَهَا كَلِمَةَۢ بَاقِيَةً","وجَعَلَ إبْراهِيمُ كَلِمةَ التَّوحِيدِ قَوْلًا باقِيًا على مَرِّ الزَّمانِ."],[4,4,"عَقِبِهِۦ","ولَدِهِ مِن بَعْدِهِ."]],"29":[[1,1,"مَتَّعۡتُ","أجْزَلْتُ النِّعمَةَ ولَمْ أُعاجِلْ بالعُقُوبَةِ."],[6,6,"ٱلۡحَقُّ","القُرَآنُ."],[8,8,"مُّبِينٌ","يُبَيِّنُ لَهُم مّا يَحْتاجُونَ إلَيهِ مِن أُمُورِ دِينِهِم."]],"31":[[1,1,"لَوۡلَا","هَلّا."],[8,8,"ٱلۡقَرۡيَتَيۡنِ","مَكَّةَ والطّائِفِ."]],"32":[[2,3,"رَحۡمَتَ رَبِّكَ","النُّبُوَّةُ."],[19,19,"سُخۡرِيًّا","مُذَلَّلًا في شُؤُونِ المعاشِ."],[20,21,"وَرَحۡمَتُ رَبِّكَ","النُّبُوَّةُ."],[23,24,"مِّمَّا يَجۡمَعُونَ","مِنَ الأمْوالِ."]],"33":[[4,5,"أُمَّةً وَٰحِدَةً","جماعَةً واحِدَةً، كُلُّهُم كُفّارٌ."],[14,14,"وَمَعَارِجَ","وسَلالِمَ."],[16,16,"يَظۡهَرُونَ","يَصْعَدُونَ."]],"34":[[2,2,"وَسُرُرًا","جَمْعُ سَرِيرٍ، وهو ككرْسِيٍّ واسِعٍ يُمْكِنُ الاضْطِجاعُ عَلَيهِ."],[4,4,"يَتَّكِـُٔونَ","يَجْلِسُونَ عَلَيها مُعْتَمِدِينَ على مَرافِقِهِم."]],"35":[[0,0,"وَزُخۡرُفًا","وجَعَلْنا لهم ذَهَبًا."]],"36":[[1,1,"يَعۡشُ","يُعرِضْ."],[3,4,"ذِكۡرِ ٱلرَّحۡمَـٰنِ","القرآن."],[5,5,"نُقَيِّضۡ","نَجْعَلْ."],[10,10,"قَرِينٌ","مُلازِمٌ ومُصاحِبٌ."]],"37":[[3,3,"ٱلسَّبِيلِ","طَرِيقِ الحقِّ"]],"38":[[4,4,"يَـٰلَيۡتَ","ودِدْتُّ وتمنَّيتُ."],[7,8,"بُعۡدَ ٱلۡمَشۡرِقَيۡنِ","بُعْدَ ما بَينَ المشْرِقِ والمغْرِبِ."]],"44":[[1,1,"لَذِكۡرٌ","لَشَرَفٌ."]],"45":[[1,2,"مَنۡ أَرۡسَلۡنَا","أتْباعَ مَن أرْسَلْنا، وهُم مُّؤمِنُو أهْلِ الكِتابِ."]],"46":[[3,3,"بِـَٔايَـٰتِنَآ","بِحُجَجِنا."],[6,6,"وَمَلَإِيْهِۦ","عُظَماءِ قَومِهِ."]],"48":[[7,8,"مِنۡ أُخۡتِهَا","مِنَ الَّتِي قَبْلَها."]],"49":[[2,2,"ٱلسَّاحِرُ","العالِمُ، ولَمْ يَكُنِ السِّحْرُ صِفَةَ ذَمٍّ عِنْدَ فِرْعَونَ ومَلَئِهِ."]],"50":[[6,6,"يَنكُثُونَ","يغْدِرُونَ ويَنْقُضُونَ ما عاهَدُوا عليهِ أنْفُسَهُم."]],"51":[[13,14,"مِن تَحۡتِيٓ","مِن تَحْتِ قُصُورِي."]],"52":[[0,0,"أَمۡ","بَلْ."],[7,7,"مَهِينٌ","ضَعِيفٌ حَقِيرٌ."],[10,10,"يُبِينُ","أي: يُبِين الكَلامَ."]],"53":[[0,0,"فَلَوۡلَآ","فَهَلّا."],[10,10,"مُقۡتَرِنِينَ","مُتَتابِعِينَ."]],"54":[[0,1,"فَٱسۡتَخَفَّ قَوۡمَهُۥ","حَمَلَ قَومَه عَلى خفَّةِ العَقْل."]],"55":[[1,1,"ءَاسَفُونَا","أغْضَبُونا."],[2,3,"ٱنتَقَمۡنَا مِنۡهُمۡ","عاقَبْناهُم عَلى ذُنُوبِهم."]],"56":[[1,1,"سَلَفًا","قَوْمًا تَقَدَّمُوا لِيتَّعِظَ بِهِمُ الآخَرُونَ."],[2,2,"وَمَثَلًا","عِبْرةً وعِظَةً."]],"57":[[1,4,"ضُرِبَ ٱبۡنُ مَرۡيَمَ مَثَلًا","ضَرَبَ المشركُونَ نَبِيَّ اللهِ عِيسى مَثَلًا لِآلِهَتِهِم وشَبَّهُوهُ بِها في دُخُولِ النّارِ."],[8,8,"يَصِدُّونَ","يَصِيحُونَ فَرَحًا وسُرُورًا."]],"58":[[13,13,"خَصِمُونَ","شِدِيدُو التَّمَسُكِ بالخُصُومَةِ مَعَ ظُهُورِ الحقِّ عِنْدَهُم."]],"59":[[7,9,"مَثَلًا لِّبَنِيٓ إِسۡرَٰٓءِيلَ","عِبْرةً لَهُم يَعْرِفُونَ بِهِ قُدْرَةَ اللهِ عَلى ما يُرِيدُ؛ إذْ خَلَقَهُ مِن غَيرِ أبٍ."]],"60":[[3,3,"مِنكُم","بَدَلًا مِنكُم."],[7,7,"يَخۡلُفُونَ","يَخْلُفُ بَعْضُهُم بَعْضًا بَدَلًا مِن بنِي آدمَ."]],"61":[[0,0,"وَإِنَّهُۥ","وإنّ نُزولَ عِيسى عَلَيهِ السَّلامُ في آخِرِ الزَّمانِ."],[1,1,"لَعِلۡمٌ","لَدَلِيلٌ وعَلامةٌ."],[3,4,"فَلَا تَمۡتَرُنَّ","فَلا تَشُكُّوا أنّها واقِعةٌ."]],"62":[[6,6,"مُّبِينٌ","بَيِّنُ العَداوَةِ."]],"63":[[3,3,"بِٱلۡبَيِّنَـٰتِ","بالأدِلَّةِ الواضِحاتِ."],[7,7,"بِٱلۡحِكۡمَةِ","بالنُّبُوَّةِ."]],"65":[[1,1,"ٱلۡأَحۡزَابُ","الفِرَقُ مِنَ النَّصارى."],[4,4,"فَوَيۡلٌ","فَهَلاكٌ وعَذابٌ ألِيمٌ."]],"66":[[1,1,"يَنظُرُونَ","يَنْتَظِرُونَ."],[6,6,"بَغۡتَةً","فَجْأةً."]],"67":[[0,0,"ٱلۡأَخِلَّآءُ","الأصْدِقاءُ."]],"70":[[3,3,"وَأَزۡوَٰجُكُمۡ","وقُرَناؤُكُم المؤمِنُونَ."],[4,4,"تُحۡبَرُونَ","تُنَعَّمُونَ وتُسَرُّونَ."]],"71":[[2,2,"بِصِحَافٍ","بآنِيةٍ يُؤْكَلُ فِيها."],[5,5,"وَأَكۡوَابٍ","آنِيَةٍ للشُّرْبِ."],[10,10,"وَتَلَذُّ","وتَجِدُ فِيها ما يَسُرُّها."]],"74":[[1,1,"ٱلۡمُجۡرِمِينَ","الكافِرينَ."]],"75":[[0,1,"لَا يُفَتَّرُ","لا يُخَفَّفُ."],[5,5,"مُبۡلِسُونَ","آيِسُونَ مِن رَّحْمَةِ اللهِ."]],"77":[[1,1,"يَـٰمَـٰلِكُ","هو اسْمُ خازِنِ جَهَنَّمَ."],[2,4,"لِيَقۡضِ عَلَيۡنَا رَبُّكَ","لِيُمِتْنا ربُّكَ."],[7,7,"مَّـٰكِثُونَ","مُقِيمُونَ في العذابِ."]],"79":[[0,0,"أَمۡ","بَلْ."],[1,1,"أَبۡرَمُوٓاْ","أحْكَمُوا."],[4,4,"مُبۡرِمُونَ","مُحْكِمُونَ أمْرًا في مُجازاتِهم بِالنَّكالِ والعَذابِ."]],"80":[[5,5,"سِرَّهُمۡ","ما يُخْفُونَه مِن غَيرِهِم."],[6,6,"وَنَجۡوَىٰهُم","الحدِيثَ الَّذِي يَتَسارُّونَ بِهِ فِيما بَينَهُم."],[8,8,"وَرُسُلُنَا","الملائِكَةُ الحَفَظَةُ."]],"81":[[5,7,"فَأَنَا۠ أَوَّلُ ٱلۡعَـٰبِدِينَ","أوَّلُ عابِدِيهِ بِذلكَ مِنكُم، ولَكِنَّهُ لا ولَدَ لَهُ، فأَنا أعْبُدُهُ بِأنّه لا ولَدَ لَهُ."]],"82":[[0,0,"سُبۡحَـٰنَ","تنْزِيهًا وتَقْدِيسًا."],[7,7,"يَصِفُونَ","يَكْذِبُونَ."]],"83":[[1,1,"يَخُوضُواْ","يَتَحَدَّثُوا بالباطِل على غيرِ هُدىً."]],"84":[[2,7,"فِي ٱلسَّمَآءِ إِلَـٰهٌ وَفِي ٱلۡأَرۡضِ إِلَـٰهٌ","مَعْبُودٌ في السَّماءِ وفي الأَرْضِ."]],"85":[[0,0,"وَتَبَارَكَ","كَثُرَ خَيْرُهُ."],[12,12,"تُرۡجَعُونَ","تُرَدُّونَ بَعْدَ مَماتِكُم."]],"86":[[6,6,"ٱلشَّفَـٰعَةَ","طَلَبَ قَضاءِ حاجَةِ المشْفُوعِ لَهُ عِنْدَ المشْفُوعِ عِنْدَهُ مِنَ التَّجاوُزِ عَنِ السَّيئاتِ والزَّلّاتِ وغَيرِها."]],"87":[[6,7,"فَأَنَّىٰ يُؤۡفَكُونَ","كَيْفَ يُصْرَفُونَ عَنْ عِبادَةِ الله؟"]],"88":[[0,0,"وَقِيلِهِۦ","وعِنْدَ اللهِ عِلْمُ قولِ الرَّسُولِ ﷺ."]],"89":[[0,0,"فَٱصۡفَحۡ","فَأَعْرِضْ."],[3,3,"سَلَـٰمٌ","سَلامُ مُتارَكَةٍ ومُفارَقَةٍ لِلْجاهِلِينَ."]]}