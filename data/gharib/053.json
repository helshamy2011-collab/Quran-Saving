{"1":[[2,2,"هَوَىٰ","غابَ."]],"2":[[4,4,"غَوَىٰ","خَرَجَ عنِ الرَّشادِ."]],"3":[[3,3,"ٱلۡهَوَىٰٓ","ما تَمِيلُ إلَيهِ النَّفْسُ مِن غَيرِ دَلِيلٍ."]],"5":[[1,2,"شَدِيدُ ٱلۡقُوَىٰ","مَلَكٌ شَدِيدُ القُوَّةِ."]],"6":[[1,1,"مِرَّةٍ","مَنظَرٍ حَسَنٍ."],[2,2,"فَٱسۡتَوَىٰ","عَلى صُورَتِهِ الحقِيقِيَّةِ للرَّسولِ ﷺ."]],"7":[[1,2,"بِٱلۡأُفُقِ ٱلۡأَعۡلَىٰ","أُفُقِ الشَّمسِ عِنْدَ مَطْلَعِها."]],"8":[[2,2,"فَتَدَلَّىٰ","فَزادَ في القُرْبِ."]],"9":[[1,2,"قَابَ قَوۡسَيۡنِ","مِقْدارَ قَوسَينِ."]],"11":[[2,2,"ٱلۡفُؤَادُ","قَلْبُه."]],"12":[[0,0,"أَفَتُمَـٰرُونَهُۥ","أتُكَذِّبُونَ مُحَمَّدًا ﷺ فَتُجادِلُونَه عَلى ما يَراهُ مِن آياتِ رَبِّهِ؟"]],"13":[[1,1,"رَءَاهُ","رَأى مُحَمّدٌ ﷺ جِبْرِيلَ."],[2,2,"نَزۡلَةً","مَرَّةً."]],"14":[[1,2,"سِدۡرَةِ ٱلۡمُنتَهَىٰ","شَجَرةِ نَبْقٍ في السَّماءِ السّابِعةِ، يَنْتَهي إلَيها ما يُعْرَجُ بِهِ مِنَ الأَرْضِ، وما يُهْبَطُ بِه مِن فَوْقِها."]],"16":[[1,2,"يَغۡشَى ٱلسِّدۡرَةَ","يُغَطِّيها ويَسْتُرُها."]],"17":[[1,1,"زَاغَ","مالَ."],[4,4,"طَغَىٰ","جاوَزَ ما أُمِرَ برُؤْيَتِهِ."]],"18":[[3,3,"ءَايَـٰتِ","دَلائلِ عَظَمةِ اللهِ."]],"19":[[1,2,"ٱللَّـٰتَ وَٱلۡعُزَّىٰ۞ وَمَنَوٰةَ","هي أصْنامٌ اتَّخَذَها العَربُ آلِهَةً."]],"20":[[1,2,"ٱلثَّالِثَةَ ٱلۡأُخۡرَىٰٓ","صِفَتا تأكيدٍ لمناةٍ."]],"22":[[3,3,"ضِيزَىٰٓ","جائِرةٌ."]],"23":[[12,12,"سُلۡطَـٰنٍ","حُجَّةٍ."],[18,18,"تَهۡوَى","تَشْتَهِيهِ وتَمِيلُ إلَيهِ."]],"24":[[3,3,"تَمَنَّىٰ","اشْتَهى."]],"26":[[0,2,"وَكَم مِّن مَّلَكٍ","وكَثِيرٍ مِنَ الملائِكَةِ."]],"27":[[7,8,"تَسۡمِيَةَ ٱلۡأُنثَىٰ","صِفَةَ الأُنْثى، وهي أن يُقالَ لَها: بِنْتٌ."]],"28":[[8,8,"ٱلظَّنَّ","التَّوهُّمَ الباطِلَ."],[11,12,"لَا يُغۡنِي","لا يُجدِي ولا يَقُومُ مَقامَ الحَقِّ."]],"30":[[1,3,"مَبۡلَغُهُم مِّنَ ٱلۡعِلۡمِ","مُنْتَهى عِلْمِهِم، لا عِلْمَ لَهُم فَوْقَهُ؛ والمرادُ ظَنُّهُم الفاسِدُ."]],"31":[[15,15,"بِٱلۡحُسۡنَى","بالجنَّةِ."]],"32":[[6,6,"ٱللَّمَمَ","الذُّنُوبَ الصِّغارَ الَّتِي لا يُصِرُّ صاحِبُها عَلَيها، أو يُلِمُّ بِها على وجْهِ النُّدْرَةِ."],[15,17,"أَنشَأَكُم مِّنَ ٱلۡأَرۡضِ","خَلَقَ أباكُم آدمَ مِن تُرابٍ."],[24,26,"فَلَا تُزَكُّوٓاْ أَنفُسَكُمۡ","فَتَمْدَحُوها بالتَّقْوى."]],"33":[[2,2,"تَوَلَّىٰ","أعْرَضَ عَن طاعَةِ اللهِ."]],"34":[[2,2,"وَأَكۡدَىٰٓ","تَوَقَّفَ عَنِ العَطاءِ."]],"36":[[5,6,"صُحُفِ مُوسَىٰ","هي أسْفارُ التَّوراةِ."]],"37":[[0,0,"وَإِبۡرَٰهِيمَ","وصُحُفِ إبراهِيمَ التي سُجِّل فيها ما أوْحى اللهُ إليهِ."],[2,2,"وَفَّىٰٓ","بَلَّغَ ما أُرْسِلَ بِه."]],"38":[[0,1,"أَلَّا تَزِرُ","أي لا تَحْمِلُ ولا تُؤاخَذُ."],[2,2,"وَازِرَةٌ","حاملةُ إثْمٍ."]],"39":[[1,5,"لَّيۡسَ لِلۡإِنسَـٰنِ إِلَّا مَا سَعَىٰ","لا يَحْصُلُ للإنسانِ مِنَ الأجْرِ إلّا ما كَسَبَ هُوَ لِنَفْسِهِ بِسَعْيِهِ."]],"40":[[1,1,"سَعۡيَهُۥ","عَمَلَه واكْتِسابَه."],[3,3,"يُرَىٰ","يُشاهَدُ عِنْدَ الحسابِ."]],"41":[[1,1,"يُجۡزَىٰهُ","يُجزى الإنسانُ عَلى سَعْيِهِ."],[3,3,"ٱلۡأَوۡفَىٰ","التامَّ الكامِلَ."]],"42":[[3,3,"ٱلۡمُنتَهَىٰ","انْتِهاءَ جَمِيعِ خَلْقِهِ ورُجُوعَهُم إلى حُكْمِهِ في الآخِرةِ."]],"43":[[2,3,"أَضۡحَكَ وَأَبۡكَىٰ","خَلَقَ في الإنْسانِ قُوَّتَي الضَّحِكِ والبُكاءِ وأَسْبابَهُما مِن سُرورٍ وحُزْنٍ."]],"44":[[2,3,"أَمَاتَ وَأَحۡيَا","انْفَرَدَ بالإماتَةِ والإحْياءِ."]],"46":[[1,1,"نُّطۡفَةٍ","ماءٍ قَلِيلٍ."],[3,3,"تُمۡنَىٰ","تُصَبُّ في الرَّحِمِ وتُقْذَفُ."]],"47":[[2,2,"ٱلنَّشۡأَةَ","الخَلقَ."],[3,3,"ٱلۡأُخۡرَىٰ","الأخِيَرةَ الَّتِي لا نَشْأَةَ بَعْدَها."]],"48":[[3,3,"وَأَقۡنَىٰ","أرضى الَّذِي أغْناهُ."]],"49":[[3,3,"ٱلشِّعۡرَىٰ","نَجْمٍ مُضِيءٍ كانَ يَعْبُدُهُ بَعْضُ أهْل الجاهِلِيَّةِ."]],"50":[[2,3,"عَادًا ٱلۡأُولَىٰ","قَوْمَ نَبِيِّ اللهِ هُودٍ عَلَيهِ السَّلامُ، وهي أوَّلُ العرَبِ البائِدةِ."]],"51":[[0,0,"وَثَمُودَاْ","قَوْمَ نَبِيِّ اللهِ صالِحٍ عَلَيهِ السَّلامُ."],[1,2,"فَمَآ أَبۡقَىٰ","فَما تَرَكَها بَلْ أهْلَكَها."]],"52":[[8,8,"وَأَطۡغَىٰ","أشَدَّ طَغْيانًا وتَمَرُّدًا على اللهِ."]],"53":[[0,0,"وَٱلۡمُؤۡتَفِكَةَ","هي القُرى المَخْسُوفُ بِها، المقلوبُ أعلاها أسفلها، وهي قُرى قَوْمِ لُوطٍ عَلَيهِ السَّلامُ."],[1,1,"أَهۡوَىٰ","أسْقَطَ، فَجَعَلَها هاوِيَةً."]],"54":[[0,2,"فَغَشَّىٰهَا مَا غَشَّىٰ","فَأَلْبَسَها ما ألْبَسَها مِنَ الحِجارَةِ المُتَتابِعَةِ النّازِلَةِ عَلَيهِم."]],"55":[[1,1,"ءَالَآءِ","نِعَمِ، جَمْعُ إلىً."],[3,3,"تَتَمَارَىٰ","تَتَشَكَّكُ."]],"56":[[0,0,"هَـٰذَا","الَّذِي أنْذَرْتُكُم بِهِ مِنَ الوقائِعِ."],[1,1,"نَذِيرٌ","إنْذارٌ."],[2,4,"مِّنَ ٱلنُّذُرِ ٱلۡأُولَىٰٓ","الَّتي أنْذَرْتُها الأُمَمَ الَّتي قَبْلَكُم."]],"57":[[0,0,"أَزِفَتِ","قَرُبَتْ."],[1,1,"ٱلۡـَٔازِفَةُ","القِيامَةُ."]],"58":[[0,5,"لَيۡسَ لَهَا مِن دُونِ ٱللَّهِ كَاشِفَةٌ","لا يَعْلَمُ بوَقْتِ وُقُوعِها إلّا اللهُ."]],"59":[[1,2,"هَـٰذَا ٱلۡحَدِيثِ","القرآنِ."],[3,3,"تَعۡجَبُونَ","مِن أن يَكُونَ صَحِيحًا."]],"60":[[0,0,"وَتَضۡحَكُونَ","مِنهُ سُخْرِيَةً واسْتِهْزاءً."],[1,2,"وَلَا تَبۡكُونَ","خَوْفًا مِن وعِيدِهِ."]],"61":[[1,1,"سَـٰمِدُونَ","لاهُونَ مُعْرِضُونَ عَنْهُ."]]}