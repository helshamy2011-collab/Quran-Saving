{"1":[[6,8,"وَجَعَلَ ٱلظُّلُمَـٰتِ وَٱلنُّورَ","وخَلَقَ سَوادَ الليلِ، وضياءَ النهارِ."],[13,13,"يَعۡدِلُونَ","يُشْرِكُون."]],"2":[[2,2,"خَلَقَكُم","خَلَقَ أباكم آدمَ."],[6,7,"قَضَىٰٓ أَجَلًا","قَدَّر مُدَّةَ بقائِكم في الدنيا."],[8,10,"وَأَجَلٌ مُّسَمًّى عِندَهُۥ","وقَدَّر أجلًا محدَّدًا هو يومُ القِيامةِ."],[13,13,"تَمۡتَرُونَ","تَشُكُّون في أمرِ الساعةِ."]],"3":[[7,8,"سِرَّكُمۡ وَجَهۡرَكُمۡ","ما تُخْفُونه، وما تُعْلِنُونه."],[10,11,"مَا تَكۡسِبُونَ","جميعَ أعمالِكم."]],"4":[[2,3,"مِّنۡ ءَايَةٍ","من دليلٍ على أنّ اللهَ حقُّ."]],"5":[[7,11,"أَنۢبَـٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","أخبارُ ما استَهْزَؤُوا به، وهو القرآنُ، أو محمدٌ ﷺ."]],"6":[[6,7,"مِّن قَرۡنٍ","من أمةٍ مُكَذِّبَةٍ."],[11,14,"مَا لَمۡ نُمَكِّن لَّكُمۡ","ما لم نُعْطِكم، كطُولِ الأعمارِ، وقوةِ الأبدانِ."],[18,18,"مِّدۡرَارًا","مطرًا كثيرًا."],[29,30,"قَرۡنًا ءَاخَرِينَ","أممًا أخرى."]],"7":[[3,5,"كِتَـٰبًا فِي قِرۡطَاسٍ","كتابًا مكتوبًا في صحيفةٍ."]],"8":[[4,4,"مَلَكًا","أي: لِيُصَدِّقَه، ويُنْذِرَ معه."],[8,9,"لَّقُضِيَ ٱلۡأَمۡرُ","بإهلاكِهم، والمعاجَلَةِ بعقوبتِهم."],[11,12,"لَا يُنظَرُونَ","لا يُمْهَلُون للتوبةِ."]],"9":[[0,1,"وَلَوۡ جَعَلۡنَـٰهُ","ولو جَعَلْنا الرسولَ المُرْسَلَ إلى النبيِّ ﷺ."],[5,8,"وَلَلَبَسۡنَا عَلَيۡهِم مَّا يَلۡبِسُونَ","ولَكان الأمرُ مختلِطًا عليهم بسببِ ما لَبَسُوه على أنفسِهم."]],"10":[[5,5,"فَحَاقَ","فَنَزَل وأحاطَ."],[9,12,"مَّا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","هو العذابُ الذي كانوا يستنكرونه."]],"13":[[1,2,"مَا سَكَنَ","ما استقرَّ."]],"14":[[4,4,"وَلِيًّا","مَعْبُودًا."],[5,5,"فَاطِرِ","خالقِ."],[19,19,"أَسۡلَمَ","انقادَ، واستسلمَ"]],"16":[[0,2,"مَّن يُصۡرَفۡ عَنۡهُ","أي: العذابُ."]],"18":[[1,1,"ٱلۡقَاهِرُ","الغالِبُ."]],"19":[[16,17,"وَمَنۢ بَلَغَ","كلَّ مَن بَلَغَه."]],"22":[[7,8,"أَيۡنَ شُرَكَآؤُكُمُ","أين آلهتُكم لينفعُوكُم؟"]],"23":[[3,3,"فِتۡنَتُهُمۡ","جوابُهم حين يُخْتَبَرُون بهذا السؤالِ."]],"24":[[5,6,"وَضَلَّ عَنۡهُم","وغابَ عنهم."],[7,9,"مَّا كَانُواْ يَفۡتَرُونَ","ما كانوا يعتقدونه مِن نَفْعِ آلهتِهم له."]],"25":[[7,7,"أَكِنَّةً","أغْطِيةً فلا تفقهُ القرآنَ فِقْهَ انتفاعٍ به."],[12,12,"وَقۡرًا","ثِقَلًا، وصَمَمًا."],[23,23,"يُجَـٰدِلُونَكَ","يُخاصِمُونك."],[30,30,"أَسَـٰطِيرُ","ما سَطَّرُوه من الأباطيلِ."]],"26":[[1,2,"يَنۡهَوۡنَ عَنۡهُ","يَنْهَون الناسَ عن اتِّباع محمدٍ ﷺ."],[3,4,"وَيَنۡـَٔوۡنَ عَنۡهُ","ويَبْتَعِدُون عنه."]],"27":[[3,3,"وُقِفُواْ","حُبِسُوا."],[8,8,"نُرَدُّ","إلى الدُّنيا."]],"28":[[1,1,"بَدَا","ظَهَرَ."],[3,5,"مَّا كَانُواْ يُخۡفُونَ","أي: عن أتْباعهِم من أمْرِ البعثِ، وصِدْقِ الرُّسُلِ."],[15,15,"لَكَـٰذِبُونَ","في أنهم لو عادُوا إلى الدنيا لآمَنوا."]],"29":[[8,8,"بِمَبۡعُوثِينَ","بعد الموتِ."]],"30":[[3,3,"وُقِفُواْ","حُبِسوا."],[8,8,"هَـٰذَا","أي: البعثُ الذي كنتم تُنْكِرونه."]],"31":[[9,9,"ٱلسَّاعَةُ","يومُ القيامةِ."],[13,16,"عَلَىٰ مَا فَرَّطۡنَا فِيهَا","على ما قَدَّمْناه في حياتِنا الدُّنيا."],[19,19,"أَوۡزَارَهُمۡ","ذنوبَهم."],[25,25,"يَزِرُونَ","يَحْمِلون."]],"33":[[7,8,"لَا يُكَذِّبُونَكَ","في قَرارةِ أنفسِهم، بل يعتقدون صِدْقَك."]],"34":[[15,16,"لِكَلِمَـٰتِ ٱللَّهِ","لِآياتِه التي وعَدَ فيها النبيَّ ﷺ بالنصرِ."]],"35":[[9,9,"نَفَقًا","مَنفَذًا، وسَرَبًا."],[13,13,"سُلَّمًا","دَرَجًا تَرْتقي عليه."],[16,17,"فَتَأۡتِيَهُم بِـَٔايَةٍ","بغيرِما جِئْنا به."]],"36":[[3,3,"يَسۡمَعُونَ","سَماعَ تَفَهُّمٍ لِما تَقْتَضيه العقولُ."],[4,4,"وَٱلۡمَوۡتَىٰ","هم الكفارُ."]],"37":[[1,1,"لَوۡلَا","هَلّا."],[4,4,"ءَايَةٌ","علامةٌ تَدُلُّ على صِدْقِه، وتَضْطَرُّهُمْ إلى الإيمانِ."],[17,18,"لَا يَعۡلَمُونَ","أي: إنّ الإنزالَ يكونُ وفْقَ حِكْمَتِه تعالى."]],"38":[[10,10,"أُمَمٌ","جماعاتٌ متجانِسَةٌ في الخَلْقِ والرِّزقِ."],[12,13,"مَّا فَرَّطۡنَا","ما أغفَلْنا."],[15,15,"ٱلۡكِتَـٰبِ","اللوحِ المحفوظِ."]],"39":[[3,3,"صُمٌّ","لا يَسْمَعُون ما ينفَعُهم."],[4,4,"وَبُكۡمٌ","لا يتكلَّمُون بالحقِّ."],[5,6,"فِي ٱلظُّلُمَـٰتِ","في ظلماتِ الكفرِ، والحَيْرةِ."],[15,15,"صِرَٰطٍ","طريقٍ."]],"40":[[1,1,"أَرَءَيۡتَكُمۡ","أخْبرُوني."],[4,5,"عَذَابُ ٱللَّهِ","في الدُّنيا."],[12,14,"إِن كُنتُمۡ صَـٰدِقِينَ","أي: في أنّ آلهتَكُم تنفَعُ، أو تضرُّ."]],"41":[[9,11,"وَتَنسَوۡنَ مَا تُشۡرِكُونَ","وتَتْرُكون آلهتَكم."]],"42":[[7,7,"بِٱلۡبَأۡسَآءِ","في الأموالِ."],[8,8,"وَٱلضَّرَّآءِ","في الأبدانِ."],[10,10,"يَتَضَرَّعُونَ","يَتَذَلَّلُون لربِّهم."]],"43":[[0,0,"فَلَوۡلَآ","فَهَلّا."],[3,3,"بَأۡسُنَا","بَلاؤُنا."]],"44":[[7,9,"أَبۡوَٰبَ كُلِّ شَيۡءٍ","من الخيرِ كالرزقِ والعافيةِ، استدراجًا منّا."],[16,16,"بَغۡتَةً","فَجأة."],[19,19,"مُّبۡلِسُونَ","يائِسون من كلِّ خيرٍ."]],"45":[[0,2,"فَقُطِعَ دَابِرُ ٱلۡقَوۡمِ","فاسْتُؤصِلُوا جميعًا."]],"46":[[7,9,"وَخَتَمَ عَلَىٰ قُلُوبِكُم","وطَبَعَ عليها."],[15,15,"بِهِ","بذلك المأخوذِ منكم."],[18,19,"نُصَرِّفُ ٱلۡـَٔايَـٰتِ","نَجِيءُ بالحُجَجِ على وجوهٍ متعددةٍ."],[22,22,"يَصۡدِفُونَ","يُعْرِضُون."]],"47":[[6,6,"بَغۡتَةً","من غيرِ مُقَدِّماتٍ."],[8,8,"جَهۡرَةً","بعد مُقَدِّماتٍ تَدُلُّ عليه."]],"49":[[7,7,"يَفۡسُقُونَ","يَخْرُجُون عن طاعةِ اللهِ."]],"50":[[7,9,"وَلَآ أَعۡلَمُ ٱلۡغَيۡبَ","أي: فأُخْبِرَكم بما سيكونُ مستقبلًا."],[24,25,"ٱلۡأَعۡمَىٰ وَٱلۡبَصِيرُ","الضالُّ والمهتدي."]],"51":[[0,1,"وَأَنذِرۡ بِهِ","وأعْلِمْ، وخَوِّفْ -أيها الرسولُ- بالقرآنِ."],[6,6,"وَلِيٌّ","ناصرٌ يَنْصُرُهم."],[13,14,"وَلَا شَفِيعٌ","يَشْفَعُ لهم من دونِ اللهِ."]],"52":[[0,2,"وَلَا تَطۡرُدِ ٱلَّذِينَ","ولا تُبْعِدْ عن مَجالسِك الضُّعفاءَ؛ موافَقَةً لمن طَلَبَ منك."],[5,6,"بِٱلۡغَدَوٰةِ وَٱلۡعَشِيِّ","أولِ النهار، وآخرِه."]],"53":[[1,1,"فَتَنَّا","ابتَلَيْنا عبادَنا باختلافِ حظوظِهم في الرِّزْقِ والُخلُقِ، اختبارًا منا."],[4,4,"لِّيَقُولُوٓاْ","ليقولَ الكافرون الأغنياءُ."],[5,5,"أَهَـٰٓؤُلَآءِ","الضعفاءُ من المسلمين."],[6,8,"مَنَّ ٱللَّهُ عَلَيۡهِم","أي: بالهدايةِ دونَنا."]],"54":[[2,3,"ٱلَّذِينَ يُؤۡمِنُونَ","يُصَدِّقُون."],[18,18,"بِجَهَـٰلَةٍ","أي: منه لعاقبتِها."]],"55":[[3,4,"وَلِتَسۡتَبِينَ سَبِيلُ","ولتظهَرَ طريقُ."]],"57":[[3,3,"بَيِّنَةٍ","بَصيرةٍ، ويقينٍ."],[6,7,"وَكَذَّبۡتُم بِهِۦ","بالحقِّ الذي جاءني من الله."],[10,12,"مَا تَسۡتَعۡجِلُونَ بِهِۦٓ","من العذابِ."],[21,21,"ٱلۡفَـٰصِلِينَ","بين الحقِّ والباطلِ."]],"59":[[1,2,"مَفَاتِحُ ٱلۡغَيۡبِ","خزائنُ الغيبِ تُخَزَّنُ فيها، كعِلْمِ الساعةِ وعِلْمِ ما يَسْتَعْجِلُه الكفّارُ من العذابِ."],[29,30,"كِتَـٰبٍ مُّبِينٍ","هو اللَّوحُ المحفوظُ الذي لا لَبْسَ فيه."]],"60":[[2,2,"يَتَوَفَّىٰكُم","في أثناءِ نومِكم، فيَقْبِضُ نفوسَكم التي بها تُمَيِّزُون."],[6,6,"جَرَحۡتُم","كسَبْتُم بجَوارِ حِكم من الخيرِ والشرِّ."],[9,9,"يَبۡعَثُكُمۡ","باليقظةِ من النومِ."],[10,10,"فِيهِ","في النهارِ."],[11,13,"لِيُقۡضَىٰٓ أَجَلٌ مُّسَمًّى","لتُقْضى آجالُكم المحدَّدةُ في الدنيا."]],"61":[[6,6,"حَفَظَةً","ملائكةً يَحْفَظُون أعمالَكم ورِزْقَكم وأَجَلَكم."],[13,13,"رُسُلُنَا","من الملائكةِ المُكَلَّفين بذلك."],[15,16,"لَا يُفَرِّطُونَ","لا يُضَيِّعُون ما أُمِرُوا به."]],"63":[[8,8,"تَضَرُّعًا","دعاءَ تَذَلُّلٍ جَهْرًا."]],"64":[[6,6,"كَرۡبٍ","شِدَّةٍ وغَمّ."]],"65":[[8,9,"مِّن فَوۡقِكُمۡ","كالطُّوفان."],[11,13,"مِن تَحۡتِ أَرۡجُلِكُمۡ","كالزِّلزالِ."],[15,16,"يَلۡبِسَكُمۡ شِيَعًا","يَخْلِطَ أمْرَكم عليكم، فتكونوا فِرَقًا متناحِرَةً يَتَشَيَّعُ بعضُها لبعضٍ."],[17,20,"وَيُذِيقَ بَعۡضَكُم بَأۡسَ بَعۡضٍ","يَقْتلَ بعضُكم بعضًا."],[23,24,"نُصَرِّفُ ٱلۡـَٔايَـٰتِ","نَجيءُ بالحُجَجِ على وجوهٍ متعددةٍ."]],"66":[[1,1,"بِهِۦ","بالقرآنِ، أو العذابِ."],[8,8,"بِوَكِيلٍ","بحفيظٍ على أعمالِكم حتى أُجازيَكم بها."]],"67":[[0,2,"لِّكُلِّ نَبَإٍ مُّسۡتَقَرٌّ","لكلِّ شيءٍ وقْتٌ يَقَعُ فيه."]],"68":[[3,3,"يَخُوضُونَ","بالاستهزاءِ والباطلِ."],[13,14,"وَإِمَّا يُنسِيَنَّكَ","وإنْ أنساك."],[19,19,"ٱلذِّكۡرَىٰ","تَذَكُّرِك."]],"69":[[4,7,"مِنۡ حِسَابِهِم مِّن شَيۡءٍ","ليس على المؤمنين شيءٌ من حِسابِ اللهِ على استهزاءِ المشركين."],[8,9,"وَلَـٰكِن ذِكۡرَىٰ","ولكنْ على المؤمنين أن يُذَكِّروا المشركين ليُمْسِكوا عن الخوضِ."]],"70":[[0,0,"وَذَرِ","واتْرُك."],[10,10,"بِهِۦٓ","بالقرآن."],[11,13,"أَن تُبۡسَلَ نَفۡسُۢ","لكيلا تُحْبَسَ، وتُفْضَحَ."],[21,21,"وَلِيٌّ","ناصرٌ."],[22,23,"وَلَا شَفِيعٌ","يَشْفَعُ لها في الآخرة."],[24,27,"وَإِن تَعۡدِلۡ كُلَّ عَدۡلٍ","وإن تَفْتَدِ بأيِّ فداءٍ."],[39,39,"حَمِيمٍ","شديدِ الحرارةِ، وهو ما يَسِيلُ من صديدِهم."]],"71":[[10,12,"وَنُرَدُّ عَلَىٰٓ أَعۡقَابِنَا","ونَرْجِعُ إلى الضَّلالةِ."],[18,18,"ٱسۡتَهۡوَتۡهُ","هَوَتْ به، وأضَلَّتْه."],[36,36,"لِنُسۡلِمَ","لنَنْقادَ، ونُخْلِصَ."]],"73":[[17,17,"ٱلصُّورِ","القَرْنِ الذي يُنفَخُ فيه للبعثِ."],[20,20,"وَٱلشَّهَـٰدَةِ","وما تُشاهِدُونه."]],"74":[[13,13,"مُّبِينٍ","واضحٍ."]],"75":[[0,1,"وَكَذَٰلِكَ نُرِيٓ","كما أرَيْناه الحقَّ نُرِيه."],[3,3,"مَلَكُوتَ","المُلْكَ العظيمَ."],[8,8,"ٱلۡمُوقِنِينَ","الراسِخين في الإيمان."]],"76":[[1,1,"جَنَّ","أظلمَ."],[7,8,"هَـٰذَا رَبِّي","حَكى ما يعتقدونه لأَجْلِ إلْزامِهم الحُجَّةَ."],[10,10,"أَفَلَ","غابَ."]],"77":[[3,3,"بَازِغًا","طالعًا."]],"79":[[1,2,"وَجَّهۡتُ وَجۡهِيَ","قَصَدْتُ بعبادتي."],[4,4,"فَطَرَ","خَلَقَ."],[7,7,"حَنِيفًا","مائلًا عن الشِّرْكِ."]],"80":[[0,1,"وَحَآجَّهُۥ قَوۡمُهُۥ","وجادَلَه قومُه."],[8,12,"وَلَآ أَخَافُ مَا تُشۡرِكُونَ بِهِۦٓ","لاأخافُ آلهتَكم، فلن تَضُرَّني."]],"81":[[14,14,"سُلۡطَـٰنًا","حُجَّةً بيِّنةً."],[18,18,"بِٱلۡأَمۡنِ","أي: من عذابِ اللهِ."]],"82":[[3,3,"يَلۡبِسُوٓاْ","يَخْلِطُوا."],[5,5,"بِظُلۡمٍ","بشِرْكٍ."]],"83":[[0,1,"وَتِلۡكَ حُجَّتُنَآ","وتلك البراهينُ التي أوْرَدَها إبراهيمُ."]],"86":[[7,7,"ٱلۡعَـٰلَمِينَ","من أهلِ زمانِهم."]],"87":[[4,4,"وَٱجۡتَبَيۡنَـٰهُمۡ","واختَرْناهم."]],"88":[[11,11,"لَحَبِطَ","لَبَطَلَ."]],"89":[[4,4,"وَٱلۡحُكۡمَ","والعِلْمَ."],[9,9,"هَـٰٓؤُلَآءِ","أهلُ مكةَ."],[11,12,"وَكَّلۡنَا بِهَا","ألْزَمْنا بالإيمانِ بها."]],"90":[[0,0,"أُوْلَـٰٓئِكَ","أي: الأنبياءُ."],[11,14,"إِنۡ هُوَ إِلَّا ذِكۡرَىٰ","ما القرآنُ إلا تذكيرٌ."]],"91":[[0,4,"وَمَا قَدَرُواْ ٱللَّهَ حَقَّ قَدۡرِهِۦٓ","وما عَرَفَ هؤلاء المشركون رَبَّهم حَقَّ مَعْرفَتِه."],[25,26,"تَجۡعَلُونَهُۥ قَرَاطِيسَ","تكتبون عنه دفاترَ وكتبًا مُقَطَّعةً؛ فيَتِمُّ لكم ما تُريدونه من التحريفِ."],[42,42,"خَوۡضِهِمۡ","باطِلِهم."]],"92":[[6,7,"بَيۡنَ يَدَيۡهِ","ماتَقَدَّمَه من الكتبِ السماويةِ."],[9,10,"أُمَّ ٱلۡقُرَىٰ","مكةَ."]],"93":[[27,28,"غَمَرَٰتِ ٱلۡمَوۡتِ","أهوالِه وشدائدِه."],[30,31,"بَاسِطُوٓاْ أَيۡدِيهِمۡ","لقَبْضِ أرواحِ الكفّارِ، وتَعْذ يبهم."],[32,33,"أَخۡرِجُوٓاْ أَنفُسَكُمُ","يقولون لهم: أخْرِجُوا أنفسَكم إلينا."],[37,37,"ٱلۡهُونِ","الهَوانِ والذُّلِّ."]],"94":[[8,9,"مَّا خَوَّلۡنَـٰكُمۡ","ما مَكَّنّاكم فيه من الدنيا، كالأموالِ والأولادِ، فلم تَنْتَفعوا."],[18,20,"أَنَّهُمۡ فِيكُمۡ شُرَكَـٰٓؤُاْ","شركاءُ للهِ يَسْتحقون العبادةَ."],[23,23,"بَيۡنَكُمۡ","تَواصُلُكم الذي كان بينَكم في الحياةِ الدنيا."],[24,24,"وَضَلَّ","ذهبَ، وغابَ."]],"95":[[2,3,"فَالِقُ ٱلۡحَبِّ","يَشُقُّه، فيَخْرُجُ منه الزَّرع."],[4,4,"وَٱلنَّوَىٰ","جَمْعِ النَّواة، وهي البِذْرةُ."],[5,8,"يُخۡرِجُ ٱلۡحَيَّ مِنَ ٱلۡمَيِّتِ","كالإنسانِ من النُّطفةِ."],[9,12,"وَمُخۡرِجُ ٱلۡمَيِّتِ مِنَ ٱلۡحَيِّ","كالنُّطفةِ من الإنسانِ."],[15,16,"فَأَنَّىٰ تُؤۡفَكُونَ","فكيف تُصْرَفون عن الحقِّ، وتَعْبُدُون مع الله غيرَه؟"]],"96":[[0,1,"فَالِقُ ٱلۡإِصۡبَاحِ","يَشُقُّ ضياءَ الصَّباحِ من ظلامِ الليلِ."],[7,7,"حُسۡبَانًا","جَعَلَهُما محلَّ حسابٍ لمصالحِ العباد، وأَجْراهما بحِسابٍ مُقَدَّرٍ."]],"98":[[3,5,"مِّن نَّفۡسٍ وَٰحِدَةٍ","آدمَ عليه السلام."],[6,6,"فَمُسۡتَقَرٌّ","هي أرحامُ النساءِ."],[7,7,"وَمُسۡتَوۡدَعٌ","هي أصلابُ الرجالِ."]],"99":[[11,12,"فَأَخۡرَجۡنَا مِنۡهُ","من النَّباتِ."],[13,13,"خَضِرًا","زَرْعًا، وشَجَرًا أخضرَ."],[17,17,"مُّتَرَاكِبًا","يَرْكَبُ بعضُه بعضًا كسَنابلِ القَمْحِ."],[20,21,"مِن طَلۡعِهَا","الطَّلْعُ: ما تنشأُ فيه عناقيدُ الرُّطَبِ."],[22,22,"قِنۡوَانٌ","جمعُ قِنْو، وهو عُنقودُ النَّخْلِ."],[23,23,"دَانِيَةٌ","قريبةٌ إلى الأرض."],[29,29,"مُشۡتَبِهًا","في المنظرِ."],[30,31,"وَغَيۡرَ مُتَشَـٰبِهٍ","في الطَّعْمِ."],[32,32,"ٱنظُرُوٓاْ","فَكِّرُوا في قُدْرَةِ خالقهِ."],[37,37,"وَيَنۡعِهِۦٓ","ونُضْجِه."]],"100":[[5,5,"وَخَرَقُواْ","واختَلَقُوا، ونَسَبُوا."]],"101":[[0,0,"بَدِيعُ","مُبْدِعٌ على غيرِ مثالٍ سَبَقَ."],[3,3,"أَنَّىٰ","كيف؟"]],"102":[[15,15,"وَكِيلٌ","رقيبٌ مُدَبِّرٌ لأمورِ خَلْقِه."]],"103":[[0,1,"لَّا تُدۡرِكُهُ","لا تُحيطُ به، ولا تَبْلُغُ كُنْهَ حَقيقتِه."]],"104":[[2,2,"بَصَآئِرُ","براهينُ واضحةٌ."],[10,10,"فَعَلَيۡهَا","فعلى نفسِه يعودُ وبالُ ذلك."],[14,14,"بِحَفِيظٍ","أُحْصِي أعمالَكم، بل أنا مُبَلِّغٌ."]],"105":[[1,2,"نُصَرِّفُ ٱلۡـَٔايَـٰتِ","نُبَيِّنُ البراهينَ، والحُجَجَ."],[3,4,"وَلِيَقُولُواْ دَرَسۡتَ","أي: لتقومَ الحُجَّةُ عليهم، وليقولوا: تَعَلَّمْتَ من أهلِ الكتابِ."]],"107":[[8,8,"حَفِيظًا","رقيبًا تحفَظُ أقوالَهم وأعمالَهم."],[12,12,"بِوَكِيلٍ","مُوَكَّلٍ على أمورِهم."]],"108":[[2,6,"ٱلَّذِينَ يَدۡعُونَ مِن دُونِ ٱللَّهِ","هم الأصنامُ."],[9,9,"عَدۡوَۢا","اعتداءً."],[13,13,"زَيَّنَّا","حَسَّنّا."]],"109":[[2,3,"جَهۡدَ أَيۡمَـٰنِهِمۡ","بأيمانٍ مُؤَكَّدةٍ."],[6,6,"ءَايَةٌ","معجزةٌ خارقةٌ:"],[14,15,"وَمَا يُشۡعِرُكُمۡ","وما يُدْريكم."],[16,16,"أَنَّهَآ","لعلَّ المعجزاتِ."]],"110":[[0,1,"وَنُقَلِّبُ أَفۡـِٔدَتَهُمۡ","فنَحُولُ بينَهم وبينَ الإيمانِ."],[10,11,"فِي طُغۡيَـٰنِهِمۡ","في تَمَرُّدِهم."],[12,12,"يَعۡمَهُونَ","يَتَحَيَّرون، فلا يَهْتَدُون إلى الحقِّ."]],"111":[[7,7,"وَحَشَرۡنَا","وجَمَعْنا."],[11,11,"قُبُلًا","فعايَنُوه مُواجَهةً."]],"112":[[5,6,"شَيَـٰطِينَ ٱلۡإِنسِ","هم المَرَدَةُ العُتاةُ من الإنسِ."],[12,13,"زُخۡرُفَ ٱلۡقَوۡلِ","هو القولُ المُزَيَّنُ."],[14,14,"غُرُورًا","ليَغْتَرَّ به سامِعُه."],[21,22,"وَمَا يَفۡتَرُونَ","وما يَخْتَلِقُونه من كَذِبٍ."]],"113":[[0,1,"وَلِتَصۡغَىٰٓ إِلَيۡهِ","ولتَمِيلَ إلى القولِ المُزَيَّنِ."],[8,8,"وَلِيَقۡتَرِفُواْ","ولِيكْتَسِبُوا من الأعمالِ السيئةِ."]],"114":[[2,2,"أَبۡتَغِي","أطْلُبُ."],[22,22,"ٱلۡمُمۡتَرِينَ","الشّاكِّين."]],"115":[[1,2,"كَلِمَتُ رَبِّكَ","القرآنُ الكريمُ."],[5,7,"لَّا مُبَدِّلَ لِكَلِمَـٰتِهِۦ","لا أحدَ مُغَيِّرٌ لما حَكَمَ به."]],"116":[[17,17,"يَخۡرُصُونَ","يظنُّون، يَكْذِبُون."]],"119":[[0,2,"وَمَا لَكُمۡ أَلَّا","وأيُّ شيءٍ يَمْنَعُكم؟"]],"120":[[1,3,"ظَـٰهِرَ ٱلۡإِثۡمِ وَبَاطِنَهُۥٓ","عَلانِيَتُه وسِرُّه."],[11,11,"يَقۡتَرِفُونَ","يكتسِبُون."]],"121":[[9,9,"لَفِسۡقٌ","لَخُروجٌ عن طاعةِ اللهِ."],[12,12,"لَيُوحُونَ","لَيُوَسْوِسُون لهم بما يخالِفُ الحقَّ."],[15,15,"لِيُجَـٰدِلُوكُمۡ","ليُثيروا الشبهاتِ لمجادَلَتِكم."]],"122":[[2,2,"مَيۡتًا","في الضلالةِ."],[19,19,"زُيِّنَ","حُسِّنَ."]],"123":[[5,6,"أَكَـٰبِرَ مُجۡرِمِيهَا","رُؤَساءَها وعُظماءَها."],[7,8,"لِيَمۡكُرُواْ فِيهَا","بالصَّدِّ عن دينِ اللهِ."],[9,12,"وَمَا يَمۡكُرُونَ إِلَّا بِأَنفُسِهِمۡ","وبالُ مَكْرِهم عائدٌ عليهم."]],"124":[[14,17,"أَعۡلَمُ حَيۡثُ يَجۡعَلُ رِسَالَتَهُۥ","أعلمُ بمَن يَسْتحِقُّ أن يجعلَه رسولًا، فدَعُوا طَلَبَ ماليسَ مِن شأنِكم."],[21,21,"صَغَارٌ","ذلٌّ، وهَوانٌ."]],"125":[[15,15,"حَرَجًا","شديدَ الضِّيقِ."],[17,17,"يَصَّعَّدُ","يتكَلَّفُ ما لا يُطيقُ من الصُّعود."],[23,23,"ٱلرِّجۡسَ","الشيطانَ."]],"126":[[1,2,"صِرَٰطُ رَبِّكَ","الإسلاُم."],[6,6,"ٱلۡـَٔايَـٰتِ","البراهينَ."]],"127":[[1,2,"دَارُ ٱلسَّلَـٰمِ","دارُ السَّلامةِ من المكروه، وهي الجنةُ."],[6,6,"وَلِيُّهُم","ناصِرُهم."]],"128":[[1,1,"يَحۡشُرُهُمۡ","أي: جميعَ الثَّقَلَيْن من الجنِّ والإنسِ."],[6,8,"ٱسۡتَكۡثَرۡتُم مِّنَ ٱلۡإِنسِ","بإضلالهِم، وصَدِّهم عن سبيلِ اللهِ."],[14,16,"ٱسۡتَمۡتَعَ بَعۡضُنَا بِبَعۡضٍ","استمتاعُ الجنِّ بالإنس: تَلَذُّذهم باتِّباع الإنسِ لهم، واستمتاعُ الإنس بالجن: قَبولُهم تحسينَ المعاصي منهم، فوقَعُوا فيها، وتَلَذَّ ذُوا بها."],[17,18,"وَبَلَغۡنَآ أَجَلَنَا","بانقضاءِ حياتِنا الدنيا، ووُصولِنا إلى دارِ الجَزاءِ."],[24,24,"مَثۡوَىٰكُمۡ","موضعُ مَقامِكم."],[27,30,"إِلَّا مَا شَآءَ ٱللَّهُ","أي: شاءَ عَدَمَ خُلودِه، من عُصاةِ المُوَحِّدِين."]],"129":[[1,4,"نُوَلِّي بَعۡضَ ٱلظَّـٰلِمِينَ بَعۡضَۢا","نُسَلِّط بعضَ الظّالمين من الإنسِ على بعضٍ في الدنيا."]],"130":[[5,6,"رُسُلٌ مِّنكُمۡ","الرسُلُ هم من الإنسِ، ورسُلُ الجِنِّ هم الذين يُنْذِرُون قومَهم."],[18,18,"وَغَرَّتۡهُمُ","وخَدَعَتْهم زِينتُها، فاطمأنُّوا إليها."]],"131":[[7,7,"بِظُلۡمٍ","بسببِ ظُلْمِ مَن يَظْلِمُ."],[8,9,"وَأَهۡلُهَا غَـٰفِلُونَ","أي: لا يُهلِكُهم إلا بعد إرسالِ الرسل، وارتفاعِ الغفلةِ عنهم بذلك، وتَحَقُّقِ الإنذارِ."]],"132":[[1,1,"دَرَجَـٰتٌ","مراتبُ."]],"133":[[12,17,"كَمَآ أَنشَأَكُم مِّن ذُرِّيَّةِ قَوۡمٍ ءَاخَرِينَ","أحْدَثَكم من نَسْلِ خَلْقٍ آخرين كانوا قبلَكم."]],"134":[[6,6,"بِمُعۡجِزِينَ","بفائتين عَمّا هو نازلٌ بكم."]],"135":[[4,4,"مَكَانَتِكُمۡ","طريقتِكم، فاثبُتُوا عليها."],[12,13,"عَـٰقِبَةُ ٱلدَّارِ","الجنةُ."]],"136":[[3,3,"ذَرَأَ","خَلَقَ."],[5,5,"ٱلۡحَرۡثِ","ثمراتِ الزَّرْعِ."],[13,13,"لِشُرَكَآئِنَا","للأصنامِ التي يعبُدونها."]],"137":[[5,6,"قَتۡلَ أَوۡلَـٰدِهِمۡ","وهو دَفْنُ البناتِ وهُنَّ أحياءٌ."],[7,7,"شُرَكَآؤُهُمۡ","رؤساؤُهم، وشياطينُهم."],[8,8,"لِيُرۡدُوهُمۡ","ليُهْلِكُوهم."],[9,9,"وَلِيَلۡبِسُواْ","ولِيَخْلِطُوا."]],"138":[[3,3,"وَحَرۡثٌ","وزَرْعٌ."],[4,4,"حِجۡرٌ","ممنوعةٌ، فهي لأصنامِهم."],[12,12,"حُرِّمَتۡ","فلا يركبونَها."]],"139":[[6,6,"خَالِصَةٌ","حلالٌ."],[10,10,"أَزۡوَٰجِنَا","نسائِنا."],[16,16,"شُرَكَآءُ","يأكلُ منه الذكورُ والإناثُ."],[18,18,"وَصۡفَهُمۡ","جزاءَ وصْفِهم."]],"140":[[5,5,"سَفَهَۢا","طَيشًا."],[9,10,"مَا رَزَقَهُمُ","من الأنعام."]],"141":[[3,4,"جَنَّـٰتٍ مَّعۡرُوشَـٰتٍ","بساتينَ مرفوعاتٍ عن الأرض كالعِنَبِ."],[5,6,"وَغَيۡرَ مَعۡرُوشَـٰتٍ","قائمةً على سُوقِها كالنَّخْلِ، أوما خَرَج في البَرِّ."],[13,13,"مُتَشَـٰبِهًا","في المنظرِ."],[14,15,"وَغَيۡرَ مُتَشَـٰبِهٍ","في الطَّعْمِ."],[21,22,"وَءَاتُواْ حَقَّهُۥ","بالزَّكاةِ والصدقات."]],"142":[[2,2,"حَمُولَةً","مُهَيَّأً للحَمْلِ عليه."],[3,3,"وَفَرۡشًا","صِغارَ الأنعامِ."]],"143":[[0,1,"ثَمَـٰنِيَةَ أَزۡوَٰجٍ","هذه الأنعامُ ثمانيةُ أصنافٍ، أربعةٌ منها في الغنم، وهي: الضَّأْنُ ذُكورًا وإناثًا، والمَعْزُ ذكورًا وإناثًا، وأربعةٌ في الإبِلِ والبقَرِ، ذكورًا وإناثًا."],[13,15,"أَمَّا ٱشۡتَمَلَتۡ عَلَيۡهِ","أي: هل حَرَّمَ ما اشتملت عليه؟ فإن كان التحريمُ منه فإن ذلك يَسْتَلْزِم ُ تحريمَ الجميعِ، فلماذا حَلَّلُوا بعضَها، وحَرَّمُوا بعضَها الآخر؟"]],"144":[[18,18,"شُهَدَآءَ","حاضِرين."]],"145":[[7,7,"مُحَرَّمًا","أي: طعامًا محرَّمًا."],[8,10,"عَلَىٰ طَاعِمٍ يَطۡعَمُهُۥٓ","على مَن يأكلُه."],[17,17,"مَّسۡفُوحًا","جاريًا."],[22,22,"رِجۡسٌ","نَجَسٌ."],[25,28,"أُهِلَّ لِغَيۡرِ ٱللَّهِ بِهِۦ","هو المذبوحُ الذي ذُكِرَ عليه اسمُ غيرِ اللهِ."],[29,30,"فَمَنِ ٱضۡطُرَّ","إلى الأَكْلِ من هذه المحرَّماتِ."],[31,32,"غَيۡرَ بَاغٍ","غيرَ طالبٍ بأَكْلِه التلذُّذَ."],[33,34,"وَلَا عَادٍ","ولا متجاوزٍ حَدَّ الضَّرورةِ."]],"146":[[13,16,"إِلَّا مَا حَمَلَتۡ ظُهُورُهُمَآ","إلا الشَّحْمَ المخالِطَ لظُهورِهما."],[17,18,"أَوِ ٱلۡحَوَايَآ","أو المخالِطَ للأمعاءِ."],[25,25,"بِبَغۡيِهِمۡ","بأعمالهِم السيئةِ."]],"147":[[7,9,"وَلَا يُرَدُّ بَأۡسُهُۥ","ولا يُدْفَعُ عِقابُه إنْ أنْزَلَه بهم."]],"148":[[10,13,"وَلَا حَرَّمۡنَا مِن شَيۡءٍ","أي: لو شاءَ ما حَرَّمْنا على أنفسِنا شيئًا من الأنعام."],[21,21,"بَأۡسَنَا","عقابَنا."],[36,36,"تَخۡرُصُونَ","تَتَوَهَّمون، وتظنون."]],"149":[[2,3,"ٱلۡحُجَّةُ ٱلۡبَـٰلِغَةُ","هي القاطِعَةُ لشُبَهِهِم، وهذه الحُجَّةُ هي الرُّسُلُ، وما جاؤُوا به من كُتُبٍ، ومعجزاتٍ."]],"150":[[1,1,"هَلُمَّ","هاتُوا."],[7,8,"حَرَّمَ هَـٰذَا","حَرَّم ماحَرَّمْتُم من الأنعام."],[11,12,"فَلَا تَشۡهَدۡ","لأنّ شهادتَهم باطلةٌ."],[26,26,"يَعۡدِلُونَ","يُشْرِكون."]],"151":[[17,17,"إِمۡلَـٰقٍ","فَقْرٍ."],[24,25,"مَا ظَهَرَ","ما أُعْلِنَ منها."],[27,28,"وَمَا بَطَنَ","ما خَفِيَ منها."]],"152":[[5,7,"بِٱلَّتِي هِيَ أَحۡسَنُ","بما يُصْلِحُ مالَه، وينتفعُ به."],[9,10,"يَبۡلُغَ أَشُدَّهُۥ","وهو سِنُّ البُلوغِ مع الرُّشْدِ، فادفعُوا إليه ماله."],[14,14,"بِٱلۡقِسۡطِ","بالعدلِ."],[19,19,"وُسۡعَهَا","طاقَتَها."],[27,29,"وَبِعَهۡدِ ٱللَّهِ أَوۡفُواْ","بما عَهِدَ به إليكم من الالتزامِ بشرعِه."]],"153":[[1,2,"هَـٰذَا صِرَٰطِي","الإسلامُ طريقي."],[7,7,"ٱلسُّبُلَ","طُرُقَ الضَّلالِ والبِدَعِ."],[8,9,"فَتَفَرَّقَ بِكُمۡ","فتميلَ بكم."]],"154":[[4,7,"تَمَامًا عَلَى ٱلَّذِيٓ أَحۡسَنَ","تمامًا لنِعْمَتِه على المُحْسنين من مِلَّتِه."]],"155":[[0,0,"وَهَـٰذَا","أي: القرآنُ."]],"156":[[0,1,"أَن تَقُولُوٓاْ","لئلّا تقولُوا أيها الكفارُ."],[6,6,"طَآئِفَتَيۡنِ","اليهودِ والنصارى."],[9,10,"وَإِن كُنَّا","وإنّنا كنّا."],[12,12,"دِرَاسَتِهِمۡ","تلاوةِ كتبِهم بلُغاتها."],[13,13,"لَغَـٰفِلِينَ","لاندْري ما فيها."]],"157":[[8,9,"أَهۡدَىٰ مِنۡهُمۡ","أشَدَّ استقامةً على الحقِّ."],[23,23,"وَصَدَفَ","أعرَضَ."]],"158":[[1,1,"يَنظُرُونَ","ينتظر المُعْرِضون."],[5,5,"ٱلۡمَلَـٰٓئِكَةُ","المختصُّون بقَبْضِ الأرواحِ."],[7,8,"يَأۡتِيَ رَبُّكَ","للفَصْل بين عبادِه يومَ القيامةِ."],[11,13,"بَعۡضُ ءَايَـٰتِ رَبِّكَ","بعضُ علاماتِ السّاعةِ."],[26,27,"مِن قَبۡلُ","من قبلِ إتيانِ هذه الآياتِ."],[32,32,"خَيۡرًا","عملًا صالحًا."]],"159":[[2,3,"فَرَّقُواْ دِينَهُمۡ","جَعَلُوه متفرِّقًا، فأخذوا ببعضِه، وتركوا بعضَه."],[5,5,"شِيَعًا","فِرَقًا وأحزابًا."]],"161":[[5,6,"صِرَٰطٍ مُّسۡتَقِيمٍ","طريقٍ لا عِوَجَ فيه، وهو الإسلامُ."],[8,8,"قِيَمًا","يقومُ بأمْرِ الدنيا والآخرةِ."],[11,11,"حَنِيفًا","مائلًا إلى الحقِّ."]],"162":[[3,3,"وَنُسُكِي","وذَبْحي للأنعام."],[4,4,"وَمَحۡيَايَ","ما أعمَلُه في حياتي."],[5,5,"وَمَمَاتِي","ما يُقَدِّره عليّ في الموتِ."]],"163":[[6,7,"أَوَّلُ ٱلۡمُسۡلِمِينَ","أولُ مَن انقادَ للهِ من هذه الأمةِ."]],"164":[[3,3,"أَبۡغِي","أطْلُبُ."],[9,14,"وَلَا تَكۡسِبُ كُلُّ نَفۡسٍ إِلَّا عَلَيۡهَا","لا يُؤاخَذُ ممّا أتَتْ به من الذَّنبِ سِواها."],[15,19,"وَلَا تَزِرُ وَازِرَةٌ وِزۡرَ أُخۡرَىٰ","ولا تَحْمِلُ نفسٌ آثمةٌ إثمَ نفسٍ أخرى."]],"165":[[3,3,"خَلَـٰٓئِفَ","خُلَفاءَ الأممِ الماضيةِ."],[5,8,"وَرَفَعَ بَعۡضَكُمۡ فَوۡقَ بَعۡضٍ","في الرِّزقِ والقوةِ وغيرِهما."],[9,9,"دَرَجَـٰتٍ","مراتبَ."],[10,10,"لِّيَبۡلُوَكُمۡ","ليختبرَكم."],[11,13,"فِي مَآ ءَاتَىٰكُمۡ","أي: من نِعَمِه."]]}