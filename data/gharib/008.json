{"1":[[2,2,"ٱلۡأَنفَالِ","جَمْعُ نَفَل، وهي: الغنائمُ في غزوةِ «بَدْر»."],[10,11,"ذَاتَ بَيۡنِكُمۡ","الصِّلَةُ التي تَرْبِطُ بعضَكم ببعض."]],"2":[[6,6,"وَجِلَتۡ","خافَتْ وفَزِعَتْ."],[14,16,"وَعَلَىٰ رَبِّهِمۡ يَتَوَكَّلُونَ","يعتمدون عليه ويُفَوِّضون أمرَهم إليه."]],"4":[[5,5,"دَرَجَـٰتٌ","منازلُ عاليةٌ."]],"5":[[0,1,"كَمَآ أَخۡرَجَكَ","هذه الحالُ في كراهةِ فريقٍ من المؤمنين للقتالِ بعد تَبَيُّنِه، مثلُ إخراجِك في حالِ كراهتِهم."]],"6":[[1,2,"فِي ٱلۡحَقِّ","في القتالِ."]],"7":[[4,4,"ٱلطَّآئِفَتَيۡنِ","القافلةِ الآتيةِ من الشام وما تحمِلُه من أرزاقٍ، أو النَّفيرِ لقتالِ الأعداءِ."],[9,11,"غَيۡرَ ذَاتِ ٱلشَّوۡكَةِ","غيرَ ذاتِ السِّلاحِ والقُوَّةِ، وهي: القافلةُ."],[20,22,"وَيَقۡطَعَ دَابِرَ ٱلۡكَـٰفِرِينَ","الدابِرُ: الآخِرُ، أي: ويستأصِلَ الكافرين بالهَلاكِ."]],"8":[[0,1,"لِيُحِقَّ ٱلۡحَقَّ","ليُظْهِرَه للناسِ ويُبَيِّنَه."]],"9":[[1,1,"تَسۡتَغِيثُونَ","تَطْلُبون النَّصْرَ على عَدُوِّكم."],[10,10,"مُرۡدِفِينَ","يَتْبَعُ بعضُهم بعضًا."]],"10":[[0,2,"وَمَا جَعَلَهُ ٱللَّهُ","وما جَعَلَ الإمدادَ."],[5,5,"وَلِتَطۡمَئِنَّ","ولِتَسْكُنَ وتُوقِنَ بنَصْرِ اللهِ."]],"11":[[1,1,"يُغَشِّيكُمُ","يُلْقي اللهُ عليكم."],[3,4,"أَمَنَةً مِّنۡهُ","أمانًا من الله لكم."],[12,12,"وَيُذۡهِبَ","ويُزيلَ."],[14,15,"رِجۡزَ ٱلشَّيۡطَـٰنِ","وساوِسَه بما خَطَرَ لهم من الخوفِ والفَشَلِ."],[16,18,"وَلِيَرۡبِطَ عَلَىٰ قُلُوبِكُمۡ","وليُقَوِّيَها بالصَّبرِ والشَّجاعةِ."]],"12":[[5,6,"أَنِّي مَعَكُمۡ","بإعانتي ونَصْري."],[7,9,"فَثَبِّتُواْ ٱلَّذِينَ ءَامَنُواْ","فَقَوُّوا عزائمَهم، وبَشِّرُوهم بالنَّصْرِ."],[15,15,"ٱلرُّعۡبَ","الخوفَ الشديدَ."],[17,18,"فَوۡقَ ٱلۡأَعۡنَاقِ","رؤوسَ الكفارِ."],[21,22,"كُلَّ بَنَانٍ","كلَّ طَرَفٍ ومِفْصَلٍ في الجسمِ."]],"13":[[0,0,"ذَٰلِكَ","ما وقَعَ عليهم من القَتْل."],[2,3,"شَآقُّواْ ٱللَّهَ","خالَفُوا أمْرَه."]],"15":[[7,7,"زَحۡفًا","مُتقارِبين يَدْنُو كلُّ فريقٍ من الآخَرِ."],[8,10,"فَلَا تُوَلُّوهُمُ ٱلۡأَدۡبَارَ","فلا تُدِيروا لهم ظُهورَكم مُنْهَزِمين."]],"16":[[5,6,"مُتَحَرِّفًا لِّقِتَالٍ","مائِلًا عن موقفِه إلى موضعٍ أصلَحَ للقتالِ فيه."],[8,8,"مُتَحَيِّزًا","مُنْحازًا ومنضَمًّا."],[10,10,"فِئَةٍ","جماعةٍ من المسلمين في ميدانِ القتالِ."],[12,15,"بَآءَ بِغَضَبٍ مِّنَ ٱللَّهِ","استحَقَّ غضَبه."]],"17":[[12,13,"وَلِيُبۡلِيَ ٱلۡمُؤۡمِنِينَ","وليختبرَ اللهُ المؤمنين بنِعَمِه وإحسانِه."]],"18":[[3,3,"مُوهِنُ","مُضْعِفُ ومُبْطِلُ."],[4,5,"كَيۡدِ ٱلۡكَـٰفِرِينَ","مَكْرِهم واحتيالِهم."]],"19":[[1,1,"تَسۡتَفۡتِحُواْ","تطلُبوا النَّصْرَ أيها الكفارُ."],[3,4,"جَآءَكُمُ ٱلۡفَتۡحُ","تَهَكُّمٌ بالكفارِ، فقد نَصَرَ اللهُ المؤمنين ب «بَدْرٍ»."],[10,11,"وَإِن تَعُودُواْ","إلى الكفرِ وقتالِ النبيِّ ﷺ."],[12,12,"نَعُدۡ","بهزيمَتِكم ونَصْرِه - ﷺ - عليكم."],[16,16,"فِئَتُكُمۡ","جماعتُكم."],[22,23,"مَعَ ٱلۡمُؤۡمِنِينَ","بتأييدِه ونَصْرِه."]],"20":[[6,7,"وَلَا تَوَلَّوۡاْ","ولا تُعْرِضُوا عن طاعةِ اللهِ ورسولهِ."],[10,10,"تَسۡمَعُونَ","ما يُتلى عليكم من الحُجَجِ والبراهينِ."]],"22":[[2,2,"ٱلدَّوَآبِّ","جَمْعُ دابّة، وهي: ما دَبَّ على الأرضِ مِن خَلْقِ اللهِ."],[5,5,"ٱلصُّمُّ","مَنِ انسَدَّتْ آذانُهم عن سماعِ الحقِّ."],[6,6,"ٱلۡبُكۡمُ","مَن خَرِسَتْ ألسنتُهم عن النُّطقِ به."]],"23":[[5,5,"لَّأَسۡمَعَهُمۡ","مواعِظَ القرآنِ وعِبَرَه."],[8,8,"لَتَوَلَّواْ","لَأَعْرَضُوا عن الإيمان عِنادًا."],[10,10,"مُّعۡرِضُونَ","صادُّون عنه."]],"24":[[8,9,"لِمَا يُحۡيِيكُمۡ","لما فيه الحياةُ الأبديةُ."],[14,16,"بَيۡنَ ٱلۡمَرۡءِ وَقَلۡبِهِۦ","بين الإنسانِ وخواطِرِ قلبِه، فاللهُ أملكُ لقلوبِ عبادِه منهم."]],"25":[[1,1,"فِتۡنَةً","ابتلاءً ومِحْنَةً تنزِلُ بكم."]],"26":[[4,4,"مُّسۡتَضۡعَفُونَ","قليلُو العَدَدِ، مَقْهُورون."],[9,9,"يَتَخَطَّفَكُمُ","يَأْخُذَكُم بسُرعةٍ."],[10,10,"ٱلنَّاسُ","كفارُ قريشٍ."],[11,11,"فَـَٔاوَىٰكُمۡ","جَعَلَ اللهُ لكم «المدينةَ» مَأْوىً تَأْوُون إليه."]],"27":[[3,5,"لَا تَخُونُواْ ٱللَّهَ","بتَرْكِ ما أوْجَبَه عليكم، وارتكابِ ما نَهاكم عنه."],[8,8,"أَمَـٰنَـٰتِكُمۡ","ما ائتُمِنتُم عليه من التكاليفِ الشرعيةِ."]],"28":[[4,4,"فِتۡنَةٌ","اختبارٌ لكم."]],"29":[[8,8,"فُرۡقَانًا","فَصْلًا بين الحَقِّ والباطِلِ."]],"30":[[1,2,"يَمۡكُرُ بِكَ","يَكِيدُ لك."],[5,5,"لِيُثۡبِتُوكَ","ليَحْبِسُوك."],[9,9,"يُخۡرِجُوكَ","من بلدِك «مكةَ»."]],"31":[[15,16,"أَسَـٰطِيرُ ٱلۡأَوَّلِينَ","جَمْعُ أُسْطُورة، وهي: ما سُطِّرَ في كُتُبِ السابقين من الأخبارِ المكذوبةِ."]],"32":[[3,5,"إِن كَانَ هَـٰذَا","ما جاءَ به محمدٌ."]],"33":[[4,5,"وَأَنتَ فِيهِمۡ","وأنت مقيمٌ بينَهم في «مكةَ»."]],"34":[[0,4,"وَمَا لَهُمۡ أَلَّا يُعَذِّبَهُمُ ٱللَّهُ","وأيُّ شيءٍ يَمْنَعُ من عذابه لهم؟"],[6,6,"يَصُدُّونَ","يَمْنَعُون."],[7,9,"عَنِ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ","عن الطَّوافِ بالكعبةِ، والصَّلاةِ فيه."],[10,12,"وَمَا كَانُوٓاْ أَوۡلِيَآءَهُۥٓ","وما كان الكفارُ أولياءَ اللهِ ولا المسجدِ الحرامِ."]],"35":[[6,6,"مُكَآءً","صَفيرًا."],[7,7,"وَتَصۡدِيَةً","وتَصْفيقًا."],[8,9,"فَذُوقُواْ ٱلۡعَذَابَ","في الدنيا بالقَتْلِ والأَسْرِ في «بدرٍ»، وفي الآخرةِ بالنارِ."]],"36":[[13,13,"حَسۡرَةً","ندامةً وأَسَفًا."]],"37":[[0,0,"لِيَمِيزَ","ليَفْصِلَ."],[10,10,"فَيَرۡكُمَهُۥ","يَجْمَعَه ويَضُمَّ بعضَه إلى بعضٍ."]],"38":[[3,4,"إِن يَنتَهُواْ","عن الكفرِ، ويَرْجِعُوا إلى الإيمان."],[10,11,"وَإِن يَعُودُواْ","إلى قتالِ النبيِّ ﷺ."],[13,13,"مَضَتۡ","سَبَقَتْ."],[14,15,"سُنَّتُ ٱلۡأَوَّلِينَ","سنَّتُنا في عقوبةِ مَن كَذَّبَ واستمرَّ على كُفْرِه."]],"39":[[4,4,"فِتۡنَةٌ","شِرْكٌ وصَدٌّ عن سبيل الله."],[5,8,"وَيَكُونَ ٱلدِّينُ كُلُّهُۥ لِلَّهِ","وتكونَ الطاعةُ والعبادةُ كلُّهاخالصةً لله."],[9,10,"فَإِنِ ٱنتَهَوۡاْ","فإن انزجَرَ المشركون عن شِرْكِهم وفتنةِ المؤمنين."]],"40":[[5,5,"مَوۡلَىٰكُمۡ","مُعينُكم وناصِرُكم."]],"41":[[2,2,"غَنِمۡتُم","ظَفِرْتُمْ به من الأعداءِ بالجِهادِ."],[9,10,"وَلِذِي ٱلۡقُرۡبَىٰ","قَرابةِ الرسولِ ﷺ، وهم بنو هاشمٍ وبنو المطَّلِبِ."],[11,11,"وَٱلۡيَتَـٰمَىٰ","الأطفالِ الذين مات آباؤُهم وهم دونَ سِنِّ البُلوغ."],[12,12,"وَٱلۡمَسَـٰكِينِ","أهلِ الحاجةِ الذين لا يَمْلِكُون ما يَكْفيهم."],[13,14,"وَٱبۡنِ ٱلسَّبِيلِ","المسافرِ الذي انقطعَتْ به النفقةُ."],[19,20,"وَمَآ أَنزَلۡنَا","من الملائكةِ والآياتِ والنَّصْرِ."],[23,24,"يَوۡمَ ٱلۡفُرۡقَانِ","يومَ «بَدْرٍ» حينَ فَرَقَ اللهُ بينَ الحقِّ والباطلِ."]],"42":[[2,3,"بِٱلۡعُدۡوَةِ ٱلدُّنۡيَا","جانبِ الوادي الأقربِ إلى «المدينة»."],[6,6,"ٱلۡقُصۡوَىٰ","البعيدةِ عن «المدينةِ»."],[7,7,"وَٱلرَّكۡبُ","عِيرُ التجارةِ وأصحابُها."],[8,9,"أَسۡفَلَ مِنكُمۡ","في مكانٍ أسفلَ من مكانِكم جهةَ ساحلِ البحرِ الأحمرِ."],[16,20,"لِّيَقۡضِيَ ٱللَّهُ أَمۡرًا كَانَ مَفۡعُولًا","بنَصْرِ أوليائِه وخِذْلانِ أعدائِه."],[21,23,"لِّيَهۡلِكَ مَنۡ هَلَكَ","ليموتَ مَن يموتُ من الكفّارِ."],[24,25,"عَنۢ بَيِّنَةٍ","عن حُجَّةٍ عايَنَها."],[26,28,"وَيَحۡيَىٰ مَنۡ حَيَّ","ويعيشَ مَن يعيشُ مِنهُم."]],"43":[[9,9,"لَّفَشِلۡتُمۡ","لَجَبُنْتُم وضَعُفتم."],[10,10,"وَلَتَنَـٰزَعۡتُمۡ","اختلَفْتُم."],[11,12,"فِي ٱلۡأَمۡرِ","في القتالِ."],[15,15,"سَلَّمَ","عَصَمَ من الضَّعْفِ والاختلافِ."]],"46":[[7,7,"رِيحُكُمۡ","قُوَّتُكم ونَصْرُكم."],[11,12,"مَعَ ٱلصَّـٰبِرِينَ","بالعَوْنِ والنصرِ والتأييدِ."]],"47":[[6,6,"بَطَرًا","كِبْرًا."],[7,8,"وَرِئَآءَ ٱلنَّاسِ","مراءاةً لهم وطَلَبًا للفَخْرِ."]],"48":[[1,1,"زَيَّنَ","حَسَّنَ."],[13,14,"جَارٌ لَّكُمۡ","مُعينٌ وناصرٌ لكم."],[16,17,"تَرَآءَتِ ٱلۡفِئَتَانِ","التقى المسلمون مع الكفارِ."],[18,20,"نَكَصَ عَلَىٰ عَقِبَيۡهِ","رَجَعَ إلى الوراء ووَلّى هاربًا."],[25,29,"إِنِّيٓ أَرَىٰ مَا لَا تَرَوۡنَ","مِن الملائكةِ الذين جاؤوا لنُصْرَةِ المؤمنين."]],"49":[[2,2,"ٱلۡمُنَـٰفِقُونَ","جَمْعُ مُنافق، وهو: مَن يُظهِرُ الإسلامَ ويُبْطِنُ الكفرَ."],[4,6,"فِي قُلُوبِهِم مَّرَضٌ","ضِعافُ الإيمانِ الشاكُّون من غيرِ نِفاقٍ."],[7,9,"غَرَّ هَـٰٓؤُلَآءِ دِينُهُمۡ","أي: اغترَّ المسلمون بدينِهم حتى تَكَلَّفُوا قتالَ المشركين."],[11,13,"يَتَوَكَّلۡ عَلَى ٱللَّهِ","يُفَوِّضْ أمرَه إليه ويعتمدْ عليه."]],"50":[[3,3,"يَتَوَفَّى","يَقْبِضُ ويَنْتَزِعُ."],[9,9,"وَأَدۡبَـٰرَهُمۡ","ظهورَهم."],[12,12,"ٱلۡحَرِيقِ","المُحْرِقِ، وهو جهنَّمُ."]],"51":[[1,3,"بِمَا قَدَّمَتۡ أَيۡدِيكُمۡ","بسبب أعمالِكم السيئةِ."],[6,7,"لَيۡسَ بِظَلَّـٰمٍ","ليس بذي ظُلْمٍ."]],"52":[[0,2,"كَدَأۡبِ ءَالِ فِرۡعَوۡنَ","حالُ المشركين في الكفرِ واستحقاقِ العذابِ كحالِ آلِ فرعونَ."],[9,10,"فَأَخَذَهُمُ ٱللَّهُ","أنزلَ بهم عقابَه."]],"53":[[0,0,"ذَٰلِكَ","أي: التعذيبُ على الأعمالِ السيئة."]],"55":[[2,2,"ٱلدَّوَآبِّ","جَمْعُ دابَّةٍ، وهي: ما دَبَّ على الأرضِ من خَلْقِ اللهِ."]],"56":[[1,1,"عَـٰهَدتَّ","التزَمْتَ معهم بميثاقٍ."],[4,4,"يَنقُضُونَ","يُبْطِلُون."]],"57":[[0,1,"فَإِمَّا تَثۡقَفَنَّهُمۡ","فإن ظَفِرْتَ بهم وصادَفْتَهم."],[4,5,"فَشَرِّدۡ بِهِم","ففرِّقْ وخَوِّفْ بقَتْلهِم والتنكيلِ بهم."],[6,7,"مَّنۡ خَلۡفَهُمۡ","غيرَهم من المحاربين."]],"58":[[5,6,"فَٱنۢبِذۡ إِلَيۡهِمۡ","فألْقِ إليهم عَهْدَهم."],[7,8,"عَلَىٰ سَوَآءٍ","حتى يَسْتَوِيَ الفريقان في العِلْم بأنه لا عَهْدَ بينَهم."]],"59":[[4,4,"سَبَقُوٓاْ","أفلَتُوا ونَجَوْا من الظَّفَرِ بهم."],[6,7,"لَا يُعۡجِزُونَ","لن يُفْلِتُوا من عذابِ اللهِ."]],"60":[[0,0,"وَأَعِدُّواْ","وهَيِّئوا."],[7,8,"رِّبَاطِ ٱلۡخَيۡلِ","إعدادِها ورَبْطِها؛ انتظارًا للغَزْوِ عليها."],[9,9,"تُرۡهِبُونَ","تُخَوِّفُون."],[15,16,"مِن دُونِهِمۡ","مِن غيرِهم."],[17,18,"لَا تَعۡلَمُونَهُمُ","لم تَظْهَرْ لكم عداوتُهم."],[28,29,"يُوَفَّ إِلَيۡكُمۡ","يُخْلِفْه اللهُ لكم في الدنيا، ويَدَّخِرْ لكم ثوابَه في الآخرة."],[31,32,"لَا تُظۡلَمُونَ","لا تُنْقَصُون شيئًا من أجرِ الإنفاقِ."]],"61":[[1,1,"جَنَحُواْ","مالَ المحارِبُون."],[2,2,"لِلسَّلۡمِ","للمُسالمةِ وتَرْكِ الحربِ."],[3,4,"فَٱجۡنَحۡ لَهَا","فمِلْ إلى المصالحةِ."],[5,7,"وَتَوَكَّلۡ عَلَى ٱللَّهِ","اعتمِدْ عليه وفَوِّضْ أمْرَك إليه."]],"62":[[3,3,"يَخۡدَعُوكَ","يُدَبِّرُوا إيقاعَك فيما تَكْرَهُ."],[5,6,"حَسۡبَكَ ٱللَّهُ","كافِيك وناصِرُك."]],"63":[[0,0,"وَأَلَّفَ","وجَمَعَ."]],"65":[[2,2,"حَرِّضِ","بالِغْ في الحَثِّ."],[24,25,"لَّا يَفۡقَهُونَ","لا يَعْلمون ما أعَدَّه اللهُ للمجاهدين في سبيلِه."]],"66":[[24,25,"مَعَ ٱلصَّـٰبِرِينَ","بتأييدِه ونَصْرِه."]],"67":[[8,8,"يُثۡخِنَ","يُبالِغَ في قَتْلِ الأعداءِ."],[12,13,"عَرَضَ ٱلدُّنۡيَا","حُطامَها، وهو: الفِداءُ من أسْرى «بدر»."],[15,16,"يُرِيدُ ٱلۡـَٔاخِرَةَ","ثوابَها، بإظهارِ الدِّين، وما يَحْصِلُ لكم من أجْر الجهادِ."],[18,18,"عَزِيزٌ","قويٌّ قادرٌ لا يُقْهَرُ."],[19,19,"حَكِيمٌ","ذو حِكْمةٍ في أفعالِه كلِّها."]],"68":[[1,3,"كِتَـٰبٌ مِّنَ ٱللَّهِ","قَضاءٌ وحُكْمٌ منه."],[4,4,"سَبَقَ","بإباحةِ الغنيمةِ وفِداءِ الأسرى."],[5,5,"لَمَسَّكُمۡ","لَأصابَكم."]],"69":[[1,2,"مِمَّا غَنِمۡتُمۡ","مِن قِتالِ عَدُوِّكم وفِداءِ الأسرى."]],"70":[[16,18,"مِّمَّآ أُخِذَ مِنكُمۡ","من المالِ بأن يُيَسِّرَ اللهُ لكم من فَضْلِه خيرًا كثيرًا."]],"71":[[2,2,"خِيَانَتَكَ","بالغَدْرِ بك وخِداعِكَ."],[4,5,"خَانُواْ ٱللَّهَ","بمخالفةِ أمْرِه."],[6,7,"مِن قَبۡلُ","قبلَ غزوةِ «بدرٍ»."],[8,9,"فَأَمۡكَنَ مِنۡهُمۡ","فأقدرك الله عليهم ونَصَرَك."]],"72":[[3,3,"وَهَاجَرُواْ","انتقلُوا إلى دارِ الإسلام، أو بلدٍ يتمكَّنُون فيه من العبادةِ."],[10,11,"وَٱلَّذِينَ ءَاوَواْ","هم الأنصارُ الذين أسكنُوا النبيَّ ﷺ والمهاجرين في دُورِهم."],[15,16,"أَوۡلِيَآءُ بَعۡضٍ","في النُّصْرَةِ والمعونةِ."],[24,24,"وَلَـٰيَتِهِم","نُصْرَتهِم."],[30,30,"ٱسۡتَنصَرُوكُمۡ","طلبُوا نُصْرَتَكم."],[31,32,"فِي ٱلدِّينِ","بأنهم من أهلِ دينِكم."],[40,40,"مِّيثَـٰقٌ","عَهْدٌ مؤكَّدٌ."]],"73":[[5,6,"إِلَّا تَفۡعَلُوهُ","أي: تَوَلِّيَ المؤمنين ونُصْرتهم."],[8,8,"فِتۡنَةٌ","للمؤمنين عن دينِهم."],[11,12,"وَفَسَادٌ كَبِيرٌ","بالصَّدِّ عن سبيلِ اللهِ، وقوةِ الكفرِ."]],"75":[[2,3,"مِنۢ بَعۡدُ","بعدَ السابقين إلى الإيمانِ والهجرةِ."],[7,8,"فَأُوْلَـٰٓئِكَ مِنكُمۡ","أي: لهم ما لكم وعليهم ما عليكم."],[9,10,"وَأُوْلُواْ ٱلۡأَرۡحَامِ","ذَوو القَراباتِ."],[12,13,"أَوۡلَىٰ بِبَعۡضٍ","في الميراثِ من عامَّةِ المسلمين."],[15,16,"كِتَـٰبِ ٱللَّهِ","حُكْمِه الذي كَتَبَه في اللَّوحِ المحفوظِ."]]}