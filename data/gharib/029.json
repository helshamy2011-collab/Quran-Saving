{"1":[[0,0,"الٓمٓ","سَبَقَ الكَلامُ على مِثْلِه في أوَّلِ سورةِ البَقَرةِ."]],"2":[[8,9,"لَا يُفۡتَنُونَ","لا يُبتَلَونَ."]],"4":[[5,6,"أَن يَسۡبِقُونَا","أن يُعْجِزُونا ويَفُوتُونا."],[7,7,"سَآءَ","بِئْسَ."]],"5":[[2,2,"يَرۡجُواْ","يَتَوَقَّعُ ويَطْمَعُ."],[6,7,"أَجَلَ ٱللَّهِ","الوَقْتَ المُعَيَّنَ للبَعْثِ والجَزاءِ."]],"6":[[1,1,"جَـٰهَدَ","أي: الكُفّارَ ونَفْسَه الأَمّارةَ بالسُّوءِ."]],"7":[[4,4,"لَنُكَفِّرَنَّ","لَنَمْحُوَنَّ."],[7,7,"وَلَنَجۡزِيَنَّهُمۡ","لَنُثِيبَنَّهم."]],"8":[[0,0,"وَوَصَّيۡنَا","أي: أمَرْنا."],[3,3,"حُسۡنًا","أي: بَرًّا بِهِما وعَطْفًا عَلَيهِما."],[5,5,"جَـٰهَدَاكَ","ألْزَماكَ."]],"10":[[11,12,"فِتۡنَةَ ٱلنَّاسِ","ابتلاءَهم وتَعْذِيبَهُم"]],"12":[[7,7,"وَلۡنَحۡمِلۡ","ولْنَتَحَمَّلْ."]],"13":[[1,1,"أَثۡقَالَهُمۡ","أي: أثْقالَ ذُنُوبِهِم العَظِيمَةَ."],[10,10,"يَفۡتَرُونَ","يَخْتَلِقُونَ."]],"14":[[5,5,"فَلَبِثَ","مَكَثَ."],[13,13,"ٱلطُّوفَانُ","الماءُ الكَثِيرُ الذي غَمَرهُم مِن جَمِيعِ الجِهاتِ."]],"15":[[4,4,"ءَايَةً","عِبْرةً عَظِيمةً."]],"17":[[5,5,"أَوۡثَـٰنًا","أصْنامًا."],[6,7,"تَخۡلُقُونَ إِفۡكًا","تَفْتَرُونَ كَذِبًا."],[18,18,"فَٱبۡتَغُواْ","فالتَمِسُوا."]],"19":[[3,3,"يُبۡدِئُ","يُنشِئُ ابتداءً."],[7,7,"يُعِيدُهُۥٓ","يُعِيدُ الخَلْقَ مِن بَعْدِ فَنائِهِ."]],"20":[[10,10,"يُنشِئُ","يَخلُقُ."],[11,12,"ٱلنَّشۡأَةَ ٱلۡـَٔاخِرَةَ","أي: نَشْأَةً ثانيةً عِنْدَ البعْثِ."]],"21":[[7,7,"تُقۡلَبُونَ","تُرجَعُونَ."]],"22":[[2,2,"بِمُعۡجِزِينَ","بِسابِقِينَ اللهَ."]],"23":[[2,3,"بِـَٔايَـٰتِ ٱللَّهِ","أي: بالقرآنِ."],[4,4,"وَلِقَآئِهِۦٓ","أي: بالبعثِ بَعْدَ الموتِ."]],"24":[[17,17,"لَـَٔايَـٰتٍ","لَأَدِلَّةً واضِحَةً."]],"25":[[6,6,"أَوۡثَـٰنًا","أصْنامًا، أي: اتَّخذتُموها آلِهَةً."],[7,8,"مَّوَدَّةَ بَيۡنِكُمۡ","أي: للتَّوادِّ والتَّواصُل بَيْنَكُم لاجْتِماعِكُم على عِبادَتِها."],[15,17,"يَكۡفُرُ بَعۡضُكُم بِبَعۡضٍ","أي: يتبرَّأُ بعضُكُم مِن بَعْضٍ."],[21,21,"مَأۡوَىٰكُمُ","مَنزِلُكُم الذي تَأْوُونَ وتَرْجِعُونَ إليهِ."]],"26":[[0,0,"فَـَٔامَنَ","أي: صَدَّقَ إبراهيمَ عَلَيهِ الصَّلاةُ والسَّلامُ."]],"27":[[8,8,"وَٱلۡكِتَـٰبَ","أي: الكُتُبَ المنزَّلةَ، مِنَ التَّوراةِ والإنْجِيلِ والزَّبُورِ والقرآنِ."],[10,10,"أَجۡرَهُۥ","أي: ثَوابَه."]],"28":[[6,6,"ٱلۡفَـٰحِشَةَ","هي إتْيانُهم الرِّجالَ في أدْبارِهِم."]],"29":[[4,4,"ٱلسَّبِيلَ","أي: الطَّريقَ على المارَّةِ والمسافِرِينَ، بأخْذِ أمْوالِهِم، أو قَتْلِهِم، أو إكْراهِهِم على الفاحِشَةِ."],[6,7,"فِي نَادِيكُمُ","في مَجْلِسِكُم."],[8,8,"ٱلۡمُنكَرَ","وهو كلُّ فِعْلٍ يُنكِره الشَّرْعُ أو العقْلُ كالسُّخْرِيَةِ مِنَ النّاسِ وحَذْفِ المارّةِ."]],"31":[[2,2,"رُسُلُنَآ","أي: مِنَ الَملائِكَةِ."],[9,10,"هَـٰذِهِ ٱلۡقَرۡيَةِ","هي «سَدُومُ» قَرْيَةُ قَوْمِ لُوطٍ."]],"32":[[14,15,"مِنَ ٱلۡغَـٰبِرِينَ","مِنَ الباقِينَ في العَذابِ والهَلاكِ."]],"33":[[5,6,"سِيٓءَ بِهِمۡ","اعْتَراهُ الغَمُّ بِمَجِيئِهِم خَوْفًا عَليهِم مِن قَومِهِ."]],"34":[[6,6,"رِجۡزًا","عَذابًا شَدِيدًا."]],"35":[[2,2,"مِنۡهَآ","أي: مِن دِيارِ قَومِ لُوطٍ."],[3,4,"ءَايَةَۢ بَيِّنَةً","أي: آثارًا واضِحةً."]],"36":[[8,8,"وَٱرۡجُواْ","تَوَقّعُوا، أوِ اخْشَوا."],[11,12,"وَلَا تَعۡثَوۡاْ","لا تُفْسدُوا أشدَّ الفَسادِ."]],"37":[[2,2,"ٱلرَّجۡفَةُ","الزَّلْزَلةُ الشَّدِيدَةُ."],[6,6,"جَـٰثِمِينَ","مَيِّتِينَ بارِكِينَ على رُكَبِهِم."]],"38":[[11,11,"فَصَدَّهُمۡ","فصَرفَهُم."],[13,13,"ٱلسَّبِيلِ","أي: سَبِيلِ اللهِ المُسْتَقِيمِ."],[15,15,"مُسۡتَبۡصِرِينَ","أي: عُقَلاءَ ذَوِي بَصائِرَ مُتَمَكِّنِينَ مِن مَّعْرِفَةِ الحقِّ."]],"39":[[6,6,"بِٱلۡبَيِّنَـٰتِ","بالأدِلَّةِ الواضِحةِ."],[12,12,"سَـٰبِقِينَ","فائِتِينَ مِن عَذابِ اللهِ."]],"40":[[7,7,"حَاصِبًا","ريحًا عاصِفًا ترمِيهِم بالحَصْباءِ."],[11,11,"ٱلصَّيۡحَةُ","صَوْتٌ مِنَ السَّماءِ مُهلِكٌ مُرْجِفٌ."],[14,15,"خَسَفۡنَا بِهِ","جَعَلْنا الأرْضَ تبتَلِعُه وهو حَيٌّ."]],"41":[[12,13,"أَوۡهَنَ ٱلۡبُيُوتِ","أضْعَفَها."]],"43":[[2,2,"نَضۡرِبُهَا","أي: نُبَيِّنُها."],[4,5,"وَمَا يَعۡقِلُهَآ","وما يَفْهَمُها."]],"44":[[8,8,"لَـَٔايَةً","لدَلالَةً عَظِيمةً."]],"45":[[12,12,"ٱلۡفَحۡشَآءِ","أي: كُلِّ عَمَلٍ قَبِيحٍ."],[13,13,"وَٱلۡمُنكَرِ","وهو كلُّ فِعْلٍ يُنكِرُه الشَّرعُ أو العَقْلُ."]],"46":[[2,3,"أَهۡلَ ٱلۡكِتَـٰبِ","وهُمُ اليَهُودُ والنَّصارى."]],"47":[[14,15,"وَمَا يَجۡحَدُ","وما يُنكِرُ."],[16,16,"بِـَٔايَـٰتِنَآ","أي: بالقرآنِ وما فيه مِن دَلائِلَ وبَراهِينَ."],[18,18,"ٱلۡكَـٰفِرُونَ","أي: المُكابِرُونَ في كُفْرِهِم."]],"48":[[11,11,"لَّٱرۡتَابَ","لَشَكَّ."],[12,12,"ٱلۡمُبۡطِلُونَ","هُمْ أهلُ الباطِلِ."]],"49":[[1,2,"هُوَ ءَايَـٰتُۢ","أي: القرآنُ آياتٌ تُتْلى."],[3,3,"بَيِّنَـٰتٌ","واضِحاتٌ."],[7,7,"أُوتُواْ","أُعْطُوا."],[13,13,"ٱلظَّـٰلِمُونَ","أي: المُعانِدُونَ الَّذينَ يَعْلَمُونَ الحقَّ ولا يَتَّبعُونَه."]],"50":[[4,4,"ءَايَـٰتٌ","أي: مُعْجِزاتٌ حِسِّيَّةٌ تُثْبِتُ صِدْقَهُ."],[10,11,"عِندَ ٱللَّهِ","أي: إنْ شاءَ أنْزَلَها، وإنْ شاءَ مَنَعَها."]],"53":[[3,4,"أَجَلٌ مُّسَمًّى","وقْتٌ مُعَيَّنٌ لا يَتَقَدَّمُ ولا يَتَأَخَّرُ."],[8,8,"بَغۡتَةً","فُجاءَةً."]],"54":[[4,4,"لَمُحِيطَةُۢ","أي: سَتُحِيطُ بِهِم في الآخِرَةِ."]],"58":[[4,4,"لَنُبَوِّئَنَّهُم","لَنُنَزِّلَنَّهُم."],[7,7,"غُرَفًا","مَنازِلَ عالِيةً."]],"60":[[0,2,"وَكَأَيِّن مِّن دَآبَّةٍ","أي: كَثِيرٌ مِنَ الدَّوابِّ."],[3,5,"لَّا تَحۡمِلُ رِزۡقَهَا","أي: لا تُطِيقُ حَمْلَهُ ولا ادِّخارَهُ."]],"61":[[11,12,"فَأَنَّىٰ يُؤۡفَكُونَ","فَكَيفَ يُصرَفُونَ عَن تَوحِيدِهِ؟"]],"62":[[1,1,"يَبۡسُطُ","يُوَسِّعُ."],[7,7,"وَيَقۡدِرُ","يُضَيِّقُ."]],"63":[[10,12,"مِنۢ بَعۡدِ مَوۡتِهَا","مِن بَعْدِ قَحْطِ الأرْضِ وجَفافِها."]],"64":[[10,11,"لَهِيَ ٱلۡحَيَوَانُ","لَهِيَ الحَياةُ الدّائِمَةُ الَّتي لا يُنَغِّصُها شَيءٌ."]],"65":[[2,3,"فِي ٱلۡفُلۡكِ","في السُّفُن"]],"67":[[6,7,"وَيُتَخَطَّفُ ٱلنَّاسُ","أي: يُسْتَلَبُونَ قَتْلًا وأسْرًا."],[10,10,"أَفَبِٱلۡبَـٰطِلِ","أي: بالشِّركِ."]],"68":[[3,3,"ٱفۡتَرَىٰ","اخْتَلَقَ."],[15,15,"مَثۡوًى","مَسْكَنٌ."]],"69":[[1,2,"جَـٰهَدُواْ فِينَا","أي: الكُفّارَ والنَّفْسَ والشَّيطانَ."],[3,4,"لَنَهۡدِيَنَّهُمۡ سُبُلَنَا","لَنُرْشِدَنَّهُم طُرُقَنا."]]}