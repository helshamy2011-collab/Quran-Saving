{"1":[[0,0,"تَبَارَكَ","تَكاثَرَ خَيْرُه وعَظُمَتْ بَرَكاتُه."],[3,3,"ٱلۡفُرۡقَانَ","القُرآنَ، الفارقَ بَيْنَ الحقِّ والَباطِلِ."],[8,8,"نَذِيرًا","مُخَوِّفًا."]],"2":[[17,17,"فَقَدَّرَهُۥ","أي: فَهَيَّأَه لِما يَصْلُحُ لَهُ ويلِيقُ بِهِ."]],"3":[[21,21,"نُشُورًا","بَعْثًا بَعْدَ الموتِ."]],"4":[[4,4,"هَـٰذَآ","أي: القرآنُ."],[6,6,"إِفۡكٌ","كَذِبٌ وبُهْتانٌ."],[7,7,"ٱفۡتَرَىٰهُ","اختَلَقَه وتَقَوَّلَه."],[10,11,"قَوۡمٌ ءَاخَرُونَ","أي: من الَّذينَ أسْلَمُوا مِن أهْلِ الكِتابِ."],[15,15,"وَزُورًا","كَذِبًا عظِيمًا."]],"5":[[1,2,"أَسَـٰطِيرُ ٱلۡأَوَّلِينَ","الأكاذيبُ الَّتي كَتَبها المتقدِّمُونَ."],[3,3,"ٱكۡتَتَبَهَا","طَلَبَ كِتابَتَها."],[5,6,"تُمۡلَىٰ عَلَيۡهِ","تُقْرَأُ عَلَيهِ لِيِحْفَظَها."]],"6":[[4,4,"ٱلسِّرَّ","هو كلُّ ما يَغِيبُ ويَخْفى."]],"8":[[7,7,"جَنَّةٌ","أي: بُسْتانٌ مُثْمِرٌ."],[16,16,"مَّسۡحُورًا","مَجْنُونًا، غَلَبَ السِّحرُ على عَقْلِه."]],"10":[[9,9,"جَنَّـٰتٍ","بَساتِينَ وحَدائقَ."],[16,16,"قُصُورَۢا","بُيُوتًا مُشَيَّدةً."]],"11":[[3,3,"وَأَعۡتَدۡنَا","وجَعَلْناه مُعَدًّا لهم."],[7,7,"سَعِيرًا","أي: نارًا مُشْتَعِلةً تُسَعَّر بهم."]],"12":[[7,7,"تَغَيُّظًا","صَوْتَ غَلَيانٍ وفَوَرانٍ."],[8,8,"وَزَفِيرًا","النَّفَسَ الخارِجَ مِنَ الجَوفِ بِشِدَّةٍ."]],"13":[[2,2,"مِنۡهَا","أي: مِن جَهَنَّمَ."],[5,5,"مُّقَرَّنِينَ","مُقَيَّدةً أيدِيهِم إلى أعْناقِهِم."],[8,8,"ثُبُورًا","هَلاكًا."]],"15":[[12,12,"وَمَصِيرًا","ومَرْجِعًا."]],"16":[[9,9,"مَّسۡـُٔولًا","أي: يَسْأَلُ اللهَ عِبادُه المتَّقُونَ"]],"18":[[1,1,"سُبۡحَـٰنَكَ","تَنْزِيهًا لَكَ يا رَبَّنا."],[2,5,"مَا كَانَ يَنۢبَغِي لَنَآ","ما كان يَحِقُّ ولا يَصِحُّ لَنا."],[11,11,"أَوۡلِيَآءَ","المُرادُ به: آلهةٌ نَعْبُدُهُم."],[16,17,"نَسُواْ ٱلذِّكۡرَ","غَفَلُوا عَن دَلائِلِ الوَحْدانيَّةِ."],[20,20,"بُورًا","هالِكِينَ أو فاسِدِين."]],"19":[[6,6,"صَرۡفًا","دَفْعًا."],[10,10,"يَظۡلِم","أي: يُشْرِكْ بِاللهِ."]],"20":[[15,15,"فِتۡنَةً","ابْتِلاءً واخْتِبارًا."]],"21":[[2,3,"لَا يَرۡجُونَ","لا يخافُونَ."],[9,10,"أَوۡ نَرَىٰ","أي: عِيانًا."],[13,15,"ٱسۡتَكۡبَرُواْ فِيٓ أَنفُسِهِمۡ","أضْمَرُوا الاسْتِكْبارَ عَنِ الحَقِّ في قُلُوبِهِم."],[16,16,"وَعَتَوۡ","تَجاوَزُوا الحدَّ في الطُّغيانِ."]],"22":[[8,9,"حِجۡرًا مَّحۡجُورًا","حَرامًا محرَّمًا عَلَيكُمُ الجنَّةُ."]],"23":[[7,7,"هَبَآءً","أي: كالهباءِ وهو ما يُرى في ضَوءِ الشَّمسِ مِن دقِيقِ الغُبارِ."],[8,8,"مَّنثُورًا","مُفَرَّقًا."]],"24":[[6,6,"مَقِيلًا","مَكانًا للرّاحَةِ وقتَ القَيْلُولَةِ."]],"25":[[1,2,"تَشَقَّقُ ٱلسَّمَآءُ","تَتَفَتَّحُ السَّمَواتُ."],[3,3,"بِٱلۡغَمَـٰمِ","بالسَّحابِ الأبيضِ الرَّقِيقِ."]],"26":[[8,8,"عَسِيرًا","صَعْبًا شَدِيدًا."]],"27":[[1,4,"يَعَضُّ ٱلظَّالِمُ عَلَىٰ يَدَيۡهِ","أي: تَحَسُّرًا."]],"28":[[5,5,"خَلِيلًا","صَدِيقًا."]],"29":[[3,3,"ٱلذِّكۡرِ","أي: القرآنِ والإيمانِ به."],[10,10,"خَذُولًا","كثيرَ الخِذْلانِ لِمَن يُوالِيهِ، والخِذْلانُ: التَّخَلِّي عَنِ النُّصْرَةِ."]],"30":[[8,8,"مَهۡجُورًا","مَتْرُوكًا، تُرِكَ الإيمانُ به والعَمَلُ بِما فِيه."]],"31":[[6,6,"ٱلۡمُجۡرِمِينَ","أي: الكافِرِينَ والمُشْرِكِينَ."]],"32":[[3,3,"لَوۡلَا","هَلّا."],[7,8,"جُمۡلَةً وَٰحِدَةً","أي: دُفْعةً واحِدَةً."],[10,12,"لِنُثَبِّتَ بِهِۦ فُؤَادَكَ","لنُقَوِّيَ به قَلْبَكَ."],[13,14,"وَرَتَّلۡنَـٰهُ تَرۡتِيلًا","أي: أنْزَلْناه وفرَّقْناه آيةً بعْدَ آيةٍ."]],"33":[[2,2,"بِمَثَلٍ","بِحُجَّةٍ أو شُبْهَةٍ."]],"35":[[8,8,"وَزِيرًا","مُعِينًا لِتَبْلِيغِ الرِّسالةِ."]],"36":[[7,7,"فَدَمَّرۡنَـٰهُمۡ","فَأَهْلَكْناهُم."]],"37":[[8,8,"ءَايَةً","عِبْرةً."],[9,9,"وَأَعۡتَدۡنَا","هَيَّأنا."]],"38":[[2,3,"وَأَصۡحَـٰبَ ٱلرَّسِّ","أصْحابَ البِئْرِ."],[4,4,"وَقُرُونَۢا","وأُمَمًا."]],"39":[[1,3,"ضَرَبۡنَا لَهُ ٱلۡأَمۡثَـٰلَ","بَيَّنّا لجَمِيعِ الأمَمِ الحُجَجَ، وأَزَلْنا عَنْهم الشَّبُهاتِ."],[5,5,"تَبَّرۡنَا","أهْلَكْنا."]],"40":[[3,3,"ٱلۡقَرۡيَةِ","هي «سَدُومُ» قَرْيَةُ قَومِ لُوطٍ."],[6,7,"مَطَرَ ٱلسَّوۡءِ","أي: بالحِجارةِ مِنَ السَّماءِ."],[13,15,"لَا يَرۡجُونَ نُشُورًا","لا يتَوَقَّعُونَ بَعْثًا بَعْدَ الموتِ."]],"41":[[5,5,"هُزُوًا","مُسْتَهْزَأً بِه."]],"42":[[0,1,"إِن كَادَ","إنّه قارَبَ."]],"43":[[8,8,"وَكِيلًا","حَفِيظًا يَحْفَظُه مِنِ اتِّباعِ هَواهُ."]],"44":[[10,10,"كَٱلۡأَنۡعَـٰمِ","كالبَهائِمِ لا يَفْهَمُونَ."]],"45":[[5,6,"مَدَّ ٱلظِّلَّ","بَسَطَه مِن طُلُوعِ الفَجْرِ إلى طُلُوعِ الشَّمسِ."],[10,10,"سَاكِنًا","ثابِتًا، لا تُزِيلُهُ الشَّمْسُ."],[15,15,"دَلِيلًا","أي: يُسْتَدَلُّ بأحْوالِ الشَّمسِ على أحْوالِ الظِّلِّ."]],"46":[[3,4,"قَبۡضًا يَسِيرًا","أي: يَتَقَلَّصُ الظِّلُّ تَدْرِيجيًّا بِقَدْرِ ارْتِفاعِ الشَّمسِ."]],"47":[[5,5,"لِبَاسًا","ساتِرًا بِظَلامِهِ."],[7,7,"سُبَاتًا","راحَةً لَكُم."],[10,10,"نُشُورًا","تَنْتَشِرُونَ فِيهِ لمَعاشِكُم."]],"49":[[7,7,"أَنۡعَـٰمًا","بَهائِمَ."],[8,8,"وَأَنَاسِيَّ","أُناسًا."]],"50":[[1,2,"صَرَّفۡنَـٰهُ بَيۡنَهُمۡ","أنْزَلْنا المَطَرَ على أنْحاءٍ مُخْتَلِفَةٍ."],[8,8,"كُفُورًا","جُحُودًا بالنِّعمَةِ."]],"52":[[3,4,"وَجَـٰهِدۡهُم بِهِۦ","وجاهِدِ الكُفّارَ بالقُرآنِ والبُرْهانِ."]],"53":[[2,2,"مَرَجَ","خَلَطَ وأرْسَلَ."],[5,6,"عَذۡبٌ فُرَاتٌ","حُلْوٌ شَدِيدُ الحَلاوَةِ."],[9,9,"أُجَاجٌ","شَدِيدُ المُلُوحَةِ."],[11,12,"بَيۡنَهُمَا بَرۡزَخًا","حاجِزًا بين البَحْرَينِ يَمْنَعُ اخْتِلاطَ أحَدِهِما بالآخَر."],[13,14,"وَحِجۡرًا مَّحۡجُورًا","أي: مانِعًا حَصِينًا."]],"54":[[4,4,"ٱلۡمَآءِ","هو مَنِيُّ الرَّجلِ والمرْأةِ."],[8,8,"وَصِهۡرًا","القَرابَةَ النّاشِئَةَ مِنَ الزَّواجِ بَيْنَ الزَّوْجِ وأهْلِ زَوْجتِهِ."]],"55":[[11,13,"عَلَىٰ رَبِّهِۦ ظَهِيرًا","مُعِينًا للشَّيطانِ على رَبِّه."]],"59":[[9,10,"ثُمَّ ٱسۡتَوَىٰ","أي: عَلا وارْتَفَعَ كَما يَلِيقُ بِجَلالِهِ."],[12,12,"ٱلۡعَرۡشِ","هو سريرُ المُلْكِ الَّذِي اسْتَوى عليه الرَّحْمَنُ وتَحْمِلُهُ الملائِكةُ، وهو أعْظَمُ المخْلُوقاتِ، وهو سَقْفُ الجنَّةِ."]],"60":[[12,12,"نُفُورًا","تَباعُدًا عَنِ الإيمانِ."]],"61":[[0,0,"تَبَارَكَ","تَكاثَرَ خَيْرُه وعَظُمَتْ بَرَكاتُه."],[5,5,"بُرُوجًا","مَنازِلَ للكَواكِبِ والنُّجُومِ."],[8,8,"سِرَٰجًا","شَمْسًا تُضِيءُ."]],"62":[[5,5,"خِلۡفَةً","يَخْلُفُ أحدُهما الآخَرَ فَيَتَعاقَبانِ."],[8,9,"أَن يَذَّكَّرَ","أن يَعْتَبرَ."]],"63":[[6,6,"هَوۡنًا","أي: بسَكِينَةٍ وتَواضُعٍ."],[10,11,"قَالُواْ سَلَـٰمًا","أي: قالُوا قَوْلًا سَدِيدًا يَسْلَمُونَ بهِ مِنَ الأذى."]],"64":[[1,1,"يَبِيتُونَ","يَقْضُونَ لَيالِيَهُم."]],"65":[[3,3,"ٱصۡرِفۡ","ادْفَعْ."],[10,10,"غَرَامًا","لِزامًا، يُلازِمُ صاحِبَهُ."]],"67":[[3,4,"لَمۡ يُسۡرِفُواْ","لم يَتَجاوَزُوا حَدَّ الاعْتِدالِ."],[5,6,"وَلَمۡ يَقۡتُرُواْ","ولم يُضَيِّقوا في الإنْفِاقِ."],[10,10,"قَوَامًا","وسَطًا بَيْنَ التَّبذِيرِ والتَّضْيِيقِ."]],"68":[[1,2,"لَا يَدۡعُونَ","لا يَعْبُدُونَ."],[21,21,"أَثَامًا","عِقابًا."]],"69":[[5,6,"وَيَخۡلُدۡ فِيهِۦ","ويَبْقى فيه على الدَّوامِ."],[7,7,"مُهَانًا","ذلِيلًا حَقِيرًا."]],"71":[[8,8,"مَتَابًا","توبةً."]],"72":[[3,3,"ٱلزُّورَ","شَهادَةً كاذِبَةً."],[6,6,"بِٱللَّغۡوِ","بِكُلِّ ساقِطٍ مِن قَوْلٍ أو فِعْلٍ."],[7,8,"مَرُّواْ كِرَامًا","مُكْرِمِينَ أنْفُسَهُم بالإعْراضِ عَنْهُ."]],"73":[[5,6,"لَمۡ يَخِرُّواْ","لم يَسْقُطُوا ولَمْ يَقَعُوا."],[8,9,"صُمًّا وَعُمۡيَانًا","أي: لا يَسْمَعُونَ ولا يُبْصِرُونَ، والمعنى إنّما يَخِرُّونَ عَلَيها سامِعِينَ مُبْصِرِينَ مُنْتَفِعِينَ."]],"74":[[8,9,"قُرَّةَ أَعۡيُنٍ","مَوْضِعَ سُرورٍ وفَرَحٍ."]],"75":[[2,2,"ٱلۡغُرۡفَةَ","المرادُ منها أعلى مَنازِلِ الجنَّةِ وأَفْضَلُها."]],"77":[[1,3,"مَا يَعۡبَؤُاْ بِكُمۡ","لا يُبالي بكُم."],[11,11,"لِزَامَۢا","أي: عَذابًا داِئمًا مُلازِمًا لَكُم."]]}