{"3":[[1,2,"أَدۡنَى ٱلۡأَرۡضِ","أقْرَبِ أرْضِ الشّامِ إلى فارِس."],[6,6,"غَلَبِهِمۡ","أي: كَوْنِهِم مَغْلُوبِينَ."]],"4":[[1,2,"بِضۡعِ سِنِينَ","أي: ما بينَ الثَّلاثَةِ إلى العَشْرَةِ"]],"7":[[1,4,"ظَـٰهِرًا مِّنَ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","فَيَنْظُرُونَ إلى الأسْبابِ الظّاهِرَةِ ولا يَنْظُرُونَ إلى مُسَبِّبِها المتَصَرِّفِ فِيها الَّذي هُوَ اللهُ تَعالى."]],"8":[[13,14,"أَجَلٍ مُّسَمًّى","وقْتٍ مُقَدَّرٍ هُوَ يومُ القِيامَةِ."],[19,20,"بِلِقَآيِٕ رَبِّهِمۡ","المُرادُ به البَعْثُ بَعْدَ الموتِ."]],"9":[[7,10,"عَـٰقِبَةُ ٱلَّذِينَ مِن قَبۡلِهِمۡ","أي: مَصِيرُهُم الَّذي انْتهَوا إليهِ."],[15,16,"وَأَثَارُواْ ٱلۡأَرۡضَ","حَرَثُوها للزِّراعَةِ."],[17,17,"وَعَمَرُوهَآ","أي: بالبُنْيانِ والزِّراعَةِ."],[23,23,"بِٱلۡبَيِّنَـٰتِ","بالبَراهِينِ الواضِحةِ، ومنها المُعْجِزاتُ الحِسِّيةُ."]],"10":[[5,5,"ٱلسُّوٓأَىٰٓ","تَأْنِيثُ «الأسْوأ»، ومعناها: العُقُوبَةُ المتناهِيةُ في السُّوءِ، وهي نارُ جَهَنَّم."]],"11":[[1,1,"يَبۡدَؤُاْ","يُنْشِئُ ابتِداءً."],[4,4,"يُعِيدُهُۥ","يُعِيدُ الخَلْقَ مِن بَعْدِ فَنائِهِ."]],"12":[[3,4,"يُبۡلِسُ ٱلۡمُجۡرِمُونَ","يَيْئَسُونَ بانْقِطاعِ حُجَّتِهِم."]],"13":[[3,4,"مِّن شُرَكَآئِهِمۡ","أي: مِن آلهَتِهِم الَّتي كانُوا يَعْبُدُونَها مِن دُونِ اللهِ."]],"14":[[4,4,"يَتَفَرَّقُونَ","أي: فَرِيقٌ في الجنَّة، وفَرِيقٌ في السَّعِيرِ."]],"15":[[7,7,"رَوۡضَةٍ","المرادُ بِها هُنا «الجنَّةُ»."],[8,8,"يُحۡبَرُونَ","يُكَرَّمُونَ ويُنَعَّمُونَ."]],"16":[[5,6,"وَلِقَآيِٕ ٱلۡـَٔاخِرَةِ","أي: البَعْثِ بَعْدَ الموتِ."],[8,10,"فِي ٱلۡعَذَابِ مُحۡضَرُونَ","مُقيمُونَ فِيهِ."]],"17":[[0,1,"فَسُبۡحَـٰنَ ٱللَّهِ","أي: فنزِّهُوهُ عمّا لا يَلِيقُ بِه."],[2,3,"حِينَ تُمۡسُونَ","أي: وقْتَ دُخُولِكُم في المساءِ."],[4,5,"وَحِينَ تُصۡبِحُونَ","أي: وقْتَ دُخُولِكَمُ في الصَّباحِ."]],"18":[[5,5,"وَعَشِيًّا","وقْتَ العَشِيِّ، أي: بَعْدَ زَوالِ الشَّمسِ."],[6,7,"وَحِينَ تُظۡهِرُونَ","أي: وقْتَ الظَّهِيَرةِ."]],"19":[[10,11,"بَعۡدَ مَوۡتِهَا","أي: قَحْطِها وجَفافِها."],[13,13,"تُخۡرَجُونَ","أي: تُبعثُونَ مِن قُبُورِكُم."]],"20":[[10,10,"تَنتَشِرُونَ","تَتَفَرَّقُونَ."]],"21":[[5,6,"مِّنۡ أَنفُسِكُمۡ","مِن جِنْسِكُم."],[8,9,"لِّتَسۡكُنُوٓاْ إِلَيۡهَا","لِتألَفُوها وتَطْمئنُّوا إلَيها."],[12,13,"مَّوَدَّةً وَرَحۡمَةً","مَحَبَّةً وشَفَقَةً."],[19,19,"يَتَفَكَّرُونَ","يَتَدَبَّرُونَ."]],"22":[[6,6,"أَلۡسِنَتِكُمۡ","لُغاتِكُم."]],"23":[[5,5,"ٱبۡتِغَآؤُكُم","طَلَبُكُم والتِماسُكُم."],[6,7,"مِّن فَضۡلِهِۦٓ","مِن رِزْقِه."]],"24":[[4,5,"خَوۡفًا وَطَمَعًا","أي: خَوْفًا مِنَ الصَّواعِقِ وطَمعًا في الغَيثِ."],[13,14,"بَعۡدَ مَوۡتِهَآ","بَعْدَ قَحْطِها وجَفافِها."]],"25":[[6,6,"بِأَمۡرِهِۦ","بِإرادَتِه وقُدْرَتِهِ."],[15,15,"تَخۡرُجُونَ","أي: مِن قُبُورِكُم أحْياءً."]],"26":[[6,7,"لَّهُۥ قَـٰنِتُونَ","مُنْقادُونَ لإرادَتِه."]],"27":[[2,2,"يَبۡدَؤُاْ","يُنْشِئُ."],[7,7,"أَهۡوَنُ","هيِّنٌ ويَسِيرُ."],[10,11,"ٱلۡمَثَلُ ٱلۡأَعۡلَىٰ","الوصْفُ الأَعْلى."]],"28":[[9,10,"مَلَكَتۡ أَيۡمَـٰنُكُم","أي: العبِيدُ والإماءُ."],[20,21,"كَخِيفَتِكُمۡ أَنفُسَكُمۡ","أي: كَما تَخافُونَ الأحْرارَ المُشابِهِينَ لَكُم في الحرِّيَّةِ وتَمَلُّكِ الأمْوالِ."]],"30":[[0,2,"فَأَقِمۡ وَجۡهَكَ لِلدِّينِ","أي: اسْتَقِمْ واسْتَمِر عَلى دِينِ الإسْلامِ."],[3,3,"حَنِيفًا","مائِلًا إليه مُسْتَقِيمًا عَلِيهِ، غَيْرَ مُلْتَفِتٍ إلى غَيْرِه مِنَ الأدْيانِ الباطِلَةِ."],[4,5,"فِطۡرَتَ ٱللَّهِ","أي: الزَمُوا فِطْرَةَ اللهِ، وهِيَ الإسْلامُ."],[7,9,"فَطَرَ ٱلنَّاسَ عَلَيۡهَا","أي: خَلَقَهُم عَلَيها."]],"31":[[0,1,"مُنِيبِينَ إِلَيۡهِ","راجِعِينَ إليهِ بالتَّوبَةِ والإخْلاصِ."]],"32":[[2,3,"فَرَّقُواْ دِينَهُمۡ","أي: آمَنُوا بِبَعْضٍ وكَفَرُوا بِبَعْضٍ."],[5,5,"شِيَعًا","فِرَقًا وأحْزابًا مُخْتلِفَةً."],[6,7,"كُلُّ حِزۡبِۭ","كلُّ فَرِيقٍ."],[10,10,"فَرِحُونَ","مَسْرُورُونَ."]],"33":[[3,3,"ضُرٌّ","قَحْطٌ وشِدَّةٌ."],[6,7,"مُّنِيبِينَ إِلَيۡهِ","مُلْتَجِئِينَ إليهِ بالتَّوبَةِ والإخْلاصِ."],[10,12,"أَذَاقَهُم مِّنۡهُ رَحۡمَةً","أي: كَشَفَ عَنْهُم ضُرَّهُم."]],"35":[[3,3,"سُلۡطَـٰنًا","بُرْهانًا أو كِتابًا."]],"36":[[4,5,"فَرِحُواْ بِهَا","فرِحُوا بِها فَرَحَ بَطَرٍ لا فَرَحَ شُكْرٍ."],[9,11,"بِمَا قَدَّمَتۡ أَيۡدِيهِمۡ","أي: بِسَبَبِ أعْمالِهِم السَّيِّئةِ."],[14,14,"يَقۡنَطُونَ","يَيْئَسُونَ."]],"37":[[8,8,"وَيَقۡدِرُ","يُضَيِّقُ."]],"38":[[0,0,"فَـَٔاتِ","فأعْطِ."],[4,4,"ٱلۡمِسۡكِينَ","الفَقِيرَ الَّذِي لا يَمْلِكُ ما يَكْفِيهِ ويَسُدُّ حاجَتَه."],[5,6,"ٱبۡنَ ٱلسَّبِيلِ","المُسافِرَ المُحْتاجَ."]],"39":[[0,1,"وَمَآ ءَاتَيۡتُم","وما أعطَيتُم."],[3,3,"رِّبًا","قَرْضًا أو هَدِيَّةً بِقَصْدِ الرِّبا والزِّيادَةِ."],[4,4,"لِّيَرۡبُوَاْ","لِيَزِيِدَ ويَنْمُوَ."],[8,9,"فَلَا يَرۡبُواْ","فَلا يَزِيدُ."],[21,21,"ٱلۡمُضۡعِفُونَ","أي: هُمْ أصْحابُ الأجْرِ المُضاعَفِ."]],"40":[[10,11,"مِن شُرَكَآئِكُم","مِنَ آلَهتِكُم الَّتي تَعْبُدُونَها مِن دُونِ اللهِ."],[18,19,"سُبۡحَـٰنَهُۥ وَتَعَـٰلَىٰ","تَنَزَّهَ اللهُ وتَقَدَّسَ."]],"41":[[5,8,"بِمَا كَسَبَتۡ أَيۡدِي ٱلنَّاسِ","أي: بِسَبَبِ أعْمالِهِم السَّيِّئةِ."],[10,11,"بَعۡضَ ٱلَّذِي","أي: عُقُوبَةَ بَعْضِ الَّذي."],[14,14,"يَرۡجِعُونَ","أي: يَتُوبُونَ إلى اللهِ."]],"43":[[2,3,"لِلدِّينِ ٱلۡقَيِّمِ","أي: نَحْوَ الدِّينِ المسْتَقِيم، وهو الإسْلامُ."],[9,11,"لَّا مَرَدَّ لَهُۥ","أي: لا يقْدِرُ أحدٌ على ردِّهِ."],[15,15,"يَصَّدَّعُونَ","يَتَفَرَّقُونَ، فَرِيقٌ في الجنَّةِ وفَرِيقٌ في السَّعيرِ."]],"44":[[8,8,"يَمۡهَدُونَ","يُوَطِّئُونَ ويُهَيِّئُونَ الطَّريقَ إلى مَنازِلَ في الجنَّةِ."]],"46":[[5,5,"مُبَشِّرَٰتٍ","أي: بِنُزُولِ المَطَرِ."],[7,8,"مِّن رَّحۡمَتِهِۦ","والمرادُ بها هُنا: المَطرُ."],[10,10,"ٱلۡفُلۡكُ","السُّفُنُ."],[12,12,"لِتَبۡتَغُواْ","لِتَطْلُبُوا."]],"47":[[8,8,"بِٱلۡبَيِّنَـٰتِ","بالمُعْجِزاتِ والبراهِينِ الواضِحةِ."],[11,12,"ٱلَّذِينَ أَجۡرَمُواْ","الَّذينَ فَعَلُوا الإجْرامَ واكْتَسَبُوا السَّيِّئاتِ."]],"48":[[4,4,"فَتُثِيرُ","فتُحَرِّكُ وتَنْشُرُ."],[6,6,"فَيَبۡسُطُهُۥ","فَيَنْشُرُه."],[12,12,"كِسَفًا","قِطَعًا متفرِّقةً."],[14,14,"ٱلۡوَدۡقَ","المطَرَ."],[16,17,"مِنۡ خِلَـٰلِهِۦ","مِن فُرَجِ السَّحابِ ووَسَطِه."],[27,27,"يَسۡتَبۡشِرُونَ","يَفْرَحُونَ."]],"49":[[9,9,"لَمُبۡلِسِينَ","لَآيسِينَ مِن نُّزُولِ المطَرِ."]],"51":[[2,2,"رِيحًا","أي: رِيحًا مُفْسِدَةً لِنَباتِهم."],[3,4,"فَرَأَوۡهُ مُصۡفَرًّا","فَرَأَوُا النَّباتَ مُصْفَرًّا بَعْدَ الخُضْرَةِ."],[5,5,"لَّظَلُّواْ","لَصارُوا."],[8,8,"يَكۡفُرُونَ","يَجْحَدُونَ باللهِ وبنِعَمِه."]],"52":[[4,4,"وَلَّوۡاْ","انصَرَفُوا."]],"53":[[2,3,"بِهَـٰدِ ٱلۡعُمۡيِ","بمُرْشِدِ مَن أعْماهُ اللهُ عَنِ الحقِّ."],[13,13,"مُّسۡلِمُونَ","خاضِعُونَ مُنْقادُونَ."]],"54":[[3,4,"مِّن ضَعۡفٍ","أي: مِن نُّطْفَةٍ ضَعِيفَةٍ."],[7,9,"مِنۢ بَعۡدِ ضَعۡفٍ","أي: مِن بَعْدِ ضَعْفِ الطُّفولَةِ والصِّغَرِ."],[10,10,"قُوَّةٍ","أي: قُوَّةِ الشَّبابِ."],[16,16,"ضَعۡفًا","أي: ضَعْفَ الكِبَرِ والهرَمِ."],[17,17,"وَشَيۡبَةً","أي: بياضًا في الشَّعْرِ وضَعْفًا في قُوى الجسِمِ."]],"55":[[7,8,"غَيۡرَ سَاعَةٍ","غيرَ فَتْرَةِ قَصِيرةٍ مِنَ الزَّمَنِ."],[11,11,"يُؤۡفَكُونَ","يُصْرَفُونَ عَنِ الحقِّ والصِّدقِ."]],"57":[[5,5,"مَعۡذِرَتُهُمۡ","اعْتِذارُهُم."],[6,8,"وَلَا هُمۡ يُسۡتَعۡتَبُونَ","لا يُطْلَبُ مِنهُم إرْضاءُ اللهِ تَعالى بالتَّوبَةِ والطّاعَةِ."]],"58":[[11,11,"بِـَٔايَةٍ","أي: بِأيِّ حُجَّةٍ."],[18,18,"مُبۡطِلُونَ","أي: أصْحابُ أباطِيلَ."]],"59":[[1,1,"يَطۡبَعُ","يَخْتِمُ، فلا تَعِي شيئًا مِنَ الحَقِّ."]],"60":[[5,6,"وَلَا يَسۡتَخِفَّنَّكَ","لا يَحْمِلَنَّكَ على الخِفَّةِ وتَرْكِ الصَّبْرِ."]]}