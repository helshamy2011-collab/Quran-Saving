{"1":[[0,0,"وَٱلۡفَجۡرِ","أقْسَم اللهُ بِوَقْتِ الفجْرِ."]],"2":[[0,1,"وَلَيَالٍ عَشۡرٍ","هي الليالي العَشْرُ الأُوَلُ مِن ذِي الحِجَّةِ."]],"3":[[0,0,"وَٱلشَّفۡعِ","كُلُّ شَيءٍ خَلَقَه اللهُ زَوْجًا فهو شَفْعٌ."],[1,1,"وَٱلۡوَتۡرِ","الفَرْدِ."]],"4":[[2,2,"يَسۡرِ","يَسْرِي بِظَلامِهِ."]],"5":[[3,3,"قَسَمٌ","مَقْنَعٌ ومُكْتَفىً في القَسَمِ."],[4,5,"لِّذِي حِجۡرٍ","لِصاحِبِ عَقْلٍ."]],"7":[[0,0,"إِرَمَ","قَبِيلةِ إرَمَ."],[1,2,"ذَاتِ ٱلۡعِمَادِ","صاحبةِ القُوُّةِ والأبْنِيَةِ المَرْفُوعَةِ على الأعْمِدَةِ."]],"8":[[3,3,"مِثۡلُهَا","مِثْلُ تِلْكَ القَبِيلةِ في الطُّولِ والقُوَّةِ."]],"9":[[2,2,"جَابُواْ","قَطَعُوا."],[3,3,"ٱلصَّخۡرَ","الحَجَرَ العَظِيمَ الصُّلْبَ الَّذِي عَمِلُوا مِنهُ البُيوتَ."],[4,4,"بِٱلۡوَادِ","بِوادِي القُرى."]],"10":[[1,2,"ذِي ٱلۡأَوۡتَادِ","صاحِبِ الجُنُودِ الَّذِين ثَبَّتُوا مُلكَهُ، وقَوَّوا لَهُ أمْرَهُ."]],"11":[[1,1,"طَغَوۡاْ","تَجاوَزُوا الحدَّ في الظُّلْمِ."]],"13":[[0,1,"فَصَبَّ عَلَيۡهِمۡ","فَغَشّاهُم."],[3,4,"سَوۡطَ عَذَابٍ","عَذابًا شَدِيدا."]],"14":[[2,2,"لَبِٱلۡمِرۡصَادِ","لا يفُوتُه شَيءٌ مِن أعْمالِ العِبادِ."]],"15":[[4,4,"ٱبۡتَلَىٰهُ","اخْتَبَرَهُ."],[6,6,"فَأَكۡرَمَهُۥ","بَسَطَ لَهُ في رِزقِهِ."],[7,7,"وَنَعَّمَهُۥ","جَعَلَه في أطْيَبِ عَيْشٍ."]],"16":[[3,3,"ٱبۡتَلَىٰهُ","اخْتَبَرَهُ."],[4,4,"فَقَدَرَ","فَضَيَّقَ."],[9,9,"أَهَـٰنَنِ","أذَلَّنِي بالفَقْرِ."]],"17":[[0,0,"كَلَّا","ليسَ الأمرُ كَما يَظُنُّ هَذا الإنْسانُ."],[2,3,"لَّا تُكۡرِمُونَ","لا تُحْسنُونَ مُعامَلةَ."],[4,4,"ٱلۡيَتِيمَ","الطِّفْلَ الَّذِي ماتَ أبُوهُ وهو صَغِيرٌ."]],"18":[[0,1,"وَلَا تَحَـٰٓضُّونَ","ولا يَحثُّ بعضُكُم بعْضًا."],[4,4,"ٱلۡمِسۡكِينِ","المُحْتاجِ الَّذِي لا يَمْلِكُ ما يَكْفِيهِ."]],"19":[[1,1,"ٱلتُّرَاثَ","حُقُوقَ الآخرِينَ في الِميراثِ."],[3,3,"لَّمًّا","شَدِيدًا، وهو أن يأكُلَ نَصِيبَهُ ونَصِيبَ غَيرِه."]],"20":[[3,3,"جَمًّا","كَثِيرًا مُفْرِطًا."]],"21":[[0,0,"كَلَّآ","لا ينبغِي أن يكُونَ حالُكُم كَما ذُكِر."],[2,3,"دُكَّتِ ٱلۡأَرۡضُ","زُلْزِلَتِ الأرْضُ وكَسَّرَ بَعْضُها بَعْضًا."],[4,5,"دَكًّا دَكًّا","مَرَّةً بعدَ مَرَّةٍ."]],"22":[[2,2,"وَٱلۡمَلَكُ","والملائِكةُ."],[3,4,"صَفًّا صَفًّا","صُفُوفًا صفُوفًا."]],"23":[[4,5,"يَتَذَكَّرُ ٱلۡإِنسَـٰنُ","يتَّعِظُ الكافِرُ ويتُوبُ."],[6,8,"وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ","ومِن أينَ لَهُ التَّوبةُ؟."]],"24":[[2,2,"قَدَّمۡتُ","العملَ الصّالحَ."],[3,3,"لِحَيَاتِي","في الآخِرةِ."]],"26":[[0,1,"وَلَا يُوثِقُ","ولا يَشُدُّ ويَربِطُ للعذابِ."],[2,2,"وَثَاقَهُۥٓ","رَبْطَهُ بالسَّلاسِلِ ونَحْوِها للعذابِ."]],"27":[[2,2,"ٱلۡمُطۡمَئِنَّةُ","الموقِنَةُ بِأنّ اللهَ ربُّها، المطيعةُ لَهُ."]],"28":[[3,3,"رَاضِيَةً","بالثَّوابِ."],[4,4,"مَّرۡضِيَّةً","مَرْضِيًّا عَنكِ."]],"29":[[1,2,"فِي عِبَـٰدِي","مَعَ عِبادِي، وقيل: في جُمْلةِ عِبادِي الصّالحِينَ المُطِيعِينَ."]]}