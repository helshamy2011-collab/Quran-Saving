{"1":[[0,0,"وَٱلصَّـٰٓفَّـٰتِ","هي الملائِكَةُ التي تَصْطَفُّ في عِبادَتِها."]],"2":[[0,0,"فَٱلزَّٰجِرَٰتِ","هي الملائكةُ التي تَزْجُرُ السَّحابَ وتَسُوقُه."]],"3":[[1,1,"ذِكۡرًا","هو القرآنُ."]],"6":[[5,5,"ٱلۡكَوَاكِبِ","النُّجُومِ."]],"7":[[4,4,"مَّارِدٍ","مُتَمَرِّدٍ خارجٍ عَنِ الطّاعةِ."]],"8":[[5,5,"وَيُقۡذَفُونَ","ويُرجَمُونَ (بالشُّهُبِ)."]],"9":[[0,0,"دُحُورًا","إبْعادًا وطَرْدًا."],[3,3,"وَاصِبٌ","دائمٌ لا يَنْقَطِعُ."]],"10":[[2,3,"خَطِفَ ٱلۡخَطۡفَةَ","أي: اسْتَرَقَ السَّمْعَ خِلْسةً."],[4,4,"فَأَتۡبَعَهُۥ","تَبِعَه ولحِقَه."],[5,6,"شِهَابٌ ثَاقِبٌ","نَجْمٌ مُضِيءٌ."]],"11":[[11,11,"لَّازِبِۭ","مُلْتَزِقٍ بَعْضُه ببَعْضٍ."]],"12":[[2,2,"وَيَسۡخَرُونَ","يَسْتَهْزِئُونَ بِكَ."]],"14":[[2,2,"ءَايَةً","مُعْجِزَةً مِن مُّعْجِزاتِكَ."],[3,3,"يَسۡتَسۡخِرُونَ","يبالِغُونَ في سُخْرِيَّتِهِم."]],"18":[[3,3,"دَٰخِرُونَ","أذِلّاءُ صاغِرُونَ."]],"19":[[2,3,"زَجۡرَةٌ وَٰحِدَةٌ","نَفْخَةٌ واحِدَةٌ."]],"20":[[1,1,"يَـٰوَيۡلَنَا","يا هَلاكَنا."]],"21":[[1,2,"يَوۡمُ ٱلۡفَصۡلِ","يومُ القضاءِ بَيْنَ الخَلْقِ."]],"22":[[0,0,"ٱحۡشُرُواْ","اجْمَعُوا."],[3,3,"وَأَزۡوَٰجَهُمۡ","قُرَناءَهُم ونُظراءَهُم."]],"23":[[3,6,"فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ","دُلُّوهُم إلى طَرِيقِ النّارِ، وسُوقُوهُم إليها."]],"24":[[0,0,"وَقِفُوهُمۡ","احْبِسُوهُم في مَوْقِفِ الحِسابِ."]],"26":[[3,3,"مُسۡتَسۡلِمُونَ","مُنْقادُونَ أذلّاءُ لِعَجِزِهِم عَنِ الحِيلَةِ."]],"28":[[4,5,"عَنِ ٱلۡيَمِينِ","أي: عَنِ النّاحيةِ الَّتي كان مِنها الحقُّ، فَتَصْرِفُونَنا عَنْها."]],"30":[[9,9,"طَـٰغِينَ","متجاوِزِينَ الحَدَّ في الكُفْرِ والضَّلالِ."]],"31":[[0,0,"فَحَقَّ","ثَبَتَ ووَجَبَ."]],"32":[[0,0,"فَأَغۡوَيۡنَـٰكُمۡ","فأَضْلَلْناكُم."],[3,3,"غَـٰوِينَ","ضالِّيِنَ."]],"45":[[0,0,"يُطَافُ","يُدارُ."],[2,2,"بِكَأۡسٍ","بِكأسٍ مِن خمْرٍ."],[4,4,"مَّعِينِۭ","نابِعٍ مِنَ العُيوَنِ."]],"47":[[0,2,"لَا فِيهَا غَوۡلٌ","لا أذىً فيها ولا مَكْروهٌ على شاربيها."],[3,6,"وَلَا هُمۡ عَنۡهَا يُنزَفُونَ","ولا هم عَن شُرْبِها تَذْهَبُ عُقُولُهم، أي: لا تُنزَفُ عُقُولُهم كما يُنْزَفَ دَمُ الجَرِيحِ."]],"48":[[1,2,"قَـٰصِرَٰتُ ٱلطَّرۡفِ","حُورٌ قَصَرْنَ نَظَرَهُنَّ على أزْواجِهِنَّ."],[3,3,"عِينٌ","جَمْعُ «عَيناءَ»: واسعةُ العَينِ حَسَنَتُها."]],"49":[[2,2,"مَّكۡنُونٌ","مَصُونٌ لم يَمْسَسْهُ أحَدٌ."]],"51":[[6,6,"قَرِينٌ","صاحِبٌ مُلازِمٌ."]],"53":[[6,6,"لَمَدِينُونَ","لَمَجْزِيُّونَ ومُحاسَبُونَ."]],"55":[[3,4,"سَوَآءِ ٱلۡجَحِيمِ","وسَطِها."]],"56":[[1,1,"تَٱللَّهِ","واللهِ."],[3,3,"كِدتَّ","قارَبْتَ."],[4,4,"لَتُرۡدِينِ","لَتُهْلِكُنِي."]],"57":[[5,5,"ٱلۡمُحۡضَرِينَ","أي: في العذابِ مِثلَك."]],"62":[[2,2,"نُّزُلًا","ما يُهَيَّأُ للنَّزيلِ إكْرامًا لهُ."],[4,5,"شَجَرَةُ ٱلزَّقُّومِ","الشَّجَرَةُ الخَبيَثةُ الملعُونةُ ذاتُ الثَّمرِ المُرِّ الكرِيهِ الرّائِحَةِ."]],"63":[[2,3,"فِتۡنَةً لِّلظَّـٰلِمِينَ","مِحْنَةً لَهُم لِكَوْنِهِم يُعَذَّبُونَ بِها في الآخِرةِ."]],"64":[[2,2,"تَخۡرُجُ","تَنْبُتُ."],[4,5,"أَصۡلِ ٱلۡجَحِيمِ","قَعْرِ جَهَنَّمَ."]],"65":[[0,0,"طَلۡعُهَا","ثَمَرُها."],[1,3,"كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ","تشبيهٌ للمَحْسُوسِ بالمتَخَيَّلِ؛ لِتناهِيهِ في البَشاعَةِ والقُبْحِ."]],"67":[[4,4,"لَشَوۡبًا","لخَلْطًا ومِزاجًا."],[5,6,"مِّنۡ حَمِيمٍ","الماءِ الحارِّ الشَّديدِ الحرارةِ."]],"68":[[2,2,"مَرۡجِعَهُمۡ","مَرَدَّهُم."],[4,4,"ٱلۡجَحِيمِ","جَهَنَّمَ."]],"69":[[1,1,"أَلۡفَوۡاْ","وجَدُوا."]],"70":[[3,3,"يُهۡرَعُونَ","يُسْرِعُونَ إلى متابعةِ آبائِهِم الضّالِّينَ."]],"72":[[3,3,"مُّنذِرِينَ","مُرسَلِينَ."]],"76":[[3,4,"ٱلۡكَرۡبِ ٱلۡعَظِيمِ","الغَرَقِ بالطُّوفانِ العظيمِ."]],"78":[[3,3,"ٱلۡـَٔاخِرِينَ","الَّذينَ جاؤُوا بَعْدَه."]],"82":[[2,2,"ٱلۡـَٔاخَرِينَ","الباقِينَ الَّذين كذَّبوُا نوحًا عليه الصَّلاةُ والسَّلامُ."]],"83":[[2,2,"شِيعَتِهِۦ","أي: جَماعَتِهِ الَّذينَ هُمُ الأنبِياءُ والمرْسَلُونَ عليهم الصَّلاةُ والسَّلامُ."]],"86":[[0,0,"أَئِفۡكًا","أكَذِبًا وباطِلًا."]],"88":[[0,0,"فَنَظَرَ","تَأَمَّلَ."]],"89":[[2,2,"سَقِيمٌ","مَرِيضٌ."]],"90":[[0,2,"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ","فانصَرَفُوا عنه مُعْرِضِين."]],"91":[[0,1,"فَرَاغَ إِلَىٰٓ","ذَهَبَ خُفْيَةً."]],"93":[[0,1,"فَرَاغَ عَلَيۡهِمۡ","مالَ وأَقْبَل عَلَيهِم."],[3,3,"بِٱلۡيَمِينِ","أي: بيَدِه اليُمْنى."]],"94":[[2,2,"يَزِفُّونَ","يُسْرِعُونَ في مَشْيِهِم."]],"95":[[3,3,"تَنۡحِتُونَ","تَبْرُونَ وتَقْشِرُونَ بِأَيْدِيكُم."]],"97":[[6,6,"ٱلۡجَحِيمِ","النّارِ الشَّديدةِ الاتِّقادِ."]],"98":[[4,4,"ٱلۡأَسۡفَلِينَ","المقْهُورِينَ المغْلُوبِينَ."]],"101":[[2,2,"حَلِيمٍ","أي: عِنْدَما يَكْبَر."]],"103":[[1,1,"أَسۡلَمَا","اسْتَسْلَما لأمْرِ اللهِ وانْقادا لَه."],[2,3,"وَتَلَّهُۥ لِلۡجَبِينِ","أي: أضْجَعَه على جَبينِه على الأرضِ."]],"106":[[3,4,"ٱلۡبَلَـٰٓؤُاْ ٱلۡمُبِينُ","الاخْتِبارُ الواضِحُ."]],"107":[[1,2,"بِذِبۡحٍ عَظِيمٍ","بكَبْشٍ مَذْبُوحٍ عَظِيمِ القَدْرِ."]],"108":[[1,1,"عَلَيۡهِ","أي: على ذِكْرِه الحَسَنِ."],[2,3,"فِي ٱلۡـَٔاخِرِينَ","في الأُمَمِ التي جاءتْ بَعْدَه."]],"115":[[2,4,"مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","أي: مِنَ الغَرَقِ وتَسَلُّطِ فِرْعَونَ."]],"119":[[1,1,"عَلَيۡهِمَا","أي: على ذِكْرِهِما الحَسَنِ."],[2,3,"فِي ٱلۡـَٔاخِرِينَ","في الأمَمِ الَّتي جاءَتْ بَعْدَهُما."]],"125":[[1,1,"بَعۡلًا","وهو اسْمٌ لِصَنَمٍ كانُوا يَعْبُدُونَهُ."],[2,2,"وَتَذَرُونَ","تَتْرُكُونَ."]],"127":[[2,2,"لَمُحۡضَرُونَ","أي: لِلْحِسابِ والعِقابِ."]],"129":[[1,1,"عَلَيۡهِ","أي: على ذِكْرِه الحَسَنِ."],[2,3,"فِي ٱلۡـَٔاخِرِينَ","في الأُمَمِ الَّتي جاءَتْ بَعْدَهُ."]],"135":[[2,3,"فِي ٱلۡغَـٰبِرِينَ","الباقِينَ في العذابِ."]],"136":[[1,1,"دَمَّرۡنَا","أهْلَكْنا."],[2,2,"ٱلۡـَٔاخَرِينَ","الباقِينَ مِن قَومِ لُوطٍ عَلَيهِ السَّلامُ الَّذينَ لم يُؤْمِنُوا بِهِ."]],"137":[[3,3,"مُّصۡبِحِينَ","داخِلِينَ وقْتَ الصَّباحِ."]],"140":[[1,1,"أَبَقَ","هَرَبَ."],[4,4,"ٱلۡمَشۡحُونِ","المَمْلُوءِ."]],"141":[[0,0,"فَسَاهَمَ","اقْتَرَعَ وقَبِلَ القُرْعَةَ."],[3,3,"ٱلۡمُدۡحَضِينَ","المَغْلُوبِينَ بالقُرْعَةِ."]],"142":[[0,0,"فَٱلۡتَقَمَهُ","فابْتَلَعَه."],[3,3,"مُلِيمٌ","آتٍ بما يُلامُ عَلَيهِ."]],"143":[[4,4,"ٱلۡمُسَبِّحِينَ","بِذِكْرِ اللهِ وكَثْرةِ العِبادةِ."]],"144":[[0,0,"لَلَبِثَ","لمَكَثَ."]],"145":[[0,0,"فَنَبَذۡنَـٰهُ","طَرَحْناه."],[1,1,"بِٱلۡعَرَآءِ","بِأرْضٍ خاليةٍ عاريةٍ من الشَّجرِ والبناءِ."],[3,3,"سَقِيمٌ","ضَعِيفُ البَدَنِ بسَبِبِ حَبْسِهِ في بَطْنِ الحُوتِ."]],"146":[[4,4,"يَقۡطِينٍ","القَرْعِ."]],"151":[[3,3,"إِفۡكِهِمۡ","من كَذِبِهِم وافْتِرائِهِم."]],"153":[[0,0,"أَصۡطَفَى","هل اخْتارَ؟"]],"156":[[2,3,"سُلۡطَـٰنٌ مُّبِينٌ","حُجَّةٌ واضِحةٌ."]],"158":[[2,3,"وَبَيۡنَ ٱلۡجِنَّةِ","بَيْنَ الملائِكَةِ."],[9,9,"لَمُحۡضَرُونَ","أي: لِلْعَذابِ."]],"162":[[3,3,"بِفَـٰتِنِينَ","بمُضِلِّينَ ومُفْسِدِينَ أحَدًا."]],"163":[[3,4,"صَالِ ٱلۡجَحِيمِ","يَدْخُلُ النارَ، ويُقاسي حَرَّها."]],"165":[[2,2,"ٱلصَّآفُّونَ","الواقِفُونَ صُفُوفًا."]],"166":[[2,2,"ٱلۡمُسَبِّحُونَ","المُنَزِّهُونَ للهِ والمُقَدِّسُونَ له عَن كُلِّ ما لا يَلِيقُ بِه."]],"168":[[3,5,"ذِكۡرًا مِّنَ ٱلۡأَوَّلِينَ","أي: كِتابًا مِن كُتُبِ الأوَّلِينَ كالتَّوراةِ والإنْجِيلِ."]],"170":[[0,1,"فَكَفَرُواْ بِهِۦ","أي: فَجاءَهُم الرَّسُولُ بالقرآنِ فَكَفَرُوا بِهِ."]],"177":[[2,2,"بِسَاحَتِهِمۡ","بِفِنائِهِم، والمرادُ: القَومُ."]]}