{"1":[[0,0,"نٓ","سَبَقَ الكَلامُ عَلى الحروفِ المُقَطَّعةِ في أوَّلِ سُورَةِ البَقَرَةِ."],[1,1,"وَٱلۡقَلَمِ","أقْسَمَ اللهُ بالقلمِ الَّذِي يَكْتُبُ بهِ الملائِكةُ والنّاسُ."],[2,3,"وَمَا يَسۡطُرُونَ","أقْسَمَ اللهُ بِما يَكْتُبُونَ مِنَ الخَيرِ والنَّفْعِ والعُلُومِ."]],"3":[[2,2,"لَأَجۡرًا","لَثَوابًا عَظِيمًا."],[3,4,"غَيۡرَ مَمۡنُونٍ","غيرَ مَنقُوصٍ ولا مَقْطُوعٍ."]],"6":[[0,0,"بِأَييِّكُمُ","في أيٍّ مِنكُم."],[1,1,"ٱلۡمَفۡتُونُ","الفِتْنَةُ و الجنُونُ."]],"9":[[0,0,"وَدُّواْ","تَمَنَّوا وأحَبُّوا."],[1,2,"لَوۡ تُدۡهِنُ","لو تُلايِنُهُم وتُصانِعُهُم عَلى بَعْضِ ما هُم عَلَيهِ."],[3,3,"فَيُدۡهِنُونَ","فَيَلِينُونَ لَكَ."]],"10":[[3,3,"حَلَّافٍ","كَثِيرِ الحَلْفِ."],[4,4,"مَّهِينٍ","حَقِيرٍ."]],"11":[[0,0,"هَمَّازٍ","مُغْتابٍ للنّاسِ."],[1,2,"مَّشَّآءِۭ بِنَمِيمٍ","يَمْشِي بَينَ النّاسِ ويَنْقُلُ حَدِيثَ بَعْضِهِم إلى بَعْضٍ عَلى وجْهِ الإفْسادِ بَيْنَهُم."]],"12":[[0,0,"مَّنَّاعٍ","شَدِيدِ المنْعِ لِلخَيْرِ."],[2,2,"مُعۡتَدٍ","مُتَجاوِزٍ حَدَّه في العُدْوانِ عَلى النّاسِ وتَناوُلِ الُمحَرَّماتِ."],[3,3,"أَثِيمٍ","كَثِيرِ الآثامِ."]],"13":[[0,0,"عُتُلِّۭ","شَدَيدٍ في كُفْرِهِ، فاحِشٍ لَئِيمٍ."],[3,3,"زَنِيمٍ","مَنسُوبٍ إلى غَيرِ أبِيهِ."]],"14":[[0,4,"أَن كَانَ ذَا مَالٍ وَبَنِينَ","طَغى وتَكَبَّرَ لِأَجْلِ أن رَّزَقَهُ اللهُ مالًا وبَنِينَ فَلَمْ يَشْكُرِ النِّعْمَةَ."]],"15":[[5,6,"أَسَـٰطِيرُ ٱلۡأَوَّلِينَ","أباطِيلُ الأوَّلِينَ وخُرافاتُهُم."]],"16":[[0,0,"سَنَسِمُهُۥ","سَنَجْعلُ عَلامةً لازِمةً لا تُفارِقُهُ."],[1,2,"عَلَى ٱلۡخُرۡطُومِ","عَلى أنْفِهِ عُقُوبةً لَهُ."]],"17":[[1,1,"بَلَوۡنَـٰهُمۡ","اخْتَبَرْنا أهْلَ مَكَّةَ بالجُوعِ والقَحْطِ."],[5,5,"ٱلۡجَنَّةِ","الحَدِيقَةِ."],[8,8,"لَيَصۡرِمُنَّهَا","لَيَقْطَعُنَّ ثِمارَها."],[9,9,"مُصۡبِحِينَ","مُبَكِّرِينَ في الصَّباحِ."]],"18":[[0,1,"وَلَا يَسۡتَثۡنُونَ","ولَمْ يَقُولُوا: إن شاءَ اللهُ."]],"19":[[0,4,"فَطَافَ عَلَيۡهَا طَآئِفٌ مِّن رَّبِّكَ","فَأَنْزَلَ اللهُ عَلَيها نارًا أحْرَقَتْها لَيلًا."]],"20":[[1,1,"كَٱلصَّرِيمِ","مُحْتَرِقَةً سَوْداءَ كالليلِ المُظْلمِ."]],"21":[[0,0,"فَتَنَادَوۡاْ","فَنادى بَعْضُهُم بَعْضا."],[1,1,"مُصۡبِحِينَ","وقْتَ الصَّباحِ."]],"22":[[1,1,"ٱغۡدُواْ","اذْهَبُوا مُبَكِّرِينَ."],[3,3,"حَرۡثِكُمۡ","زَرْعِكُم."],[6,6,"صَـٰرِمِينَ","قاطِعِينَ ثِمارَكُم."]],"23":[[2,2,"يَتَخَـٰفَتُونَ","يُسِرُّ بَعْضُهُم إلى بَعْضٍ في الكَلامِ."]],"25":[[0,0,"وَغَدَوۡاْ","سارُوا في أوَّلِ النَّهارِ."],[1,2,"عَلَىٰ حَرۡدٍ","على أمْرٍ مُجْمَعٍ عَلَيهِ."]],"26":[[0,1,"فَلَمَّا رَأَوۡهَا","أي مُحْتَرِقَةً."],[4,4,"لَضَآلُّونَ","أخْطأنا الطَّريقَ إلى حَدِيقَتِنا."]],"27":[[2,2,"مَحۡرُومُونَ","حُرِمْنا خيرَها بِسَبَبِ مَنعِنا الَمساكِينَ."]],"28":[[1,1,"أَوۡسَطُهُمۡ","أعْدَلُهُم وأَفْضَلُهُم."],[5,5,"لَوۡلَا","هَلّا."],[6,6,"تُسَبِّحُونَ","تَقُولُونَ: إن شاء اللهُ."]],"29":[[1,2,"سُبۡحَـٰنَ رَبِّنَآ","نُنَزِّهُ رَبَّنا عَنِ الظُّلْمِ فِيما أصابَنا."]],"30":[[4,4,"يَتَلَـٰوَمُونَ","يَلُومُ بَعْضُهم بَعْضًا."]],"31":[[1,1,"يَـٰوَيۡلَنَآ","نادَوا عَلى أنْفُسِهِم بِالشَّرِّ والعَذابِ."],[4,4,"طَـٰغِينَ","مُتَجاوِزِينَ الحدَّ في مَنعِنا الفُقَراءَ."]],"32":[[9,9,"رَٰغِبُونَ","طالِبُونَ الخيرَ والعفوَ عَن سيِّئاتِنا."]],"33":[[0,1,"كَذَٰلِكَ ٱلۡعَذَابُ","نَفْعَلُ بِمن تَعَدّى حُدُودَنا مِثلَ ما فَعَلْنا بِهَؤُلاءِ."]],"36":[[2,3,"كَيۡفَ تَحۡكُمُونَ","كَيفَ تَقْضُونَ بِهذا الحُكْمِ الظّالِمِ؟"]],"37":[[2,2,"كِتَـٰبٌ","أُنْزِلَ مِن عِنْدِ اللهِ."],[4,4,"تَدۡرُسُونَ","تَقْرَؤونَ فِيهِ هَذا الحُكْمَ الجائِرَ."]],"38":[[3,4,"لَمَا تَخَيَّرُونَ","ما تَشْتَهُونَ وتَخْتارُونَ، ليسَ لَكُم ذَلِكَ."]],"39":[[2,3,"أَيۡمَـٰنٌ عَلَيۡنَا","عُهُودٌ ومَواثِيقُ عَلَينا."],[4,4,"بَـٰلِغَةٌ","مُؤَكَّدةٌ."]],"40":[[3,3,"زَعِيمٌ","كَفِيلٌ وضامِنٌ."]],"41":[[0,2,"أَمۡ لَهُمۡ شُرَكَآءُ","ألَهُم أرْبابٌ يَفْعَلُونَ بِهِم ما زَعَمُوا مِنَ الكَرامةِ؟"]],"42":[[3,3,"سَاقٍ","يَكْشِفُ رَبُّنا عَن ساقِهِ يَوْمَ القِيامَةِ فَيَسْجُدُ لَهُ كُلُّ مُؤْمِنٍ ومُؤْمِنَةٍ، ولا يَتَمكَّنُ المنافِقُونَ مِنَ السُّجُودِ."]],"43":[[0,1,"خَـٰشِعَةً أَبۡصَـٰرُهُمۡ","مُنْكَسِرَةً لا يَرْفَعُونَها."],[2,2,"تَرۡهَقُهُمۡ","تَغْشاهُم."]],"44":[[0,2,"فَذَرۡنِي وَمَن يُكَذِّبُ","خَلِّ بينِي وبَينَ مَنُ يُكذِّبُ."],[5,5,"سَنَسۡتَدۡرِجُهُم","سَنَمُدُّهُم بالأمْوالِ والأَولادِ والنِّعَمِ اسْتِدْراجًا لَهُم."]],"45":[[0,1,"وَأُمۡلِي لَهُمۡ","وأُمْهِلُهُم وأُطِيلُ أعْمارَهُم لِيَزْدادُوا إثْما."],[3,3,"كَيۡدِي","مَكْرِي بِالكُفّارِ."],[4,4,"مَتِينٌ","قَوِيٌّ شدِيدٌ."]],"46":[[4,5,"مِّن مَّغۡرَمٍ","مِن غَرامَةِ ذَلِكَ الأَجْرِ."],[6,6,"مُّثۡقَلُونَ","يَثْقُلُ عَلَيهِم حِمْلُهُ."]],"47":[[0,2,"أَمۡ عِندَهُمُ ٱلۡغَيۡبُ","بَلْ أعِنْدَهُم عِلْمُ الغَيبِ؟"]],"48":[[5,6,"كَصَاحِبِ ٱلۡحُوتِ","هُو يُونُسُ -عَلَيهِ السَّلامُ-."],[10,10,"مَكۡظُومٌ","مَمْلُوءٌ غَمًّا وكَرْبًا."]],"49":[[3,5,"نِعۡمَةٌ مِّن رَّبِّهِۦ","التَّوبَةُ وقَبُولُها مِنهُ."],[6,6,"لَنُبِذَ","لَطُرِحَ."],[7,7,"بِٱلۡعَرَآءِ","بالأرْضِ الفَضاءِ المهْلِكَةِ."],[9,9,"مَذۡمُومٌ","آتٍ بِما يُلامُ عَلَيهِ."]],"50":[[0,0,"فَٱجۡتَبَـٰهُ","فاخْتارَهُ لِرِسالتِهِ."]],"51":[[4,4,"لَيُزۡلِقُونَكَ","لَيُصِيبُونَكَ بالعَينِ لِبُغْضِهِم إيّاكَ."],[8,8,"ٱلذِّكۡرَ","القُرَآنَ."]]}