{"1":[[0,0,"بَرَآءَةٌ","إعذارٌ وتَحَلُّلٌ من العهودِ."],[6,6,"عَـٰهَدتُّم","التزَمْتُم معهم بميثاقٍ."]],"2":[[0,0,"فَسِيحُواْ","فسِيروا آمنين."],[7,9,"غَيۡرُ مُعۡجِزِي ٱللَّهِ","لن تُفْلِتُوا من عقوبةِ الله."],[12,13,"مُخۡزِي ٱلۡكَـٰفِرِينَ","مُذِلُّهم في الدنيا والآخرة."]],"3":[[0,0,"وَأَذَٰنٌ","إعلامٌ وإنذارٌ."],[6,8,"يَوۡمَ ٱلۡحَجِّ ٱلۡأَكۡبَرِ","يومَ النَّحرِ."],[16,16,"تُبۡتُمۡ","رَجَعْتُم إلى الحقِّ وتَرَكْتُم الشِّركَ."],[21,21,"تَوَلَّيۡتُمۡ","أعْرَضْتُم."],[27,27,"وَبَشِّرِ","وأنذِرْ."]],"4":[[6,8,"لَمۡ يَنقُصُوكُمۡ شَيۡـًٔا","لم يَخُونوا العهدَ ولا شروطَه."],[9,10,"وَلَمۡ يُظَـٰهِرُواْ","ولم يُعاونوا."],[16,17,"إِلَىٰ مُدَّتِهِمۡ","إلى مدةِ العهدِ المحددةِ."]],"5":[[1,1,"ٱنسَلَخَ","خَرَجَ وانقَضى."],[2,3,"ٱلۡأَشۡهُرُ ٱلۡحُرُمُ","الأشهرُ الأربعةُ التي أمَّنتم بها المشركين."],[8,8,"وَخُذُوهُمۡ","وأْسِروهم."],[9,9,"وَٱحۡصُرُوهُمۡ","اقصِدُوهم بالحِصارِ في معاقِلِهم، أو امنعُوهم من الخروجِ والتنقُّلِ في البلادِ."],[12,13,"كُلَّ مَرۡصَدٍ","كلَّ طريقٍ ومَرْقَبٍ."],[15,15,"تَابُواْ","رَجَعُوا عن الكفر ودخلوا في الإسلام."],[20,21,"فَخَلُّواْ سَبِيلَهُمۡ","فاترُكوهم ولا تتعرَّضوا لهم."]],"6":[[4,4,"ٱسۡتَجَارَكَ","طَلَبَ جِوارَكَ، أي: حمايتَك وأمانَك."],[5,5,"فَأَجِرۡهُ","فأمِّنْهُ."],[8,9,"كَلَـٰمَ ٱللَّهِ","القرآنَ الكريمَ."],[11,12,"أَبۡلِغۡهُ مَأۡمَنَهُۥ","أعِدْهُ من حيثُ أتى آمِنًا."]],"7":[[0,1,"كَيۡفَ يَكُونُ","لا يكونُ."],[3,3,"عَهۡدٌ","التزامٌ بميثاقٍ."],[12,13,"ٱلۡمَسۡجِدِ ٱلۡحَرَامِ","الحَرَمِ كلِّه."],[14,16,"فَمَا ٱسۡتَقَـٰمُواْ لَكُمۡ","فما أقاموا على الوفاءِ بعهدكم."]],"8":[[2,3,"يَظۡهَرُواْ عَلَيۡكُمۡ","يَظْفَرُوا بكم ويَغْلِبوكم."],[4,5,"لَا يَرۡقُبُواْ","لا يُراعُوا."],[7,7,"إِلًّا","قَرابةً ولا حِلْفًا."],[9,9,"ذِمَّةً","عَهْدًا ولا حَقًّا."]],"9":[[0,0,"ٱشۡتَرَوۡاْ","استبدَلُوا."],[3,4,"ثَمَنًا قَلِيلًا","عَرَضَ الدنيا الزائلَ."],[5,7,"فَصَدُّواْ عَن سَبِيلِهِۦٓ","فأعرضُوا عن الحقِّ، ومنعُوا غيرَهم عنه."],[9,9,"سَآءَ","قَبُحَ."]],"11":[[9,9,"وَنُفَصِّلُ","نُبيِّنُ."]],"12":[[1,1,"نَّكَثُوٓاْ","نَقَضُوا."],[2,2,"أَيۡمَـٰنَهُم","مواثيقَهم المؤكَّدةَ بالأَيْمان."],[6,8,"وَطَعَنُواْ فِي دِينِكُمۡ","ذَمُّوا الإسلامَ وعابُوه."],[13,15,"لَآ أَيۡمَـٰنَ لَهُمۡ","لا عهودَ لهم يُوَفّى بها."]],"13":[[5,5,"وَهَمُّواْ","وعَزَمُوا وعَمِلوا."],[9,9,"بَدَءُوكُمۡ","بالإيذاءِ والقتالِ."],[10,11,"أَوَّلَ مَرَّةٍ","أولَ الأمرِ «بمكةَ» «وببَدْرٍ» وغيرِهما."],[12,12,"أَتَخۡشَوۡنَهُمۡ","أتَخافُونهم، أو أتخافون ملاقاتَهم في الحربِ؟"]],"14":[[1,1,"يُعَذِّبۡهُمُ","يَقْتُلْهم."],[4,4,"وَيُخۡزِهِمۡ","ويُذِلّهم بالهزيمةِ والأَسْرِ."],[7,7,"وَيَشۡفِ","يُزِلِ الغَمَّ ونحوَه."]],"15":[[1,2,"غَيۡظَ قُلُوبِهِمۡ","غَضَبَها وما تحمِلُه من كراهةٍ للأعداءِ."]],"16":[[3,3,"تُتۡرَكُواْ","دونَ اختبارٍ وابتلاءٍ."],[19,19,"وَلِيجَةً","بِطانةً وأولياءَ."]],"17":[[0,1,"مَا كَانَ","ما صَحَّ ولا استقامَ."],[3,6,"أَن يَعۡمُرُواْ مَسَـٰجِدَ ٱللَّهِ","أن يَبْنُوها ويَصُونوها، أو أن يُقيموا العبادةَ فيها."],[12,12,"حَبِطَتۡ","بَطَلتْ."]],"19":[[1,2,"سِقَايَةَ ٱلۡحَآجِّ","سَقْيَ الحُجّاجِ الماءَ."],[20,21,"لَا يَهۡدِي","لا يُوَفِّقُ"],[23,23,"ٱلظَّـٰلِمِينَ","الكافرين."]],"20":[[10,10,"دَرَجَةً","مَنزِلَةً."]],"21":[[4,4,"وَرِضۡوَٰنٍ","رضا اللهِ عنهم الذي لا سُخْطَ بعدَه."],[9,9,"مُّقِيمٌ","دائمٌ لا يَزُولُ."]],"23":[[7,7,"أَوۡلِيَآءَ","نصراءَ وأصدقاءَ."],[9,10,"ٱسۡتَحَبُّواْ ٱلۡكُفۡرَ","اختارُوه ودامُوا عليه."]],"24":[[7,7,"وَعَشِيرَتُكُمۡ","قبيلتُكم وذوو القَرابةِ القريبة."],[9,9,"ٱقۡتَرَفۡتُمُوهَا","اكتسَبْتموها."],[12,12,"كَسَادَهَا","عَدَمَ رَواجِها."],[14,14,"تَرۡضَوۡنَهَآ","تُعْجِبُكم وتميلُ أنفسُكم إليها."],[23,23,"فَتَرَبَّصُواْ","فانتظِرُوا."],[27,27,"بِأَمۡرِهِۦ","بعقابِه."]],"25":[[18,19,"بِمَا رَحُبَتۡ","مع وُسْعِها."],[21,21,"وَلَّيۡتُم","فَرَرْتُم."],[22,22,"مُّدۡبِرِينَ","مُنْهَزِمِين، جاعِلين ظُهورَكم جهةَ عدوِّكم."]],"26":[[3,3,"سَكِينَتَهُۥ","طمأنينتَه وأَمْنَه."],[9,9,"جُنُودًا","ملائكةً."]],"28":[[5,5,"نَجَسٌ","خُبَثاءُ في عقائدِهم وأعمالِهم الشِّرْكيةِ."],[11,12,"عَامِهِمۡ هَـٰذَا","وهو العامُ التاسعُ من الهجرةِ."],[15,15,"عَيۡلَةً","فَقْرًا."]],"29":[[14,17,"وَلَا يَدِينُونَ دِينَ ٱلۡحَقِّ","ولا يَلْتزمون أحكامَ الإسلام الذي ارتضاه الله دِينًا للناسِ."],[24,24,"ٱلۡجِزۡيَةَ","ما قُدِّرَ على أهل الكِتابِ من المالِ كلَّ عامٍ؛ جزاءً لما مُنِحُوا من الأمنِ."],[25,26,"عَن يَدٍ","بأيدِيهم غيرَ ممتنعين."],[28,28,"صَـٰغِرُونَ","خاضِعونَ أذلّاءُ."]],"30":[[2,2,"عُزَيۡرٌ","حَبْرٌ من علماءِ اليهودِ، يُعَظِّمُونه؛ لعِلْمِه وعبادتِه."],[13,13,"يُضَـٰهِـُٔونَ","يُشابِهُون."],[19,20,"قَـٰتَلَهُمُ ٱللَّهُ","دعاءٌ عليهم بالهَلاكِ."],[21,22,"أَنَّىٰ يُؤۡفَكُونَ","كيف يُصْرَفُون عن الحقِّ الواضحِ إلى الباطلِ؟"]],"31":[[1,1,"أَحۡبَارَهُمۡ","جَمْعُ حَبْرٍ، وهم العلماءُ من اليهودِ."],[2,2,"وَرُهۡبَـٰنَهُمۡ","جَمْعُ راهبٍ، وهم العُبّادُ من النَّصارى."],[3,6,"أَرۡبَابًا مِّن دُونِ ٱللَّهِ","إذ أطاعُوهم في تحريمِ ما أحلَّ اللهُ، وتحليلِ ما حَرَّمه."],[7,9,"وَٱلۡمَسِيحَ ٱبۡنَ مَرۡيَمَ","واتخذ النصارى عيسى عليه السلام إلهًا فعبدُوه."],[20,20,"سُبۡحَـٰنَهُۥ","تَنَزَّه اللهُ وتَقَدَّسَ."]],"32":[[0,0,"يُرِيدُونَ","يريدُ الكفّارُ بتكذيبهِم."],[1,2,"أَن يُطۡفِـُٔواْ","أن يُبْطِلُوا."],[3,4,"نُورَ ٱللَّهِ","دينَ الإسلامِ وما فيه من الهُدى والرَّشادِ."],[10,11,"يُتِمَّ نُورَهُۥ","يُكْمِلَ اللهُ دينَه ويُظْهِرَه."]],"33":[[4,4,"بِٱلۡهُدَىٰ","بالإيمانِ الصَّحيحِ، والعلمِ النافعِ."],[5,6,"وَدِينِ ٱلۡحَقِّ","دينِ الإسلامِ."],[7,7,"لِيُظۡهِرَهُۥ","ليُعْلِيَه."],[8,10,"عَلَى ٱلدِّينِ كُلِّهِۦ","على الأديانِ جميعًا."]],"34":[[8,10,"لَيَأۡكُلُونَ أَمۡوَٰلَ ٱلنَّاسِ","لَيأخُذُونها."],[11,11,"بِٱلۡبَـٰطِلِ","بغيرِ حَقٍّ كالرِّشوةِ وغيرِها."],[12,15,"وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِ","ويمنعون الناسَ من الدخولِ في الإسلامِ، أو اتباعِ الحقِّ."],[17,19,"يَكۡنِزُونَ ٱلذَّهَبَ وَٱلۡفِضَّةَ","يجمعونَ الأموالَ."],[20,24,"وَلَا يُنفِقُونَهَا فِي سَبِيلِ ٱللَّهِ","ولايُؤَدُّون زَكاتَها، ولايُخْرِجون منها الحقوقَ الواجبةَ."]],"35":[[6,6,"فَتُكۡوَىٰ","تُحْرَقُ."],[15,18,"فَذُوقُواْ مَا كُنتُمۡ تَكۡنِزُونَ","ذُوقوا سوءَ عاقبةِ جَمْعِكم."]],"36":[[1,2,"عِدَّةَ ٱلشُّهُورِ","أي: عَدَدَها الذي يَتَألَّفُ منه العامُ."],[8,10,"فِي كِتَـٰبِ ٱللَّهِ","في حُكْمِه القَدَريِّ الذي كُتب في اللَّوحِ المحفوظِ."],[16,17,"أَرۡبَعَةٌ حُرُمٌ","أي: ذاتُ حُرْمَةٍ وتعظيمٍ، وهي: رَجَبٌ، وذو القِعدة، وذو الحِجَّةِ، والمُحَرَّمُ."],[20,20,"ٱلۡقَيِّمُ","المستقيمُ الذي لا عِوَجَ فيه."],[21,24,"فَلَا تَظۡلِمُواْ فِيهِنَّ أَنفُسَكُمۡ","بارتكابِ ما حَرَّمَ اللهُ؛ لعِظَمِ حُرْمتِها."],[27,27,"كَآفَّةً","جميعًا، وفي كلِّ الشهورِ."],[31,35,"وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَعَ ٱلۡمُتَّقِينَ","بالعَوْنِ والنَّصرِ."]],"37":[[1,1,"ٱلنَّسِيٓءُ","تأخيرُ حُرْمَةِ شهرٍ إلى شهرٍ آخرَ، كما كانت تفعلُه العربُ في الجاهليةِ."],[9,9,"يُحِلُّونَهُۥ","أي: النسيءَ."],[13,13,"لِّيُوَاطِـُٔواْ","ليوافِقُوا بتحليلِ شهرٍ وتحريمِ آخرَ بَدَلَه."],[14,14,"عِدَّةَ","عددَ."],[15,17,"مَا حَرَّمَ ٱللَّهُ","من الأشهرِ، بحيث تكونُ أربعةً في العددِ."],[27,28,"لَا يَهۡدِي","لا يُوَفِّقُ."]],"38":[[8,8,"ٱنفِرُواْ","اخرُجُوا بخِفَّةٍ ونشاطٍ."],[9,11,"فِي سَبِيلِ ٱللَّهِ","إلى الجهادِ لإعلاءِ كلمةِ اللهِ."],[12,14,"ٱثَّاقَلۡتُمۡ إِلَى ٱلۡأَرۡضِ","تباطَأْتم في الخروجِ ومِلْتُم إلى الإقامةِ في أرضِكم ومساكِنِكُم."],[18,19,"مِنَ ٱلۡـَٔاخِرَةِ","بدلَ نعيمِ الآخرةِ."],[21,23,"مَتَـٰعُ ٱلۡحَيَوٰةِ ٱلدُّنۡيَا","ما يُتَمَتَّعُ به مِن لَذّاتِ الدنيا."]],"39":[[2,2,"يُعَذِّبۡكُمۡ","يُنْزِلْ عقوبتَه بكم."]],"40":[[0,1,"إِلَّا تَنصُرُوهُ","إن لم تَنْصُروا النبيَّ ﷺ."],[9,10,"ثَانِيَ ٱثۡنَيۡنِ","أحدَ اثنين، والثاني هو أبوبكرٍ الصدّيقُ رضي الله عنه."],[14,14,"ٱلۡغَارِ","النَّقْبِ في الَجبَلِ، وهو في جبلِ ثورٍ ب«مكةَ»."],[17,17,"لِصَـٰحِبِهِۦ","أبي بكرٍ الصديقِ رضي الله عنه."],[25,25,"سَكِينَتَهُۥ","طمأنينتَه."],[28,28,"بِجُنُودٍ","هم الملائكةُ، يَحْرُسُونه ويَصْرِفُون أبصارَ الكفارِ عنه."],[32,34,"كَلِمَةَ ٱلَّذِينَ كَفَرُواْ","أي: دعوةَ الشِّركِ والكفرِ."],[35,35,"ٱلسُّفۡلَىٰ","المغلوبةَ."],[36,37,"كَلِمَةُ ٱللَّهِ","كلمةُ التوحيدِ."],[39,39,"ٱلۡعُلۡيَا","الغالبةُ."]],"41":[[1,1,"خِفَافًا","على الصِّفةِ التي يَخِفُّ عليكم الجهادُ فيها."],[2,2,"وَثِقَالًا","وعلى الصفةِ التي يَثْقُلُ عليكم الجهادُ فيها."]],"42":[[0,1,"لَوۡ كَانَ","أي: ما دَعَوْتَهم إليه من الخروجِ للجهادِ."],[2,2,"عَرَضًا","مَتاعًا وغَنيمةً."],[3,3,"قَرِيبًا","سَهْلَ المأخَذِ."],[5,5,"قَاصِدًا","متوسِّطًا بَيْنَ القُرْبِ والبُعْدِ لا مَشَقَّةَ فيه."],[10,10,"ٱلشُّقَّةُ","المسافةُ البعيدةُ التي تُقْطَعُ بمَشَقَّةٍ."],[17,18,"يُهۡلِكُونَ أَنفُسَهُمۡ","بالَحلِفِ الكاذبِ والنِّفاقِ."]],"43":[[0,2,"عَفَا ٱللَّهُ عَنكَ","العَفْوُ: هو التجاوُزُ عن الخطأ وتَرْكُ المؤاخذةِ عليه."]],"45":[[1,1,"يَسۡتَـٔۡذِنُكَ","يَطْلُبُ الإذنَ للتخَلُّفِ عن الجهادِ."],[8,9,"وَٱرۡتَابَتۡ قُلُوبُهُمۡ","شَكَّتْ في الإسلامِ وشرائعِه."],[13,13,"يَتَرَدَّدُونَ","يتَحيَّرُون."]],"46":[[2,2,"ٱلۡخُرُوجَ","مَعَك إلى الجهادِ."],[3,5,"لَأَعَدُّواْ لَهُۥ عُدَّةً","لَتَأهَّبُوا له بإعدادِ السِّلاحِ، والزادِ، وما يُحتاجُ إليه."],[9,9,"ٱنۢبِعَاثَهُمۡ","خروجَهم للجهادِ."],[10,10,"فَثَبَّطَهُمۡ","مَنَعهم وعوَّقهم بقَضائِه وقَدَرِه."],[12,12,"ٱقۡعُدُواْ","تَخَلَّفُوا عن الجِهادِ."],[13,14,"مَعَ ٱلۡقَـٰعِدِينَ","من المرضى والضُّعَفاءِ والنِّساءِ والصِّبْيانِ."]],"47":[[6,6,"خَبَالًا","شرًّا وفسادًا."],[7,8,"وَلَأَوۡضَعُواْ خِلَـٰلَكُمۡ","أسْرَعُوا في المَشْيِ بينَكم بالنميمةِ وإفسادِ القلوبِ."],[9,9,"يَبۡغُونَكُمُ","يُريدُون لكم."],[10,10,"ٱلۡفِتۡنَةَ","ما تُفْتَنُون به؛ كي تتثاقَلُوا عن الجهادِ في سبيلِ اللهِ."],[12,13,"سَمَّـٰعُونَ لَهُمۡ","مَن يَسْمعون كلام المنافقين، ويُطيعونهم."]],"48":[[1,1,"ٱبۡتَغَوُاْ","طلبُوا وأرادوا."],[2,2,"ٱلۡفِتۡنَةَ","فتنةَ المؤمنين وصَدَّهم عن دينِهم."],[3,4,"مِن قَبۡلُ","من قبلِ غزوةِ «تبوكَ»."],[5,7,"وَقَلَّبُواْ لَكَ ٱلۡأُمُورَ","أرادُوا إبطالَ ما جِئْتَ به بتحايُلِهم ومَكْرِهم."],[10,10,"ٱلۡحَقُّ","النصرُ من عندِ اللهِ."],[11,11,"وَظَهَرَ","علا وغَلَبَ."],[12,13,"أَمۡرُ ٱللَّهِ","دينُه، وهو الإسلامُ."]],"49":[[0,0,"وَمِنۡهُم","ومن المنافقين."],[3,4,"ٱئۡذَن لِّي","في التخَلُّف عن الجهادِ."],[5,6,"وَلَا تَفۡتِنِّيٓ","لاتُوقِعْني في فتنةِ النِّساءِ حالةَ الخروجِ معك."],[8,9,"فِي ٱلۡفِتۡنَةِ","فتنةِ النِّفاقِ والتخلُّفِ عن الجهادِ."],[10,10,"سَقَطُواْ","وقعوا في الإثمِ لمخالَفَتِهم أمرَ اللهِ ورسولِه."]],"50":[[2,2,"حَسَنَةٌ","نصرٌ وغنيمةٌ."],[6,6,"مُصِيبَةٌ","مَكْرُوهٌ من هزيمةٍ أو شدَّةٍ."],[8,12,"قَدۡ أَخَذۡنَآ أَمۡرَنَا مِن قَبۡلُ","قد احْتَطْنا لأنفسِنا حين تَخَلَّفْنا عن الجهادِ قبلَ هذه المصيبةِ."],[13,13,"وَيَتَوَلَّواْ","وينصَرِفُوا."]],"51":[[4,7,"مَا كَتَبَ ٱللَّهُ لَنَا","ما قَدَّرَه علينا."],[8,9,"هُوَ مَوۡلَىٰنَا","ناصِرُنا ومُتَوَلِّي أمورِنا."],[10,12,"وَعَلَى ٱللَّهِ فَلۡيَتَوَكَّلِ","فلْيَعْتَمِدْ ولْيُفَوِّضْ أمرَه إليه."]],"52":[[1,2,"هَلۡ تَرَبَّصُونَ","ما تنتظرون أن يَقَعَ."],[5,6,"إِحۡدَى ٱلۡحُسۡنَيَيۡنِ","إحدى العاقبتَين: النصرَ، أوالشهادةَ في سبيلِ اللهِ."]],"53":[[2,2,"طَوۡعًا","طائعِين."],[4,4,"كَرۡهًا","كارهِين."],[11,11,"فَـٰسِقِينَ","خارجِين عن دينِ اللهِ."]],"54":[[16,16,"كُسَالَىٰ","متثاقلون عن الصَّلاةِ."]],"55":[[8,9,"لِيُعَذِّبَهُم بِهَا","بما يَلْقَون من التعبِ في جَمْعِها، وبالمصائبِ التي تقعُ فيها."],[13,13,"وَتَزۡهَقَ","تَخْرُجَ."]],"56":[[9,9,"يَفۡرَقُونَ","يَخافُون."]],"57":[[2,2,"مَلۡجَـًٔا","حِصْنًا ومأمَنًا يلجَؤُون إليه."],[4,4,"مَغَـٰرَٰتٍ","جَمْعُ مَغارةٍ، وهي الكَهْفُ، أو الغارُ في الجبلِ يُؤْويهم."],[6,6,"مُدَّخَلًا","مكانًا يَدْخلونه كالنَّفَقِ في الأرضِ."],[7,7,"لَّوَلَّوۡاْ","لَأَقْبَلُوا."],[10,10,"يَجۡمَحُونَ","يُسْرِعون في دخولِه لا يَمْنَعُهم شيءٌ."]],"58":[[2,2,"يَلۡمِزُكَ","يَعِيبُك."],[4,4,"ٱلصَّدَقَـٰتِ","في قِسْمةِ أموالِ الصَّدقاتِ."]],"59":[[8,9,"حَسۡبُنَا ٱللَّهُ","كافِينا."],[16,18,"إِلَى ٱللَّهِ رَٰغِبُونَ","مُحِبُّون أن يُغْنيَنا من فضلِه."]],"60":[[1,1,"ٱلصَّدَقَـٰتُ","الزَّكَواتُ المفروضةُ."],[2,2,"لِلۡفُقَرَآءِ","للمحتاجِين الذين لا يَمْلِكُون شيئًا."],[3,3,"وَٱلۡمَسَـٰكِينِ","الذين لا يَمْلِكُون ما يَكْفيهم ويَسُدُّ حاجتَهم."],[4,5,"وَٱلۡعَـٰمِلِينَ عَلَيۡهَا","السُّعاةُ الذين يَجْمعون الزكاةَ من أصحابِها."],[6,7,"وَٱلۡمُؤَلَّفَةِ قُلُوبُهُمۡ","المستمالةِ قلوبُهم إلى الإسلام كمن يُرْجى إسلامُه أو قوَّةُ إيمانِه."],[8,9,"وَفِي ٱلرِّقَابِ","وتُعطى الزكاةُ في عِتْقِ رقابِ العبيدِ والمكاتَبين."],[10,10,"وَٱلۡغَـٰرِمِينَ","الذين استدانُوا لأنفسهم، ولا قُدَرةَ لهم على الوفاءِ، أو استدانُوا لإصلاحِ ذاتِ البَيْنِ."],[11,13,"وَفِي سَبِيلِ ٱللَّهِ","وللغُزاةِ وللمرابطين في سبيل الله."],[14,15,"وَٱبۡنِ ٱلسَّبِيلِ","المسافرِ المنقطعِ عن مالِه في سفرِه، وإن كان غنيًا في بلدِه."],[16,18,"فَرِيضَةً مِّنَ ٱللَّهِ","هذه القِسْمةُ فَرَضَها اللهُ فريضةً وقَدَّرها."]],"61":[[6,6,"أُذُنٌ","يستمعُ لكلِّ ما يُقالُ له ويُصَدِّقُه."],[7,10,"قُلۡ أُذُنُ خَيۡرٍ لَّكُمۡ","أي: أُذُنٌ في الخيرِ والحقِّ، وفيما يجبُ سَماعُه وقَبولُه."],[13,14,"وَيُؤۡمِنُ لِلۡمُؤۡمِنِينَ","ويُصَدِّقُ المؤمنين فيما يُخبرونه."]],"63":[[4,4,"يُحَادِدِ","يخالِفْ."]],"64":[[6,6,"تُنَبِّئُهُم","تُخَبِّرُهم."],[7,9,"بِمَا فِي قُلُوبِهِمۡ","بما يُضْمِرُونَه في قلوبِهم من الكفرِ."],[14,16,"مُخۡرِجٌ مَّا تَحۡذَرُونَ","مُظْهِرٌ ما تَخافُونه من الفضيحةِ."]],"65":[[0,1,"وَلَئِن سَأَلۡتَهُمۡ","عَمّا قالوا من الطَّعْنِ في حَقِّك وحَقِّ أصحابِك."],[5,6,"نَخُوضُ وَنَلۡعَبُ","نتحَدَّثُ بكلامٍ لم نَقْصِدْ به الإساءةَ."]],"66":[[6,10,"إِن نَّعۡفُ عَن طَآئِفَةٍ مِّنكُمۡ","بالتوفيق للتوبةِ والإخلاصِ فيها."],[11,12,"نُعَذِّبۡ طَآئِفَةَۢ","بسبب تَرْكِ التوبةِ والإصرارِ على النِّفاقِ."]],"67":[[2,4,"بَعۡضُهُم مِّنۢ بَعۡضٍ","أي: مُتَشابهون في صفةِ النِّفاقِ والبُعْدِ عن الإيمانِ."],[6,6,"بِٱلۡمُنكَرِ","بالكفرِ والمعاصي."],[9,9,"ٱلۡمَعۡرُوفِ","هو كلُّ ما عُرِفَ حُسْنُه في الشَّرعِ والعَقْلِ."],[10,11,"وَيَقۡبِضُونَ أَيۡدِيَهُمۡ","ويُمْسِكُون عن الإنفاقِ في طاعةِ اللهِ ومَرْضاتِه."],[12,13,"نَسُواْ ٱللَّهَ","تَرَكُوا طاعتَه وأوامرَه."],[14,14,"فَنَسِيَهُمۡ","فتركَهم من رحمتِه وثوابِه."],[18,18,"ٱلۡفَـٰسِقُونَ","الخارجُون عن الإيمانِ والطاعة."]],"68":[[10,10,"حَسۡبُهُمۡ","كافِيهم؛ عقابًا على كفرِهم."],[11,12,"وَلَعَنَهُمُ ٱللَّهُ","طَرَدَهم مِن رحمتِه."],[15,15,"مُّقِيمٌ","دائمٌ لا ينقطعُ."]],"69":[[11,11,"بِخَلَـٰقِهِمۡ","بنصيبِهم الذي قُدِّرَ لهم من مَلاذِّ الدنيا."],[20,20,"وَخُضۡتُمۡ","ودَخَلْتُم في الباطلِ والطَّعْنِ في الدِّينِ."],[24,24,"حَبِطَتۡ","بَطَلَتْ."]],"70":[[2,2,"نَبَأُ","خبرُ."],[12,13,"وَأَصۡحَـٰبِ مَدۡيَنَ","هم قومُ شعيبٍ عليه السلام."],[14,14,"وَٱلۡمُؤۡتَفِكَـٰتِ","قُرى قومِ لوطٍ عليه السلام، التي انقلبَتْ بهم، فصار عالِيها سافلَها."],[17,17,"بِٱلۡبَيِّنَـٰتِ","بالوَحْيِ والمعجزاتِ."],[23,25,"كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ","بتعريضِها للعقابِ؛ بسببِ كُفْرِهم."]],"71":[[3,4,"أَوۡلِيَآءُ بَعۡضٍ","أنصارُ بعضٍ."],[22,22,"عَزِيزٌ","لا يُعْجِزُه شيء عن إنجازِ وعْدِه بالمؤمنين، ووعيدِه بمَن عَصاه وكَفَرَ به."],[23,23,"حَكِيمٌ","يَضَعُ الأمورَ في محالِّها."]],"72":[[6,7,"مِن تَحۡتِهَا","من تحتِ قصورِها وأشجارِها."],[12,12,"طَيِّبَةً","حسنةَ البناءِ، طَيِّبةَ القَرارِ."],[14,15,"جَنَّـٰتِ عَدۡنٍ","أي: إقامةٍ وخُلودٍ."],[19,19,"أَكۡبَرُ","ممّا هم فيه من أنواعِ النعيمِ."]],"73":[[5,5,"وَٱغۡلُظۡ","واشدُدْ في جهادِك."],[7,7,"وَمَأۡوَىٰهُمۡ","مصيرُهم."]],"74":[[6,7,"كَلِمَةَ ٱلۡكُفۡرِ","هي استهزاؤهُم بالرسولِ عليه الصلاةُ والسلام، وبالدِّينِ."],[11,11,"وَهَمُّواْ","وصَمَّمَ المنافقون على قَتْلِ الرسولِ ﷺ."],[12,14,"بِمَا لَمۡ يَنَالُواْ","بما لم يُمَكِّنْهم اللهُ منه."],[15,16,"وَمَا نَقَمُوٓاْ","وما وجَدَ المنافقون شيئًا يَكْرَهُونه ويَعِيبونَه."],[24,25,"وَإِن يَتَوَلَّوۡاْ","يُعْرِضُوا، أو يَسْتمِرُّوا على حالِهم."],[43,43,"وَلِيٍّ","يَلي أمورَهم وينفَعُهم."],[44,45,"وَلَا نَصِيرٍ","ولا ناصرٍ يَدْفَعُ عنهم ما هم فيه."]],"75":[[2,3,"عَـٰهَدَ ٱللَّهَ","قَطَعَ على نفسِه العهدَ مع اللهِ."]],"77":[[0,1,"فَأَعۡقَبَهُمۡ نِفَاقًا","فأَوْرَثَهم اللهُ جزاءَ صنيعِهم زيادةً في نفاقِهم."]],"78":[[5,5,"سِرَّهُمۡ","ما انطَوتْ عليه نفوسُهم من النِّفاق."],[6,6,"وَنَجۡوَىٰهُمۡ","ما يتحَدَّثون به بينهَم من الكَيْدِ والمَكْر."]],"79":[[1,2,"يَلۡمِزُونَ ٱلۡمُطَّوِّعِينَ","يَعِيبُون المتصدِّقين ويَطْعَنُون في إخلاصِهم."],[11,11,"جُهۡدَهُمۡ","طاقَتَهم وما تَبْلُغُه قُوَّتُهم."]],"80":[[9,10,"سَبۡعِينَ مَرَّةً","أي: مهما كَثُرَ استغفارُك لهم وتكرَّر."],[21,22,"لَا يَهۡدِي","لا يُوَفِّقُ."],[24,24,"ٱلۡفَـٰسِقِينَ","الخارجين عن دينِ الله."]],"81":[[1,1,"ٱلۡمُخَلَّفُونَ","الذين تخلَّفُوا عن الجهادِ في غزوةِ «تبوكَ»."],[2,2,"بِمَقۡعَدِهِمۡ","أي: بقُعودِهم."],[3,5,"خِلَـٰفَ رَسُولِ ٱللَّهِ","مخالِفِين رسولَ الله ﷺ."],[15,16,"لَا تَنفِرُواْ","لا تَخْرُجُوا إلى الجهادِ."]],"82":[[1,1,"قَلِيلًا","في الدنيا."],[3,3,"كَثِيرًا","في الآخرةِ."]],"83":[[20,21,"أَوَّلَ مَرَّةٍ","هي غزوةُ «تبوكَ»."],[24,24,"ٱلۡخَـٰلِفِينَ","المتخلِّفين عن الجهادِ كالنِّساءِ والصِّبيانِ."]],"84":[[7,10,"وَلَا تَقُمۡ عَلَىٰ قَبۡرِهِۦٓ","لأجلِ الدَّفْنِ، أو الزيارةِ، أو الدعاءِ له."]],"85":[[7,9,"أَن يُعَذِّبَهُم بِهَا","بما يَلْقَون من التعب في جَمْعِها، وبالمصائبِ التي تقعُ فيها."],[12,12,"وَتَزۡهَقَ","تَخْرُجَ."]],"86":[[10,11,"أُوْلُواْ ٱلطَّوۡلِ","أصحابُ الغِنى والمقدرةِ على الجهادِ."],[14,14,"ذَرۡنَا","اتْرُكْنا."]],"87":[[4,4,"ٱلۡخَوَالِفِ","جَمعُ خالِفة، ويقال للمرأةِ والرجل، والمرادُ: النِّساءُ اللاتي تخلَّفْنَ في البيوتِ، أو الرجالُ العاجزون عن القتال."],[5,5,"وَطُبِعَ","ختمَ اللهُ."]],"88":[[10,10,"ٱلۡخَيۡرَٰتُ","في الدنيا والآخرةِ."]],"90":[[1,1,"ٱلۡمُعَذِّرُونَ","المعتذرون بأعذارٍ كاذبةٍ عن عدمِ الخروجِ للغَزْوِ."],[3,3,"ٱلۡأَعۡرَابِ","سُكّانِ الباديةِ."],[6,6,"وَقَعَدَ","عن الغزوِ لغيرِ عُذْرٍ."]],"91":[[13,13,"حَرَجٌ","إثمٌ."],[15,15,"نَصَحُواْ","أخلَصُوا."],[21,22,"مِن سَبِيلٍ","من طريقٍ للمؤاخذةِ."]],"92":[[6,6,"لِتَحۡمِلَهُمۡ","على ما يَرْكَبون عليه في الغَزْو."],[13,13,"تَوَلَّواْ","انْصَرَفُوا مِن عندِك."],[18,18,"حَزَنًا","أسَفًا على ما فاتَهم من شَرَفِ الجهادِ وثوابِه."]],"93":[[1,1,"ٱلسَّبِيلُ","طريقُ العقوبةِ والمؤاخَذَةِ."]],"94":[[2,4,"إِذَا رَجَعۡتُمۡ إِلَيۡهِمۡ","من الغَزْوِ."],[8,10,"لَن نُّؤۡمِنَ لَكُمۡ","لن نُصَدِّقَكم."]],"95":[[3,5,"إِذَا ٱنقَلَبۡتُمۡ إِلَيۡهِمۡ","رَجَعْتُم إليهم من الغَزْو."],[6,7,"لِتُعۡرِضُواْ عَنۡهُمۡ","لتَتْرُكُوهم وتَصْفَحُوا عنهم."],[11,11,"رِجۡسٌ","خبثاءُ في بَواطِنِهم واعتقاداتِهم."],[12,12,"وَمَأۡوَىٰهُمۡ","مصيرُهم."]],"96":[[13,13,"ٱلۡفَـٰسِقِينَ","الخارجين عن دينِ اللهِ."]],"97":[[0,0,"ٱلۡأَعۡرَابُ","سُكّانُ الباديةِ."],[4,4,"وَأَجۡدَرُ","وأحَقُّ."]],"98":[[6,6,"مَغۡرَمًا","غَرامةً وخَسارةً."],[7,7,"وَيَتَرَبَّصُ","ينتظرُ."],[9,9,"ٱلدَّوَآئِرَ","جَمْعُ دائرةٍ، وهي: تَقَلُّباتُ الدَّهْرِ ومصائبُه."],[12,12,"ٱلسَّوۡءِ","كلُّ ما يسوءُ ويَضُرُّ."]],"99":[[7,9,"وَيَتَّخِذُ مَا يُنفِقُ","ويحتسِبُ ما ينفقُه في سبيلِ اللهِ."],[10,12,"قُرُبَـٰتٍ عِندَ ٱللَّهِ","جَمْعُ قُرْبَةٍ، وهي: ما يُتَقَرَّبُ به إلى اللهِ تعالى."],[13,14,"وَصَلَوَٰتِ ٱلرَّسُولِ","جَمْعُ صلاةٍ، وهي هنا: الدعاُء، أي: ويَجْعَلُ إنفاقَه في سبيلِ اللهِ وسيلةً إلى دعاءِ الرسولِ ﷺ له."]],"100":[[3,3,"ٱلۡمُهَـٰجِرِينَ","الذين هَجَرُوا قومَهم، وانتقلُوا من بلدِ الفتنةِ إلى دارِ الإسلامِ."],[4,4,"وَٱلۡأَنصَارِ","الذين نصرُوا النبي ﷺ، وآوَوا المهاجرين."],[7,7,"بِإِحۡسَـٰنٍ","في الاعتقادِ والأقوالِ والأعمالِ."],[17,17,"تَحۡتَهَا","تحتَ قصورِها وأشجارِها."]],"101":[[8,10,"مَرَدُواْ عَلَى ٱلنِّفَاقِ","مَهَرُوا فيه واستمَرُّوا عليه."],[15,16,"سَنُعَذِّبُهُم مَّرَّتَيۡنِ","الأولى: في الدنيا بفضيحتِهم، أو بأنواعِ المكارِهِ التي تنالُهم، والثانية: بعذابِ القبرِ."],[20,21,"عَذَابٍ عَظِيمٍ","نارِ جهنمَ."]],"102":[[4,5,"عَمَلًا صَـٰلِحًا","ما سَبَقَ لهم من الجهادِ مع توبتِهم."],[6,7,"وَءَاخَرَ سَيِّئًا","تَخَلُّفَهم عن غزوةِ «تبوكَ»."]],"103":[[4,4,"تُطَهِّرُهُمۡ","تُزيلُ بها أثَرَ ذنوبِهم."],[5,6,"وَتُزَكِّيهِم بِهَا","تُنَمِّي بها حَسَناتِهم وترفَعُهم إلى منازلِ المُخْلَصِين."],[7,8,"وَصَلِّ عَلَيۡهِمۡ","ادْعُ لهم واستغفِرْ."],[11,12,"سَكَنٌ لَّهُمۡ","سكينةٌ لنفوسِهم وطُمَأنينةٌ لقلوبِهم."]],"104":[[9,10,"وَيَأۡخُذُ ٱلصَّدَقَـٰتِ","يَقْبَلُها ويُثيبُ عليها."]],"105":[[7,7,"وَسَتُرَدُّونَ","ستُرْجَعُون يومَ القيامةِ."]],"106":[[1,3,"مُرۡجَوۡنَ لِأَمۡرِ ٱللَّهِ","مُؤَخَّرون لحُكمِ اللهِ فيهم."]],"107":[[3,3,"ضِرَارًا","لأجل الضَّرَر بِالمؤمنين."],[8,8,"وَإِرۡصَادًا","انتظارًا وإعدادًا."],[9,12,"لِّمَنۡ حَارَبَ ٱللَّهَ وَرَسُولَهُۥ","هو أبو عامرٍ الفاسقُ."],[13,14,"مِن قَبۡلُ","أي: من قَبْلِ بناءِ مسجدِ الضِّرارِ."],[19,19,"ٱلۡحُسۡنَىٰ","الخيرَ والإحسانَ إلى المسلمين."]],"108":[[0,2,"لَا تَقُمۡ فِيهِ","أي للصَّلاةِ في مَسْجدِ الضِّرارِ."],[4,7,"لَّمَسۡجِدٌ أُسِّسَ عَلَى ٱلتَّقۡوَىٰ","هو مَسْجدُ قُباءٍ."],[17,19,"يُحِبُّونَ أَن يَتَطَهَّرُواْ","طهارةً حسِّيةً من النجاساتِ، ومعنويةً من الذُّنوبِ والمعاصي."]],"109":[[7,7,"وَرِضۡوَٰنٍ","ورجاءِ مَرْضاةِ اللهِ."],[13,15,"عَلَىٰ شَفَا جُرُفٍ","على طَرَفِ حُفْرَةٍ، أو مكانٍ يَجْرُفُه الماءُ."],[16,16,"هَارٍ","مُشْرِفٍ على السُّقوط."],[17,18,"فَٱنۡهَارَ بِهِۦ","فسَقَطَ المكانُ بالبُنيانِ مع بانيه."],[23,24,"لَا يَهۡدِي","لا يُوَفِّقُ."]],"110":[[2,2,"بُنۡيَـٰنُهُمُ","مسجدُ الضِّرارِ."],[5,7,"رِيبَةً فِي قُلُوبِهِمۡ","شَكًّا ونفاقًا راسخًا في قلوبِهم."],[10,11,"تَقَطَّعَ قُلُوبُهُمۡ","تتقَطَّعَ قلوبُهم بَمْوتِهم، فالنِّفاقُ ملازمٌ لهم ماداموا أحياءً."]],"111":[[28,28,"فَٱسۡتَبۡشِرُواْ","أظْهِرُوا السُّرورَ."]],"112":[[0,0,"ٱلسَّـٰٓئِحُونَ","الصّائمون."]],"114":[[7,9,"مَّوۡعِدَةٍ وَعَدَهَآ إِيَّاهُ","وهي الاستغفارُ له."],[20,20,"لَأَوَّٰهٌ","كثيرُ التضرُّعِ إلى اللهِ."],[21,21,"حَلِيمٌ","صَبُورٌ على الأذى، كثيرُ الصَّفْحِ عَمَّن نالَه بمَكْروه."]],"115":[[11,12,"مَّا يَتَّقُونَ","ما يَجِبُ عليهم اتقاؤُه من المُحَرَّماتِ."]],"116":[[14,14,"وَلِيٍّ","يَتَوَلّى أمورَكم وينفَعُكم."],[15,16,"وَلَا نَصِيرٍ","يَنْصُرُكم ويَدْفَعُ عنكم ما أنتم فيه."]],"117":[[10,11,"سَاعَةِ ٱلۡعُسۡرَةِ","وقتِ الشِّدةِ، وهي غزوةُ «تبوكَ»."],[16,17,"يَزِيغُ قُلُوبُ","تميلُ إلى التخَلُّفِ عن الجهادِ."],[24,25,"بِهِمۡ رَءُوفٌ","كثيرُ الرأفةِ والرحمةِ بهم في عاجِلِهم وآجِلِهم."]],"118":[[0,1,"وَعَلَى ٱلثَّلَـٰثَةِ","أي: وتابَ على الثلاثةِ، وهم: كَعْبُ بنُ مالك، وهِلالُ ابنُ أميةَ، ومُرارةُ بنُ الرَّبِيعِ."],[3,3,"خُلِّفُواْ","تَخَلَّفوا عن الجهادِ في غزوةِ «تبوكَ»."],[9,10,"بِمَا رَحُبَتۡ","أي: مع سَعَتِها؛ ندمًا بسبب تَخَلُّفِهم عن الغزوِ."],[14,14,"وَظَنُّوٓاْ","أيقنوا."],[22,24,"ثُمَّ تَابَ عَلَيۡهِمۡ","وفَّقهم اللهُ للتوبةِ."],[25,25,"لِيَتُوبُوٓاْ","ليستمِرُّوا على التوبةِ ويثبتُوا عليها."]],"120":[[0,3,"مَا كَانَ لِأَهۡلِ ٱلۡمَدِينَةِ","أي: ليس لهم."],[13,17,"وَلَا يَرۡغَبُواْ بِأَنفُسِهِمۡ عَن نَّفۡسِهِۦ","لا يَرْضَوْا لها بالراحة، ورسولُ الله ﷺ في تعبٍ ومشقةٍ."],[22,22,"ظَمَأٌ","عَطَشٌ."],[23,24,"وَلَا نَصَبٌ","تَعَبٌ."],[25,26,"وَلَا مَخۡمَصَةٌ","جُوعٌ شديدٌ."],[32,32,"مَوۡطِئًا","مكانًا."],[33,33,"يَغِيظُ","يُغْضِبُ."],[39,39,"نَّيۡلًا","بقَتْلٍ، أو أسْرٍ، أو جِراحَةٍ، أو غنيمةٍ ونحوِها."]],"122":[[5,5,"فَلَوۡلَا","فهَلّا."],[6,6,"نَفَرَ","خَرَج للغزوِ والجهادِ."]],"123":[[5,5,"يَلُونَكُم","يجاوِرُونكم."],[10,10,"غِلۡظَةً","شدَّةً."]],"124":[[4,4,"فَمِنۡهُم","فمِنَ المنافقين."],[17,17,"يَسۡتَبۡشِرُونَ","يَفْرحُون بفضلِ اللهِ عليهم."]],"125":[[4,4,"مَّرَضٌ","شكٌّ ونِفاقٌ."],[6,8,"رِجۡسًا إِلَىٰ رِجۡسِهِمۡ","نِفاقًا وكُفْرًا إلى كُفْرِهم."]],"126":[[3,3,"يُفۡتَنُونَ","يُبْتلَوْن بأنواعِ البَلاءِ."],[13,15,"وَلَا هُمۡ يَذَّكَّرُونَ","لا يَتَّعِظُون بما نَزَلَ بهم."]],"127":[[4,7,"نَّظَرَ بَعۡضُهُمۡ إِلَىٰ بَعۡضٍ","تغامَزَ المنافقون بالعيونِ؛ إنكارًا لنزولِ السورةِ، وغيظًا لما فيها من بيانِ عيوبِهم."],[8,11,"هَلۡ يَرَىٰكُم مِّنۡ أَحَدٍ","يُريدون الهروبَ من مجلسِ النبيِّ ﷺ."],[14,16,"صَرَفَ ٱللَّهُ قُلُوبَهُم","عن الإيمانِ."],[19,20,"لَّا يَفۡقَهُونَ","لا يَفْهَمونَ لعَدَمِ تَدَبُّرِهم وإنصافِهم."]],"128":[[3,4,"مِّنۡ أَنفُسِكُمۡ","من قومِكم."],[5,6,"عَزِيزٌ عَلَيۡهِ","ما تَلْقَوْن من المكروهِ والمشقَّةِ."],[12,12,"رَءُوفٌ","عظيمُ الرحمةِ شفيقٌ."]],"129":[[1,1,"تَوَلَّوۡاْ","أعْرَضُوا."],[3,4,"حَسۡبِيَ ٱللَّهُ","يكفيني اللهُ."],[9,10,"عَلَيۡهِ تَوَكَّلۡتُ","اعتمَدْتُ عليه وفوَّضْتُ جميعَ أموري إليه."],[13,13,"ٱلۡعَرۡشِ","سريرِ المُلك الذي استوى عليه الرحمنُ، وتحمِلُه الملائكةُ، وهو أعظمُ المخلوقاتِ، وهو سَقْفُ الجنةِ."]]}